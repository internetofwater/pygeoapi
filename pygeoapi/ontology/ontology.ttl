    "http://www.efunda.com/glossary/units/units--energy_density--british_thermal_unit_it_per_cubic_foot.cfm"^^xsd:anyURI,
    "http://www.translatorscafe.com/cafe/EN/units-converter/fuel-efficiency--volume/c/"^^xsd:anyURI,
