quantitykind:CubicExpansionCoefficient a qudt:QuantityKind ;
    rdfs:label "معامل التمدد الحجمى"@ar,
        "Вълново число"@bg,
        "Volumenausdehnungskoeffizient"@de,
        "Κυματαριθμός"@el,
        "cubic expansion coefficient"@en,
        "coeficiente de dilatación cúbica"@es,
