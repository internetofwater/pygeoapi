unit:T a qudt:Unit, qudt:Unit, qudt:DerivedUnit, qudt:DerivedUnit;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/unit>, <http://qudt.org/vocab/unit>;
  rdfs:label "Tesla"@de, "Tesla"@de, "tesla"@cs, "tesla"@cs, "tesla"@en, "tesla"@en,
    "tesla"@es, "tesla"@es, "tesla"@fr, "tesla"@fr, "tesla"@hu, "tesla"@hu, "tesla"@it,
    "tesla"@it, "tesla"@la, "tesla"@la, "tesla"@ms, "tesla"@ms, "tesla"@pl, "tesla"@pl,
    "tesla"@pt, "tesla"@pt, "tesla"@ro, "tesla"@ro, "tesla"@sl, "tesla"@sl, "tesla"@tr,
    "tesla"@tr, "τέσλα"@el, "τέσλα"@el, "тесла"@bg, "тесла"@bg, "тесла"@ru, "тесла"@ru,
    "טסלה"@he, "טסלה"@he, "تسلا"@ar, "تسلا"@ar, "تسلا"@fa, "تسلا"@fa, "टैस्ला"@hi, "टैस्ला"@hi,
    "テスラ"@ja, "テスラ"@ja, "特斯拉"@zh, "特斯拉"@zh;
  dct:description "The SI unit of flux density (or field intensity) for magnetic fields (also called the magnetic induction). The intensity of a magnetic field can be measured by placing a current-carrying conductor in the field. The magnetic field exerts a force on the conductor, a force which depends on the amount of the current and on the length of the conductor. One tesla is defined as the field intensity generating one newton of force per ampere of current per meter of conductor. Equivalently, one tesla represents a magnetic flux density of one weber per square meter of area. A field of one tesla is quite strong: the strongest fields available in laboratories are about 20 teslas, and the Earth's magnetic flux density, at its surface, is about 50 microteslas. The tesla, defined in 1958, honors the Serbian-American electrical engineer Nikola Tesla (1856-1943), whose work in electromagnetic induction led to the first practical generators and motors using alternating current. $T =  V\\cdot s \\cdot m^{-2} = N\\cdot A^{-1}\\cdot m^{-1} = Wb\\cdot m^{-2} = kg \\cdot  C^{-1}\\cdot s^{-1}\\cdot A^{-1} = kg \\cdot s^{-2}\\cdot A^{-1} = N \\cdot s \\cdot C^{-1}\\cdot m^{-1}$ where, $\\\\$ $A$ = ampere, $C$=coulomb, $m$ = meter,  $N$ = newton, $s$ = second, $T$ = tesla, $Wb$ = weber"^^qudt:LatexString,
    "The SI unit of flux density (or field intensity) for magnetic fields (also called the magnetic induction). The intensity of a magnetic field can be measured by placing a current-carrying conductor in the field. The magnetic field exerts a force on the conductor, a force which depends on the amount of the current and on the length of the conductor. One tesla is defined as the field intensity generating one newton of force per ampere of current per meter of conductor. Equivalently, one tesla represents a magnetic flux density of one weber per square meter of area. A field of one tesla is quite strong: the strongest fields available in laboratories are about 20 teslas, and the Earth's magnetic flux density, at its surface, is about 50 microteslas. The tesla, defined in 1958, honors the Serbian-American electrical engineer Nikola Tesla (1856-1943), whose work in electromagnetic induction led to the first practical generators and motors using alternating current. $T =  V\\cdot s \\cdot m^{-2} = N\\cdot A^{-1}\\cdot m^{-1} = Wb\\cdot m^{-2} = kg \\cdot  C^{-1}\\cdot s^{-1}\\cdot A^{-1} = kg \\cdot s^{-2}\\cdot A^{-1} = N \\cdot s \\cdot C^{-1}\\cdot m^{-1}$ where, $\\\\$ $A$ = ampere, $C$=coulomb, $m$ = meter,  $N$ = newton, $s$ = second, $T$ = tesla, $Wb$ = weber"^^qudt:LatexString;
  qudt:applicableSystem <http://qudt.org/vocab/sou/CGS-EMU>, <http://qudt.org/vocab/sou/CGS-EMU>,
    <http://qudt.org/vocab/sou/CGS-GAUSS>, <http://qudt.org/vocab/sou/CGS-GAUSS>, <http://qudt.org/vocab/sou/SI>,
    <http://qudt.org/vocab/sou/SI>;
  qudt:conversionMultiplier 1.0, 1.0;
  qudt:conversionMultiplierSN 1.0E0, 1.0E0;
  qudt:dbpediaMatch "http://dbpedia.org/resource/Tesla"^^xsd:anyURI, "http://dbpedia.org/resource/Tesla"^^xsd:anyURI;
  qudt:hasDimensionVector dimensionvector:A0E-1L0I0M1H0T-2D0, dimensionvector:A0E-1L0I0M1H0T-2D0;
  qudt:hasQuantityKind quantitykind:MagneticFluxDensity, quantitykind:MagneticFluxDensity,
    quantitykind:MagneticField, quantitykind:MagneticField;
  qudt:iec61360Code "0112/2///62720#UAA285", "0112/2///62720#UAA285";
  qudt:informativeReference "http://en.wikipedia.org/wiki/Tesla?oldid=481198244"^^xsd:anyURI,
    "http://en.wikipedia.org/wiki/Tesla?oldid=481198244"^^xsd:anyURI, "http://en.wikipedia.org/wiki/Tesla_(unit)"^^xsd:anyURI,
    "http://en.wikipedia.org/wiki/Tesla_(unit)"^^xsd:anyURI, "http://www.oxfordreference.com/view/10.1093/acref/9780198605225.001.0001/acref-9780198605225-e-1406?rskey=AzXBLd"^^xsd:anyURI,
    "https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAA285"^^xsd:anyURI,
    "https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAA285"^^xsd:anyURI,
    "http://www.oxfordreference.com/view/10.1093/acref/acref-9780198605225-e-1406?rskey=AzXBLd"^^xsd:anyURI;
  qudt:omUnit <http://www.ontology-of-units-of-measure.org/resource/om-2/tesla>, <http://www.ontology-of-units-of-measure.org/resource/om-2/tesla>;
  qudt:siExactMatch <https://si-digital-framework.org/SI/units/tesla>, <https://si-digital-framework.org/SI/units/tesla>;
  qudt:symbol "T", "T";
  qudt:ucumCode "T"^^qudt:UCUMcs, "T"^^qudt:UCUMcs;
  qudt:udunitsCode "T", "T";
  qudt:uneceCommonCode "D33", "D33";
  qudt:derivedCoherentUnitOfSystem <http://qudt.org/vocab/sou/SI>, <http://qudt.org/vocab/sou/SI>;
  qudt:definedUnitOfSystem <http://qudt.org/vocab/sou/SI>, <http://qudt.org/vocab/sou/SI>;
  qudt:siUnitsExpression "Wb/m^2", "Wb/m^2";
  qudt:hasFactorUnit _:b1cb43fcbd504833bf8a964862c3127018936, _:b1cb43fcbd504833bf8a964862c3127018937 .

