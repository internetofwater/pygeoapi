  rdfs:comment "Applicable units are those of quantitykind:Torque", "Applicable units are those of quantitykind:Torque";
  dct:description "A bending moment exists in a structural element when a moment is applied to the element so that the element bends. It is the component of moment of force perpendicular to the longitudinal axis of a beam or a shaft."^^qudt:LatexString,
    "A bending moment exists in a structural element when a moment is applied to the element so that the element bends. It is the component of moment of force perpendicular to the longitudinal axis of a beam or a shaft."^^qudt:LatexString;
  skos:broader quantitykind:Torque, quantitykind:Torque;
  qudt:dbpediaMatch "http://dbpedia.org/resource/Torque"^^xsd:anyURI, "http://dbpedia.org/resource/Torque"^^xsd:anyURI;
