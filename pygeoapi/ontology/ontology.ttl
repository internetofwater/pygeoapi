  <http://qudt.org/schema/qudt/hasQuantityKind> <http://qudt.org/vocab/quantitykind/TemperatureAmountOfSubstance>;
  <http://qudt.org/schema/qudt/symbol> "mol·°C";
  <http://qudt.org/schema/qudt/ucumCode> "mol.Cel"^^<http://qudt.org/schema/qudt/UCUMcs>;
  <http://qudt.org/schema/qudt/expression> "$mol-deg-c$"^^<http://qudt.org/schema/qudt/LatexString>,
    "$mol-degC$"^^<http://qudt.org/schema/qudt/LatexString> .

<http://qudt.org/vocab/dimensionvector/A1E0L0I0M0H1T0D0> a <http://qudt.org/schema/qudt/QuantityKindDimensionVector_SI>,
    <http://qudt.org/schema/qudt/QuantityKindDimensionVector_ISO>, <http://qudt.org/schema/qudt/QuantityKindDimensionVector_Imperial>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/dimensionvector>;
