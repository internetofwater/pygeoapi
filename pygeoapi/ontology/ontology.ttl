quantitykind:ExchangeIntegral a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "Exchange Integral"@en, "Exchange Integral"@en;
  rdfs:comment "Applicable units are those of quantitykind:ExchangeIntegral", "Applicable units are those of quantitykind:ExchangeIntegral";
  dct:description "\"Exchange Integral\" is the constituent of the interaction energy between the spins of adjacent electrons in matter arising from the overlap of electron state functions."^^qudt:LatexString,
    "\"Exchange Integral\" is the constituent of the interaction energy between the spins of adjacent electrons in matter arising from the overlap of electron state functions."^^qudt:LatexString;
  qudt:hasDimensionVector dimensionvector:A0E0L2I0M1H0T-2D0, dimensionvector:A0E0L2I0M1H0T-2D0;
  qudt:informativeReference "http://en.wikipedia.org/wiki/Exchange_interaction"^^xsd:anyURI,
    "http://en.wikipedia.org/wiki/Exchange_interaction"^^xsd:anyURI;
  qudt:symbol "K", "K";
  qudt:isoNormativeReference "http://www.iso.org/iso/catalogue_detail?csnumber=31897"^^xsd:anyURI,
    "http://www.iso.org/iso/catalogue_detail?csnumber=31897"^^xsd:anyURI;
  qudt:plainTextDescription "\"Exchange Integral\" is the constituent of the interaction energy between the spins of adjacent electrons in matter arising from the overlap of electron state functions.",
    "\"Exchange Integral\" is the constituent of the interaction energy between the spins of adjacent electrons in matter arising from the overlap of electron state functions.";
  qudt:applicableUnit unit:J, unit:J, unit:NanoJ, unit:NanoJ, unit:PicoJ, unit:PicoJ .

quantitykind:HamiltonFunction a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "Hamilton Function"@en, "Hamilton Function"@en;
  rdfs:comment "Applicable units are those of quantitykind:HamiltonFunction", "Applicable units are those of quantitykind:HamiltonFunction";
  dct:description "The Hamilton–Jacobi equation (HJE) is a necessary condition describing extremal geometry in generalizations of problems from the calculus of variations."^^qudt:LatexString,
    "The Hamilton–Jacobi equation (HJE) is a necessary condition describing extremal geometry in generalizations of problems from the calculus of variations."^^qudt:LatexString;
  qudt:hasDimensionVector dimensionvector:A0E0L2I0M1H0T-2D0, dimensionvector:A0E0L2I0M1H0T-2D0;
  qudt:informativeReference "http://en.wikipedia.org/wiki/Hamilton–Jacobi_equation"^^xsd:anyURI,
    "http://en.wikipedia.org/wiki/Hamilton–Jacobi_equation"^^xsd:anyURI;
  qudt:symbol "H", "H";
  qudt:isoNormativeReference "http://www.iso.org/iso/catalogue_detail?csnumber=31889"^^xsd:anyURI,
    "http://www.iso.org/iso/catalogue_detail?csnumber=31889"^^xsd:anyURI;
  qudt:plainTextDescription "The Hamilton–Jacobi equation (HJE) is a necessary condition describing extremal geometry in generalizations of problems from the calculus of variations.",
    "The Hamilton–Jacobi equation (HJE) is a necessary condition describing extremal geometry in generalizations of problems from the calculus of variations.";
  qudt:latexDefinition "$H = \\sum p_i\\dot{q_i} - L$, where $p_i$ is a generalized momentum, $\\dot{q_i}$ is a generalized velocity, and $L$ is the Lagrange function."^^qudt:LatexString,
    "$H = \\sum p_i\\dot{q_i} - L$, where $p_i$ is a generalized momentum, $\\dot{q_i}$ is a generalized velocity, and $L$ is the Lagrange function."^^qudt:LatexString;
  qudt:applicableUnit unit:J, unit:J, unit:NanoJ, unit:NanoJ, unit:PicoJ, unit:PicoJ .

quantitykind:LagrangeFunction a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "Lagrange Function"@en, "Lagrange Function"@en;
  rdfs:comment "Applicable units are those of quantitykind:LagrangeFunction", "Applicable units are those of quantitykind:LagrangeFunction";
  dct:description "The Lagrange Function is a function that summarizes the dynamics of the system."^^qudt:LatexString,
    "The Lagrange Function is a function that summarizes the dynamics of the system."^^qudt:LatexString;
  qudt:hasDimensionVector dimensionvector:A0E0L2I0M1H0T-2D0, dimensionvector:A0E0L2I0M1H0T-2D0;
  qudt:informativeReference "http://en.wikipedia.org/wiki/Lagrangian"^^xsd:anyURI, "http://en.wikipedia.org/wiki/Lagrangian"^^xsd:anyURI,
    "http://www.electropedia.org/iev/iev.nsf/display?openform&ievref=113-03-76"^^xsd:anyURI,
    "http://www.electropedia.org/iev/iev.nsf/display?openform&ievref=113-03-76"^^xsd:anyURI;
  qudt:symbol "L", "L";
  qudt:isoNormativeReference "http://www.iso.org/iso/catalogue_detail?csnumber=31889"^^xsd:anyURI,
    "http://www.iso.org/iso/catalogue_detail?csnumber=31889"^^xsd:anyURI;
  qudt:plainTextDescription "The Lagrange Function is a function that summarizes the dynamics of the system.",
    "The Lagrange Function is a function that summarizes the dynamics of the system.";
  qudt:latexDefinition "$L(q_i, \\dot{q_i}) = T(q_i, \\dot{q_i}) - V(q_i)$, where $T$ is kinetic energy, $V$ is potential energy, $q_i$ is a generalized coordinate, and $\\dot{q_i}$ is a generalized velocity."^^qudt:LatexString,
    "$L(q_i, \\dot{q_i}) = T(q_i, \\dot{q_i}) - V(q_i)$, where $T$ is kinetic energy, $V$ is potential energy, $q_i$ is a generalized coordinate, and $\\dot{q_i}$ is a generalized velocity."^^qudt:LatexString;
  qudt:applicableUnit unit:J, unit:J, unit:NanoJ, unit:NanoJ, unit:PicoJ, unit:PicoJ .

quantitykind:LevelWidth a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "Level Width"@en, "Level Width"@en;
  rdfs:comment "Applicable units are those of quantitykind:LevelWidth", "Applicable units are those of quantitykind:LevelWidth";
  dct:description "The \"Level Width\" is the uncertainty in the energy of a quantum-mechanical system having discrete energy levels in a state that is not strictly stationary. The system may be an atom, a molecule, or an atomic nucleus."^^qudt:LatexString,
    "The \"Level Width\" is the uncertainty in the energy of a quantum-mechanical system having discrete energy levels in a state that is not strictly stationary. The system may be an atom, a molecule, or an atomic nucleus."^^qudt:LatexString;
  qudt:hasDimensionVector dimensionvector:A0E0L2I0M1H0T-2D0, dimensionvector:A0E0L2I0M1H0T-2D0;
  qudt:informativeReference "http://encyclopedia2.thefreedictionary.com/Level+Width"^^xsd:anyURI,
    "http://encyclopedia2.thefreedictionary.com/Level+Width"^^xsd:anyURI;
  qudt:isoNormativeReference "http://www.iso.org/iso/catalogue_detail?csnumber=31895"^^xsd:anyURI,
    "http://www.iso.org/iso/catalogue_detail?csnumber=31895"^^xsd:anyURI;
  qudt:plainTextDescription "The \"Level Width\" is the uncertainty in the energy of a quantum-mechanical system having discrete energy levels in a state that is not strictly stationary. The system may be an atom, a molecule, or an atomic nucleus.",
    "The \"Level Width\" is the uncertainty in the energy of a quantum-mechanical system having discrete energy levels in a state that is not strictly stationary. The system may be an atom, a molecule, or an atomic nucleus.";
  qudt:latexSymbol "$\\Gamma$"^^qudt:LatexString, "$\\Gamma$"^^qudt:LatexString;
  qudt:latexDefinition "$\\Gamma = \\frac{\\hbar}{\\tau}$, where $\\hbar$ is the reduced Planck constant and $\\tau$ is the mean lifetime."^^qudt:LatexString,
    "$\\Gamma = \\frac{\\hbar}{\\tau}$, where $\\hbar$ is the reduced Planck constant and $\\tau$ is the mean lifetime."^^qudt:LatexString;
  qudt:applicableUnit unit:J, unit:J, unit:NanoJ, unit:NanoJ, unit:PicoJ, unit:PicoJ .

