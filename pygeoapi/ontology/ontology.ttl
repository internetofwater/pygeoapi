quantitykind:Slowing-DownDensity a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "Slowing-Down Density"@en, "Slowing-Down Density"@en;
  rdfs:comment "Applicable units are those of quantitykind:Slowing-DownDensity", "Applicable units are those of quantitykind:Slowing-DownDensity";
  dct:description "\"Slowing-Down Density\" is a measure of the rate at which neutrons lose energy in a nuclear reactor through collisions; equal to the number of neutrons that fall below a given energy per unit volume per unit time."^^qudt:LatexString,
    "\"Slowing-Down Density\" is a measure of the rate at which neutrons lose energy in a nuclear reactor through collisions; equal to the number of neutrons that fall below a given energy per unit volume per unit time."^^qudt:LatexString;
  qudt:hasDimensionVector dimensionvector:A0E0L-3I0M0H0T-1D0, dimensionvector:A0E0L-3I0M0H0T-1D0;
  qudt:iec61360Code "0112/2///62720#UAD170", "0112/2///62720#UAD170";
  qudt:informativeReference "http://encyclopedia2.thefreedictionary.com/slowing-down+density"^^xsd:anyURI,
    "http://encyclopedia2.thefreedictionary.com/slowing-down+density"^^xsd:anyURI, "https://cdd.iec.ch/cdd/iec61987/iec61987.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD170"^^xsd:anyURI,
    "https://cdd.iec.ch/cdd/iec61987/iec61987.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD170"^^xsd:anyURI;
  qudt:symbol "q", "q";
  qudt:isoNormativeReference "http://www.iso.org/iso/catalogue_detail?csnumber=31895"^^xsd:anyURI,
    "http://www.iso.org/iso/catalogue_detail?csnumber=31895"^^xsd:anyURI;
  qudt:plainTextDescription "\"Slowing-Down Density\" is a measure of the rate at which neutrons lose energy in a nuclear reactor through collisions; equal to the number of neutrons that fall below a given energy per unit volume per unit time.",
    "\"Slowing-Down Density\" is a measure of the rate at which neutrons lose energy in a nuclear reactor through collisions; equal to the number of neutrons that fall below a given energy per unit volume per unit time.";
  qudt:latexDefinition "$q = -\\frac{dn}{dt}$, where $n$ is the number density and $dt$ is the duration."^^qudt:LatexString,
    "$q = -\\frac{dn}{dt}$, where $n$ is the number density and $dt$ is the duration."^^qudt:LatexString;
  qudt:applicableUnit unit:PER-M3-SEC, unit:PER-M3-SEC, unit:PER-SEC-M3, unit:PER-SEC-M3 .

