    "https://cdd.iec.ch/cdd/iec61987/iec61987.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD040"^^xsd:anyURI,
    "https://cdd.iec.ch/cdd/iec61987/iec61987.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD040"^^xsd:anyURI;
  qudt:siExactMatch <https://si-digital-framework.org/SI/quantities/CUDE>, <https://si-digital-framework.org/quantities/CUDE>;
  qudt:symbol "J", "J";
