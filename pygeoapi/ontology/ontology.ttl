    "https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAA277"^^xsd:anyURI,
    "https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAA277"^^xsd:anyURI,
    "https://en.wikipedia.org/wiki/Siemens_(unit)"^^xsd:anyURI, "https://en.wikipedia.org/wiki/Siemens_(unit)"^^xsd:anyURI;
  qudt:omUnit <http://www.ontology-of-units-of-measure.org/resource/om-2/siemens>, <http://www.ontology-of-units-of-measure.org/resource/om-2/siemens>;
  qudt:siExactMatch <https://si-digital-framework.org/SI/units/siemens>, <https://si-digital-framework.org/SI/units/siemens>;
