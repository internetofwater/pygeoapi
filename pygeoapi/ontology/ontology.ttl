  <http://qudt.org/schema/qudt/symbol> "pt";
  <http://qudt.org/schema/qudt/ucumCode> "[pnt]"^^<http://qudt.org/schema/qudt/UCUMcs>;
  <http://qudt.org/schema/qudt/uneceCommonCode> "N3" .

