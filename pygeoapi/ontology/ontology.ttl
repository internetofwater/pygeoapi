quantitykind:EquivalenceDoseOutput a qudt:QuantityKind ;
    rdfs:label "equivalence dose output"@en-US ;
    dct:description "ratio of equivalence dose within an appropriately small interval to this interval, calculated as the differential quotient: q • D = q • ∂D/∂t as a measure of the current radiation exposure"@en ;
