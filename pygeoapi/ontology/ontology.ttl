quantitykind:PolarMomentOfInertia a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "Polar moment of inertia"@en, "Polar moment of inertia"@en;
  rdfs:comment "Applicable units are those of quantitykind:MomentOfInertia", "Applicable units are those of quantitykind:MomentOfInertia";
  dct:description "The polar moment of inertia is a quantity used to predict an object's ability to resist torsion, in objects (or segments of objects) with an invariant circular cross-section and no significant warping or out-of-plane deformation. It is used to calculate the angular displacement of an object subjected to a torque. It is analogous to the area moment of inertia, which characterizes an object's ability to resist bending. "^^qudt:LatexString,
    "The polar moment of inertia is a quantity used to predict an object's ability to resist torsion, in objects (or segments of objects) with an invariant circular cross-section and no significant warping or out-of-plane deformation. It is used to calculate the angular displacement of an object subjected to a torque. It is analogous to the area moment of inertia, which characterizes an object's ability to resist bending. "^^qudt:LatexString;
  skos:broader quantitykind:MomentOfInertia, quantitykind:MomentOfInertia;
  qudt:hasDimensionVector dimensionvector:A0E0L2I0M1H0T0D0, dimensionvector:A0E0L2I0M1H0T0D0;
  qudt:informativeReference "http://en.wikipedia.org/wiki/Second_moment_of_area"^^xsd:anyURI,
    "http://en.wikipedia.org/wiki/Second_moment_of_area"^^xsd:anyURI;
  qudt:symbol "J_{zz}", "J_{zz}";
  qudt:plainTextDescription "The polar moment of inertia is a quantity used to predict an object's ability to resist torsion, in objects (or segments of objects) with an invariant circular cross-section and no significant warping or out-of-plane deformation. It is used to calculate the angular displacement of an object subjected to a torque. It is analogous to the area moment of inertia, which characterizes an object's ability to resist bending. ",
    "The polar moment of inertia is a quantity used to predict an object's ability to resist torsion, in objects (or segments of objects) with an invariant circular cross-section and no significant warping or out-of-plane deformation. It is used to calculate the angular displacement of an object subjected to a torque. It is analogous to the area moment of inertia, which characterizes an object's ability to resist bending. ";
  qudt:applicableUnit unit:KiloGM-CentiM2, unit:KiloGM-CentiM2, unit:KiloGM-M2, unit:KiloGM-M2,
    unit:KiloGM-MilliM2, unit:KiloGM-MilliM2, unit:LB-FT2, unit:LB-FT2, unit:LB-IN2, unit:LB-IN2 .

