quantitykind:AtomicAttenuationCoefficient a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "Atomic Attenuation Coefficient"@en, "Atomic Attenuation Coefficient"@en;
  rdfs:comment "Applicable units are those of quantitykind:Area", "Applicable units are those of quantitykind:Area";
  dct:description "\"Atomic Attenuation Coefficient\" is a measurement of how strongly a chemical species or substance absorbs or scatters light at a given wavelength, per the number of atoms in the substance."^^qudt:LatexString,
    "\"Atomic Attenuation Coefficient\" is a measurement of how strongly a chemical species or substance absorbs or scatters light at a given wavelength, per the number of atoms in the substance."^^qudt:LatexString;
  skos:broader quantitykind:Area, quantitykind:Area;
  skos:closeMatch quantitykind:MolarAttenuationCoefficient, quantitykind:MolarAttenuationCoefficient;
  qudt:hasDimensionVector dimensionvector:A0E0L2I0M0H0T0D0, dimensionvector:A0E0L2I0M0H0T0D0;
  qudt:informativeReference "http://en.wikipedia.org/wiki/Attenuation_coefficient"^^xsd:anyURI,
    "http://en.wikipedia.org/wiki/Attenuation_coefficient"^^xsd:anyURI;
  qudt:symbol "μₐ", "μₐ";
  qudt:plainTextDescription "\"Atomic Attenuation Coefficient\" is a measurement of how strongly a chemical species or substance absorbs or scatters light at a given wavelength, per the number of atoms in the substance.",
    "\"Atomic Attenuation Coefficient\" is a measurement of how strongly a chemical species or substance absorbs or scatters light at a given wavelength, per the number of atoms in the substance.";
  qudt:latexDefinition "$\\mu_a = -\\frac{\\mu}{n}$, where $\\mu$ is the linear attenuation coefficient and $n$ is the number density of the atoms in the substance."^^qudt:LatexString,
    "$\\mu_a = -\\frac{\\mu}{n}$, where $\\mu$ is the linear attenuation coefficient and $n$ is the number density of the atoms in the substance."^^qudt:LatexString;
