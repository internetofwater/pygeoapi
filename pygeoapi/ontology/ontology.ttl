unit:M3-PER-MOL a qudt:Unit, qudt:Unit;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/unit>, <http://qudt.org/vocab/unit>;
  rdfs:label "Cubic Meter per Mole"@en-US, "Cubic Meter per Mole"@en-US, "Kubikmeter je Mol"@de,
    "Kubikmeter je Mol"@de, "cubic metre per mole"@en, "cubic metre per mole"@en, "kubični meter na mol"@sl,
    "kubični meter na mol"@sl, "meter kubik per mole"@ms, "meter kubik per mole"@ms, "metr krychlový na mol"@cs,
    "metr krychlový na mol"@cs, "metr sześcienny na mol"@pl, "metr sześcienny na mol"@pl,
    "metreküp bölü metre küp"@tr, "metreküp bölü metre küp"@tr, "metro cubo alla mole"@it,
    "metro cubo alla mole"@it, "metro cúbico por mol"@es, "metro cúbico por mol"@es, "metro cúbico por mol"@pt,
    "metro cúbico por mol"@pt, "metru cub pe mol"@ro, "metru cub pe mol"@ro, "mètre cube par mole"@fr,
    "mètre cube par mole"@fr, "кубический метр на моль"@ru, "кубический метр на моль"@ru,
    "متر مكعب لكل مول"@ar, "متر مكعب لكل مول"@ar, "متر مکعب بر مول"@fa, "متر مکعب بر مول"@fa,
    "घन मीटर प्रति मोल (इकाई)"@hi, "घन मीटर प्रति मोल (इकाई)"@hi, "立方メートル 毎立方メートル"@ja,
    "立方メートル 毎立方メートル"@ja, "立方米每摩尔"@zh, "立方米每摩尔"@zh;
  dct:description "<p>The molar volume, symbol $Vm$, is the volume occupied by one mole of a substance (chemical element or chemical compound) at a given temperature and pressure. It is equal to the molar mass (M) divided by the mass density. It has the SI unit cubic metres per mole $m3/mol$, although it is more practical to use the units cubic decimetres per mole $dm3/mol$ for gases and cubic centimetres per mole $cm3/mol$ for liquids and solids</p>."^^qudt:LatexString,
    "<p>The molar volume, symbol $Vm$, is the volume occupied by one mole of a substance (chemical element or chemical compound) at a given temperature and pressure. It is equal to the molar mass (M) divided by the mass density. It has the SI unit cubic metres per mole $m3/mol$, although it is more practical to use the units cubic decimetres per mole $dm3/mol$ for gases and cubic centimetres per mole $cm3/mol$ for liquids and solids</p>."^^qudt:LatexString;
  qudt:applicableSystem <http://qudt.org/vocab/sou/SI>, <http://qudt.org/vocab/sou/SI>;
  qudt:conversionMultiplier 1.0, 1.0;
  qudt:conversionMultiplierSN 1.0E0, 1.0E0;
  qudt:hasDimensionVector dimensionvector:A-1E0L3I0M0H0T0D0, dimensionvector:A-1E0L3I0M0H0T0D0;
  qudt:hasQuantityKind quantitykind:MolarRefractivity, quantitykind:MolarRefractivity,
    quantitykind:MolarVolume, quantitykind:MolarVolume;
  qudt:iec61360Code "0112/2///62720#UAA771", "0112/2///62720#UAA771";
  qudt:informativeReference "https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAA771"^^xsd:anyURI,
    "https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAA771"^^xsd:anyURI;
  qudt:symbol "m³/mol", "m³/mol";
  qudt:ucumCode "m3.mol-1"^^qudt:UCUMcs, "m3.mol-1"^^qudt:UCUMcs, "m3/mol"^^qudt:UCUMcs,
    "m3/mol"^^qudt:UCUMcs;
  qudt:uneceCommonCode "A40", "A40";
