    <http://qudt.org/vocab/quantitykind/Dissipance>, <http://qudt.org/vocab/quantitykind/DoseEquivalentQualityFactor>,
    <http://qudt.org/vocab/quantitykind/Duv>, <http://qudt.org/vocab/quantitykind/EinsteinTransitionProbability>,
    <http://qudt.org/vocab/quantitykind/ElectricSusceptibility>, <http://qudt.org/vocab/quantitykind/Emissivity>,
    <http://qudt.org/vocab/quantitykind/EquilibriumConstant>, <http://qudt.org/vocab/quantitykind/FastFissionFactor>,
    <http://qudt.org/vocab/quantitykind/GFactorOfNucleus>, <http://qudt.org/vocab/quantitykind/GeneralizedCoordinate>,
    <http://qudt.org/vocab/quantitykind/GeneralizedForce>, <http://qudt.org/vocab/quantitykind/GeneralizedMomentum>,
    <http://qudt.org/vocab/quantitykind/GeneralizedVelocity>, <http://qudt.org/vocab/quantitykind/GruneisenParameter>,
    <http://qudt.org/vocab/quantitykind/InternalConversionFactor>, <http://qudt.org/vocab/quantitykind/IsentropicExponent>,
    <http://qudt.org/vocab/quantitykind/LandeGFactor>, <http://qudt.org/vocab/quantitykind/LeakageFactor>,
    <http://qudt.org/vocab/quantitykind/Lethargy>, <http://qudt.org/vocab/quantitykind/LogOctanolAirPartitionCoefficient>,
    <http://qudt.org/vocab/quantitykind/LogOctanolWaterPartitionCoefficient>, <http://qudt.org/vocab/quantitykind/Long-RangeOrderParameter>,
    <http://qudt.org/vocab/quantitykind/LossFactor>, <http://qudt.org/vocab/quantitykind/MadelungConstant>,
    <http://qudt.org/vocab/quantitykind/MagneticSusceptability>, <http://qudt.org/vocab/quantitykind/MassFraction>,
    <http://qudt.org/vocab/quantitykind/MassFractionOfDryMatter>, <http://qudt.org/vocab/quantitykind/MassFractionOfWater>,
    <http://qudt.org/vocab/quantitykind/MassRatioOfWaterToDryMatter>, <http://qudt.org/vocab/quantitykind/MassRatioOfWaterVapourToDryGas>,
    <http://qudt.org/vocab/quantitykind/MobilityRatio>, <http://qudt.org/vocab/quantitykind/MultiplicationFactor>,
    <http://qudt.org/vocab/quantitykind/NapierianAbsorbance>, <http://qudt.org/vocab/quantitykind/NeutronYieldPerAbsorption>,
    <http://qudt.org/vocab/quantitykind/NeutronYieldPerFission>, <http://qudt.org/vocab/quantitykind/Non-LeakageProbability>,
    <http://qudt.org/vocab/quantitykind/NumberOfParticles>, <http://qudt.org/vocab/quantitykind/OrderOfReflection>,
    <http://qudt.org/vocab/quantitykind/OsmoticCoefficient>, <http://qudt.org/vocab/quantitykind/PackingFraction>,
    <http://qudt.org/vocab/quantitykind/PermittivityRatio>, <http://qudt.org/vocab/quantitykind/PoissonRatio>,
    <http://qudt.org/vocab/quantitykind/PowerFactor>, <http://qudt.org/vocab/quantitykind/QualityFactor>,
    <http://qudt.org/vocab/quantitykind/RadianceFactor>, <http://qudt.org/vocab/quantitykind/RatioOfSpecificHeatCapacities>,
    <http://qudt.org/vocab/quantitykind/Reactivity>, <http://qudt.org/vocab/quantitykind/ReflectanceFactor>,
    <http://qudt.org/vocab/quantitykind/RefractiveIndex>, <http://qudt.org/vocab/quantitykind/RelativeMassConcentrationOfVapour>,
    <http://qudt.org/vocab/quantitykind/RelativeMassDensity>, <http://qudt.org/vocab/quantitykind/RelativeMassExcess>,
    <http://qudt.org/vocab/quantitykind/RelativeMassRatioOfVapour>, <http://qudt.org/vocab/quantitykind/ResonanceEscapeProbability>,
    <http://qudt.org/vocab/quantitykind/Short-RangeOrderParameter>, <http://qudt.org/vocab/quantitykind/StandardAbsoluteActivity>,
    <http://qudt.org/vocab/quantitykind/StatisticalWeight>, <http://qudt.org/vocab/quantitykind/StructureFactor>,
    <http://qudt.org/vocab/quantitykind/ThermalDiffusionFactor>, <http://qudt.org/vocab/quantitykind/ThermalDiffusionRatio>,
    <http://qudt.org/vocab/quantitykind/ThermalUtilizationFactor>, <http://qudt.org/vocab/quantitykind/TotalIonization>,
    <http://qudt.org/vocab/quantitykind/TransmittanceDensity>, <http://qudt.org/vocab/quantitykind/Turns>;
  <http://qudt.org/schema/qudt/symbol> "一";
  <http://qudt.org/schema/qudt/uneceCommonCode> "C62" .

<http://qudt.org/vocab/quantitykind/Absorptance> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Absorptance"@en;
  rdfs:comment "Applicable units are those of quantitykind:Absorptance";
  dct:description "Absorptance is the ratio of the radiation absorbed by a surface to that incident upon it. Also known as absorbance."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1>;
  <http://qudt.org/schema/qudt/informativeReference> "http://en.wikipedia.org/wiki/Absorbance"^^xsd:anyURI,
    "https://en.wikipedia.org/wiki/Absorptance"^^xsd:anyURI, "https://www.researchgate.net/post/Absorptance_or_absorbance"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/plainTextDescription> "Absorptance is the ratio of the radiation absorbed by a surface to that incident upon it. Also known as absorbance.";
  <http://qudt.org/schema/qudt/latexSymbol> "$\\alpha$"^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/latexDefinition> "$\\alpha = \\frac{\\Phi_a}{\\Phi_m}$, where $\\Phi_a$ is the absorbed radiant flux or the absorbed luminous flux, and $\\Phi_m$ is the radiant flux or luminous flux of the incident radiation."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://www.linkedmodel.org/schema/vaem#todo> "belongs to SOQ-ISO";
  <http://qudt.org/schema/qudt/applicableUnit> unit:UNITLESS .

<http://qudt.org/vocab/quantitykind/ActivityCoefficient> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Activity Coefficient"@en;
  rdfs:comment "Applicable units are those of quantitykind:ActivityCoefficient";
  dct:description "An \"Activity Coefficient\" is a factor used in thermodynamics to account for deviations from ideal behaviour in a mixture of chemical substances. In an ideal mixture, the interactions between each pair of chemical species are the same (or more formally, the enthalpy change of solution is zero) and, as a result, properties of the mixtures can be expressed directly in terms of simple concentrations or partial pressures of the substances present e.g. Raoult's law. Deviations from ideality are accommodated by modifying the concentration by an activity coefficient. "^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1>;
  <http://qudt.org/schema/qudt/informativeReference> "http://en.wikipedia.org/wiki/Activity_coefficient"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/symbol> "f_B";
  <http://qudt.org/schema/qudt/isoNormativeReference> "http://www.iso.org/iso/catalogue_detail?csnumber=31894"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/plainTextDescription> "An \"Activity Coefficient\" is a factor used in thermodynamics to account for deviations from ideal behaviour in a mixture of chemical substances. In an ideal mixture, the interactions between each pair of chemical species are the same (or more formally, the enthalpy change of solution is zero) and, as a result, properties of the mixtures can be expressed directly in terms of simple concentrations or partial pressures of the substances present e.g. Raoult's law. Deviations from ideality are accommodated by modifying the concentration by an activity coefficient. ";
  <http://qudt.org/schema/qudt/latexDefinition> "$f_B = \\frac{\\lambda_B}{(\\lambda_B^*x_B)}$, where $\\lambda_B$ the absolute activity of substance $B$, $\\lambda_B^*$ is the absolute activity of the pure substance $B$ at the same temperature and pressure, and $x_B$ is the amount-of-substance fraction of substance $B$."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/applicableUnit> unit:UNITLESS .

<http://qudt.org/vocab/quantitykind/AmountOfSubstanceFraction> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Fractional Amount of Substance"@en;
  rdfs:comment "Applicable units are those of quantitykind:AmountOfSubstanceFraction";
  dct:description "\"Fractional Amount of Substance\" is defined as tthe amount of a constituent divided by the total amount of all constituents in a mixture."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1>;
  <http://qudt.org/schema/qudt/informativeReference> "http://en.wikipedia.org/wiki/Amount_fraction"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/symbol> "X_B";
  <http://qudt.org/schema/qudt/isoNormativeReference> "http://www.iso.org/iso/catalogue_detail?csnumber=31894"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/plainTextDescription> "\"Fractional Amount of Substance\" is defined as tthe amount of a constituent divided by the total amount of all constituents in a mixture.";
  <http://qudt.org/schema/qudt/latexDefinition> "$x_B = \\frac{n_B}{n}$, where $n_B$ is the amount of substance $B$ and $n$ is the total amount of substance."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/applicableUnit> unit:UNITLESS .

<http://qudt.org/vocab/quantitykind/AtomScatteringFactor> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Atom Scattering Factor"@en;
  rdfs:comment "Applicable units are those of quantitykind:AtomScatteringFactor";
  dct:description "\"Atom Scattering Factor\" is measure of the scattering power of an isolated atom."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1>;
  <http://qudt.org/schema/qudt/informativeReference> "http://reference.iucr.org/dictionary/Atomic_scattering_factor"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/symbol> "f";
  <http://qudt.org/schema/qudt/isoNormativeReference> "http://www.iso.org/iso/catalogue_detail?csnumber=31897"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/plainTextDescription> "\"Atom Scattering Factor\" is measure of the scattering power of an isolated atom.";
  <http://qudt.org/schema/qudt/latexDefinition> "$f = \\frac{E_a}{E_e}$, where $E_a$ is the radiation amplitude scattered by the atom and $E_e$ is the radiation ampliture scattered by a single electron."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/applicableUnit> unit:UNITLESS .

<http://qudt.org/vocab/quantitykind/AverageLogarithmicEnergyDecrement> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Average Logarithmic Energy Decrement"@en;
  rdfs:comment "Applicable units are those of quantitykind:AverageLogarithmicEnergyDecrement";
  dct:description "\"Average Logarithmic Energy Decrement\" is a measure of the amount of energy a neutron loses upon colliding with various nuclei. It is the average value of the increase in lethargy in elastic collisions between neutrons and nuclei whose kinetic energy is negligible compared with that of the neutrons."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1>;
  <http://qudt.org/schema/qudt/informativeReference> "http://everything2.com/title/Average+logarithmic+energy+decrement+per+collision"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/isoNormativeReference> "http://www.iso.org/iso/catalogue_detail?csnumber=31895"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/plainTextDescription> "\"Average Logarithmic Energy Decrement\" is a measure of the amount of energy a neutron loses upon colliding with various nuclei. It is the average value of the increase in lethargy in elastic collisions between neutrons and nuclei whose kinetic energy is negligible compared with that of the neutrons.";
  <http://qudt.org/schema/qudt/latexSymbol> "$\\xi$"^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/applicableUnit> unit:UNITLESS .

<http://qudt.org/vocab/quantitykind/BindingFraction> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Binding Fraction"@en;
  rdfs:comment "Applicable units are those of quantitykind:BindingFraction";
  dct:description "The \"Binding Fraction\" is the ratio of the binding energy of a nucleus to the atomic mass number."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1>;
  <http://qudt.org/schema/qudt/informativeReference> "http://encyclopedia2.thefreedictionary.com/binding+fraction"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/symbol> "b";
  <http://qudt.org/schema/qudt/isoNormativeReference> "http://www.iso.org/iso/catalogue_detail?csnumber=31895"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/plainTextDescription> "The \"Binding Fraction\" is the ratio of the binding energy of a nucleus to the atomic mass number.";
  <http://qudt.org/schema/qudt/latexDefinition> "$b = \\frac{B_r}{A}$, where $B_r$ is the relative mass defect and $A$ is the nucleon number."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/applicableUnit> unit:UNITLESS .

<http://qudt.org/vocab/quantitykind/BioconcentrationFactor> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Bioconcentration Factor"@en;
  rdfs:comment "Applicable units are those of quantitykind:BioconcentrationFactor";
  dct:description "The bioconcentration factor is the ratio of the concentration of a chemical substance in biota over the concentration of the same chemical substance in water. It is related to the octanol-water partition coefficient."^^<http://qudt.org/schema/qudt/LatexString>;
  skos:broader <http://qudt.org/vocab/quantitykind/DimensionlessRatio>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1>;
  <http://qudt.org/schema/qudt/plainTextDescription> "The bioconcentration factor is the ratio of the concentration of a chemical substance in biota over the concentration of the same chemical substance in water. It is related to the octanol-water partition coefficient.";
  <http://qudt.org/schema/qudt/applicableUnit> unit:UNITLESS .

<http://qudt.org/vocab/quantitykind/CanonicalPartitionFunction> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Canonical Partition Function"@en;
  rdfs:comment "Applicable units are those of quantitykind:CanonicalPartitionFunction";
  dct:description "A \"Canonical Partition Function\" applies to a canonical ensemble, in which the system is allowed to exchange heat with the environment at fixed temperature, volume, and number of particles."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1>;
  <http://qudt.org/schema/qudt/informativeReference> "http://en.wikipedia.org/wiki/Partition_function_(statistical_mechanics)"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/symbol> "Z";
  <http://qudt.org/schema/qudt/isoNormativeReference> "http://www.iso.org/iso/catalogue_detail?csnumber=31894"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/plainTextDescription> "A \"Canonical Partition Function\" applies to a canonical ensemble, in which the system is allowed to exchange heat with the environment at fixed temperature, volume, and number of particles.";
  <http://qudt.org/schema/qudt/latexDefinition> "$Z = \\sum_r e^{-\\frac{E_r}{kT}}$, where the sum is over all quantum states consistent with given energy, volume, external fields, and content, $E_r$ is the energy in the $rth$ quantum state, $k$ is the Boltzmann constant, and $T$ is thermodynamic temperature."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/applicableUnit> unit:UNITLESS .

<http://qudt.org/vocab/quantitykind/Chromaticity> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Chromaticity"@en;
  rdfs:comment "Applicable units are those of quantitykind:Chromaticity";
  dct:description "Chromaticity is an objective specification of the quality of a color regardless of its luminance"^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1>;
  <http://qudt.org/schema/qudt/informativeReference> "https://en.wikipedia.org/wiki/Chromaticity"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/plainTextDescription> "Chromaticity is an objective specification of the quality of a color regardless of its luminance";
  <http://qudt.org/schema/qudt/applicableUnit> unit:UNITLESS .

<http://qudt.org/vocab/quantitykind/Constringence> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Constringence"@en;
  rdfs:comment "Applicable units are those of quantitykind:Constringence";
  dct:description "In optics and lens design, constringence of a transparent material, also known as the Abbe number or the V-number, is an approximate measure of the material's dispersion (change of refractive index versus wavelength), with high values of V indicating low dispersion."^^<http://qudt.org/schema/qudt/LatexString>;
  skos:altLabel "Abbe Number"@en, "V-number"@en;
  skos:broader <http://qudt.org/vocab/quantitykind/DimensionlessRatio>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1>;
  <http://qudt.org/schema/qudt/informativeReference> "https://en.wikipedia.org/wiki/Abbe_number"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/symbol> "V";
  <http://qudt.org/schema/qudt/applicableUnit> unit:UNITLESS .

<http://qudt.org/vocab/quantitykind/CouplingFactor> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Constantă de cuplaj"@ro, "constante de acoplamiento"@es, "constante de couplage"@fr,
    "coupling factor"@en, "fattore di accoppiamento"@it, "stała sprzężenia"@pl, "Çiftlenim sabiti"@tr,
    "Константа взаимодействия"@ru, "結合定数"@ja, "耦合常數"@zh;
  rdfs:comment "Applicable units are those of quantitykind:CouplingFactor";
  dct:description "\"Coupling Factor\" is the ratio of an electromagnetic quantity, usually voltage or current, appearing at a specified location of a given circuit to the corresponding quantity at a specified location in the circuit from which energy is transferred by coupling."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1>;
  <http://qudt.org/schema/qudt/informativeReference> "http://www.iso.org/iso/home/store/catalogue_tc/catalogue_detail.htm?csnumber=31891"^^xsd:anyURI,
    "http://www.electropedia.org/iev/iev.nsf/display?openform&ievref=161-03-18"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/symbol> "k";
  <http://qudt.org/schema/qudt/plainTextDescription> "\"Coupling Factor\" is the ratio of an electromagnetic quantity, usually voltage or current, appearing at a specified location of a given circuit to the corresponding quantity at a specified location in the circuit from which energy is transferred by coupling.";
  <http://qudt.org/schema/qudt/latexDefinition> "For inductive coupling between two inductive elements, $k = \\frac{\\left | L_{mn} \\right |}{\\sqrt{L_m L_n}}$, where $L_m$ and $L_n$ are their self inductances, and $L_{mn}$ is their mutual inductance."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/applicableUnit> unit:UNITLESS .

<http://qudt.org/vocab/quantitykind/Debye-WallerFactor> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Debye-Waller Factor"@en;
  rdfs:comment "Applicable units are those of quantitykind:Debye-WallerFactor";
  dct:description "\"Debye-Waller Factor\" (DWF), named after Peter Debye and Ivar Waller, is used in condensed matter physics to describe the attenuation of x-ray scattering or coherent neutron scattering caused by thermal motion. Also, a factor by which the intensity of a diffraction line is reduced because of the lattice vibrations."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1>;
  <http://qudt.org/schema/qudt/informativeReference> "http://en.wikipedia.org/wiki/Debye–Waller_factor"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/symbol> "D, B";
  <http://qudt.org/schema/qudt/isoNormativeReference> "http://www.iso.org/iso/catalogue_detail?csnumber=31897"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/plainTextDescription> "\"Debye-Waller Factor\" (DWF), named after Peter Debye and Ivar Waller, is used in condensed matter physics to describe the attenuation of x-ray scattering or coherent neutron scattering caused by thermal motion. Also, a factor by which the intensity of a diffraction line is reduced because of the lattice vibrations.";
  <http://qudt.org/schema/qudt/latexDefinition> "$u = R - R_0$, where $R$ is the particle position vector and $R_0$ is the equilibrium position vector of a particle."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/applicableUnit> unit:UNITLESS .

<http://qudt.org/vocab/quantitykind/DegreeOfDissociation> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Degree of Dissociation"@en;
  rdfs:comment "Applicable units are those of quantitykind:DegreeOfDissociation";
  dct:description "The \"Degree of Dissociation\" is the fraction of original solute molecules that have dissociated."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/dbpediaMatch> "http://dbpedia.org/resource/Faraday_constant"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1>;
  <http://qudt.org/schema/qudt/informativeReference> "http://en.wikipedia.org/wiki/Dissociation_(chemistry)"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/isoNormativeReference> "http://www.iso.org/iso/catalogue_detail?csnumber=31894"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/plainTextDescription> "The \"Degree of Dissociation\" is the fraction of original solute molecules that have dissociated.";
  <http://qudt.org/schema/qudt/latexSymbol> "$\\alpha$"^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/applicableUnit> unit:UNITLESS .

<http://qudt.org/vocab/quantitykind/Dissipance> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Dissipance"@en;
  rdfs:comment "Applicable units are those of quantitykind:Dissipance";
  dct:description "Dissipance, or dissipation factor for sound power, is the ratio of dissipated sound power to incident sound power. The dissipation factor (DF) is a measure of loss-rate of energy of a mode of oscillation (mechanical, electrical, or electromechanical) in a dissipative system. It is the reciprocal of quality factor, which represents the quality of oscillation."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1>;
  <http://qudt.org/schema/qudt/informativeReference> "http://en.wikipedia.org/wiki/Dissipation_factor"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/plainTextDescription> "Dissipance, or dissipation factor for sound power, is the ratio of dissipated sound power to incident sound power. The dissipation factor (DF) is a measure of loss-rate of energy of a mode of oscillation (mechanical, electrical, or electromechanical) in a dissipative system. It is the reciprocal of quality factor, which represents the quality of oscillation.";
  <http://qudt.org/schema/qudt/latexSymbol> "$\\delta$"^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/latexDefinition> "$\\delta = \\frac{P_d}{P_i}$, where $P_d$ is the dissipated sound power, and $P_i$ is the incident sound power."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://www.linkedmodel.org/schema/vaem#todo> "belongs to SOQ-ISO";
  <http://qudt.org/schema/qudt/applicableUnit> unit:UNITLESS .

<http://qudt.org/vocab/quantitykind/DoseEquivalentQualityFactor> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Dose Equivalent Quality Factor"@en;
  rdfs:comment "Applicable units are those of quantitykind:DoseEquivalentQualityFactor";
  dct:description "\"Dose Equivalent Quality Factor\" is a factor in the caculation and measurement of dose equivalent, by which the absorbed dose is to be weighted in order to account for different biological effectiveness of radiations, for radiation protection purposes."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1>;
  <http://qudt.org/schema/qudt/informativeReference> "http://en.wikipedia.org/wiki/Equivalent_dose"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/symbol> "Q";
  <http://qudt.org/schema/qudt/isoNormativeReference> "http://www.iso.org/iso/catalogue_detail?csnumber=31895"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/plainTextDescription> "\"Dose Equivalent Quality Factor\" is a factor in the caculation and measurement of dose equivalent, by which the absorbed dose is to be weighted in order to account for different biological effectiveness of radiations, for radiation protection purposes.";
  <http://qudt.org/schema/qudt/applicableUnit> unit:UNITLESS .

<http://qudt.org/vocab/quantitykind/Duv> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:seeAlso <http://qudt.org/vocab/quantitykind/CorrelatedColorTemperature>;
  rdfs:label "Delta u,v"@en;
  rdfs:comment "Applicable units are those of quantitykind:Duv";
  dct:description "Duv is a metric that is short for Delta u,v (not to be confused with Delta u',v') and describes the distance of a light color point from the black body curve."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1>;
  <http://qudt.org/schema/qudt/informativeReference> "https://www.waveformlighting.com/tech/calculate-duv-from-cie-1931-xy-coordinates"^^xsd:anyURI,
    "https://www1.eere.energy.gov/buildings/publications/pdfs/ssl/led-color-characteristics-factsheet.pdf"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/plainTextDescription> "Duv is a metric that is short for Delta u,v (not to be confused with Delta u',v') and describes the distance of a light color point from the black body curve.";
  <http://qudt.org/schema/qudt/applicableUnit> unit:UNITLESS .

<http://qudt.org/vocab/quantitykind/EinsteinTransitionProbability> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Einstein Transition Probability"@en;
  rdfs:comment "Applicable units are those of quantitykind:EinsteinTransitionProbability";
  dct:description "Given two atomic states of energy $E_j$ and $E_k$.  Let $E_j > E_k$.  Assume the atom is bathed in radiation of energy density $u(w)$.  Transitions between these states can take place in three different ways. Spontaneous, induced/stimulated emission, and induced absorption. $A_jk$ represents the Einstein transition probability for spontaneous emission."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1>;
  <http://qudt.org/schema/qudt/informativeReference> "http://electron6.phys.utk.edu/qm2/modules/m10/einstein.htm"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/symbol> "A_jkN_j";
  <http://qudt.org/schema/qudt/latexDefinition> "$\\frac{-dN_j}{dt} = A_jkN_j$, where $-dN_j$ is the number of molecules spontaneously leaving the state j for the state k during a time interval of duration $dt$, $N_j$ is the number of molecules in the state j, and $E_j > E_k$."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/applicableUnit> unit:UNITLESS .

<http://qudt.org/vocab/quantitykind/ElectricSusceptibility> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:seeAlso <http://qudt.org/vocab/quantitykind/ElectricPolarization>, <http://qudt.org/vocab/quantitykind/ElectricFieldStrength>;
  rdfs:label "electric susceptibility"@en, "elektrische Suszeptibilität"@de, "podatność elektryczna"@pl,
    "susceptibilidad eléctrica"@es, "susceptibilidade eléctrica"@pt, "susceptibilité électrique"@fr,
    "suscettività elettrica"@it, "электрическая восприимчивость"@ru, "المتأثرية الكهربائية، سرعة التأثر الكهربائية"@ar,
    "電気感受率"@ja;
  rdfs:comment "Applicable units are those of quantitykind:ElectricSusceptibility";
  dct:description "\"Electric Susceptibility\" is the ratio of electric polarization to electric field strength, normalized to the electric constant. The definition applies to an isotropic medium. For an anisotropic medium, electric susceptibility is a second order tensor."^^<http://qudt.org/schema/qudt/LatexString>;
  skos:altLabel "susceptywność elektryczna"@pl, "диэлектрическая восприимчивость"@ru;
  <http://qudt.org/schema/qudt/dbpediaMatch> "http://dbpedia.org/resource/Permittivity"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1>;
  <http://qudt.org/schema/qudt/informativeReference> "http://www.iso.org/iso/home/store/catalogue_tc/catalogue_detail.htm?csnumber=31891"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/expression> "$e-susceptibility$"^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/plainTextDescription> "\"Electric Susceptibility\" is the ratio of electric polarization to electric field strength, normalized to the electric constant. The definition applies to an isotropic medium. For an anisotropic medium, electric susceptibility is a second order tensor.";
  <http://qudt.org/schema/qudt/latexSymbol> "$\\chi$"^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/latexDefinition> "$\\chi = \\frac{P}{(\\epsilon_0 E)}$, where $P$ is electric polorization, $\\epsilon_0$ is the electric constant, and $E$ is electric field strength."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/applicableUnit> unit:UNITLESS .

<http://qudt.org/vocab/quantitykind/Emissivity> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Emissivity"@en;
  rdfs:comment "Applicable units are those of quantitykind:Emissivity";
  dct:description "Emissivity of a material (usually written $\\varepsilon$ or e) is the relative ability of its surface to emit energy by radiation."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1>;
  <http://qudt.org/schema/qudt/informativeReference> "http://en.wikipedia.org/wiki/Emissivity"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/latexSymbol> "$\\varepsilon$"^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/latexDefinition> "$\\varepsilon = \\frac{M}{M_b}$, where $M$ is the radiant exitance of a thermal radiator and $M_b$ is the radiant exitance of a blackbody at the same temperature."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/applicableUnit> unit:UNITLESS .

<http://qudt.org/vocab/quantitykind/EquilibriumConstant> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:seeAlso <http://qudt.org/vocab/quantitykind/EquilibriumConstantOnConcentrationBasis>,
    <http://qudt.org/vocab/quantitykind/EquilibriumConstantOnPressureBasis>;
  rdfs:label "Equilibrium Constant"@en;
  rdfs:comment "Applicable units are those of quantitykind:EquilibriumConstant";
  dct:description "The \"Equlilbrium Constant\", also known as the thermodynamic equilibrium constant, is an expression that gives us a ratio of the products and reactants of a reaction at equilibrium with respect to a specific unit."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1>;
  <http://qudt.org/schema/qudt/informativeReference> "http://en.wikipedia.org/wiki/Equilibrium_constant"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/isoNormativeReference> "http://www.iso.org/iso/catalogue_detail?csnumber=31894"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/plainTextDescription> "The \"Equlilbrium Constant\", also known as the thermodynamic equilibrium constant, is an expression that gives us a ratio of the products and reactants of a reaction at equilibrium with respect to a specific unit.";
  <http://qudt.org/schema/qudt/latexSymbol> "$K^\\Theta$"^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/latexDefinition> "$K^\\Theta = \\Pi_B(\\lambda_B^\\Theta)^{-\\nu_B}$, where $\\Pi_B$ denotes the product for all substances $B$, $\\lambda_B^\\Theta$ is the standard absolute activity of substance $B$, and $\\nu_B$ is the stoichiometric number of the substance $B$."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/applicableUnit> unit:UNITLESS .

<http://qudt.org/vocab/quantitykind/FastFissionFactor> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Fast Fission Factor"@en;
  rdfs:comment "Applicable units are those of quantitykind:FastFissionFactor";
  dct:description "\"Fast Fission Factor\" in an infinite medium, is the ratio of the mean number of neutrons produced by fission due to neutrons of all energies to the mean number of neutrons produced by fissions due to thermal neutrons only."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1>;
  <http://qudt.org/schema/qudt/informativeReference> "http://en.wikipedia.org/wiki/Four_factor_formula"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/isoNormativeReference> "http://www.iso.org/iso/catalogue_detail?csnumber=31895"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/plainTextDescription> "\"Fast Fission Factor\" in an infinite medium, is the ratio of the mean number of neutrons produced by fission due to neutrons of all energies to the mean number of neutrons produced by fissions due to thermal neutrons only.";
  <http://qudt.org/schema/qudt/latexSymbol> "$\\varphi$"^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/applicableUnit> unit:UNITLESS .

<http://qudt.org/vocab/quantitykind/GFactorOfNucleus> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "g-Factor of Nucleus"@en;
  rdfs:comment "Applicable units are those of quantitykind:GFactorOfNucleus";
  dct:description "The \"g-Factor of Nucleus\" is associated with the spin and magnetic moments of protons, neutrons, and many nuclei."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1>;
  <http://qudt.org/schema/qudt/informativeReference> "http://en.wikipedia.org/wiki/Landé_g-factor"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/symbol> "g";
  <http://qudt.org/schema/qudt/isoNormativeReference> "http://www.iso.org/iso/catalogue_detail?csnumber=31895"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/plainTextDescription> "The \"g-Factor of Nucleus\" is associated with the spin and magnetic moments of protons, neutrons, and many nuclei.";
  <http://qudt.org/schema/qudt/latexDefinition> "$g = \\frac{\\mu}{I\\mu_B}$, where $\\mu$ is the magnitude of magnetic dipole moment, $I$ is the nuclear angular momentum quantum number, and $\\mu_B$ is the Bohr magneton."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/applicableUnit> unit:UNITLESS .

<http://qudt.org/vocab/quantitykind/GeneralizedCoordinate> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Generalized Coordinate"@en;
  rdfs:comment "Applicable units are those of quantitykind:GeneralizedCoordinate";
  dct:description "Generalized Coordinates refers to the parameters that describe the configuration of the system relative to some reference configuration. These parameters must uniquely define the configuration of the system relative to the reference configuration."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1>;
  <http://qudt.org/schema/qudt/informativeReference> "http://en.wikipedia.org/wiki/Generalized_coordinates"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/symbol> "q_i";
  <http://qudt.org/schema/qudt/isoNormativeReference> "http://www.iso.org/iso/catalogue_detail?csnumber=31889"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/plainTextDescription> "Generalized Coordinates refers to the parameters that describe the configuration of the system relative to some reference configuration. These parameters must uniquely define the configuration of the system relative to the reference configuration.";
  <http://qudt.org/schema/qudt/latexDefinition> "$q_i$, where $q_i$ is one of the coordinates that is used to describe the position of the system under consideration, and $N$ is the lowest number of coordinates necessary to fully define the position of the system."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/applicableUnit> unit:UNITLESS .

<http://qudt.org/vocab/quantitykind/GeneralizedForce> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Generalized Force"@en;
  rdfs:comment "Applicable units are those of quantitykind:GeneralizedForce";
  dct:description "Generalized Forces find use in Lagrangian mechanics, where they play a role conjugate to generalized coordinates."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1>;
  <http://qudt.org/schema/qudt/informativeReference> "http://en.wikipedia.org/wiki/Generalized_forces"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/symbol> "Q_i";
  <http://qudt.org/schema/qudt/isoNormativeReference> "http://www.iso.org/iso/catalogue_detail?csnumber=31889"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/plainTextDescription> "Generalized Forces find use in Lagrangian mechanics, where they play a role conjugate to generalized coordinates.";
  <http://qudt.org/schema/qudt/latexDefinition> "$\\delta A = \\sum Q_i\\delta q_i$, where $A$ is work and $q_i$ is a generalized coordinate."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/applicableUnit> unit:UNITLESS .

<http://qudt.org/vocab/quantitykind/GeneralizedMomentum> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Generalized Force"@en;
  rdfs:comment "Applicable units are those of quantitykind:GeneralizedMomentum";
  dct:description "Generalized Momentum, also known as the canonical or conjugate momentum, extends the concepts of both linear momentum and angular momentum. To distinguish it from generalized momentum, the product of mass and velocity is also referred to as mechanical, kinetic or kinematic momentum."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1>;
  <http://qudt.org/schema/qudt/informativeReference> "http://en.wikipedia.org/wiki/Momentum"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/symbol> "p_i";
  <http://qudt.org/schema/qudt/isoNormativeReference> "http://www.iso.org/iso/catalogue_detail?csnumber=31889"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/plainTextDescription> "Generalized Momentum, also known as the canonical or conjugate momentum, extends the concepts of both linear momentum and angular momentum. To distinguish it from generalized momentum, the product of mass and velocity is also referred to as mechanical, kinetic or kinematic momentum.";
  <http://qudt.org/schema/qudt/latexDefinition> "$p_i = \\frac{\\partial L}{\\partial \\dot{q_i}}$, where $L$ is the Langrange function and $\\dot{q_i}$ is a generalized velocity."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/applicableUnit> unit:UNITLESS .

<http://qudt.org/vocab/quantitykind/GeneralizedVelocity> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Generalized Velocity"@en;
  rdfs:comment "Applicable units are those of quantitykind:GeneralizedVelocity";
  dct:description "Generalized Velocities are the time derivatives of the generalized coordinates of the system."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1>;
  <http://qudt.org/schema/qudt/informativeReference> "http://en.wikipedia.org/wiki/Generalized_coordinates"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/isoNormativeReference> "http://www.iso.org/iso/catalogue_detail?csnumber=31889"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/plainTextDescription> "Generalized Velocities are the time derivatives of the generalized coordinates of the system.";
  <http://qudt.org/schema/qudt/latexSymbol> "$\\dot{q_i}$"^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/latexDefinition> "$\\dot{q_i} = \\frac{dq_i}{dt}$, where $q_i$ is the generalized coordinate and $t$ is time."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/applicableUnit> unit:UNITLESS .

<http://qudt.org/vocab/quantitykind/GruneisenParameter> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Gruneisen Parameter"@en;
  rdfs:comment "Applicable units are those of quantitykind:GruneisenParameter";
  dct:description "\"Gruneisen Parameter\" named after Eduard Grüneisen, describes the effect that changing the volume of a crystal lattice has on its vibrational properties, and, as a consequence, the effect that changing temperature has on the size or dynamics of the lattice."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1>;
  <http://qudt.org/schema/qudt/informativeReference> "http://en.wikipedia.org/wiki/Grüneisen_parameter"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/isoNormativeReference> "http://www.iso.org/iso/catalogue_detail?csnumber=31897"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/plainTextDescription> "\"Gruneisen Parameter\" named after Eduard Grüneisen, describes the effect that changing the volume of a crystal lattice has on its vibrational properties, and, as a consequence, the effect that changing temperature has on the size or dynamics of the lattice.";
  <http://qudt.org/schema/qudt/latexSymbol> "$\\gamma$"^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/latexDefinition> "$\\gamma = \\frac{\\alpha_V}{x_T c_V\\rho}$, where $\\alpha_V$ is the cubic expansion coefficient, $x_T$ is isothermal compressibility, $c_V$ is specific heat capacity at constant volume, and $\\rho$ is mass density."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/applicableUnit> unit:UNITLESS .

<http://qudt.org/vocab/quantitykind/InternalConversionFactor> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "InternalConversionFactor"@en;
  rdfs:comment "Applicable units are those of quantitykind:InternalConversionFactor";
  dct:description "The \"InternalConversionFactor\" describes the rate of internal conversion. It is the ratio of the number of internal conversion electrons to the number of gamma quanta emitted by the radioactive atom in a given transition."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1>;
  <http://qudt.org/schema/qudt/informativeReference> "http://en.wikipedia.org/wiki/Internal_conversion_coefficient"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/symbol> "a";
  <http://qudt.org/schema/qudt/isoNormativeReference> "http://www.iso.org/iso/catalogue_detail?csnumber=31895"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/plainTextDescription> "The \"InternalConversionFactor\" describes the rate of internal conversion. It is the ratio of the number of internal conversion electrons to the number of gamma quanta emitted by the radioactive atom in a given transition.";
  <http://qudt.org/schema/qudt/applicableUnit> unit:UNITLESS .

<http://qudt.org/vocab/quantitykind/IsentropicExponent> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:seeAlso <http://qudt.org/vocab/quantitykind/IsentropicCompressibility>;
  rdfs:label "Coefficiente di dilatazione adiabatica"@it, "Coeficient de transformare adiabatică"@ro,
    "Coeficiente de dilatación adiabática"@es, "Coeficiente de expansão adiabática"@pt,
    "Isentropenexponent"@de, "Poissonova konstanta"@cs, "Wykładnik adiabaty"@pl, "adiabatni eksponent"@sl,
    "exposant isoentropique"@fr, "isentropic exponent"@en, "ısı sığası oranı; adyabatik indeks"@tr,
    "Показатель адиабаты"@ru, "نسبة السعة الحرارية"@ar, "比熱比"@ja, "绝热指数"@zh;
  rdfs:comment "Applicable units are those of quantitykind:IsentropicExponent";
  dct:description """
  $\\textit{Isentropic Exponent}$ is a variant of $\\textit{Specific Heat Ratio Capacities}$. 
  For an ideal gas $\\textit{Isentropic Exponent}$, $\\varkappa$. is equal to $\\gamma$,
   the ratio of its specific heat capacities $c_p$ and $c_v$ under steady pressure and volume.
  """^^<http://qudt.org/schema/qudt/LatexString>;
  skos:altLabel "indice adiabatico"@it, "indice adiabatique"@fr;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1>;
  <http://qudt.org/schema/qudt/informativeReference> "http://en.wikipedia.org/wiki/Compressibility"^^xsd:anyURI,
    "http://en.citizendium.org/wiki/Specific_heat_ratio"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/isoNormativeReference> "http://www.iso.org/iso/catalogue_detail?csnumber=31890"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/latexSymbol> "$\\varkappa$"^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/latexDefinition> "$\\varkappa = -\\frac{V}{p}\\left \\{  \\frac{\\partial p}{\\partial  V}\\right \\}_S$, where $V$ is volume, $p$ is pressure, and $S$ is entropy."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/applicableUnit> unit:UNITLESS .

<http://qudt.org/vocab/quantitykind/LandeGFactor> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Lande g-Factor"@en;
  rdfs:comment "Applicable units are those of quantitykind:LandeGFactor";
  dct:description "The \"Lande g-Factor\" is a particular example of a g-factor, namely for an electron with both spin and orbital angular momenta. It is named after Alfred Landé, who first described it in 1921."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1>;
  <http://qudt.org/schema/qudt/informativeReference> "http://en.wikipedia.org/wiki/Landé_g-factor"^^xsd:anyURI,
    "http://en.wikipedia.org/wiki/G-factor_(physics)"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/symbol> "g";
  <http://qudt.org/schema/qudt/isoNormativeReference> "http://www.iso.org/iso/catalogue_detail?csnumber=31895"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/plainTextDescription> "The \"Lande g-Factor\" is a particular example of a g-factor, namely for an electron with both spin and orbital angular momenta. It is named after Alfred Landé, who first described it in 1921.";
  <http://qudt.org/schema/qudt/latexDefinition> "$g = \\frac{\\mu}{J\\mu_B}$, where $\\mu$ is the magnitude of magnetic dipole moment, $J$ is the total angular momentum quantum number, and $\\mu_B$ is the Bohr magneton."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/applicableUnit> unit:UNITLESS .

<http://qudt.org/vocab/quantitykind/LeakageFactor> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Leakage Factor"@en;
  rdfs:comment "Applicable units are those of quantitykind:LeakageFactor";
  dct:description "\"Leakage Factor\" is the ratio of the total magnetic flux to the useful magnetic flux of a magnetic circuit."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1>;
  <http://qudt.org/schema/qudt/informativeReference> "http://www.iso.org/iso/home/store/catalogue_tc/catalogue_detail.htm?csnumber=31891"^^xsd:anyURI,
    "http://www.electropedia.org/iev/iev.nsf/display?openform&ievref=221-04-12"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/expression> "$leakage-factor$"^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/plainTextDescription> "\"Leakage Factor\" is the ratio of the total magnetic flux to the useful magnetic flux of a magnetic circuit.";
  <http://qudt.org/schema/qudt/latexSymbol> "$\\sigma$"^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/latexDefinition> "$\\sigma = 1 - k^2$, where $k$ is the coupling factor."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/applicableUnit> unit:UNITLESS .

<http://qudt.org/vocab/quantitykind/Lethargy> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Lethargy"@en;
  rdfs:comment "Applicable units are those of quantitykind:Lethargy";
  dct:description "The \"Lethargy\" is a dimensionless logarithm of the ratio of the energy of source neutrons to the energy of neutrons after a collision."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1>;
  <http://qudt.org/schema/qudt/informativeReference> "http://www.scribd.com/doc/51548050/149/Lethargy"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/symbol> "u";
  <http://qudt.org/schema/qudt/isoNormativeReference> "http://www.iso.org/iso/catalogue_detail?csnumber=31895"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/plainTextDescription> "The \"Lethargy\" is a dimensionless logarithm of the ratio of the energy of source neutrons to the energy of neutrons after a collision.";
  <http://qudt.org/schema/qudt/latexDefinition> "$u = \\ln(\\frac{E_0}{E})$, where $E_0$ is a reference energy."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/applicableUnit> unit:UNITLESS .

<http://qudt.org/vocab/quantitykind/LogOctanolAirPartitionCoefficient> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Octanol Air Partition Coefficient"@en;
  rdfs:comment "Applicable units are those of quantitykind:LogOctanolAirPartitionCoefficient";
  dct:description "A dimensionless ratio that is the logarithm of the ratio of a compound's concentration within a two phase mixture of liquid octanol and gaseous air at equilibrium.  More simply, it is a comparison of the solubilities of the compound solute in these two immiscible substances."^^<http://qudt.org/schema/qudt/LatexString>;
  skos:broader <http://qudt.org/vocab/quantitykind/DimensionlessRatio>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1>;
  <http://qudt.org/schema/qudt/plainTextDescription> "A dimensionless ratio that is the logarithm of the ratio of a compound's concentration within a two phase mixture of liquid octanol and gaseous air at equilibrium.  More simply, it is a comparison of the solubilities of the compound solute in these two immiscible substances.";
  <http://qudt.org/schema/qudt/applicableUnit> unit:UNITLESS .

<http://qudt.org/vocab/quantitykind/LogOctanolWaterPartitionCoefficient> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Logarithm of Octanol Water Partition Coefficient"@en;
  rdfs:comment "Applicable units are those of quantitykind:LogOctanolWaterPartitionCoefficient";
  dct:description "A dimensionless ratio that is the logarithm of the ratio of a compound's concentration within a two phase mixture of octanol and water at equilibrium.  More simply, it is a comparison of the solubilities of the compound solute in these two immiscible liquids.  This property is used to measure the lipophilicity and the hydrophilicity of a substance."^^<http://qudt.org/schema/qudt/LatexString>;
  skos:broader <http://qudt.org/vocab/quantitykind/DimensionlessRatio>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1>;
  <http://qudt.org/schema/qudt/plainTextDescription> "A dimensionless ratio that is the logarithm of the ratio of a compound's concentration within a two phase mixture of octanol and water at equilibrium.  More simply, it is a comparison of the solubilities of the compound solute in these two immiscible liquids.  This property is used to measure the lipophilicity and the hydrophilicity of a substance.";
  <http://qudt.org/schema/qudt/applicableUnit> unit:UNITLESS .

<http://qudt.org/vocab/quantitykind/Long-RangeOrderParameter> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Long-Range Order Parameter"@en;
  rdfs:comment "Applicable units are those of quantitykind:Long-RangeOrderParameter";
  dct:description "\"Long-Range Order Parameter\" is the fraction of atoms in an Ising ferromagnet having magnetic moments in one direction, minus the fraction having magnetic moments in the opposite direction."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1>;
  <http://qudt.org/schema/qudt/symbol> "R, s";
  <http://qudt.org/schema/qudt/isoNormativeReference> "http://www.iso.org/iso/catalogue_detail?csnumber=31897"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/plainTextDescription> "\"Long-Range Order Parameter\" is the fraction of atoms in an Ising ferromagnet having magnetic moments in one direction, minus the fraction having magnetic moments in the opposite direction.";
  <http://qudt.org/schema/qudt/applicableUnit> unit:UNITLESS .

<http://qudt.org/vocab/quantitykind/LossFactor> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:seeAlso <http://qudt.org/vocab/quantitykind/Resistance>, <http://qudt.org/vocab/quantitykind/Reactance>,
    <http://qudt.org/vocab/quantitykind/QualityFactor>;
  rdfs:label "Loss Factor"@en;
  rdfs:comment "Applicable units are those of quantitykind:LossFactor";
  dct:description """
  $\\textit{Loss Factor}$ is the inverse of $\\textit{Quality Factor}$ and is the ratio of the $\\textit{resistance}$ and modulus of $\\textit{reactance}$.
  """^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1>;
  <http://qudt.org/schema/qudt/informativeReference> "http://www.iso.org/iso/home/store/catalogue_tc/catalogue_detail.htm?csnumber=31891"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/symbol> "d";
  <http://qudt.org/schema/qudt/plainTextDescription> "Loss Factor is the inverse of Quality Factor and is the ratio of the resistance and modulus of reactance.";
  <http://qudt.org/schema/qudt/latexDefinition> "$d = \\frac{1}{Q}$, where $Q$ is quality factor."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/applicableUnit> unit:UNITLESS .

<http://qudt.org/vocab/quantitykind/MadelungConstant> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Constante de Madelung"@es, "Constante de Madelung"@fr, "Costante di Madelung"@it,
    "Madelung constant"@en, "Madelung-Konstante"@de, "Stała Madelunga"@pl, "constante de Madelung"@pt,
    "постоянная Маделунга"@ru, "ثابت مادلونك"@ar, "ثابت مادلونگ"@fa, "マーデルングエネルギー"@ja,
    "馬德隆常數"@zh;
  rdfs:comment "Applicable units are those of quantitykind:MadelungConstant";
  dct:description "\"Madelung Constant\" is used in determining the electrostatic potential of a single ion in a crystal by approximating the ions by point charges. It is named after Erwin Madelung, a German physicist."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1>;
  <http://qudt.org/schema/qudt/informativeReference> "http://en.wikipedia.org/wiki/Madelung_constant"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/isoNormativeReference> "http://www.iso.org/iso/catalogue_detail?csnumber=31897"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/plainTextDescription> "\"Madelung Constant\" is used in determining the electrostatic potential of a single ion in a crystal by approximating the ions by point charges. It is named after Erwin Madelung, a German physicist.";
  <http://qudt.org/schema/qudt/latexSymbol> "$\\alpha$"^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/latexDefinition> "For a uni-univalent ionic crystal of specified structure, the binding energy $V_b$ per pair of ions is $V_b = \\alpha\\frac{e^2}{4\\pi \\varepsilon_0 a}$, where $e$ is the elementary charge, $\\varepsilon_0$ is the electric constant, and $a$ is the lattice constant which should be specified."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/applicableUnit> unit:UNITLESS .

<http://qudt.org/vocab/quantitykind/MagneticSusceptability> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:seeAlso <http://qudt.org/vocab/quantitykind/MagneticFieldStrength_H>, <http://qudt.org/vocab/constant/MagneticConstant>,
    <http://qudt.org/vocab/quantitykind/Magnetization>;
  rdfs:label "Magnetic Susceptability"@en;
  rdfs:comment "Applicable units are those of quantitykind:MagneticSusceptability";
  dct:description "\"Magnetic Susceptability\" is a scalar or tensor quantity the product of which by the magnetic constant $\\mu_0$ and by the magnetic field strength $H$ is equal to the magnetic polarization $J$. The definition given applies to an isotropic medium. For an anisotropic medium permeability is a second order tensor."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1>;
  <http://qudt.org/schema/qudt/informativeReference> "http://www.iso.org/iso/home/store/catalogue_tc/catalogue_detail.htm?csnumber=31891"^^xsd:anyURI,
    "http://www.electropedia.org/iev/iev.nsf/display?openform&ievref=121-12-37"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/expression> "$\\kappa = \\frac{M}{H}$"^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/latexSymbol> "$\\kappa$"^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/latexDefinition> "$\\kappa = \\frac{M}{H}$,  where $M$ is magnetization,  and $H$ is magnetic field strength."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/applicableUnit> unit:UNITLESS .

<http://qudt.org/vocab/quantitykind/MassFraction> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Mass Fraction"@en;
  rdfs:comment "Applicable units are those of quantitykind:MassFraction";
  dct:description "The \"Mass Fraction\" is the fraction of one substance with mass to the mass of the total mixture ."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1>;
  <http://qudt.org/schema/qudt/informativeReference> "http://en.wikipedia.org/wiki/Mass_fraction_(chemistry)"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/symbol> "w_B";
  <http://qudt.org/schema/qudt/isoNormativeReference> "http://www.iso.org/iso/catalogue_detail?csnumber=31894"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/plainTextDescription> "The \"Mass Fraction\" is the fraction of one substance with mass to the mass of the total mixture .";
  <http://qudt.org/schema/qudt/latexDefinition> "$w_B = \\frac{m_B}{m}$, where $m_B$ is the mass of substance $B$ and $m$ is the total."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/applicableUnit> unit:UNITLESS .

<http://qudt.org/vocab/quantitykind/MassFractionOfDryMatter> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:seeAlso <http://qudt.org/vocab/quantitykind/MassFractionOfWater>;
  rdfs:label "Mass Fraction of Dry Matter"@en;
  rdfs:comment "Applicable units are those of quantitykind:MassFractionOfDryMatter";
  dct:description "\"Mass Fraction of Dry Matter\" is one of a number of $\\textit{Concentration}$ quantities defined by ISO 80000."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1>;
  <http://qudt.org/schema/qudt/symbol> "w_d";
  <http://qudt.org/schema/qudt/isoNormativeReference> "http://www.iso.org/iso/catalogue_detail?csnumber=31890"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/plainTextDescription> "\"Mass Fraction of Dry Matter\" is one of a number of Concentration quantities defined by ISO 80000.";
  <http://qudt.org/schema/qudt/latexDefinition> "$w_d= 1 - w_{h2o}$, where $w_{h2o}$ is mass fraction of water."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/applicableUnit> unit:UNITLESS .

<http://qudt.org/vocab/quantitykind/MassFractionOfWater> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:seeAlso <http://qudt.org/vocab/quantitykind/MassFractionOfDryMatter>;
  rdfs:label "Mass Fraction of Water"@en;
  rdfs:comment "Applicable units are those of quantitykind:MassFractionOfWater";
  dct:description "\"Mass Fraction of Water\" is one of a number of $\\textit{Concentration}$ quantities defined by ISO 80000."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1>;
  <http://qudt.org/schema/qudt/symbol> "w_{H_2o}";
  <http://qudt.org/schema/qudt/isoNormativeReference> "http://www.iso.org/iso/catalogue_detail?csnumber=31890"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/plainTextDescription> "Mass Fraction of Water is one of a number of Concentration quantities defined by ISO 80000.";
  <http://qudt.org/schema/qudt/latexDefinition> "$w_{H_2o} = \\frac{u}{1+u}$, where $u$ is mass ratio of water to dry water."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/applicableUnit> unit:UNITLESS .

<http://qudt.org/vocab/quantitykind/MassRatioOfWaterToDryMatter> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Mass Concentration of Water To Dry Matter"@en;
  rdfs:comment "Applicable units are those of quantitykind:MassRatioOfWaterToDryMatter";
  dct:description "\"Mass Ratio of Water to Dry Matter\" is one of a number of $\\textit{Concentration Ratio}$ quantities defined by ISO 80000."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1>;
  <http://qudt.org/schema/qudt/symbol> "u";
  <http://qudt.org/schema/qudt/isoNormativeReference> "http://www.iso.org/iso/catalogue_detail?csnumber=31890"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/plainTextDescription> "Mass Ratio of Water to Dry Matter is one of a number of Concentration Ratio quantities defined by ISO 80000.";
  <http://qudt.org/schema/qudt/latexDefinition> "$u = m/m_d$, where $m$ is mass of water vapour and $m_d$ is mass of dry matter. Mass ratio of water to dry matter at saturation is denoted $u_{sat}$."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/applicableUnit> unit:UNITLESS .

<http://qudt.org/vocab/quantitykind/MassRatioOfWaterVapourToDryGas> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Mass Ratio of Water Vapour to Dry Gas"@en;
  rdfs:comment "Applicable units are those of quantitykind:MassRatioOfWaterVapourToDryGas";
  dct:description "\"Mass Ratio of Water Vapour to Dry Gas\" is one of a number of $\\textit{Concentration Ratio}$ quantities defined by ISO 80000."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1>;
  <http://qudt.org/schema/qudt/symbol> "x";
  <http://qudt.org/schema/qudt/isoNormativeReference> "http://www.iso.org/iso/catalogue_detail?csnumber=31890"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/plainTextDescription> "Mass Ratio of Water Vapour to Dry Gas is one of a number of Concentration Ratio quantities defined by ISO 80000.";
  <http://qudt.org/schema/qudt/latexDefinition> "$x = m/m_d$, where $m$ is mass of water vapour and $m_d$ is mass of dry gas. Mass ratio of water vapour to dry gas  at saturation is denoted $x_{sat}$."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/applicableUnit> unit:UNITLESS .

<http://qudt.org/vocab/quantitykind/MobilityRatio> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Mobility Ratio"@en;
  rdfs:comment "Applicable units are those of quantitykind:MobilityRatio";
  dct:description "\"MobilityRatio\" describes permeability of a porous material to a given phase divided by the viscosity of that phase."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1>;
  <http://qudt.org/schema/qudt/symbol> "b";
  <http://qudt.org/schema/qudt/isoNormativeReference> "http://www.iso.org/iso/catalogue_detail?csnumber=31897"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/plainTextDescription> "\"MobilityRatio\" describes permeability of a porous material to a given phase divided by the viscosity of that phase.";
  <http://qudt.org/schema/qudt/latexDefinition> "$b = \\frac{\\mu_n}{\\mu_p}$, where $\\mu_n$ and $\\mu_p$ are mobilities for electrons and holes, respectively."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/applicableUnit> unit:UNITLESS .

<http://qudt.org/vocab/quantitykind/MultiplicationFactor> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Multiplication Factor"@en;
  rdfs:comment "Applicable units are those of quantitykind:MultiplicationFactor";
  dct:description "The \"Multiplication Factor\" is the ratio of the total number of fission or fission-dependent neutrons produced in a time interval to the total number of neutrons lost by absorption and leakage during the same interval."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1>;
  <http://qudt.org/schema/qudt/informativeReference> "http://en.wikipedia.org/wiki/Neutron_multiplication_factor"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/symbol> "k";
  <http://qudt.org/schema/qudt/isoNormativeReference> "http://www.iso.org/iso/catalogue_detail?csnumber=31895"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/plainTextDescription> "The \"Multiplication Factor\" is the ratio of the total number of fission or fission-dependent neutrons produced in a time interval to the total number of neutrons lost by absorption and leakage during the same interval.";
  <http://qudt.org/schema/qudt/applicableUnit> unit:UNITLESS .

<http://qudt.org/vocab/quantitykind/NapierianAbsorbance> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Napierian Absorbance"@en;
  rdfs:comment "Applicable units are those of quantitykind:NapierianAbsorbance";
  dct:description "Napierian Absorbance is the natural (Napierian) logarithm of the reciprocal of the spectral internal transmittance."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1>;
  <http://qudt.org/schema/qudt/informativeReference> "https://en.wikipedia.org/wiki/Absorbance#Beer-Lambert_law"^^xsd:anyURI,
    "https://en.wikipedia.org/wiki/Beer%E2%80%93Lambert_law#Formulation"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/symbol> "A_e, B";
  <http://qudt.org/schema/qudt/plainTextDescription> "Napierian Absorbance is the natural (Napierian) logarithm of the reciprocal of the spectral internal transmittance.";
  <http://qudt.org/schema/qudt/latexDefinition> "$A_e(\\lambda) = -ln(\\tau(\\lambda))$, where $\\tau$ is the transmittance at a given wavelength $\\lambda$."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/applicableUnit> unit:UNITLESS .

<http://qudt.org/vocab/quantitykind/NeutronYieldPerAbsorption> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Neutron Yield per Absorption"@en;
  rdfs:comment "Applicable units are those of quantitykind:NeutronYieldPerAbsorption";
  dct:description "The \"Neutron Yield per Absorption\" is the average number of fission neutrons, both prompt and delayed, emitted per neutron absorbed in a fissionable nuclide or in a nuclear fuel, as specified."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1>;
  <http://qudt.org/schema/qudt/informativeReference> "http://en.wikipedia.org/wiki/Fission_product_yield"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/isoNormativeReference> "http://www.iso.org/iso/catalogue_detail?csnumber=31895"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/plainTextDescription> "The \"Neutron Yield per Absorption\" is the average number of fission neutrons, both prompt and delayed, emitted per neutron absorbed in a fissionable nuclide or in a nuclear fuel, as specified.";
  <http://qudt.org/schema/qudt/latexSymbol> "$\\eta$"^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/applicableUnit> unit:UNITLESS .

<http://qudt.org/vocab/quantitykind/NeutronYieldPerFission> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Neutron Yield per Fission"@en;
  rdfs:comment "Applicable units are those of quantitykind:NeutronYieldPerFission";
  dct:description "The \"Neutron Yield per Fission\" is the average number of fission neutrons, both prompt and delayed, emitted per fission event."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1>;
  <http://qudt.org/schema/qudt/informativeReference> "http://en.wikipedia.org/wiki/Fission_product_yield"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/isoNormativeReference> "http://www.iso.org/iso/catalogue_detail?csnumber=31895"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/plainTextDescription> "The \"Neutron Yield per Fission\" is the average number of fission neutrons, both prompt and delayed, emitted per fission event.";
  <http://qudt.org/schema/qudt/latexSymbol> "$\\nu$"^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/applicableUnit> unit:UNITLESS .

<http://qudt.org/vocab/quantitykind/Non-LeakageProbability> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Non-Leakage Probability"@en;
  rdfs:comment "Applicable units are those of quantitykind:Non-LeakageProbability";
  dct:description "The \"Non-Leakage Probability\" is the probability that a neutron will not escape from the reactor during the slowing-down process or while it diffuses as a thermal neutron"^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1>;
  <http://qudt.org/schema/qudt/informativeReference> "http://en.wikipedia.org/wiki/Six_factor_formula"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/isoNormativeReference> "http://www.iso.org/iso/catalogue_detail?csnumber=31895"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/plainTextDescription> "The \"Non-Leakage Probability\" is the probability that a neutron will not escape from the reactor during the slowing-down process or while it diffuses as a thermal neutron";
  <http://qudt.org/schema/qudt/latexSymbol> "$\\Lambda$"^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/applicableUnit> unit:UNITLESS .

<http://qudt.org/vocab/quantitykind/NumberOfParticles> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Number of Particles"@en;
  rdfs:comment "Applicable units are those of quantitykind:NumberOfParticles";
  dct:description "\"Number of Particles\", also known as the particle number, of a thermodynamic system, conventionally indicated with the letter N, is the number of constituent particles in that system."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1>;
  <http://qudt.org/schema/qudt/informativeReference> "http://en.wikipedia.org/wiki/Particle_number"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/symbol> "N_B";
  <http://qudt.org/schema/qudt/isoNormativeReference> "http://www.iso.org/iso/catalogue_detail?csnumber=31894"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/plainTextDescription> "\"Number of Particles\", also known as the particle number, of a thermodynamic system, conventionally indicated with the letter N, is the number of constituent particles in that system.";
  <http://qudt.org/schema/qudt/applicableUnit> unit:UNITLESS .

<http://qudt.org/vocab/quantitykind/OrderOfReflection> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Order of Reflection"@en;
  rdfs:comment "Applicable units are those of quantitykind:OrderOfReflection";
  dct:description "\"Order of Reflection\" is $n$ in the Bragg's Law equation."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1>;
  <http://qudt.org/schema/qudt/informativeReference> "http://www.answers.com/topic/order-of-reflection"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/symbol> "n";
  <http://qudt.org/schema/qudt/isoNormativeReference> "http://www.iso.org/iso/catalogue_detail?csnumber=31897"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/applicableUnit> unit:UNITLESS .

<http://qudt.org/vocab/quantitykind/OsmoticCoefficient> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Osmotic Coefficient"@en;
  rdfs:comment "Applicable units are those of quantitykind:OsmoticCoefficient";
  dct:description "The \"Osmotic Coefficient\" is a quantity which characterises the deviation of a solvent from ideal behavior."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1>;
  <http://qudt.org/schema/qudt/informativeReference> "http://en.wikipedia.org/wiki/Osmotic_coefficient"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/isoNormativeReference> "http://www.iso.org/iso/catalogue_detail?csnumber=31894"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/plainTextDescription> "The \"Osmotic Coefficient\" is a quantity which characterises the deviation of a solvent from ideal behavior.";
  <http://qudt.org/schema/qudt/latexSymbol> "$\\varphi$"^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/latexDefinition> "$\\varphi = -(M_A\\sum b_B)^{-1} \\ln a_A$, where $M_A$ is the molar mass of the solvent $A$, $\\sum$ denotes summation over all the solutes, $b_B$ is the molality of solute $B$, and $a_A$ is the activity of solvent $A$."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/applicableUnit> unit:UNITLESS .

<http://qudt.org/vocab/quantitykind/PackingFraction> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Packing Fraction"@en;
  rdfs:comment "Applicable units are those of quantitykind:PackingFraction";
  dct:description "The \"Packing Fraction\" is the fraction of volume in a crystal structure that is occupied by atoms."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1>;
  <http://qudt.org/schema/qudt/informativeReference> "http://en.wikipedia.org/wiki/Atomic_packing_factor"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/symbol> "f";
  <http://qudt.org/schema/qudt/isoNormativeReference> "http://www.iso.org/iso/catalogue_detail?csnumber=31895"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/plainTextDescription> "The \"Packing Fraction\" is the fraction of volume in a crystal structure that is occupied by atoms.";
  <http://qudt.org/schema/qudt/latexDefinition> "$f = \\frac{\\Delta_r}{A}$, where $\\Delta_r$ is the relative mass excess and $A$ is the nucleon number."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/applicableUnit> unit:UNITLESS .

<http://qudt.org/vocab/quantitykind/PermittivityRatio> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:seeAlso <http://qudt.org/vocab/quantitykind/Permittivity>;
  rdfs:label "Permittivity Ratio"@en;
  rdfs:comment "Applicable units are those of quantitykind:PermittivityRatio";
  dct:description "\"Permittivity Ratio\" is the ratio of permittivity to the permittivity of a vacuum."^^<http://qudt.org/schema/qudt/LatexString>;
  skos:broader <http://qudt.org/vocab/quantitykind/DimensionlessRatio>;
  <http://qudt.org/schema/qudt/dbpediaMatch> "http://dbpedia.org/resource/Permittivity"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1>;
  <http://qudt.org/schema/qudt/informativeReference> "http://www.iso.org/iso/home/store/catalogue_tc/catalogue_detail.htm?csnumber=31891"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/expression> "$rel-permittivity$"^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/plainTextDescription> "\"Permittivity Ratio\" is the ratio of permittivity to the permittivity of a vacuum.";
  <http://qudt.org/schema/qudt/latexSymbol> "$\\epsilon_r$"^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/latexDefinition> "$\\epsilon_r = \\epsilon / \\epsilon_0$, where $\\epsilon$ is permittivity and $\\epsilon_0$ is the electric constant."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/qkdvDenominator> <http://qudt.org/vocab/dimensionvector/A0E2L-3I0M-1H0T4D0>;
  <http://qudt.org/schema/qudt/qkdvNumerator> <http://qudt.org/vocab/dimensionvector/A0E2L-3I0M-1H0T4D0>;
  <http://qudt.org/schema/qudt/applicableUnit> unit:UNITLESS .

<http://qudt.org/vocab/quantitykind/PoissonRatio> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Poisson Ratio"@en;
  rdfs:comment "Applicable units are those of quantitykind:PoissonRatio";
  dct:description "The Poisson Ratio is the negative ratio of transverse to axial strain. In fact, when a sample object is stretched (or squeezed), to an extension (or contraction) in the direction of the applied load, it corresponds a contraction (or extension) in a direction perpendicular to the applied load. The ratio between these two quantities is the Poisson's ratio."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1>;
  <http://qudt.org/schema/qudt/informativeReference> "http://en.wikipedia.org/wiki/Poisson%27s_ratio"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/isoNormativeReference> "http://www.iso.org/iso/catalogue_detail?csnumber=31889"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/plainTextDescription> "The Poisson Ratio is the negative ratio of transverse to axial strain. In fact, when a sample object is stretched (or squeezed), to an extension (or contraction) in the direction of the applied load, it corresponds a contraction (or extension) in a direction perpendicular to the applied load. The ratio between these two quantities is the Poisson's ratio.";
  <http://qudt.org/schema/qudt/latexSymbol> "$\\mu$"^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/latexDefinition> "$\\mu = \\frac{\\Delta \\delta}{\\Delta l}$, where $\\Delta \\delta$ is the lateral contraction and $\\Delta l$ is the elongation."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/applicableUnit> unit:UNITLESS .

<http://qudt.org/vocab/quantitykind/PowerFactor> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:seeAlso <http://qudt.org/vocab/quantitykind/ActivePower>, <http://qudt.org/vocab/quantitykind/ApparentPower>;
  rdfs:label "Leistungsfaktor"@de, "Współczynnik mocy"@pl, "facteur de puissance"@fr,
    "factor de potencia"@es, "factor de putere"@ro, "faktor kuasa"@ms, "fator de potência"@pt,
    "fattore di potenza"@it, "güç faktörü"@tr, "power factor"@en, "Účiník"@cs, "Коэффициент_мощности"@ru,
    "ضریب توان"@fa, "معامل القدرة"@ar, "शक्ति गुणांक"@hi, "力率"@ja, "功率因数"@zh;
  rdfs:comment "Applicable units are those of quantitykind:PowerFactor";
  dct:description "\"Power Factor\", under periodic conditions, is the ratio of the absolute value of the active power $P$ to the apparent power $S$."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1>;
  <http://qudt.org/schema/qudt/informativeReference> "http://www.iso.org/iso/home/store/catalogue_tc/catalogue_detail.htm?csnumber=31891"^^xsd:anyURI,
    "http://www.electropedia.org/iev/iev.nsf/display?openform&ievref=131-11-46"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/expression> "$power-factor$"^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/latexSymbol> "$\\lambda$"^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/latexDefinition> "$\\lambda = \\left | P \\right | / \\left | S \\right |$, where $P$ is active power and $S$ is apparent power."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/applicableUnit> unit:UNITLESS .

<http://qudt.org/vocab/quantitykind/QualityFactor> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:seeAlso <http://qudt.org/vocab/quantitykind/Resistance>, <http://qudt.org/vocab/quantitykind/Impedance>;
  rdfs:label "Quality Factor"@en;
  rdfs:comment "Applicable units are those of quantitykind:QualityFactor";
  dct:description "\"Quality Factor\", of a resonant circuit, is a measure of the \"goodness\" or quality of a resonant circuit. A higher value for this figure of merit correspondes to a more narrow bandwith, which is desirable in many applications. More formally, $Q$ is the ratio of power stored to power dissipated in the circuit reactance and resistance, respectively"^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1>;
  <http://qudt.org/schema/qudt/informativeReference> "http://www.iso.org/iso/home/store/catalogue_tc/catalogue_detail.htm?csnumber=31891"^^xsd:anyURI,
    "http://en.sourcetronic.com/electrical-measurement-glossary/quality-factor.html"^^xsd:anyURI,
    "http://www.allaboutcircuits.com/vol_2/chpt_6/6.html"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/symbol> "Q";
  <http://qudt.org/schema/qudt/latexDefinition> "If $\\underline{Z} = R + jX$, then $Q = \\left | X \\right |/R$, where $\\underline{Z}$ is impedance, $R$ is resistance, and $X$ is reactance."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://www.linkedmodel.org/schema/vaem#todo> "Resolve Quality Facor - electronics and also doses";
  <http://qudt.org/schema/qudt/applicableUnit> unit:UNITLESS .

<http://qudt.org/vocab/quantitykind/RadianceFactor> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Radiance Factor"@en;
  rdfs:comment "Applicable units are those of quantitykind:RadianceFactor";
  dct:description "Radiance Factor is the ratio of the radiance of the surface element in the given direction to that of a perfect reflecting or transmitting diffuser identically irradiated unit."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1>;
  <http://qudt.org/schema/qudt/informativeReference> "http://www.encyclo.co.uk/define/radiance+factor"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/plainTextDescription> "Radiance Factor is the ratio of the radiance of the surface element in the given direction to that of a perfect reflecting or transmitting diffuser identically irradiated unit.";
  <http://qudt.org/schema/qudt/latexSymbol> "$\\beta$"^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/latexDefinition> "$\\beta = \\frac{L_n}{L_d}$, where $L_n$ is the radiance of a surface element in a given direction and $L_d$ is the radiance of the perfect reflecting or transmitting diffuser identically irradiated and viewed. Reflectance factor is equivalent to radiance factor or luminance factor (when the cone angle is infinitely small, and is equivalent to reflectance when the cone angle is $2π sr$."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/applicableUnit> unit:UNITLESS .

<http://qudt.org/vocab/quantitykind/RatioOfSpecificHeatCapacities> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:seeAlso <http://qudt.org/vocab/quantitykind/IsentropicExponent>;
  rdfs:label "Ratio of Specific Heat Capacities"@en;
  rdfs:comment "Applicable units are those of quantitykind:RatioOfSpecificHeatCapacities";
  dct:description """
  The specific heat ratio of a gas is the ratio of the specific heat at constant pressure,
   $c_p$, to the specific heat at constant volume, $c_V$. 
  It is sometimes referred to as the $\\textit{adiabatic index}$,
   or the $\\textit{heat capacity ratio}$,
   or the $\\textit{isentropic expansion factor}$,
   or the $\\textit{adiabatic exponent}$,
  or the $\\textit{isentropic exponent}$.
  """^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1>;
  <http://qudt.org/schema/qudt/informativeReference> "http://en.citizendium.org/wiki/Specific_heat_ratio"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/isoNormativeReference> "http://www.iso.org/iso/catalogue_detail?csnumber=31890"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/latexSymbol> "$\\gamma$"^^<http://qudt.org/schema/qudt/LatexString>,
    "$\\varkappa$"^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/latexDefinition> "$\\gamma = c_p / c_V$, where $c$ is the specific heat of a gas, $c_p$ is specific heat capacity at constant pressure, $c_V$ is specific heat capacity at constant volume."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/applicableUnit> unit:UNITLESS .

<http://qudt.org/vocab/quantitykind/Reactivity> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Reactivity"@en;
  rdfs:comment "Applicable units are those of quantitykind:Reactivity";
  dct:description "\"Reactivity\" characterizes the deflection of reactor from the critical state."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1>;
  <http://qudt.org/schema/qudt/informativeReference> "http://en.wikipedia.org/wiki/Nuclear_chain_reaction"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/isoNormativeReference> "http://www.iso.org/iso/catalogue_detail?csnumber=31895"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/plainTextDescription> "\"Reactivity\" characterizes the deflection of reactor from the critical state.";
  <http://qudt.org/schema/qudt/latexSymbol> "$\\rho$"^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/latexDefinition> "$\\rho = \\frac{k_{eff} - 1}{k_{eff}}$, where $k_{eff}$ is the effective multiplication factor."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/applicableUnit> unit:UNITLESS .

<http://qudt.org/vocab/quantitykind/ReflectanceFactor> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Reflectance Factor"@en;
  rdfs:comment "Applicable units are those of quantitykind:ReflectanceFactor";
  dct:description "Reflectance Factor is the measure of the ability of a surface to reflect light or other electromagnetic radiation, equal to the ratio of the reflected flux to the incident flux."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1>;
  <http://qudt.org/schema/qudt/informativeReference> "http://www.thefreedictionary.com/reflectance+factor"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/symbol> "R";
  <http://qudt.org/schema/qudt/plainTextDescription> "Reflectance Factor is the measure of the ability of a surface to reflect light or other electromagnetic radiation, equal to the ratio of the reflected flux to the incident flux.";
  <http://qudt.org/schema/qudt/latexDefinition> "$R = \\frac{\\Phi_n}{\\Phi_d}$, where $\\Phi_n$ is the radiant flux or luminous flux reflected in the directions delimited by a given cone and $\\Phi_d$ is the flux reflected in the same directions by an identically radiated diffuser of reflectance equal to 1."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/applicableUnit> unit:UNITLESS .

<http://qudt.org/vocab/quantitykind/RefractiveIndex> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Brechzahl"@de, "Indeks biasan"@ms, "Index lomu"@cs, "Indice de refracție"@ro,
    "Współczynnik załamania"@pl, "indice de réfraction"@fr, "indice di rifrazione"@it,
    "kırılma indeksi"@tr, "refractive index"@en, "índice de refracción"@es, "índice refrativo"@pt,
    "Показатель преломления"@ru, "ضریب شکست"@fa, "معامل الانكسار"@ar, "अपवर्तनांक"@hi,
    "屈折率"@ja, "折射率"@zh;
  rdfs:comment "Applicable units are those of quantitykind:RefractiveIndex";
  dct:description "\"refractive index\" or index of refraction n of a substance (optical medium) is a dimensionless number that describes how light, or any other radiation, propagates through that medium."^^<http://qudt.org/schema/qudt/LatexString>;
  skos:altLabel "Brechungsindex"@de;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1>;
  <http://qudt.org/schema/qudt/informativeReference> "http://en.wikipedia.org/wiki/Refractive_index"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/symbol> "n";
  <http://qudt.org/schema/qudt/plainTextDescription> "\"refractive index\" or index of refraction n of a substance (optical medium) is a dimensionless number that describes how light, or any other radiation, propagates through that medium.";
  <http://qudt.org/schema/qudt/latexDefinition> "$n = \\frac{c_0}{c}$, where $c_0$ is the speed of light in vacuum, and $c$ is the speed of light in the medium."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/applicableUnit> unit:UNITLESS .

<http://qudt.org/vocab/quantitykind/RelativeMassConcentrationOfVapour> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:seeAlso <http://qudt.org/vocab/quantitykind/RelativePartialPressure>;
  rdfs:label "Relative Mass Concentration of Vapour"@en;
  rdfs:comment "Applicable units are those of quantitykind:RelativeMassConcentrationOfVapour";
  dct:description "\"Relative Mass Concentration of Vapour\" is one of a number of \"Relative Concentration\" quantities defined by ISO 80000."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1>;
  <http://qudt.org/schema/qudt/isoNormativeReference> "http://www.iso.org/iso/catalogue_detail?csnumber=31890"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/plainTextDescription> "Relative Mass Concentration of Vapour is one of a number of Relative Concentration quantities defined by ISO 80000.";
  <http://qudt.org/schema/qudt/latexSymbol> "$\\varphi$"^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/latexDefinition> "$\\varphi = v / v_{sat}$, where $v$ is mass concentration of water vapour,  $v_{sat}$ is its mass concentration of water vapour at saturation (at the same temperature). For normal cases, the relative partial pressure may be assumed to be equal to relative mass concentration of vapour."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/applicableUnit> unit:UNITLESS .

<http://qudt.org/vocab/quantitykind/RelativeMassDensity> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Relative Mass Density"@en;
  rdfs:comment "Applicable units are those of quantitykind:RelativeMassDensity";
  dct:description "Relative density, or specific gravity, is the ratio of the density (mass of a unit volume) of a substance to the density of a given reference material."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1>;
  <http://qudt.org/schema/qudt/informativeReference> "http://en.wikipedia.org/wiki/Relative_density"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/symbol> "d";
  <http://qudt.org/schema/qudt/isoNormativeReference> "http://www.iso.org/iso/catalogue_detail?csnumber=31889"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/plainTextDescription> "Relative density, or specific gravity, is the ratio of the density (mass of a unit volume) of a substance to the density of a given reference material.";
  <http://qudt.org/schema/qudt/latexDefinition> "$d = \\frac{\\rho}{\\rho_0}$, where $\\rho$ is mass density of a substance and $\\rho_0$ is the mass density of a reference substance under conditions that should be specified for both substances."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/applicableUnit> unit:UNITLESS .

<http://qudt.org/vocab/quantitykind/RelativeMassExcess> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Relative Mass Excess"@en;
  rdfs:comment "Applicable units are those of quantitykind:RelativeMassExcess";
  dct:description "The \"Relative Mass Excess\" is the mass excess between the monoisotopic mass of an element and the mass of its A + 1 or its A + 2 isotopic cluster (extrapolated from relative mass defect)."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1>;
  <http://qudt.org/schema/qudt/informativeReference> "http://en.wikipedia.org/wiki/Mass_excess"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/isoNormativeReference> "http://www.iso.org/iso/catalogue_detail?csnumber=31895"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/plainTextDescription> "The \"Relative Mass Excess\" is the mass excess between the monoisotopic mass of an element and the mass of its A + 1 or its A + 2 isotopic cluster (extrapolated from relative mass defect).";
  <http://qudt.org/schema/qudt/latexSymbol> "$\\Delta_r$"^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/latexDefinition> "$\\Delta_r = \\frac{\\Delta}{m_u}$, where $\\Delta$ is the mass excess and $m_u$ is the unified atomic mass constant."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/applicableUnit> unit:UNITLESS .

<http://qudt.org/vocab/quantitykind/RelativeMassRatioOfVapour> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Relative Mass Ratio of Vapour"@en;
  rdfs:comment "Applicable units are those of quantitykind:RelativeMassRatioOfVapour";
  dct:description "\"Relative Mass Ratio of Vapour\" is one of a number of \"Relative Concentration\" quantities defined by ISO 80000."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1>;
  <http://qudt.org/schema/qudt/isoNormativeReference> "http://www.iso.org/iso/catalogue_detail?csnumber=31890"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/plainTextDescription> "Relative Mass Ratio of Vapour is one of a number of Relative Concentration quantities defined by ISO 80000.";
  <http://qudt.org/schema/qudt/latexSymbol> "$\\psi$"^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/latexDefinition> "$\\psi = x / x_{sat}$, where $x$ is mass ratio of water vapour to dry gas,  $x_{sat}$ is its mass raio of water vapour to dry gas at saturation (at the same temperature)."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/applicableUnit> unit:UNITLESS .

<http://qudt.org/vocab/quantitykind/ResonanceEscapeProbability> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Resonance Escape Probability"@en;
  rdfs:comment "Applicable units are those of quantitykind:ResonanceEscapeProbability";
  dct:description "The \"Resonance Escape Probability\" is the fraction of fission neutrons that manage to slow down from fission to thermal energies without being absorbed. In an infinite medium, the probability that a neutron slowing down will traverse all or some specified portion of the range of resonance energies without being absorbed."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1>;
  <http://qudt.org/schema/qudt/informativeReference> "http://en.wikipedia.org/wiki/Four_factor_formula"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/symbol> "p";
  <http://qudt.org/schema/qudt/isoNormativeReference> "http://www.iso.org/iso/catalogue_detail?csnumber=31895"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/plainTextDescription> "The \"Resonance Escape Probability\" is the fraction of fission neutrons that manage to slow down from fission to thermal energies without being absorbed. In an infinite medium, the probability that a neutron slowing down will traverse all or some specified portion of the range of resonance energies without being absorbed.";
  <http://qudt.org/schema/qudt/applicableUnit> unit:UNITLESS .

<http://qudt.org/vocab/quantitykind/Short-RangeOrderParameter> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Short-Range Order Parameter"@en;
  rdfs:comment "Applicable units are those of quantitykind:Short-RangeOrderParameter";
  dct:description "\"Short-Range Order Parameter\" is the fraction of the nearest-neighbor atom pairs in an Ising ferromagnet having magnetic moments in one direction, minus the fraction having magnetic moments in the opposite direction."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1>;
  <http://qudt.org/schema/qudt/isoNormativeReference> "http://www.iso.org/iso/catalogue_detail?csnumber=31897"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/plainTextDescription> "\"Short-Range Order Parameter\" is the fraction of the nearest-neighbor atom pairs in an Ising ferromagnet having magnetic moments in one direction, minus the fraction having magnetic moments in the opposite direction.";
  <http://qudt.org/schema/qudt/latexSymbol> "$r, \\sigma$"^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/applicableUnit> unit:UNITLESS .

<http://qudt.org/vocab/quantitykind/StandardAbsoluteActivity> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Standard Absolute Activity"@en;
  rdfs:comment "Applicable units are those of quantitykind:StandardAbsoluteActivity";
  dct:description "The \"Standard Absolute Activity\" is proportional to the absoulte activity of the pure substance $B$ at the same temperature and pressure multiplied by the standard pressure."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1>;
  <http://qudt.org/schema/qudt/informativeReference> "http://en.wikipedia.org/wiki/Activity_coefficient"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/isoNormativeReference> "http://www.iso.org/iso/catalogue_detail?csnumber=31894"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/latexSymbol> "$\\lambda_B^\\Theta$"^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/latexDefinition> "$\\lambda_B^\\Theta = \\lambda_B^*(p^\\Theta)$, where $\\lambda_B^\\Theta$ the absolute activity of the pure substance $B$ at the same temperature and pressure, and $p^\\Theta$ is standard pressure."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/applicableUnit> unit:UNITLESS .

<http://qudt.org/vocab/quantitykind/StatisticalWeight> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Statistical Weight"@en;
  rdfs:comment "Applicable units are those of quantitykind:StatisticalWeight";
  dct:description "A \"Statistical Weight\" is the relative probability (possibly unnormalized) of a particular feature of a state."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1>;
  <http://qudt.org/schema/qudt/informativeReference> "http://en.wikipedia.org/wiki/Statistical_weight"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/symbol> "g";
  <http://qudt.org/schema/qudt/isoNormativeReference> "http://www.iso.org/iso/catalogue_detail?csnumber=31894"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/plainTextDescription> "A \"Statistical Weight\" is the relative probability (possibly unnormalized) of a particular feature of a state.";
  <http://qudt.org/schema/qudt/applicableUnit> unit:UNITLESS .

<http://qudt.org/vocab/quantitykind/StructureFactor> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Structure Factor"@en;
  rdfs:comment "Applicable units are those of quantitykind:StructureFactor";
  dct:description "\"Structure Factor\" is a mathematical description of how a material scatters incident radiation."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1>;
  <http://qudt.org/schema/qudt/informativeReference> "http://en.wikipedia.org/wiki/Structure_factor"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/symbol> "F(h, k, l)";
  <http://qudt.org/schema/qudt/isoNormativeReference> "http://www.iso.org/iso/catalogue_detail?csnumber=31897"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/plainTextDescription> "\"Structure Factor\" is a mathematical description of how a material scatters incident radiation.";
  <http://qudt.org/schema/qudt/latexDefinition> "$F(h, k, l) = \\sum_{n=1}^N f_n\\exp{[2\\pi i(hx_n + ky_n +lz_n)]}$, where $f_n$ is the atomic scattering factor for atom $n$, and $x_n$, $y_n$, and $z_n$ are fractional coordinates in the unit cell; for $h$, $k$, and $l$."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/applicableUnit> unit:UNITLESS .

<http://qudt.org/vocab/quantitykind/ThermalDiffusionFactor> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Thermal Diffusion Factor"@en;
  rdfs:comment "Applicable units are those of quantitykind:ThermalDiffusionFactor";
  dct:description "Thermal diffusion is a phenomenon in which a temperature gradient in a mixture of fluids gives rise to a flow of one constituent relative to the mixture as a whole. in the context of the equation that describes thermal diffusion, the \"Thermal Diffusion Factor\" is ."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1>;
  <http://qudt.org/schema/qudt/informativeReference> "http://www.thermopedia.com/content/1189/"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/isoNormativeReference> "http://www.iso.org/iso/catalogue_detail?csnumber=31894"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/plainTextDescription> "Thermal diffusion is a phenomenon in which a temperature gradient in a mixture of fluids gives rise to a flow of one constituent relative to the mixture as a whole. in the context of the equation that describes thermal diffusion, the \"Thermal Diffusion Factor\" is .";
  <http://qudt.org/schema/qudt/latexSymbol> "$\\alpha_T$"^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/latexDefinition> "$\\alpha_T = \\frac{k_T}{(x_A x_B)}$, where $k_T$ is the thermal diffusion ratio, and $x_A$ and $x_B$ are the local amount-of-substance fractions of the two substances $A$ and $B$."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/applicableUnit> unit:UNITLESS .

<http://qudt.org/vocab/quantitykind/ThermalDiffusionRatio> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Thermal Diffusion Ratio"@en;
  rdfs:comment "Applicable units are those of quantitykind:ThermalDiffusionRatio";
  dct:description "The \"Thermal Diffusion Ratio\" is proportional to the product of the component concentrations."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1>;
  <http://qudt.org/schema/qudt/informativeReference> "http://www.thermopedia.com/content/1189/"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/symbol> "k_T";
  <http://qudt.org/schema/qudt/isoNormativeReference> "http://www.iso.org/iso/catalogue_detail?csnumber=31894"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/plainTextDescription> "The \"Thermal Diffusion Ratio\" is proportional to the product of the component concentrations.";
  <http://qudt.org/schema/qudt/latexDefinition> "In a steady state of a binary mixture in which thermal diffusion occurs, $grad x_B  = -(\\frac{k_T}{T}) grad T$, where $x_B$ is the amount-of-substance fraction of the heavier substance $B$, and $T$ is the local thermodynamic temperature."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/applicableUnit> unit:UNITLESS .

<http://qudt.org/vocab/quantitykind/ThermalUtilizationFactor> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Thermal Utilization Factor"@en;
  rdfs:comment "Applicable units are those of quantitykind:ThermalUtilizationFactor";
  dct:description "The \"Thermal Utilization Factor\" in an infinite medium, is the ratio of the number of thermal absorbed in a fissionable nuclide or in a nuclear fuel, as specified, to the total number of thermal neutrons absorbed."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1>;
  <http://qudt.org/schema/qudt/informativeReference> "http://en.wikipedia.org/wiki/Four_factor_formula"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/symbol> "f";
  <http://qudt.org/schema/qudt/isoNormativeReference> "http://www.iso.org/iso/catalogue_detail?csnumber=31895"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/plainTextDescription> "The \"Thermal Utilization Factor\" in an infinite medium, is the ratio of the number of thermal absorbed in a fissionable nuclide or in a nuclear fuel, as specified, to the total number of thermal neutrons absorbed.";
  <http://qudt.org/schema/qudt/applicableUnit> unit:UNITLESS .

<http://qudt.org/vocab/quantitykind/TotalIonization> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Total Ionization"@en;
  rdfs:comment "Applicable units are those of quantitykind:TotalIonization";
  dct:description "\"Total Ionization\" by a particle, total mean charge, divided by the elementary charge, $e$, of all positive ions produced by an ionizing charged particle along its entire path and along the paths of any secondary charged particles."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1>;
  <http://qudt.org/schema/qudt/informativeReference> "http://en.wikipedia.org/wiki/Ionization#Classical_ionization"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/symbol> "N_i";
  <http://qudt.org/schema/qudt/isoNormativeReference> "http://www.iso.org/iso/catalogue_detail?csnumber=31895"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/latexDefinition> "$N = \\int N_i dl$."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/applicableUnit> unit:UNITLESS .

<http://qudt.org/vocab/quantitykind/TransmittanceDensity> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Transmittance Density"@en;
  rdfs:comment "Applicable units are those of quantitykind:TransmittanceDensity";
  dct:description "Transmittance is the fraction of incident light (electromagnetic radiation) at a specified wavelength that passes through a sample."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1>;
  <http://qudt.org/schema/qudt/symbol> "A_10, D";
  <http://qudt.org/schema/qudt/plainTextDescription> "Transmittance is the fraction of incident light (electromagnetic radiation) at a specified wavelength that passes through a sample.";
  <http://qudt.org/schema/qudt/latexDefinition> "$A_{10}(\\lambda) = -lg(\\tau(\\lambda))$, where $\\tau$ is the transmittance at a given wavelength $\\lambda$."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/applicableUnit> unit:UNITLESS .

<http://qudt.org/vocab/quantitykind/Turns> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Turns"@en;
