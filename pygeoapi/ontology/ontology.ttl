<http://qudt.org/vocab/quantitykind/MeanEnergyImparted> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Mean Energy Imparted"@en;
  rdfs:comment "Applicable units are those of quantitykind:Energy";
  dct:description "The \"Mean Energy Imparted\", is the average energy imparted to irradiated matter."^^<http://qudt.org/schema/qudt/LatexString>;
  skos:broader <http://qudt.org/vocab/quantitykind/Energy>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L2I0M1H0T-2D0>;
  <http://qudt.org/schema/qudt/informativeReference> "http://www.answers.com/topic/energy-imparted"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/symbol> "ε̅";
  <http://qudt.org/schema/qudt/plainTextDescription> "The \"Mean Energy Imparted\", is the average energy imparted to irradiated matter.";
  <http://qudt.org/schema/qudt/latexDefinition> "To the matter in a given domain, $\\bar{\\varepsilon} = R_{in} - R_{out} + \\sum Q$, where $R_{in}$ is the radiant energy of all those charged and uncharged ionizing particles that enter the domain, $R_{out}$ is the radiant energy of all those charged and uncharged ionizing particles that leave the domain, and $\\sum Q$ is the sum of all changes of the rest energy of nuclei and elementary particles that occur in that domain."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/applicableUnit> unit:AttoJ, unit:BTU_IT, unit:BTU_TH,
    unit:CAL_IT, unit:CAL_TH, unit:ERG, unit:EV, unit:E_h, unit:ExaJ, unit:FT-LB_F, unit:FT-PDL,
    unit:FemtoJ, unit:GigaEV, unit:GigaJ, unit:GigaW-HR, unit:J, unit:KiloBTU_IT, unit:KiloBTU_TH,
    unit:KiloCAL, unit:KiloEV, unit:KiloJ, unit:KiloV-A-HR, unit:KiloV-A_Reactive-HR,
    unit:KiloW-HR, unit:MegaEV, unit:MegaJ, unit:MegaTOE, unit:MegaV-A-HR, unit:MegaV-A_Reactive-HR,
    unit:MegaW-HR, unit:MicroJ, unit:MilliJ, unit:NanoJ, unit:PetaJ, unit:PicoJ, unit:PlanckEnergy,
    unit:QUAD, unit:THERM_EC, unit:THM_EEC, unit:THERM_US, unit:THM_US, unit:TOE, unit:TeraJ,
    unit:TeraW-HR, unit:TonEnergy, unit:V-A-HR, unit:V-A_Reactive-HR, unit:W-HR, unit:W-SEC;
  <http://qudt.org/schema/qudt/normativeReference> "http://www.iso.org/iso/catalogue_detail?csnumber=31895"^^xsd:anyURI .

<http://qudt.org/vocab/quantitykind/MeanFreePath> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Mean Free Path"@en;
  rdfs:comment "Applicable units are those of quantitykind:Length";
  dct:description "\"Mean Free Path\" is the average distance travelled by a moving particle (such as an atom, a molecule, a photon) between successive impacts (collisions) which modify its direction or energy or other particle properties."^^<http://qudt.org/schema/qudt/LatexString>;
  skos:broader <http://qudt.org/vocab/quantitykind/Length>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L1I0M0H0T0D0>;
  <http://qudt.org/schema/qudt/informativeReference> "http://en.wikipedia.org/wiki/Mean_free_path"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/symbol> "λ";
  <http://qudt.org/schema/qudt/plainTextDescription> "\"Mean Free Path\" is the average distance travelled by a moving particle (such as an atom, a molecule, a photon) between successive impacts (collisions) which modify its direction or energy or other particle properties.";
  <http://qudt.org/schema/qudt/abbreviation> "m";
  <http://qudt.org/schema/qudt/applicableUnit> unit:ANGSTROM, unit:AU, unit:BTU_IT-PER-LB_F,
    unit:CH, unit:CHAIN_US, unit:CentiM, unit:DecaM, unit:DeciM, unit:FATH, unit:FM, unit:FemtoM,
    unit:FT, unit:FT_US, unit:FUR, unit:FUR_Long, unit:GAUGE_FR, unit:GA_Charriere, unit:HectoM,
    unit:IN, unit:KiloM, unit:LY, unit:M, unit:MI, unit:MI_N, unit:MI_US, unit:MicroIN,
    unit:MicroM, unit:MilLength, unit:MilliIN, unit:MilliM, unit:NanoM, unit:PARSEC, unit:PCA,
    unit:PT, unit:PicoM, unit:PlanckLength, unit:ROD, unit:YD, unit:ZOLL;
  <http://qudt.org/schema/qudt/normativeReference> "http://www.iso.org/iso/catalogue_detail?csnumber=31895"^^xsd:anyURI,
    "http://www.iso.org/iso/catalogue_detail?csnumber=31894"^^xsd:anyURI .

<http://qudt.org/vocab/quantitykind/MeanLifetime> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Mean Lifetime"@en;
  rdfs:comment "Applicable units are those of quantitykind:Time";
  dct:description "The \"Mean Lifetime\" is the average length of time that an element remains in the set of discrete elements in a decaying quantity, $N(t)$."^^<http://qudt.org/schema/qudt/LatexString>;
  skos:broader <http://qudt.org/vocab/quantitykind/Time>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T1D0>;
  <http://qudt.org/schema/qudt/informativeReference> "http://en.wikipedia.org/wiki/Exponential_decay"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/isoNormativeReference> "http://www.iso.org/iso/catalogue_detail?csnumber=31895"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/latexSymbol> "$\\tau$"^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/latexDefinition> "$\\tau = \\frac{1}{\\lambda}$, where $\\lambda$ is the decay constant."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/applicableUnit> unit:AttoSEC, unit:CentiPOISE-PER-BAR,
    unit:DAY, unit:DAY_Sidereal, unit:DeciSEC, unit:FemtoSEC, unit:H-PER-KiloOHM, unit:H-PER-OHM,
    unit:HR, unit:HR_Sidereal, unit:KiloSEC, unit:KiloYR, unit:MIN, unit:MIN_Sidereal,
    unit:MO, unit:MO_Synodic, unit:MO_MeanGREGORIAN, unit:MO_MeanJulian, unit:MegaSEC,
    unit:MegaYR, unit:MicroH-PER-KiloOHM, unit:MicroH-PER-OHM, unit:MicroSEC, unit:MilliH-PER-KiloOHM,
    unit:MilliH-PER-OHM, unit:MilliPA-SEC-PER-BAR, unit:MilliSEC, unit:NanoSEC, unit:PA-SEC-PER-BAR,
    unit:POISE-PER-BAR, unit:POISE-PER-PA, unit:PicoSEC, unit:PlanckTime, unit:SEC, unit:SH,
    unit:WK, unit:YR, unit:YR_Common, unit:YR_Metrology, unit:YR_Sidereal, unit:YR_TROPICAL .

<http://qudt.org/vocab/quantitykind/MeanLinearRange> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Mean Linear Range"@en;
  rdfs:comment "Applicable units are those of quantitykind:Length";
  dct:description "\"Mean Linear Range\" is, in a given material, for specified charged particles of a specified energy, the average displacement of the particles before they stop. That is, the mean totl rectified path length travelled by a particle in the course of slowing down to rest (or to some suitable cut-off energy) in a given substance under specified conditions averaged over a group of particles having the same initial energy."^^<http://qudt.org/schema/qudt/LatexString>;
  skos:broader <http://qudt.org/vocab/quantitykind/Length>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L1I0M0H0T0D0>;
  <http://qudt.org/schema/qudt/informativeReference> "http://goldbook.iupac.org/M03782.html"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/symbol> "R";
  <http://qudt.org/schema/qudt/plainTextDescription> "\"Mean Linear Range\" is, in a given material, for specified charged particles of a specified energy, the average displacement of the particles before they stop. That is, the mean totl rectified path length travelled by a particle in the course of slowing down to rest (or to some suitable cut-off energy) in a given substance under specified conditions averaged over a group of particles having the same initial energy.";
  <http://qudt.org/schema/qudt/applicableUnit> unit:ANGSTROM, unit:AU, unit:BTU_IT-PER-LB_F,
    unit:CH, unit:CHAIN_US, unit:CentiM, unit:DecaM, unit:DeciM, unit:FATH, unit:FM, unit:FemtoM,
    unit:FT, unit:FT_US, unit:FUR, unit:FUR_Long, unit:GAUGE_FR, unit:GA_Charriere, unit:HectoM,
    unit:IN, unit:KiloM, unit:LY, unit:M, unit:MI, unit:MI_N, unit:MI_US, unit:MicroIN,
    unit:MicroM, unit:MilLength, unit:MilliIN, unit:MilliM, unit:NanoM, unit:PARSEC, unit:PCA,
    unit:PT, unit:PicoM, unit:PlanckLength, unit:ROD, unit:YD, unit:ZOLL;
  <http://qudt.org/schema/qudt/normativeReference> "http://www.iso.org/iso/catalogue_detail?csnumber=31895"^^xsd:anyURI .

<http://qudt.org/vocab/quantitykind/MechanicalEnergy> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Mechanical Energy"@en;
  rdfs:comment "Applicable units are those of quantitykind:Energy";
  dct:description "Mechanical Energy is the sum of potential energy and kinetic energy. It is the energy associated with the motion and position of an object."^^<http://qudt.org/schema/qudt/LatexString>;
  skos:broader <http://qudt.org/vocab/quantitykind/Energy>;
  <http://qudt.org/schema/qudt/dbpediaMatch> "http://dbpedia.org/resource/Mechanical_energy"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L2I0M1H0T-2D0>;
  <http://qudt.org/schema/qudt/informativeReference> "http://en.wikipedia.org/wiki/Mechanical_energy"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/symbol> "E";
  <http://qudt.org/schema/qudt/isoNormativeReference> "http://www.iso.org/iso/catalogue_detail?csnumber=31889"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/plainTextDescription> "Mechanical Energy is the sum of potential energy and kinetic energy. It is the energy associated with the motion and position of an object.";
  <http://qudt.org/schema/qudt/latexDefinition> "$E = T + V$, where $T$ is kinetic energy and $V$ is potential energy."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/applicableUnit> unit:AttoJ, unit:BTU_IT, unit:BTU_TH,
