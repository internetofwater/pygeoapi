  <http://qudt.org/schema/qudt/symbol> "cd/ft²";
  <http://qudt.org/schema/qudt/ucumCode> "cd.[ft_i]-2"^^<http://qudt.org/schema/qudt/UCUMcs>;
  <http://qudt.org/schema/qudt/uneceCommonCode> "P32" .

<http://qudt.org/vocab/dimensionvector/A0E0L-2I1M0H0T0D0> a <http://qudt.org/schema/qudt/QuantityKindDimensionVector_SI>,
