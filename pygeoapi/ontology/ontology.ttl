quantitykind:ElectronDensity a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "Electron Density"@en, "Electron Density"@en;
  rdfs:comment "Applicable units are those of quantitykind:NumberDensity", "Applicable units are those of quantitykind:NumberDensity";
  dct:description """
  $\\textit{Electron Density}$ is the number of electrons per volume in conduction bands. 
  It is the measure of the probability of an electron being present at a specific location.
  """^^qudt:LatexString,
    """
  $\\textit{Electron Density}$ is the number of electrons per volume in conduction bands. 
  It is the measure of the probability of an electron being present at a specific location.
  """^^qudt:LatexString;
