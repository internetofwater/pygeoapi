quantitykind:Conductivity a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:seeAlso quantitykind:ElectricCurrentDensity, quantitykind:ElectricCurrentDensity,
    quantitykind:ElectricFieldStrength, quantitykind:ElectricFieldStrength;
  rdfs:label "Conductivity"@en, "Conductivity"@en;
  rdfs:comment "Applicable units are those of quantitykind:Conductivity", "Applicable units are those of quantitykind:Conductivity";
  dct:description """
  $\\textit{Conductivity}$ is a scalar or tensor quantity the product of which by the electric field strength in a medium is equal to the electric current density. 
  For an isotropic medium the conductivity is a scalar quantity; for an anisotropic medium it is a tensor quantity.
  $$\\mathbf{J} = \\sigma \\mathbf{E}$$
  Where $\\mathbf{J}$ is electric current density, and $\\mathbf{E}$ is electric field strength.
  """^^qudt:LatexString,
    """
  $\\textit{Conductivity}$ is a scalar or tensor quantity the product of which by the electric field strength in a medium is equal to the electric current density. 
  For an isotropic medium the conductivity is a scalar quantity; for an anisotropic medium it is a tensor quantity.
  $$\\mathbf{J} = \\sigma \\mathbf{E}$$
  Where $\\mathbf{J}$ is electric current density, and $\\mathbf{E}$ is electric field strength.
  """^^qudt:LatexString;
  qudt:hasDimensionVector dimensionvector:A0E2L-3I0M-1H0T3D0, dimensionvector:A0E2L-3I0M-1H0T3D0;
  qudt:iec61360Code "0112/2///62720#UAD025", "0112/2///62720#UAD025";
  qudt:informativeReference "http://www.iso.org/iso/home/store/catalogue_tc/catalogue_detail.htm?csnumber=31891"^^xsd:anyURI,
    "http://www.iso.org/iso/home/store/catalogue_tc/catalogue_detail.htm?csnumber=31891"^^xsd:anyURI,
    "http://www.electropedia.org/iev/iev.nsf/display?openform&ievref=121-12-03"^^xsd:anyURI,
    "http://www.electropedia.org/iev/iev.nsf/display?openform&ievref=121-12-03"^^xsd:anyURI,
    "https://cdd.iec.ch/cdd/iec61987/iec61987.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD025"^^xsd:anyURI,
    "https://cdd.iec.ch/cdd/iec61987/iec61987.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD025"^^xsd:anyURI;
  qudt:plainTextDescription "\"Conductivity\" is a scalar or tensor quantity the product of which by the electric field strength in a medium is equal to the electric current density. For an isotropic medium the conductivity is a scalar quantity; for an anisotropic medium it is a tensor quantity.",
    "\"Conductivity\" is a scalar or tensor quantity the product of which by the electric field strength in a medium is equal to the electric current density. For an isotropic medium the conductivity is a scalar quantity; for an anisotropic medium it is a tensor quantity.";
  qudt:latexSymbol "$\\gamma$"^^qudt:LatexString, "$\\gamma$"^^qudt:LatexString, "$\\sigma$"^^qudt:LatexString,
    "$\\sigma$"^^qudt:LatexString;
  qudt:latexDefinition "$\\mathbf{J} = \\sigma \\mathbf{E}$, where $\\mathbf{J}$ is electric current density, and $\\mathbf{E}$ is electric field strength."^^qudt:LatexString,
    "$\\mathbf{J} = \\sigma \\mathbf{E}$, where $\\mathbf{J}$ is electric current density, and $\\mathbf{E}$ is electric field strength."^^qudt:LatexString;
  qudt:applicableUnit unit:DeciS-PER-M, unit:DeciS-PER-M, unit:S-PER-M, unit:S-PER-M,
    unit:KiloS-PER-M, unit:KiloS-PER-M, unit:MegaS-PER-M, unit:MegaS-PER-M, unit:MicroS-PER-CentiM,
    unit:MicroS-PER-CentiM, unit:MicroS-PER-M, unit:MicroS-PER-M, unit:MilliS-PER-CentiM,
    unit:MilliS-PER-CentiM, unit:MilliS-PER-M, unit:MilliS-PER-M, unit:NanoS-PER-CentiM,
    unit:NanoS-PER-CentiM, unit:NanoS-PER-M, unit:NanoS-PER-M, unit:PicoS-PER-M, unit:PicoS-PER-M,
