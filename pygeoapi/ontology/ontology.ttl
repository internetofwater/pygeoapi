  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/unit>;
  rdfs:label "cubic metre per second bar";
  dct:description "power of the SI base unit metre with the exponent 3 divided by the product out of the SI base unit second and the unit bar";
