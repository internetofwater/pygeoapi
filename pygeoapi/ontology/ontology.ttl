quantitykind:Exposure a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "Exposure"@en, "Exposure"@en;
  rdfs:comment "Applicable units are those of quantitykind:ElectricChargePerMass", "Applicable units are those of quantitykind:ElectricChargePerMass";
  dct:description "\"Exposure\" reflects the extent of ionization events taking place when air is irradiated by ionizing photons (gamma radiation and/or x rays). In photography, exposure is the amount of light allowed to fall on each area unit of a photographic medium (photographic film or image sensor) during the process of taking a photograph. Exposure is measured in lux seconds, and can be computed from exposure value (EV) and scene luminance in a specified region."^^qudt:LatexString,
    "\"Exposure\" reflects the extent of ionization events taking place when air is irradiated by ionizing photons (gamma radiation and/or x rays). In photography, exposure is the amount of light allowed to fall on each area unit of a photographic medium (photographic film or image sensor) during the process of taking a photograph. Exposure is measured in lux seconds, and can be computed from exposure value (EV) and scene luminance in a specified region."^^qudt:LatexString;
  skos:broader quantitykind:ElectricChargePerMass, quantitykind:ElectricChargePerMass;
  qudt:dbpediaMatch "http://dbpedia.org/resource/Exposure"^^xsd:anyURI, "http://dbpedia.org/resource/Exposure"^^xsd:anyURI;
  qudt:hasDimensionVector dimensionvector:A0E1L0I0M-1H0T1D0, dimensionvector:A0E1L0I0M-1H0T1D0;
  qudt:informativeReference "http://en.wikipedia.org/wiki/Exposure_%28photography%29"^^xsd:anyURI,
    "http://en.wikipedia.org/wiki/Exposure_%28photography%29"^^xsd:anyURI, "http://hps.org/publicinformation/ate/faqs/gammaandexposure.html"^^xsd:anyURI,
    "http://hps.org/publicinformation/ate/faqs/gammaandexposure.html"^^xsd:anyURI;
  qudt:siExactMatch <https://si-digital-framework.org/SI/quantities/XPOS>, <https://si-digital-framework.org/quantities/XPOS>;
  qudt:symbol "X", "X";
  qudt:isoNormativeReference "http://www.iso.org/iso/catalogue_detail?csnumber=31895"^^xsd:anyURI,
    "http://www.iso.org/iso/catalogue_detail?csnumber=31895"^^xsd:anyURI;
  qudt:plainTextDescription "\"Exposure\" reflects the extent of ionization events taking place when air is irradiated by ionizing photons (gamma radiation and/or x rays). In photography, exposure is the amount of light allowed to fall on each area unit of a photographic medium (photographic film or image sensor) during the process of taking a photograph. Exposure is measured in lux seconds, and can be computed from exposure value (EV) and scene luminance in a specified region.",
    "\"Exposure\" reflects the extent of ionization events taking place when air is irradiated by ionizing photons (gamma radiation and/or x rays). In photography, exposure is the amount of light allowed to fall on each area unit of a photographic medium (photographic film or image sensor) during the process of taking a photograph. Exposure is measured in lux seconds, and can be computed from exposure value (EV) and scene luminance in a specified region.";
  qudt:latexDefinition "For X-or gamma radiation, $X = \\frac{dQ}{dm}$, where $dQ$ is the absolute value of the mean total electric charge of the ions of the same sign produced in dry air when all the electrons and positrons liberated or created by photons in an element of air are completely stopped in air, and $dm$ is the mass of that element."^^qudt:LatexString,
    "For X-or gamma radiation, $X = \\frac{dQ}{dm}$, where $dQ$ is the absolute value of the mean total electric charge of the ions of the same sign produced in dry air when all the electrons and positrons liberated or created by photons in an element of air are completely stopped in air, and $dm$ is the mass of that element."^^qudt:LatexString;
  qudt:applicableUnit unit:A-HR-PER-KiloGM, unit:A-HR-PER-KiloGM, unit:A-M2-PER-J-SEC,
    unit:A-M2-PER-J-SEC, unit:C-PER-KiloGM, unit:C-PER-KiloGM, unit:HZ-PER-T, unit:HZ-PER-T,
    unit:KiloR, unit:KiloR, unit:MegaHZ-PER-T, unit:MegaHZ-PER-T, unit:MilliC-PER-KiloGM,
    unit:MilliC-PER-KiloGM, unit:MilliR, unit:MilliR, unit:PER-T-SEC, unit:PER-T-SEC,
    unit:R, unit:R .

quantitykind:ExposureOfIonizingRadiation a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "exposure of ionizing radiation"@en-US, "exposure of ionizing radiation"@en-US;
  dct:description "measure of an electromagnetic radiation field to which a material is exposed in terms of ionization, which the radiation produces as reference material air, expressed as ratio of ∂Q and ∂m, where ∂Q is the absolute value of the total charge of the ions of one sign produced in the air of mass ∂m when all of the electrons (and positrons) liberated by photons in this mass element are completely stopped"@en,
    "measure of an electromagnetic radiation field to which a material is exposed in terms of ionization, which the radiation produces as reference material air, expressed as ratio of ∂Q and ∂m, where ∂Q is the absolute value of the total charge of the ions of one sign produced in the air of mass ∂m when all of the electrons (and positrons) liberated by photons in this mass element are completely stopped"@en;
  qudt:hasDimensionVector dimensionvector:A0E1L0I0M-1H0T1D0, dimensionvector:A0E1L0I0M-1H0T1D0;
  qudt:symbol "0173-1#Z4-BAJ326#002", "0173-1#Z4-BAJ326#002";
  qudt:plainTextDescription "Maß für die Wirkung eines elektromagnetischen Feldes auf Materie in Form der Ionisation, die die Strahlung im Referenzmaterial Luft erzeugt, ausgedrückt als Quotient aus ∂Q und ∂m, wobei ∂Q der Absolutwert der gesamten elektrischen Ladung der Ionen eines Vorzeichens ist, die in Luft der Masse ∂m gebildet wird, wenn in diesem Massenelement alle Elektronen (und Positronen), die durch die Photonen freigesetzt werden, komplett gestoppt werden"@de,
    "Maß für die Wirkung eines elektromagnetischen Feldes auf Materie in Form der Ionisation, die die Strahlung im Referenzmaterial Luft erzeugt, ausgedrückt als Quotient aus ∂Q und ∂m, wobei ∂Q der Absolutwert der gesamten elektrischen Ladung der Ionen eines Vorzeichens ist, die in Luft der Masse ∂m gebildet wird, wenn in diesem Massenelement alle Elektronen (und Positronen), die durch die Photonen freigesetzt werden, komplett gestoppt werden"@de .

quantitykind:ExposureRateOfIonizingRadiation a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "exposure rate of ionizing radiation"@en-US, "exposure rate of ionizing radiation"@en-US;
  dct:description "ratio between the exposure of ionizing radiation dJ in a time interval and the duration dt of this interval"@en,
    "ratio between the exposure of ionizing radiation dJ in a time interval and the duration dt of this interval"@en;
