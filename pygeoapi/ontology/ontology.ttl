quantitykind:RelativeHumidity a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:seeAlso quantitykind:AbsoluteHumidity, quantitykind:AbsoluteHumidity;
  rdfs:label "Relative Humidity"@en, "Relative Humidity"@en;
  rdfs:comment "Applicable units are those of quantitykind:RelativeHumidity", "Applicable units are those of quantitykind:RelativeHumidity";
  dct:description """
  $\\textit{Relative Humidity}$ is the ratio of the partial pressure of water vapor in an air-water mixture to the saturated vapor pressure of water at a prescribed temperature. 
  The relative humidity of air depends not only on temperature but also on the pressure of the system of interest. 
  $$$$
  $\\textit{Relative Humidity}$ is also referred to as $\\textit{Relative Partial Pressure}$. 
  $$$$
  Relative partial pressure is often referred to as $RH$ and expressed in percent.
  """^^qudt:LatexString,
    """
  $\\textit{Relative Humidity}$ is the ratio of the partial pressure of water vapor in an air-water mixture to the saturated vapor pressure of water at a prescribed temperature. 
  The relative humidity of air depends not only on temperature but also on the pressure of the system of interest. 
  $$$$
  $\\textit{Relative Humidity}$ is also referred to as $\\textit{Relative Partial Pressure}$. 
  $$$$
  Relative partial pressure is often referred to as $RH$ and expressed in percent.
  """^^qudt:LatexString;
  skos:altLabel "RH", "RH";
  skos:broader quantitykind:RelativePartialPressure, quantitykind:RelativePartialPressure;
  qudt:hasDimensionVector dimensionvector:A0E0L0I0M0H0T0D1, dimensionvector:A0E0L0I0M0H0T0D1;
  qudt:informativeReference "http://en.wikipedia.org/wiki/Relative_humidity"^^xsd:anyURI,
    "http://en.wikipedia.org/wiki/Relative_humidity"^^xsd:anyURI;
  qudt:isoNormativeReference "http://www.iso.org/iso/catalogue_detail?csnumber=31890"^^xsd:anyURI,
    "http://www.iso.org/iso/catalogue_detail?csnumber=31890"^^xsd:anyURI;
  qudt:latexSymbol "$\\varphi$"^^qudt:LatexString, "$\\varphi$"^^qudt:LatexString;
  qudt:latexDefinition "$\\varphi = p / p_{sat}$, where $p$ is partial pressure of vapour,  $p_{sat}$ is thermodynamic temperature and $V$ is its partial pressure at saturation (at the same temperature). Relative partial pressure is often referred to as $RH$ and expressed in percent. $\\textit{Relative Humidity}$ is also referred to as $\\textit{Relative Partial Pressure}$."^^qudt:LatexString,
    "$\\varphi = p / p_{sat}$, where $p$ is partial pressure of vapour,  $p_{sat}$ is thermodynamic temperature and $V$ is its partial pressure at saturation (at the same temperature). Relative partial pressure is often referred to as $RH$ and expressed in percent. $\\textit{Relative Humidity}$ is also referred to as $\\textit{Relative Partial Pressure}$."^^qudt:LatexString;
  qudt:applicableUnit unit:PERCENT, unit:PERCENT, unit:PERCENT_RH, unit:PERCENT_RH .

