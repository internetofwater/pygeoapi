quantitykind:BulkModulus a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "Bulk Modulus"@en, "Bulk Modulus"@en;
  rdfs:comment "Applicable units are those of quantitykind:BulkModulus", "Applicable units are those of quantitykind:BulkModulus";
  dct:description "The bulk modulus of a substance measures the substance's resistance to uniform compression. It is defined as the ratio of the infinitesimal pressure increase to the resulting relative decrease of the volume."^^qudt:LatexString,
    "The bulk modulus of a substance measures the substance's resistance to uniform compression. It is defined as the ratio of the infinitesimal pressure increase to the resulting relative decrease of the volume."^^qudt:LatexString;
  qudt:hasDimensionVector dimensionvector:A0E0L-1I0M1H0T-2D0, dimensionvector:A0E0L-1I0M1H0T-2D0;
  qudt:informativeReference "http://en.wikipedia.org/wiki/Bulk_modulus"^^xsd:anyURI,
    "http://en.wikipedia.org/wiki/Bulk_modulus"^^xsd:anyURI;
  qudt:symbol "K", "K";
  qudt:isoNormativeReference "http://www.iso.org/iso/catalogue_detail?csnumber=31889"^^xsd:anyURI,
    "http://www.iso.org/iso/catalogue_detail?csnumber=31889"^^xsd:anyURI;
  qudt:plainTextDescription "The bulk modulus of a substance measures the substance's resistance to uniform compression. It is defined as the ratio of the infinitesimal pressure increase to the resulting relative decrease of the volume.",
    "The bulk modulus of a substance measures the substance's resistance to uniform compression. It is defined as the ratio of the infinitesimal pressure increase to the resulting relative decrease of the volume.";
  qudt:latexDefinition "$K = \\frac{p}{\\vartheta}$, where $p$ is pressure and $\\vartheta$ is volume strain."^^qudt:LatexString,
    "$K = \\frac{p}{\\vartheta}$, where $p$ is pressure and $\\vartheta$ is volume strain."^^qudt:LatexString;
  qudt:applicableUnit unit:PA, unit:PA, unit:PicoPA, unit:PicoPA .

quantitykind:Fugacity a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "Fugasiti"@ms, "Fugasiti"@ms, "Fugazität"@de, "Fugazität"@de, "Lotność"@pl,
    "Lotność"@pl, "fugacidad"@es, "fugacidad"@es, "fugacidade"@pt, "fugacidade"@pt, "fugacita"@cs,
    "fugacita"@cs, "fugacitate"@ro, "fugacitate"@ro, "fugacity"@en, "fugacity"@en, "fugacità"@it,
    "fugacità"@it, "fugacité"@fr, "fugacité"@fr, "fügasite"@tr, "fügasite"@tr, "انفلاتية"@ar,
    "انفلاتية"@ar, "بی‌دوامی"@fa, "بی‌دوامی"@fa, "フガシティー"@ja, "フガシティー"@ja, "逸度"@zh, "逸度"@zh;
  rdfs:comment "Applicable units are those of quantitykind:Fugacity", "Applicable units are those of quantitykind:Fugacity";
  dct:description "\"Fugacity\" of a real gas is an effective pressure which replaces the true mechanical pressure in accurate chemical equilibrium calculations. It is equal to the pressure of an ideal gas which has the same chemical potential as the real gas."^^qudt:LatexString,
    "\"Fugacity\" of a real gas is an effective pressure which replaces the true mechanical pressure in accurate chemical equilibrium calculations. It is equal to the pressure of an ideal gas which has the same chemical potential as the real gas."^^qudt:LatexString;
  qudt:hasDimensionVector dimensionvector:A0E0L-1I0M1H0T-2D0, dimensionvector:A0E0L-1I0M1H0T-2D0;
  qudt:informativeReference "http://en.wikipedia.org/wiki/Fugacity"^^xsd:anyURI, "http://en.wikipedia.org/wiki/Fugacity"^^xsd:anyURI;
  qudt:isoNormativeReference "http://www.iso.org/iso/catalogue_detail?csnumber=31894"^^xsd:anyURI,
    "http://www.iso.org/iso/catalogue_detail?csnumber=31894"^^xsd:anyURI;
  qudt:plainTextDescription "\"Fugacity\" of a real gas is an effective pressure which replaces the true mechanical pressure in accurate chemical equilibrium calculations. It is equal to the pressure of an ideal gas which has the same chemical potential as the real gas.",
    "\"Fugacity\" of a real gas is an effective pressure which replaces the true mechanical pressure in accurate chemical equilibrium calculations. It is equal to the pressure of an ideal gas which has the same chemical potential as the real gas.";
  qudt:latexSymbol "$\\tilde{p}_B$"^^qudt:LatexString, "$\\tilde{p}_B$"^^qudt:LatexString;
  qudt:applicableUnit unit:PA, unit:PA, unit:PicoPA, unit:PicoPA .

