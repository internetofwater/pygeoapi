    unit:DecaK, unit:MegaK, unit:MilliK .

quantitykind:WetBulbTemperature a qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/vocab/quantitykind>;
  rdfs:label "Wet Bulb Temperature"@en;
  rdfs:comment "Applicable units are those of quantitykind:Temperature";
