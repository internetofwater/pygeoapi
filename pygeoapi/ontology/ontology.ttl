  <http://qudt.org/schema/qudt/applicableUnit> unit:IN-PER-SEC .

unit:IN-PER-SEC-DEG_F a <http://qudt.org/schema/qudt/Unit>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/unit>;
  rdfs:label "inch per second degree Fahrenheit";
  dct:description "unit inch according to the Anglo-American and the Imperial system of units divided by the product of the SI base unit second and the traditional unit degree Fahrenheit";
  <http://qudt.org/schema/qudt/conversionMultiplier> 0.0457199999999999963424000000000003048;
