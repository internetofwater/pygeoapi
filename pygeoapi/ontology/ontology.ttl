quantitykind:Strain a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "Strain"@en, "Strain"@en;
  rdfs:comment "Applicable units are those of quantitykind:DimensionlessRatio", "Applicable units are those of quantitykind:DimensionlessRatio";
  dct:description "In any branch of science dealing with materials and their behaviour, strain is the geometrical expression of deformation caused by the action of stress on a physical body. Strain is calculated by first assuming a change between two body states: the beginning state and the final state. Then the difference in placement of two points in this body in those two states expresses the numerical value of strain. Strain therefore expresses itself as a change in size and/or shape. [Wikipedia]"^^qudt:LatexString,
    "In any branch of science dealing with materials and their behaviour, strain is the geometrical expression of deformation caused by the action of stress on a physical body. Strain is calculated by first assuming a change between two body states: the beginning state and the final state. Then the difference in placement of two points in this body in those two states expresses the numerical value of strain. Strain therefore expresses itself as a change in size and/or shape. [Wikipedia]"^^qudt:LatexString;
  skos:broader quantitykind:DimensionlessRatio, quantitykind:DimensionlessRatio;
  qudt:dbpediaMatch "http://dbpedia.org/resource/Strain"^^xsd:anyURI, "http://dbpedia.org/resource/Strain"^^xsd:anyURI;
  qudt:hasDimensionVector dimensionvector:A0E0L0I0M0H0T0D1, dimensionvector:A0E0L0I0M0H0T0D1;
  qudt:informativeReference "http://www.freestudy.co.uk/mech%20prin%20h2/stress.pdf"^^xsd:anyURI,
    "http://www.freestudy.co.uk/mech%20prin%20h2/stress.pdf"^^xsd:anyURI;
  qudt:plainTextDescription "In any branch of science dealing with materials and their behaviour, strain is the geometrical expression of deformation caused by the action of stress on a physical body. Strain is calculated by first assuming a change between two body states: the beginning state and the final state. Then the difference in placement of two points in this body in those two states expresses the numerical value of strain. Strain therefore expresses itself as a change in size and/or shape. [Wikipedia]",
    "In any branch of science dealing with materials and their behaviour, strain is the geometrical expression of deformation caused by the action of stress on a physical body. Strain is calculated by first assuming a change between two body states: the beginning state and the final state. Then the difference in placement of two points in this body in those two states expresses the numerical value of strain. Strain therefore expresses itself as a change in size and/or shape. [Wikipedia]";
  qudt:exactMatch quantitykind:LinearStrain, quantitykind:LinearStrain;
  qudt:latexSymbol "$\\epsilon$"^^qudt:LatexString, "$\\epsilon$"^^qudt:LatexString;
  qudt:applicableUnit unit:FRACTION, unit:FRACTION, unit:GR, unit:GR, unit:NUM, unit:NUM,
    unit:ONE-PER-ONE, unit:PERCENT, unit:PERCENT, unit:PERMITTIVITY_REL, unit:PERMITTIVITY_REL,
    unit:PPB, unit:PPB, unit:PPM, unit:PPM, unit:PPQ, unit:PPQ, unit:PPT, unit:PPT, unit:PPTH,
    unit:PPTH, unit:PPTM, unit:PPTM, unit:PSU, unit:PSU, unit:UNITLESS, unit:UNITLESS .

