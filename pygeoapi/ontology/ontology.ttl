    "B/m"^^<http://qudt.org/schema/qudt/UCUMcs>;
  <http://qudt.org/schema/qudt/uneceCommonCode> "P43" .

<http://qudt.org/vocab/dimensionvector/A0E0L-1I0M0H0T0D0> a <http://qudt.org/schema/qudt/QuantityKindDimensionVector_SI>,
    <http://qudt.org/schema/qudt/QuantityKindDimensionVector_CGS>, <http://qudt.org/schema/qudt/QuantityKindDimensionVector_ISO>,
