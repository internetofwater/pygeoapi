<http://qudt.org/vocab/quantitykind/LinearStiffness> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Linear Force"@en, "Streckenlast"@de;
