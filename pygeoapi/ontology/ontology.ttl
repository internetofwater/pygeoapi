unit:M2-PER-SEC-K a qudt:Unit, qudt:Unit;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/unit>, <http://qudt.org/vocab/unit>;
  rdfs:label "square metre per second kelvin", "square metre per second kelvin";
  dct:description """
  The unit $\\textit{Square Metre per Second Kelvin}$ is a heat transfer coefficient that is area-dependent
   and varies with time and temperature difference. 
  Heat transfer is typically defined in terms of watts per square meter per kelvin ($W/m^{2}K$),
   representing the rate of heat transfer across a surface per unit area per unit temperature difference.
  """^^qudt:LatexString,
    """
  The unit $\\textit{Square Metre per Second Kelvin}$ is a heat transfer coefficient that is area-dependent
   and varies with time and temperature difference. 
  Heat transfer is typically defined in terms of watts per square meter per kelvin ($W/m^{2}K$),
   representing the rate of heat transfer across a surface per unit area per unit temperature difference.
  """^^qudt:LatexString;
  qudt:conversionMultiplier 1.0, 1.0;
  qudt:conversionMultiplierSN 1.0E0, 1.0E0;
  qudt:hasDimensionVector dimensionvector:A0E0L2I0M0H-1T-1D0, dimensionvector:A0E0L2I0M0H-1T-1D0;
