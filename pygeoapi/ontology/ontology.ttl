unit:MicroC-PER-M2 a <http://qudt.org/schema/qudt/Unit>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/unit>;
  rdfs:label "Microcoulomb per Square Meter"@en-US, "Microcoulomb per Square Metre"@en;
  dct:description "0.000001-fold of the SI derived unit coulomb divided by the power of the SI base unit metre with the exponent 2"^^rdf:HTML;
