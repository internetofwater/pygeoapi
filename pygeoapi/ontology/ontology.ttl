<http://qudt.org/vocab/quantitykind/MagneticAreaMoment> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Magnetic Area Moment"@en;
  rdfs:comment "Applicable units are those of quantitykind:MagneticAreaMoment";
  dct:description "\"Magnetic Area Moment\", for a magnetic dipole, is a vector quantity equal to the product of the current, the loop area, and the unit vector normal to the loop plane, the direction of which corresponds to the loop orientation. \"Magnetic Area Moment\" is also referred to as \"Magnetic Moment\"."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E1L2I0M0H0T0D0>;
  <http://qudt.org/schema/qudt/informativeReference> "http://www.iso.org/iso/home/store/catalogue_tc/catalogue_detail.htm?csnumber=31891"^^xsd:anyURI,
    "http://www.electropedia.org/iev/iev.nsf/display?openform&ievref=121-11-49"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/symbol> "m";
  <http://qudt.org/schema/qudt/plainTextDescription> "\"Magnetic Area Moment\", for a magnetic dipole, is a vector quantity equal to the product of the current, the loop area, and the unit vector normal to the loop plane, the direction of which corresponds to the loop orientation. \"Magnetic Area Moment\" is also referred to as \"Magnetic Moment\".";
  <http://qudt.org/schema/qudt/exactMatch> <http://qudt.org/vocab/quantitykind/MagneticMoment>;
  <http://qudt.org/schema/qudt/latexDefinition> "$m = I e_n A$, where $I$ is electric current in a small closed loop, $e_n$ is a unit vector perpendicular to the loop, and $A$ is the area of the loop. The magnetic moment of a substance within a domain is the vector sum of the magnetic moments of all entities included in the domain."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/applicableUnit> unit:A-M2, unit:A_Ab-CentiM2, unit:EV-PER-T,
    unit:J-PER-T .

<http://qudt.org/vocab/quantitykind/MagneticMoment> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Magnetický dipól"@cs, "Manyetik moment"@tr, "Momen magnetik"@ms, "dipol magnetyczny"@pl,
    "magnetic moment"@en, "magnetisches Dipolmoment"@de, "moment magnétique"@fr, "momento de dipolo magnético"@es,
    "momento de dipolo magnético"@pt, "momento di dipolo magnetico"@it, "Магнитный момент"@ru,
    "دوقطبی مغناطیسی"@fa, "عزم مغناطيسي"@ar, "चुम्बकीय द्विध्रुव"@hi, "磁偶极"@zh, "磁気双極子"@ja;
  rdfs:comment "Applicable units are those of quantitykind:MagneticMoment";
  dct:description "\"Magnetic Moment\", for a magnetic dipole, is a vector quantity equal to the product of the current, the loop area, and the unit vector normal to the loop plane, the direction of which corresponds to the loop orientation. \"Magnetic Moment\" is also referred to as \"Magnetic Area Moment\", and is not to be confused with Magnetic Dipole Moment."^^<http://qudt.org/schema/qudt/LatexString>;
  skos:altLabel "giromagnetic moment"@en, "momen giromagnetik"@ms, "moment giromagnétique"@fr;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E1L2I0M0H0T0D0>;
  <http://qudt.org/schema/qudt/iec61360Code> "0112/2///62720#UAD097", "0112/2///62720#UAD101";
  <http://qudt.org/schema/qudt/informativeReference> "http://www.iso.org/iso/home/store/catalogue_tc/catalogue_detail.htm?csnumber=31891"^^xsd:anyURI,
    "http://www.electropedia.org/iev/iev.nsf/display?openform&ievref=121-11-49"^^xsd:anyURI,
    "https://www.simetric.co.uk/siderived.htm"^^xsd:anyURI, "https://cdd.iec.ch/cdd/iec61987/iec61987.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD097"^^xsd:anyURI,
    "https://cdd.iec.ch/cdd/iec61987/iec61987.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD101"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/symbol> "m";
  <http://qudt.org/schema/qudt/plainTextDescription> "\"Magnetic Moment\", for a magnetic dipole, is a vector quantity equal to the product of the current, the loop area, and the unit vector normal to the loop plane, the direction of which corresponds to the loop orientation. \"Magnetic Moment\" is also referred to as \"Magnetic Area Moment\", and is not to be confused with Magnetic Dipole Moment.";
  <http://qudt.org/schema/qudt/exactMatch> <http://qudt.org/vocab/quantitykind/MagneticAreaMoment>;
  <http://qudt.org/schema/qudt/latexDefinition> "$m = I e_n A$, where $I$ is electric current in a small closed loop, $e_n$ is a unit vector perpendicular to the loop, and $A$ is the area of the loop. The magnetic moment of a substance within a domain is the vector sum of the magnetic moments of all entities included in the domain."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/applicableUnit> unit:A-M2, unit:A_Ab-CentiM2, unit:EV-PER-T,
    unit:J-PER-T .

