unit:M2-PER-M a <http://qudt.org/schema/qudt/Unit>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/unit>;
  rdfs:label "Quadratmeter je Meter"@de, "kvadratni meter na meter"@sl, "meter persegi per meter"@ms,
    "metr kwadratowy na metr"@pl, "metrekare per metre"@tr, "metro cuadrado pormetro"@es,
    "metro quadrado por metro"@pt, "metro quadrato al metro"@it, "metru pătrat pe metru"@ro,
    "mètre carré par mètre"@fr, "square metre per metre"@en, "čtvereční metr na metr"@cs,
    "квадратный метр на метр"@ru;
  <http://qudt.org/schema/qudt/applicableSystem> <http://qudt.org/vocab/sou/SI>;
  <http://qudt.org/schema/qudt/conversionMultiplier> 1.0;
