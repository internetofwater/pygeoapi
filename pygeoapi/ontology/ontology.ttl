  <http://qudt.org/schema/qudt/hasQuantityKind> <http://qudt.org/vocab/quantitykind/Length>;
  <http://qudt.org/schema/qudt/iec61360Code> "0112/2///62720#UAA372";
  <http://qudt.org/schema/qudt/informativeReference> "https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAA372"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/symbol> "ch (US survey)";
  <http://qudt.org/schema/qudt/uneceCommonCode> "M49" .

unit:CHF-PER-KiloGM a <http://qudt.org/schema/qudt/Unit>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/unit>;
  rdfs:label "Swiss Francs per kilogram"@en;
