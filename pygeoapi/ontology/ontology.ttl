variablename:cadmiumDissolved a skos:Concept ;
    skos:definition "Cadmium is a chemical element with symbol Cd and atomic number 48. This soft, bluish-white metal is chemically similar to the two other stable metals in group 12, zinc and mercury. Like zinc, it demonstrates oxidation state +2 in most of its compounds, and like mercury, it has a lower melting point than the transition metals in groups 3 through 11. Cadmium and its congeners in group 12 are often not considered transition metals, in that they do not have partly filled d or f electron shells in the elemental or common oxidation states. The average concentration of cadmium in Earth's crust is between 0.1 and 0.5 parts per million (ppm).",
        "Dissolved Cadmium. For chemical terms, \"dissolved\" indicates a filtered sample." ;
    skos:exactMatch "https://en.wikipedia.org/wiki/Cadmium" ;
    skos:historyNote "Originally from the CUAHSI HIS VariableNameCV.  See: http://his.cuahsi.org/mastercvreg/edit_cv11.aspx?tbl=VariableNameCV.",
        "Wikipedia" ;
    skos:inScheme <http://vocabulary.odm2.org/variablename> ;
    skos:note "Added to support Critical Zone Observatory (CZO) data use cases. " ;
    skos:prefLabel "Cadmium, dissolved" ;
    skos:topConceptOf <http://vocabulary.odm2.org/variablename> .

variablename:cadmiumDistributionCoefficient a skos:Concept ;
    skos:definition "Ratio of concentrations of cadmium in two phases in equilibrium with each other. Phases must be specified." ;
    skos:historyNote "Originally from the CUAHSI HIS VariableNameCV.  See: http://his.cuahsi.org/mastercvreg/edit_cv11.aspx?tbl=VariableNameCV." ;
    skos:inScheme <http://vocabulary.odm2.org/variablename> ;
    skos:prefLabel "Cadmium, distribution coefficient" ;
    skos:topConceptOf <http://vocabulary.odm2.org/variablename> .

variablename:cadmiumParticulate a skos:Concept ;
    skos:definition "Particulate cadmium (Cd) in suspension" ;
    skos:historyNote "Originally from the CUAHSI HIS VariableNameCV.  See: http://his.cuahsi.org/mastercvreg/edit_cv11.aspx?tbl=VariableNameCV." ;
    skos:inScheme <http://vocabulary.odm2.org/variablename> ;
    skos:prefLabel "Cadmium, particulate" ;
    skos:topConceptOf <http://vocabulary.odm2.org/variablename> .

variablename:cadmiumTotal a skos:Concept ;
    skos:definition "Total Cadmium (Cd). For chemical terms, \"total\" indciates an unfiltered sample." ;
    skos:historyNote "Originally from the CUAHSI HIS VariableNameCV.  See: http://his.cuahsi.org/mastercvreg/edit_cv11.aspx?tbl=VariableNameCV." ;
    skos:inScheme <http://vocabulary.odm2.org/variablename> ;
    skos:prefLabel "Cadmium, total" ;
    skos:topConceptOf <http://vocabulary.odm2.org/variablename> .

variablename:calciumDissolved a skos:Concept ;
    skos:definition "Calcium is a chemical element with symbol Ca and atomic number 20. An alkaline earth metal, calcium is a reactive metal that forms a dark oxide-nitride layer when exposed to air. Its physical and chemical properties are most similar to its heavier homologues strontium and barium. It is the fifth most abundant element in Earth's crust and the third most abundant metal, after iron and aluminium. The most common calcium compound on Earth is calcium carbonate, found in limestone and the fossilised remnants of early sea life; gypsum, anhydrite, fluorite, and apatite are also sources of calcium. The name derives from Latin calx \"lime\", which was obtained from heating limestone.",
        "Dissolved Calcium (Ca)" ;
    skos:exactMatch "https://en.wikipedia.org/wiki/Calcium" ;
    skos:historyNote "Originally from the CUAHSI HIS VariableNameCV.  See: http://his.cuahsi.org/mastercvreg/edit_cv11.aspx?tbl=VariableNameCV.",
        "Wikipedia" ;
    skos:inScheme <http://vocabulary.odm2.org/variablename> ;
    skos:note "Added to support Critical Zone Observatory (CZO) data use cases. " ;
    skos:prefLabel "Calcium, dissolved" ;
    skos:topConceptOf <http://vocabulary.odm2.org/variablename> .

variablename:calciumOxide a skos:Concept ;
    skos:definition "Calcium oxide (CaO), commonly known as quicklime or burnt lime, is a widely used chemical compound." ;
    skos:exactMatch "https://en.wikipedia.org/wiki/Calcium_oxide" ;
    skos:historyNote "Wikipedia" ;
    skos:inScheme <http://vocabulary.odm2.org/variablename> ;
    skos:note "Added to support Critical Zone Observatory (CZO) data use cases. " ;
    skos:prefLabel "Calcium oxide" ;
    skos:topConceptOf <http://vocabulary.odm2.org/variablename> .

variablename:canopyClosure a skos:Concept ;
    skos:definition "Crown closure is a term used in forestry. Crown closure and crown cover are two slightly different measures of the forest canopy and that determine the amount of light able to penetrate to the forest floor." ;
    skos:exactMatch "https://en.wikipedia.org/wiki/Crown_closure" ;
    skos:historyNote "Wikipedia" ;
    skos:inScheme <http://vocabulary.odm2.org/variablename> ;
    skos:note "Added to support Critical Zone Observatory (CZO) data use cases. " ;
    skos:prefLabel "Canopy closure" ;
    skos:topConceptOf <http://vocabulary.odm2.org/variablename> .

variablename:canopyHeight a skos:Concept ;
    skos:definition "Forest canopy density and height are used as variables in a number of environmental applications, such as biomass estimation, vegetation coverage, and biodiversity determination. Canopy density, or canopy cover, is the ratio of vegetation to ground as seen from the air. Canopy height measures how far above the ground the top of the canopy is. Lidar can be used to determine both of these variables." ;
    skos:exactMatch "http://desktop.arcgis.com/en/arcmap/10.3/manage-data/las-dataset/lidar-solutions-estimating-forest-density-and-height.htm" ;
    skos:inScheme <http://vocabulary.odm2.org/variablename> ;
    skos:note "Added to support Critical Zone Observatory (CZO) data use cases. " ;
    skos:prefLabel "Canopy height" ;
    skos:topConceptOf <http://vocabulary.odm2.org/variablename> .

