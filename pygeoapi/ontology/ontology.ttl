unit:PSU a qudt:Unit, qudt:Unit;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/unit>, <http://qudt.org/vocab/unit>;
  rdfs:seeAlso unit:PPTH, unit:PPTH;
  rdfs:label "Practical Salinity Unit"@en, "Practical Salinity Unit"@en;
  dct:description "Practical salinity scale 1978 (PSS-78) is used for ionic content of seawater determined by electrical conductivity. Salinities measured using PSS-78 do not have units, but are approximately scaled to parts-per-thousand for the valid range. The suffix psu or PSU (denoting practical salinity unit) is sometimes added to PSS-78 measurement values. The addition of PSU as a unit after the value is \"formally incorrect and strongly discouraged\"."^^rdf:HTML,
    "Practical salinity scale 1978 (PSS-78) is used for ionic content of seawater determined by electrical conductivity. Salinities measured using PSS-78 do not have units, but are approximately scaled to parts-per-thousand for the valid range. The suffix psu or PSU (denoting practical salinity unit) is sometimes added to PSS-78 measurement values. The addition of PSU as a unit after the value is \"formally incorrect and strongly discouraged\"."^^rdf:HTML;
  qudt:applicableSystem <http://qudt.org/vocab/sou/CGS-EMU>, <http://qudt.org/vocab/sou/CGS-EMU>,
    <http://qudt.org/vocab/sou/CGS-GAUSS>, <http://qudt.org/vocab/sou/CGS-GAUSS>, <http://qudt.org/vocab/sou/PLANCK>,
    <http://qudt.org/vocab/sou/PLANCK>, <http://qudt.org/vocab/sou/SI>, <http://qudt.org/vocab/sou/SI>,
    <http://qudt.org/vocab/sou/CGS>, <http://qudt.org/vocab/sou/CGS>, <http://qudt.org/vocab/sou/IMPERIAL>,
    <http://qudt.org/vocab/sou/IMPERIAL>, <http://qudt.org/vocab/sou/CGS-ESU>, <http://qudt.org/vocab/sou/CGS-ESU>,
    <http://qudt.org/vocab/sou/ASU>, <http://qudt.org/vocab/sou/ASU>;
  qudt:conversionMultiplier 0.0;
  qudt:conversionMultiplierSN 0.0E0;
  qudt:hasDimensionVector dimensionvector:A0E0L0I0M0H0T0D1, dimensionvector:A0E0L0I0M0H0T0D1;
  qudt:hasQuantityKind quantitykind:DimensionlessRatio, quantitykind:DimensionlessRatio;
  qudt:informativeReference "https://en.wikipedia.org/wiki/Salinity#PSU"^^xsd:anyURI,
    "https://en.wikipedia.org/wiki/Salinity#PSU"^^xsd:anyURI;
  qudt:symbol "PSU", "PSU";
  dct:source <https://unesdoc.unesco.org/ark:/48223/pf0000047932>, <https://unesdoc.unesco.org/ark:/48223/pf0000047932> .

