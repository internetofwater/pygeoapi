  <http://qudt.org/schema/qudt/ucumCode> "ds"^^<http://qudt.org/schema/qudt/UCUMcs>;
  <http://qudt.org/schema/qudt/uneceCommonCode> "C26";
  <http://qudt.org/schema/qudt/prefix> <http://qudt.org/vocab/prefix/Deci> .

