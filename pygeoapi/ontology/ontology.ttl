quantitykind:Area a qudt:QuantityKind ;
    rdfs:label "مساحة"@ar,
        "Площ"@bg,
        "plocha"@cs,
        "Fläche"@de,
        "Ταχύτητα"@el,
        "area"@en,
        "área"@es,
