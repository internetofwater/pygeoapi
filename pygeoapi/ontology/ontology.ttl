    unit:TeraW-HR, unit:TonEnergy, unit:V-A-HR, unit:V-A_Reactive-HR, unit:W-HR, unit:W-SEC .

<http://qudt.org/vocab/quantitykind/MechanicalImpedance> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Mechanical Impedance"@en;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L0I0M1H0T-1D0>;
  <http://qudt.org/schema/qudt/iec61360Code> "0112/2///62720#UAD115";
  <http://qudt.org/schema/qudt/informativeReference> "https://cdd.iec.ch/cdd/iec61987/iec61987.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD115"^^xsd:anyURI .

<http://qudt.org/vocab/quantitykind/MechanicalSurfaceImpedance> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Mechanical surface impedance"@en;
  rdfs:comment "There are various interpretations of MechanicalSurfaceImpedance: Pressure/Velocity - https://apps.dtic.mil/sti/pdfs/ADA315595.pdf, Force / Speed - https://www.wikidata.org/wiki/Q6421317, and (Pressure / Velocity)**0.5 - https://www.sciencedirect.com/topics/engineering/mechanical-impedance. We are seeking a resolution to these differences.";
  dct:description "Mechanical surface impedance at a surface, is the complex quotient of the total force on the surface by the component of the average sound particle velocity at the surface in the direction of the force"^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L-2I0M1H0T-1D0>;
  <http://qudt.org/schema/qudt/symbol> "Z";
  <http://qudt.org/schema/qudt/plainTextDescription> "Mechanical surface impedance at a surface, is the complex quotient of the total force on the surface by the component of the average sound particle velocity at the surface in the direction of the force";
  <http://qudt.org/schema/qudt/latexDefinition> "$Z_m = Z_a A^2$, where $A$ is the area of the surface considered and $Z_a$ is the acoustic impedance."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://www.linkedmodel.org/schema/vaem#todo> "belongs to SOQ-ISO" .

<http://qudt.org/vocab/quantitykind/MechanicalTension> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "mechanical tension"@en-US;
  rdfs:comment "Applicable units are those of quantitykind:ForcePerArea";
  dct:description "at a point of a body upon which a force acts which attempts to change the shape of the body, the limit value of the ratio between the force and area of a flat surface around this point when the dimensions approach zero"@en;
  skos:broader <http://qudt.org/vocab/quantitykind/ForcePerArea>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L-1I0M1H0T-2D0>;
  <http://qudt.org/schema/qudt/symbol> "0173-1#Z4-BAJ204#005";
  <http://qudt.org/schema/qudt/plainTextDescription> "an einem Punkt eines Körpers, an dem eine Kraft angreift, welche die Form des Körpers zu verändern sucht, der Grenzwert des Quotienten Kraft durch Fläche einer ebenen Oberfläche um diesen Punkt, wenn deren Abmessungen gegen null gehen"@de;
  <http://qudt.org/schema/qudt/applicableUnit> unit:ATM, unit:ATM_T, unit:BAR, unit:BARAD,
