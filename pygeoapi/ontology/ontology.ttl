unit:MilliM-PER-DAY a <http://qudt.org/schema/qudt/Unit>, <http://qudt.org/schema/qudt/DerivedUnit>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/unit>;
  rdfs:label "millimeters per day"@en-US, "millimetres per day"@en;
  dct:description "A measure of change in depth over time for a specific area, typically used to express precipitation intensity or evaporation (the amount of liquid water evaporated per unit of time from the area)"^^rdf:HTML;
  <http://qudt.org/schema/qudt/applicableSystem> <http://qudt.org/vocab/sou/CGS-EMU>,
    <http://qudt.org/vocab/sou/CGS-GAUSS>, <http://qudt.org/vocab/sou/SI>, <http://qudt.org/vocab/sou/CGS>;
  <http://qudt.org/schema/qudt/conversionMultiplier> 0.0000000115741;
  <http://qudt.org/schema/qudt/conversionMultiplierSN> 1.15741E-8;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L1I0M0H0T-1D0>;
  <http://qudt.org/schema/qudt/hasQuantityKind> <http://qudt.org/vocab/quantitykind/LinearVelocity>,
    <http://qudt.org/vocab/quantitykind/Velocity>;
  <http://qudt.org/schema/qudt/informativeReference> "https://en.wikipedia.org/wiki/Rain#Measurement"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/symbol> "mm/d";
  <http://qudt.org/schema/qudt/ucumCode> "mm.d-1"^^<http://qudt.org/schema/qudt/UCUMcs>,
    "mm/d"^^<http://qudt.org/schema/qudt/UCUMcs>;
  <http://qudt.org/schema/qudt/plainTextDescription> "A measure of change in depth over time for a specific area, typically used to express precipitation intensity or evaporation (the amount of liquid water evaporated per unit of time from the area)" .

