  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L-1I0M1H0T-3D0>;
  <http://qudt.org/schema/qudt/hasQuantityKind> <http://qudt.org/vocab/quantitykind/ForcePerAreaTime>;
  <http://qudt.org/schema/qudt/symbol> "dbar/a";
  <http://qudt.org/schema/qudt/ucumCode> "dbar.a-1"^^<http://qudt.org/schema/qudt/UCUMcs>,
    "dbar/a"^^<http://qudt.org/schema/qudt/UCUMcs> .

<http://qudt.org/vocab/dimensionvector/A0E0L-1I0M1H0T-3D0> a <http://qudt.org/schema/qudt/QuantityKindDimensionVector_SI>,
    <http://qudt.org/schema/qudt/QuantityKindDimensionVector_ISO>, <http://qudt.org/schema/qudt/QuantityKindDimensionVector_Imperial>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/dimensionvector>;
  rdfs:label "A0E0L-1I0M1H0T-3D0";
  <http://qudt.org/schema/qudt/latexDefinition> "$L^-1 M T^-3$"^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/hasReferenceQuantityKind> <http://qudt.org/vocab/quantitykind/ForcePerAreaTime>;
  <http://qudt.org/schema/qudt/dimensionExponentForAmountOfSubstance> 0;
  <http://qudt.org/schema/qudt/dimensionExponentForElectricCurrent> 0;
  <http://qudt.org/schema/qudt/dimensionExponentForLength> -1;
  <http://qudt.org/schema/qudt/dimensionExponentForLuminousIntensity> 0;
  <http://qudt.org/schema/qudt/dimensionExponentForMass> 1;
  <http://qudt.org/schema/qudt/dimensionExponentForThermodynamicTemperature> 0;
  <http://qudt.org/schema/qudt/dimensionExponentForTime> -3;
  <http://qudt.org/schema/qudt/dimensionlessExponent> 0 .

