quantitykind:HeatCapacity a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "Wärmekapazität"@de, "Wärmekapazität"@de, "capacidad calorífica"@es, "capacidad calorífica"@es,
    "capacidade térmica"@pt, "capacidade térmica"@pt, "capacitate termică"@ro, "capacitate termică"@ro,
    "capacità termica"@it, "capacità termica"@it, "capacité thermique"@fr, "capacité thermique"@fr,
    "heat capacity"@en, "heat capacity"@en, "isı kapasitesi"@tr, "isı kapasitesi"@tr,
    "muatan haba"@ms, "muatan haba"@ms, "pojemność cieplna"@pl, "pojemność cieplna"@pl,
    "tepelná kapacita"@cs, "tepelná kapacita"@cs, "toplotna kapaciteta"@sl, "toplotna kapaciteta"@sl,
    "теплоёмкость"@ru, "теплоёмкость"@ru, "سعة حرارية"@ar, "سعة حرارية"@ar, "ظرفیت گرمایی"@fa,
    "ظرفیت گرمایی"@fa, "ऊष्मा धारिता"@hi, "ऊष्मा धारिता"@hi, "热容"@zh, "热容"@zh, "熱容量"@ja,
    "熱容量"@ja;
  rdfs:comment "Applicable units are those of quantitykind:HeatCapacity", "Applicable units are those of quantitykind:HeatCapacity";
  dct:description "\"Heat Capacity\" (usually denoted by a capital $C$, often with subscripts), or thermal capacity, is the measurable physical quantity that characterizes the amount of heat required to change a substance's temperature by a given amount. In the International System of Units (SI), heat capacity is expressed in units of joule(s) (J) per kelvin (K)."^^qudt:LatexString,
    "\"Heat Capacity\" (usually denoted by a capital $C$, often with subscripts), or thermal capacity, is the measurable physical quantity that characterizes the amount of heat required to change a substance's temperature by a given amount. In the International System of Units (SI), heat capacity is expressed in units of joule(s) (J) per kelvin (K)."^^qudt:LatexString;
  skos:broader quantitykind:EnergyPerTemperature, quantitykind:EnergyPerTemperature;
  qudt:hasDimensionVector dimensionvector:A0E0L2I0M1H-1T-2D0, dimensionvector:A0E0L2I0M1H-1T-2D0;
  qudt:informativeReference "http://en.wikipedia.org/wiki/Heat_capacity"^^xsd:anyURI,
    "http://en.wikipedia.org/wiki/Heat_capacity"^^xsd:anyURI;
  qudt:siExactMatch <https://si-digital-framework.org/SI/quantities/HECA>, <https://si-digital-framework.org/quantities/HECA>;
  qudt:symbol "C_P", "C_P";
  qudt:latexDefinition "$C = dQ/dT$, where $Q$ is amount of heat and $T$ is thermodynamic temperature."^^qudt:LatexString,
    "$C = dQ/dT$, where $Q$ is amount of heat and $T$ is thermodynamic temperature."^^qudt:LatexString;
