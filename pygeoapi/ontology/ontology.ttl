unit:BILLION_Long a qudt:Unit, qudt:CountingUnit;
  rdfs:isDefinedBy <http://qudt.org/vocab/unit>;
  rdfs:label "Billion (Long Scale)";
  dct:description "Counting unit for a count of one billion according to the long scale, defined as one million million on the long scale";
  qudt:applicableSystem <http://qudt.org/vocab/sou/CGS-EMU>, <http://qudt.org/vocab/sou/CGS-GAUSS>,
    <http://qudt.org/vocab/sou/PLANCK>, <http://qudt.org/vocab/sou/SI>, <http://qudt.org/vocab/sou/CGS>,
    <http://qudt.org/vocab/sou/IMPERIAL>, <http://qudt.org/vocab/sou/CGS-ESU>, <http://qudt.org/vocab/sou/ASU>;
  qudt:conversionMultiplier 1000000000000.0;
  qudt:conversionMultiplierSN 1.0E12;
  qudt:hasDimensionVector dimensionvector:A0E0L0I0M0H0T0D1;
  qudt:hasQuantityKind quantitykind:Count;
  qudt:informativeReference "https://en.wikipedia.org/wiki/Billion"^^xsd:anyURI;
  qudt:symbol "1000000000000" .

unit:BILLION_Short a qudt:Unit, qudt:CountingUnit;
  rdfs:isDefinedBy <http://qudt.org/vocab/unit>;
  rdfs:label "Billion (Short Scale)";
