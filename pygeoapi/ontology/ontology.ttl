  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/dimensionvector>;
  rdfs:label "A0E0L-2I1M0H0T0D0";
  <http://qudt.org/schema/qudt/latexDefinition> "$L^-2 J$"^^<http://qudt.org/schema/qudt/LatexString>;
