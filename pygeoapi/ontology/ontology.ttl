quantitykind:MolarConductivity a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "Molar Conductivity"@en, "Molar Conductivity"@en;
