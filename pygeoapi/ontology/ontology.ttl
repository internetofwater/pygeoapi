unit:V_Stat a qudt:Unit, qudt:Unit;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/unit>, <http://qudt.org/vocab/unit>;
  rdfs:label "Statvolt"@en, "Statvolt"@en;
  dct:description "\"statvolt\" is a unit of voltage and electrical potential used in the cgs system of units. The conversion to the SI system is $1 statvolt = 299.792458 volts$. The conversion factor 299.792458 is simply the numerical value of the speed of light in m/s divided by 106. The statvolt is also defined in the cgs system as $1 erg / esu$. It is a useful unit for electromagnetism because one statvolt per centimetre is equal in magnitude to one gauss. Thus, for example, an electric field of one statvolt/cm has the same energy density as a magnetic field of one gauss. Likewise, a plane wave propagating in a vacuum has perpendicular electric and magnetic fields such that for every gauss of magnetic field intensity there is one statvolt/cm of electric field intensity. The abvolt is another option for a unit of voltage in the cgs system."^^qudt:LatexString,
    "\"statvolt\" is a unit of voltage and electrical potential used in the cgs system of units. The conversion to the SI system is $1 statvolt = 299.792458 volts$. The conversion factor 299.792458 is simply the numerical value of the speed of light in m/s divided by 106. The statvolt is also defined in the cgs system as $1 erg / esu$. It is a useful unit for electromagnetism because one statvolt per centimetre is equal in magnitude to one gauss. Thus, for example, an electric field of one statvolt/cm has the same energy density as a magnetic field of one gauss. Likewise, a plane wave propagating in a vacuum has perpendicular electric and magnetic fields such that for every gauss of magnetic field intensity there is one statvolt/cm of electric field intensity. The abvolt is another option for a unit of voltage in the cgs system."^^qudt:LatexString;
  qudt:applicableSystem <http://qudt.org/vocab/sou/CGS>, <http://qudt.org/vocab/sou/CGS>,
    <http://qudt.org/vocab/sou/CGS-ESU>, <http://qudt.org/vocab/sou/CGS-ESU>;
  qudt:conversionMultiplier 299.792458, 299.792458;
  qudt:conversionMultiplierSN 2.99792458E2, 2.99792458E2;
  qudt:dbpediaMatch "http://dbpedia.org/resource/Statvolt"^^xsd:anyURI, "http://dbpedia.org/resource/Statvolt"^^xsd:anyURI;
  qudt:hasDimensionVector dimensionvector:A0E-1L2I0M1H0T-3D0, dimensionvector:A0E-1L2I0M1H0T-3D0;
  qudt:hasQuantityKind quantitykind:ElectricPotential, quantitykind:ElectricPotential,
    quantitykind:ElectricPotentialDifference, quantitykind:ElectricPotentialDifference,
    quantitykind:EnergyPerElectricCharge, quantitykind:EnergyPerElectricCharge, quantitykind:Voltage,
    quantitykind:Voltage;
  qudt:informativeReference "http://en.wikipedia.org/wiki/Statvolt"^^xsd:anyURI, "http://en.wikipedia.org/wiki/Statvolt"^^xsd:anyURI,
    "http://en.wikipedia.org/wiki/Statvolt?oldid=491769750"^^xsd:anyURI, "http://en.wikipedia.org/wiki/Statvolt?oldid=491769750"^^xsd:anyURI;
  qudt:omUnit <http://www.ontology-of-units-of-measure.org/resource/om-2/statvolt>,
    <http://www.ontology-of-units-of-measure.org/resource/om-2/statvolt>;
  qudt:symbol "statV", "statV";
  qudt:derivedUnitOfSystem <http://qudt.org/vocab/sou/CGS-ESU>, <http://qudt.org/vocab/sou/CGS-ESU>;
  qudt:scalingOf unit:V .

