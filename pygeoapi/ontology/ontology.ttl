quantitykind:LinearElectricCurrentDensity a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:seeAlso quantitykind:ElectricChargeSurfaceDensity, quantitykind:ElectricChargeSurfaceDensity,
    quantitykind:ElectricCurrentDensity, quantitykind:ElectricCurrentDensity;
  rdfs:label "Linear Electric Current Density"@en, "Linear Electric Current Density"@en;
  rdfs:comment "Applicable units are those of quantitykind:LinearElectricCurrentDensity",
    "Applicable units are those of quantitykind:LinearElectricCurrentDensity";
  dct:description "\"Linear Electric Linear Current Density\" is the electric current per unit length. Electric current, $I$, through a curve $C$ is defined as $I = \\int_C J _s \\times e_n$, where $e_n$ is a unit vector perpendicular to the surface and line vector element, and $dr$ is the differential of position vector $r$."^^qudt:LatexString,
    "\"Linear Electric Linear Current Density\" is the electric current per unit length. Electric current, $I$, through a curve $C$ is defined as $I = \\int_C J _s \\times e_n$, where $e_n$ is a unit vector perpendicular to the surface and line vector element, and $dr$ is the differential of position vector $r$."^^qudt:LatexString;
  qudt:hasDimensionVector dimensionvector:A0E1L-1I0M0H0T0D0, dimensionvector:A0E1L-1I0M0H0T0D0;
  qudt:informativeReference "http://www.iso.org/iso/home/store/catalogue_tc/catalogue_detail.htm?csnumber=31891"^^xsd:anyURI,
    "http://www.iso.org/iso/home/store/catalogue_tc/catalogue_detail.htm?csnumber=31891"^^xsd:anyURI,
    "http://www.asknumbers.com/ElectricalConversion.aspx"^^xsd:anyURI, "http://www.asknumbers.com/ElectricalConversion.aspx"^^xsd:anyURI;
  qudt:symbol "J_s", "J_s";
  qudt:latexDefinition "$J_s = \\rho_A v$, where $\\rho_A$ is surface density of electric charge and $v$ is velocity."^^qudt:LatexString,
    "$J_s = \\rho_A v$, where $\\rho_A$ is surface density of electric charge and $v$ is velocity."^^qudt:LatexString;
  qudt:applicableUnit unit:A-PER-CentiM, unit:A-PER-CentiM, unit:A-PER-M, unit:A-PER-M,
    unit:A-PER-MilliM, unit:A-PER-MilliM, unit:KiloA-PER-M, unit:KiloA-PER-M, unit:MilliA-PER-IN,
    unit:MilliA-PER-IN, unit:MilliA-PER-MilliM, unit:MilliA-PER-MilliM .

