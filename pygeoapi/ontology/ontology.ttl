quantitykind:SeebeckCoefficient a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "Seebeck Coefficient"@en, "Seebeck Coefficient"@en;
  rdfs:comment "Applicable units are those of quantitykind:SeebeckCoefficient", "Applicable units are those of quantitykind:SeebeckCoefficient";
  dct:description "\"Seebeck Coefficient\", or thermopower, or thermoelectric power of a material is a measure of the magnitude of an induced thermoelectric voltage in response to a temperature difference across that material."^^qudt:LatexString,
    "\"Seebeck Coefficient\", or thermopower, or thermoelectric power of a material is a measure of the magnitude of an induced thermoelectric voltage in response to a temperature difference across that material."^^qudt:LatexString;
  qudt:hasDimensionVector dimensionvector:A0E-1L2I0M1H-1T-3D0, dimensionvector:A0E-1L2I0M1H-1T-3D0;
  qudt:iec61360Code "0112/2///62720#UAD169", "0112/2///62720#UAD169";
  qudt:informativeReference "http://en.wikipedia.org/wiki/Thermopower"^^xsd:anyURI,
    "http://en.wikipedia.org/wiki/Thermopower"^^xsd:anyURI, "https://cdd.iec.ch/cdd/iec61987/iec61987.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD169"^^xsd:anyURI,
    "https://cdd.iec.ch/cdd/iec61987/iec61987.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD169"^^xsd:anyURI;
  qudt:symbol "S_{ab}", "S_{ab}";
  qudt:isoNormativeReference "http://www.iso.org/iso/catalogue_detail?csnumber=31897"^^xsd:anyURI,
    "http://www.iso.org/iso/catalogue_detail?csnumber=31897"^^xsd:anyURI;
  qudt:plainTextDescription "\"Seebeck Coefficient\", or thermopower, or thermoelectric power of a material is a measure of the magnitude of an induced thermoelectric voltage in response to a temperature difference across that material.",
    "\"Seebeck Coefficient\", or thermopower, or thermoelectric power of a material is a measure of the magnitude of an induced thermoelectric voltage in response to a temperature difference across that material.";
  qudt:latexDefinition "$S_{ab} = \\frac{dE_{ab}}{dT}$, where $E_{ab}$ is the thermosource voltage between substances a and b, $T$ is the thermodynamic temperature of the hot junction."^^qudt:LatexString,
    "$S_{ab} = \\frac{dE_{ab}}{dT}$, where $E_{ab}$ is the thermosource voltage between substances a and b, $T$ is the thermodynamic temperature of the hot junction."^^qudt:LatexString;
