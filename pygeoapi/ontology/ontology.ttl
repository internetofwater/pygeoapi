quantitykind:GaugePressure a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "Gauge Pressure"@en, "Gauge Pressure"@en;
  rdfs:comment "Applicable units are those of quantitykind:ForcePerArea", "Applicable units are those of quantitykind:ForcePerArea";
  dct:description """Gauge Pressure is the pressure of a system relative to the pressure of the surrounding atmosphere. 
It is the difference between the absolute pressure and the atmospheric pressure. Gauge pressure is positive for pressures 
above atmospheric pressure and negative for pressures below it. A Quantity in QUDT having a QuantityKind of GaugePressure
would typically also assert the value of qudt:isDeltaQuantity to be true, indicating that the value is a difference between
two pressures."""^^qudt:LatexString,
    """Gauge Pressure is the pressure of a system relative to the pressure of the surrounding atmosphere. 
It is the difference between the absolute pressure and the atmospheric pressure. Gauge pressure is positive for pressures 
above atmospheric pressure and negative for pressures below it. A Quantity in QUDT having a QuantityKind of GaugePressure
would typically also assert the value of qudt:isDeltaQuantity to be true, indicating that the value is a difference between
two pressures."""^^qudt:LatexString;
  skos:broader quantitykind:Pressure, quantitykind:Pressure;
  qudt:hasDimensionVector dimensionvector:A0E0L-1I0M1H0T-2D0, dimensionvector:A0E0L-1I0M1H0T-2D0;
