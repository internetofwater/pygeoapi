quantitykind:ThermodynamicTemperature a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:seeAlso quantitykind:Temperature, quantitykind:Temperature;
  rdfs:label "temperatura"@pl, "temperatura"@pl, "temperatura"@sl, "temperatura"@sl,
