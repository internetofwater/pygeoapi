    <http://qudt.org/vocab/sou/CGS-GAUSS>, <http://qudt.org/vocab/sou/SI>, <http://qudt.org/vocab/sou/CGS>;
  <http://qudt.org/schema/qudt/conversionMultiplier> 1000000.0;
  <http://qudt.org/schema/qudt/conversionMultiplierSN> 1.0E6;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L2I0M0H0T-2D0>;
  <http://qudt.org/schema/qudt/hasQuantityKind> <http://qudt.org/vocab/quantitykind/SpecificModulus>;
  <http://qudt.org/schema/qudt/symbol> "GPa·cm³/g";
  <http://qudt.org/schema/qudt/ucumCode> "GPa.cm3.g-1"^^<http://qudt.org/schema/qudt/UCUMcs>,
    "GPa.cm3/g"^^<http://qudt.org/schema/qudt/UCUMcs>;
