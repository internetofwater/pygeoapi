<http://qudt.org/vocab/quantitykind/MolarMass> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Jisim molar"@ms, "Masa molowa"@pl, "Masă molară"@ro, "Molmasse"@de, "Molární hmotnost"@cs,
    "masa molar"@es, "massa molar"@pt, "massa molare"@it, "masse molaire"@fr, "molar kütle"@tr,
    "molar mass"@en, "molska masa"@sl, "Молярная масса"@ru, "جرم مولی"@fa, "كتلة مولية"@ar,
    "मोलर द्रव्यमान"@hi, "モル質量"@ja, "摩尔质量"@zh;
  rdfs:comment "Applicable units are those of quantitykind:MolarMass";
  dct:description "In chemistry, the molar mass M is defined as the mass of a given substance (chemical element or chemical compound) divided by its amount of substance. It is a physical property of a given substance. The base SI unit for molar mass is $kg/mol$."^^<http://qudt.org/schema/qudt/LatexString>;
  skos:altLabel "molare Masse"@de, "stoffmengenbezogene Masse"@de;
  <http://qudt.org/schema/qudt/dbpediaMatch> "http://dbpedia.org/resource/Molar_mass"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A-1E0L0I0M1H0T0D0>;
  <http://qudt.org/schema/qudt/iec61360Code> "0112/2///62720#UAD125";
  <http://qudt.org/schema/qudt/informativeReference> "http://en.wikipedia.org/wiki/Molar_mass"^^xsd:anyURI,
    "https://cdd.iec.ch/cdd/iec61987/iec61987.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD125"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/symbol> "M";
  <http://qudt.org/schema/qudt/isoNormativeReference> "http://www.iso.org/iso/catalogue_detail?csnumber=31894"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/applicableUnit> unit:GM-PER-MOL, unit:KiloGM-PER-KiloMOL,
    unit:KiloGM-PER-MOL .

