qudt:latexSymbol a owl:DatatypeProperty, owl:DatatypeProperty;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/schema/qudt>, <http://qudt.org/schema/qudt>;
  rdfs:label "latex symbol", "latex symbol";
  rdfs:range qudt:LatexString, qudt:LatexString;
  dct:description """
  The symbol is a glyph that is used to represent some concept, typically a unit or a quantity, in a compact form. 
  For example, the symbol for an Ohm is $ohm$. 
  This contrasts with 'unit:abbreviation', which gives a short alphanumeric abbreviation for the unit, 'ohm' for Ohm.
  """^^qudt:LatexString,
    """
  The symbol is a glyph that is used to represent some concept, typically a unit or a quantity, in a compact form. 
  For example, the symbol for an Ohm is $ohm$. 
  This contrasts with 'unit:abbreviation', which gives a short alphanumeric abbreviation for the unit, 'ohm' for Ohm.
  """^^qudt:LatexString .

unit:ANGSTROM3 a qudt:Unit, qudt:Unit;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/unit>, <http://qudt.org/vocab/unit>;
  rdfs:label "Cubic Angstrom"@en, "Cubic Angstrom"@en, "Cubic Angstrom"@en-US, "Cubic Angstrom"@en-US;
  dct:description "A unit that is a non-SI unit, specifically a CGS unit,  of polarizability known informally as polarizability volume.  The SI defined units for polarizability are C*m^2/V and can be converted to $Angstr\\ddot{o}m$^3 by multiplying the SI value by 4 times pi times the vacuum permittivity and then converting the resulting m^3 to $Angstr\\ddot{o}m$^3 through the SI base 10 conversion (multiplying by 10^-30)."^^qudt:LatexString,
    "A unit that is a non-SI unit, specifically a CGS unit,  of polarizability known informally as polarizability volume.  The SI defined units for polarizability are C*m^2/V and can be converted to $Angstr\\ddot{o}m$^3 by multiplying the SI value by 4 times pi times the vacuum permittivity and then converting the resulting m^3 to $Angstr\\ddot{o}m$^3 through the SI base 10 conversion (multiplying by 10^-30)."^^qudt:LatexString;
  qudt:applicableSystem <http://qudt.org/vocab/sou/CGS-GAUSS>, <http://qudt.org/vocab/sou/CGS-GAUSS>;
  qudt:conversionMultiplier 0.000000000000000000000000000001, 0.000000000000000000000000000001;
  qudt:conversionMultiplierSN 1.0E-30, 1.0E-30;
  qudt:hasDimensionVector dimensionvector:A0E0L3I0M0H0T0D0, dimensionvector:A0E0L3I0M0H0T0D0;
  qudt:hasQuantityKind quantitykind:Volume, quantitykind:Volume;
  qudt:symbol "Å³", "Å³";
  qudt:ucumCode "Ao3"^^qudt:UCUMcs, "Ao3"^^qudt:UCUMcs;
  qudt:hasFactorUnit _:b1cb43fcbd504833bf8a964862c3127014601 .

unit:ARCMIN a qudt:Unit, qudt:Unit, qudt:DerivedUnit, qudt:DerivedUnit;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/unit>, <http://qudt.org/vocab/unit>;
  rdfs:label "ArcMinute"@en, "ArcMinute"@en;
  dct:description "A minute of arc, arcminute, or minute arc (MOA), is a unit of angular measurement equal to one sixtieth (1/60) of one degree (circle/21,600), or $\\pi /10,800 radians$. In turn, a second of arc or arcsecond is one sixtieth (1/60) of one minute of arc. Since one degree is defined as one three hundred and sixtieth (1/360) of a rotation, one minute of arc is 1/21,600 of a rotation. "^^qudt:LatexString,
    "A minute of arc, arcminute, or minute arc (MOA), is a unit of angular measurement equal to one sixtieth (1/60) of one degree (circle/21,600), or $\\pi /10,800 radians$. In turn, a second of arc or arcsecond is one sixtieth (1/60) of one minute of arc. Since one degree is defined as one three hundred and sixtieth (1/360) of a rotation, one minute of arc is 1/21,600 of a rotation. "^^qudt:LatexString;
  qudt:applicableSystem <http://qudt.org/vocab/sou/USCS>, <http://qudt.org/vocab/sou/USCS>;
  qudt:conversionMultiplier 0.000290888209, 0.000290888209;
  qudt:conversionMultiplierSN 2.90888209E-4, 2.90888209E-4;
  qudt:hasDimensionVector dimensionvector:A0E0L0I0M0H0T0D1, dimensionvector:A0E0L0I0M0H0T0D1;
  qudt:hasQuantityKind quantitykind:Angle, quantitykind:Angle, quantitykind:PlaneAngle,
