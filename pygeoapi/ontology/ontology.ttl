quantitykind:PlaneAngle a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "Rovinný úhel"@cs, "Rovinný úhel"@cs, "Sudut satah"@ms, "Sudut satah"@ms,
    "angle plan"@fr, "angle plan"@fr, "angolo piano"@it, "angolo piano"@it, "angulus planus"@la,
    "angulus planus"@la, "düzlemsel açı"@tr, "düzlemsel açı"@tr, "ebener Winkel"@de, "ebener Winkel"@de,
    "kąt płaski"@pl, "kąt płaski"@pl, "medida angular"@pt, "medida angular"@pt, "plane angle"@en,
    "plane angle"@en, "ravninski kot"@sl, "ravninski kot"@sl, "szög"@hu, "szög"@hu, "unghi plan"@ro,
    "unghi plan"@ro, "ángulo plano"@es, "ángulo plano"@es, "Επίπεδη γωνία"@el, "Επίπεδη γωνία"@el,
    "Плоский угол"@ru, "Плоский угол"@ru, "Равнинен ъгъл"@bg, "Равнинен ъгъл"@bg, "זווית"@he,
    "זווית"@he, "الزاوية النصف قطرية"@ar, "الزاوية النصف قطرية"@ar, "زاویه مستوی"@fa,
    "زاویه مستوی"@fa, "क्षेत्र"@hi, "क्षेत्र"@hi, "弧度"@ja, "弧度"@ja, "角度"@zh, "角度"@zh;
  rdfs:comment "Applicable units are those of quantitykind:PlaneAngle", "Applicable units are those of quantitykind:PlaneAngle";
  dct:description "The inclination to each other of two intersecting lines, measured by the arc of a circle intercepted between the two lines forming the angle, the center of the circle being the point of intersection.  An acute angle is less than $90^\\circ$, a right angle $90^\\circ$; an obtuse angle, more than $90^\\circ$ but less than $180^\\circ$; a straight angle, $180^\\circ$; a reflex angle, more than $180^\\circ$ but less than $360^\\circ$; a perigon, $360^\\circ$. Any angle not a multiple of $90^\\circ$ is an oblique angle. If the sum of two angles is $90^\\circ$, they are complementary angles; if $180^\\circ$, supplementary angles; if $360^\\circ$, explementary angles."^^qudt:LatexString,
    "The inclination to each other of two intersecting lines, measured by the arc of a circle intercepted between the two lines forming the angle, the center of the circle being the point of intersection.  An acute angle is less than $90^\\circ$, a right angle $90^\\circ$; an obtuse angle, more than $90^\\circ$ but less than $180^\\circ$; a straight angle, $180^\\circ$; a reflex angle, more than $180^\\circ$ but less than $360^\\circ$; a perigon, $360^\\circ$. Any angle not a multiple of $90^\\circ$ is an oblique angle. If the sum of two angles is $90^\\circ$, they are complementary angles; if $180^\\circ$, supplementary angles; if $360^\\circ$, explementary angles."^^qudt:LatexString;
  qudt:dbpediaMatch "http://dbpedia.org/resource/Plane_angle"^^xsd:anyURI, "http://dbpedia.org/resource/Plane_angle"^^xsd:anyURI;
  qudt:hasDimensionVector dimensionvector:A0E0L0I0M0H0T0D1, dimensionvector:A0E0L0I0M0H0T0D1;
  qudt:iec61360Code "0112/2///62720#UAD140", "0112/2///62720#UAD140";
  qudt:informativeReference "http://www.thefreedictionary.com/plane+angle"^^xsd:anyURI,
    "http://www.thefreedictionary.com/plane+angle"^^xsd:anyURI, "https://cdd.iec.ch/cdd/iec61987/iec61987.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD140"^^xsd:anyURI,
    "https://cdd.iec.ch/cdd/iec61987/iec61987.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD140"^^xsd:anyURI;
  qudt:siExactMatch <https://si-digital-framework.org/SI/quantities/ANGP>, <https://si-digital-framework.org/quantities/ANGP>;
  qudt:plainTextDescription "An angle formed by two straight lines (in the same plane) angle - the space between two lines or planes that intersect; the inclination of one line to another; measured in degrees or radians",
    "An angle formed by two straight lines (in the same plane) angle - the space between two lines or planes that intersect; the inclination of one line to another; measured in degrees or radians";
  qudt:exactMatch quantitykind:Angle, quantitykind:Angle;
