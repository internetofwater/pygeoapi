quantitykind:CyclotronAngularFrequency a qudt:QuantityKind ;
    rdfs:label "Larmor Angular Frequency"@en ;
    dct:description "The \"Cyclotron Angular Frequency\" describes angular momentum vector precession about the external field axis with an angular frequency."^^qudt:LatexString ;
    qudt:applicableUnit unit:DEG-PER-HR,
        unit:DEG-PER-MIN,
        unit:DEG-PER-SEC,
        unit:PlanckFrequency_Ang,
        unit:RAD-PER-HR,
        unit:RAD-PER-MIN,
        unit:RAD-PER-SEC ;
