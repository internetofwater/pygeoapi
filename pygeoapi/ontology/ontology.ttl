quantitykind:ElectricField a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "Electric Field"@en, "Electric Field"@en;
  rdfs:comment "Applicable units are those of quantitykind:ElectricField", "Applicable units are those of quantitykind:ElectricField";
  dct:description "The space surrounding an electric charge or in the presence of a time-varying magnetic field has a property called an electric field. This electric field exerts a force on other electrically charged objects. In the idealized case, the force exerted between two point charges is inversely proportional to the square of the distance between them. (Coulomb's Law)."^^qudt:LatexString,
    "The space surrounding an electric charge or in the presence of a time-varying magnetic field has a property called an electric field. This electric field exerts a force on other electrically charged objects. In the idealized case, the force exerted between two point charges is inversely proportional to the square of the distance between them. (Coulomb's Law)."^^qudt:LatexString;
  qudt:dbpediaMatch "http://dbpedia.org/resource/Electric_field"^^xsd:anyURI, "http://dbpedia.org/resource/Electric_field"^^xsd:anyURI;
  qudt:hasDimensionVector dimensionvector:A0E-1L1I0M1H0T-3D0, dimensionvector:A0E-1L1I0M1H0T-3D0;
  qudt:informativeReference "http://en.wikipedia.org/wiki/Electric_field"^^xsd:anyURI,
    "http://en.wikipedia.org/wiki/Electric_field"^^xsd:anyURI;
  qudt:expression "$E$"^^qudt:LatexString, "$E$"^^qudt:LatexString;
  qudt:plainTextDescription "The space surrounding an electric charge or in the presence of a time-varying magnetic field has a property called an electric field. This electric field exerts a force on other electrically charged objects. In the idealized case, the force exerted between two point charges is inversely proportional to the square of the distance between them. (Coulomb's Law).",
    "The space surrounding an electric charge or in the presence of a time-varying magnetic field has a property called an electric field. This electric field exerts a force on other electrically charged objects. In the idealized case, the force exerted between two point charges is inversely proportional to the square of the distance between them. (Coulomb's Law).";
  qudt:applicableUnit unit:V-PER-M, unit:V-PER-M, unit:V_Ab-PER-CentiM, unit:V_Ab-PER-CentiM,
    unit:V_Stat-PER-CentiM, unit:V_Stat-PER-CentiM .

unit:V-PER-M2 a qudt:Unit, qudt:Unit;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/unit>, <http://qudt.org/vocab/unit>;
  rdfs:label "Volt per Square Meter"@en-US, "Volt per Square Meter"@en-US, "Volt per Square Metre"@en,
    "Volt per Square Metre"@en;
  dct:description """
  $\\textit{Volt per Square Metre}$ is the divergence at a particular point in a vector field is (roughly) how much the vector field 'spreads out' from that point. 
  Operationally, we take the partial derivative of each of the field with respect to each of its space variables and add all the derivatives together to get the divergence. 
  $\\textit{Electric field}$ ($V/m$) differentiated with respect to distance ($m$) yields $V/(m^2)$.
  """^^qudt:LatexString,
    """
  $\\textit{Volt per Square Metre}$ is the divergence at a particular point in a vector field is (roughly) how much the vector field 'spreads out' from that point. 
  Operationally, we take the partial derivative of each of the field with respect to each of its space variables and add all the derivatives together to get the divergence. 
  $\\textit{Electric field}$ ($V/m$) differentiated with respect to distance ($m$) yields $V/(m^2)$.
  """^^qudt:LatexString;
  qudt:applicableSystem <http://qudt.org/vocab/sou/CGS-EMU>, <http://qudt.org/vocab/sou/CGS-EMU>,
    <http://qudt.org/vocab/sou/CGS-GAUSS>, <http://qudt.org/vocab/sou/CGS-GAUSS>, <http://qudt.org/vocab/sou/SI>,
    <http://qudt.org/vocab/sou/SI>;
  qudt:conversionMultiplier 1.0, 1.0;
  qudt:conversionMultiplierSN 1.0E0, 1.0E0;
  qudt:hasDimensionVector dimensionvector:A0E-1L0I0M1H0T-3D0, dimensionvector:A0E-1L0I0M1H0T-3D0;
  qudt:hasQuantityKind quantitykind:EnergyPerAreaElectricCharge, quantitykind:EnergyPerAreaElectricCharge;
  qudt:symbol "V/m²", "V/m²";
  qudt:ucumCode "V.m-2"^^qudt:UCUMcs, "V.m-2"^^qudt:UCUMcs;
  qudt:expression "$V m^{-2}$"^^qudt:LatexString, "$V m^{-2}$"^^qudt:LatexString;
  qudt:derivedCoherentUnitOfSystem <http://qudt.org/vocab/sou/SI>, <http://qudt.org/vocab/sou/SI>;
  qudt:hasFactorUnit _:b1cb43fcbd504833bf8a964862c3127019125, _:b1cb43fcbd504833bf8a964862c3127019126 .

