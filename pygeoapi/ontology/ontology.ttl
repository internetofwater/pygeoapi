  <http://qudt.org/schema/qudt/symbol> "μF/m";
  <http://qudt.org/schema/qudt/ucumCode> "uF.m-1"^^<http://qudt.org/schema/qudt/UCUMcs>;
  <http://qudt.org/schema/qudt/uneceCommonCode> "B89";
