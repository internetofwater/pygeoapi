  <http://qudt.org/schema/qudt/uneceCommonCode> "M94" .

<http://qudt.org/vocab/quantitykind/Unbalance> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "unbalance", "unbalance"@en-US;
  rdfs:comment "Applicable units are those of quantitykind:Unbalance";
  dct:description "unsteady rotation of a body resulting from an anxious distribution of mass, expressed as the product of radius and related mass"@en;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L1I0M1H0T0D0>;
