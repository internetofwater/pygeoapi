quantitykind:DisplacementCurrentDensity a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:seeAlso quantitykind:ElectricFluxDensity, quantitykind:ElectricFluxDensity;
  rdfs:label "Displacement Current Density"@en, "Displacement Current Density"@en;
  rdfs:comment "Applicable units are those of quantitykind:DisplacementCurrentDensity",
    "Applicable units are those of quantitykind:DisplacementCurrentDensity";
  dct:description """
$\\text{Displacement Current Density}$ is the time rate of change of the $\\textit{Electric Flux Density}$. 
  This is a measure of how quickly the electric field changes if we observe it as a function of time. 
  This is different than if we look at how the electric field changes spatially, that is, over a region of space for a fixed amount of time.
  """^^qudt:LatexString,
    """
$\\text{Displacement Current Density}$ is the time rate of change of the $\\textit{Electric Flux Density}$. 
  This is a measure of how quickly the electric field changes if we observe it as a function of time. 
  This is different than if we look at how the electric field changes spatially, that is, over a region of space for a fixed amount of time.
  """^^qudt:LatexString;
  qudt:dbpediaMatch "http://dbpedia.org/resource/Electric_flux"^^xsd:anyURI, "http://dbpedia.org/resource/Electric_flux"^^xsd:anyURI;
  qudt:hasDimensionVector dimensionvector:A0E1L-2I0M0H0T0D0, dimensionvector:A0E1L-2I0M0H0T0D0;
  qudt:informativeReference "http://www.iso.org/iso/home/store/catalogue_tc/catalogue_detail.htm?csnumber=31891"^^xsd:anyURI,
    "http://www.iso.org/iso/home/store/catalogue_tc/catalogue_detail.htm?csnumber=31891"^^xsd:anyURI,
    "http://www.maxwells-equations.com/math/partial-electric-flux.php"^^xsd:anyURI, "http://www.maxwells-equations.com/math/partial-electric-flux.php"^^xsd:anyURI;
  qudt:latexSymbol "$J_D$"^^qudt:LatexString, "$J_D$"^^qudt:LatexString;
  qudt:latexDefinition "$J_D = \\frac{\\partial D}{\\partial t}$, where $D$ is electric flux density and $t$ is time."^^qudt:LatexString,
    "$J_D = \\frac{\\partial D}{\\partial t}$, where $D$ is electric flux density and $t$ is time."^^qudt:LatexString;
  qudt:applicableUnit unit:A-PER-M2, unit:A-PER-M2 .

quantitykind:TotalCurrentDensity a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:seeAlso quantitykind:ElectricCurrentDensity, quantitykind:ElectricCurrentDensity,
    quantitykind:DisplacementCurrentDensity, quantitykind:DisplacementCurrentDensity;
  rdfs:label "Total Current Density"@en, "Total Current Density"@en;
  rdfs:comment "Applicable units are those of quantitykind:TotalCurrentDensity", "Applicable units are those of quantitykind:TotalCurrentDensity";
  dct:description "\"Total Current Density\" is the sum of the electric current density and the displacement current density."^^qudt:LatexString,
    "\"Total Current Density\" is the sum of the electric current density and the displacement current density."^^qudt:LatexString;
  qudt:hasDimensionVector dimensionvector:A0E1L-2I0M0H0T0D0, dimensionvector:A0E1L-2I0M0H0T0D0;
  qudt:informativeReference "http://www.iso.org/iso/home/store/catalogue_tc/catalogue_detail.htm?csnumber=31891"^^xsd:anyURI,
    "http://www.iso.org/iso/home/store/catalogue_tc/catalogue_detail.htm?csnumber=31891"^^xsd:anyURI;
  qudt:plainTextDescription "\"Total Current Density\" is the sum of the electric current density and the displacement current density.",
    "\"Total Current Density\" is the sum of the electric current density and the displacement current density.";
  qudt:latexSymbol "$J_{tot}$"^^qudt:LatexString, "$J_{tot}$"^^qudt:LatexString;
  qudt:latexDefinition "$J_{tot}= J + J_D$, where $J$ is electric current density and $J_D$ is displacement current density."^^qudt:LatexString,
    "$J_{tot}= J + J_D$, where $J$ is electric current density and $J_D$ is displacement current density."^^qudt:LatexString;
  qudt:applicableUnit unit:A-PER-M2, unit:A-PER-M2 .

