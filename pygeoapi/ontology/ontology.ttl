<http://qudt.org/vocab/quantitykind/IsothermalCompressibility> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Izotermna stisljivost"@sl, "Ketermampatan isotermik"@ms, "compresibilidad isotérmica"@es,
    "compressibilidade isotérmica"@pt, "compressibilité isotherme"@fr, "comprimibilità isotermica"@it,
    "isothermal compressibility"@en, "isotherme Kompressibilität"@de, "objemová stlačitelnost"@cs,
    "ściśliwość izotermiczna"@pl, "изотермический коэффициент сжимаемости"@ru, "ضریب تراکم‌پذیری همدما"@fa,
    "معامل الانضغاط عند ثبوت درجة الحرارة"@ar, "等温压缩率"@zh, "等温圧縮率"@ja;
  rdfs:comment "Applicable units are those of quantitykind:IsothermalCompressibility";
  dct:description "The isothermal compressibility defines the rate of change of system volume with pressure."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L1I0M-1H0T2D0>;
  <http://qudt.org/schema/qudt/informativeReference> "http://en.wikipedia.org/wiki/Compressibility"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/plainTextDescription> "The isothermal compressibility defines the rate of change of system volume with pressure.";
  <http://qudt.org/schema/qudt/exactMatch> <http://qudt.org/vocab/quantitykind/InversePressure>;
  <http://qudt.org/schema/qudt/latexSymbol> "$\\varkappa_T$"^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/latexDefinition> "$\\varkappa_T = \\frac{1}{V}\\left (\\frac{\\partial V}{\\partial p} \\right )_T$, where $V$ is volume, $p$ is $pressure$, and $T$ is thermodynamic temperature."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/applicableUnit> unit:PER-BAR, unit:PER-MILLE-PSI, unit:PER-MegaPA,
    unit:PER-PA, unit:PER-PSI .

