unit:MicroSV a qudt:Unit, qudt:Unit, qudt:DerivedUnit, qudt:DerivedUnit;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/unit>, <http://qudt.org/vocab/unit>;
  rdfs:label "MicroSievert"@en, "MicroSievert"@en;
  dct:description "Although the sievert has the same dimensions as the gray (i.e. joules per kilogram), it measures a different quantity. To avoid any risk of confusion between the absorbed dose and the equivalent dose, the corresponding special units, namely the gray instead of the joule per kilogram for absorbed dose and the sievert instead of the joule per kilogram for the dose equivalent, should be used. 0.000001-fold of the SI derived unit sievert."^^rdf:HTML,
    "Although the sievert has the same dimensions as the gray (i.e. joules per kilogram), it measures a different quantity. To avoid any risk of confusion between the absorbed dose and the equivalent dose, the corresponding special units, namely the gray instead of the joule per kilogram for absorbed dose and the sievert instead of the joule per kilogram for the dose equivalent, should be used. 0.000001-fold of the SI derived unit sievert."^^rdf:HTML;
  qudt:applicableSystem <http://qudt.org/vocab/sou/CGS-EMU>, <http://qudt.org/vocab/sou/CGS-EMU>,
    <http://qudt.org/vocab/sou/CGS-GAUSS>, <http://qudt.org/vocab/sou/CGS-GAUSS>, <http://qudt.org/vocab/sou/SI>,
    <http://qudt.org/vocab/sou/SI>, <http://qudt.org/vocab/sou/CGS>, <http://qudt.org/vocab/sou/CGS>;
  qudt:conversionMultiplier 0.000001, 0.000001;
  qudt:conversionMultiplierSN 1.0E-6, 1.0E-6;
  qudt:dbpediaMatch "http://dbpedia.org/resource/Sievert"^^xsd:anyURI, "http://dbpedia.org/resource/Sievert"^^xsd:anyURI;
  qudt:hasDimensionVector dimensionvector:A0E0L2I0M0H0T-2D0, dimensionvector:A0E0L2I0M0H0T-2D0;
  qudt:hasQuantityKind quantitykind:DoseEquivalent, quantitykind:DoseEquivalent;
  qudt:informativeReference "http://en.wikipedia.org/wiki/Sievert?oldid=495474333"^^xsd:anyURI,
