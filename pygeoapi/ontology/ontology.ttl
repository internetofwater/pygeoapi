quantitykind:Activity a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "Activity"@en, "Activity"@en;
  rdfs:comment "Applicable units are those of quantitykind:Activity", "Applicable units are those of quantitykind:Activity";
  dct:description """
  $\\textit{Activity}$ is the number of decays per unit time of a radioactive sample,
   the term used to characterise the number of nuclei which disintegrate in a radioactive substance per unit time. 
  Activity is usually measured in Becquerels ($Bq$), where 1 $Bq$ is 1 disintegration per second,
   in honor of the scientist Henri Becquerel.
  """^^qudt:LatexString,
    """
  $\\textit{Activity}$ is the number of decays per unit time of a radioactive sample,
   the term used to characterise the number of nuclei which disintegrate in a radioactive substance per unit time. 
  Activity is usually measured in Becquerels ($Bq$), where 1 $Bq$ is 1 disintegration per second,
   in honor of the scientist Henri Becquerel.
  """^^qudt:LatexString;
  skos:broader quantitykind:StochasticProcess, quantitykind:StochasticProcess;
  qudt:dbpediaMatch "http://dbpedia.org/resource/Radioactive_decay"^^xsd:anyURI, "http://dbpedia.org/resource/Radioactive_decay"^^xsd:anyURI;
  qudt:hasDimensionVector dimensionvector:A0E0L0I0M0H0T-1D0, dimensionvector:A0E0L0I0M0H0T-1D0;
  qudt:informativeReference "http://en.wikipedia.org/wiki/Mass_number"^^xsd:anyURI,
    "http://en.wikipedia.org/wiki/Mass_number"^^xsd:anyURI, "http://en.wikipedia.org/wiki/Radioactive_decay"^^xsd:anyURI,
    "http://en.wikipedia.org/wiki/Radioactive_decay"^^xsd:anyURI, "http://en.wikipedia.org/wiki/Radioactive_decay#Radioactive_decay_rates"^^xsd:anyURI,
    "http://en.wikipedia.org/wiki/Radioactive_decay#Radioactive_decay_rates"^^xsd:anyURI;
  qudt:siExactMatch <https://si-digital-framework.org/SI/quantities/ARRN>, <https://si-digital-framework.org/quantities/ARRN>;
  qudt:symbol "A", "A";
  qudt:isoNormativeReference "http://www.iso.org/iso/catalogue_detail?csnumber=31895"^^xsd:anyURI,
    "http://www.iso.org/iso/catalogue_detail?csnumber=31895"^^xsd:anyURI;
  qudt:latexDefinition """
  $A = Z + N$, where $Z$ is the atomic number and $N$ is the neutron number.
  Variation $dN$ of spontaneous number of nuclei $N$ in a particular energy state, 
   in a sample of radionuclide, due to spontaneous nuclear transitions from this state during an infinitesimal time interval, 
   divided by its duration $dt$, thus $A = -\\frac{dN}{dt}$.
  """^^qudt:LatexString,
    """
  $A = Z + N$, where $Z$ is the atomic number and $N$ is the neutron number.
  Variation $dN$ of spontaneous number of nuclei $N$ in a particular energy state, 
   in a sample of radionuclide, due to spontaneous nuclear transitions from this state during an infinitesimal time interval, 
   divided by its duration $dt$, thus $A = -\\frac{dN}{dt}$.
  """^^qudt:LatexString;
  qudt:applicableUnit unit:BQ, unit:BQ, unit:CI, unit:CI, unit:GigaBQ, unit:GigaBQ,
    unit:KiloBQ, unit:KiloBQ, unit:KiloCi, unit:KiloCi, unit:MegaBQ, unit:MegaBQ, unit:MicroBQ,
    unit:MicroBQ, unit:MicroCi, unit:MicroCi, unit:MilliBQ, unit:MilliBQ, unit:MilliCi,
    unit:MilliCi, unit:NanoBQ, unit:NanoBQ, unit:PetaBQ, unit:PetaBQ, unit:TeraBQ, unit:TeraBQ .

