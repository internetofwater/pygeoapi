        <http://qudt.org/schema/qudt> ;
    ns2:latestPublishedVersion "https://qudt.org/doc/2025/02/DOC_SCHEMA-QUDT.html"^^xsd:anyURI,
        "https://qudt.org/doc/2025/06/DOC_SCHEMA-QUDT.html"^^xsd:anyURI,
