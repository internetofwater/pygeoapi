unit:DeciB-W a <http://qudt.org/schema/qudt/Unit>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/unit>;
  rdfs:label "decibel watt";
  dct:description "The decibel watt or dBW is a unit for the measurement of the strength of a signal expressed in decibels relative to one watt.";
