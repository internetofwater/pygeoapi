  <http://qudt.org/schema/qudt/iec61360Code> "0112/2///62720#UAA632";
  <http://qudt.org/schema/qudt/informativeReference> "http://en.wikipedia.org/wiki/Kilogram-force?oldid=493375479"^^xsd:anyURI,
    "https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAA632"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/symbol> "kgf";
  <http://qudt.org/schema/qudt/ucumCode> "kgf"^^<http://qudt.org/schema/qudt/UCUMcs>;
  <http://qudt.org/schema/qudt/udunitsCode> "kgf";
  <http://qudt.org/schema/qudt/uneceCommonCode> "B37";
