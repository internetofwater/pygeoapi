<http://qudt.org/vocab/quantitykind/MacroscopicCrossSection> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Macroscopic Cross-section"@en;
  rdfs:comment "Applicable units are those of quantitykind:Area";
  dct:description "\"Macroscopic Cross-section\" is the sum of the cross-sections for a reaction or process of a specified type over all atoms or other entities in a given 3D domain, divided by the volume of that domain."^^<http://qudt.org/schema/qudt/LatexString>;
  skos:broader <http://qudt.org/vocab/quantitykind/CrossSection>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L2I0M0H0T0D0>;
  <http://qudt.org/schema/qudt/informativeReference> "http://en.wikipedia.org/wiki/Cross_section_(physics)"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/isoNormativeReference> "http://www.iso.org/iso/catalogue_detail?csnumber=31895"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/plainTextDescription> "\"Macroscopic Cross-section\" is the sum of the cross-sections for a reaction or process of a specified type over all atoms or other entities in a given 3D domain, divided by the volume of that domain.";
  <http://qudt.org/schema/qudt/latexSymbol> "$\\sum$"^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/latexDefinition> "$\\sum = n_1\\sigma_1 + \\cdots + n_j\\sigma_j +$, where $n_j$ is the number density and $\\sigma_j$ the cross-section for entities of type $j$."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/applicableUnit> unit:AC, unit:ARE, unit:BARN, unit:CentiM2,
    unit:DecaARE, unit:DeciM2, unit:FT2, unit:HA, unit:IN2, unit:KiloM2, unit:KiloMIL_Circ,
    unit:M2, unit:MI2, unit:MI_US2, unit:MIL_Circ, unit:MicroM2, unit:MilliM2, unit:NanoM2,
    unit:PlanckArea, unit:YD2 .

<http://qudt.org/vocab/quantitykind/MacroscopicTotalCrossSection> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Macroscopic Total Cross-section"@en;
  rdfs:comment "Applicable units are those of quantitykind:Area";
  dct:description "\"Macroscopic Total Cross-section\" is the total cross-sections for all atoms or other entities in a given 3D domain, divided by the volume of that domain."^^<http://qudt.org/schema/qudt/LatexString>;
  skos:broader <http://qudt.org/vocab/quantitykind/CrossSection>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L2I0M0H0T0D0>;
  <http://qudt.org/schema/qudt/informativeReference> "http://en.wikipedia.org/wiki/Cross_section_(physics)"^^xsd:anyURI,
    "http://en.wikipedia.org/wiki/Nuclear_cross_section"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/isoNormativeReference> "http://www.iso.org/iso/catalogue_detail?csnumber=31895"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/plainTextDescription> "\"Macroscopic Total Cross-section\" is the total cross-sections for all atoms or other entities in a given 3D domain, divided by the volume of that domain.";
  <http://qudt.org/schema/qudt/latexSymbol> "$\\sum_{tot}, \\sum_T$"^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/applicableUnit> unit:AC, unit:ARE, unit:BARN, unit:CentiM2,
    unit:DecaARE, unit:DeciM2, unit:FT2, unit:HA, unit:IN2, unit:KiloM2, unit:KiloMIL_Circ,
    unit:M2, unit:MI2, unit:MI_US2, unit:MIL_Circ, unit:MicroM2, unit:MilliM2, unit:NanoM2,
    unit:PlanckArea, unit:YD2 .

<http://qudt.org/vocab/quantitykind/MagneticDipoleMomentOfAMolecule> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "magnetic dipole moment of a molecule"@en-US;
  dct:description "Em = -m•B, where Em is the interaction energy of the molecule with the magnetic dipole moment m and a magnetic field with the magnetic induced flux density B"@en;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E1L2I0M0H0T0D0>;
  <http://qudt.org/schema/qudt/symbol> "0173-1#Z4-BAJ460#001";
  <http://qudt.org/schema/qudt/plainTextDescription> "Em = -m•B, wobei Em die Interaktionsenergie vom Molekül ist mit dem magnetischem Dipolmoment m und einem Magnetfeld mit der magnetischen Induktionsflussdichte B"@de .

<http://qudt.org/vocab/quantitykind/MagneticFluxDensityOrMagneticPolarization> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "magnetic flux density or magnetic polarization"@en-US;
  dct:description "field vector B which exhibits a force F on any charged particle which has a velocity v, where the force is the product of the vector product v x B and the electric charge Q of the particle or vector quantity equal to the product of the magnetization M and the magnetic constant µ₀"@en;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E-1L0I0M1H0T-2D0>;
  <http://qudt.org/schema/qudt/symbol> "0173-1#Z4-BAJ221#002";
  <http://qudt.org/schema/qudt/plainTextDescription> "vektorielle Feldgröße B, die auf jedes geladene Teilchen, das eine Geschwindigkeit v hat, eine Kraft F ausübt, die gleich dem Produkt aus dem Vektorprodukt v x B und der elektrischen Ladung Q des Teilchens ist oder vektorielle Größe gleich dem Produkt aus der Magnetisierung M und der magnetischen Feldkonstante µ₀"@de .

<http://qudt.org/vocab/quantitykind/MagneticPolarization> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:seeAlso <http://qudt.org/vocab/quantitykind/MagneticFieldStrength_H>, <http://qudt.org/vocab/constant/MagneticConstant>,
    <http://qudt.org/vocab/quantitykind/Magnetization>;
  rdfs:label "Magnetic Polarization"@en;
  dct:description """
$\\text{Magnetic Polarization}$ is a vector quantity equal to the product of the magnetization $M$ and the magnetic constant $\\mu_0$.
  """^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E1L-1I0M0H0T0D0>;
  <http://qudt.org/schema/qudt/iec61360Code> "0112/2///62720#UAD102";
  <http://qudt.org/schema/qudt/informativeReference> "http://www.iso.org/iso/home/store/catalogue_tc/catalogue_detail.htm?csnumber=31891"^^xsd:anyURI,
    "http://www.electropedia.org/iev/iev.nsf/display?openform&ievref=121-11-54"^^xsd:anyURI,
    "https://cdd.iec.ch/cdd/iec61987/iec61987.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD102"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/latexSymbol> "$J_m$"^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/latexDefinition> "$J_m = \\mu_0 M$,  where $\\mu_0$ is the magentic constant and $M$ is magnetization."^^<http://qudt.org/schema/qudt/LatexString> .

<http://qudt.org/vocab/quantitykind/Magnetization> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Magnetisierung"@de, "aimantation"@fr, "magnetización"@es, "magnetization"@en,
    "magnetização"@pt, "magnetizzazione"@it, "magnetyzacia"@pl, "намагниченность"@ru,
    "مغنطة"@ar, "磁化"@ja;
  rdfs:comment "Applicable units are those of quantitykind:LinearElectricCurrentDensity";
  dct:description "\"Magnetization\" is defined as the ratio of magnetic moment per unit volume. It is a vector-valued quantity."^^<http://qudt.org/schema/qudt/LatexString>;
  skos:broader <http://qudt.org/vocab/quantitykind/LinearElectricCurrent>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E1L-1I0M0H0T0D0>;
  <http://qudt.org/schema/qudt/informativeReference> "http://www.iso.org/iso/home/store/catalogue_tc/catalogue_detail.htm?csnumber=31891"^^xsd:anyURI,
    "http://www.electropedia.org/iev/iev.nsf/display?openform&ievref=121-11-52"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/symbol> "M";
  <http://qudt.org/schema/qudt/plainTextDescription> "\"Magnetization\" is defined as the ratio of magnetic moment per unit volume. It is a vector-valued quantity.";
  <http://qudt.org/schema/qudt/latexDefinition> "$M = dm/dV$, where $m$ is magentic moment of a substance in a domain with Volume $V$."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/altSymbol> "H_i";
  <http://qudt.org/schema/qudt/applicableUnit> unit:A-PER-CentiM, unit:A-PER-M, unit:A-PER-MilliM,
    unit:KiloA-PER-M, unit:MilliA-PER-IN, unit:MilliA-PER-MilliM .

<http://qudt.org/vocab/quantitykind/MagnetizationField> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Magnetization Field"@en;
  rdfs:comment "Applicable units are those of quantitykind:LinearElectricCurrentDensity";
  dct:description "The Magnetization Field is defined as the ratio of magnetic moment per unit volume. It is a vector-valued quantity."^^<http://qudt.org/schema/qudt/LatexString>;
  skos:broader <http://qudt.org/vocab/quantitykind/ElectricCurrentPerLength>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E1L-1I0M0H0T0D0>;
  <http://qudt.org/schema/qudt/symbol> "M";
  <http://qudt.org/schema/qudt/plainTextDescription> "The Magnetization Field is defined as the ratio of magnetic moment per unit volume. It is a vector-valued quantity.";
  <http://qudt.org/schema/qudt/applicableUnit> unit:A-PER-CentiM, unit:A-PER-M, unit:A-PER-MilliM,
    unit:KiloA-PER-M, unit:MilliA-PER-IN, unit:MilliA-PER-MilliM .

<http://qudt.org/vocab/quantitykind/MassAmountOfSubstance> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Mass Amount of Substance"@en;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A1E0L0I0M1H0T0D0> .

<http://qudt.org/vocab/dimensionvector/A1E0L0I0M1H0T0D0> a <http://qudt.org/schema/qudt/QuantityKindDimensionVector_SI>,
    <http://qudt.org/schema/qudt/QuantityKindDimensionVector_ISO>, <http://qudt.org/schema/qudt/QuantityKindDimensionVector_Imperial>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/dimensionvector>;
  rdfs:label "A1E0L0I0M1H0T0D0";
