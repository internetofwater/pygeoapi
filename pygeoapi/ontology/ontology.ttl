  <http://qudt.org/schema/qudt/symbol> "E_{ab}";
  <http://qudt.org/schema/qudt/isoNormativeReference> "http://www.iso.org/iso/catalogue_detail?csnumber=31897"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/plainTextDescription> "\"Source Voltage Between Substances\" is the source voltage between substance a and b.";
