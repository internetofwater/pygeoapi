<http://qudt.org/vocab/quantitykind/TemperatureBasedAmountOfSubstanceConcentration>
  a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "temperature-based amount-of-substance concentration"@en-US;
  dct:description "ratio of material concentration divided by the related temperature"@en;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/NotApplicable>;
  <http://qudt.org/schema/qudt/symbol> "0173-1#Z4-BAJ395#002";
  <http://qudt.org/schema/qudt/plainTextDescription> "Quotient aus Stoffmengenkonzentration dividiert durch die zugehörige Temperatur"@de .

<http://qudt.org/vocab/quantitykind/TemperatureBasedDensity> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "temperature-based density"@en-US;
  dct:description "ratio of density divided by the related temperature"@en;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/NotApplicable>;
  <http://qudt.org/schema/qudt/symbol> "0173-1#Z4-BAJ389#003";
  <http://qudt.org/schema/qudt/plainTextDescription> "Quotient aus Dichte dividiert durch die zugehörige Temperatur"@de .

<http://qudt.org/vocab/quantitykind/TemperatureBasedDynamicViscosity> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "temperature-based dynamic viscosity"@en-US;
  dct:description "ratio of dynamic viscosity, divided by temperature"@en;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/NotApplicable>;
  <http://qudt.org/schema/qudt/symbol> "0173-1#Z4-BAJ390#002";
  <http://qudt.org/schema/qudt/plainTextDescription> "Quotient der dynamischen Viskosität dividiert durch die Temperatur"@de .

<http://qudt.org/vocab/quantitykind/TemperatureBasedKinematicViscosity> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "temperature-based kinematic viscosity"@en-US;
  dct:description "ratio of dynamic viscosity and the density of a material, divided by the related temperature"@en;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/NotApplicable>;
  <http://qudt.org/schema/qudt/symbol> "0173-1#Z4-BAJ392#002";
  <http://qudt.org/schema/qudt/plainTextDescription> "Quotient aus der dynamischen Viskosität und der Dichte eines Stoffes dividiert durch die zugehörige Temperatur"@de .

<http://qudt.org/vocab/quantitykind/TemperatureBasedLength> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "temperature-based length"@en-US;
  dct:description "ratio of length divided by the related temperature"@en;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L1I0M0H-1T0D0>;
  <http://qudt.org/schema/qudt/symbol> "0173-1#Z4-BAJ393#002";
  <http://qudt.org/schema/qudt/plainTextDescription> "Quotient aus Länge dividiert durch die zugehörige Temperatur"@de .

<http://qudt.org/vocab/quantitykind/TemperatureBasedMass> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "temperature-based mass"@en-US;
  dct:description "ratio of mass divided by the related temperature"@en;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/NotApplicable>;
  <http://qudt.org/schema/qudt/symbol> "0173-1#Z4-BAJ394#002";
  <http://qudt.org/schema/qudt/plainTextDescription> "Quotient aus Masse dividiert durch die zugehörige Temperatur"@de .

<http://qudt.org/vocab/quantitykind/TemperatureBasedMassFlowRate> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "temperature-based mass flow rate"@en-US;
