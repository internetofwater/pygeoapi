  <http://qudt.org/schema/qudt/applicableUnit> unit:A-PER-KiloGM .

unit:A-PER-M a <http://qudt.org/schema/qudt/Unit>, <http://qudt.org/schema/qudt/DerivedUnit>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/unit>;
  rdfs:label "Ampere je Meter"@de, "Ampere per Meter"@en-US, "amper bölü metre"@tr,
    "amper na meter"@sl, "amper na metr"@pl, "ampere al metro"@it, "ampere pe metru"@ro,
    "ampere per meter"@ms, "ampere per metre"@en, "ampere por metro"@pt, "amperio por metro"@es,
    "ampère par mètre"@fr, "ampérů na metr"@cs, "ампер на метр"@ru, "آمپر بر متر"@fa,
    "مقياس التبادل، الأس السالب للمتر"@ar, "प्रति मीटर एम्पीयर"@hi, "アンペア毎メートル"@ja, "安培每米"@zh;
  dct:description " is the SI unit of magnetic field strength. One ampere per meter is equal to $\\pi/250$ oersteds ($12.566\\, 371\\,millioersteds$) in CGS units. The ampere per meter is also the SI unit of \"magnetization\" in the sense of magnetic dipole moment per unit volume; in this context $1 A/m = 0.001\\,emu\\,per\\,cubic\\,centimeter$."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/applicableSystem> <http://qudt.org/vocab/sou/CGS-EMU>,
    <http://qudt.org/vocab/sou/CGS-GAUSS>, <http://qudt.org/vocab/sou/SI>;
  <http://qudt.org/schema/qudt/conversionMultiplier> 1.0;
  <http://qudt.org/schema/qudt/conversionMultiplierSN> 1.0E0;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E1L-1I0M0H0T0D0>;
  <http://qudt.org/schema/qudt/hasQuantityKind> <http://qudt.org/vocab/quantitykind/LinearElectricCurrentDensity>,
    <http://qudt.org/vocab/quantitykind/MagneticFieldStrength_H>, <http://qudt.org/vocab/quantitykind/Coercivity>;
  <http://qudt.org/schema/qudt/iec61360Code> "0112/2///62720#UAA104";
  <http://qudt.org/schema/qudt/informativeReference> "https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAA104"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/symbol> "A/m";
  <http://qudt.org/schema/qudt/ucumCode> "A.m-1"^^<http://qudt.org/schema/qudt/UCUMcs>,
    "A/m"^^<http://qudt.org/schema/qudt/UCUMcs>;
  <http://qudt.org/schema/qudt/uneceCommonCode> "AE";
  <http://qudt.org/schema/qudt/expression> "$A/m$"^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/derivedCoherentUnitOfSystem> <http://qudt.org/vocab/sou/SI>;
  <http://qudt.org/schema/qudt/definedUnitOfSystem> <http://qudt.org/vocab/sou/SI> .

<http://qudt.org/schema/qudt/definedUnitOfSystem> a owl:ObjectProperty;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/schema/qudt>;
  rdfs:label "defined unit of system";
  owl:inverseOf <http://qudt.org/schema/qudt/hasDefinedUnit>;
  rdfs:subPropertyOf <http://qudt.org/schema/qudt/isUnitOfSystem>;
  dct:description "This property relates a unit of measure with the unit system that defines the unit."^^rdf:HTML .

<http://qudt.org/vocab/quantitykind/Coercivity> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:seeAlso <http://qudt.org/vocab/quantitykind/MagneticFieldStrength_H>;
  rdfs:label "Coercivity"@en;
  rdfs:comment "Applicable units are those of quantitykind:Coercivity";
  dct:description "$\\textit{Coercivity}$, also referred to as $\\textit{Coercive Field Strength}$, is the magnetic field strength to be applied to bring the magnetic flux density in a substance from its remaining magnetic flux density to zero. This is defined as the coercive field strength in a substance when either the magnetic flux density or the magnetic polarization and magnetization is brought from its value at magnetic saturation to zero by monotonic reduction of the applied magnetic field strength. The quantity which is brought to zero should be stated, and the appropriate symbol used: $H_{cB}$, $H_{cJ}$ or $H_{cM}$ for the coercivity relating to the magnetic flux density, the magnetic polarization or the magnetization respectively, where $H_{cJ} = H_{cM}$."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E1L-1I0M0H0T0D0>;
  <http://qudt.org/schema/qudt/informativeReference> "http://www.iso.org/iso/home/store/catalogue_tc/catalogue_detail.htm?csnumber=31891"^^xsd:anyURI,
    "http://www.electropedia.org/iev/iev.nsf/display?openform&ievref=121-12-69"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/symbol> "H_{c,B}";
  <http://qudt.org/schema/qudt/applicableUnit> unit:A-PER-M .

unit:A-PER-M2 a <http://qudt.org/schema/qudt/Unit>, <http://qudt.org/schema/qudt/DerivedUnit>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/unit>;
  rdfs:label "Ampere je Quadratmeter"@de, "Ampere per Square Meter"@en-US, "amper bölü metre kare"@tr,
    "amper na kvadratni meter"@sl, "amper na metr kwadratowy"@pl, "ampere al metro quadrato"@it,
    "ampere pe metru pătrat"@ro, "ampere per meter persegi"@ms, "ampere per square metre"@en,
    "ampere por metro quadrado"@pt, "amperio por metro cuadrado"@es, "ampère par mètre carré"@fr,
    "ampér na metr čtvereční"@cs, "ампер на квадратный метр"@ru, "آمپر بر مترمربع"@fa,
    "أمبير في المتر المربع"@ar, "एम्पीयर प्रति वर्ग मीटर"@hi, "アンペア毎平方メートル"@ja, "安培每平方米"@zh;
  dct:description """$\\textit{Ampere Per Square Meter}$ is a unit in the category of electric current density. 
This unit is commonly used in the SI unit system.
"""^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/applicableSystem> <http://qudt.org/vocab/sou/CGS-EMU>,
    <http://qudt.org/vocab/sou/CGS-GAUSS>, <http://qudt.org/vocab/sou/SI>;
  <http://qudt.org/schema/qudt/conversionMultiplier> 1.0;
  <http://qudt.org/schema/qudt/conversionMultiplierSN> 1.0E0;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E1L-2I0M0H0T0D0>;
  <http://qudt.org/schema/qudt/hasQuantityKind> <http://qudt.org/vocab/quantitykind/ElectricCurrentDensity>,
    <http://qudt.org/vocab/quantitykind/DisplacementCurrentDensity>, <http://qudt.org/vocab/quantitykind/TotalCurrentDensity>;
  <http://qudt.org/schema/qudt/iec61360Code> "0112/2///62720#UAA105", "0112/2///62720#UAD533";
  <http://qudt.org/schema/qudt/informativeReference> "https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAA105"^^xsd:anyURI,
    "https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAD533"^^xsd:anyURI,
    "https://en.wikipedia.org/wiki/Current_density"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/symbol> "A/m²";
  <http://qudt.org/schema/qudt/ucumCode> "A.m-2"^^<http://qudt.org/schema/qudt/UCUMcs>,
    "A/m2"^^<http://qudt.org/schema/qudt/UCUMcs>;
  <http://qudt.org/schema/qudt/uneceCommonCode> "A41";
  <http://qudt.org/schema/qudt/expression> "$A/m^2$"^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/derivedCoherentUnitOfSystem> <http://qudt.org/vocab/sou/SI>;
  <http://qudt.org/schema/qudt/definedUnitOfSystem> <http://qudt.org/vocab/sou/SI> .

<http://qudt.org/vocab/quantitykind/DisplacementCurrentDensity> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:seeAlso <http://qudt.org/vocab/quantitykind/ElectricFluxDensity>;
  rdfs:label "Displacement Current Density"@en;
  rdfs:comment "Applicable units are those of quantitykind:DisplacementCurrentDensity";
  dct:description """
$\\text{Displacement Current Density}$ is the time rate of change of the $\\textit{Electric Flux Density}$. 
  This is a measure of how quickly the electric field changes if we observe it as a function of time. 
  This is different than if we look at how the electric field changes spatially, that is, over a region of space for a fixed amount of time.
  """^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/dbpediaMatch> "http://dbpedia.org/resource/Electric_flux"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E1L-2I0M0H0T0D0>;
  <http://qudt.org/schema/qudt/informativeReference> "http://www.iso.org/iso/home/store/catalogue_tc/catalogue_detail.htm?csnumber=31891"^^xsd:anyURI,
    "http://www.maxwells-equations.com/math/partial-electric-flux.php"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/latexSymbol> "$J_D$"^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/latexDefinition> "$J_D = \\frac{\\partial D}{\\partial t}$, where $D$ is electric flux density and $t$ is time."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/applicableUnit> unit:A-PER-M2 .

<http://qudt.org/vocab/quantitykind/TotalCurrentDensity> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:seeAlso <http://qudt.org/vocab/quantitykind/ElectricCurrentDensity>, <http://qudt.org/vocab/quantitykind/DisplacementCurrentDensity>;
  rdfs:label "Total Current Density"@en;
  rdfs:comment "Applicable units are those of quantitykind:TotalCurrentDensity";
  dct:description "\"Total Current Density\" is the sum of the electric current density and the displacement current density."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E1L-2I0M0H0T0D0>;
  <http://qudt.org/schema/qudt/informativeReference> "http://www.iso.org/iso/home/store/catalogue_tc/catalogue_detail.htm?csnumber=31891"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/plainTextDescription> "\"Total Current Density\" is the sum of the electric current density and the displacement current density.";
  <http://qudt.org/schema/qudt/latexSymbol> "$J_{tot}$"^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/latexDefinition> "$J_{tot}= J + J_D$, where $J$ is electric current density and $J_D$ is displacement current density."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/applicableUnit> unit:A-PER-M2 .

unit:A-PER-M2-K2 a <http://qudt.org/schema/qudt/Unit>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/unit>;
  rdfs:label "Ampere per Square Meter Square Kelvin"@en-US, "Ampere per Square Metre Square Kelvin"@en;
  <http://qudt.org/schema/qudt/applicableSystem> <http://qudt.org/vocab/sou/SI>;
  <http://qudt.org/schema/qudt/conversionMultiplier> 1.0;
  <http://qudt.org/schema/qudt/conversionMultiplierSN> 1.0E0;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E1L-2I0M0H-2T0D0>;
  <http://qudt.org/schema/qudt/hasQuantityKind> <http://qudt.org/vocab/quantitykind/RichardsonConstant>;
  <http://qudt.org/schema/qudt/iec61360Code> "0112/2///62720#UAB353";
  <http://qudt.org/schema/qudt/informativeReference> "http://www.iso.org/iso/catalogue_detail?csnumber=31897"^^xsd:anyURI,
    "https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAB353"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/symbol> "A/(m²·K²)";
  <http://qudt.org/schema/qudt/ucumCode> "A.m-2.K-2"^^<http://qudt.org/schema/qudt/UCUMcs>,
    "A/(m2.K2)"^^<http://qudt.org/schema/qudt/UCUMcs>;
  <http://qudt.org/schema/qudt/uneceCommonCode> "A6";
  <http://qudt.org/schema/qudt/expression> "$a/m^2-k^2$"^^<http://qudt.org/schema/qudt/LatexString> .

<http://qudt.org/vocab/dimensionvector/A0E1L-2I0M0H-2T0D0> a <http://qudt.org/schema/qudt/QuantityKindDimensionVector_SI>,
    <http://qudt.org/schema/qudt/QuantityKindDimensionVector_CGS>, <http://qudt.org/schema/qudt/QuantityKindDimensionVector_ISO>,
    <http://qudt.org/schema/qudt/QuantityKindDimensionVector_Imperial>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/dimensionvector>;
  rdfs:label "A0E1L-2I0M0H-2T0D0";
  <http://qudt.org/schema/qudt/dimensionExponentForAmountOfSubstance> 0;
  <http://qudt.org/schema/qudt/dimensionExponentForElectricCurrent> 1;
  <http://qudt.org/schema/qudt/dimensionExponentForLength> -2;
  <http://qudt.org/schema/qudt/dimensionExponentForLuminousIntensity> 0;
  <http://qudt.org/schema/qudt/dimensionExponentForMass> 0;
  <http://qudt.org/schema/qudt/dimensionExponentForThermodynamicTemperature> -2;
  <http://qudt.org/schema/qudt/dimensionExponentForTime> 0;
  <http://qudt.org/schema/qudt/dimensionlessExponent> 0 .

<http://qudt.org/vocab/quantitykind/RichardsonConstant> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Richardson Constant"@en;
  rdfs:comment "Applicable units are those of quantitykind:RichardsonConstant";
  dct:description "\"Richardson Constant\" is a constant used in developing thermionic emission current density for a metal."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E1L-2I0M0H-2T0D0>;
  <http://qudt.org/schema/qudt/iec61360Code> "0112/2///62720#UAD162";
  <http://qudt.org/schema/qudt/informativeReference> "http://en.wikipedia.org/wiki/Thermionic_emission"^^xsd:anyURI,
    "https://cdd.iec.ch/cdd/iec61987/iec61987.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD162"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/symbol> "A";
  <http://qudt.org/schema/qudt/isoNormativeReference> "http://www.iso.org/iso/catalogue_detail?csnumber=31897"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/plainTextDescription> "\"Richardson Constant\" is a constant used in developing thermionic emission current density for a metal.";
  <http://qudt.org/schema/qudt/latexDefinition> "The thermionic emission current, $J$, for a metal is $J = AT^2\\exp{(-\\frac{\\Phi}{kT})}$, where $T$ is thermodynamic temperature, $k$ is the Boltzmann constant, and $\\Phi$ is a work function."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/applicableUnit> unit:A-PER-M2-K2 .

unit:A-PER-MilliM a <http://qudt.org/schema/qudt/Unit>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/unit>;
  rdfs:label "Ampere per Millimeter"@en-US, "Ampere per Millimetre"@en;
  dct:description "SI base unit ampere divided by the 0.001-fold of the SI base unit metre"^^rdf:HTML;
  <http://qudt.org/schema/qudt/applicableSystem> <http://qudt.org/vocab/sou/CGS-EMU>,
    <http://qudt.org/vocab/sou/CGS-GAUSS>, <http://qudt.org/vocab/sou/SI>;
  <http://qudt.org/schema/qudt/conversionMultiplier> 1000.0;
  <http://qudt.org/schema/qudt/conversionMultiplierSN> 1.0E3;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E1L-1I0M0H0T0D0>;
  <http://qudt.org/schema/qudt/hasQuantityKind> <http://qudt.org/vocab/quantitykind/LinearElectricCurrentDensity>,
    <http://qudt.org/vocab/quantitykind/MagneticFieldStrength_H>;
  <http://qudt.org/schema/qudt/iec61360Code> "0112/2///62720#UAB072";
  <http://qudt.org/schema/qudt/informativeReference> "https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAB072"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/symbol> "A/mm";
  <http://qudt.org/schema/qudt/ucumCode> "A.mm-1"^^<http://qudt.org/schema/qudt/UCUMcs>,
    "A/mm"^^<http://qudt.org/schema/qudt/UCUMcs>;
  <http://qudt.org/schema/qudt/uneceCommonCode> "A3";
  <http://qudt.org/schema/qudt/plainTextDescription> "SI base unit ampere divided by the 0.001-fold of the SI base unit metre" .

unit:A-PER-MilliM2 a <http://qudt.org/schema/qudt/Unit>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/unit>;
  rdfs:label "Ampere per Square Millimeter"@en-US, "Ampere per Square Millimetre"@en;
  dct:description "SI base unit ampere divided by the 0.000 001-fold of the power of the SI base unit metre by exponent 2"^^rdf:HTML;
  <http://qudt.org/schema/qudt/applicableSystem> <http://qudt.org/vocab/sou/CGS-EMU>,
    <http://qudt.org/vocab/sou/CGS-GAUSS>, <http://qudt.org/vocab/sou/SI>;
  <http://qudt.org/schema/qudt/conversionMultiplier> 1000000.0;
  <http://qudt.org/schema/qudt/conversionMultiplierSN> 1.0E6;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E1L-2I0M0H0T0D0>;
  <http://qudt.org/schema/qudt/hasQuantityKind> <http://qudt.org/vocab/quantitykind/ElectricCurrentDensity>;
  <http://qudt.org/schema/qudt/iec61360Code> "0112/2///62720#UAB051";
  <http://qudt.org/schema/qudt/informativeReference> "https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAB051"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/symbol> "A/mm²";
  <http://qudt.org/schema/qudt/ucumCode> "A.mm-2"^^<http://qudt.org/schema/qudt/UCUMcs>,
    "A/mm2"^^<http://qudt.org/schema/qudt/UCUMcs>;
  <http://qudt.org/schema/qudt/uneceCommonCode> "A7";
  <http://qudt.org/schema/qudt/plainTextDescription> "SI base unit ampere divided by the 0.000 001-fold of the power of the SI base unit metre by exponent 2" .

unit:A-PER-PA a <http://qudt.org/schema/qudt/Unit>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/unit>;
  rdfs:label "ampere per pascal";
  dct:description "SI base unit ampere divided by the SI derived unit pascal";
