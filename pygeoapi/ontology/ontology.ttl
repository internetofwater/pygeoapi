quantitykind:RespiratoryRate a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "Respiratory Rate"@en, "Respiratory Rate"@en;
  rdfs:comment "Applicable units are those of quantitykind:RespiratoryRate", "Applicable units are those of quantitykind:RespiratoryRate";
  dct:description "Respiratory rate (Vf, Rf or RR) is also known by respiration rate, pulmonary ventilation rate, ventilation rate, or breathing frequency is the number of breaths taken within a set amount of time, typically 60 seconds. A normal respiratory rate is termed eupnea, an increased respiratory rate is termed tachypnea and a lower than normal respiratory rate is termed bradypnea."^^qudt:LatexString,
    "Respiratory rate (Vf, Rf or RR) is also known by respiration rate, pulmonary ventilation rate, ventilation rate, or breathing frequency is the number of breaths taken within a set amount of time, typically 60 seconds. A normal respiratory rate is termed eupnea, an increased respiratory rate is termed tachypnea and a lower than normal respiratory rate is termed bradypnea."^^qudt:LatexString;
  qudt:dbpediaMatch "http://dbpedia.org/resource/Respiratory_rate"^^xsd:anyURI, "http://dbpedia.org/resource/Respiratory_rate"^^xsd:anyURI;
  qudt:hasDimensionVector dimensionvector:A0E0L0I0M0H0T-1D0, dimensionvector:A0E0L0I0M0H0T-1D0;
  qudt:informativeReference "http://en.wikipedia.org/wiki/Respiratory_rate"^^xsd:anyURI,
    "http://en.wikipedia.org/wiki/Respiratory_rate"^^xsd:anyURI;
  qudt:symbol "Vf, Rf or RR", "Vf, Rf or RR";
  qudt:plainTextDescription "Respiratory rate (Vf, Rf or RR) is also known by respiration rate, pulmonary ventilation rate, ventilation rate, or breathing frequency is the number of breaths taken within a set amount of time, typically 60 seconds. A normal respiratory rate is termed eupnea, an increased respiratory rate is termed tachypnea and a lower than normal respiratory rate is termed bradypnea.",
    "Respiratory rate (Vf, Rf or RR) is also known by respiration rate, pulmonary ventilation rate, ventilation rate, or breathing frequency is the number of breaths taken within a set amount of time, typically 60 seconds. A normal respiratory rate is termed eupnea, an increased respiratory rate is termed tachypnea and a lower than normal respiratory rate is termed bradypnea.";
  qudt:applicableUnit unit:BREATH-PER-MIN, unit:BREATH-PER-MIN .

unit:BREWSTER a qudt:Unit, qudt:Unit, qudt:DerivedUnit, qudt:DerivedUnit;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/unit>, <http://qudt.org/vocab/unit>;
  rdfs:label "Brewster"@en, "Brewster"@en;
  dct:description "The brewster (B) is a non-SI unit used to measure the susceptibility of a material to photoelasticity, or the value of the stress-optic coefficient of the material. The unit has dimensions reciprocal to those of stress. One brewster is defined to be equal to 10^-12 square metres per newton (m^2/N or 1/Pa) or 10^-13 square centimetres per dyne (cm^2/dyn). The unit is named after David Brewster, who discovered stress-induced birefringence in 1816."^^rdf:HTML,
    "The brewster (B) is a non-SI unit used to measure the susceptibility of a material to photoelasticity, or the value of the stress-optic coefficient of the material. The unit has dimensions reciprocal to those of stress. One brewster is defined to be equal to 10^-12 square metres per newton (m^2/N or 1/Pa) or 10^-13 square centimetres per dyne (cm^2/dyn). The unit is named after David Brewster, who discovered stress-induced birefringence in 1816."^^rdf:HTML;
  qudt:conversionMultiplier 0.000000000001, 0.000000000001;
  qudt:conversionMultiplierSN 1.0E-12, 1.0E-12;
  qudt:hasDimensionVector dimensionvector:A0E0L1I0M-1H0T2D0, dimensionvector:A0E0L1I0M-1H0T2D0;
  qudt:hasQuantityKind quantitykind:StressOpticCoefficient, quantitykind:StressOpticCoefficient;
  qudt:informativeReference "https://en.wikipedia.org/wiki/Brewster_(unit)"^^xsd:anyURI,
    "https://en.wikipedia.org/wiki/Brewster_(unit)"^^xsd:anyURI;
  qudt:symbol "B", "B";
  qudt:exactMatch unit:NanoM-PER-MilliM-MegaPA, unit:NanoM-PER-MilliM-MegaPA;
  qudt:siUnitsExpression "nm/mm/MPa", "nm/mm/MPa";
  qudt:qkdvDenominator dimensionvector:A0E0L0I0M1H0T-2D0, dimensionvector:A0E0L0I0M1H0T-2D0;
  qudt:qkdvNumerator dimensionvector:A0E0L1I0M0H0T0D0, dimensionvector:A0E0L1I0M0H0T0D0 .

