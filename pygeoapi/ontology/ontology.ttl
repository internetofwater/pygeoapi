  <http://qudt.org/schema/qudt/informativeReference> "https://www.euronuclear.org/glossary/reactor-time-constant/"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/symbol> "T";
  <http://qudt.org/schema/qudt/isoNormativeReference> "http://www.iso.org/iso/catalogue_detail?csnumber=31895"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/plainTextDescription> "The \"Reactor Time Constant\", also called the reactor period, is the time during which the neutron flux density in a reactor changes by the factor e = 2.718 (e: basis of natural logarithms), when the neutron flux density increases or decreases exponentially.";
