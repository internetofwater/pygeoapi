  <http://qudt.org/schema/qudt/symbol> "GW·h";
  <http://qudt.org/schema/qudt/ucumCode> "GW.h"^^<http://qudt.org/schema/qudt/UCUMcs>;
  <http://qudt.org/schema/qudt/uneceCommonCode> "GWH";
