  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/unit>;
  rdfs:label "ton, register";
  dct:description "traditional unit of the cargo capacity";
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L3I0M0H0T0D0>;
  <http://qudt.org/schema/qudt/hasQuantityKind> <http://qudt.org/vocab/quantitykind/Volume>,
    <http://qudt.org/vocab/quantitykind/SectionModulus>;
  <http://qudt.org/schema/qudt/iec61360Code> "0112/2///62720#UAB291";
  <http://qudt.org/schema/qudt/informativeReference> "https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAB291"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/symbol> "RT";
  <http://qudt.org/schema/qudt/uneceCommonCode> "M70" .

