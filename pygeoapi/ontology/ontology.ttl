quantitykind:ScalarMagneticPotential a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:seeAlso quantitykind:MagneticFieldStrength_H, quantitykind:MagneticFieldStrength_H;
  rdfs:label "Scalar Magnetic Potential"@en, "Scalar Magnetic Potential"@en;
  rdfs:comment "Applicable units are those of quantitykind:ScalarMagneticPotential",
    "Applicable units are those of quantitykind:ScalarMagneticPotential";
  dct:description "\"Scalar Magnetic Potential\" is the scalar potential of an irrotational magnetic field strength. The negative of the gradient of the scalar magnetic potential is the irrotational magnetic field strength. The magnetic scalar potential is not unique since any constant scalar field can be added to it without changing its gradient."^^qudt:LatexString,
    "\"Scalar Magnetic Potential\" is the scalar potential of an irrotational magnetic field strength. The negative of the gradient of the scalar magnetic potential is the irrotational magnetic field strength. The magnetic scalar potential is not unique since any constant scalar field can be added to it without changing its gradient."^^qudt:LatexString;
  qudt:hasDimensionVector dimensionvector:A0E-1L1I0M1H0T-2D0, dimensionvector:A0E-1L1I0M1H0T-2D0;
  qudt:iec61360Code "0112/2///62720#UAD164", "0112/2///62720#UAD164";
  qudt:informativeReference "http://www.iso.org/iso/home/store/catalogue_tc/catalogue_detail.htm?csnumber=31891"^^xsd:anyURI,
    "http://www.iso.org/iso/home/store/catalogue_tc/catalogue_detail.htm?csnumber=31891"^^xsd:anyURI,
    "http://www.electropedia.org/iev/iev.nsf/display?openform&ievref=121-11-58"^^xsd:anyURI,
    "http://www.electropedia.org/iev/iev.nsf/display?openform&ievref=121-11-58"^^xsd:anyURI,
    "https://cdd.iec.ch/cdd/iec61987/iec61987.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD164"^^xsd:anyURI,
    "https://cdd.iec.ch/cdd/iec61987/iec61987.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD164"^^xsd:anyURI;
  qudt:symbol "V_m", "V_m";
  qudt:plainTextDescription "\"Scalar Magnetic Potential\" is the scalar potential of an irrotational magnetic field strength. The negative of the gradient of the scalar magnetic potential is the irrotational magnetic field strength. The magnetic scalar potential is not unique since any constant scalar field can be added to it without changing its gradient.",
    "\"Scalar Magnetic Potential\" is the scalar potential of an irrotational magnetic field strength. The negative of the gradient of the scalar magnetic potential is the irrotational magnetic field strength. The magnetic scalar potential is not unique since any constant scalar field can be added to it without changing its gradient.";
  qudt:latexSymbol "$\\varphi$"^^qudt:LatexString, "$\\varphi$"^^qudt:LatexString;
  qudt:latexDefinition "$\\mathbf{H} = -grad V_m$, where $\\mathbf{H}$ is magnetic field strength."^^qudt:LatexString,
    "$\\mathbf{H} = -grad V_m$, where $\\mathbf{H}$ is magnetic field strength."^^qudt:LatexString;
  qudt:applicableUnit unit:V-SEC-PER-M, unit:V-SEC-PER-M .

