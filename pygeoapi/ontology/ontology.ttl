  <http://qudt.org/schema/qudt/hasQuantityKind> <http://qudt.org/vocab/quantitykind/Density>,
    <http://qudt.org/vocab/quantitykind/MassDensity>;
  <http://qudt.org/schema/qudt/symbol> "t{long}/yd³";
