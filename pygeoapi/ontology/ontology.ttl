quantitykind:MagneticFluxDensity a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:seeAlso quantitykind:MagneticField, quantitykind:MagneticField;
  rdfs:label "Densidad de flujo magnético"@es, "Densidad de flujo magnético"@es, "Densité de flux magnétique"@fr,
    "Densité de flux magnétique"@fr, "Ketumpatan fluks magnet"@ms, "Ketumpatan fluks magnet"@ms,
    "Magnetická indukce"@cs, "Magnetická indukce"@cs, "densidade de fluxo magnético"@pt,
    "densidade de fluxo magnético"@pt, "densitas fluxus magnetici"@la, "densitas fluxus magnetici"@la,
    "densità di flusso magnetico"@it, "densità di flusso magnetico"@it, "gostota magnetnega pretoka"@sl,
    "gostota magnetnega pretoka"@sl, "inducție magnetică"@ro, "inducție magnetică"@ro,
    "indukcja magnetyczna"@pl, "indukcja magnetyczna"@pl, "magnetic flux density"@en,
    "magnetic flux density"@en, "magnetische Flussdichte"@de, "magnetische Flussdichte"@de,
    "manyetik akı yoğunluğu"@tr, "manyetik akı yoğunluğu"@tr, "mágneses indukció"@hu,
    "mágneses indukció"@hu, "Магнитна индукция"@bg, "Магнитна индукция"@bg, "Магнитная индукция"@ru,
    "Магнитная индукция"@ru, "צפיפות שטף מגנטי"@he, "צפיפות שטף מגנטי"@he, "المجال المغناطيسي"@ar,
    "المجال المغناطيسي"@ar, "چگالی شار مغناطیسی"@fa, "چگالی شار مغناطیسی"@fa, "चुम्बकीय क्षेत्र"@hi,
    "चुम्बकीय क्षेत्र"@hi, "磁束密度"@ja, "磁束密度"@ja, "磁通量密度"@zh, "磁通量密度"@zh;
  rdfs:comment "Applicable units are those of quantitykind:MagneticFluxDensity", "Applicable units are those of quantitykind:MagneticFluxDensity";
  dct:description "\"Magnetic Flux Density\" is a vector quantity and is the magnetic flux per unit area of a magnetic field at right angles to the magnetic force. It can be defined in terms of the effects the field has, for example by $B = F/q v \\sin \\theta$, where $F$ is the force a moving charge $q$ would experience if it was travelling at a velocity $v$ in a direction making an angle θ with that of the field. The magnetic field strength is also a vector quantity and is related to $B$ by: $H = B/\\mu$, where $\\mu$ is the permeability of the medium."^^qudt:LatexString,
    "\"Magnetic Flux Density\" is a vector quantity and is the magnetic flux per unit area of a magnetic field at right angles to the magnetic force. It can be defined in terms of the effects the field has, for example by $B = F/q v \\sin \\theta$, where $F$ is the force a moving charge $q$ would experience if it was travelling at a velocity $v$ in a direction making an angle θ with that of the field. The magnetic field strength is also a vector quantity and is related to $B$ by: $H = B/\\mu$, where $\\mu$ is the permeability of the medium."^^qudt:LatexString;
  skos:altLabel "inducción magnética"@es, "inducción magnética"@es, "magnetische Induktion"@de,
    "magnetische Induktion"@de;
  qudt:hasDimensionVector dimensionvector:A0E-1L0I0M1H0T-2D0, dimensionvector:A0E-1L0I0M1H0T-2D0;
  qudt:iec61360Code "0112/2///62720#UAD100", "0112/2///62720#UAD100";
  qudt:informativeReference "http://www.iso.org/iso/home/store/catalogue_tc/catalogue_detail.htm?csnumber=31891"^^xsd:anyURI,
    "http://www.iso.org/iso/home/store/catalogue_tc/catalogue_detail.htm?csnumber=31891"^^xsd:anyURI,
    "http://www.oxfordreference.com/display/10.1093/acref/9780199233991.001.0001/acref-9780199233991-e-1798"^^xsd:anyURI,
    "https://cdd.iec.ch/cdd/iec61987/iec61987.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD100"^^xsd:anyURI,
    "https://cdd.iec.ch/cdd/iec61987/iec61987.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD100"^^xsd:anyURI,
    "http://www.oxfordreference.com/display/10.1093/acref/acref-9780199233991-e-1798"^^xsd:anyURI;
  qudt:symbol "B", "B";
  qudt:latexDefinition "$\\mathbf{F}  = qv \\times B$, where $F$ is force and $v$ is velocity of any test particle with electric charge $q$."^^qudt:LatexString,
    "$\\mathbf{F}  = qv \\times B$, where $F$ is force and $v$ is velocity of any test particle with electric charge $q$."^^qudt:LatexString;
