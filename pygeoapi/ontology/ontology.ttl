        <http://qudt.org/vocab/unit> .

unit:YD2 a qudt:DerivedUnit,
        qudt:Unit ;
    rdfs:label "Square Yard"@en ;
    dct:description "The square yard is an imperial/US customary unit of area, formerly used in most of the English-speaking world but now generally replaced by the square metre outside of the U.S. , Canada and the U.K. It is defined as the area of a square with sides of one yard in length. (Gaj in Hindi)."^^rdf:HTML ;
    qudt:applicableSystem <http://qudt.org/vocab/sou/IMPERIAL>,
        <http://qudt.org/vocab/sou/USCS> ;
    qudt:conversionMultiplier 0.83612736 ;
    qudt:conversionMultiplierSN 8.361274e-01 ;
    qudt:definedUnitOfSystem <http://qudt.org/vocab/sou/IMPERIAL>,
        <http://qudt.org/vocab/sou/USCS> ;
    qudt:expression "$yd^2$"^^qudt:LatexString ;
    qudt:hasDimensionVector dimensionvector:A0E0L2I0M0H0T0D0 ;
    qudt:hasFactorUnit [ qudt:exponent 2 ;
            qudt:hasUnit unit:YD ],
        [ qudt:exponent 2 ;
            qudt:hasUnit unit:YD ],
        [ qudt:exponent 2 ;
            qudt:hasUnit unit:YD ] ;
    qudt:hasQuantityKind quantitykind:Area ;
    qudt:iec61360Code "0112/2///62720#UAB034" ;
    qudt:informativeReference "https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAB034"^^xsd:anyURI ;
    qudt:symbol "yd²" ;
    qudt:ucumCode "[syd_i]"^^qudt:UCUMcs,
        "[yd_i]2"^^qudt:UCUMcs ;
    qudt:uneceCommonCode "YDK" ;
    rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/unit>,
        <http://qudt.org/vocab/unit> .

