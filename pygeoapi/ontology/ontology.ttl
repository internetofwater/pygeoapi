quantitykind:AbsoluteActivity a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "Absolute Activity"@en, "Absolute Activity"@en;
  rdfs:comment "Applicable units are those of quantitykind:AbsoluteActivity", "Applicable units are those of quantitykind:AbsoluteActivity";
  dct:description "The \"Absolute Activity\" is the exponential of the ratio of the chemical potential to $RT$ where $R$ is the gas constant and $T$ the thermodynamic temperature."^^qudt:LatexString,
    "The \"Absolute Activity\" is the exponential of the ratio of the chemical potential to $RT$ where $R$ is the gas constant and $T$ the thermodynamic temperature."^^qudt:LatexString;
  skos:broader quantitykind:InverseVolume, quantitykind:InverseVolume;
  qudt:hasDimensionVector dimensionvector:A0E0L-3I0M0H0T0D0, dimensionvector:A0E0L-3I0M0H0T0D0;
