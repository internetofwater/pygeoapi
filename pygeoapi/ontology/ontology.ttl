  <http://qudt.org/schema/qudt/uneceCommonCode> "C82";
  <http://qudt.org/schema/qudt/expression> "$rad m^2 / mol$"^^<http://qudt.org/schema/qudt/LatexString> .

<http://qudt.org/vocab/quantitykind/MolarOpticalRotatoryPower> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Molar Optical Rotatory Power"@en;
  rdfs:comment "Applicable units are those of quantitykind:MolarOpticalRotatoryPower";
  dct:description "The \"Molar Optical Rotatory Power\" Angle of optical rotation divided by the optical path length through the medium and by the amount concentration giving the molar optical rotatory power."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A-1E0L2I0M0H0T0D0>;
  <http://qudt.org/schema/qudt/iec61360Code> "0112/2///62720#UAD126";
  <http://qudt.org/schema/qudt/informativeReference> "http://goldbook.iupac.org/O04313.html"^^xsd:anyURI,
    "https://cdd.iec.ch/cdd/iec61987/iec61987.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD126"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/isoNormativeReference> "http://www.iso.org/iso/catalogue_detail?csnumber=31894"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/plainTextDescription> "The \"Molar Optical Rotatory Power\" Angle of optical rotation divided by the optical path length through the medium and by the amount concentration giving the molar optical rotatory power.";
  <http://qudt.org/schema/qudt/latexSymbol> "$\\alpha_n$"^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/latexDefinition> "$\\alpha_n = \\alpha \\frac{A}{n}$, where $\\alpha$ is the angle of optical rotation, and $n$ is the amount of substance of the optically active component in the path of a linearly polarized light beam of cross sectional area $A$."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/applicableUnit> unit:RAD-M2-PER-MOL .

unit:RAD-PER-HR a <http://qudt.org/schema/qudt/Unit>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/unit>;
  rdfs:label "Radian per Hour"@en;
  dct:description "\"Radian per Hour\" is a unit for  'Angular Velocity' expressed as $rad/h$."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/applicableSystem> <http://qudt.org/vocab/sou/CGS-EMU>,
    <http://qudt.org/vocab/sou/CGS-GAUSS>, <http://qudt.org/vocab/sou/SI>, <http://qudt.org/vocab/sou/CGS>;
  <http://qudt.org/schema/qudt/conversionMultiplier> 0.0002777777777777777777777777777777778;
  <http://qudt.org/schema/qudt/conversionMultiplierSN> 2.777777777777777777777777777777778E-4;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T-1D0>;
  <http://qudt.org/schema/qudt/hasQuantityKind> <http://qudt.org/vocab/quantitykind/AngularFrequency>,
    <http://qudt.org/vocab/quantitykind/AngularVelocity>;
  <http://qudt.org/schema/qudt/symbol> "rad/h";
  <http://qudt.org/schema/qudt/ucumCode> "rad.h-1"^^<http://qudt.org/schema/qudt/UCUMcs>,
    "rad/h"^^<http://qudt.org/schema/qudt/UCUMcs>;
  <http://qudt.org/schema/qudt/expression> "$rad/h$"^^<http://qudt.org/schema/qudt/LatexString> .

unit:RAD-PER-M a <http://qudt.org/schema/qudt/Unit>, <http://qudt.org/schema/qudt/DerivedUnit>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/unit>;
  rdfs:label "مقياس التبادل، الأس السالب للمتر"@ar, "Radian per Meter"@en-US, "Radiant je Meter"@de,
    "radian na metr"@pl, "radian par mètre"@fr, "radian per meter"@ms, "radian per metre"@en,
    "radiane pe metru"@ro, "radiano por metro"@pt, "radiante al metro"@it, "radián por metro"@es,
    "radiánů na metr"@cs, "radyan bölü metre"@tr, "радиан на метр"@ru, "رادیان بر متر"@fa,
    "प्रति मीटर वर्ग मीटर"@hi, "ラジアン毎メートル"@ja, "弧度每米"@zh;
  <http://qudt.org/schema/qudt/applicableSystem> <http://qudt.org/vocab/sou/CGS-EMU>,
    <http://qudt.org/vocab/sou/CGS-GAUSS>, <http://qudt.org/vocab/sou/SI>, <http://qudt.org/vocab/sou/CGS>;
  <http://qudt.org/schema/qudt/conversionMultiplier> 1.0;
  <http://qudt.org/schema/qudt/conversionMultiplierSN> 1.0E0;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L-1I0M0H0T0D0>;
  <http://qudt.org/schema/qudt/hasQuantityKind> <http://qudt.org/vocab/quantitykind/AngularWavenumber>,
    <http://qudt.org/vocab/quantitykind/DebyeAngularWavenumber>, <http://qudt.org/vocab/quantitykind/FermiAngularWavenumber>;
  <http://qudt.org/schema/qudt/iec61360Code> "0112/2///62720#UAA967", "0112/2///62720#UAD510";
  <http://qudt.org/schema/qudt/informativeReference> "http://www.iso.org/iso/catalogue_detail?csnumber=31897"^^xsd:anyURI,
    "https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAA967"^^xsd:anyURI,
    "https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAD510"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/symbol> "rad/m";
  <http://qudt.org/schema/qudt/ucumCode> "rad.m-1"^^<http://qudt.org/schema/qudt/UCUMcs>,
