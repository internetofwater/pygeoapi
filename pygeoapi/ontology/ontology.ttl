    "Úhlová rychlost"@cs, "Угловая скорость"@ru, "سرعة زاوية"@ar, "سرعت زاویه‌ای"@fa,
    "कोणीय वेग"@hi, "角速度"@ja;
  rdfs:comment "Applicable units are those of quantitykind:AngularVelocity";
  dct:description "Angular Velocity refers to how fast an object rotates or revolves relative to another point."^^<http://qudt.org/schema/qudt/LatexString>;
  skos:altLabel "angular speed"@en, "kelajuan bersudut"@ms;
  <http://qudt.org/schema/qudt/dbpediaMatch> "http://dbpedia.org/resource/Angular_velocity"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T-1D0>;
