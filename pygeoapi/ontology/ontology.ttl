  <http://qudt.org/schema/qudt/conversionMultiplier> 1000.0;
  <http://qudt.org/schema/qudt/conversionMultiplierSN> 1.0E3;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L0I0M-1H0T2D0>;
  <http://qudt.org/schema/qudt/hasQuantityKind> <http://qudt.org/vocab/quantitykind/SpectralCrossSection>;
  <http://qudt.org/schema/qudt/iec61360Code> "0112/2///62720#UAB168";
  <http://qudt.org/schema/qudt/informativeReference> "https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAB168"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/symbol> "cm²/erg";
  <http://qudt.org/schema/qudt/ucumCode> "cm2.erg-1"^^<http://qudt.org/schema/qudt/UCUMcs>,
    "cm2/erg"^^<http://qudt.org/schema/qudt/UCUMcs>;
  <http://qudt.org/schema/qudt/uneceCommonCode> "D16" .

<http://qudt.org/vocab/quantitykind/SpectralCrossSection> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Spectral Cross-section"@en;
  rdfs:comment "Applicable units are those of quantitykind:SpectralCrossSection";
  dct:description "\"Spectral Cross-section\" is the cross-section for a process in which the energy of the ejected or scattered particle is in an interval of energy, divided by the range $dE$ of this interval."^^<http://qudt.org/schema/qudt/LatexString>;
  skos:closeMatch <http://qudt.org/vocab/quantitykind/AngularCrossSection>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L0I0M-1H0T2D0>;
  <http://qudt.org/schema/qudt/informativeReference> "http://en.wikipedia.org/wiki/Cross_section_(physics)"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/isoNormativeReference> "http://www.iso.org/iso/catalogue_detail?csnumber=31895"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/latexSymbol> "$\\sigma_E$"^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/latexDefinition> "$\\sigma = \\int \\sigma_E dE$"^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/applicableUnit> unit:CentiM2-PER-ERG, unit:M2-PER-J .

unit:CentiM2-PER-GM a <http://qudt.org/schema/qudt/Unit>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/unit>;
  rdfs:label "Square centimeters per gram"@en-US, "Square centimetres per gram"@en;
  dct:description "0.0001-fold of the power of the SI base unit metre by exponent 2 divided by the 0.001-fold SI base unit kilogram";
  <http://qudt.org/schema/qudt/conversionMultiplier> 0.1;
  <http://qudt.org/schema/qudt/conversionMultiplierSN> 1.0E-1;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L2I0M-1H0T0D0>;
  <http://qudt.org/schema/qudt/hasQuantityKind> <http://qudt.org/vocab/quantitykind/MassAttenuationCoefficient>,
    <http://qudt.org/vocab/quantitykind/SpecificSurfaceArea>;
  <http://qudt.org/schema/qudt/iec61360Code> "0112/2///62720#UAB193";
  <http://qudt.org/schema/qudt/informativeReference> "https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAB193"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/symbol> "cm²/g";
  <http://qudt.org/schema/qudt/ucumCode> "cm2.g-1"^^<http://qudt.org/schema/qudt/UCUMcs>,
    "cm2/g"^^<http://qudt.org/schema/qudt/UCUMcs>;
  <http://qudt.org/schema/qudt/uneceCommonCode> "H15" .

<http://qudt.org/vocab/dimensionvector/A0E0L2I0M-1H0T0D0> a <http://qudt.org/schema/qudt/QuantityKindDimensionVector_SI>,
    <http://qudt.org/schema/qudt/QuantityKindDimensionVector_CGS>, <http://qudt.org/schema/qudt/QuantityKindDimensionVector_ISO>,
    <http://qudt.org/schema/qudt/QuantityKindDimensionVector_Imperial>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/dimensionvector>;
  rdfs:label "A0E0L2I0M-1H0T0D0";
  <http://qudt.org/schema/qudt/dimensionExponentForAmountOfSubstance> 0;
  <http://qudt.org/schema/qudt/dimensionExponentForElectricCurrent> 0;
  <http://qudt.org/schema/qudt/dimensionExponentForLength> 2;
  <http://qudt.org/schema/qudt/dimensionExponentForLuminousIntensity> 0;
  <http://qudt.org/schema/qudt/dimensionExponentForMass> -1;
  <http://qudt.org/schema/qudt/dimensionExponentForThermodynamicTemperature> 0;
  <http://qudt.org/schema/qudt/dimensionExponentForTime> 0;
  <http://qudt.org/schema/qudt/dimensionlessExponent> 0 .

<http://qudt.org/vocab/quantitykind/MassAttenuationCoefficient> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Mass Attenuation Coefficient"@en;
  rdfs:comment "Applicable units are those of quantitykind:MassAttenuationCoefficient";
  dct:description "\"Mass Attenuation Coefficient\" is a measurement of how strongly a chemical species or substance absorbs or scatters light at a given wavelength, per unit mass."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L2I0M-1H0T0D0>;
  <http://qudt.org/schema/qudt/iec61360Code> "0112/2///62720#UAD105";
  <http://qudt.org/schema/qudt/informativeReference> "http://en.wikipedia.org/wiki/Mass_attenuation_coefficient"^^xsd:anyURI,
    "https://cdd.iec.ch/cdd/iec61987/iec61987.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD105"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/isoNormativeReference> "http://www.iso.org/iso/catalogue_detail?csnumber=31895"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/plainTextDescription> "\"Mass Attenuation Coefficient\" is a measurement of how strongly a chemical species or substance absorbs or scatters light at a given wavelength, per unit mass.";
  <http://qudt.org/schema/qudt/latexSymbol> "$\\mu_m$"^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/latexDefinition> "$\\mu_m = \\frac{\\mu}{\\rho}$, where $\\mu$ is the linear attenuation coefficient and $\\rho$ is the mass density of the medium."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/applicableUnit> unit:CentiM2-PER-GM, unit:M2-PER-GM,
    unit:M2-PER-GM_DRY, unit:M2-PER-KiloGM .

<http://qudt.org/vocab/quantitykind/SpecificSurfaceArea> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Specific Surface Area"@en;
  rdfs:comment "Applicable units are those of quantitykind:SpecificSurfaceArea";
  dct:description "<strong>Specific surface area</strong> (<strong>SSA</strong>) is a property of solids defined as the total surface area (SA) of a material per unit mass, (with units of m<sup>2</sup>/kg or m<sup>2</sup>/g). It is a physical value that can be used to determine the type and properties of a material (e.g. soil or snow). It has a particular importance for adsorption, heterogeneous catalysis, and reactions on surfaces."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L2I0M-1H0T0D0>;
  <http://qudt.org/schema/qudt/informativeReference> "https://en.wikipedia.org/wiki/Specific_surface_area"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/plainTextDescription> "Specific surface area (SSA) is a property of solids defined as the total surface area (SA) of a material per unit mass, (with units of m²/kg or m²/g). It is a physical value that can be used to determine the type and properties of a material (e.g. soil or snow). It has a particular importance for adsorption, heterogeneous catalysis, and reactions on surfaces.";
  <http://qudt.org/schema/qudt/latexSymbol> "$SSA$"^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/latexDefinition> "$SSA = \\frac{SA}{\\m}$, where $SA$ is the surface area of an object and $\\m$ is the mass density of the object."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/applicableUnit> unit:CentiM2-PER-GM, unit:M2-PER-GM,
    unit:M2-PER-KiloGM .

unit:CentiM2-PER-SEC a <http://qudt.org/schema/qudt/Unit>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/unit>;
  rdfs:label "Square centimetres per second"@en;
  dct:description "0.0001-fold of the power of the SI base unit metre by exponent 2 divided by the SI base unit second";
  <http://qudt.org/schema/qudt/applicableSystem> <http://qudt.org/vocab/sou/CGS-EMU>,
    <http://qudt.org/vocab/sou/CGS-GAUSS>, <http://qudt.org/vocab/sou/SI>, <http://qudt.org/vocab/sou/CGS>;
  <http://qudt.org/schema/qudt/conversionMultiplier> 0.0001;
  <http://qudt.org/schema/qudt/conversionMultiplierSN> 1.0E-4;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L2I0M0H0T-1D0>;
  <http://qudt.org/schema/qudt/hasQuantityKind> <http://qudt.org/vocab/quantitykind/AreaPerTime>;
  <http://qudt.org/schema/qudt/iec61360Code> "0112/2///62720#UAB408";
  <http://qudt.org/schema/qudt/informativeReference> "https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAB408"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/symbol> "cm²/s";
  <http://qudt.org/schema/qudt/ucumCode> "cm2.s-1"^^<http://qudt.org/schema/qudt/UCUMcs>,
    "cm2/s"^^<http://qudt.org/schema/qudt/UCUMcs>;
  <http://qudt.org/schema/qudt/uneceCommonCode> "M81" .

<http://qudt.org/vocab/dimensionvector/A0E0L2I0M0H0T-1D0> a <http://qudt.org/schema/qudt/QuantityKindDimensionVector_SI>,
    <http://qudt.org/schema/qudt/QuantityKindDimensionVector_ISO>, <http://qudt.org/schema/qudt/QuantityKindDimensionVector_Imperial>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/dimensionvector>;
  rdfs:label "A0E0L2I0M0H0T-1D0";
  <http://qudt.org/schema/qudt/latexDefinition> "$L^2 T^-1$"^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/hasReferenceQuantityKind> <http://qudt.org/vocab/quantitykind/AreaPerTime>;
  <http://qudt.org/schema/qudt/dimensionExponentForAmountOfSubstance> 0;
  <http://qudt.org/schema/qudt/dimensionExponentForElectricCurrent> 0;
  <http://qudt.org/schema/qudt/dimensionExponentForLength> 2;
  <http://qudt.org/schema/qudt/dimensionExponentForLuminousIntensity> 0;
  <http://qudt.org/schema/qudt/dimensionExponentForMass> 0;
  <http://qudt.org/schema/qudt/dimensionExponentForThermodynamicTemperature> 0;
  <http://qudt.org/schema/qudt/dimensionExponentForTime> -1;
  <http://qudt.org/schema/qudt/dimensionlessExponent> 0 .

<http://qudt.org/vocab/quantitykind/AreaPerTime> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Area per Time"@en;
  rdfs:comment "Applicable units are those of quantitykind:AreaPerTime";
