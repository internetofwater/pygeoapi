quantitykind:AngularWavenumber a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "Kreisrepetenz"@de, "Kreisrepetenz"@de, "angular wavenumber"@en, "angular wavenumber"@en,
    "liczba falowa kątowa"@pl, "liczba falowa kątowa"@pl, "nombre d'onde angulaire"@fr,
    "nombre d'onde angulaire"@fr, "numero d'onda angolare"@it, "numero d'onda angolare"@it,
    "número de onda angular"@es, "número de onda angular"@es, "número de onda angular"@pt,
    "número de onda angular"@pt, "عدد موجى زاوى"@ar, "عدد موجى زاوى"@ar, "角波数"@ja, "角波数"@ja,
    "角波数"@zh, "角波数"@zh;
  rdfs:comment "Applicable units are those of quantitykind:AngularWavenumber", "Applicable units are those of quantitykind:AngularWavenumber";
  dct:description "\"wavenumber\" is the spatial frequency of a wave - the number of waves that exist over a specified distance. More formally, it is the reciprocal of the wavelength. It is also the magnitude of the wave vector."^^qudt:LatexString,
    "\"wavenumber\" is the spatial frequency of a wave - the number of waves that exist over a specified distance. More formally, it is the reciprocal of the wavelength. It is also the magnitude of the wave vector."^^qudt:LatexString;
  skos:altLabel "Kreiswellenzahl"@de, "Kreiswellenzahl"@de, "angular repetency"@en,
    "angular repetency"@en, "repetencja kątowa"@pl, "repetencja kątowa"@pl, "repetência angular"@pt,
    "repetência angular"@pt, "répétence angulaire"@fr, "répétence angulaire"@fr, "تكرار زاوى"@ar,
    "تكرار زاوى"@ar;
  skos:broader quantitykind:InverseLength, quantitykind:InverseLength;
  qudt:hasDimensionVector dimensionvector:A0E0L-1I0M0H0T0D0, dimensionvector:A0E0L-1I0M0H0T0D0;
  qudt:informativeReference "http://en.wikipedia.org/wiki/Wavenumber"^^xsd:anyURI, "http://en.wikipedia.org/wiki/Wavenumber"^^xsd:anyURI;
  qudt:symbol "k", "k";
  qudt:isoNormativeReference "http://www.iso.org/iso/catalogue_detail?csnumber=31897"^^xsd:anyURI,
    "http://www.iso.org/iso/catalogue_detail?csnumber=31897"^^xsd:anyURI;
  qudt:plainTextDescription "\"wavenumber\" is the spatial frequency of a wave - the number of waves that exist over a specified distance. More formally, it is the reciprocal of the wavelength. It is also the magnitude of the wave vector.",
    "\"wavenumber\" is the spatial frequency of a wave - the number of waves that exist over a specified distance. More formally, it is the reciprocal of the wavelength. It is also the magnitude of the wave vector.";
  qudt:latexDefinition """$k = \\frac{2\\pi}{\\lambda}= \\frac{2\\pi\\upsilon}{\\upsilon_p}=\\frac{\\omega}{\\upsilon_p}$, where $\\upsilon$ is the frequency of the wave, $\\lambda$ is the wavelength, $\\omega = 2\\pi \\upsilon$ is the angular frequency of the wave, and $\\upsilon_p$ is the phase velocity of the wave.

Alternatively:

$k = \\frac{p}{\\hbar}$, where $p$ is the linear momentum of quasi free electrons in an electron gas and $\\hbar$ is the reduced Planck constant ($h$ divided by $2\\pi$); for phonons, its magnitude is $k = \\frac{2\\pi}{\\lambda}$, where $\\lambda$ is the wavelength of the lattice vibrations."""^^qudt:LatexString,
    """$k = \\frac{2\\pi}{\\lambda}= \\frac{2\\pi\\upsilon}{\\upsilon_p}=\\frac{\\omega}{\\upsilon_p}$, where $\\upsilon$ is the frequency of the wave, $\\lambda$ is the wavelength, $\\omega = 2\\pi \\upsilon$ is the angular frequency of the wave, and $\\upsilon_p$ is the phase velocity of the wave.

Alternatively:

$k = \\frac{p}{\\hbar}$, where $p$ is the linear momentum of quasi free electrons in an electron gas and $\\hbar$ is the reduced Planck constant ($h$ divided by $2\\pi$); for phonons, its magnitude is $k = \\frac{2\\pi}{\\lambda}$, where $\\lambda$ is the wavelength of the lattice vibrations."""^^qudt:LatexString;
  <http://www.linkedmodel.org/schema/vaem#todo> "belongs to SOQ-ISO", "belongs to SOQ-ISO";
  qudt:applicableUnit unit:DEG-PER-M, unit:DEG-PER-M, unit:RAD-PER-M, unit:RAD-PER-M .

