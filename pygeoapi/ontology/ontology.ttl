<http://qudt.org/vocab/quantitykind/IonicStrength> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Ionic Strength"@en;
  rdfs:comment "Applicable units are those of quantitykind:IonicStrength";
  dct:description "The \"Ionic Strength\" of a solution is a measure of the concentration of ions in that solution."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A1E0L0I0M-1H0T0D0>;
  <http://qudt.org/schema/qudt/informativeReference> "http://en.wikipedia.org/wiki/Ionic_strength"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/symbol> "I";
  <http://qudt.org/schema/qudt/isoNormativeReference> "http://www.iso.org/iso/catalogue_detail?csnumber=31894"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/plainTextDescription> "The \"Ionic Strength\" of a solution is a measure of the concentration of ions in that solution.";
  <http://qudt.org/schema/qudt/latexDefinition> "$I = \\frac{1}{2} \\sum z_i^2 b_i$, where the summation is carried out over all ions with charge number $z_i$ and molality $m_i$."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/applicableUnit> unit:CentiMOL-PER-KiloGM, unit:KiloMOL-PER-KiloGM,
    unit:MOL-PER-KiloGM, unit:MOL_LB-PER-LB, unit:MicroMOL-PER-GM, unit:MilliMOL-PER-GM,
    unit:MilliMOL-PER-KiloGM, unit:NanoMOL-PER-GM .

<http://qudt.org/vocab/quantitykind/MolalityOfSolute> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Molality of Solute"@en;
  rdfs:comment "Applicable units are those of quantitykind:MolalityOfSolute";
  dct:description "The \"Molality of Solute\" of a solution is defined as the amount of substance of solute divided by the mass in kg of the solvent."^^<http://qudt.org/schema/qudt/LatexString>;
  skos:broader <http://qudt.org/vocab/quantitykind/AmountOfSubstancePerMass>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A1E0L0I0M-1H0T0D0>;
  <http://qudt.org/schema/qudt/informativeReference> "http://en.wikipedia.org/wiki/Molality"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/symbol> "b_B";
  <http://qudt.org/schema/qudt/isoNormativeReference> "http://www.iso.org/iso/catalogue_detail?csnumber=31894"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/plainTextDescription> "The \"Molality of Solute\" of a solution is defined as the amount of substance of solute divided by the mass in kg of the solvent.";
  <http://qudt.org/schema/qudt/latexDefinition> "$b_B = \\frac{n_B}{m_a}$, where $n_B$ is the amount of substance and $m_A$ is the mass."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/applicableUnit> unit:CentiMOL-PER-KiloGM, unit:KiloMOL-PER-KiloGM,
    unit:MOL-PER-KiloGM, unit:MOL_LB-PER-LB, unit:MicroMOL-PER-GM, unit:NanoMOL-PER-GM .

