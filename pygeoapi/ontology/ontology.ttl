quantitykind:AreicChargeDensityOrElectricFluxDensityOrElectricPolarization a qudt:QuantityKind,
    qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "areic charge density or electric flux density or electric polarization"@en-US,
    "areic charge density or electric flux density or electric polarization"@en-US;
  dct:description "charge Q presented on an area of size A divided by the area A or vector quantity obtained at a given point by adding the electric polarization P to the product of the electric field strength E and the electric constant (permittivity) ε₀"@en,
    "charge Q presented on an area of size A divided by the area A or vector quantity obtained at a given point by adding the electric polarization P to the product of the electric field strength E and the electric constant (permittivity) ε₀"@en;
  qudt:hasDimensionVector dimensionvector:A0E1L-2I0M0H0T1D0, dimensionvector:A0E1L-2I0M0H0T1D0;
  qudt:symbol "0173-1#Z4-BAJ320#002", "0173-1#Z4-BAJ320#002";
  qudt:plainTextDescription "auf einer Fläche mit dem Flächeninhalt A vorhandenen Ladung Q dividiert durch den Flächeninhalt A oder vektorielle Größe, die für einen gegebenen Punkt gleich der Summe der elektrischen Polarisation P und des Produkts aus der elektrischen Feldstärke E und der elektrischen Feldkonstante (Permittivität) ε₀ ist oder räumliche Dichte des elektrischen Moments molekularer Dipole"@de,
    "auf einer Fläche mit dem Flächeninhalt A vorhandenen Ladung Q dividiert durch den Flächeninhalt A oder vektorielle Größe, die für einen gegebenen Punkt gleich der Summe der elektrischen Polarisation P und des Produkts aus der elektrischen Feldstärke E und der elektrischen Feldkonstante (Permittivität) ε₀ ist oder räumliche Dichte des elektrischen Moments molekularer Dipole"@de .

