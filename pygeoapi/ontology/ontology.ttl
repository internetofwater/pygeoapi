quantitykind:Enthalpy a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:seeAlso quantitykind:InternalEnergy, quantitykind:InternalEnergy;
  rdfs:label "Entalpi"@ms, "Entalpi"@ms, "Entalpi"@tr, "Entalpi"@tr, "Entalpie"@ro,
    "Entalpie"@ro, "Enthalpie"@de, "Enthalpie"@de, "entalpia"@it, "entalpia"@it, "entalpia"@pl,
    "entalpia"@pl, "entalpia"@pt, "entalpia"@pt, "entalpie"@cs, "entalpie"@cs, "entalpija"@sl,
    "entalpija"@sl, "entalpía"@es, "entalpía"@es, "enthalpie"@fr, "enthalpie"@fr, "enthalpy"@en,
    "enthalpy"@en, "энтальпия"@ru, "энтальпия"@ru, "آنتالپی"@fa, "آنتالپی"@fa, "محتوى حراري"@ar,
    "محتوى حراري"@ar, "पूर्ण ऊष्मा"@hi, "पूर्ण ऊष्मा"@hi, "エンタルピー"@ja, "エンタルピー"@ja, "焓"@zh,
    "焓"@zh;
  rdfs:comment "Applicable units are those of quantitykind:Energy", "Applicable units are those of quantitykind:Energy";
  dct:description "In thermodynamics, $\\textit{enthalpy}$ is the sum of the internal energy $U$ and the product of pressure $p$ and volume $V$ of a system. The characteristic function (also known as thermodynamic potential) $\\textit{enthalpy}$ used to be called $\\textit{heat content}$, which is why it is conventionally indicated by $H$. The specific enthalpy of a working mass is a property of that mass used in thermodynamics, defined as $h=u+p \\cdot v$,  where $u$ is the specific internal energy, $p$ is the pressure, and $v$ is specific volume. In other words, $h = H / m$ where $m$ is the mass of the system. The SI unit for $\\textit{Specific Enthalpy}$ is $\\textit{joules per kilogram}$"^^qudt:LatexString,
    "In thermodynamics, $\\textit{enthalpy}$ is the sum of the internal energy $U$ and the product of pressure $p$ and volume $V$ of a system. The characteristic function (also known as thermodynamic potential) $\\textit{enthalpy}$ used to be called $\\textit{heat content}$, which is why it is conventionally indicated by $H$. The specific enthalpy of a working mass is a property of that mass used in thermodynamics, defined as $h=u+p \\cdot v$,  where $u$ is the specific internal energy, $p$ is the pressure, and $v$ is specific volume. In other words, $h = H / m$ where $m$ is the mass of the system. The SI unit for $\\textit{Specific Enthalpy}$ is $\\textit{joules per kilogram}$"^^qudt:LatexString;
  skos:broader quantitykind:Energy, quantitykind:Energy;
  qudt:dbpediaMatch "http://dbpedia.org/resource/Enthalpy"^^xsd:anyURI, "http://dbpedia.org/resource/Enthalpy"^^xsd:anyURI;
  qudt:hasDimensionVector dimensionvector:A0E0L2I0M1H0T-2D0, dimensionvector:A0E0L2I0M1H0T-2D0;
  qudt:informativeReference "http://en.citizendium.org/wiki/Enthalpy"^^xsd:anyURI, "http://en.citizendium.org/wiki/Enthalpy"^^xsd:anyURI,
    "http://en.wikipedia.org/wiki/Enthalpy"^^xsd:anyURI, "http://en.wikipedia.org/wiki/Enthalpy"^^xsd:anyURI;
  qudt:symbol "H", "H";
  qudt:latexDefinition "$H = U + pV$, where $U$ is internal energy, $p$ is pressure and $V$ is volume."^^qudt:LatexString,
    "$H = U + pV$, where $U$ is internal energy, $p$ is pressure and $V$ is volume."^^qudt:LatexString;
