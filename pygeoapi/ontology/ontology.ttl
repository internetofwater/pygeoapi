variablename:orthoclase a skos:Concept;
  skos:definition "Orthoclase, or orthoclase feldspar (endmember formula KAlSi3O8), is an important tectosilicate mineral which forms igneous rock. The name is from the Ancient Greek for \"straight fracture,\" because its two cleavage planes are at right angles to each other. It is a type of potassium feldspar, also known as K-feldspar. The gem known as moonstone (see below) is largely composed of orthoclase.";
  skos:topConceptOf <http://vocabulary.odm2.org/variablename>;
  skos:prefLabel "Orthoclase";
  skos:note "Added to support Critical Zone Observatory (CZO) data use cases. ";
  skos:historyNote "Wikipedia";
  skos:exactMatch "https://en.wikipedia.org/wiki/Orthoclase" .

