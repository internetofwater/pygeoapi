    "http://www.efunda.com/glossary/units/units--pressure--poundal_per_square_foot.cfm"^^xsd:anyURI,
    "https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAB243"^^xsd:anyURI,
