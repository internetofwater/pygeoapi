unit:GRAY a qudt:DerivedUnit,
        qudt:Unit ;
    rdfs:label "جراي; غراي"@ar,
        "Грей"@bg,
        "грей"@bg,
        "Gray"@cs,
        "gray"@cs,
        "Gray"@de,
