quantitykind:DisplacementCurrent a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:seeAlso quantitykind:ElectricFluxDensity, quantitykind:ElectricFluxDensity;
  rdfs:label "Displacement Current"@en, "Displacement Current"@en;
  rdfs:comment "Applicable units are those of quantitykind:DisplacementCurrent", "Applicable units are those of quantitykind:DisplacementCurrent";
  dct:description "\"Displacement Current\" is a quantity appearing in Maxwell's equations that is defined in terms of the rate of change of electric displacement field. Displacement current has the units of electric current density, and it has an associated magnetic field just as actual currents do. However it is not an electric current of moving charges, but a time-varying electric field. In materials, there is also a contribution from the slight motion of charges bound in atoms, dielectric polarization."^^qudt:LatexString,
    "\"Displacement Current\" is a quantity appearing in Maxwell's equations that is defined in terms of the rate of change of electric displacement field. Displacement current has the units of electric current density, and it has an associated magnetic field just as actual currents do. However it is not an electric current of moving charges, but a time-varying electric field. In materials, there is also a contribution from the slight motion of charges bound in atoms, dielectric polarization."^^qudt:LatexString;
  qudt:hasDimensionVector dimensionvector:A0E1L0I0M0H0T0D0, dimensionvector:A0E1L0I0M0H0T0D0;
  qudt:informativeReference "http://www.iso.org/iso/home/store/catalogue_tc/catalogue_detail.htm?csnumber=31891"^^xsd:anyURI,
    "http://www.iso.org/iso/home/store/catalogue_tc/catalogue_detail.htm?csnumber=31891"^^xsd:anyURI,
    "http://en.wikipedia.org/wiki/Displacement_current"^^xsd:anyURI, "http://en.wikipedia.org/wiki/Displacement_current"^^xsd:anyURI;
  qudt:symbol "I_D", "I_D";
  qudt:plainTextDescription "\"Displacement Current\" is a quantity appearing in Maxwell's equations that is defined in terms of the rate of change of electric displacement field. Displacement current has the units of electric current density, and it has an associated magnetic field just as actual currents do. However it is not an electric current of moving charges, but a time-varying electric field. In materials, there is also a contribution from the slight motion of charges bound in atoms, dielectric polarization.",
    "\"Displacement Current\" is a quantity appearing in Maxwell's equations that is defined in terms of the rate of change of electric displacement field. Displacement current has the units of electric current density, and it has an associated magnetic field just as actual currents do. However it is not an electric current of moving charges, but a time-varying electric field. In materials, there is also a contribution from the slight motion of charges bound in atoms, dielectric polarization.";
  qudt:latexDefinition "$I_D= \\int_S J_D \\cdot e_n dA$, over a surface $S$, where $J_D$ is displacement current density and $e_n dA$ is the vector surface element."^^qudt:LatexString,
    "$I_D= \\int_S J_D \\cdot e_n dA$, over a surface $S$, where $J_D$ is displacement current density and $e_n dA$ is the vector surface element."^^qudt:LatexString;
  qudt:applicableUnit unit:A, unit:A, unit:AttoA, unit:AttoA, unit:FemtoA, unit:FemtoA,
    unit:GigaA, unit:GigaA, unit:PetaA, unit:PetaA, unit:TeraA, unit:TeraA .

quantitykind:ElectricCurrent a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "Arus elektrik"@ms, "Arus elektrik"@ms, "Elektrický proud"@cs, "Elektrický proud"@cs,
    "corrente elettrica"@it, "corrente elettrica"@it, "corrente elétrica"@pt, "corrente elétrica"@pt,
    "corriente eléctrica"@es, "corriente eléctrica"@es, "curent electric"@ro, "curent electric"@ro,
    "electric current"@en, "electric current"@en, "elektrik akımı"@tr, "elektrik akımı"@tr,
    "elektrische Stromstärke"@de, "elektrische Stromstärke"@de, "električni tok"@sl, "električni tok"@sl,
    "elektromos áramerősség"@hu, "elektromos áramerősség"@hu, "fluxio electrica"@la, "fluxio electrica"@la,
    "intensité de courant électrique"@fr, "intensité de courant électrique"@fr, "prąd elektryczny"@pl,
    "prąd elektryczny"@pl, "Ένταση ηλεκτρικού ρεύματος"@el, "Ένταση ηλεκτρικού ρεύματος"@el,
    "Електрически ток"@bg, "Електрически ток"@bg, "Сила электрического тока"@ru, "Сила электрического тока"@ru,
    "זרם חשמלי"@he, "זרם חשמלי"@he, "تيار كهربائي"@ar, "تيار كهربائي"@ar, "جریان الکتریکی"@fa,
    "جریان الکتریکی"@fa, "विद्युत धारा"@hi, "विद्युत धारा"@hi, "电流"@zh, "电流"@zh, "電流"@ja,
    "電流"@ja;
  rdfs:comment "Applicable units are those of quantitykind:ElectricCurrent", "Applicable units are those of quantitykind:ElectricCurrent";
  dct:description """
  The quantity kind $\\textit{Electric Current}$ is the flow (movement) of electric charge. 
  The amount of electric current through some surface, for example, a section through a copper conductor,
   is defined as the amount of electric charge flowing through that surface over time. 
  Current is a scalar-valued quantity. 
  Electric current is one of the base quantities in the International System of Quantities, ISQ,
   on which the International System of Units, SI, is based.
  """^^rdf:HTML,
    """
  The quantity kind $\\textit{Electric Current}$ is the flow (movement) of electric charge. 
  The amount of electric current through some surface, for example, a section through a copper conductor,
   is defined as the amount of electric charge flowing through that surface over time. 
  Current is a scalar-valued quantity. 
  Electric current is one of the base quantities in the International System of Quantities, ISQ,
   on which the International System of Units, SI, is based.
  """^^rdf:HTML;
  qudt:dbpediaMatch "http://dbpedia.org/resource/Electric_current"^^xsd:anyURI, "http://dbpedia.org/resource/Electric_current"^^xsd:anyURI;
  qudt:hasDimensionVector dimensionvector:A0E1L0I0M0H0T0D0, dimensionvector:A0E1L0I0M0H0T0D0;
  qudt:iec61360Code "0112/2///62720#UAD039", "0112/2///62720#UAD039";
  qudt:informativeReference "http://www.iso.org/iso/home/store/catalogue_tc/catalogue_detail.htm?csnumber=31891"^^xsd:anyURI,
    "http://www.iso.org/iso/home/store/catalogue_tc/catalogue_detail.htm?csnumber=31891"^^xsd:anyURI,
    "https://cdd.iec.ch/cdd/iec61987/iec61987.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD039"^^xsd:anyURI,
    "https://cdd.iec.ch/cdd/iec61987/iec61987.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD039"^^xsd:anyURI;
  qudt:siExactMatch <https://si-digital-framework.org/SI/quantities/ELCU>, <https://si-digital-framework.org/quantities/ELCU>;
  qudt:symbol "I", "I";
  qudt:plainTextDescription "\"Electric Current\" is the flow (movement) of electric charge. The amount of electric current through some surface, for example, a section through a copper conductor, is defined as the amount of electric charge flowing through that surface over time. Current is a scalar-valued quantity. Electric current is one of the base quantities in the International System of Quantities, ISQ, on which the International System of Units, SI, is based. ",
    "\"Electric Current\" is the flow (movement) of electric charge. The amount of electric current through some surface, for example, a section through a copper conductor, is defined as the amount of electric charge flowing through that surface over time. Current is a scalar-valued quantity. Electric current is one of the base quantities in the International System of Quantities, ISQ, on which the International System of Units, SI, is based. ";
  qudt:applicableUnit unit:A, unit:A, unit:A_Ab, unit:A_Ab, unit:BIOT, unit:BIOT, unit:A_Stat,
    unit:A_Stat, unit:AttoA, unit:AttoA, unit:FemtoA, unit:FemtoA, unit:GigaA, unit:GigaA,
    unit:KiloA, unit:KiloA, unit:MegaA, unit:MegaA, unit:MicroA, unit:MicroA, unit:MilliA,
    unit:MilliA, unit:NanoA, unit:NanoA, unit:PetaA, unit:PetaA, unit:PicoA, unit:PicoA,
    unit:PlanckCurrent, unit:PlanckCurrent, unit:TeraA, unit:TeraA .

quantitykind:ElectricCurrentPhasor a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "Electric Current Phasor"@en, "Electric Current Phasor"@en;
  rdfs:comment "Applicable units are those of quantitykind:ElectricCurrentPhasor", "Applicable units are those of quantitykind:ElectricCurrentPhasor";
  dct:description "\"Electric Current Phasor\" is a representation of current as a sinusoidal integral quantity using a complex quantity whose argument is equal to the initial phase and whose modulus is equal to the root-mean-square value. A phasor is a constant complex number, usually expressed in exponential form, representing the complex amplitude (magnitude and phase) of a sinusoidal function of time. Phasors are used by electrical engineers to simplify computations involving sinusoids, where they can often reduce a differential equation problem to an algebraic one."^^qudt:LatexString,
    "\"Electric Current Phasor\" is a representation of current as a sinusoidal integral quantity using a complex quantity whose argument is equal to the initial phase and whose modulus is equal to the root-mean-square value. A phasor is a constant complex number, usually expressed in exponential form, representing the complex amplitude (magnitude and phase) of a sinusoidal function of time. Phasors are used by electrical engineers to simplify computations involving sinusoids, where they can often reduce a differential equation problem to an algebraic one."^^qudt:LatexString;
  qudt:hasDimensionVector dimensionvector:A0E1L0I0M0H0T0D0, dimensionvector:A0E1L0I0M0H0T0D0;
  qudt:informativeReference "http://www.iso.org/iso/home/store/catalogue_tc/catalogue_detail.htm?csnumber=31891"^^xsd:anyURI,
    "http://www.iso.org/iso/home/store/catalogue_tc/catalogue_detail.htm?csnumber=31891"^^xsd:anyURI,
    "http://en.wikipedia.org/wiki/Phasor_(electronics)"^^xsd:anyURI, "http://en.wikipedia.org/wiki/Phasor_(electronics)"^^xsd:anyURI,
    "http://www.electropedia.org/iev/iev.nsf/display?openform&ievref=131-11-26"^^xsd:anyURI,
    "http://www.electropedia.org/iev/iev.nsf/display?openform&ievref=131-11-26"^^xsd:anyURI;
  qudt:plainTextDescription "\"Electric Current Phasor\" is a representation of current as a sinusoidal integral quantity using a complex quantity whose argument is equal to the initial phase and whose modulus is equal to the root-mean-square value. A phasor is a constant complex number, usually expressed in exponential form, representing the complex amplitude (magnitude and phase) of a sinusoidal function of time. Phasors are used by electrical engineers to simplify computations involving sinusoids, where they can often reduce a differential equation problem to an algebraic one.",
    "\"Electric Current Phasor\" is a representation of current as a sinusoidal integral quantity using a complex quantity whose argument is equal to the initial phase and whose modulus is equal to the root-mean-square value. A phasor is a constant complex number, usually expressed in exponential form, representing the complex amplitude (magnitude and phase) of a sinusoidal function of time. Phasors are used by electrical engineers to simplify computations involving sinusoids, where they can often reduce a differential equation problem to an algebraic one.";
  qudt:latexSymbol "$\\underline{I}$"^^qudt:LatexString, "$\\underline{I}$"^^qudt:LatexString;
  qudt:latexDefinition "When $i = \\hat{I} \\cos{(\\omega t + \\alpha)}$, where $i$ is the electric current, $\\omega$ is angular frequence, $t$ is time, and $\\alpha$ is initial phase, then $\\underline{I} = Ie^{ja}$."^^qudt:LatexString,
    "When $i = \\hat{I} \\cos{(\\omega t + \\alpha)}$, where $i$ is the electric current, $\\omega$ is angular frequence, $t$ is time, and $\\alpha$ is initial phase, then $\\underline{I} = Ie^{ja}$."^^qudt:LatexString;
  qudt:applicableUnit unit:A, unit:A, unit:AttoA, unit:AttoA, unit:FemtoA, unit:FemtoA,
    unit:GigaA, unit:GigaA, unit:PetaA, unit:PetaA, unit:TeraA, unit:TeraA .

quantitykind:MagneticTension a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:seeAlso quantitykind:MagneticFieldStrength_H, quantitykind:MagneticFieldStrength_H;
  rdfs:label "Magnetic Tension"@en, "Magnetic Tension"@en;
  rdfs:comment "Applicable units are those of quantitykind:MagneticTension", "Applicable units are those of quantitykind:MagneticTension";
  dct:description "\"Magnetic Tension\" is a scalar quantity equal to the line integral of the magnetic field strength $\\mathbf{H}$ along a specified path linking two points a and b."^^qudt:LatexString,
    "\"Magnetic Tension\" is a scalar quantity equal to the line integral of the magnetic field strength $\\mathbf{H}$ along a specified path linking two points a and b."^^qudt:LatexString;
  qudt:hasDimensionVector dimensionvector:A0E1L0I0M0H0T0D0, dimensionvector:A0E1L0I0M0H0T0D0;
  qudt:informativeReference "http://www.iso.org/iso/home/store/catalogue_tc/catalogue_detail.htm?csnumber=31891"^^xsd:anyURI,
    "http://www.iso.org/iso/home/store/catalogue_tc/catalogue_detail.htm?csnumber=31891"^^xsd:anyURI,
    "http://www.electropedia.org/iev/iev.nsf/display?openform&ievref=121-11-57"^^xsd:anyURI,
    "http://www.electropedia.org/iev/iev.nsf/display?openform&ievref=121-11-57"^^xsd:anyURI;
  qudt:symbol "U_m", "U_m";
  qudt:plainTextDescription "Magnetic Tension is a scalar quantity equal to the line integral of the magnetic field strength H along a specified path linking two points a and b.",
    "Magnetic Tension is a scalar quantity equal to the line integral of the magnetic field strength H along a specified path linking two points a and b.";
  qudt:latexDefinition "$U_m = \\int_{r_a(C)}^{r_b} \\mathbf{H} \\cdot dr$, where $\\mathbf{H}$ is magnetic field strength and $r$ is the position vector along a given curve $C$ from point $a$ to point $b$."^^qudt:LatexString,
    "$U_m = \\int_{r_a(C)}^{r_b} \\mathbf{H} \\cdot dr$, where $\\mathbf{H}$ is magnetic field strength and $r$ is the position vector along a given curve $C$ from point $a$ to point $b$."^^qudt:LatexString;
  qudt:applicableUnit unit:A, unit:A, unit:AttoA, unit:AttoA, unit:FemtoA, unit:FemtoA,
    unit:GigaA, unit:GigaA, unit:PetaA, unit:PetaA, unit:TeraA, unit:TeraA .

quantitykind:MagnetomotiveForce a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:seeAlso quantitykind:MagneticFieldStrength_H, quantitykind:MagneticFieldStrength_H;
  rdfs:label "Magnetomotive Force"@en, "Magnetomotive Force"@en;
  rdfs:comment "Applicable units are those of quantitykind:MagnetomotiveForce", "Applicable units are those of quantitykind:MagnetomotiveForce";
  dct:description """
$\\text{Magnetomotive Force}$, also referred to as ($mmf$), is the ability of an electric circuit to produce magnetic flux. 
  Just as the ability of a battery to produce electric current is called its electromotive force 
  or emf, mmf is taken as the work required to move a unit magnet pole from any point through any path 
  which links the electric circuit back the same point in the presence of the magnetic force produced 
  by the electric current in the circuit. 
$\\text{Magnetomotive Force}$ is the scalar line integral of the magnetic field strength along a closed path.
  """^^qudt:LatexString,
    """
$\\text{Magnetomotive Force}$, also referred to as ($mmf$), is the ability of an electric circuit to produce magnetic flux. 
  Just as the ability of a battery to produce electric current is called its electromotive force 
  or emf, mmf is taken as the work required to move a unit magnet pole from any point through any path 
  which links the electric circuit back the same point in the presence of the magnetic force produced 
  by the electric current in the circuit. 
$\\text{Magnetomotive Force}$ is the scalar line integral of the magnetic field strength along a closed path.
  """^^qudt:LatexString;
  qudt:dbpediaMatch "http://dbpedia.org/resource/Magnetomotive_force"^^xsd:anyURI, "http://dbpedia.org/resource/Magnetomotive_force"^^xsd:anyURI;
  qudt:hasDimensionVector dimensionvector:A0E1L0I0M0H0T0D0, dimensionvector:A0E1L0I0M0H0T0D0;
  qudt:informativeReference "http://www.iso.org/iso/home/store/catalogue_tc/catalogue_detail.htm?csnumber=31891"^^xsd:anyURI,
    "http://www.iso.org/iso/home/store/catalogue_tc/catalogue_detail.htm?csnumber=31891"^^xsd:anyURI,
    "http://www.electropedia.org/iev/iev.nsf/display?openform&ievref=121-11-60"^^xsd:anyURI,
    "http://www.electropedia.org/iev/iev.nsf/display?openform&ievref=121-11-60"^^xsd:anyURI;
  qudt:latexSymbol "$F_m $"^^qudt:LatexString, "$F_m $"^^qudt:LatexString;
  qudt:latexDefinition "$F_m = \\oint \\mathbf{H} \\cdot dr$, where $\\mathbf{H}$ is magnetic field strength and $r$ is position vector along a given curve $C$ from point $a$ to point $b$."^^qudt:LatexString,
    "$F_m = \\oint \\mathbf{H} \\cdot dr$, where $\\mathbf{H}$ is magnetic field strength and $r$ is position vector along a given curve $C$ from point $a$ to point $b$."^^qudt:LatexString;
  qudt:applicableUnit unit:A, unit:A, unit:AT, unit:AT, unit:AttoA, unit:AttoA, unit:FemtoA,
    unit:FemtoA, unit:GI, unit:GI, unit:GigaA, unit:GigaA, unit:OERSTED-CentiM, unit:OERSTED-CentiM,
    unit:PetaA, unit:PetaA, unit:TeraA, unit:TeraA .

quantitykind:TotalCurrent a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:seeAlso quantitykind:DisplacementCurrent, quantitykind:DisplacementCurrent, quantitykind:ElectricCurrent,
    quantitykind:ElectricCurrent;
  rdfs:label "Total Current"@en, "Total Current"@en;
  rdfs:comment "Applicable units are those of quantitykind:TotalCurrent", "Applicable units are those of quantitykind:TotalCurrent";
  dct:description "\"Total Current\" is the sum of the electric current that is flowing through a surface and the displacement current."^^qudt:LatexString,
    "\"Total Current\" is the sum of the electric current that is flowing through a surface and the displacement current."^^qudt:LatexString;
  qudt:hasDimensionVector dimensionvector:A0E1L0I0M0H0T0D0, dimensionvector:A0E1L0I0M0H0T0D0;
  qudt:informativeReference "http://www.iso.org/iso/home/store/catalogue_tc/catalogue_detail.htm?csnumber=31891"^^xsd:anyURI,
    "http://www.iso.org/iso/home/store/catalogue_tc/catalogue_detail.htm?csnumber=31891"^^xsd:anyURI;
  qudt:symbol "I_{tot}", "I_{tot}";
  qudt:plainTextDescription "\"Total Current\" is the sum of the electric current that is flowing through a surface and the displacement current.",
    "\"Total Current\" is the sum of the electric current that is flowing through a surface and the displacement current.";
  qudt:latexDefinition "$I_{tot}= I + I_D$, where $I$ is electric current and $I_D$ is displacement current."^^qudt:LatexString,
