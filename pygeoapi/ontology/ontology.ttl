  rdfs:label "Degree Celsius Centimeter"@en-US, "Degree Celsius Centimetre"@en;
  dct:description "$\\textit{Degree Celsius Centimeter}$ is a C.G.S System unit for 'Length Temperature' expressed as $cm-degC$."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/applicableSystem> <http://qudt.org/vocab/sou/SI>, <http://qudt.org/vocab/sou/CGS>;
