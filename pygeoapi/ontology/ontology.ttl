unit:M3-PER-SEC2 a <http://qudt.org/schema/qudt/Unit>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/unit>;
  rdfs:label "Cubic Meter per Square Second"@en-US, "Cubic Metre per Square Second"@en;
