unit:GM-PER-MilliM2 a <http://qudt.org/schema/qudt/Unit>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/unit>;
  rdfs:label "gram per square millimetre";
  dct:description "0.001-fold of the SI base unit kilogram divided by the 0.000001-fold of the power of the SI base unit meter by exponent 2";
  <http://qudt.org/schema/qudt/conversionMultiplier> 1000.0;
