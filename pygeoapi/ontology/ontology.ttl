    skos:topConceptOf <http://vocabulary.odm2.org/variablename> .

variablename:fluorescenceXRay a skos:Concept ;
    skos:definition "X-ray fluorescence (XRF) is the emission of characteristic \"secondary\" (or fluorescent) X-rays from a material that has been excited by bombarding with high-energy X-rays or gamma rays." ;
    skos:exactMatch "https://en.wikipedia.org/wiki/X-ray_fluorescence" ;
    skos:historyNote "Wikipedia" ;
    skos:inScheme <http://vocabulary.odm2.org/variablename> ;
    skos:note "Added to support Critical Zone Observatory (CZO) data use cases. " ;
    skos:prefLabel "Fluorescence, X-ray (XRF)" ;
    skos:topConceptOf <http://vocabulary.odm2.org/variablename> .

