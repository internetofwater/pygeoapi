quantitykind:ElectromagneticEnergyDensity a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:seeAlso quantitykind:MagneticFieldStrength_H, quantitykind:MagneticFieldStrength_H,
    quantitykind:MagneticFluxDensity, quantitykind:MagneticFluxDensity, quantitykind:ElectricFieldStrength,
    quantitykind:ElectricFieldStrength, quantitykind:ElectricFluxDensity, quantitykind:ElectricFluxDensity;
  rdfs:label "Electromagnetic Energy Density"@en, "Electromagnetic Energy Density"@en;
  rdfs:comment "Applicable units are those of quantitykind:ElectromagneticEnergyDensity",
    "Applicable units are those of quantitykind:ElectromagneticEnergyDensity";
  dct:description """
$\\textit{Electromagnetic Energy Density}$, also known as the $\\color{indigo} {\\text{Volumic Electromagnetic Energy}}$, is the energy associated with an electromagnetic field, per unit volume of the field.
  """^^qudt:LatexString,
    """
$\\textit{Electromagnetic Energy Density}$, also known as the $\\color{indigo} {\\text{Volumic Electromagnetic Energy}}$, is the energy associated with an electromagnetic field, per unit volume of the field.
  """^^qudt:LatexString;
  qudt:hasDimensionVector dimensionvector:A0E0L-1I0M1H0T-2D0, dimensionvector:A0E0L-1I0M1H0T-2D0;
  qudt:informativeReference "http://www.iso.org/iso/home/store/catalogue_tc/catalogue_detail.htm?csnumber=31891"^^xsd:anyURI,
    "http://www.iso.org/iso/home/store/catalogue_tc/catalogue_detail.htm?csnumber=31891"^^xsd:anyURI,
    "http://www.electropedia.org/iev/iev.nsf/display?openform&ievref=121-11-64"^^xsd:anyURI,
    "http://www.electropedia.org/iev/iev.nsf/display?openform&ievref=121-11-64"^^xsd:anyURI;
  qudt:symbol "w", "w";
  qudt:exactMatch quantitykind:VolumicElectromagneticEnergy, quantitykind:VolumicElectromagneticEnergy;
  qudt:latexDefinition "$w = (1/2) ( \\mathbf{E} \\cdot \\mathbf{D} + \\mathbf{B} \\cdot \\mathbf{H})$, where $\\mathbf{E}$ is electric field strength, $\\mathbf{D}$ is electric flux density, $\\mathbf{M}$ is magnetic flux density, and $\\mathbf{H}$ is magnetic field strength."^^qudt:LatexString,
    "$w = (1/2) ( \\mathbf{E} \\cdot \\mathbf{D} + \\mathbf{B} \\cdot \\mathbf{H})$, where $\\mathbf{E}$ is electric field strength, $\\mathbf{D}$ is electric flux density, $\\mathbf{M}$ is magnetic flux density, and $\\mathbf{H}$ is magnetic field strength."^^qudt:LatexString;
  qudt:applicableUnit unit:J-PER-M3, unit:J-PER-M3 .

quantitykind:RadiantEnergyDensity a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "Radiant Energy Density"@en, "Radiant Energy Density"@en;
  rdfs:comment "Applicable units are those of quantitykind:RadiantEnergyDensity", "Applicable units are those of quantitykind:RadiantEnergyDensity";
  dct:description "\"Radiant Energy Density\", or radiant power, is the radiant energy per unit volume."^^qudt:LatexString,
    "\"Radiant Energy Density\", or radiant power, is the radiant energy per unit volume."^^qudt:LatexString;
  qudt:hasDimensionVector dimensionvector:A0E0L-1I0M1H0T-2D0, dimensionvector:A0E0L-1I0M1H0T-2D0;
  qudt:informativeReference "http://en.wikipedia.org/wiki/Radiant_energy_density"^^xsd:anyURI,
    "http://en.wikipedia.org/wiki/Radiant_energy_density"^^xsd:anyURI;
  qudt:isoNormativeReference "http://www.iso.org/iso/catalogue_detail?csnumber=31892"^^xsd:anyURI,
    "http://www.iso.org/iso/catalogue_detail?csnumber=31892"^^xsd:anyURI;
  qudt:plainTextDescription "\"Radiant Energy Density\", or radiant power, is the radiant energy per unit volume.",
    "\"Radiant Energy Density\", or radiant power, is the radiant energy per unit volume.";
  qudt:latexSymbol "$w, \\rho$"^^qudt:LatexString, "$w, \\rho$"^^qudt:LatexString;
  qudt:latexDefinition "$w$, $\\rho = \\frac{dQ}{dV}$, where $dQ$ is the radiant energy in an elementary three-dimensional domain, and $dV$ is the volume."^^qudt:LatexString,
    "$w$, $\\rho = \\frac{dQ}{dV}$, where $dQ$ is the radiant energy in an elementary three-dimensional domain, and $dV$ is the volume."^^qudt:LatexString;
  qudt:applicableUnit unit:J-PER-M3, unit:J-PER-M3 .

