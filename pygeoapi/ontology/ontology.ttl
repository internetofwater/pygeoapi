  <http://qudt.org/schema/qudt/hasQuantityKind> <http://qudt.org/vocab/quantitykind/Area>;
  <http://qudt.org/schema/qudt/iec61360Code> "0112/2///62720#UAD931";
  <http://qudt.org/schema/qudt/informativeReference> "https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAD931"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/symbol> "kcmil" .

