dct:extent a rdf:Property, rdf:Property;
  rdfs:isDefinedBy <http://purl.org/dc/terms/>, <http://purl.org/dc/terms/>;
  rdfs:label "Extent"@en, "Extent"@en;
  rdfs:comment "The size or duration of the resource."@en, "The size or duration of the resource."@en;
  rdfs:subPropertyOf dc:format, dc:format, dct:format, dct:format;
  dct:description "Recommended practice is to specify the file size in megabytes and duration in ISO 8601 format."@en,
    "Recommended practice is to specify the file size in megabytes and duration in ISO 8601 format."@en;
  dct:issued "2000-07-11"^^xsd:date, "2000-07-11"^^xsd:date;
  <http://purl.org/dc/dcam/rangeIncludes> dct:SizeOrDuration, dct:SizeOrDuration .

dct:format a rdf:Property, rdf:Property;
  rdfs:isDefinedBy <http://purl.org/dc/terms/>, <http://purl.org/dc/terms/>;
  rdfs:label "Format"@en, "Format"@en;
  rdfs:comment "The file format, physical medium, or dimensions of the resource."@en,
    "The file format, physical medium, or dimensions of the resource."@en;
  rdfs:subPropertyOf dc:format, dc:format;
  dct:description "Recommended practice is to use a controlled vocabulary where available. For example, for file formats one could use the list of Internet Media Types [[MIME](https://www.iana.org/assignments/media-types/media-types.xhtml)].  Examples of dimensions include size and duration."@en,
    "Recommended practice is to use a controlled vocabulary where available. For example, for file formats one could use the list of Internet Media Types [[MIME](https://www.iana.org/assignments/media-types/media-types.xhtml)].  Examples of dimensions include size and duration."@en;
  dct:issued "2008-01-14"^^xsd:date, "2008-01-14"^^xsd:date;
  <http://purl.org/dc/dcam/rangeIncludes> dct:MediaType, dct:MediaType, dct:Extent,
    dct:Extent .

dct:hasFormat a rdf:Property, rdf:Property;
  rdfs:isDefinedBy <http://purl.org/dc/terms/>, <http://purl.org/dc/terms/>;
  rdfs:label "Has Format"@en, "Has Format"@en;
  rdfs:comment "A related resource that is substantially the same as the pre-existing described resource, but in another format."@en,
    "A related resource that is substantially the same as the pre-existing described resource, but in another format."@en;
  rdfs:subPropertyOf dc:relation, dc:relation, dct:relation, dct:relation;
  dct:description "This property is intended to be used with non-literal values. This property is an inverse property of Is Format Of."@en,
    "This property is intended to be used with non-literal values. This property is an inverse property of Is Format Of."@en;
  dct:issued "2000-07-11"^^xsd:date, "2000-07-11"^^xsd:date .

dct:hasPart a rdf:Property, rdf:Property;
