  qudt:dbpediaMatch "http://dbpedia.org/resource/Planck_momentum"^^xsd:anyURI, "http://dbpedia.org/resource/Planck_momentum"^^xsd:anyURI;
  qudt:hasDimensionVector dimensionvector:A0E0L1I0M1H0T-1D0, dimensionvector:A0E0L1I0M1H0T-1D0;
  qudt:hasQuantityKind quantitykind:LinearMomentum, quantitykind:LinearMomentum, quantitykind:Momentum,
