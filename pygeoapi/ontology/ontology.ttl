  dct:description "\"Gravity\" is a unit for  'Linear Acceleration' expressed as $G$."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/conversionMultiplier> 9.80665;
  <http://qudt.org/schema/qudt/conversionMultiplierSN> 9.80665E0;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L1I0M0H0T-2D0>;
  <http://qudt.org/schema/qudt/hasQuantityKind> <http://qudt.org/vocab/quantitykind/Acceleration>,
