  <http://qudt.org/schema/qudt/plainTextDescription> "\"Visible Radiant Energy\", also known as luminous energy, is the energy of electromagnetic waves. It is energy of the particles that are emitted, transferred, or received as radiation.";
  <http://qudt.org/schema/qudt/latexDefinition> "Q"^^<http://qudt.org/schema/qudt/LatexString>;
