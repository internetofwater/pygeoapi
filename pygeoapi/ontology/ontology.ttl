quantitykind:NuclearQuadrupoleMoment a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "Nuclear Quadrupole Moment"@en, "Nuclear Quadrupole Moment"@en;
  rdfs:comment "Applicable units are those of quantitykind:NuclearQuadrupoleMoment",
    "Applicable units are those of quantitykind:NuclearQuadrupoleMoment";
  dct:description "\"Nuclear Quadrupole Moment\" is a quantity that characterizes the deviation from spherical symmetry of the electrical charge distribution in an atomic nucleus."^^qudt:LatexString,
    "\"Nuclear Quadrupole Moment\" is a quantity that characterizes the deviation from spherical symmetry of the electrical charge distribution in an atomic nucleus."^^qudt:LatexString;
  qudt:hasDimensionVector dimensionvector:A0E0L2I0M0H0T0D0, dimensionvector:A0E0L2I0M0H0T0D0;
  qudt:informativeReference "http://en.wikipedia.org/wiki/Nuclear_quadrupole_resonance"^^xsd:anyURI,
    "http://en.wikipedia.org/wiki/Nuclear_quadrupole_resonance"^^xsd:anyURI;
  qudt:symbol "Q", "Q";
  qudt:isoNormativeReference "http://www.iso.org/iso/catalogue_detail?csnumber=31895"^^xsd:anyURI,
    "http://www.iso.org/iso/catalogue_detail?csnumber=31895"^^xsd:anyURI;
  qudt:plainTextDescription "\"Nuclear Quadrupole Moment\" is a quantity that characterizes the deviation from spherical symmetry of the electrical charge distribution in an atomic nucleus.",
    "\"Nuclear Quadrupole Moment\" is a quantity that characterizes the deviation from spherical symmetry of the electrical charge distribution in an atomic nucleus.";
  qudt:latexDefinition "$Q = (\\frac{1}{e}) \\int (3z^2 - r^2)\\rho(x, y, z)dV$, in the quantum state with the nuclear spin in the field direction $(z)$, where $\\rho(x, y, z)$ is the nuclear electric charge density, $e$ is the elementary charge, $r^2 = x^2 + y^2 + z^2$, and $dV$ is the volume element $dx$ $dy$ $dz$."^^qudt:LatexString,
    "$Q = (\\frac{1}{e}) \\int (3z^2 - r^2)\\rho(x, y, z)dV$, in the quantum state with the nuclear spin in the field direction $(z)$, where $\\rho(x, y, z)$ is the nuclear electric charge density, $e$ is the elementary charge, $r^2 = x^2 + y^2 + z^2$, and $dV$ is the volume element $dx$ $dy$ $dz$."^^qudt:LatexString;
  qudt:applicableUnit unit:KiloM2, unit:KiloM2, unit:M2, unit:M2, unit:NanoM2, unit:NanoM2 .

