<http://qudt.org/vocab/quantitykind/BraggAngle> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Bragg Angle"@en;
  rdfs:comment "Applicable units are those of quantitykind:Angle";
  dct:description "\"Bragg Angle\" describes the condition for a plane wave to be diffracted from a family of lattice planes, the angle between the wavevector of the incident plane wave, and the lattice planes."^^<http://qudt.org/schema/qudt/LatexString>;
  skos:broader <http://qudt.org/vocab/quantitykind/Angle>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1>;
  <http://qudt.org/schema/qudt/informativeReference> "http://reference.iucr.org/dictionary/Bragg_angle"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/isoNormativeReference> "http://www.iso.org/iso/catalogue_detail?csnumber=31897"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/plainTextDescription> "\"Bragg Angle\" describes the condition for a plane wave to be diffracted from a family of lattice planes, the angle between the wavevector of the incident plane wave, and the lattice planes.";
  <http://qudt.org/schema/qudt/latexSymbol> "$\\vartheta$"^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/latexDefinition> "$2d\\sin{\\vartheta} = n\\lambda $"^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/applicableUnit> unit:ARCMIN, unit:MIN_Angle, unit:ARCSEC,
    unit:DEG, unit:GON, unit:GRAD, unit:MIL, unit:MicroRAD, unit:MilliARCSEC, unit:MilliRAD,
    unit:RAD, unit:REV .

