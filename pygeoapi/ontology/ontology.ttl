  <http://qudt.org/schema/qudt/ucumCode> "N.m-3"^^<http://qudt.org/schema/qudt/UCUMcs> .

<http://qudt.org/vocab/quantitykind/ModulusOfSubgradeReaction> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
