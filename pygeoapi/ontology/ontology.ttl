  <http://qudt.org/schema/qudt/applicableSystem> <http://qudt.org/vocab/sou/SI>;
  <http://qudt.org/schema/qudt/conversionMultiplier> 57295.77957855229894302178227976183;
  <http://qudt.org/schema/qudt/conversionMultiplierSN> 5.729577957855229894302178227976183E4;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L1I0M1H0T-2D0>;
  <http://qudt.org/schema/qudt/hasQuantityKind> <http://qudt.org/vocab/quantitykind/ModulusOfRotationalSubgradeReaction>;
  <http://qudt.org/schema/qudt/symbol> "kN·m/(°·m)";
  <http://qudt.org/schema/qudt/ucumCode> "kN.m.deg-1.m-1"^^<http://qudt.org/schema/qudt/UCUMcs>;
  <http://qudt.org/schema/qudt/plainTextDescription> "A common unit for measuring the modulus of rotational subgrade reaction." .

<http://qudt.org/vocab/quantitykind/ModulusOfRotationalSubgradeReaction> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Modulus of Rotational Subgrade Reaction"@en;
  rdfs:comment "Applicable units are those of quantitykind:ModulusOfRotationalSubgradeReaction";
  dct:description "Modulus of Rotational Subgrade Reaction is a measure for modulus of rotational subgrade reaction, which expresses the rotational elastic bedding of a linear structural element per length, such as for a beam. It is typically measured in Nm/(m*rad)."^^<http://qudt.org/schema/qudt/LatexString>;
  skos:broader <http://qudt.org/vocab/quantitykind/ForcePerAngle>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L1I0M1H0T-2D0>;
  <http://qudt.org/schema/qudt/informativeReference> "https://standards.buildingsmart.org/IFC/DEV/IFC4_2/FINAL/HTML/schema/ifcstructuralloadresource/lexical/ifcmodulusofrotationalsubgradereactionselect.htm"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/plainTextDescription> "Modulus of Rotational Subgrade Reaction is a measure for modulus of rotational subgrade reaction, which expresses the rotational elastic bedding of a linear structural element per length, such as for a beam. It is typically measured in Nm/(m*rad).";
  <http://qudt.org/schema/qudt/applicableUnit> unit:KiloN-M-PER-DEG-M, unit:N-M-PER-DEG-M,
    unit:N-M-PER-M-RAD .

