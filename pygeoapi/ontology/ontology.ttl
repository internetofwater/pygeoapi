  owl:imports <http://purl.org/dc/terms/> .

<http://vocabulary.odm2.org/variablename> a skos:ConceptScheme;
  dc:title "ODM2 Variable Name Controlled Vocabulary";
  dc:description "A vocabulary for describing the name of Variables.";
  dc:creator "ODM2 Working Group" .

variablename:weatherConditions a skos:Concept;
  skos:definition "Weather conditions";
  skos:inScheme <http://vocabulary.odm2.org/variablename>;
  skos:topConceptOf <http://vocabulary.odm2.org/variablename>;
  skos:prefLabel "Weather conditions";
  skos:historyNote "Originally from the CUAHSI HIS VariableNameCV.  See: http://his.cuahsi.org/mastercvreg/edit_cv11.aspx?tbl=VariableNameCV." .

variablename:abundance a skos:Concept;
  skos:definition "The relative representation of a species in a particular ecosystem. If this generic term is used, the publisher should specify/qualify the species, class, etc. being measured in the method, qualifier, or other appropriate field.";
  skos:inScheme <http://vocabulary.odm2.org/variablename>;
  skos:topConceptOf <http://vocabulary.odm2.org/variablename>;
  skos:prefLabel "Abundance";
  skos:historyNote "Originally from the CUAHSI HIS VariableNameCV.  See: http://his.cuahsi.org/mastercvreg/edit_cv11.aspx?tbl=VariableNameCV." .

variablename:ceriumDissolved a skos:Concept;
  skos:definition "Dissolved Cerium (Ce). \"Dissolved \" indicates a the measurement was made on a filtered sample.";
  skos:inScheme <http://vocabulary.odm2.org/variablename>;
  skos:topConceptOf <http://vocabulary.odm2.org/variablename>;
  skos:prefLabel "Cerium, dissolved";
  skos:note "Added to support Critical Zone Observatory (CZO) data use cases. ";
  skos:historyNote "Wikipedia";
  skos:exactMatch "https://en.wikipedia.org/wiki/Cerium" .

variablename:carbonOrganicExtractable a skos:Concept;
  skos:definition "Mass of carbon extractable by water from soil or forest floor samples, also known as water-extractable organic carbon (WEOC)";
  skos:inScheme <http://vocabulary.odm2.org/variablename>;
  skos:topConceptOf <http://vocabulary.odm2.org/variablename>;
  skos:prefLabel "Carbon, organic extractable";
  skos:note "Added to support Critical Zone Observatory (CZO) data use cases. ";
  skos:exactMatch "http://solvita.com/wp-content/uploads/2012/12/Soil_Organic_CN_ojss_2012.pdf" .

