    <http://qudt.org/vocab/sou/CGS> .

unit:ERG-SEC a <http://qudt.org/schema/qudt/Unit>, <http://qudt.org/schema/qudt/DerivedUnit>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/unit>;
  rdfs:label "Erg Second"@en;
