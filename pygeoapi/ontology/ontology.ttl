quantitykind:IsentropicCompressibility a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "Isentropic Compressibility"@en, "Isentropic Compressibility"@en;
  rdfs:comment "Applicable units are those of quantitykind:IsentropicCompressibility",
    "Applicable units are those of quantitykind:IsentropicCompressibility";
  dct:description """
  $\\textit{Isentropic compressibility}$ is the extent to which a material reduces its volume when it is subjected to compressive stresses at a constant value of entropy.
  """^^qudt:LatexString,
    """
  $\\textit{Isentropic compressibility}$ is the extent to which a material reduces its volume when it is subjected to compressive stresses at a constant value of entropy.
  """^^qudt:LatexString;
  qudt:hasDimensionVector dimensionvector:A0E0L1I0M-1H0T2D0, dimensionvector:A0E0L1I0M-1H0T2D0;
  qudt:informativeReference "http://en.wikipedia.org/wiki/Compressibility"^^xsd:anyURI,
    "http://en.wikipedia.org/wiki/Compressibility"^^xsd:anyURI;
  qudt:isoNormativeReference "http://www.iso.org/iso/catalogue_detail?csnumber=31890"^^xsd:anyURI,
    "http://www.iso.org/iso/catalogue_detail?csnumber=31890"^^xsd:anyURI;
  qudt:plainTextDescription "Isentropic compressibility is the extent to which a material reduces its volume when it is subjected to compressive stresses at a constant value of entropy.",
    "Isentropic compressibility is the extent to which a material reduces its volume when it is subjected to compressive stresses at a constant value of entropy.";
  qudt:latexSymbol "$\\varkappa_S$"^^qudt:LatexString, "$\\varkappa_S$"^^qudt:LatexString;
  qudt:latexDefinition "$\\varkappa_S = \\frac{1}{V}\\left (\\frac{\\partial V}{\\partial p} \\right )_S$, where $V$ is volume, $p$ is $pressure$, and $S$ is entropy,"^^qudt:LatexString,
    "$\\varkappa_S = \\frac{1}{V}\\left (\\frac{\\partial V}{\\partial p} \\right )_S$, where $V$ is volume, $p$ is $pressure$, and $S$ is entropy,"^^qudt:LatexString;
