variablename:soilHorizon a skos:Concept;
  skos:definition "A soil horizon is a layer parallel to the soil surface, whose physical characteristics differ from the layers above and beneath. Each soil type usually has three or four horizons.";
  skos:topConceptOf <http://vocabulary.odm2.org/variablename>;
