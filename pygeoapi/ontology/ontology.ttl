  rdfs:label "relative standard uncertainty", "relative standard uncertainty";
  rdfs:range xsd:double, xsd:double;
  dct:description "The relative standard uncertainty of a measurement is the (absolute) standard uncertainty divided by the magnitude of the exact value."^^rdf:HTML,
    "The relative standard uncertainty of a measurement is the (absolute) standard uncertainty divided by the magnitude of the exact value."^^rdf:HTML .

