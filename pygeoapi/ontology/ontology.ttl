  dct:issued "2000-07-11"^^xsd:date, "2000-07-11"^^xsd:date .

dct:isPartOf a rdf:Property, rdf:Property;
  rdfs:isDefinedBy <http://purl.org/dc/terms/>, <http://purl.org/dc/terms/>;
  rdfs:label "Is Part Of"@en, "Is Part Of"@en;
