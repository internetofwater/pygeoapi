unit:FARAD_Ab a qudt:Unit, qudt:Unit;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/unit>, <http://qudt.org/vocab/unit>;
  rdfs:label "Abfarad"@en, "Abfarad"@en;
  dct:description "An abfarad is an obsolete electromagnetic (CGS) unit of capacitance equal to $10^{9}$ farads (1,000,000,000 F or 1 GF). The absolute farad of the e.m.u. system, for a steady current identically $abC/abV$, and identically reciprocal abdaraf. 1 abF = 1 GF."^^qudt:LatexString,
    "An abfarad is an obsolete electromagnetic (CGS) unit of capacitance equal to $10^{9}$ farads (1,000,000,000 F or 1 GF). The absolute farad of the e.m.u. system, for a steady current identically $abC/abV$, and identically reciprocal abdaraf. 1 abF = 1 GF."^^qudt:LatexString;
  qudt:applicableSystem <http://qudt.org/vocab/sou/CGS-EMU>, <http://qudt.org/vocab/sou/CGS-EMU>,
    <http://qudt.org/vocab/sou/CGS>, <http://qudt.org/vocab/sou/CGS>;
  qudt:conversionMultiplier 1000000000.0, 1000000000.0;
  qudt:conversionMultiplierSN 1.0E9, 1.0E9;
  qudt:dbpediaMatch "http://dbpedia.org/resource/Abfarad"^^xsd:anyURI, "http://dbpedia.org/resource/Abfarad"^^xsd:anyURI;
  qudt:hasDimensionVector dimensionvector:A0E2L-2I0M-1H0T4D0, dimensionvector:A0E2L-2I0M-1H0T4D0;
  qudt:hasQuantityKind quantitykind:Capacitance, quantitykind:Capacitance;
  qudt:informativeReference "http://en.wikipedia.org/wiki/Abfarad?oldid=407124018"^^xsd:anyURI,
    "http://en.wikipedia.org/wiki/Abfarad?oldid=407124018"^^xsd:anyURI, "http://www.oxfordreference.com/view/10.1093/acref/9780198605225.001.0001/acref-9780198605225-e-13"^^xsd:anyURI,
    "http://www.oxfordreference.com/view/10.1093/acref/acref-9780198605225-e-13"^^xsd:anyURI;
  qudt:omUnit <http://www.ontology-of-units-of-measure.org/resource/om-2/abfarad>, <http://www.ontology-of-units-of-measure.org/resource/om-2/abfarad>;
