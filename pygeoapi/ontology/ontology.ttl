qudt:BigEndian a qudt:EndianType, qudt:EndianType;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/schema/qudt>, <http://qudt.org/schema/qudt>;
  rdfs:label "Big Endian", "Big Endian";
