  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/unit>;
  rdfs:label "Kilomole per Hour"@en;
  dct:description "1 000-fold of the SI base unit mole divided by the unit for time hour"^^rdf:HTML;
