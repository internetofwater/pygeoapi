  skos:topConceptOf <http://vocabulary.odm2.org/variablename>;
  skos:prefLabel "Pyridine";
  skos:historyNote "Originally from the CUAHSI HIS VariableNameCV.  See: http://his.cuahsi.org/mastercvreg/edit_cv11.aspx?tbl=VariableNameCV." .

variablename:benzo_b_fluorene a skos:Concept;
  skos:definition "Benzo(b)fluorene (C17H12), a polycyclic aromatic hydrocarbon (PAH)";
  skos:topConceptOf <http://vocabulary.odm2.org/variablename>;
  skos:prefLabel "Benzo(b)fluorene";
  skos:historyNote "Originally from the CUAHSI HIS VariableNameCV.  See: http://his.cuahsi.org/mastercvreg/edit_cv11.aspx?tbl=VariableNameCV." .

variablename:ethaneDissolved a skos:Concept;
  skos:definition "Dissolved Ethane (C2H6)";
  skos:topConceptOf <http://vocabulary.odm2.org/variablename>;
  skos:prefLabel "Ethane, dissolved";
  skos:historyNote "Originally from the CUAHSI HIS VariableNameCV.  See: http://his.cuahsi.org/mastercvreg/edit_cv11.aspx?tbl=VariableNameCV." .

variablename:gammaCounts a skos:Concept;
  skos:definition "The radioactivity of rocks has been used for many years to help derive lithologies. Natural occurring radioactive materials (NORM) include the elements uranium, thorium, potassium, radium, and radon, along with the minerals that contain them. There is usually no fundamental connection between different rock types and measured gamma ray intensity, but there exists a strong general correlation between the radioactive isotope content and mineralogy. Logging tools have been developed to read the gamma rays emitted by these elements and interpret lithology from the information collected.";
  skos:topConceptOf <http://vocabulary.odm2.org/variablename>;
  skos:prefLabel "Gamma counts";
  skos:note "Added to support Critical Zone Observatory (CZO) data use cases. ";
  skos:exactMatch "https://petrowiki.org/Gamma_ray_logs" .

variablename:di_n_OctylPhthalate a skos:Concept;
  skos:definition "Di-n-octyl phthalate (C24H38O4)";
  skos:topConceptOf <http://vocabulary.odm2.org/variablename>;
  skos:prefLabel "Di-n-octyl phthalate";
  skos:historyNote "Originally from the CUAHSI HIS VariableNameCV.  See: http://his.cuahsi.org/mastercvreg/edit_cv11.aspx?tbl=VariableNameCV." .

variablename:strontiumTotal a skos:Concept;
  skos:definition "Total Strontium (Sr)";
  skos:topConceptOf <http://vocabulary.odm2.org/variablename>;
  skos:prefLabel "Strontium, total";
  skos:historyNote "Originally from the CUAHSI HIS VariableNameCV.  See: http://his.cuahsi.org/mastercvreg/edit_cv11.aspx?tbl=VariableNameCV." .

variablename:polycyclicAromaticHydrocarbonParent a skos:Concept;
  skos:definition "Unsubstituted (i.e., non-alkylated) polycyclic aromatic hydrocarbon (PAH)";
  skos:topConceptOf <http://vocabulary.odm2.org/variablename>;
  skos:prefLabel "Polycyclic aromatic hydrocarbon, parent";
  skos:historyNote "Originally from the CUAHSI HIS VariableNameCV.  See: http://his.cuahsi.org/mastercvreg/edit_cv11.aspx?tbl=VariableNameCV." .

variablename:gadoliniumDissolved a skos:Concept;
  skos:definition "Dissolved Gadolinium (Gd). \"Dissolved \" indicates a the measurement was made on a filtered sample.";
  skos:topConceptOf <http://vocabulary.odm2.org/variablename>;
  skos:prefLabel "Gadolinium, dissolved";
  skos:note "Added to support Critical Zone Observatory (CZO) data use cases. ";
  skos:historyNote "Wikipedia";
  skos:exactMatch "https://en.wikipedia.org/wiki/Gadolinium" .

variablename:dielectricConstant a skos:Concept;
  skos:definition "The relative permittivity of a material is its (absolute) permittivity expressed as a ratio relative to the permittivity of vacuum. Permittivity is a material property that affects the Coulomb force between two point charges in the material. Relative permittivity is the factor by which the electric field between the charges is decreased relative to vacuum. Likewise, relative permittivity is the ratio of the capacitance of a capacitor using that material as a dielectric, compared with a similar capacitor that has vacuum as its dielectric. Relative permittivity is also commonly known as dielectric constant, a term deprecated in engineering as well as in chemistry.";
  skos:topConceptOf <http://vocabulary.odm2.org/variablename>;
  skos:prefLabel "Dielectric constant";
  skos:note "Added to support Critical Zone Observatory (CZO) data use cases. ";
  skos:historyNote "Wikipedia";
  skos:exactMatch "https://en.wikipedia.org/wiki/Relative_permittivity" .

variablename:NAlbuminoid a skos:Concept;
  skos:definition "Albuminoid Nitrogen";
  skos:topConceptOf <http://vocabulary.odm2.org/variablename>;
  skos:prefLabel "N, albuminoid";
  skos:historyNote "Originally from the CUAHSI HIS VariableNameCV.  See: http://his.cuahsi.org/mastercvreg/edit_cv11.aspx?tbl=VariableNameCV." .

variablename:secchiDepth a skos:Concept;
  skos:definition "Secchi depth";
  skos:topConceptOf <http://vocabulary.odm2.org/variablename>;
  skos:prefLabel "Secchi depth";
  skos:historyNote "Originally from the CUAHSI HIS VariableNameCV.  See: http://his.cuahsi.org/mastercvreg/edit_cv11.aspx?tbl=VariableNameCV." .

variablename:neodymiumDissolved a skos:Concept;
  skos:definition "Dissolved Neodymium (Nd). \"Dissolved \" indicates a the measurement was made on a filtered sample.";
  skos:topConceptOf <http://vocabulary.odm2.org/variablename>;
  skos:prefLabel "Neodymium, dissolved";
  skos:note "Added to support Critical Zone Observatory (CZO) data use cases. ";
  skos:historyNote "Wikipedia";
  skos:exactMatch "https://en.wikipedia.org/wiki/Neodymium" .

variablename:n_Alkane_C29 a skos:Concept;
  skos:definition "C29 alkane, normal (i.e. straight-chain) isomer, common name: n-Nonacosane, formula : C29H60";
  skos:topConceptOf <http://vocabulary.odm2.org/variablename>;
  skos:prefLabel "n-alkane, C29";
  skos:historyNote "Originally from the CUAHSI HIS VariableNameCV.  See: http://his.cuahsi.org/mastercvreg/edit_cv11.aspx?tbl=VariableNameCV." .

variablename:niobiumDissolved a skos:Concept;
  skos:definition "Niobium, formerly known as columbium, is a chemical element with symbol Nb (formerly Cb) and atomic number 41. It is a soft, grey, crystalline, ductile transition metal, often found in the minerals pyrochlore and columbite, hence the former name \"columbium\". Its name comes from Greek mythology, specifically Niobe, who was the daughter of Tantalus, the namesake of tantalum";
  skos:topConceptOf <http://vocabulary.odm2.org/variablename>;
  skos:prefLabel "Niobium, dissolved";
  skos:note "Added to support Critical Zone Observatory (CZO) data use cases. ";
  skos:historyNote "Wikipedia";
  skos:exactMatch "https://en.wikipedia.org/wiki/Niobium" .

variablename:zincTotal a skos:Concept;
  skos:definition "Total zinc (Zn).\"Total\" indicates was measured on a whole water (unfiltered) sample.";
  skos:topConceptOf <http://vocabulary.odm2.org/variablename>;
  skos:prefLabel "Zinc, total";
  skos:historyNote "Originally from the CUAHSI HIS VariableNameCV.  See: http://his.cuahsi.org/mastercvreg/edit_cv11.aspx?tbl=VariableNameCV." .

variablename:aldrin a skos:Concept;
  skos:definition "Aldrin (C12H8Cl6)";
  skos:topConceptOf <http://vocabulary.odm2.org/variablename>;
  skos:prefLabel "Aldrin";
  skos:historyNote "Originally from the CUAHSI HIS VariableNameCV.  See: http://his.cuahsi.org/mastercvreg/edit_cv11.aspx?tbl=VariableNameCV." .

variablename:waterUseRecreation a skos:Concept;
  skos:definition "Recreational water use, for example golf courses.";
  skos:topConceptOf <http://vocabulary.odm2.org/variablename>;
  skos:prefLabel "Water Use, Recreation";
  skos:historyNote "Originally from the CUAHSI HIS VariableNameCV.  See: http://his.cuahsi.org/mastercvreg/edit_cv11.aspx?tbl=VariableNameCV." .

variablename:nitrogenInorganic a skos:Concept;
  skos:definition "Total Inorganic Nitrogen";
  skos:topConceptOf <http://vocabulary.odm2.org/variablename>;
  skos:prefLabel "Nitrogen, inorganic";
  skos:historyNote "Originally from the CUAHSI HIS VariableNameCV.  See: http://his.cuahsi.org/mastercvreg/edit_cv11.aspx?tbl=VariableNameCV." .

variablename:resistivityElectrical a skos:Concept;
  skos:definition "The electrical resistance of an object is a measure of its opposition to the flow of electric current. The inverse quantity is electrical conductance, and is the ease with which an electric current passes.";
  skos:topConceptOf <http://vocabulary.odm2.org/variablename>;
  skos:prefLabel "Resistivity, electrical";
  skos:note "Added to support Critical Zone Observatory (CZO) data use cases. ";
  skos:historyNote "Wikipedia";
  skos:exactMatch "https://en.wikipedia.org/wiki/Electrical_resistance_and_conductance" .

variablename:sulfateTotal a skos:Concept;
  skos:definition "Total Sulfate (SO4)";
  skos:topConceptOf <http://vocabulary.odm2.org/variablename>;
  skos:prefLabel "Sulfate, total";
  skos:historyNote "Originally from the CUAHSI HIS VariableNameCV.  See: http://his.cuahsi.org/mastercvreg/edit_cv11.aspx?tbl=VariableNameCV." .

variablename:isopropylAlcohol a skos:Concept;
  skos:definition "Isopropyl alcohol (C3H8O)";
  skos:topConceptOf <http://vocabulary.odm2.org/variablename>;
  skos:prefLabel "Isopropyl alcohol";
  skos:historyNote "Originally from the CUAHSI HIS VariableNameCV.  See: http://his.cuahsi.org/mastercvreg/edit_cv11.aspx?tbl=VariableNameCV." .

variablename:hydraulicConductivity a skos:Concept;
  skos:definition "Hydraulic conductivity, symbolically represented as K, is a property of vascular plants, soils and rocks, that describes the ease with which a fluid (usually water) can move through pore spaces or fractures. It depends on the intrinsic permeability of the material, the degree of saturation, and on the density and viscosity of the fluid.";
  skos:topConceptOf <http://vocabulary.odm2.org/variablename>;
  skos:prefLabel "Hydraulic conductivity";
  skos:note "Added to support Critical Zone Observatory (CZO) data use cases. ";
  skos:historyNote "Wikipedia";
  skos:exactMatch "https://en.wikipedia.org/wiki/Hydraulic_conductivity" .

variablename:ultravioletRadiationIndex a skos:Concept;
  skos:definition "The global solar UV index (UVI) was developed as an easy-to-understand measure of biologically effective UV radiation with a view to promote public awareness of the risks of UV radiation exposure and sun protection. In the initial work done on UVI in Canada, a typical midday summer erythemal irradiance of 250 mW.m-2 was found leading to the (arbitrary) definition of one UV index equal to an erythemally weighted irradiance of 25 mW.m-2. This gives a typical range of UVI 0 to 11+.";
  skos:topConceptOf <http://vocabulary.odm2.org/variablename>;
  skos:prefLabel "Ultraviolet Radation Index";
  skos:historyNote "See http://support.bentham.co.uk/support/solutions/articles/5000619299-erythemal-radiant-exposure-and-uv-index";
  <http://vocabulary.odm2.org/ODM2/ODM2Terms/category> "Biota" .

variablename:carbonToNitrogenMolarRatio a skos:Concept;
  skos:definition "Carbon to nitrogen (C:N) molar ratio";
  skos:topConceptOf <http://vocabulary.odm2.org/variablename>;
  skos:prefLabel "Carbon to nitrogen molar ratio";
  skos:historyNote "Originally from the CUAHSI HIS VariableNameCV.  See: http://his.cuahsi.org/mastercvreg/edit_cv11.aspx?tbl=VariableNameCV." .

variablename:isobutyricAcid a skos:Concept;
  skos:definition "Isobutyric acid (C4H8O2)";
  skos:topConceptOf <http://vocabulary.odm2.org/variablename>;
  skos:prefLabel "Isobutyric acid";
  skos:historyNote "Originally from the CUAHSI HIS VariableNameCV.  See: http://his.cuahsi.org/mastercvreg/edit_cv11.aspx?tbl=VariableNameCV." .

variablename:length a skos:Concept;
  skos:definition "Length is a measure of distance.";
  skos:topConceptOf <http://vocabulary.odm2.org/variablename>;
  skos:prefLabel "Length";
  skos:note "Added to support Critical Zone Observatory (CZO) data use cases. ";
  skos:historyNote "Wikipedia";
  skos:exactMatch "https://en.wikipedia.org/wiki/Length" .

variablename:N_Nitrosodiphenylamine a skos:Concept;
  skos:definition "N-Nitrosodiphenylamine (C12H10N2O)";
  skos:topConceptOf <http://vocabulary.odm2.org/variablename>;
  skos:prefLabel "N-Nitrosodiphenylamine";
  skos:historyNote "Originally from the CUAHSI HIS VariableNameCV.  See: http://his.cuahsi.org/mastercvreg/edit_cv11.aspx?tbl=VariableNameCV." .

variablename:permittivityElectrical a skos:Concept;
  skos:definition "In electromagnetism, absolute permittivity, often simply called permittivity, usually denoted by the Greek letter ε (epsilon), is the measure of capacitance that is encountered when forming an electric field in a particular medium. More specifically, permittivity describes the amount of charge needed to generate one unit of electric flux in a particular medium. Accordingly, a charge will yield more electric flux in a medium with low permittivity than in a medium with high permittivity. Permittivity is the measure of a material's ability to store an electric field in the polarization of the medium. ";
  skos:topConceptOf <http://vocabulary.odm2.org/variablename>;
  skos:prefLabel "Permittivity, electrical ";
  skos:note "Added to support Critical Zone Observatory (CZO) data use cases. ";
  skos:historyNote "Wikipedia";
  skos:exactMatch "https://en.wikipedia.org/wiki/Permittivity" .

variablename:titaniumTotal a skos:Concept;
  skos:definition "Total titanium (Ti)";
  skos:topConceptOf <http://vocabulary.odm2.org/variablename>;
  skos:prefLabel "Titanium, total";
  skos:note "Added to support Critical Zone Observatory (CZO) data use cases. ";
  skos:historyNote "Wikipedia";
  skos:exactMatch "https://en.wikipedia.org/wiki/Titanium" .

variablename:biomass a skos:Concept;
  skos:definition "Mass of living biological organisms in a given area or ecosystem at a given time. If this generic term is used, the publisher should specify/qualify the species, class, etc. being measured in the method, qualifier, or other appropriate field.";
  skos:topConceptOf <http://vocabulary.odm2.org/variablename>;
  skos:prefLabel "Biomass";
  skos:historyNote "Originally from the CUAHSI HIS VariableNameCV.  See: http://his.cuahsi.org/mastercvreg/edit_cv11.aspx?tbl=VariableNameCV." .

variablename:vermiculite a skos:Concept;
  skos:definition "Vermiculite is a hydrous phyllosilicate mineral. It undergoes significant expansion when heated. Exfoliation occurs when the mineral is heated sufficiently, and the effect is routinely produced in commercial furnaces.";
  skos:topConceptOf <http://vocabulary.odm2.org/variablename>;
  skos:prefLabel "Vermiculite";
  skos:note "Added to support Critical Zone Observatory (CZO) data use cases. ";
  skos:historyNote "Wikipedia";
  skos:exactMatch "https://en.wikipedia.org/wiki/Vermiculite" .

variablename:uranium_234 a skos:Concept;
  skos:definition "An isotope of uranium in the uranium-238 decay series";
  skos:topConceptOf <http://vocabulary.odm2.org/variablename>;
  skos:prefLabel "Uranium-234";
  skos:historyNote "Originally from the CUAHSI HIS VariableNameCV.  See: http://his.cuahsi.org/mastercvreg/edit_cv11.aspx?tbl=VariableNameCV." .

variablename:watchdogErrorCount a skos:Concept;
  skos:definition "A counter which counts the number of total datalogger watchdog errors";
  skos:topConceptOf <http://vocabulary.odm2.org/variablename>;
  skos:prefLabel "Watchdog error count";
  skos:historyNote "Originally from the CUAHSI HIS VariableNameCV.  See: http://his.cuahsi.org/mastercvreg/edit_cv11.aspx?tbl=VariableNameCV." .

variablename:litterPlant a skos:Concept;
  skos:definition "Litterfall, plant litter, leaf litter, tree litter, soil litter, or duff, is dead plant material (such as leaves, bark, needles, twigs, and cladodes) that have fallen to the ground.";
  skos:topConceptOf <http://vocabulary.odm2.org/variablename>;
  skos:prefLabel "Litter, plant";
  skos:note "Added to support Critical Zone Observatory (CZO) data use cases. ";
  skos:historyNote "Wikipedia";
  skos:exactMatch "https://en.wikipedia.org/wiki/Plant_litter" .

variablename:albite a skos:Concept;
  skos:definition "Albite is a plagioclase feldspar mineral. It is the sodium endmember of the plagioclase solid solution series. As such it represents a plagioclase with less than 10% anorthite content.";
  skos:topConceptOf <http://vocabulary.odm2.org/variablename>;
  skos:prefLabel "Albite";
  skos:note "Added to support Critical Zone Observatory (CZO) data use cases. ";
  skos:historyNote "Wikipedia";
  skos:exactMatch "https://en.wikipedia.org/wiki/Albite" .

variablename:isophorone a skos:Concept;
  skos:definition "Isophorone (C9H14O)";
  skos:topConceptOf <http://vocabulary.odm2.org/variablename>;
  skos:prefLabel "Isophorone";
  skos:historyNote "Originally from the CUAHSI HIS VariableNameCV.  See: http://his.cuahsi.org/mastercvreg/edit_cv11.aspx?tbl=VariableNameCV." .

variablename:lead_208 a skos:Concept;
  skos:definition "Stable isotope of lead. The term stable isotope has a meaning similar to stable nuclide, but is preferably used when speaking of nuclides of a specific element. Hence, the plural form stable isotopes usually refers to isotopes of the same element. The relative abundance of such stable isotopes can be measured experimentally (isotope analysis), yielding an isotope ratio that can be used as a research tool.";
  skos:topConceptOf <http://vocabulary.odm2.org/variablename>;
  skos:prefLabel "Lead-208";
  skos:note "Added to support Critical Zone Observatory (CZO) data use cases. ";
  skos:historyNote "Wikipedia";
  skos:exactMatch "https://en.wikipedia.org/wiki/Isotopes_of_lead https://en.wikipedia.org/wiki/Stable_isotope_ratio" .

variablename:germaniumDissolved a skos:Concept;
  skos:definition "Dissolved Germanium (Ge). \"Dissolved \" indicates a the measurement was made on a filtered sample.";
  skos:topConceptOf <http://vocabulary.odm2.org/variablename>;
  skos:prefLabel "Germanium, dissolved";
  skos:note "Added to support Critical Zone Observatory (CZO) data use cases. ";
  skos:historyNote "Wikipedia";
  skos:exactMatch "https://en.wikipedia.org/wiki/Germanium" .

variablename:9_10_Dimethylanthracene a skos:Concept;
  skos:definition "9,10-Dimethylanthracene (C16H14), a polycyclic aromatic hydrocarbon (PAH)";
  skos:topConceptOf <http://vocabulary.odm2.org/variablename>;
  skos:prefLabel "9,10-Dimethylanthracene";
  skos:historyNote "Originally from the CUAHSI HIS VariableNameCV.  See: http://his.cuahsi.org/mastercvreg/edit_cv11.aspx?tbl=VariableNameCV." .

variablename:fluorescenceIndex a skos:Concept;
  skos:definition "Fluorescence index for measuring fluorescent dissolved organic matter (FDOM). Ratio of emission intensity at 470nm to intensity at 520nm at excitation 370nm.";
  skos:topConceptOf <http://vocabulary.odm2.org/variablename>;
  skos:prefLabel "Fluorescence index";
  skos:note "Added to support Critical Zone Observatory (CZO) data use cases. ";
  skos:exactMatch "https://aslopubs.onlinelibrary.wiley.com/doi/abs/10.4319/lo.2001.46.1.0038" .

variablename:chlorophyll_a_UncorrectedForPheophytin a skos:Concept;
  skos:definition "Chlorophyll a uncorrected for pheophytin";
  skos:topConceptOf <http://vocabulary.odm2.org/variablename>;
  skos:prefLabel "Chlorophyll a, uncorrected for pheophytin";
  skos:historyNote "Originally from the CUAHSI HIS VariableNameCV.  See: http://his.cuahsi.org/mastercvreg/edit_cv11.aspx?tbl=VariableNameCV." .

variablename:radiationIncomingUV_A a skos:Concept;
  skos:definition "Incoming Ultraviolet A Radiation";
  skos:topConceptOf <http://vocabulary.odm2.org/variablename>;
  skos:prefLabel "Radiation, incoming UV-A";
  skos:historyNote "Originally from the CUAHSI HIS VariableNameCV.  See: http://his.cuahsi.org/mastercvreg/edit_cv11.aspx?tbl=VariableNameCV." .

variablename:thulium a skos:Concept;
  skos:definition "Thulium is a chemical element with symbol Tm and atomic number 69. It is the thirteenth and third-last element in the lanthanide series. Like the other lanthanides, the most common oxidation state is +3, seen in its oxide, halides and other compounds; because it occurs so late in the series, however, the +2 oxidation state is also stabilized by the nearly full 4f shell that results.";
  skos:topConceptOf <http://vocabulary.odm2.org/variablename>;
  skos:prefLabel "Thulium";
  skos:note "Added to support Critical Zone Observatory (CZO) data use cases. ";
  skos:historyNote "Wikipedia";
  skos:exactMatch "https://en.wikipedia.org/wiki/Thulium" .

variablename:1_Methylanthracene a skos:Concept;
  skos:definition "1-Methylanthracene (C15H12), a polycyclic aromatic hydrocarbon (PAH)";
  skos:topConceptOf <http://vocabulary.odm2.org/variablename>;
  skos:prefLabel "1-Methylanthracene";
  skos:historyNote "Originally from the CUAHSI HIS VariableNameCV.  See: http://his.cuahsi.org/mastercvreg/edit_cv11.aspx?tbl=VariableNameCV." .

variablename:fluorideDissolved a skos:Concept;
  skos:definition "Dissolved Fluoride (F-)";
  skos:topConceptOf <http://vocabulary.odm2.org/variablename>;
