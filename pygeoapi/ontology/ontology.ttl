variablename:acidPhosphatase a skos:Concept;
  skos:definition "Phosphatase enzymes are used by soil microorganisms to access organically bound phosphate nutrients. An assay on the rates of activity of these enzymes may be used to ascertain biological demand for phosphates in the soil. Some plant roots, especially cluster roots, exude carboxylates that perform acid phosphatase activity, helping to mobilise phosphorus in nutrient-deficient soils.";
  skos:topConceptOf <http://vocabulary.odm2.org/variablename>;
  skos:prefLabel "Acid phosphatase";
  skos:historyNote "Wikipedia";
  skos:exactMatch "https://en.wikipedia.org/wiki/Acid_phosphatase";
  <http://vocabulary.odm2.org/ODM2/ODM2Terms/category> "Chemistry" .

variablename:polycyclicAromaticHydrocarbonAlkyl a skos:Concept;
