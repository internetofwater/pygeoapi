quantitykind:RadiantFluenceRate a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "Radiant Fluence Rate"@en, "Radiant Fluence Rate"@en;
  rdfs:comment "Applicable units are those of quantitykind:PowerPerArea", "Applicable units are those of quantitykind:PowerPerArea";
  dct:description "Radiant fluence rate, or spherical irradiance, is equal to the total radiant flux incident on a small sphere divided by the area of the diametrical cross-section of the sphere."^^qudt:LatexString,
    "Radiant fluence rate, or spherical irradiance, is equal to the total radiant flux incident on a small sphere divided by the area of the diametrical cross-section of the sphere."^^qudt:LatexString;
