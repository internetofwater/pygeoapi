    qudt:omUnit <http://www.ontology-of-units-of-measure.org/resource/om-2/unitPole> ;
    qudt:scalingOf unit:WB ;
    qudt:symbol "pole" ;
    qudt:uneceCommonCode "P53" ;
    rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/unit>,
        <http://qudt.org/vocab/unit> .

