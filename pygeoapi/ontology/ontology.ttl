  <http://qudt.org/schema/qudt/symbol> "kN·m/°";
  <http://qudt.org/schema/qudt/ucumCode> "kN.m.deg-1"^^<http://qudt.org/schema/qudt/UCUMcs>;
  <http://qudt.org/schema/qudt/plainTextDescription> "Unit for expressing the value of the torsional spring constant" .

<http://qudt.org/vocab/quantitykind/TorsionalSpringConstant> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Federkonstante Drehfeder"@de, "torsional spring constant"@en;
  rdfs:comment "Applicable units are those of quantitykind:TorsionalSpringConstant";
  dct:description "ratio between the turning moment for elastic deformation of a torsion spring and the related angle of rotation"@en;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L2I0M1H0T-2D0>;
  <http://qudt.org/schema/qudt/informativeReference> "https://en.wikipedia.org/wiki/Torsion_spring"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/symbol> "0173-1#Z4-BAJ448#002";
  <http://qudt.org/schema/qudt/plainTextDescription> "A torsional spring constant is a measure of the stiffness of a torsional spring, which is a type of spring that experiences twisting or torque rather than compression or extension. It is typically measured in newton-meters per radian (N·m/rad) and is used to calculate the amount of torque required to twist a spring a certain amount. It is related to the spring's geometry, material properties, and manufacturing process.",
    "Quotient Drehmoment zur elastischen Verformung einer Drehfeder durch den zugehörigen Drehwinkel"@de;
  <http://qudt.org/schema/qudt/applicableUnit> unit:KiloN-M-PER-DEG, unit:N-M-PER-ARCMIN,
    unit:N-M-PER-MIN_Angle, unit:N-M-PER-DEG, unit:N-M-PER-RAD .

