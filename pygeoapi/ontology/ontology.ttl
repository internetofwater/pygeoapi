  <http://qudt.org/schema/qudt/symbol> "keV/μm";
  <http://qudt.org/schema/qudt/ucumCode> "keV.um-1"^^<http://qudt.org/schema/qudt/UCUMcs>;
  <http://qudt.org/schema/qudt/expression> "$keV/microM$"^^<http://qudt.org/schema/qudt/LatexString> .

