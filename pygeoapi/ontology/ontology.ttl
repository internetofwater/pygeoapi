variablename:gadolinium a skos:Concept ;
    skos:definition "Gadolinium is a chemical element with symbol Gd and atomic number 64. Gadolinium is a silvery-white, malleable, and ductile rare earth metal. It is found in nature only in oxidized form, and even when separated, it usually has impurities of the other rare earths." ;
    skos:exactMatch "https://en.wikipedia.org/wiki/Gadolinium" ;
    skos:historyNote "Wikipedia" ;
    skos:inScheme <http://vocabulary.odm2.org/variablename> ;
    skos:note "Added to support Critical Zone Observatory (CZO) data use cases. " ;
    skos:prefLabel "Gadolinium" ;
    skos:topConceptOf <http://vocabulary.odm2.org/variablename> .

variablename:gadoliniumDissolved a skos:Concept ;
    skos:definition "Dissolved Gadolinium (Gd). \"Dissolved \" indicates a the measurement was made on a filtered sample." ;
    skos:exactMatch "https://en.wikipedia.org/wiki/Gadolinium" ;
    skos:historyNote "Wikipedia" ;
    skos:inScheme <http://vocabulary.odm2.org/variablename> ;
    skos:note "Added to support Critical Zone Observatory (CZO) data use cases. " ;
    skos:prefLabel "Gadolinium, dissolved" ;
    skos:topConceptOf <http://vocabulary.odm2.org/variablename> .

variablename:gallium a skos:Concept ;
    skos:definition "Gallium is a chemical element with symbol Ga and atomic number 31. It is in group 13 of the periodic table, and thus has similarities to the other metals of the group, aluminium, indium, and thallium." ;
    skos:exactMatch "https://en.wikipedia.org/wiki/Gallium" ;
    skos:historyNote "Wikipedia" ;
    skos:inScheme <http://vocabulary.odm2.org/variablename> ;
    skos:note "Added to support Critical Zone Observatory (CZO) data use cases. " ;
    skos:prefLabel "Gallium" ;
    skos:topConceptOf <http://vocabulary.odm2.org/variablename> .

variablename:gammaCounts a skos:Concept ;
    skos:definition "The radioactivity of rocks has been used for many years to help derive lithologies. Natural occurring radioactive materials (NORM) include the elements uranium, thorium, potassium, radium, and radon, along with the minerals that contain them. There is usually no fundamental connection between different rock types and measured gamma ray intensity, but there exists a strong general correlation between the radioactive isotope content and mineralogy. Logging tools have been developed to read the gamma rays emitted by these elements and interpret lithology from the information collected." ;
    skos:exactMatch "https://petrowiki.org/Gamma_ray_logs" ;
    skos:inScheme <http://vocabulary.odm2.org/variablename> ;
    skos:note "Added to support Critical Zone Observatory (CZO) data use cases. " ;
    skos:prefLabel "Gamma counts" ;
    skos:topConceptOf <http://vocabulary.odm2.org/variablename> .

variablename:geologicUnit a skos:Concept ;
    skos:definition "Geologic units consists primarily of identifying physiographic units and determining the rock lithology or coarse stratigraphy of exposed units." ;
    skos:exactMatch "https://www.nrcan.gc.ca/node/9329" ;
    skos:inScheme <http://vocabulary.odm2.org/variablename> ;
    skos:note "Added to support Critical Zone Observatory (CZO) data use cases. " ;
    skos:prefLabel "Geologic unit" ;
    skos:topConceptOf <http://vocabulary.odm2.org/variablename> .

variablename:germanium a skos:Concept ;
    skos:definition "Germanium is a chemical element with symbol Ge and atomic number 32. It is a lustrous, hard, grayish-white metalloid in the carbon group, chemically similar to its group neighbors tin and silicon. Pure germanium is a semiconductor with an appearance similar to elemental silicon. Like silicon, germanium naturally reacts and forms complexes with oxygen in nature." ;
    skos:exactMatch "https://en.wikipedia.org/wiki/Germanium" ;
    skos:historyNote "Wikipedia" ;
    skos:inScheme <http://vocabulary.odm2.org/variablename> ;
    skos:note "Added to support Critical Zone Observatory (CZO) data use cases. " ;
    skos:prefLabel "Germanium" ;
    skos:topConceptOf <http://vocabulary.odm2.org/variablename> .

variablename:germaniumDissolved a skos:Concept ;
    skos:definition "Dissolved Germanium (Ge). \"Dissolved \" indicates a the measurement was made on a filtered sample." ;
    skos:exactMatch "https://en.wikipedia.org/wiki/Germanium" ;
    skos:historyNote "Wikipedia" ;
    skos:inScheme <http://vocabulary.odm2.org/variablename> ;
    skos:note "Added to support Critical Zone Observatory (CZO) data use cases. " ;
    skos:prefLabel "Germanium, dissolved" ;
    skos:topConceptOf <http://vocabulary.odm2.org/variablename> .

variablename:gibbsite a skos:Concept ;
    skos:definition "Gibbsite, Al(OH)3, is one of the mineral forms of aluminium hydroxide. It is often designated as γ-Al(OH)3 (but sometimes as α-Al(OH)3.[1]). It is also sometimes called hydrargillite (or hydrargyllite). " ;
    skos:exactMatch "https://en.wikipedia.org/wiki/Gibbsite" ;
    skos:historyNote "Wikipedia" ;
    skos:inScheme <http://vocabulary.odm2.org/variablename> ;
    skos:note "Added to support Critical Zone Observatory (CZO) data use cases. " ;
    skos:prefLabel "Gibbsite" ;
    skos:topConceptOf <http://vocabulary.odm2.org/variablename> .

variablename:globalRadiation a skos:Concept ;
    skos:definition "Solar radiation, direct and diffuse, received from a solid angle of 2p steradians on a horizontal surface. Source: World Meteorological Organization, Meteoterm" ;
    skos:historyNote "Originally from the CUAHSI HIS VariableNameCV.  See: http://his.cuahsi.org/mastercvreg/edit_cv11.aspx?tbl=VariableNameCV." ;
    skos:inScheme <http://vocabulary.odm2.org/variablename> ;
    skos:prefLabel "Global Radiation" ;
    skos:topConceptOf <http://vocabulary.odm2.org/variablename> .

variablename:glucosidase a skos:Concept ;
    skos:definition "Glucosidases are glycoside hydrolase enzymes categorized under the EC number 3.2.1." ;
