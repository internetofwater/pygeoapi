unit:FARAD_Ab-PER-CentiM a qudt:Unit, qudt:Unit;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/unit>, <http://qudt.org/vocab/unit>;
  rdfs:label "Abfarad per Centimeter"@en-US, "Abfarad per Centimeter"@en-US, "Abfarad per Centimetre"@en,
    "Abfarad per Centimetre"@en;
  dct:description "The absolute dielectric constant of free space is defined as the ratio of displacement to the electric field intensity. The unit of measure is the abfarad per centimeter, a derived CGS unit."^^rdf:HTML,
    "The absolute dielectric constant of free space is defined as the ratio of displacement to the electric field intensity. The unit of measure is the abfarad per centimeter, a derived CGS unit."^^rdf:HTML;
