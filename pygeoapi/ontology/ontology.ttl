quantitykind:InternalEnergy a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:seeAlso quantitykind:Energy, quantitykind:Energy, quantitykind:Enthalpy, quantitykind:Enthalpy,
    quantitykind:GibbsEnergy, quantitykind:GibbsEnergy, quantitykind:HelmholtzEnergy,
    quantitykind:HelmholtzEnergy;
  rdfs:label "Internal Energy"@en, "Internal Energy"@en;
  rdfs:comment "Applicable units are those of quantitykind:Energy", "Applicable units are those of quantitykind:Energy";
  dct:description "\"Internal Energy\" is simply its energy. \"internal\" refers to the fact that some energy contributions are not considered. For instance, when the total system is in uniform motion, it has kinetic energy. This overall kinetic energy is never seen as part of the internal energy; one could call it external energy. Or, if the system is at constant non-zero height above the surface the Earth, it has constant potential energy in the gravitational field of the Earth. Gravitational energy is only taken into account when it plays a role in the phenomenon of interest, for instance in a colloidal suspension, where the gravitation influences the up- downward motion of the small particles comprising the colloid. In all other cases, gravitational energy is assumed not to contribute to the internal energy; one may call it again external energy."^^qudt:LatexString,
    "\"Internal Energy\" is simply its energy. \"internal\" refers to the fact that some energy contributions are not considered. For instance, when the total system is in uniform motion, it has kinetic energy. This overall kinetic energy is never seen as part of the internal energy; one could call it external energy. Or, if the system is at constant non-zero height above the surface the Earth, it has constant potential energy in the gravitational field of the Earth. Gravitational energy is only taken into account when it plays a role in the phenomenon of interest, for instance in a colloidal suspension, where the gravitation influences the up- downward motion of the small particles comprising the colloid. In all other cases, gravitational energy is assumed not to contribute to the internal energy; one may call it again external energy."^^qudt:LatexString;
  skos:broader quantitykind:Energy, quantitykind:Energy;
  qudt:dbpediaMatch "http://dbpedia.org/resource/Internal_energy"^^xsd:anyURI, "http://dbpedia.org/resource/Internal_energy"^^xsd:anyURI;
  qudt:hasDimensionVector dimensionvector:A0E0L2I0M1H0T-2D0, dimensionvector:A0E0L2I0M1H0T-2D0;
  qudt:informativeReference "http://en.citizendium.org/wiki/Internal_energy"^^xsd:anyURI,
    "http://en.citizendium.org/wiki/Internal_energy"^^xsd:anyURI;
  qudt:symbol "U", "U";
  qudt:plainTextDescription "\"Internal Energy\" is simply its energy. \"internal\" refers to the fact that some energy contributions are not considered. For instance, when the total system is in uniform motion, it has kinetic energy. This overall kinetic energy is never seen as part of the internal energy; one could call it external energy. Or, if the system is at constant non-zero height above the surface the Earth, it has constant potential energy in the gravitational field of the Earth. Gravitational energy is only taken into account when it plays a role in the phenomenon of interest, for instance in a colloidal suspension, where the gravitation influences the up- downward motion of the small particles comprising the colloid. In all other cases, gravitational energy is assumed not to contribute to the internal energy; one may call it again external energy.",
    "\"Internal Energy\" is simply its energy. \"internal\" refers to the fact that some energy contributions are not considered. For instance, when the total system is in uniform motion, it has kinetic energy. This overall kinetic energy is never seen as part of the internal energy; one could call it external energy. Or, if the system is at constant non-zero height above the surface the Earth, it has constant potential energy in the gravitational field of the Earth. Gravitational energy is only taken into account when it plays a role in the phenomenon of interest, for instance in a colloidal suspension, where the gravitation influences the up- downward motion of the small particles comprising the colloid. In all other cases, gravitational energy is assumed not to contribute to the internal energy; one may call it again external energy.";
  qudt:exactMatch quantitykind:EnergyInternal, quantitykind:EnergyInternal, quantitykind:ThermodynamicEnergy,
    quantitykind:ThermodynamicEnergy;
  qudt:latexDefinition "For a closed thermodynamic system, $\\Delta U = Q + W$, where $Q$ is amount of heat transferred to the system and $W$ is work done on the system provided that no chemical reactions occur."^^qudt:LatexString,
    "For a closed thermodynamic system, $\\Delta U = Q + W$, where $Q$ is amount of heat transferred to the system and $W$ is work done on the system provided that no chemical reactions occur."^^qudt:LatexString;
  qudt:abbreviation "int-energy", "int-energy";
  qudt:applicableUnit unit:AttoJ, unit:AttoJ, unit:BTU_IT, unit:BTU_IT, unit:BTU_TH,
    unit:BTU_TH, unit:CAL_IT, unit:CAL_IT, unit:CAL_TH, unit:CAL_TH, unit:ERG, unit:ERG,
