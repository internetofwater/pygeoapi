    "Магнитное поле"@ru, "Магнитное поле"@ru, "حقل مغناطيسي"@ar, "حقل مغناطيسي"@ar, "شدت میدان مغناطیسی"@fa,
    "شدت میدان مغناطیسی"@fa, "磁場"@ja, "磁場"@ja, "磁場"@zh, "磁場"@zh;
  rdfs:comment "Applicable units are those of quantitykind:MagneticFieldStrength_H",
    "Applicable units are those of quantitykind:MagneticFieldStrength_H";
  dct:description "$\\textit{Magnetic Field Strength}$ is a vector quantity obtained at a given point by subtracting the magnetization $M$ from the magnetic flux density $B$ divided by the magnetic constant $\\mu_0$. The magnetic field strength is related to the total current density $J_{tot}$ via: $\\text{rot} H = J_{tot}$."^^qudt:LatexString,
    "$\\textit{Magnetic Field Strength}$ is a vector quantity obtained at a given point by subtracting the magnetization $M$ from the magnetic flux density $B$ divided by the magnetic constant $\\mu_0$. The magnetic field strength is related to the total current density $J_{tot}$ via: $\\text{rot} H = J_{tot}$."^^qudt:LatexString;
  skos:broader quantitykind:ElectricCurrentPerLength, quantitykind:ElectricCurrentPerLength;
  qudt:hasDimensionVector dimensionvector:A0E1L-1I0M0H0T0D0, dimensionvector:A0E1L-1I0M0H0T0D0;
  qudt:iec61360Code "0112/2///62720#UAD098", "0112/2///62720#UAD098";
  qudt:informativeReference "http://www.iso.org/iso/home/store/catalogue_tc/catalogue_detail.htm?csnumber=31891"^^xsd:anyURI,
    "http://www.iso.org/iso/home/store/catalogue_tc/catalogue_detail.htm?csnumber=31891"^^xsd:anyURI,
    "http://www.electropedia.org/iev/iev.nsf/display?openform&ievref=121-11-56"^^xsd:anyURI,
    "http://www.electropedia.org/iev/iev.nsf/display?openform&ievref=121-11-56"^^xsd:anyURI,
    "https://cdd.iec.ch/cdd/iec61987/iec61987.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD098"^^xsd:anyURI,
    "https://cdd.iec.ch/cdd/iec61987/iec61987.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD098"^^xsd:anyURI;
  qudt:siExactMatch <https://si-digital-framework.org/SI/quantities/MAFD>, <https://si-digital-framework.org/quantities/MAFD>;
  qudt:latexSymbol "$\\mathbf{H} $"^^qudt:LatexString, "$\\mathbf{H} $"^^qudt:LatexString;
  qudt:latexDefinition "$\\mathbf{H} = \\frac{\\mathbf{B} }{\\mu_0} - M$, where $\\mathbf{B} $ is magnetic flux density, $\\mu_0$ is the magnetic constant and $M$ is magnetization."^^qudt:LatexString,
    "$\\mathbf{H} = \\frac{\\mathbf{B} }{\\mu_0} - M$, where $\\mathbf{B} $ is magnetic flux density, $\\mu_0$ is the magnetic constant and $M$ is magnetization."^^qudt:LatexString;
  dct:isReplacedBy quantitykind:MagneticFieldStrength;
