unit:ARCSEC a qudt:Unit, qudt:Unit, qudt:DerivedUnit, qudt:DerivedUnit;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/unit>, <http://qudt.org/vocab/unit>;
  rdfs:label "ArcSecond"@en, "ArcSecond"@en;
  dct:description "\"Arc Second\" is a unit of angular measure, also called the $\\textit{second of arc}$, equal to $1/60 \\; arcminute$. One arcsecond is a very small angle: there are 1,296,000 in a circle. The SI recommends $\\textit{double prime}$ ($''$) as the symbol for the arcsecond. The symbol has become common in astronomy, where very small angles are stated in milliarcseconds ($mas$)."^^qudt:LatexString,
    "\"Arc Second\" is a unit of angular measure, also called the $\\textit{second of arc}$, equal to $1/60 \\; arcminute$. One arcsecond is a very small angle: there are 1,296,000 in a circle. The SI recommends $\\textit{double prime}$ ($''$) as the symbol for the arcsecond. The symbol has become common in astronomy, where very small angles are stated in milliarcseconds ($mas$)."^^qudt:LatexString;
  qudt:applicableSystem <http://qudt.org/vocab/sou/USCS>, <http://qudt.org/vocab/sou/USCS>;
  qudt:conversionMultiplier 0.00000484813681, 0.00000484813681;
  qudt:conversionMultiplierSN 4.84813681E-6, 4.84813681E-6;
  qudt:hasDimensionVector dimensionvector:A0E0L0I0M0H0T0D1, dimensionvector:A0E0L0I0M0H0T0D1;
  qudt:hasQuantityKind quantitykind:Angle, quantitykind:Angle, quantitykind:PlaneAngle,
    quantitykind:PlaneAngle;
  qudt:iec61360Code "0112/2///62720#UAA096", "0112/2///62720#UAA096";
  qudt:informativeReference "http://en.wikipedia.org/wiki/Minute_of_arc#Symbols.2C_abbreviations_and_subdivisions"^^xsd:anyURI,
    "http://en.wikipedia.org/wiki/Minute_of_arc#Symbols.2C_abbreviations_and_subdivisions"^^xsd:anyURI,
