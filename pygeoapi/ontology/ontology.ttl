unit:DEG_C a qudt:Unit, qudt:Unit, qudt:DerivedUnit, qudt:DerivedUnit;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/unit>, <http://qudt.org/vocab/unit>;
  rdfs:label "Celsius-fok"@hu, "Celsius-fok"@hu, "Grad Celsius"@de, "Grad Celsius"@de,
    "celsius"@tr, "celsius"@tr, "darjah celsius"@ms, "darjah celsius"@ms, "degree Celsius"@en,
    "degree Celsius"@en, "degré celsius"@fr, "degré celsius"@fr, "grad celsius"@ro, "grad celsius"@ro,
    "grado celsius"@es, "grado celsius"@es, "grado celsius"@it, "grado celsius"@it, "gradus celsii"@la,
    "gradus celsii"@la, "grau celsius"@pt, "grau celsius"@pt, "stopień celsjusza"@pl,
    "stopień celsjusza"@pl, "stopinja Celzija"@sl, "stopinja Celzija"@sl, "stupně celsia"@cs,
    "stupně celsia"@cs, "βαθμός Κελσίου"@el, "βαθμός Κελσίου"@el, "градус Целзий"@bg,
    "градус Целзий"@bg, "градус Цельсия"@ru, "градус Цельсия"@ru, "צלזיוס"@he, "צלזיוס"@he,
    "درجة مئوية"@ar, "درجة مئوية"@ar, "درجه سانتی گراد/سلسیوس"@fa, "درجه سانتی گراد/سلسیوس"@fa,
    "सेल्सियस"@hi, "सेल्सियस"@hi, "セルシウス度"@ja, "セルシウス度"@ja, "摄氏度"@zh, "摄氏度"@zh;
  dct:description """
  The unit $\\textit{Celsius}$, also known as centigrade, is a scale and unit of measurement for temperature. 
  It can refer to a specific temperature on the Celsius scale as well as a unit to indicate a temperature interval, 
  a difference between two temperatures or an uncertainty. 
  This definition fixes the magnitude of both the degree Celsius and the kelvin as precisely 1 part 
  in 273.16 (approximately 0.00366) of the difference between absolute zero and the triple point of water. 
  Thus, it sets the magnitude of one degree Celsius and that of one kelvin as exactly the same. 
  Additionally, it establishes the difference between the two scales' null points as being precisely $273.15^{\\circ}\\text{C}$.
  """^^qudt:LatexString,
    """
  The unit $\\textit{Celsius}$, also known as centigrade, is a scale and unit of measurement for temperature. 
  It can refer to a specific temperature on the Celsius scale as well as a unit to indicate a temperature interval, 
  a difference between two temperatures or an uncertainty. 
  This definition fixes the magnitude of both the degree Celsius and the kelvin as precisely 1 part 
  in 273.16 (approximately 0.00366) of the difference between absolute zero and the triple point of water. 
  Thus, it sets the magnitude of one degree Celsius and that of one kelvin as exactly the same. 
  Additionally, it establishes the difference between the two scales' null points as being precisely $273.15^{\\circ}\\text{C}$.
  """^^qudt:LatexString;
  skos:altLabel "degree-centigrade", "degree-centigrade";
  qudt:applicableSystem <http://qudt.org/vocab/sou/SI>, <http://qudt.org/vocab/sou/SI>,
    <http://qudt.org/vocab/sou/CGS>, <http://qudt.org/vocab/sou/CGS>;
  qudt:conversionMultiplier 1.0, 1.0;
  qudt:conversionMultiplierSN 1.0E0, 1.0E0;
  qudt:dbpediaMatch "http://dbpedia.org/resource/Celsius"^^xsd:anyURI, "http://dbpedia.org/resource/Celsius"^^xsd:anyURI;
  qudt:hasDimensionVector dimensionvector:A0E0L0I0M0H1T0D0, dimensionvector:A0E0L0I0M0H1T0D0;
  qudt:hasQuantityKind quantitykind:BoilingPoint, quantitykind:BoilingPoint, quantitykind:FlashPoint,
    quantitykind:FlashPoint, quantitykind:MeltingPoint, quantitykind:MeltingPoint, quantitykind:Temperature,
    quantitykind:Temperature;
  qudt:iec61360Code "0112/2///62720#UAA033", "0112/2///62720#UAA033";
  qudt:informativeReference "http://en.wikipedia.org/wiki/Celsius?oldid=494152178"^^xsd:anyURI,
    "http://en.wikipedia.org/wiki/Celsius?oldid=494152178"^^xsd:anyURI, "https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAA033"^^xsd:anyURI,
    "https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAA033"^^xsd:anyURI;
  qudt:omUnit <http://www.ontology-of-units-of-measure.org/resource/om-2/degreeCelsius>,
    <http://www.ontology-of-units-of-measure.org/resource/om-2/degreeCelsius>;
  qudt:siExactMatch <https://si-digital-framework.org/SI/units/degreeCelsius>, <https://si-digital-framework.org/SI/units/degreeCelsius>;
  qudt:symbol "°C", "°C";
  qudt:ucumCode "Cel"^^qudt:UCUMcs, "Cel"^^qudt:UCUMcs;
  qudt:udunitsCode "°C", "°C", "℃", "℃";
  qudt:uneceCommonCode "CEL", "CEL";
  qudt:expression "$degC$"^^qudt:LatexString, "$degC$"^^qudt:LatexString;
  qudt:conversionOffset 273.15, 273.15;
  qudt:conversionOffsetSN 2.7315E2, 2.7315E2;
  qudt:latexDefinition "$\\,^{\\circ}{C}$"^^qudt:LatexString, "$\\,^{\\circ}{C}$"^^qudt:LatexString;
  qudt:guidance "<p>See NIST section <a href=\"http://physics.nist.gov/Pubs/SP811/sec04.html#4.2.1.1\">SP811 section 4.2.1.1</a></p>"^^rdf:HTML,
    "<p>See NIST section <a href=\"http://physics.nist.gov/Pubs/SP811/sec04.html#4.2.1.1\">SP811 section 4.2.1.1</a></p>"^^rdf:HTML,
    "<p>See NIST section <a href=\"http://physics.nist.gov/Pubs/SP811/sec06.html#6.2.8\">SP811 section 6.2.8</a></p>"^^rdf:HTML,
    "<p>See NIST section <a href=\"http://physics.nist.gov/Pubs/SP811/sec06.html#6.2.8\">SP811 section 6.2.8</a></p>"^^rdf:HTML;
