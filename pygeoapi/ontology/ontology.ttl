unit:PER-SEC a qudt:DerivedUnit,
        qudt:Unit ;
    rdfs:label "Reciprocal Second"@en ;
    dct:description "A reciprical unit of time for $\\textit{reciprocal second}$ or $\\textit{inverse second}$. The $\\textit{Per Second}$ is a unit of rate."^^qudt:LatexString ;
    qudt:applicableSystem <http://qudt.org/vocab/sou/CGS>,
        <http://qudt.org/vocab/sou/CGS-EMU>,
