  rdfs:label "Capacitance"@en;
  rdfs:comment "Applicable units are those of quantitykind:Capacitance";
  dct:description "\"Capacitance\" is the ability of a body to hold an electrical charge; it is quantified as the amount of electric charge stored for a given electric potential. Capacitance is a scalar-valued quantity."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/dbpediaMatch> "http://dbpedia.org/resource/Capacitance"^^xsd:anyURI;
