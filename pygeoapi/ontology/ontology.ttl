unit:MicroMOL-PER-M2-SEC a <http://qudt.org/schema/qudt/Unit>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/unit>;
  rdfs:label "Micromoles per square metre second"@en;
  dct:description "One part per 10**6 (million) of the SI unit of quantity of matter (the mole) per SI unit area per SI unit of time.  This term is based on the number of photons in a certain waveband incident per unit time (s) on a unit area (m2) divided by the Avogadro constant (6.022 x 1023 mol-1). It is used commonly to describe PAR in the 400-700 nm waveband. Definition Source: Thimijan, Richard W., and Royal D. Heins. 1982. Photometric, Radiometric, and Quantum Light Units of Measure: A Review of Procedures for Interconversion. HortScience 18:818-822."@en;
  <http://qudt.org/schema/qudt/applicableSystem> <http://qudt.org/vocab/sou/SI>;
  <http://qudt.org/schema/qudt/conversionMultiplier> 0.000001;
  <http://qudt.org/schema/qudt/conversionMultiplierSN> 1.0E-6;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A1E0L-2I0M0H0T-1D0>;
  <http://qudt.org/schema/qudt/hasQuantityKind> <http://qudt.org/vocab/quantitykind/PhotosyntheticPhotonFluxDensity>;
  <http://qudt.org/schema/qudt/symbol> "μmol/(m²·s)";
  <http://qudt.org/schema/qudt/ucumCode> "umol.m-2.s-1"^^<http://qudt.org/schema/qudt/UCUMcs>,
    "umol/m2/s"^^<http://qudt.org/schema/qudt/UCUMcs> .

unit:MicroMOL-PER-M2-SEC2 a <http://qudt.org/schema/qudt/Unit>, <http://qudt.org/schema/qudt/DerivedUnit>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/unit>;
  rdfs:label "micromole per square meter per square second"@en-US, "micromole per square metre per square second"@en;
  dct:description "One part per 10**6 (million) of the SI unit of quantity of matter (the mole) per SI unit area per SI unit of time squared."@en;
  <http://qudt.org/schema/qudt/applicableSystem> <http://qudt.org/vocab/sou/SI>;
  <http://qudt.org/schema/qudt/conversionMultiplier> 0.000001;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A1E0L-2I0M0H0T-2D0>;
  <http://qudt.org/schema/qudt/hasQuantityKind> <http://qudt.org/vocab/quantitykind/Unknown>;
  <http://qudt.org/schema/qudt/symbol> "μmol/(m²·s²)";
  <http://qudt.org/schema/qudt/ucumCode> "umol.m-2.s-2"^^<http://qudt.org/schema/qudt/UCUMcs>;
  <http://qudt.org/schema/qudt/plainTextDescription> "One part per 10**6 (million) of the SI unit of quantity of matter (the mole) per SI unit area per SI unit of time squared." .

<http://qudt.org/vocab/dimensionvector/A1E0L-2I0M0H0T-2D0> a <http://qudt.org/schema/qudt/QuantityKindDimensionVector_SI>,
    <http://qudt.org/schema/qudt/QuantityKindDimensionVector_CGS>, <http://qudt.org/schema/qudt/QuantityKindDimensionVector_ISO>,
    <http://qudt.org/schema/qudt/QuantityKindDimensionVector_Imperial>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/dimensionvector>;
  rdfs:label "A1E0L-2I0M0H0T-2D0";
