quantitykind:ElectricDipoleMoment a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "Dipólový moment"@cs, "Dipólový moment"@cs, "Momen dwikutub elektrik"@ms,
    "Momen dwikutub elektrik"@ms, "electric dipole moment"@en, "electric dipole moment"@en,
    "elektrik dipol momenti"@tr, "elektrik dipol momenti"@tr, "elektrisches Dipolmoment"@de,
    "elektrisches Dipolmoment"@de, "elektryczny moment dipolowy"@pl, "elektryczny moment dipolowy"@pl,
    "moment dipolaire"@fr, "moment dipolaire"@fr, "moment electric dipolar"@ro, "moment electric dipolar"@ro,
    "momento de dipolo eléctrico"@es, "momento de dipolo eléctrico"@es, "momento di dipolo elettrico"@it,
    "momento di dipolo elettrico"@it, "momento do dipolo elétrico"@pt, "momento do dipolo elétrico"@pt,
    "Электрический дипольный момент"@ru, "Электрический дипольный момент"@ru, "عزم ثنائي قطب"@ar,
    "عزم ثنائي قطب"@ar, "گشتاور دوقطبی الکتریکی"@fa, "گشتاور دوقطبی الکتریکی"@fa, "विद्युत द्विध्रुव आघूर्ण"@hi,
    "विद्युत द्विध्रुव आघूर्ण"@hi, "电偶极矩"@zh, "电偶极矩"@zh, "電気双極子"@ja, "電気双極子"@ja;
  rdfs:comment "Applicable units are those of quantitykind:ElectricDipoleMoment", "Applicable units are those of quantitykind:ElectricDipoleMoment";
  dct:description "\"Electric Dipole Moment\" is a measure of the separation of positive and negative electrical charges in a system of (discrete or continuous) charges. It is a vector-valued quantity. If the system of charges is neutral, that is if the sum of all charges is zero, then the dipole moment of the system is independent of the choice of a reference frame; however in a non-neutral system, such as the dipole moment of a single proton, a dependence on the choice of reference point arises. In such cases it is conventional to choose the reference point to be the center of mass of the system or the center of charge, not some arbitrary origin. This convention ensures that the dipole moment is an intrinsic property of the system. The electric dipole moment of a substance within a domain is the vector sum of electric dipole moments of all electric dipoles included in the domain."^^qudt:LatexString,
    "\"Electric Dipole Moment\" is a measure of the separation of positive and negative electrical charges in a system of (discrete or continuous) charges. It is a vector-valued quantity. If the system of charges is neutral, that is if the sum of all charges is zero, then the dipole moment of the system is independent of the choice of a reference frame; however in a non-neutral system, such as the dipole moment of a single proton, a dependence on the choice of reference point arises. In such cases it is conventional to choose the reference point to be the center of mass of the system or the center of charge, not some arbitrary origin. This convention ensures that the dipole moment is an intrinsic property of the system. The electric dipole moment of a substance within a domain is the vector sum of electric dipole moments of all electric dipoles included in the domain."^^qudt:LatexString;
  qudt:hasDimensionVector dimensionvector:A0E1L1I0M0H0T1D0, dimensionvector:A0E1L1I0M0H0T1D0;
  qudt:iec61360Code "0112/2///62720#UAD041", "0112/2///62720#UAD041";
  qudt:informativeReference "http://www.iso.org/iso/home/store/catalogue_tc/catalogue_detail.htm?csnumber=31891"^^xsd:anyURI,
    "http://www.iso.org/iso/home/store/catalogue_tc/catalogue_detail.htm?csnumber=31891"^^xsd:anyURI,
    "http://en.wikipedia.org/wiki/Electric_dipole_moment"^^xsd:anyURI, "http://en.wikipedia.org/wiki/Electric_dipole_moment"^^xsd:anyURI,
    "https://cdd.iec.ch/cdd/iec61987/iec61987.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD041"^^xsd:anyURI,
    "https://cdd.iec.ch/cdd/iec61987/iec61987.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD041"^^xsd:anyURI;
  qudt:symbol "p", "p";
  qudt:isoNormativeReference "http://www.iso.org/iso/catalogue_detail?csnumber=31894"^^xsd:anyURI,
    "http://www.iso.org/iso/catalogue_detail?csnumber=31894"^^xsd:anyURI;
  qudt:plainTextDescription "\"Electric Dipole Moment\" is a measure of the separation of positive and negative electrical charges in a system of (discrete or continuous) charges. It is a vector-valued quantity. If the system of charges is neutral, that is if the sum of all charges is zero, then the dipole moment of the system is independent of the choice of a reference frame; however in a non-neutral system, such as the dipole moment of a single proton, a dependence on the choice of reference point arises. In such cases it is conventional to choose the reference point to be the center of mass of the system or the center of charge, not some arbitrary origin. This convention ensures that the dipole moment is an intrinsic property of the system. The electric dipole moment of a substance within a domain is the vector sum of electric dipole moments of all electric dipoles included in the domain.",
    "\"Electric Dipole Moment\" is a measure of the separation of positive and negative electrical charges in a system of (discrete or continuous) charges. It is a vector-valued quantity. If the system of charges is neutral, that is if the sum of all charges is zero, then the dipole moment of the system is independent of the choice of a reference frame; however in a non-neutral system, such as the dipole moment of a single proton, a dependence on the choice of reference point arises. In such cases it is conventional to choose the reference point to be the center of mass of the system or the center of charge, not some arbitrary origin. This convention ensures that the dipole moment is an intrinsic property of the system. The electric dipole moment of a substance within a domain is the vector sum of electric dipole moments of all electric dipoles included in the domain.";
  qudt:latexDefinition """$E_p = -p \\cdot E$, where $E_p$ is the interaction energy of the molecule with electric dipole moment $p$ and an electric field with electric field strength $E$.

$p = q(r_+ - r_i)$, where $r_+$ and $r_-$ are the position vectors to carriers of electric charge $a$ and $-q$, respectively."""^^qudt:LatexString,
    """$E_p = -p \\cdot E$, where $E_p$ is the interaction energy of the molecule with electric dipole moment $p$ and an electric field with electric field strength $E$.

$p = q(r_+ - r_i)$, where $r_+$ and $r_-$ are the position vectors to carriers of electric charge $a$ and $-q$, respectively."""^^qudt:LatexString;
  qudt:applicableUnit unit:C-M, unit:C-M, unit:Debye, unit:DEBYE .

