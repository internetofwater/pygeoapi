qudt:applicableSystem a owl:ObjectProperty, owl:ObjectProperty;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/schema/qudt>, <http://qudt.org/schema/qudt>;
  rdfs:label "applicable system", "applicable system";
