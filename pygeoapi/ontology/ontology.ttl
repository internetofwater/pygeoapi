  <http://qudt.org/schema/qudt/symbol> "slug/d";
  <http://qudt.org/schema/qudt/uneceCommonCode> "L63";
  <http://qudt.org/schema/qudt/plainTextDescription> "unit slug for mass according to an English engineering system divided by the unit day" .

