unit:M2-PER-MOL a <http://qudt.org/schema/qudt/Unit>, <http://qudt.org/schema/qudt/DerivedUnit>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/unit>;
  rdfs:label "Square Meter per Mole"@en-US, "Square Metre per Mole"@en;
  dct:description "Square Meter Per Mole (m2/mol) is a unit in the category of Specific Area. It is also known as square meters per mole, square metre per per, square metres per per, square meter/per, square metre/per. This unit is commonly used in the SI unit system. Square Meter Per Mole (m2/mol) has a dimension of M-1L2 where $M$ is mass, and $L$ is length. This unit is the standard SI unit in this category."^^rdf:HTML;
  <http://qudt.org/schema/qudt/applicableSystem> <http://qudt.org/vocab/sou/SI>;
  <http://qudt.org/schema/qudt/conversionMultiplier> 1.0;
  <http://qudt.org/schema/qudt/conversionMultiplierSN> 1.0E0;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A-1E0L2I0M0H0T0D0>;
  <http://qudt.org/schema/qudt/hasQuantityKind> <http://qudt.org/vocab/quantitykind/MolarAbsorptionCoefficient>,
    <http://qudt.org/vocab/quantitykind/MolarAttenuationCoefficient>;
  <http://qudt.org/schema/qudt/iec61360Code> "0112/2///62720#UAA751";
  <http://qudt.org/schema/qudt/informativeReference> "https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAA751"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/symbol> "m²/mol";
  <http://qudt.org/schema/qudt/ucumCode> "m2.mol-1"^^<http://qudt.org/schema/qudt/UCUMcs>,
    "m2/mol"^^<http://qudt.org/schema/qudt/UCUMcs>;
  <http://qudt.org/schema/qudt/uneceCommonCode> "D22";
  <http://qudt.org/schema/qudt/expression> "$m^2/mol$"^^<http://qudt.org/schema/qudt/LatexString>,
    "$m^{2}/mol$"^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/isoNormativeReference> "http://www.iso.org/iso/catalogue_detail?csnumber=31895"^^xsd:anyURI .

<http://qudt.org/vocab/dimensionvector/A-1E0L2I0M0H0T0D0> a <http://qudt.org/schema/qudt/QuantityKindDimensionVector_SI>,
    <http://qudt.org/schema/qudt/QuantityKindDimensionVector_CGS>, <http://qudt.org/schema/qudt/QuantityKindDimensionVector_ISO>,
    <http://qudt.org/schema/qudt/QuantityKindDimensionVector_Imperial>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/dimensionvector>;
  rdfs:label "A-1E0L2I0M0H0T0D0";
  <http://qudt.org/schema/qudt/dimensionExponentForAmountOfSubstance> -1;
  <http://qudt.org/schema/qudt/dimensionExponentForElectricCurrent> 0;
  <http://qudt.org/schema/qudt/dimensionExponentForLength> 2;
  <http://qudt.org/schema/qudt/dimensionExponentForLuminousIntensity> 0;
  <http://qudt.org/schema/qudt/dimensionExponentForMass> 0;
  <http://qudt.org/schema/qudt/dimensionExponentForThermodynamicTemperature> 0;
  <http://qudt.org/schema/qudt/dimensionExponentForTime> 0;
  <http://qudt.org/schema/qudt/dimensionlessExponent> 0 .

<http://qudt.org/vocab/quantitykind/MolarAbsorptionCoefficient> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Molar Absorption Coefficient"@en;
  rdfs:comment "Applicable units are those of quantitykind:MolarAbsorptionCoefficient";
  dct:description "\"Molar Absorption Coefficient\" is a spectrophotometric unit indicating the light a substance absorbs with respect to length, usually centimeters, and concentration, usually moles per liter."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A-1E0L2I0M0H0T0D0>;
  <http://qudt.org/schema/qudt/informativeReference> "http://medical-dictionary.thefreedictionary.com/molar+absorption+coefficient"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/symbol> "x";
  <http://qudt.org/schema/qudt/plainTextDescription> "\"Molar Absorption Coefficient\" is a spectrophotometric unit indicating the light a substance absorbs with respect to length, usually centimeters, and concentration, usually moles per liter.";
  <http://qudt.org/schema/qudt/exactMatch> <http://qudt.org/vocab/quantitykind/MolarAttenuationCoefficient>;
  <http://qudt.org/schema/qudt/latexDefinition> "$x = aV_m$, where $a$ is the linear absorption coefficient and $V_m$ is the molar volume."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/applicableUnit> unit:M2-PER-MOL .

<http://qudt.org/vocab/quantitykind/MolarAttenuationCoefficient> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Molar Attenuation Coefficient"@en;
  rdfs:comment "Applicable units are those of quantitykind:MolarAttenuationCoefficient";
  dct:description "\"Molar Attenuation Coefficient\" is a measurement of how strongly a chemical species or substance absorbs or scatters light at a given wavelength, per amount of substance."^^<http://qudt.org/schema/qudt/LatexString>;
  skos:closeMatch <http://qudt.org/vocab/quantitykind/MassAttenuationCoefficient>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A-1E0L2I0M0H0T0D0>;
  <http://qudt.org/schema/qudt/iec61360Code> "0112/2///62720#UAD120";
  <http://qudt.org/schema/qudt/informativeReference> "http://en.wikipedia.org/wiki/Mass_attenuation_coefficient"^^xsd:anyURI,
    "https://cdd.iec.ch/cdd/iec61987/iec61987.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD120"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/isoNormativeReference> "http://www.iso.org/iso/catalogue_detail?csnumber=31895"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/plainTextDescription> "\"Molar Attenuation Coefficient\" is a measurement of how strongly a chemical species or substance absorbs or scatters light at a given wavelength, per amount of substance.";
  <http://qudt.org/schema/qudt/exactMatch> <http://qudt.org/vocab/quantitykind/MolarAbsorptionCoefficient>;
  <http://qudt.org/schema/qudt/latexSymbol> "$\\mu_c$"^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/latexDefinition> "$\\mu_c = -\\frac{\\mu}{c}$, where $\\mu$ is the linear attenuation coefficient and $c$ is the amount-of-substance concentration."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/applicableUnit> unit:M2-PER-MOL .

unit:M2-PER-N a <http://qudt.org/schema/qudt/Unit>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/unit>;
  rdfs:label "Square Meter per Newton"@en-US, "Square Metre per Newton"@en;
  dct:description "power of the SI base unit metre with the exponent 2 divided by the derived SI unit newton"^^rdf:HTML;
  <http://qudt.org/schema/qudt/applicableSystem> <http://qudt.org/vocab/sou/CGS-EMU>,
    <http://qudt.org/vocab/sou/CGS-GAUSS>, <http://qudt.org/vocab/sou/SI>, <http://qudt.org/vocab/sou/CGS>;
  <http://qudt.org/schema/qudt/conversionMultiplier> 1.0;
  <http://qudt.org/schema/qudt/conversionMultiplierSN> 1.0E0;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L1I0M-1H0T2D0>;
  <http://qudt.org/schema/qudt/hasQuantityKind> <http://qudt.org/vocab/quantitykind/Compressibility>;
  <http://qudt.org/schema/qudt/iec61360Code> "0112/2///62720#UAB492";
  <http://qudt.org/schema/qudt/informativeReference> "https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAB492"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/symbol> "m²/N";
  <http://qudt.org/schema/qudt/ucumCode> "m2.N-1"^^<http://qudt.org/schema/qudt/UCUMcs>;
  <http://qudt.org/schema/qudt/uneceCommonCode> "H59";
  <http://qudt.org/schema/qudt/plainTextDescription> "power of the SI base unit metre with the exponent 2 divided by the derived SI unit newton" .

<http://qudt.org/vocab/quantitykind/Compressibility> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Compressibility"@en;
  rdfs:comment "Applicable units are those of quantitykind:Compressibility";
  dct:description "Compressibility is a measure of the relative volume change of a fluid or solid as a response to a pressure (or mean stress) change."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L1I0M-1H0T2D0>;
  <http://qudt.org/schema/qudt/iec61360Code> "0112/2///62720#UAD024";
  <http://qudt.org/schema/qudt/informativeReference> "http://en.wikipedia.org/wiki/Compressibility"^^xsd:anyURI,
    "https://cdd.iec.ch/cdd/iec61987/iec61987.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD024"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/isoNormativeReference> "http://www.iso.org/iso/catalogue_detail?csnumber=31889"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/plainTextDescription> "Compressibility is a measure of the relative volume change of a fluid or solid as a response to a pressure (or mean stress) change.";
  <http://qudt.org/schema/qudt/latexSymbol> "$\\chi$"^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/latexDefinition> "$\\chi = -(\\frac{1}{V})\\frac{dV}{d\\rho}$, where $V$ is volume and $p$ is pressure."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/applicableUnit> unit:M2-PER-N, unit:PER-BAR, unit:PER-MILLE-PSI,
    unit:PER-MegaPA, unit:PER-PA, unit:PERCENT-PER-BAR, unit:PERCENT-PER-HectoBAR .

unit:M2-PER-SEC a <http://qudt.org/schema/qudt/Unit>, <http://qudt.org/schema/qudt/DerivedUnit>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/unit>;
  rdfs:label "Quadratmeter je Sekunde"@de, "Square Meter per Second"@en-US, "kvadratni meter na sekundo"@sl,
    "meter persegi per saat"@ms, "metr kwadratowy na sekundę"@pl, "metrekare bölü saniye"@tr,
    "metro cuadrado por segundo"@es, "metro quadrado por segundo"@pt, "metro quadrato al secondo"@it,
    "metru pătrat pe secundă"@ro, "mètre carré par seconde"@fr, "square metre per second"@en,
    "čtvereční metr za sekundu"@cs, "квадратный метр в секунду"@ru, "متر مربع بر ثانیه"@fa,
    "متر مربع في الثانية"@ar, "वर्ग मीटर प्रति सैकिण्ड"@hi, "平方メートル毎秒"@ja, "平方米每秒"@zh;
  dct:description """
  The unit $\\textit{Square Metres per Second}$ is the SI derived unit of angular momentum, defined by distance
   or displacement in metres multiplied by distance again in metres and divided by time in seconds. 
  The unit is written in symbols as $m^2/s$ or $m^22s^{-1}$. 
  It may be better understood when phrased as $\\textit{metres per second times metres}$, i.e. the momentum
   of an object with respect to a position.
  """^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/applicableSystem> <http://qudt.org/vocab/sou/CGS-EMU>,
    <http://qudt.org/vocab/sou/CGS-GAUSS>, <http://qudt.org/vocab/sou/SI>, <http://qudt.org/vocab/sou/CGS>;
  <http://qudt.org/schema/qudt/conversionMultiplier> 1.0;
  <http://qudt.org/schema/qudt/conversionMultiplierSN> 1.0E0;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L2I0M0H0T-1D0>;
  <http://qudt.org/schema/qudt/hasQuantityKind> <http://qudt.org/vocab/quantitykind/AreaPerTime>,
    <http://qudt.org/vocab/quantitykind/DiffusionCoefficient>, <http://qudt.org/vocab/quantitykind/NeutronDiffusionCoefficient>,
    <http://qudt.org/vocab/quantitykind/ThermalDiffusionRatioCoefficient>;
  <http://qudt.org/schema/qudt/iec61360Code> "0112/2///62720#UAA752", "0112/2///62720#UAD526";
  <http://qudt.org/schema/qudt/informativeReference> "https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAA752"^^xsd:anyURI,
    "https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAD526"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/symbol> "m²/s";
  <http://qudt.org/schema/qudt/ucumCode> "m2.s-1"^^<http://qudt.org/schema/qudt/UCUMcs>,
    "m2/s"^^<http://qudt.org/schema/qudt/UCUMcs>;
  <http://qudt.org/schema/qudt/uneceCommonCode> "S4";
  <http://qudt.org/schema/qudt/expression> "$m^{2} s^{-1}$"^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/derivedCoherentUnitOfSystem> <http://qudt.org/vocab/sou/SI>;
  <http://qudt.org/schema/qudt/definedUnitOfSystem> <http://qudt.org/vocab/sou/SI> .

<http://qudt.org/vocab/quantitykind/DiffusionCoefficient> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Diffusionskoeffizient"@de, "coefficient de diffusion"@fr, "coefficiente di diffusione"@it,
    "coeficiente de difusión"@es, "coeficiente de difusão"@pt, "diffusion coefficient"@en,
    "difuzijski koeficient"@sl;
  rdfs:comment "Applicable units are those of quantitykind:DiffusionCoefficient";
  dct:description "The \"Diffusion Coefficient\" is a proportionality constant between the molar flux due to molecular diffusion and the gradient in the concentration of the species (or the driving force for diffusion). Diffusivity is encountered in Fick's law and numerous other equations of physical chemistry."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L2I0M0H0T-1D0>;
  <http://qudt.org/schema/qudt/iec61360Code> "0112/2///62720#UAD031";
  <http://qudt.org/schema/qudt/informativeReference> "http://en.wikipedia.org/wiki/Mass_diffusivity"^^xsd:anyURI,
    "https://cdd.iec.ch/cdd/iec61987/iec61987.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD031"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/symbol> "D";
  <http://qudt.org/schema/qudt/isoNormativeReference> "http://www.iso.org/iso/catalogue_detail?csnumber=31894"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/plainTextDescription> "The \"Diffusion Coefficient\" is a proportionality constant between the molar flux due to molecular diffusion and the gradient in the concentration of the species (or the driving force for diffusion). Diffusivity is encountered in Fick's law and numerous other equations of physical chemistry.";
  <http://qudt.org/schema/qudt/latexDefinition> "$C_B \\left \\langle \\nu_B \\right \\rangle = -D grad C_B$, where $C_B$ the local molecular concentration of substance $B$ in the mixture and $\\left \\langle \\nu_B \\right \\rangle$ is the local average velocity of the molecules of $B$."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/applicableUnit> unit:M2-PER-SEC .

<http://qudt.org/vocab/quantitykind/NeutronDiffusionCoefficient> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Diffusionskoeffizient"@de, "coefficient de diffusion"@fr, "coefficiente di diffusione"@it,
    "coeficiente de difusión"@es, "coeficiente de difusão"@pt, "diffusion coefficient"@en,
    "difuzijski koeficient"@sl;
  rdfs:comment "Applicable units are those of quantitykind:NeutronDiffusionCoefficient";
  dct:description "The \"Diffusion Coefficient\" is "^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L2I0M0H0T-1D0>;
  <http://qudt.org/schema/qudt/informativeReference> "http://encyclopedia2.thefreedictionary.com/Diffusion+of+Neutrons"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/symbol> "D";
  <http://qudt.org/schema/qudt/isoNormativeReference> "http://www.iso.org/iso/catalogue_detail?csnumber=31895"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/plainTextDescription> "The \"Diffusion Coefficient\" is ";
  <http://qudt.org/schema/qudt/latexDefinition> "$D_n = -\\frac{J_x}{\\frac{\\partial dn}{\\partial dx}}$, where $J_x$ is the $x-component$ of the particle current and $n$ is the particle number density."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/applicableUnit> unit:M2-PER-SEC .

<http://qudt.org/vocab/quantitykind/ThermalDiffusionRatioCoefficient> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Thermal Diffusion Coefficient"@en;
  rdfs:comment "Applicable units are those of quantitykind:ThermalDiffusionRatioCoefficient";
  dct:description "The \"Thermal Diffusion Coefficient\" is ."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L2I0M0H0T-1D0>;
  <http://qudt.org/schema/qudt/informativeReference> "http://www.thermopedia.com/content/1189/"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/symbol> "D_T";
  <http://qudt.org/schema/qudt/isoNormativeReference> "http://www.iso.org/iso/catalogue_detail?csnumber=31894"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/plainTextDescription> "The \"Thermal Diffusion Coefficient\" is .";
  <http://qudt.org/schema/qudt/latexDefinition> "$D_T  = kT \\cdot D$, where $k_T$ is the thermal diffusion ratio, and $D$ is the diffusion coefficient."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/applicableUnit> unit:M2-PER-SEC .

unit:M2-PER-SEC-BAR a <http://qudt.org/schema/qudt/Unit>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/unit>;
  rdfs:label "square metre per second bar";
  dct:description """
  The unit $\\textit{Square Metre per Second Bar}$ typically refers to a measure of fluid permeability in the
   context of materials science or engineering.
  It is the volume of fluid (in square metres) that can pass through a material in one second under a pressure difference of one bar. 
  This unit is particularly important in fields such as petrophysics, hydrogeology, and materials engineering,
   where understanding the flow of fluids through porous media is crucial.
  A $Bar$ is not an SI unit but is a unit of pressure that is widely used in various scientific and engineering contexts.
  A bar is equal to $100,000\\ pascals$, (symbol $Pa$), approximately equal to the atmospheric pressure on Earth at sea level.
  """^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/conversionMultiplier> 0.00001;
  <http://qudt.org/schema/qudt/conversionMultiplierSN> 1.0E-5;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L3I0M-1H0T1D0>;
  <http://qudt.org/schema/qudt/hasQuantityKind> <http://qudt.org/vocab/quantitykind/Unknown>;
  <http://qudt.org/schema/qudt/iec61360Code> "0112/2///62720#UAB493";
  <http://qudt.org/schema/qudt/informativeReference> "https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAB493"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/symbol> "m²/(s·bar)";
  <http://qudt.org/schema/qudt/ucumCode> "m2.s-1.bar-1"^^<http://qudt.org/schema/qudt/UCUMcs>;
  <http://qudt.org/schema/qudt/uneceCommonCode> "G41" .

<http://qudt.org/vocab/dimensionvector/A0E0L3I0M-1H0T1D0> a <http://qudt.org/schema/qudt/QuantityKindDimensionVector>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/dimensionvector>;
  rdfs:label "A0E0L3I0M-1H0T1D0";
  <http://qudt.org/schema/qudt/latexDefinition> "$L^3 M^-1 T $"^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/dimensionExponentForAmountOfSubstance> 0;
  <http://qudt.org/schema/qudt/dimensionExponentForElectricCurrent> 0;
  <http://qudt.org/schema/qudt/dimensionExponentForLength> 3;
  <http://qudt.org/schema/qudt/dimensionExponentForLuminousIntensity> 0;
