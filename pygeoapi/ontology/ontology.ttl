quantitykind:PhotosyntheticPhotonFluxDensity a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "Photosynthetic Photon Flux Density"@en, "Photosynthetic Photon Flux Density"@en;
  rdfs:comment "Applicable units are those of quantitykind:PhotosyntheticPhotonFluxDensity",
    "Applicable units are those of quantitykind:PhotosyntheticPhotonFluxDensity";
  dct:description "Photosynthetically Active Radiation are the wavelengths of light within the visible range of 400 to 700 nanometers (nm) that are critical for photosynthesis. PPFD measures the amount of PAR light (photons) that arrive at the plant’s surface each second. The PPFD is measured at various distances with a Full-spectrum Quantum Sensor, also known as a PAR meter. Natural sunlight has a PAR value of 900-1500μMol/m2/s when the sun is directly overhead. For a grow light to be effective, it should have PAR values of 500-1500 μMol/m2/s."^^qudt:LatexString,
    "Photosynthetically Active Radiation are the wavelengths of light within the visible range of 400 to 700 nanometers (nm) that are critical for photosynthesis. PPFD measures the amount of PAR light (photons) that arrive at the plant’s surface each second. The PPFD is measured at various distances with a Full-spectrum Quantum Sensor, also known as a PAR meter. Natural sunlight has a PAR value of 900-1500μMol/m2/s when the sun is directly overhead. For a grow light to be effective, it should have PAR values of 500-1500 μMol/m2/s."^^qudt:LatexString;
  skos:altLabel "PPFD", "PPFD";
  qudt:hasDimensionVector dimensionvector:A1E0L-2I0M0H0T-1D0, dimensionvector:A1E0L-2I0M0H0T-1D0;
  qudt:informativeReference "https://www.gigahertz-optik.com/en-us/service-and-support/knowledge-base/measurement-of-par/"^^xsd:anyURI,
    "https://www.gigahertz-optik.com/en-us/service-and-support/knowledge-base/measurement-of-par/"^^xsd:anyURI;
  qudt:plainTextDescription "Photosynthetically Active Radiation are the wavelengths of light within the visible range of 400 to 700 nanometers (nm) that are critical for photosynthesis. PPFD measures the amount of PAR light (photons) that arrive at the plant’s surface each second. The PPFD is measured at various distances with a Full-spectrum Quantum Sensor, also known as a PAR meter. Natural sunlight has a PAR value of 900-1500μMol/m2/s when the sun is directly overhead. For a grow light to be effective, it should have PAR values of 500-1500 μMol/m2/s.",
    "Photosynthetically Active Radiation are the wavelengths of light within the visible range of 400 to 700 nanometers (nm) that are critical for photosynthesis. PPFD measures the amount of PAR light (photons) that arrive at the plant’s surface each second. The PPFD is measured at various distances with a Full-spectrum Quantum Sensor, also known as a PAR meter. Natural sunlight has a PAR value of 900-1500μMol/m2/s when the sun is directly overhead. For a grow light to be effective, it should have PAR values of 500-1500 μMol/m2/s.";
  <http://www.w3.org/ns/prov#wasDerivedFrom> <https://www.dormgrow.com/par>, <https://www.dormgrow.com/par>;
  qudt:applicableUnit unit:MOL-PER-M2-DAY, unit:MOL-PER-M2-DAY, unit:MOL-PER-M2-SEC,
    unit:MOL-PER-M2-SEC, unit:MicroMOL-PER-M2-DAY, unit:MicroMOL-PER-M2-DAY, unit:MicroMOL-PER-M2-HR,
    unit:MicroMOL-PER-M2-HR, unit:MicroMOL-PER-M2-SEC, unit:MicroMOL-PER-M2-SEC, unit:MilliMOL-PER-M2-DAY,
    unit:MilliMOL-PER-M2-DAY, unit:MilliMOL-PER-M2-SEC, unit:MilliMOL-PER-M2-SEC, unit:NanoMOL-PER-M2-DAY,
    unit:NanoMOL-PER-M2-DAY, unit:PicoMOL-PER-M2-DAY, unit:PicoMOL-PER-M2-DAY .

