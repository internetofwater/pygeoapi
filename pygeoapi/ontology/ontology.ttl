variablename:dysprosium a skos:Concept ;
    skos:definition "Dysprosium is a chemical element with symbol Dy and atomic number 66. It is a rare earth element with a metallic silver luster. Dysprosium is never found in nature as a free element, though it is found in various minerals, such as xenotime. Naturally occurring dysprosium is composed of seven isotopes, the most abundant of which is 164Dy." ;
    skos:exactMatch "https://en.wikipedia.org/wiki/Dysprosium" ;
    skos:historyNote "Wikipedia" ;
    skos:inScheme <http://vocabulary.odm2.org/variablename> ;
    skos:note "Added to support Critical Zone Observatory (CZO) data use cases. " ;
    skos:prefLabel "Dysprosium" ;
    skos:topConceptOf <http://vocabulary.odm2.org/variablename> .

variablename:dysprosiumDissolved a skos:Concept ;
    skos:definition "Dissolved dysprosium (Dy). \"Dissolved \" indicates a the measurement was made on a filtered sample." ;
    skos:exactMatch "https://en.wikipedia.org/wiki/Dysprosium" ;
    skos:historyNote "Wikipedia" ;
    skos:inScheme <http://vocabulary.odm2.org/variablename> ;
    skos:note "Added to support Critical Zone Observatory (CZO) data use cases. " ;
    skos:prefLabel "Dysprosium, dissolved" ;
    skos:topConceptOf <http://vocabulary.odm2.org/variablename> .

variablename:effectiveEnergyAndMassTransfer a skos:Concept ;
    skos:definition "Effective energy and mass transfer (EEMT) couples energy and mass flux to the subsurface in the form of effective precipitation and net primary production in a common energy unit." ;
    skos:exactMatch "https://doi.org/10.5194/hess-16-725-2012" ;
    skos:inScheme <http://vocabulary.odm2.org/variablename> ;
    skos:note "Added to support Critical Zone Observatory (CZO) data use cases. " ;
    skos:prefLabel "Effective energy and mass transfer (EEMT)" ;
    skos:topConceptOf <http://vocabulary.odm2.org/variablename> .

