  dct:creator "Faith Sternlieb"@en, "Kyle Onda"@en, "Sara Larsen"@en;
  skos:definition "Amount of water currently stored in a reservoir, usually expressed as a percentage of its total storage capacity "@en;
  skos:inScheme variablename:conceptScheme_7c70597b;
  skos:topConceptOf variablename:conceptScheme_7c70597b;
  skos:prefLabel "Storage"@en;
  skos:altLabel "Capacity"@en, "Volume"@en, "Content"@en;
  skos:note "Preferred Unit: (kilo) Acre/ft (kaf), Millions acre feet (maf) "@en, "Timestep: daily"@en,
    "Kinds (from Sara Larsen) : 1) Actual -  % of capacity or % full 2) Total - Capacity of reservoir"@en .

variablename:c_1ebf5e4c a skos:Concept;
  dct:creator "Faith Sternlieb"@en, "Sara Larsen"@en;
  skos:definition """Amount of water entering a reservoir from upstream sources.  Usually measured in cubic feet per second (CFS) or cubic meters per second (CMS). Typically tied to streamgage data. Usually upstream of reservoir.  Can be multiple inflows to a reservoir.  

"""@en;
  skos:inScheme variablename:conceptScheme_7c70597b;
  skos:topConceptOf variablename:conceptScheme_7c70597b;
  skos:prefLabel "Inflow"@en;
  skos:altLabel "streamflow"@en, "upstream"@en;
  skos:editorialNote "Preferred Units: CFS, CMS (scientific)"@en, "Timestap: Daily"@en .

variablename:c_8a7f273a a skos:Concept;
  dct:creator "Faith Sternlieb"@en, "Sara Larsen"@en;
  skos:definition "Amount of water leaving a reservoir usually through controlled release mechanisms. Usually measured in cubic feet per second (CFS) or cubic meters per second (CMS) "@en;
  skos:inScheme variablename:conceptScheme_7c70597b;
  skos:topConceptOf variablename:conceptScheme_7c70597b;
  skos:prefLabel "Outflow"@en;
  skos:altLabel "Release"@en, "Release to stream"@en, "stream release"@en;
  skos:editorialNote "Preferred Unit: CFS, CMS (scientific)"@en, "Timestep: Daily"@en,
    """(from Sara Larsen) Power/Turbine release – how much of total release goes through turbine  

Spillway release – when water enters too fast water is diverted to a gate/spillway release.  Also called emergency release. 

Bypass – tubes that allow water to be bypassed 

 

Above 3 should add to total outflow 

 

Summary of inflows->outflows are typically expressed as acre-ft/day or acre-ft/month"""@en .

