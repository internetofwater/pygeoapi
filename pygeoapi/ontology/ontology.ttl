  qudt:hasDimensionVector dimensionvector:A0E0L-4I0M1H0T-3D0;
  qudt:plainTextDescription "Spectral Irradiance is a radiometry term for the power per unit area of electromagnetic radiation per unit wavelength incident at a surface.";
  qudt:applicableUnit unit:W-PER-M2-MicroM .

