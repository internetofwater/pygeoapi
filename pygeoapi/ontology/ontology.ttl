<http://qudt.org/vocab/quantitykind/HeatingValue> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Calorific Value"@en;
  rdfs:comment "Applicable units are those of quantitykind:SpecificEnergy";
  dct:description "The heating value (or energy value or calorific value) of a substance, usually a fuel or food (see food energy), is the amount of heat released during the combustion of a specified amount of it. "^^<http://qudt.org/schema/qudt/LatexString>;
  skos:altLabel "Energy Value"@en, "Heating Value"@en;
  skos:broader <http://qudt.org/vocab/quantitykind/SpecificEnergy>;
