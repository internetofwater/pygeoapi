  rdfs:label "qualifiedCardinality", "qualifiedCardinality";
  rdfs:comment "The property that determines the cardinality of an exact qualified cardinality restriction.",
    "The property that determines the cardinality of an exact qualified cardinality restriction.";
  rdfs:range xsd:nonNegativeInteger, xsd:nonNegativeInteger;
  rdfs:domain owl:Restriction, owl:Restriction .

owl:sameAs a rdf:Property, rdf:Property;
  rdfs:isDefinedBy <http://www.w3.org/2002/07/owl#>, <http://www.w3.org/2002/07/owl#>;
  rdfs:label "sameAs", "sameAs";
  rdfs:comment "The property that determines that two given individuals are equal.",
    "The property that determines that two given individuals are equal.";
  rdfs:range owl:Thing, owl:Thing;
  rdfs:domain owl:Thing, owl:Thing .

owl:someValuesFrom a rdf:Property, rdf:Property;
  rdfs:isDefinedBy <http://www.w3.org/2002/07/owl#>, <http://www.w3.org/2002/07/owl#>;
  rdfs:label "someValuesFrom", "someValuesFrom";
  rdfs:comment "The property that determines the class that an existential property restriction refers to.",
    "The property that determines the class that an existential property restriction refers to.";
  rdfs:range rdfs:Class, rdfs:Class;
  rdfs:domain owl:Restriction, owl:Restriction .

owl:sourceIndividual a rdf:Property, rdf:Property;
  rdfs:isDefinedBy <http://www.w3.org/2002/07/owl#>, <http://www.w3.org/2002/07/owl#>;
  rdfs:label "sourceIndividual", "sourceIndividual";
  rdfs:comment "The property that determines the subject of a negative property assertion.",
    "The property that determines the subject of a negative property assertion.";
  rdfs:range owl:Thing, owl:Thing;
  rdfs:domain owl:NegativePropertyAssertion, owl:NegativePropertyAssertion .

owl:targetIndividual a rdf:Property, rdf:Property;
  rdfs:isDefinedBy <http://www.w3.org/2002/07/owl#>, <http://www.w3.org/2002/07/owl#>;
  rdfs:label "targetIndividual", "targetIndividual";
  rdfs:comment "The property that determines the object of a negative object property assertion.",
    "The property that determines the object of a negative object property assertion.";
  rdfs:range owl:Thing, owl:Thing;
  rdfs:domain owl:NegativePropertyAssertion, owl:NegativePropertyAssertion .

owl:targetValue a rdf:Property, rdf:Property;
  rdfs:isDefinedBy <http://www.w3.org/2002/07/owl#>, <http://www.w3.org/2002/07/owl#>;
  rdfs:label "targetValue", "targetValue";
  rdfs:comment "The property that determines the value of a negative data property assertion.",
    "The property that determines the value of a negative data property assertion.";
  rdfs:range rdfs:Literal, rdfs:Literal;
  rdfs:domain owl:NegativePropertyAssertion, owl:NegativePropertyAssertion .

owl:topDataProperty a owl:DatatypeProperty, owl:DatatypeProperty;
  rdfs:isDefinedBy <http://www.w3.org/2002/07/owl#>, <http://www.w3.org/2002/07/owl#>;
  rdfs:label "topDataProperty", "topDataProperty";
  rdfs:comment "The data property that relates every individual to every data value.",
    "The data property that relates every individual to every data value.";
  rdfs:range rdfs:Literal, rdfs:Literal;
  rdfs:domain owl:Thing, owl:Thing .

owl:topObjectProperty a owl:ObjectProperty, owl:ObjectProperty;
  rdfs:isDefinedBy <http://www.w3.org/2002/07/owl#>, <http://www.w3.org/2002/07/owl#>;
  rdfs:label "topObjectProperty", "topObjectProperty";
  rdfs:comment "The object property that relates every two individuals.", "The object property that relates every two individuals.";
  rdfs:range owl:Thing, owl:Thing;
  rdfs:domain owl:Thing, owl:Thing .

owl:unionOf a rdf:Property, rdf:Property;
  rdfs:isDefinedBy <http://www.w3.org/2002/07/owl#>, <http://www.w3.org/2002/07/owl#>;
  rdfs:label "unionOf", "unionOf";
  rdfs:comment "The property that determines the collection of classes or data ranges that build a union.",
    "The property that determines the collection of classes or data ranges that build a union.";
  rdfs:range rdf:List, rdf:List;
  rdfs:domain rdfs:Class, rdfs:Class .

owl:withRestrictions a rdf:Property, rdf:Property;
  rdfs:isDefinedBy <http://www.w3.org/2002/07/owl#>, <http://www.w3.org/2002/07/owl#>;
  rdfs:label "withRestrictions", "withRestrictions";
  rdfs:comment "The property that determines the collection of facet-value pairs that define a datatype restriction.",
    "The property that determines the collection of facet-value pairs that define a datatype restriction.";
  rdfs:range rdf:List, rdf:List;
  rdfs:domain rdfs:Datatype, rdfs:Datatype .

<http://www.w3.org/2000/01/rdf-schema#> a owl:Ontology, owl:Ontology;
  dc:title "The RDF Schema vocabulary (RDFS)", "The RDF Schema vocabulary (RDFS)";
  rdfs:seeAlso <http://www.w3.org/2000/01/rdf-schema-more>, <http://www.w3.org/2000/01/rdf-schema-more> .

rdfs:subPropertyOf a rdf:Property, rdf:Property;
  rdfs:isDefinedBy <http://www.w3.org/2000/01/rdf-schema#>, <http://www.w3.org/2000/01/rdf-schema#>;
  rdfs:label "subPropertyOf", "subPropertyOf";
  rdfs:comment "The subject is a subproperty of a property.", "The subject is a subproperty of a property.";
  rdfs:range rdf:Property, rdf:Property;
  rdfs:domain rdf:Property, rdf:Property .

rdfs:ContainerMembershipProperty a rdfs:Class, rdfs:Class;
  rdfs:subClassOf rdf:Property, rdf:Property;
  rdfs:isDefinedBy <http://www.w3.org/2000/01/rdf-schema#>, <http://www.w3.org/2000/01/rdf-schema#>;
  rdfs:label "ContainerMembershipProperty", "ContainerMembershipProperty";
  rdfs:comment """The class of container membership properties, rdf:_1, rdf:_2, ...,
                    all of which are sub-properties of 'member'.""",
    """The class of container membership properties, rdf:_1, rdf:_2, ...,
                    all of which are sub-properties of 'member'.""" .

rdfs:member a rdf:Property, rdf:Property;
  rdfs:isDefinedBy <http://www.w3.org/2000/01/rdf-schema#>, <http://www.w3.org/2000/01/rdf-schema#>;
  rdfs:label "member", "member";
  rdfs:comment "A member of the subject resource.", "A member of the subject resource.";
  rdfs:range rdfs:Resource, rdfs:Resource;
  rdfs:domain rdfs:Resource, rdfs:Resource .

<http://www.w3.org/2004/02/skos/core> a owl:Ontology, owl:Ontology;
  rdfs:seeAlso <http://www.w3.org/TR/skos-reference/>, <http://www.w3.org/TR/skos-reference/>;
  dct:title "SKOS Vocabulary"@en, "SKOS Vocabulary"@en;
  dct:contributor "Dave Beckett", "Dave Beckett", "Nikki Rogers", "Nikki Rogers", "Participants in W3C's Semantic Web Deployment Working Group.",
    "Participants in W3C's Semantic Web Deployment Working Group.";
  dct:description "An RDF vocabulary for describing the basic structure and content of concept schemes such as thesauri, classification schemes, subject heading lists, taxonomies, 'folksonomies', other types of controlled vocabulary, and also concept schemes embedded in glossaries and terminologies."@en,
    "An RDF vocabulary for describing the basic structure and content of concept schemes such as thesauri, classification schemes, subject heading lists, taxonomies, 'folksonomies', other types of controlled vocabulary, and also concept schemes embedded in glossaries and terminologies."@en;
  dct:creator "Alistair Miles", "Alistair Miles", "Sean Bechhofer", "Sean Bechhofer" .

dct:title a rdf:Property, rdf:Property, owl:AnnotationProperty, owl:AnnotationProperty;
  rdfs:isDefinedBy <http://purl.org/dc/terms/>, <http://purl.org/dc/terms/>;
  rdfs:label "title", "title", "Title"@en, "Title"@en;
  rdfs:comment "A name given to the resource."@en, "A name given to the resource."@en;
  rdfs:range xsd:string, xsd:string, rdfs:Literal, rdfs:Literal;
  rdfs:subPropertyOf dc:title, dc:title;
  dct:issued "2008-01-14"^^xsd:date, "2008-01-14"^^xsd:date .

dct:contributor a rdf:Property, rdf:Property, rdf:Property, rdf:Property;
  rdfs:isDefinedBy <http://purl.org/dc/terms/>, <http://purl.org/dc/terms/>;
  rdfs:label "contributor", "contributor", "Contributor"@en, "Contributor"@en;
  rdfs:comment "An entity responsible for making contributions to the resource."@en,
    "An entity responsible for making contributions to the resource."@en;
  rdfs:subPropertyOf dc:contributor, dc:contributor;
  dct:description "The guidelines for using names of persons or organizations as creators apply to contributors."@en,
    "The guidelines for using names of persons or organizations as creators apply to contributors."@en;
  dct:issued "2008-01-14"^^xsd:date, "2008-01-14"^^xsd:date;
  <http://purl.org/dc/dcam/rangeIncludes> dct:Agent, dct:Agent .

dct:description a rdf:Property, rdf:Property, owl:DatatypeProperty, owl:DatatypeProperty;
  rdfs:isDefinedBy <http://purl.org/dc/terms/>, <http://purl.org/dc/terms/>;
  rdfs:label "description", "description", "Description"@en, "Description"@en;
  rdfs:comment "An account of the resource."@en, "An account of the resource."@en;
  rdfs:subPropertyOf dc:description, dc:description;
  dct:description "Description may include but is not limited to: an abstract, a table of contents, a graphical representation, or a free-text account of the resource."@en,
    "Description may include but is not limited to: an abstract, a table of contents, a graphical representation, or a free-text account of the resource."@en;
  dct:issued "2008-01-14"^^xsd:date, "2008-01-14"^^xsd:date .

dct:creator a rdf:Property, rdf:Property, owl:AnnotationProperty, owl:AnnotationProperty;
  rdfs:isDefinedBy <http://purl.org/dc/terms/>, <http://purl.org/dc/terms/>;
  rdfs:label "creator", "creator", "Creator"@en, "Creator"@en;
  rdfs:comment "An entity responsible for making the resource."@en, "An entity responsible for making the resource."@en;
  owl:equivalentProperty <http://xmlns.com/foaf/0.1/maker>, <http://xmlns.com/foaf/0.1/maker>;
  rdfs:subPropertyOf dct:contributor, dct:contributor, dc:creator, dc:creator;
  dct:description "Recommended practice is to identify the creator with a URI.  If this is not possible or feasible, a literal value that identifies the creator may be provided."@en,
    "Recommended practice is to identify the creator with a URI.  If this is not possible or feasible, a literal value that identifies the creator may be provided."@en;
  dct:issued "2008-01-14"^^xsd:date, "2008-01-14"^^xsd:date;
  <http://purl.org/dc/dcam/rangeIncludes> dct:Agent, dct:Agent .

skos:Concept a owl:Class, owl:Class;
  rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core>, <http://www.w3.org/2004/02/skos/core>;
  rdfs:label "Concept"@en, "Concept"@en;
  skos:definition "An idea or notion; a unit of thought."@en, "An idea or notion; a unit of thought."@en .

skos:definition a rdf:Property, rdf:Property, owl:AnnotationProperty, owl:AnnotationProperty;
  rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core>, <http://www.w3.org/2004/02/skos/core>;
  rdfs:label "definition"@en, "definition"@en;
  rdfs:subPropertyOf skos:note, skos:note;
  skos:definition "A statement or formal explanation of the meaning of a concept."@en,
    "A statement or formal explanation of the meaning of a concept."@en .

skos:ConceptScheme a owl:Class, owl:Class;
  rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core>, <http://www.w3.org/2004/02/skos/core>;
  rdfs:label "Concept Scheme"@en, "Concept Scheme"@en;
  owl:disjointWith skos:Concept, skos:Concept;
  skos:definition "A set of concepts, optionally including statements about semantic relationships between those concepts."@en,
    "A set of concepts, optionally including statements about semantic relationships between those concepts."@en;
  skos:scopeNote "A concept scheme may be defined to include concepts from different sources."@en,
    "A concept scheme may be defined to include concepts from different sources."@en;
  skos:example "Thesauri, classification schemes, subject heading lists, taxonomies, 'folksonomies', and other types of controlled vocabulary are all examples of concept schemes. Concept schemes are also embedded in glossaries and terminologies."@en,
    "Thesauri, classification schemes, subject heading lists, taxonomies, 'folksonomies', and other types of controlled vocabulary are all examples of concept schemes. Concept schemes are also embedded in glossaries and terminologies."@en .

skos:scopeNote a rdf:Property, rdf:Property, owl:AnnotationProperty, owl:AnnotationProperty;
  rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core>, <http://www.w3.org/2004/02/skos/core>;
  rdfs:label "scope note"@en, "scope note"@en;
  rdfs:subPropertyOf skos:note, skos:note;
  skos:definition "A note that helps to clarify the meaning and/or the use of a concept."@en,
    "A note that helps to clarify the meaning and/or the use of a concept."@en .

skos:example a rdf:Property, rdf:Property, owl:AnnotationProperty, owl:AnnotationProperty;
  rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core>, <http://www.w3.org/2004/02/skos/core>;
  rdfs:label "example"@en, "example"@en;
  rdfs:subPropertyOf skos:note, skos:note;
  skos:definition "An example of the use of a concept."@en, "An example of the use of a concept."@en .

skos:Collection a owl:Class, owl:Class;
  rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core>, <http://www.w3.org/2004/02/skos/core>;
  rdfs:label "Collection"@en, "Collection"@en;
  owl:disjointWith skos:Concept, skos:Concept, skos:ConceptScheme, skos:ConceptScheme;
  skos:definition "A meaningful collection of concepts."@en, "A meaningful collection of concepts."@en;
  skos:scopeNote "Labelled collections can be used where you would like a set of concepts to be displayed under a 'node label' in the hierarchy."@en,
    "Labelled collections can be used where you would like a set of concepts to be displayed under a 'node label' in the hierarchy."@en .

skos:OrderedCollection a owl:Class, owl:Class;
  rdfs:subClassOf skos:Collection, skos:Collection;
  rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core>, <http://www.w3.org/2004/02/skos/core>;
  rdfs:label "Ordered Collection"@en, "Ordered Collection"@en;
  skos:definition "An ordered collection of concepts, where both the grouping and the ordering are meaningful."@en,
    "An ordered collection of concepts, where both the grouping and the ordering are meaningful."@en;
  skos:scopeNote "Ordered collections can be used where you would like a set of concepts to be displayed in a specific order, and optionally under a 'node label'."@en,
    "Ordered collections can be used where you would like a set of concepts to be displayed in a specific order, and optionally under a 'node label'."@en .

skos:inScheme a rdf:Property, rdf:Property, owl:ObjectProperty, owl:ObjectProperty;
  rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core>, <http://www.w3.org/2004/02/skos/core>;
  rdfs:label "is in scheme"@en, "is in scheme"@en;
  rdfs:range skos:ConceptScheme, skos:ConceptScheme;
  skos:definition "Relates a resource (for example a concept) to a concept scheme in which it is included."@en,
    "Relates a resource (for example a concept) to a concept scheme in which it is included."@en;
  skos:scopeNote "A concept may be a member of more than one concept scheme."@en, "A concept may be a member of more than one concept scheme."@en .

skos:hasTopConcept a rdf:Property, rdf:Property, owl:ObjectProperty, owl:ObjectProperty;
  rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core>, <http://www.w3.org/2004/02/skos/core>;
  rdfs:label "has top concept"@en, "has top concept"@en;
  rdfs:range skos:Concept, skos:Concept;
  rdfs:domain skos:ConceptScheme, skos:ConceptScheme;
  owl:inverseOf skos:topConceptOf, skos:topConceptOf;
  skos:definition "Relates, by convention, a concept scheme to a concept which is topmost in the broader/narrower concept hierarchies for that scheme, providing an entry point to these hierarchies."@en,
    "Relates, by convention, a concept scheme to a concept which is topmost in the broader/narrower concept hierarchies for that scheme, providing an entry point to these hierarchies."@en .

skos:topConceptOf a rdf:Property, rdf:Property, owl:ObjectProperty, owl:ObjectProperty;
  rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core>, <http://www.w3.org/2004/02/skos/core>;
  rdfs:label "is top concept in scheme"@en, "is top concept in scheme"@en;
  rdfs:range skos:ConceptScheme, skos:ConceptScheme;
  rdfs:domain skos:Concept, skos:Concept;
  owl:inverseOf skos:hasTopConcept, skos:hasTopConcept;
  rdfs:subPropertyOf skos:inScheme, skos:inScheme;
  skos:definition "Relates a concept to the concept scheme that it is a top level concept of."@en,
    "Relates a concept to the concept scheme that it is a top level concept of."@en .

skos:prefLabel a rdf:Property, rdf:Property, owl:AnnotationProperty, owl:AnnotationProperty;
  rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core>, <http://www.w3.org/2004/02/skos/core>;
  rdfs:label "preferred label"@en, "preferred label"@en;
  rdfs:comment "A resource has no more than one value of skos:prefLabel per language tag, and no more than one value of skos:prefLabel without language tag."@en,
    "A resource has no more than one value of skos:prefLabel per language tag, and no more than one value of skos:prefLabel without language tag."@en,
    "The range of skos:prefLabel is the class of RDF plain literals."@en, "The range of skos:prefLabel is the class of RDF plain literals."@en,
    """skos:prefLabel, skos:altLabel and skos:hiddenLabel are pairwise
      disjoint properties."""@en,
    """skos:prefLabel, skos:altLabel and skos:hiddenLabel are pairwise
      disjoint properties."""@en;
  rdfs:subPropertyOf rdfs:label, rdfs:label;
  skos:definition "The preferred lexical label for a resource, in a given language."@en,
    "The preferred lexical label for a resource, in a given language."@en .

skos:altLabel a rdf:Property, rdf:Property, owl:AnnotationProperty, owl:AnnotationProperty;
  rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core>, <http://www.w3.org/2004/02/skos/core>;
  rdfs:label "alternative label"@en, "alternative label"@en;
  rdfs:comment "The range of skos:altLabel is the class of RDF plain literals."@en,
    "The range of skos:altLabel is the class of RDF plain literals."@en, "skos:prefLabel, skos:altLabel and skos:hiddenLabel are pairwise disjoint properties."@en,
    "skos:prefLabel, skos:altLabel and skos:hiddenLabel are pairwise disjoint properties."@en;
  rdfs:subPropertyOf rdfs:label, rdfs:label;
  skos:definition "An alternative lexical label for a resource."@en, "An alternative lexical label for a resource."@en;
  skos:example "Acronyms, abbreviations, spelling variants, and irregular plural/singular forms may be included among the alternative labels for a concept. Mis-spelled terms are normally included as hidden labels (see skos:hiddenLabel)."@en,
    "Acronyms, abbreviations, spelling variants, and irregular plural/singular forms may be included among the alternative labels for a concept. Mis-spelled terms are normally included as hidden labels (see skos:hiddenLabel)."@en .

skos:hiddenLabel a rdf:Property, rdf:Property, owl:AnnotationProperty, owl:AnnotationProperty;
  rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core>, <http://www.w3.org/2004/02/skos/core>;
  rdfs:label "hidden label"@en, "hidden label"@en;
  rdfs:comment "skos:prefLabel, skos:altLabel and skos:hiddenLabel are pairwise disjoint properties."@en,
    "skos:prefLabel, skos:altLabel and skos:hiddenLabel are pairwise disjoint properties."@en,
    "The range of skos:hiddenLabel is the class of RDF plain literals."@en, "The range of skos:hiddenLabel is the class of RDF plain literals."@en;
  rdfs:subPropertyOf rdfs:label, rdfs:label;
  skos:definition "A lexical label for a resource that should be hidden when generating visual displays of the resource, but should still be accessible to free text search operations."@en,
    "A lexical label for a resource that should be hidden when generating visual displays of the resource, but should still be accessible to free text search operations."@en .

skos:notation a rdf:Property, rdf:Property, owl:DatatypeProperty, owl:DatatypeProperty;
  rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core>, <http://www.w3.org/2004/02/skos/core>;
  rdfs:label "notation"@en, "notation"@en;
  skos:definition "A notation, also known as classification code, is a string of characters such as \"T58.5\" or \"303.4833\" used to uniquely identify a concept within the scope of a given concept scheme."@en,
    "A notation, also known as classification code, is a string of characters such as \"T58.5\" or \"303.4833\" used to uniquely identify a concept within the scope of a given concept scheme."@en;
  skos:scopeNote "By convention, skos:notation is used with a typed literal in the object position of the triple."@en,
    "By convention, skos:notation is used with a typed literal in the object position of the triple."@en .

skos:note a rdf:Property, rdf:Property, owl:AnnotationProperty, owl:AnnotationProperty;
  rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core>, <http://www.w3.org/2004/02/skos/core>;
  rdfs:label "note"@en, "note"@en;
  skos:definition "A general note, for any purpose."@en, "A general note, for any purpose."@en;
  skos:scopeNote "This property may be used directly, or as a super-property for more specific note types."@en,
    "This property may be used directly, or as a super-property for more specific note types."@en .

skos:changeNote a rdf:Property, rdf:Property, owl:AnnotationProperty, owl:AnnotationProperty;
  rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core>, <http://www.w3.org/2004/02/skos/core>;
  rdfs:label "change note"@en, "change note"@en;
  rdfs:subPropertyOf skos:note, skos:note;
  skos:definition "A note about a modification to a concept."@en, "A note about a modification to a concept."@en .

skos:editorialNote a rdf:Property, rdf:Property, owl:AnnotationProperty, owl:AnnotationProperty;
  rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core>, <http://www.w3.org/2004/02/skos/core>;
  rdfs:label "editorial note"@en, "editorial note"@en;
  rdfs:subPropertyOf skos:note, skos:note;
  skos:definition "A note for an editor, translator or maintainer of the vocabulary."@en,
    "A note for an editor, translator or maintainer of the vocabulary."@en .

skos:historyNote a rdf:Property, rdf:Property, owl:AnnotationProperty, owl:AnnotationProperty;
  rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core>, <http://www.w3.org/2004/02/skos/core>;
  rdfs:label "history note"@en, "history note"@en;
  rdfs:subPropertyOf skos:note, skos:note;
  skos:definition "A note about the past state/use/meaning of a concept."@en, "A note about the past state/use/meaning of a concept."@en .

skos:semanticRelation a rdf:Property, rdf:Property, owl:ObjectProperty, owl:ObjectProperty;
  rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core>, <http://www.w3.org/2004/02/skos/core>;
  rdfs:label "is in semantic relation with"@en, "is in semantic relation with"@en;
  rdfs:range skos:Concept, skos:Concept;
  rdfs:domain skos:Concept, skos:Concept;
  skos:definition "Links a concept to a concept related by meaning."@en, "Links a concept to a concept related by meaning."@en;
  skos:scopeNote "This property should not be used directly, but as a super-property for all properties denoting a relationship of meaning between concepts."@en,
    "This property should not be used directly, but as a super-property for all properties denoting a relationship of meaning between concepts."@en .

skos:broader a rdf:Property, rdf:Property, owl:ObjectProperty, owl:ObjectProperty;
  rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core>, <http://www.w3.org/2004/02/skos/core>;
  rdfs:label "has broader"@en, "has broader"@en;
  rdfs:comment "Broader concepts are typically rendered as parents in a concept hierarchy (tree)."@en,
    "Broader concepts are typically rendered as parents in a concept hierarchy (tree)."@en;
  owl:inverseOf skos:narrower, skos:narrower;
  rdfs:subPropertyOf skos:broaderTransitive, skos:broaderTransitive;
  skos:definition "Relates a concept to a concept that is more general in meaning."@en,
    "Relates a concept to a concept that is more general in meaning."@en;
  skos:scopeNote "By convention, skos:broader is only used to assert an immediate (i.e. direct) hierarchical link between two conceptual resources."@en,
    "By convention, skos:broader is only used to assert an immediate (i.e. direct) hierarchical link between two conceptual resources."@en .

skos:broaderTransitive a rdf:Property, rdf:Property, owl:ObjectProperty, owl:ObjectProperty,
    owl:TransitiveProperty, owl:TransitiveProperty;
  rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core>, <http://www.w3.org/2004/02/skos/core>;
