quantitykind:LuminousFlux a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "Fluks berluminositi"@ms, "Fluks berluminositi"@ms, "Lichtstrom"@de, "Lichtstrom"@de,
    "Světelný tok"@cs, "Světelný tok"@cs, "fluctús lucis"@la, "fluctús lucis"@la, "flujo luminoso"@es,
    "flujo luminoso"@es, "flusso luminoso"@it, "flusso luminoso"@it, "flux lumineux"@fr,
    "flux lumineux"@fr, "flux luminos"@ro, "flux luminos"@ro, "fluxo luminoso"@pt, "fluxo luminoso"@pt,
    "fényáram"@hu, "fényáram"@hu, "işık akısı"@tr, "işık akısı"@tr, "luminous flux"@en,
    "luminous flux"@en, "strumień świetlny"@pl, "strumień świetlny"@pl, "svetlobni tok"@sl,
    "svetlobni tok"@sl, "Светлинен поток"@bg, "Светлинен поток"@bg, "Световой поток"@ru,
    "Световой поток"@ru, "שטף הארה"@he, "שטף הארה"@he, "التدفق الضوئي"@ar, "التدفق الضوئي"@ar,
    "شار نوری"@fa, "شار نوری"@fa, "प्रकाशीय बहाव"@hi, "प्रकाशीय बहाव"@hi, "光束"@ja, "光束"@ja,
    "光通量"@zh, "光通量"@zh;
  rdfs:comment "Applicable units are those of quantitykind:LuminousFlux", "Applicable units are those of quantitykind:LuminousFlux";
  dct:description """
  $\\textit{Luminous Flux}$, or $\\textit{Luminous Power}$, is the measure of the perceived power of light. 
  It differs from radiant flux, the measure of the total power of light emitted,
   in that luminous flux is adjusted to reflect the varying sensitivity of the human eye to different wavelengths of light.
  """^^qudt:LatexString,
    """
  $\\textit{Luminous Flux}$, or $\\textit{Luminous Power}$, is the measure of the perceived power of light. 
  It differs from radiant flux, the measure of the total power of light emitted,
   in that luminous flux is adjusted to reflect the varying sensitivity of the human eye to different wavelengths of light.
  """^^qudt:LatexString;
  qudt:dbpediaMatch "http://dbpedia.org/resource/Luminous_flux"^^xsd:anyURI, "http://dbpedia.org/resource/Luminous_flux"^^xsd:anyURI;
  qudt:hasDimensionVector dimensionvector:A0E0L0I1M0H0T0D0, dimensionvector:A0E0L0I1M0H0T0D0;
  qudt:iec61360Code "0112/2///62720#UAD094", "0112/2///62720#UAD094";
  qudt:informativeReference "http://en.wikipedia.org/wiki/Luminous_flux"^^xsd:anyURI,
    "http://en.wikipedia.org/wiki/Luminous_flux"^^xsd:anyURI, "https://cdd.iec.ch/cdd/iec61987/iec61987.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD094"^^xsd:anyURI,
    "https://cdd.iec.ch/cdd/iec61987/iec61987.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD094"^^xsd:anyURI;
  qudt:siExactMatch <https://si-digital-framework.org/SI/quantities/LUFL>, <https://si-digital-framework.org/quantities/LUFL>;
  qudt:symbol "F", "F";
  qudt:isoNormativeReference "http://www.iso.org/iso/catalogue_detail?csnumber=43012"^^xsd:anyURI,
    "http://www.iso.org/iso/catalogue_detail?csnumber=43012"^^xsd:anyURI;
  qudt:plainTextDescription "Luminous Flux or Luminous Power is the measure of the perceived power of light. It differs from radiant flux, the measure of the total power of light emitted, in that luminous flux is adjusted to reflect the varying sensitivity of the human eye to different wavelengths of light.",
    "Luminous Flux or Luminous Power is the measure of the perceived power of light. It differs from radiant flux, the measure of the total power of light emitted, in that luminous flux is adjusted to reflect the varying sensitivity of the human eye to different wavelengths of light.";
  qudt:latexDefinition "$\\Phi_v = K_m \\int_{0}^{\\infty}{\\Phi_\\lambda(\\lambda)}{V(\\lambda)d\\lambda}$, where $K_m$ is the maximum spectral luminous efficacy, $\\Phi_\\lambda(\\lambda)$ is the spectral radiant flux, $V(\\lambda)$ is the spectral luminous efficiency, and $\\lambda$ is the wavelength."^^qudt:LatexString,
    "$\\Phi_v = K_m \\int_{0}^{\\infty}{\\Phi_\\lambda(\\lambda)}{V(\\lambda)d\\lambda}$, where $K_m$ is the maximum spectral luminous efficacy, $\\Phi_\\lambda(\\lambda)$ is the spectral radiant flux, $V(\\lambda)$ is the spectral luminous efficiency, and $\\lambda$ is the wavelength."^^qudt:LatexString;
  qudt:applicableUnit unit:KiloLM, unit:KiloLM, unit:LM, unit:LM .

