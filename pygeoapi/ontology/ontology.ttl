unit:HZ-PER-K a qudt:Unit ;
    rdfs:label "هرتز لكل كلفن"@ar,
        "Hertz Na Kelvin"@cs,
        "hertz na kelvin"@cs,
        "Hertz Je Kelvin"@de,
        "Hertz je Kelvin"@de,
        "Hertz per Kelvin"@en,
        "hertz per kelvin"@en,
        "Hercio Por Kelvin"@es,
        "hercio por kelvin"@es,
        "هرتز بر کلوین"@fa,
        "Hertz Par Kelvin"@fr,
        "hertz par kelvin"@fr,
        "हर्ट्ज प्रति कैल्विन"@hi,
