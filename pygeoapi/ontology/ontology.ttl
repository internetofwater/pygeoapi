<http://qudt.org/vocab/quantitykind/AngularWavenumber> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Kreisrepetenz"@de, "angular wavenumber"@en, "liczba falowa kątowa"@pl,
    "nombre d'onde angulaire"@fr, "numero d'onda angolare"@it, "número de onda angular"@es,
    "número de onda angular"@pt, "عدد موجى زاوى"@ar, "角波数"@ja, "角波数"@zh;
  rdfs:comment "Applicable units are those of quantitykind:AngularWavenumber";
  dct:description "\"wavenumber\" is the spatial frequency of a wave - the number of waves that exist over a specified distance. More formally, it is the reciprocal of the wavelength. It is also the magnitude of the wave vector."^^<http://qudt.org/schema/qudt/LatexString>;
  skos:altLabel "Kreiswellenzahl"@de, "angular repetency"@en, "repetencja kątowa"@pl,
    "repetência angular"@pt, "répétence angulaire"@fr, "تكرار زاوى"@ar;
  skos:broader <http://qudt.org/vocab/quantitykind/InverseLength>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L-1I0M0H0T0D0>;
  <http://qudt.org/schema/qudt/informativeReference> "http://en.wikipedia.org/wiki/Wavenumber"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/symbol> "k";
  <http://qudt.org/schema/qudt/isoNormativeReference> "http://www.iso.org/iso/catalogue_detail?csnumber=31897"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/plainTextDescription> "\"wavenumber\" is the spatial frequency of a wave - the number of waves that exist over a specified distance. More formally, it is the reciprocal of the wavelength. It is also the magnitude of the wave vector.";
  <http://qudt.org/schema/qudt/latexDefinition> """$k = \\frac{2\\pi}{\\lambda}= \\frac{2\\pi\\upsilon}{\\upsilon_p}=\\frac{\\omega}{\\upsilon_p}$, where $\\upsilon$ is the frequency of the wave, $\\lambda$ is the wavelength, $\\omega = 2\\pi \\upsilon$ is the angular frequency of the wave, and $\\upsilon_p$ is the phase velocity of the wave.

Alternatively:

$k = \\frac{p}{\\hbar}$, where $p$ is the linear momentum of quasi free electrons in an electron gas and $\\hbar$ is the reduced Planck constant ($h$ divided by $2\\pi$); for phonons, its magnitude is $k = \\frac{2\\pi}{\\lambda}$, where $\\lambda$ is the wavelength of the lattice vibrations."""^^<http://qudt.org/schema/qudt/LatexString>;
  <http://www.linkedmodel.org/schema/vaem#todo> "belongs to SOQ-ISO";
  <http://qudt.org/schema/qudt/applicableUnit> unit:DEG-PER-M, unit:RAD-PER-M .

<http://qudt.org/vocab/quantitykind/DebyeAngularWavenumber> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Debye Angular Wavenumber"@en;
  rdfs:comment "Applicable units are those of quantitykind:DebyeAngularWavenumber";
  dct:description "\"Debye Angular Wavenumber\" is the cut-off angular wavenumber in the Debye model of the vibrational spectrum of a solid."^^<http://qudt.org/schema/qudt/LatexString>;
  skos:broader <http://qudt.org/vocab/quantitykind/InverseLength>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L-1I0M0H0T0D0>;
  <http://qudt.org/schema/qudt/symbol> "q_D";
  <http://qudt.org/schema/qudt/isoNormativeReference> "http://www.iso.org/iso/catalogue_detail?csnumber=31897"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/plainTextDescription> "\"Debye Angular Wavenumber\" is the cut-off angular wavenumber in the Debye model of the vibrational spectrum of a solid.";
  <http://qudt.org/schema/qudt/applicableUnit> unit:DEG-PER-M, unit:RAD-PER-M .

<http://qudt.org/vocab/quantitykind/FermiAngularWavenumber> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Fermi Angular Wavenumber"@en;
