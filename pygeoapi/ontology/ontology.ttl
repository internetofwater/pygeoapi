quantitykind:RecombinationCoefficient a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "Recombination Coefficient"@en, "Recombination Coefficient"@en;
  rdfs:comment "Applicable units are those of quantitykind:RecombinationCoefficient",
    "Applicable units are those of quantitykind:RecombinationCoefficient";
  dct:description "The \"Recombination Coefficient\" is the rate of recombination of positive ions with electrons or negative ions in a gas, per unit volume, divided by the product of the number of positive ions per unit volume and the number of electrons or negative ions per unit volume."^^qudt:LatexString,
    "The \"Recombination Coefficient\" is the rate of recombination of positive ions with electrons or negative ions in a gas, per unit volume, divided by the product of the number of positive ions per unit volume and the number of electrons or negative ions per unit volume."^^qudt:LatexString;
  qudt:hasDimensionVector dimensionvector:A0E0L3I0M0H0T-1D0, dimensionvector:A0E0L3I0M0H0T-1D0;
  qudt:informativeReference "http://encyclopedia2.thefreedictionary.com/recombination+coefficient"^^xsd:anyURI,
    "http://encyclopedia2.thefreedictionary.com/recombination+coefficient"^^xsd:anyURI;
  qudt:symbol "a", "a";
  qudt:isoNormativeReference "http://www.iso.org/iso/catalogue_detail?csnumber=31895"^^xsd:anyURI,
    "http://www.iso.org/iso/catalogue_detail?csnumber=31895"^^xsd:anyURI;
  qudt:plainTextDescription "The \"Recombination Coefficient\" is the rate of recombination of positive ions with electrons or negative ions in a gas, per unit volume, divided by the product of the number of positive ions per unit volume and the number of electrons or negative ions per unit volume.",
    "The \"Recombination Coefficient\" is the rate of recombination of positive ions with electrons or negative ions in a gas, per unit volume, divided by the product of the number of positive ions per unit volume and the number of electrons or negative ions per unit volume.";
  qudt:latexDefinition "$-\\frac{dn^+}{dt} = -\\frac{dn^-}{dt} = an^+n^-$, where $n^+$ and $n^-$ are the ion number densities of positive and negative ions, respectively, recombined during an infinitesimal time interval with duration $dt$."^^qudt:LatexString,
    "$-\\frac{dn^+}{dt} = -\\frac{dn^-}{dt} = an^+n^-$, where $n^+$ and $n^-$ are the ion number densities of positive and negative ions, respectively, recombined during an infinitesimal time interval with duration $dt$."^^qudt:LatexString;
  qudt:applicableUnit unit:M3-PER-SEC, unit:M3-PER-SEC .

quantitykind:SoundVolumeVelocity a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "Sound volume velocity"@en, "Sound volume velocity"@en;
  rdfs:comment "Applicable units are those of quantitykind:SoundVolumeVelocity", "Applicable units are those of quantitykind:SoundVolumeVelocity";
  dct:description "Sound Volume Velocity is the product of particle velocity $v$ and the surface area $S$ through which an acoustic wave of frequency $f$ propagates. Also, the surface integral of the normal component of the sound particle velocity over the cross-section (through which the sound propagates). It is used to calculate acoustic impedance."^^qudt:LatexString,
    "Sound Volume Velocity is the product of particle velocity $v$ and the surface area $S$ through which an acoustic wave of frequency $f$ propagates. Also, the surface integral of the normal component of the sound particle velocity over the cross-section (through which the sound propagates). It is used to calculate acoustic impedance."^^qudt:LatexString;
  qudt:hasDimensionVector dimensionvector:A0E0L3I0M0H0T-1D0, dimensionvector:A0E0L3I0M0H0T-1D0;
  qudt:informativeReference "http://en.wikipedia.org/wiki/Acoustic_impedance"^^xsd:anyURI,
    "http://en.wikipedia.org/wiki/Acoustic_impedance"^^xsd:anyURI;
  qudt:symbol "q", "q";
  qudt:latexDefinition "$q= vS$, where $v$ is sound particle velocity and $S$ is the surface area through which an acoustic wave of frequence $f$ propagates."^^qudt:LatexString,
    "$q= vS$, where $v$ is sound particle velocity and $S$ is the surface area through which an acoustic wave of frequence $f$ propagates."^^qudt:LatexString;
  <http://www.linkedmodel.org/schema/vaem#todo> "belongs to SOQ-ISO", "belongs to SOQ-ISO";
  qudt:applicableUnit unit:M3-PER-SEC, unit:M3-PER-SEC .

