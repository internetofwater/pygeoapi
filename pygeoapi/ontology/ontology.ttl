    "aceleração angular"@pt, "angular acceleration"@en, "angular acceleration"@en, "Úhlové zrychlení"@cs,
    "Úhlové zrychlení"@cs, "Угловое ускорение"@ru, "Угловое ускорение"@ru, "تسارع زاوي"@ar,
    "تسارع زاوي"@ar, "شتاب زاویه‌ای"@fa, "شتاب زاویه‌ای"@fa, "कोणीय त्वरण"@hi, "कोणीय त्वरण"@hi,
