  qudt:hasDimensionVector dimensionvector:A0E0L-3I0M0H0T-1D0, dimensionvector:A0E0L-3I0M0H0T-1D0;
  qudt:hasQuantityKind quantitykind:ActivityConcentration, quantitykind:ActivityConcentration;
  qudt:iec61360Code "0112/2///62720#UAB126", "0112/2///62720#UAB126";
  qudt:informativeReference "http://www.efunda.com/glossary/units/units--radioactivity_concentration--becquerel_per_cubic_meter.cfm"^^xsd:anyURI,
    "http://www.efunda.com/glossary/units/units--radioactivity_concentration--becquerel_per_cubic_meter.cfm"^^xsd:anyURI,
