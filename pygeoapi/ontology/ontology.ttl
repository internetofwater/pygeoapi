    <http://qudt.org/vocab/quantitykind/BodyMassIndex>, <http://qudt.org/vocab/quantitykind/MeanMassRange>,
    <http://qudt.org/vocab/quantitykind/SurfaceDensity>;
  <http://qudt.org/schema/qudt/iec61360Code> "0112/2///62720#UAB389";
