quantitykind:RichardsonConstant a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "Richardson Constant"@en, "Richardson Constant"@en;
  rdfs:comment "Applicable units are those of quantitykind:RichardsonConstant", "Applicable units are those of quantitykind:RichardsonConstant";
  dct:description "\"Richardson Constant\" is a constant used in developing thermionic emission current density for a metal."^^qudt:LatexString,
    "\"Richardson Constant\" is a constant used in developing thermionic emission current density for a metal."^^qudt:LatexString;
  qudt:hasDimensionVector dimensionvector:A0E1L-2I0M0H-2T0D0, dimensionvector:A0E1L-2I0M0H-2T0D0;
  qudt:iec61360Code "0112/2///62720#UAD162", "0112/2///62720#UAD162";
  qudt:informativeReference "http://en.wikipedia.org/wiki/Thermionic_emission"^^xsd:anyURI,
    "http://en.wikipedia.org/wiki/Thermionic_emission"^^xsd:anyURI, "https://cdd.iec.ch/cdd/iec61987/iec61987.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD162"^^xsd:anyURI,
    "https://cdd.iec.ch/cdd/iec61987/iec61987.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD162"^^xsd:anyURI;
  qudt:symbol "A", "A";
  qudt:isoNormativeReference "http://www.iso.org/iso/catalogue_detail?csnumber=31897"^^xsd:anyURI,
    "http://www.iso.org/iso/catalogue_detail?csnumber=31897"^^xsd:anyURI;
  qudt:plainTextDescription "\"Richardson Constant\" is a constant used in developing thermionic emission current density for a metal.",
    "\"Richardson Constant\" is a constant used in developing thermionic emission current density for a metal.";
  qudt:latexDefinition "The thermionic emission current, $J$, for a metal is $J = AT^2\\exp{(-\\frac{\\Phi}{kT})}$, where $T$ is thermodynamic temperature, $k$ is the Boltzmann constant, and $\\Phi$ is a work function."^^qudt:LatexString,
    "The thermionic emission current, $J$, for a metal is $J = AT^2\\exp{(-\\frac{\\Phi}{kT})}$, where $T$ is thermodynamic temperature, $k$ is the Boltzmann constant, and $\\Phi$ is a work function."^^qudt:LatexString;
  qudt:applicableUnit unit:A-PER-M2-K2, unit:A-PER-M2-K2 .

