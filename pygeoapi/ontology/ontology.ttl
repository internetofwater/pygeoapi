unit:RPK a <http://qudt.org/schema/qudt/Unit>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/unit>;
  rdfs:label "Reads per Kilobase"@en;
  dct:description "RPK (Reads Per Kilobases) are obtained by dividing read counts by gene lengths (expressed in kilo-nucleotides)."^^rdf:HTML;
  skos:altLabel "RPK";
  <http://qudt.org/schema/qudt/conversionMultiplier> 1.0;
  <http://qudt.org/schema/qudt/conversionMultiplierSN> 1.0E0;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1>;
  <http://qudt.org/schema/qudt/hasQuantityKind> <http://qudt.org/vocab/quantitykind/Dimensionless>,
    <http://qudt.org/vocab/quantitykind/GeneFamilyAbundance>;
  <http://qudt.org/schema/qudt/informativeReference> "https://learn.gencore.bio.nyu.edu/metgenomics/shotgun-metagenomics/functional-analysis/"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/symbol> "RPK";
  <http://qudt.org/schema/qudt/plainTextDescription> "RPK (Reads Per Kilobases) are obtained by dividing read counts by gene lengths (expressed in kilo-nucleotides).";
  <http://qudt.org/schema/qudt/qkdvDenominator> <http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1>;
  <http://qudt.org/schema/qudt/qkdvNumerator> <http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1> .

<http://qudt.org/vocab/quantitykind/GeneFamilyAbundance> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Gene Family Abundance"@en;
  rdfs:comment "Applicable units are those of quantitykind:GeneFamilyAbundance";
  dct:description "The abundance of each gene family in the community. Gene families are groups of evolutionarily-related protein-coding sequences that often perform similar functions. Gene family abundance is reported in RPK (reads per kilobase) units to normalize for gene length."^^<http://qudt.org/schema/qudt/LatexString>;
  skos:broader <http://qudt.org/vocab/quantitykind/DimensionlessRatio>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1>;
  <http://qudt.org/schema/qudt/informativeReference> "https://learn.gencore.bio.nyu.edu/"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/plainTextDescription> "The abundance of each gene family in the community. Gene families are groups of evolutionarily-related protein-coding sequences that often perform similar functions. Gene family abundance is reported in RPK (reads per kilobase) units to normalize for gene length.";
  <http://qudt.org/schema/qudt/qkdvDenominator> <http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1>;
  <http://qudt.org/schema/qudt/qkdvNumerator> <http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1>;
  <http://qudt.org/schema/qudt/applicableUnit> unit:RPK .

