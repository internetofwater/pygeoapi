quantitykind:PhotoThresholdOfAwarenessFunction a qudt:QuantityKind ;
    rdfs:label "Photo Threshold of Awareness Function"@en ;
    dct:description "\"Photo Threshold of Awareness Function\" is the ability of the human eye to detect a light that results in a $1^o$ radial angle at the eye with a given duration (temporal summation)."^^qudt:LatexString ;
