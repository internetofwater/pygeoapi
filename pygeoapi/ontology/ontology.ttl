quantitykind:MechanicalSurfaceImpedance a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "Mechanical surface impedance"@en, "Mechanical surface impedance"@en;
  rdfs:comment "There are various interpretations of MechanicalSurfaceImpedance: Pressure/Velocity - https://apps.dtic.mil/sti/pdfs/ADA315595.pdf, Force / Speed - https://www.wikidata.org/wiki/Q6421317, and (Pressure / Velocity)**0.5 - https://www.sciencedirect.com/topics/engineering/mechanical-impedance. We are seeking a resolution to these differences.",
    "There are various interpretations of MechanicalSurfaceImpedance: Pressure/Velocity - https://apps.dtic.mil/sti/pdfs/ADA315595.pdf, Force / Speed - https://www.wikidata.org/wiki/Q6421317, and (Pressure / Velocity)**0.5 - https://www.sciencedirect.com/topics/engineering/mechanical-impedance. We are seeking a resolution to these differences.";
  dct:description "Mechanical surface impedance at a surface, is the complex quotient of the total force on the surface by the component of the average sound particle velocity at the surface in the direction of the force"^^qudt:LatexString,
    "Mechanical surface impedance at a surface, is the complex quotient of the total force on the surface by the component of the average sound particle velocity at the surface in the direction of the force"^^qudt:LatexString;
  qudt:hasDimensionVector dimensionvector:A0E0L-2I0M1H0T-1D0, dimensionvector:A0E0L-2I0M1H0T-1D0;
  qudt:symbol "Z", "Z";
  qudt:plainTextDescription "Mechanical surface impedance at a surface, is the complex quotient of the total force on the surface by the component of the average sound particle velocity at the surface in the direction of the force",
    "Mechanical surface impedance at a surface, is the complex quotient of the total force on the surface by the component of the average sound particle velocity at the surface in the direction of the force";
  qudt:latexDefinition "$Z_m = Z_a A^2$, where $A$ is the area of the surface considered and $Z_a$ is the acoustic impedance."^^qudt:LatexString,
    "$Z_m = Z_a A^2$, where $A$ is the area of the surface considered and $Z_a$ is the acoustic impedance."^^qudt:LatexString;
  <http://www.linkedmodel.org/schema/vaem#todo> "belongs to SOQ-ISO", "belongs to SOQ-ISO" .

quantitykind:MechanicalTension a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "mechanical tension"@en-US, "mechanical tension"@en-US;
  rdfs:comment "Applicable units are those of quantitykind:ForcePerArea", "Applicable units are those of quantitykind:ForcePerArea";
  dct:description "at a point of a body upon which a force acts which attempts to change the shape of the body, the limit value of the ratio between the force and area of a flat surface around this point when the dimensions approach zero"@en,
