    "steradiante"@it, "steradián"@cs, "steradián"@cs, "steradyan"@tr, "steradyan"@tr,
    "stéradian"@fr, "stéradian"@fr, "szteradián"@hu, "szteradián"@hu, "στερακτίνιο"@el,
