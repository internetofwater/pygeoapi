    "A legal document giving official permission to do something with the resource."@en;
  rdfs:subPropertyOf dct:rights, dct:rights, dc:rights, dc:rights;
  dct:description "Recommended practice is to identify the license document with a URI. If this is not possible or feasible, a literal value that identifies the license may be provided."@en,
    "Recommended practice is to identify the license document with a URI. If this is not possible or feasible, a literal value that identifies the license may be provided."@en;
  dct:issued "2004-06-14"^^xsd:date, "2004-06-14"^^xsd:date;
  <http://purl.org/dc/dcam/rangeIncludes> dct:LicenseDocument, dct:LicenseDocument .

dct:mediator a rdf:Property, rdf:Property;
