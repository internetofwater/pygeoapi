<http://qudt.org/vocab/quantitykind/MolarDensity> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "molar density"@en-US;
  dct:description "quantity whose value is inversely proportional to the quantity of material"@en;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A-1E0L0I0M0H0T0D0>;
  <http://qudt.org/schema/qudt/symbol> "0173-1#Z4-BAJ372#002";
  <http://qudt.org/schema/qudt/plainTextDescription> "Größe, deren Wert sich umgekehrt proportional zu Stoffmengenwert verhält"@de .

<http://qudt.org/vocab/quantitykind/MolarInternalEnergy> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "molar internal energy";
  rdfs:comment "Applicable units are those of quantitykind:MolarEnergy";
  skos:broader <http://qudt.org/vocab/quantitykind/MolarEnergy>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A-1E0L2I0M1H0T-2D0>;
  <http://qudt.org/schema/qudt/iec61360Code> "0112/2///62720#UAD124";
  <http://qudt.org/schema/qudt/informativeReference> "https://cdd.iec.ch/cdd/iec61987/iec61987.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD124"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/applicableUnit> unit:J-PER-MOL, unit:KiloCAL-PER-MOL,
    unit:KiloJ-PER-MOL .

<http://qudt.org/vocab/quantitykind/MolarOpticalRotationalAbility> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "molar optical rotational ability"@en-US;
  dct:description "material-specific quantity resulting as the specific angle of rotation of a substance for a particular wavelength and a particular temperature from the relationship: ratio between measured angle of rotation divided by the concentration of material and the covered path"@en;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L2I0M-1H0T0D0>;
  <http://qudt.org/schema/qudt/symbol> "0173-1#Z4-BAJ426#001";
  <http://qudt.org/schema/qudt/plainTextDescription> "materialspezifische Größe, die sich als spezifischer Drehwinkel einer Substanz für eine bestimmte Wellenlänge und eine bestimmte Temperatur ergibt durch die Beziehung: Quotient aus gemessener Drehwinkel dividiert durch die Stoffmenegenkonzentration und die durchstrahlte Wegstrecke"@de .

<http://qudt.org/vocab/quantitykind/MolarThermalCapacity> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "molar thermal capacity"@en-US;
  dct:description "thermal capacity divided by the amount of substance"@en;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A-1E0L2I0M1H-1T-2D0>;
  <http://qudt.org/schema/qudt/symbol> "0173-1#Z4-BAJ355#002";
  <http://qudt.org/schema/qudt/plainTextDescription> "auf die Stoffmenge bezogene Wärmekapazität"@de .

<http://qudt.org/vocab/quantitykind/MolarThermodynamicEnergy> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "molar thermodynamic energy"@en-US;
  rdfs:comment "Applicable units are those of quantitykind:MolarEnergy";
  dct:description "energy in relation to the amount of a substance"@en;
  skos:broader <http://qudt.org/vocab/quantitykind/MolarEnergy>;
