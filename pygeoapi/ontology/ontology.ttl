quantitykind:DiffusionCoefficientForFluenceRate a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "Diffusion Coefficient for Fluence Rate"@en, "Diffusion Coefficient for Fluence Rate"@en;
  rdfs:comment "Applicable units are those of quantitykind:Length", "Applicable units are those of quantitykind:Length";
  dct:description "The \"Diffusion Coefficient for Fluence Rate\" is a proportionality constant between the ."^^qudt:LatexString,
    "The \"Diffusion Coefficient for Fluence Rate\" is a proportionality constant between the ."^^qudt:LatexString;
  skos:broader quantitykind:Length, quantitykind:Length;
  qudt:hasDimensionVector dimensionvector:A0E0L1I0M0H0T0D0, dimensionvector:A0E0L1I0M0H0T0D0;
  qudt:informativeReference "http://en.wikipedia.org/wiki/Mass_diffusivity"^^xsd:anyURI,
