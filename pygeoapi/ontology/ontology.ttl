  rdfs:label "घन मीटर"@hi, "घन मीटर"@hi, "Steradiant"@de, "Steradiant"@de, "estereorradián"@es,
    "estereorradián"@es, "esterradiano"@pt, "esterradiano"@pt, "steradian"@en, "steradian"@en,
