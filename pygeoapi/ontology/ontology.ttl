  <http://qudt.org/schema/qudt/informativeReference> "http://en.wikipedia.org/wiki/Delta-v"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/plainTextDescription> "The change in translational velocity including all losses for a propulsive system or module. Delta-V losses include, but are not limited to, gravity losses and steering losses.";
  <http://qudt.org/schema/qudt/latexSymbol> "$\\bigtriangleup v$"^^<http://qudt.org/schema/qudt/LatexString>;
