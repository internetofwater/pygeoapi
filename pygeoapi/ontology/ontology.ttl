<http://qudt.org/vocab/quantitykind/ParticleSourceDensity> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Particle Source Density"@en;
  rdfs:comment "Applicable units are those of quantitykind:ParticleSourceDensity";
  dct:description "\"Particle Source Density\" is the rate of production of particles in a 3D domain divided by the volume of that element."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L-3I0M0H0T-1D0>;
  <http://qudt.org/schema/qudt/symbol> "S";
  <http://qudt.org/schema/qudt/isoNormativeReference> "http://www.iso.org/iso/catalogue_detail?csnumber=31895"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/plainTextDescription> "\"Particle Source Density\" is the rate of production of particles in a 3D domain divided by the volume of that element.";
  <http://qudt.org/schema/qudt/applicableUnit> unit:PER-M3-SEC .

<http://qudt.org/vocab/quantitykind/Slowing-DownDensity> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Slowing-Down Density"@en;
  rdfs:comment "Applicable units are those of quantitykind:Slowing-DownDensity";
  dct:description "\"Slowing-Down Density\" is a measure of the rate at which neutrons lose energy in a nuclear reactor through collisions; equal to the number of neutrons that fall below a given energy per unit volume per unit time."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L-3I0M0H0T-1D0>;
  <http://qudt.org/schema/qudt/iec61360Code> "0112/2///62720#UAD170";
  <http://qudt.org/schema/qudt/informativeReference> "http://encyclopedia2.thefreedictionary.com/slowing-down+density"^^xsd:anyURI,
    "https://cdd.iec.ch/cdd/iec61987/iec61987.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD170"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/symbol> "q";
  <http://qudt.org/schema/qudt/isoNormativeReference> "http://www.iso.org/iso/catalogue_detail?csnumber=31895"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/plainTextDescription> "\"Slowing-Down Density\" is a measure of the rate at which neutrons lose energy in a nuclear reactor through collisions; equal to the number of neutrons that fall below a given energy per unit volume per unit time.";
  <http://qudt.org/schema/qudt/latexDefinition> "$q = -\\frac{dn}{dt}$, where $n$ is the number density and $dt$ is the duration."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/applicableUnit> unit:PER-M3-SEC, unit:PER-SEC-M3 .

