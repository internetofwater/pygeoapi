unit:SEC a qudt:Unit, qudt:Unit;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/unit>, <http://qudt.org/vocab/unit>;
  rdfs:label "Sekunde"@de, "Sekunde"@de, "másodperc"@hu, "másodperc"@hu, "saat"@ms,
    "saat"@ms, "saniye"@tr, "saniye"@tr, "second"@en, "second"@en, "seconde"@fr, "seconde"@fr,
    "secondo"@it, "secondo"@it, "secundum"@la, "secundum"@la, "secundă"@ro, "secundă"@ro,
    "segundo"@es, "segundo"@es, "segundo"@pt, "segundo"@pt, "sekunda"@cs, "sekunda"@cs,
    "sekunda"@pl, "sekunda"@pl, "sekunda"@sl, "sekunda"@sl, "δευτερόλεπτο"@el, "δευτερόλεπτο"@el,
    "секунда"@bg, "секунда"@bg, "секунда"@ru, "секунда"@ru, "שנייה"@he, "שנייה"@he, "ثانية"@ar,
    "ثانية"@ar, "ثانیه"@fa, "ثانیه"@fa, "सैकण्ड"@hi, "सैकण्ड"@hi, "秒"@ja, "秒"@ja, "秒"@zh,
    "秒"@zh;
  dct:description """The $Second$ (symbol: $s$) is the base unit of time in the International System of Units (SI) and is also a unit of time in other systems of measurement. Between the years1000 (when al-Biruni used seconds) and 1960 the second was defined as $1/86400$ of a mean solar day (that definition still applies in some astronomical and legal contexts). Between 1960 and 1967, it was defined in terms of the period of the Earth's orbit around the Sun in 1900, but it is now defined more precisely in atomic terms.
Under the International System of Units (via the International Committee for Weights and Measures, or CIPM), since 1967 the second has been defined as the duration of ${9192631770}$ periods of the radiation corresponding to the transition between the two hyperfine levels of the ground state of the caesium 133 atom.In 1997 CIPM added that the periods would be defined for a caesium atom at rest, and approaching the theoretical temperature of absolute zero, and in 1999, it included corrections from ambient radiation."""^^qudt:LatexString,
    """The $Second$ (symbol: $s$) is the base unit of time in the International System of Units (SI) and is also a unit of time in other systems of measurement. Between the years1000 (when al-Biruni used seconds) and 1960 the second was defined as $1/86400$ of a mean solar day (that definition still applies in some astronomical and legal contexts). Between 1960 and 1967, it was defined in terms of the period of the Earth's orbit around the Sun in 1900, but it is now defined more precisely in atomic terms.
Under the International System of Units (via the International Committee for Weights and Measures, or CIPM), since 1967 the second has been defined as the duration of ${9192631770}$ periods of the radiation corresponding to the transition between the two hyperfine levels of the ground state of the caesium 133 atom.In 1997 CIPM added that the periods would be defined for a caesium atom at rest, and approaching the theoretical temperature of absolute zero, and in 1999, it included corrections from ambient radiation."""^^qudt:LatexString;
  qudt:applicableSystem <http://qudt.org/vocab/sou/CGS-EMU>, <http://qudt.org/vocab/sou/CGS-EMU>,
    <http://qudt.org/vocab/sou/CGS-GAUSS>, <http://qudt.org/vocab/sou/CGS-GAUSS>, <http://qudt.org/vocab/sou/SI>,
    <http://qudt.org/vocab/sou/SI>, <http://qudt.org/vocab/sou/CGS>, <http://qudt.org/vocab/sou/CGS>,
    <http://qudt.org/vocab/sou/IMPERIAL>, <http://qudt.org/vocab/sou/IMPERIAL>, <http://qudt.org/vocab/sou/USCS>,
    <http://qudt.org/vocab/sou/USCS>;
  qudt:conversionMultiplier 1.0, 1.0;
  qudt:conversionMultiplierSN 1.0E0, 1.0E0;
  qudt:dbpediaMatch "http://dbpedia.org/resource/Second"^^xsd:anyURI, "http://dbpedia.org/resource/Second"^^xsd:anyURI;
  qudt:hasDimensionVector dimensionvector:A0E0L0I0M0H0T1D0, dimensionvector:A0E0L0I0M0H0T1D0;
  qudt:hasQuantityKind quantitykind:Time, quantitykind:Time, quantitykind:Period, quantitykind:Period;
  qudt:iec61360Code "0112/2///62720#UAA972", "0112/2///62720#UAA972", "0112/2///62720#UAD722";
  qudt:informativeReference "http://en.wikipedia.org/wiki/Second?oldid=495241006"^^xsd:anyURI,
    "http://en.wikipedia.org/wiki/Second?oldid=495241006"^^xsd:anyURI, "https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAA972"^^xsd:anyURI,
    "https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAA972"^^xsd:anyURI,
    "https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAD722"^^xsd:anyURI;
  qudt:omUnit <http://www.ontology-of-units-of-measure.org/resource/om-2/second-Time>,
    <http://www.ontology-of-units-of-measure.org/resource/om-2/second-Time>;
  qudt:siExactMatch <https://si-digital-framework.org/SI/units/second>, <https://si-digital-framework.org/SI/units/second>;
  qudt:symbol "s", "s";
  qudt:ucumCode "s"^^qudt:UCUMcs, "s"^^qudt:UCUMcs;
  qudt:udunitsCode "s", "s";
  qudt:uneceCommonCode "SEC", "SEC";
  qudt:definedUnitOfSystem <http://qudt.org/vocab/sou/USCS>, <http://qudt.org/vocab/sou/USCS> .

