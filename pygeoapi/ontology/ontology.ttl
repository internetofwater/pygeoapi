    "A/Pa"^^<http://qudt.org/schema/qudt/UCUMcs>;
  <http://qudt.org/schema/qudt/uneceCommonCode> "N93" .

<http://qudt.org/vocab/dimensionvector/A0E1L1I0M-1H0T2D0> a <http://qudt.org/schema/qudt/QuantityKindDimensionVector>;
