variablename:humificationIndex a skos:Concept;
  skos:definition "Humification index. Hummification is the processes by which organic matter decomposes to form humus. In humus the initial structures or shapes can no longer be recognized. See also humus.";
  skos:inScheme <http://vocabulary.odm2.org/variablename>;
  skos:topConceptOf <http://vocabulary.odm2.org/variablename>;
