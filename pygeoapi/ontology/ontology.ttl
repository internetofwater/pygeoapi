variablename:permittivity a skos:Concept;
  skos:definition "Permittivity is a physical quantity that describes how an electric field affects, and is affected by a dielectric medium, and is determined by the ability of a material to polarize in response to the field, and thereby reduce the total electric field inside the material. Thus, permittivity relates to a material's ability to transmit (or \"permit\") an electric field.";
  skos:inScheme <http://vocabulary.odm2.org/variablename>;
  skos:topConceptOf <http://vocabulary.odm2.org/variablename>;
  skos:prefLabel "Permittivity";
