unit:DEG_R a qudt:Unit, qudt:Unit;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/unit>, <http://qudt.org/vocab/unit>;
  rdfs:label "Degree Rankine"@en, "Degree Rankine"@en;
  dct:description """
  The unit $\\textit{Degree Rankine}$ is a thermodynamic (absolute) temperature scale. 
  The symbol for degrees Rankine is $^\\circ R$ or $^\\circ Ra$ if necessary to distinguish it from the Rømer and Réaumur scales). 
  Zero on both the Kelvin and Rankine scales is absolute zero, but the Rankine degree is defined as equal
   to one degree Fahrenheit, rather than the one degree Celsius used by the Kelvin scale. 
  A temperature of $-459.67 ^\\circ F$ is exactly equal to $0 ^\\circ R$.
  """^^qudt:LatexString,
    """
  The unit $\\textit{Degree Rankine}$ is a thermodynamic (absolute) temperature scale. 
  The symbol for degrees Rankine is $^\\circ R$ or $^\\circ Ra$ if necessary to distinguish it from the Rømer and Réaumur scales). 
  Zero on both the Kelvin and Rankine scales is absolute zero, but the Rankine degree is defined as equal
   to one degree Fahrenheit, rather than the one degree Celsius used by the Kelvin scale. 
  A temperature of $-459.67 ^\\circ F$ is exactly equal to $0 ^\\circ R$.
  """^^qudt:LatexString;
  qudt:applicableSystem <http://qudt.org/vocab/sou/CGS>, <http://qudt.org/vocab/sou/CGS>;
  qudt:conversionMultiplier 0.5555555555555556, 0.5555555555555556;
  qudt:conversionMultiplierSN 5.555555555555556E-1, 5.555555555555556E-1;
  qudt:hasDimensionVector dimensionvector:A0E0L0I0M0H1T0D0, dimensionvector:A0E0L0I0M0H1T0D0;
  qudt:hasQuantityKind quantitykind:BoilingPoint, quantitykind:BoilingPoint, quantitykind:FlashPoint,
    quantitykind:FlashPoint, quantitykind:MeltingPoint, quantitykind:MeltingPoint, quantitykind:Temperature,
    quantitykind:Temperature, quantitykind:ThermodynamicTemperature, quantitykind:ThermodynamicTemperature;
