  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L-2I0M0H0T-2D0>;
  <http://qudt.org/schema/qudt/hasQuantityKind> <http://qudt.org/vocab/quantitykind/Unknown>;
  <http://qudt.org/schema/qudt/symbol> "mBq/(m²·d)";
