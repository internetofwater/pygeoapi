  <http://qudt.org/schema/qudt/normativeReference> "http://www.iso.org/iso/catalogue_detail?csnumber=31895"^^xsd:anyURI .

<http://qudt.org/vocab/quantitykind/RestMass> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Jisim rehat"@ms, "Klidová hmotnost"@cs, "Mirovna masa"@sl, "Ruhemasse"@de,
    "dinlenme kütlesi"@tr, "masa invariante"@es, "masa invariantă"@ro, "masa spoczynkowa"@pl,
    "massa a riposo"@it, "massa de repouso"@pt, "masse au repos"@fr, "rest mass"@en, "инвариантная масса"@ru,
    "جرم سکون"@fa, "كتلة ساكنة"@ar, "निश्चर द्रव्यमान"@hi, "不変質量"@ja, "静止质量"@zh;
  rdfs:comment "Applicable units are those of quantitykind:Mass";
  dct:description "The $\\textit{Rest Mass}$, the invariant mass, intrinsic mass, proper mass, or (in the case of bound systems or objects observed in their center of momentum frame) simply mass, is a characteristic of the total energy and momentum of an object or a system of objects that is the same in all frames of reference related by Lorentz transformations. The mass of a particle type X (electron, proton or neutron) when that particle is at rest. For an electron: $m_e = 9,109 382 15(45) 10^{-31} kg$, for a proton: $m_p = 1,672 621 637(83) 10^{-27} kg$, for a neutron: $m_n = 1,674 927 211(84) 10^{-27} kg$. Rest mass is often denoted $m_0$."^^<http://qudt.org/schema/qudt/LatexString>;
  skos:altLabel "Proper Mass", "invariantna masa"@sl, "lastna masa"@sl, "masa niezmiennicza"@pl,
    "masse invariante"@fr, "masse propre"@fr, "träge Masse"@de, "масса покоя"@ru;
  skos:broader <http://qudt.org/vocab/quantitykind/Mass>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L0I0M1H0T0D0>;
  <http://qudt.org/schema/qudt/informativeReference> "http://www.iso.org/iso/home/store/catalogue_tc/catalogue_detail.htm?csnumber=31895"^^xsd:anyURI,
    "http://en.wikipedia.org/wiki/Invariant_mass"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/symbol> "m_X";
  <http://qudt.org/schema/qudt/isoNormativeReference> "http://www.iso.org/iso/catalogue_detail?csnumber=31895"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/applicableUnit> unit:AMU, unit:U, unit:CARAT, unit:CWT_LONG,
    unit:Hundredweight_UK, unit:CWT_SHORT, unit:Hundredweight_US, unit:CentiGM, unit:DRAM_UK,
    unit:DRAM_US, unit:DWT, unit:Pennyweight, unit:DecaGM, unit:DeciGM, unit:DeciTONNE,
    unit:DeciTON_Metric, unit:EarthMass, unit:FemtoGM, unit:GM, unit:GRAIN, unit:HectoGM,
    unit:KiloGM, unit:KiloTONNE, unit:KiloTON_Metric, unit:LB, unit:LB_M, unit:LB_T, unit:LunarMass,
    unit:MOMME_Pearl, unit:MOMME_Textile, unit:MegaGM, unit:MegaTON, unit:MegaTONNE, unit:MicroGM,
    unit:MilliGM, unit:NanoGM, unit:OZ, unit:OZ_M, unit:OZ_TROY, unit:PFUND, unit:PicoGM,
    unit:PlanckMass, unit:Quarter_UK, unit:SLUG, unit:SolarMass, unit:Stone_UK, unit:TON,
