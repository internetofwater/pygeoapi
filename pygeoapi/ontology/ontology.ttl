  <http://qudt.org/schema/qudt/symbol> "inHg (32 °F)";
  <http://qudt.org/schema/qudt/uneceCommonCode> "N16" .

unit:IN_HG_60DEG_F a <http://qudt.org/schema/qudt/Unit>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/unit>;
  rdfs:label "inch of mercury (60 °F)";
  dct:description "non SI-conform unit of pressure according to the Anglo-American and Imperial system for units, whereas the value of 1 inHg meets the static pressure, which is generated by a mercury at a temperature of 60°F with a height of 1 inch";
