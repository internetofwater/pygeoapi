quantitykind:MachNumber a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "Mach number"@en, "Mach number"@en, "Mach sayısı"@tr, "Mach sayısı"@tr,
    "Mach-Zahl"@de, "Mach-Zahl"@de, "Machovo číslo"@cs, "Machovo číslo"@cs, "Machovo število"@sl,
    "Machovo število"@sl, "Nombor Mach"@ms, "Nombor Mach"@ms, "liczba Macha"@pl, "liczba Macha"@pl,
    "nombre de Mach"@fr, "nombre de Mach"@fr, "numero di Mach"@it, "numero di Mach"@it,
    "număr Mach"@ro, "număr Mach"@ro, "número de Mach"@es, "número de Mach"@es, "número de Mach"@pt,
    "número de Mach"@pt, "число Маха"@ru, "число Маха"@ru, "عدد ماخ"@ar, "عدد ماخ"@ar,
    "عدد ماخ"@fa, "عدد ماخ"@fa, "मैक संख्या"@hi, "मैक संख्या"@hi, "マッハ数n"@ja, "マッハ数n"@ja,
    "马赫"@zh, "马赫"@zh;
  rdfs:comment "Applicable units are those of quantitykind:MachNumber", "Applicable units are those of quantitykind:MachNumber";
  dct:description "\"Mach Number\" is a dimensionless quantity representing the speed of an object moving through air or other fluid divided by the local speed of sound. It is commonly used to represent the speed of an object when it is traveling close to or above the speed of sound. The Mach number is commonly used both with objects traveling at high speed in a fluid, and with high-speed fluid flows inside channels such as nozzles, diffusers or wind tunnels. As it is defined as a ratio of two speeds, it is a dimensionless number."^^qudt:LatexString,
    "\"Mach Number\" is a dimensionless quantity representing the speed of an object moving through air or other fluid divided by the local speed of sound. It is commonly used to represent the speed of an object when it is traveling close to or above the speed of sound. The Mach number is commonly used both with objects traveling at high speed in a fluid, and with high-speed fluid flows inside channels such as nozzles, diffusers or wind tunnels. As it is defined as a ratio of two speeds, it is a dimensionless number."^^qudt:LatexString;
  skos:broader quantitykind:DimensionlessRatio, quantitykind:DimensionlessRatio;
  skos:closeMatch <http://dbpedia.org/resource/Mach_number>, <http://dbpedia.org/resource/Mach_number>;
  qudt:dbpediaMatch "http://dbpedia.org/resource/Mach_number"^^xsd:anyURI, "http://dbpedia.org/resource/Mach_number"^^xsd:anyURI;
  qudt:hasDimensionVector dimensionvector:A0E0L0I0M0H0T0D1, dimensionvector:A0E0L0I0M0H0T0D1;
  qudt:iec61360Code "0112/2///62720#UAD364", "0112/2///62720#UAD364";
  qudt:informativeReference "http://en.wikipedia.org/wiki/Mach_number"^^xsd:anyURI,
    "http://en.wikipedia.org/wiki/Mach_number"^^xsd:anyURI, "https://cdd.iec.ch/cdd/iec61987/iec61987.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD364"^^xsd:anyURI,
    "https://cdd.iec.ch/cdd/iec61987/iec61987.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD364"^^xsd:anyURI;
  qudt:symbol "Ma", "Ma";
  qudt:isoNormativeReference "http://www.iso.org/iso/catalogue_detail?csnumber=31896"^^xsd:anyURI,
    "http://www.iso.org/iso/catalogue_detail?csnumber=31896"^^xsd:anyURI;
  qudt:plainTextDescription "\"Mach Number\" is a dimensionless quantity representing the speed of an object moving through air or other fluid divided by the local speed of sound. It is commonly used to represent the speed of an object when it is traveling close to or above the speed of sound. The Mach number is commonly used both with objects traveling at high speed in a fluid, and with high-speed fluid flows inside channels such as nozzles, diffusers or wind tunnels. As it is defined as a ratio of two speeds, it is a dimensionless number.",
    "\"Mach Number\" is a dimensionless quantity representing the speed of an object moving through air or other fluid divided by the local speed of sound. It is commonly used to represent the speed of an object when it is traveling close to or above the speed of sound. The Mach number is commonly used both with objects traveling at high speed in a fluid, and with high-speed fluid flows inside channels such as nozzles, diffusers or wind tunnels. As it is defined as a ratio of two speeds, it is a dimensionless number.";
  qudt:latexDefinition "$Ma = \\frac{v_o}{c_o}$, where $v_0$ is speed, and $c_o$ is speed of sound."^^qudt:LatexString,
    "$Ma = \\frac{v_o}{c_o}$, where $v_0$ is speed, and $c_o$ is speed of sound."^^qudt:LatexString;
  qudt:qkdvDenominator dimensionvector:A0E0L1I0M0H0T-1D0, dimensionvector:A0E0L1I0M0H0T-1D0;
  qudt:qkdvNumerator dimensionvector:A0E0L1I0M0H0T-1D0, dimensionvector:A0E0L1I0M0H0T-1D0;
  qudt:applicableUnit unit:MACH, unit:MACH;
  qudt:normativeReference "http://www.iso.org/iso/catalogue_detail?csnumber=31896"^^xsd:anyURI,
    "http://www.iso.org/iso/catalogue_detail?csnumber=31896"^^xsd:anyURI .

