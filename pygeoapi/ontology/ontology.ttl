  <http://qudt.org/schema/qudt/conversionMultiplierSN> 1.0E-1;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E2L-3I0M-1H0T3D0>;
  <http://qudt.org/schema/qudt/hasQuantityKind> <http://qudt.org/vocab/quantitykind/Conductivity>;
  <http://qudt.org/schema/qudt/symbol> "dS/m";
  <http://qudt.org/schema/qudt/ucumCode> "dS.m-1"^^<http://qudt.org/schema/qudt/UCUMcs>,
    "dS/m"^^<http://qudt.org/schema/qudt/UCUMcs>;
  <http://qudt.org/schema/qudt/plainTextDescription> "Decisiemens per metre." .

<http://qudt.org/vocab/dimensionvector/A0E2L-3I0M-1H0T3D0> a <http://qudt.org/schema/qudt/QuantityKindDimensionVector_SI>,
    <http://qudt.org/schema/qudt/QuantityKindDimensionVector_ISO>, <http://qudt.org/schema/qudt/QuantityKindDimensionVector_Imperial>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/dimensionvector>;
  rdfs:label "A0E2L-3I0M-1H0T3D0";
  <http://qudt.org/schema/qudt/dimensionExponentForAmountOfSubstance> 0;
  <http://qudt.org/schema/qudt/dimensionExponentForElectricCurrent> 2;
  <http://qudt.org/schema/qudt/dimensionExponentForLength> -3;
  <http://qudt.org/schema/qudt/dimensionExponentForLuminousIntensity> 0;
