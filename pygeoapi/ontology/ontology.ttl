  <http://qudt.org/schema/qudt/uneceCommonCode> "F68" .

unit:KiloGM-PER-MIN-K a <http://qudt.org/schema/qudt/Unit>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/unit>;
  rdfs:label "kilogram per minute kelvin";
  dct:description "SI base unit kilogram divided by the product out of the unit minute and the SI base unit kelvin";
  <http://qudt.org/schema/qudt/conversionMultiplier> 0.01666666666666666666666666666666667;
  <http://qudt.org/schema/qudt/conversionMultiplierSN> 1.666666666666666666666666666666667E-2;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L0I0M1H-1T-1D0>;
