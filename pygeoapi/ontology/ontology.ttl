    skos:note "Added to support Critical Zone Observatory (CZO) data use cases. " ;
    skos:prefLabel "Activity, beta-N-acetyl glucosaminidase" ;
    skos:topConceptOf <http://vocabulary.odm2.org/variablename> .

variablename:activityPhenolOxidase a skos:Concept ;
    skos:definition "Assay for microbial activity using phenol oxidase" ;
    skos:exactMatch "https://www.encyclopedia.com/education/dictionaries-thesauruses-pictures-and-press-releases/microbiological-assay" ;
    skos:inScheme <http://vocabulary.odm2.org/variablename> ;
    skos:note "Added to support Critical Zone Observatory (CZO) data use cases. " ;
    skos:prefLabel "Activity, phenol oxidase" ;
    skos:topConceptOf <http://vocabulary.odm2.org/variablename> .

variablename:adamantane a skos:Concept ;
    skos:definition "Adamantane (C10H16)" ;
    skos:historyNote "Originally from the CUAHSI HIS VariableNameCV.  See: http://his.cuahsi.org/mastercvreg/edit_cv11.aspx?tbl=VariableNameCV." ;
    skos:inScheme <http://vocabulary.odm2.org/variablename> ;
    skos:prefLabel "Adamantane" ;
    skos:topConceptOf <http://vocabulary.odm2.org/variablename> .

variablename:agencyCode a skos:Concept ;
    skos:definition "Code for the agency which analyzed the sample" ;
    skos:historyNote "Originally from the CUAHSI HIS VariableNameCV.  See: http://his.cuahsi.org/mastercvreg/edit_cv11.aspx?tbl=VariableNameCV." ;
    skos:inScheme <http://vocabulary.odm2.org/variablename> ;
    skos:prefLabel "Agency code" ;
    skos:topConceptOf <http://vocabulary.odm2.org/variablename> .

variablename:albedo a skos:Concept ;
    skos:definition "The ratio of reflected to incident light." ;
    skos:historyNote "Originally from the CUAHSI HIS VariableNameCV.  See: http://his.cuahsi.org/mastercvreg/edit_cv11.aspx?tbl=VariableNameCV." ;
    skos:inScheme <http://vocabulary.odm2.org/variablename> ;
    skos:prefLabel "Albedo" ;
    skos:topConceptOf <http://vocabulary.odm2.org/variablename> .

variablename:albite a skos:Concept ;
    skos:definition "Albite is a plagioclase feldspar mineral. It is the sodium endmember of the plagioclase solid solution series. As such it represents a plagioclase with less than 10% anorthite content." ;
    skos:exactMatch "https://en.wikipedia.org/wiki/Albite" ;
    skos:historyNote "Wikipedia" ;
    skos:inScheme <http://vocabulary.odm2.org/variablename> ;
    skos:note "Added to support Critical Zone Observatory (CZO) data use cases. " ;
    skos:prefLabel "Albite" ;
    skos:topConceptOf <http://vocabulary.odm2.org/variablename> .

variablename:aldrin a skos:Concept ;
    skos:definition "Aldrin (C12H8Cl6)" ;
    skos:historyNote "Originally from the CUAHSI HIS VariableNameCV.  See: http://his.cuahsi.org/mastercvreg/edit_cv11.aspx?tbl=VariableNameCV." ;
    skos:inScheme <http://vocabulary.odm2.org/variablename> ;
    skos:prefLabel "Aldrin" ;
    skos:topConceptOf <http://vocabulary.odm2.org/variablename> .

variablename:alkaliFeldspar a skos:Concept ;
    skos:definition "The alkali feldspar group are those feldspar minerals rich in the alkali elements like potassium and sodium. The alkali feldspars include albite, anorthoclase, microcline, orthoclase and sanidine." ;
    skos:exactMatch "https://en.wikipedia.org/wiki/Alkali_feldspar" ;
    skos:historyNote "Wikipedia" ;
    skos:inScheme <http://vocabulary.odm2.org/variablename> ;
    skos:note "Added to support Critical Zone Observatory (CZO) data use cases. " ;
    skos:prefLabel "Alkali feldspar" ;
    skos:topConceptOf <http://vocabulary.odm2.org/variablename> .

variablename:alkalinityCarbonatePlusBicarbonate a skos:Concept ;
    skos:definition "Alkalinity, carbonate plus bicarbonate" ;
    skos:historyNote "Originally from the CUAHSI HIS VariableNameCV.  See: http://his.cuahsi.org/mastercvreg/edit_cv11.aspx?tbl=VariableNameCV." ;
    skos:inScheme <http://vocabulary.odm2.org/variablename> ;
    skos:prefLabel "Alkalinity, carbonate plus bicarbonate" ;
    skos:topConceptOf <http://vocabulary.odm2.org/variablename> .

variablename:alloxanthin a skos:Concept ;
    skos:definition "The phytoplankton pigment Alloxanthin" ;
    skos:historyNote "Originally from the CUAHSI HIS VariableNameCV.  See: http://his.cuahsi.org/mastercvreg/edit_cv11.aspx?tbl=VariableNameCV." ;
    skos:inScheme <http://vocabulary.odm2.org/variablename> ;
    skos:prefLabel "Alloxanthin" ;
    skos:topConceptOf <http://vocabulary.odm2.org/variablename> .

variablename:alluviumDepth a skos:Concept ;
    skos:definition "Alluvium is loose, unconsolidated (not cemented together into a solid rock) soil or sediment that has been eroded, reshaped by water in some form, and redeposited in a non-marine setting. Alluvium is typically made up of a variety of materials, including fine particles of silt and clay and larger particles of sand and gravel. When this loose alluvial material is deposited or cemented into a lithological unit, or lithified, it is called an alluvial deposit." ;
    skos:exactMatch "https://en.wikipedia.org/wiki/Alluvium" ;
    skos:historyNote "Wikipedia" ;
    skos:inScheme <http://vocabulary.odm2.org/variablename> ;
    skos:note "Added to support Critical Zone Observatory (CZO) data use cases. " ;
    skos:prefLabel "Alluvium depth" ;
    skos:topConceptOf <http://vocabulary.odm2.org/variablename> .

variablename:alphaNAcetylglucosaminidase a skos:Concept ;
    ns3:category "Chemistry" ;
    skos:definition "An enzyme with system name alpha-N-acetyl-D-glucosaminide N-acetylglucosaminohydrolase.[1][2][3][4] This enzyme catalyses the following chemical reaction: Hydrolysis of terminal non-reducing N-acetyl-D-glucosamine residues in N-acetyl-alpha-D-glucosaminides." ;
    skos:exactMatch "https://en.wikipedia.org/wiki/Alpha-N-acetylglucosaminidase" ;
    skos:historyNote "Wikipedia" ;
    skos:inScheme <http://vocabulary.odm2.org/variablename> ;
    skos:prefLabel "Alpha-N-Acetylglucosaminidase" ;
    skos:topConceptOf <http://vocabulary.odm2.org/variablename> .

variablename:altitude a skos:Concept ;
    skos:definition "Altitude or height (sometimes known as depth) is defined based on the context in which it is used (aviation, geometry, geographical survey, sport, atmospheric pressure, and many more). As a general definition, altitude is a distance measurement, usually in the vertical or \"up\" direction, between a reference datum and a point or object. The reference datum also often varies according to the context. Although the term altitude is commonly used to mean the height above sea level of a location, in geography the term elevation is often preferred for this usage." ;
    skos:exactMatch "https://en.wikipedia.org/wiki/Altitude" ;
    skos:historyNote "Wikipedia" ;
    skos:inScheme <http://vocabulary.odm2.org/variablename> ;
    skos:prefLabel "Altitude" ;
    skos:topConceptOf <http://vocabulary.odm2.org/variablename> .

variablename:aluminumDissolved a skos:Concept ;
    skos:definition "Dissolved Aluminum (Al)" ;
    skos:historyNote "Originally from the CUAHSI HIS VariableNameCV.  See: http://his.cuahsi.org/mastercvreg/edit_cv11.aspx?tbl=VariableNameCV." ;
    skos:inScheme <http://vocabulary.odm2.org/variablename> ;
    skos:prefLabel "Aluminum, dissolved" ;
    skos:topConceptOf <http://vocabulary.odm2.org/variablename> .

variablename:aluminumParticulate a skos:Concept ;
    skos:definition "Particulate aluminum in suspension" ;
    skos:historyNote "Originally from the CUAHSI HIS VariableNameCV.  See: http://his.cuahsi.org/mastercvreg/edit_cv11.aspx?tbl=VariableNameCV." ;
    skos:inScheme <http://vocabulary.odm2.org/variablename> ;
    skos:prefLabel "Aluminum, particulate" ;
    skos:topConceptOf <http://vocabulary.odm2.org/variablename> .

variablename:aluminumTotal a skos:Concept ;
    skos:definition "Aluminum (Al). Total indicates was measured on a whole water sample." ;
    skos:historyNote "Originally from the CUAHSI HIS VariableNameCV.  See: http://his.cuahsi.org/mastercvreg/edit_cv11.aspx?tbl=VariableNameCV." ;
    skos:inScheme <http://vocabulary.odm2.org/variablename> ;
    skos:prefLabel "Aluminum, total" ;
    skos:topConceptOf <http://vocabulary.odm2.org/variablename> .

variablename:ammoniumFlux a skos:Concept ;
    skos:definition "Ammonium (NH4) flux" ;
    skos:historyNote "Originally from the CUAHSI HIS VariableNameCV.  See: http://his.cuahsi.org/mastercvreg/edit_cv11.aspx?tbl=VariableNameCV." ;
    skos:inScheme <http://vocabulary.odm2.org/variablename> ;
    skos:prefLabel "Ammonium flux" ;
    skos:topConceptOf <http://vocabulary.odm2.org/variablename> .

variablename:amphibole a skos:Concept ;
    skos:definition "Amphibole is an important group of inosilicate minerals, forming prism or needlelike crystals, composed of double chain SiO 4 tetrahedra, linked at the vertices and generally containing ions of iron and/or magnesium in their structures." ;
    skos:exactMatch "https://en.wikipedia.org/wiki/Amphibole" ;
    skos:historyNote "Wikipedia" ;
    skos:inScheme <http://vocabulary.odm2.org/variablename> ;
    skos:note "Added to support Critical Zone Observatory (CZO) data use cases. " ;
    skos:prefLabel "Amphibole" ;
    skos:topConceptOf <http://vocabulary.odm2.org/variablename> .

variablename:antimonyDissolved a skos:Concept ;
    skos:definition "Dissolved antimony (Sb).\"Dissolved\" indicates measurement was on a filtered sample." ;
    skos:historyNote "Originally from the CUAHSI HIS VariableNameCV.  See: http://his.cuahsi.org/mastercvreg/edit_cv11.aspx?tbl=VariableNameCV." ;
    skos:inScheme <http://vocabulary.odm2.org/variablename> ;
    skos:prefLabel "Antimony, dissolved" ;
    skos:topConceptOf <http://vocabulary.odm2.org/variablename> .

variablename:antimonyDistributionCoefficient a skos:Concept ;
    skos:definition "Ratio of concentrations of antimony in two phases in equilibrium with each other. Phases must be specified." ;
    skos:historyNote "Originally from the CUAHSI HIS VariableNameCV.  See: http://his.cuahsi.org/mastercvreg/edit_cv11.aspx?tbl=VariableNameCV." ;
    skos:inScheme <http://vocabulary.odm2.org/variablename> ;
    skos:prefLabel "Antimony, distribution coefficient" ;
    skos:topConceptOf <http://vocabulary.odm2.org/variablename> .

variablename:antimonyParticulate a skos:Concept ;
    skos:definition "Particulate antimony (Sb) in suspension" ;
    skos:historyNote "Originally from the CUAHSI HIS VariableNameCV.  See: http://his.cuahsi.org/mastercvreg/edit_cv11.aspx?tbl=VariableNameCV." ;
    skos:inScheme <http://vocabulary.odm2.org/variablename> ;
    skos:prefLabel "Antimony, particulate" ;
    skos:topConceptOf <http://vocabulary.odm2.org/variablename> .

variablename:antimonyTotal a skos:Concept ;
    skos:definition "Total antimony (Sb). \"Total\" indicates was measured on a whole water (unfiltered) sample." ;
    skos:historyNote "Originally from the CUAHSI HIS VariableNameCV.  See: http://his.cuahsi.org/mastercvreg/edit_cv11.aspx?tbl=VariableNameCV." ;
    skos:inScheme <http://vocabulary.odm2.org/variablename> ;
    skos:prefLabel "Antimony, total" ;
    skos:topConceptOf <http://vocabulary.odm2.org/variablename> .

variablename:apophyllite a skos:Concept ;
    skos:definition "The name apophyllite refers to a specific group of phyllosilicates, a class of minerals. Originally, the group name referred to a specific mineral, but was redefined in 1978 to stand for a class of minerals of similar chemical makeup that comprise a solid solution series, and includes the members fluorapophyllite-(K), fluorapophyllite-(Na), hydroxyapophyllite-(K)." ;
    skos:exactMatch "https://en.wikipedia.org/wiki/Apophyllite" ;
    skos:historyNote "Wikipedia" ;
    skos:inScheme <http://vocabulary.odm2.org/variablename> ;
    skos:note "Added to support Critical Zone Observatory (CZO) data use cases. " ;
    skos:prefLabel "Apophyllite" ;
    skos:topConceptOf <http://vocabulary.odm2.org/variablename> .

variablename:areaBasal a skos:Concept ;
    skos:definition "Basal area is the area of a given section of land that is occupied by the cross-section of tree trunks and stems at the base. The term is used in forest management and forest ecology." ;
    skos:exactMatch "https://en.wikipedia.org/wiki/Basal_area" ;
    skos:historyNote "Wikipedia" ;
    skos:inScheme <http://vocabulary.odm2.org/variablename> ;
    skos:note "Added to support Critical Zone Observatory (CZO) data use cases. " ;
    skos:prefLabel "Area, basal" ;
    skos:topConceptOf <http://vocabulary.odm2.org/variablename> .

variablename:argon a skos:Concept ;
    skos:definition "Argon" ;
    skos:historyNote "Originally from the CUAHSI HIS VariableNameCV.  See: http://his.cuahsi.org/mastercvreg/edit_cv11.aspx?tbl=VariableNameCV." ;
    skos:inScheme <http://vocabulary.odm2.org/variablename> ;
    skos:prefLabel "Argon" ;
    skos:topConceptOf <http://vocabulary.odm2.org/variablename> .

variablename:argonDissolved a skos:Concept ;
    skos:definition "Dissolved Argon" ;
    skos:historyNote "Originally from the CUAHSI HIS VariableNameCV.  See: http://his.cuahsi.org/mastercvreg/edit_cv11.aspx?tbl=VariableNameCV." ;
    skos:inScheme <http://vocabulary.odm2.org/variablename> ;
    skos:prefLabel "Argon, dissolved" ;
    skos:topConceptOf <http://vocabulary.odm2.org/variablename> .

variablename:arsenicDissolved a skos:Concept ;
    skos:definition "Dissolved Arsenic. For chemical terms, dissolved represents a filtered sample." ;
    skos:historyNote "Originally from the CUAHSI HIS VariableNameCV.  See: http://his.cuahsi.org/mastercvreg/edit_cv11.aspx?tbl=VariableNameCV." ;
    skos:inScheme <http://vocabulary.odm2.org/variablename> ;
    skos:prefLabel "Arsenic, dissolved" ;
    skos:topConceptOf <http://vocabulary.odm2.org/variablename> .

variablename:arsenicDistributionCoefficient a skos:Concept ;
    skos:definition "Ratio of concentrations of arsenic in two phases in equilibrium with each other. Phases must be specified." ;
    skos:historyNote "Originally from the CUAHSI HIS VariableNameCV.  See: http://his.cuahsi.org/mastercvreg/edit_cv11.aspx?tbl=VariableNameCV." ;
    skos:inScheme <http://vocabulary.odm2.org/variablename> ;
    skos:prefLabel "Arsenic, distribution coefficient" ;
    skos:topConceptOf <http://vocabulary.odm2.org/variablename> .

