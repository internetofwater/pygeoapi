quantitykind:RadiantExposure a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "Radiant Exposure"@en, "Radiant Exposure"@en;
  rdfs:comment "Applicable units are those of quantitykind:EnergyPerArea", "Applicable units are those of quantitykind:EnergyPerArea";
  dct:description "Radiant exposure is a measure of the total radiant energy incident on a surface per unit area; equal to the integral over time of the radiant flux density. Also known as exposure."^^qudt:LatexString,
    "Radiant exposure is a measure of the total radiant energy incident on a surface per unit area; equal to the integral over time of the radiant flux density. Also known as exposure."^^qudt:LatexString;
  skos:broader quantitykind:EnergyPerArea, quantitykind:EnergyPerArea;
  qudt:hasDimensionVector dimensionvector:A0E0L0I0M1H0T-2D0, dimensionvector:A0E0L0I0M1H0T-2D0;
  qudt:iec61360Code "0112/2///62720#UAD150", "0112/2///62720#UAD150";
  qudt:informativeReference "http://omlc.ogi.edu/education/ece532/class1/irradiance.html"^^xsd:anyURI,
    "http://omlc.ogi.edu/education/ece532/class1/irradiance.html"^^xsd:anyURI, "https://cdd.iec.ch/cdd/iec61987/iec61987.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD150"^^xsd:anyURI,
    "https://cdd.iec.ch/cdd/iec61987/iec61987.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD150"^^xsd:anyURI;
  qudt:symbol "H_e", "H_e";
  qudt:plainTextDescription "Radiant exposure is a measure of the total radiant energy incident on a surface per unit area; equal to the integral over time of the radiant flux density. Also known as exposure.",
    "Radiant exposure is a measure of the total radiant energy incident on a surface per unit area; equal to the integral over time of the radiant flux density. Also known as exposure.";
  qudt:latexDefinition "$H = \\int_{0}^{\\Delta t}{E}{dt}$, where $E$ is the irradiance acting during the time interval with duration $\\Delta t$."^^qudt:LatexString,
    "$H = \\int_{0}^{\\Delta t}{E}{dt}$, where $E$ is the irradiance acting during the time interval with duration $\\Delta t$."^^qudt:LatexString;
