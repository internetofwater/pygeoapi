<http://qudt.org/vocab/quantitykind/CurieTemperature> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Curie sıcaklığı"@tr, "Curie temperature"@en, "Curie-Temperatur"@de, "Curieova teplota"@cs,
    "Punct Curie"@ro, "Suhu Curie"@ms, "punto di Curie"@it, "temperatura Curie"@pl, "temperatura de Curie"@es,
    "temperatura de Curie"@pt, "température de Curie"@fr, "Точка Кюри"@ru, "درجة حرارة كوري"@ar,
    "نقطه کوری"@fa, "क्यूरी ताप"@hi, "キュリー温度"@ja, "居里点"@zh;
  rdfs:comment "Applicable units are those of quantitykind:Temperature";
  dct:description "\"Curie Temperature\" is the critical thermodynamic temperature of a ferromagnet."^^<http://qudt.org/schema/qudt/LatexString>;
  skos:broader <http://qudt.org/vocab/quantitykind/Temperature>;
  skos:closeMatch <http://qudt.org/vocab/quantitykind/NeelTemperature>, <http://qudt.org/vocab/quantitykind/SuperconductionTransitionTemperature>;
