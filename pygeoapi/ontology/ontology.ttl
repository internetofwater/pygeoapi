unit:CCY_NOK-PER-KiloW-HR a qudt:Unit ;
    rdfs:label "Norwegian Krone per KiloWatt Hour"@en,
        "Norwegian Krone per kilowatt hour"@en ;
    qudt:applicableSystem <http://qudt.org/vocab/sou/SI> ;
    qudt:conversionMultiplier 0.0000002777777777777777777777777777777778 ;
    qudt:conversionMultiplierSN 2.777778e-07 ;
    qudt:hasDimensionVector dimensionvector:A0E0L-2I0M-1H0T2D0 ;
    qudt:hasFactorUnit [ qudt:exponent -1 ;
            qudt:hasUnit unit:HR ],
        [ qudt:exponent -1 ;
            qudt:hasUnit unit:KiloW ],
        [ qudt:exponent 1 ;
            qudt:hasUnit unit:CCY_NOK ],
        [ qudt:exponent -1 ;
            qudt:hasUnit unit:HR ],
        [ qudt:exponent -1 ;
            qudt:hasUnit unit:KiloW ],
        [ qudt:exponent 1 ;
            qudt:hasUnit unit:CCY_NOK ],
        [ qudt:exponent -1 ;
            qudt:hasUnit unit:HR ],
        [ qudt:exponent -1 ;
            qudt:hasUnit unit:KiloW ],
        [ qudt:exponent 1 ;
            qudt:hasUnit unit:CCY_NOK ] ;
    qudt:hasQuantityKind quantitykind:CostPerEnergy ;
    qudt:plainTextDescription "Unit for measuring the cost of electricity." ;
    qudt:symbol "kr/(kW·h)" ;
    rdfs:isDefinedBy <http://qudt.org/vocab/unit> .

