  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/unit>, <http://qudt.org/vocab/unit>;
  rdfs:label "Statcoulomb per Square Centimeter"@en-US, "Statcoulomb per Square Centimeter"@en-US,
