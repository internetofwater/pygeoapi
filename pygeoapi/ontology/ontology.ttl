unit:KiloW a qudt:Unit, qudt:Unit, qudt:DerivedUnit, qudt:DerivedUnit;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/unit>, <http://qudt.org/vocab/unit>;
  rdfs:label "Kilowatt"@en, "Kilowatt"@en;
  dct:description """
  The unit $\\textit{Kilowatt}$ is a derived unit of power in the International System of Units (SI). 
  The unit, defined as 1,000 joule per second, measures the rate of energy conversion or transfer.
  """^^qudt:LatexString,
    """
  The unit $\\textit{Kilowatt}$ is a derived unit of power in the International System of Units (SI). 
  The unit, defined as 1,000 joule per second, measures the rate of energy conversion or transfer.
  """^^qudt:LatexString;
  qudt:applicableSystem <http://qudt.org/vocab/sou/CGS-EMU>, <http://qudt.org/vocab/sou/CGS-EMU>,
    <http://qudt.org/vocab/sou/CGS-GAUSS>, <http://qudt.org/vocab/sou/CGS-GAUSS>, <http://qudt.org/vocab/sou/PLANCK>,
