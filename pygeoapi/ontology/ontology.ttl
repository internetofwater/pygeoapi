    unit:PER-CentiM3, unit:PER-FT3, unit:PER-IN3, unit:PER-MilliL, unit:PER-YD3 .

<http://qudt.org/vocab/quantitykind/IonDensity> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Ion Density"@en;
  rdfs:comment "Applicable units are those of quantitykind:NumberDensity";
  dct:description "\"Ion Density\" is the number of ions per unit volume. Also known as ion concentration."^^<http://qudt.org/schema/qudt/LatexString>;
  skos:broader <http://qudt.org/vocab/quantitykind/NumberDensity>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L-3I0M0H0T0D0>;
  <http://qudt.org/schema/qudt/informativeReference> "http://www.answers.com/topic/ion-density"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/symbol> "N, n^+, n^-";
  <http://qudt.org/schema/qudt/plainTextDescription> "\"Ion Density\" is the number of ions per unit volume. Also known as ion concentration.";
  <http://qudt.org/schema/qudt/exactMatch> <http://qudt.org/vocab/quantitykind/IonConcentration>;
  <http://qudt.org/schema/qudt/latexDefinition> """$n^+ = \\frac{N^+}{V}$, $n^- = \\frac{N^-}{V}$

where $N^+$ and $N^-$ are the number of positive and negative ions, respectively, in a 3D domain with volume $V$."""^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/applicableUnit> unit:NUM-PER-L, unit:NUM-PER-M3, unit:NUM-PER-MicroL,
    unit:NUM-PER-MilliL, unit:NUM-PER-MilliM3, unit:NUM-PER-NanoL, unit:NUM-PER-PicoL;
  <http://qudt.org/schema/qudt/normativeReference> "http://www.iso.org/iso/catalogue_detail?csnumber=31895"^^xsd:anyURI .

<http://qudt.org/vocab/quantitykind/IonCurrent> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Ion Current"@en;
  rdfs:comment "Applicable units are those of quantitykind:ElectricCurrent";
  dct:description "An ion current is the influx and/or efflux of ions through an ion channel."^^<http://qudt.org/schema/qudt/LatexString>;
  skos:broader <http://qudt.org/vocab/quantitykind/ElectricCurrent>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E1L0I0M0H0T0D0>;
  <http://qudt.org/schema/qudt/symbol> "j";
  <http://qudt.org/schema/qudt/plainTextDescription> "An ion current is the influx and/or efflux of ions through an ion channel.";
  <http://qudt.org/schema/qudt/applicableUnit> unit:A, unit:A_Ab, unit:BIOT, unit:A_Stat,
    unit:AttoA, unit:FemtoA, unit:GigaA, unit:KiloA, unit:MegaA, unit:MicroA, unit:MilliA,
    unit:NanoA, unit:PetaA, unit:PicoA, unit:PlanckCurrent, unit:TeraA .

<http://qudt.org/vocab/quantitykind/IonicCharge> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Ionic Charge"@en;
  rdfs:comment "Applicable units are those of quantitykind:ElectricCharge";
  dct:description "The total charge of an ion. The charge of an electron; the charge of any ion is equal to this electron charge in magnitude, or is an integral multiple of it."^^<http://qudt.org/schema/qudt/LatexString>;
  skos:broader <http://qudt.org/vocab/quantitykind/ElectricCharge>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E1L0I0M0H0T1D0>;
  <http://qudt.org/schema/qudt/symbol> "q";
  <http://qudt.org/schema/qudt/plainTextDescription> "The total charge of an ion. The charge of an electron; the charge of any ion is equal to this electron charge in magnitude, or is an integral multiple of it.";
  <http://qudt.org/schema/qudt/applicableUnit> unit:A-HR, unit:A-SEC, unit:AttoC, unit:C,
    unit:C_Ab, unit:C_Stat, unit:FR, unit:CentiC, unit:DecaC, unit:DeciC, unit:E, unit:ElementaryCharge,
    unit:ExaC, unit:F, unit:FemtoC, unit:GigaC, unit:HectoC, unit:KiloA-HR, unit:KiloC,
    unit:KiloJ-PER-KiloV, unit:MegaC, unit:MicroC, unit:MilliA-HR, unit:MilliA-SEC, unit:MilliC,
    unit:NanoC, unit:PetaC, unit:PicoC, unit:PlanckCharge, unit:TeraC, unit:YoctoC, unit:YottaC,
    unit:ZeptoC, unit:ZettaC .

<http://qudt.org/vocab/quantitykind/IsothermalMoistureCapacity> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Isothermal Moisture Capacity"@en;
  rdfs:comment "Applicable units are those of quantitykind:SpecificVolume";
  dct:description "\"Isothermal Moisture Capacity\" is the capacity of a material to absorb moisture in the Effective Moisture Penetration Depth (EMPD) model."^^<http://qudt.org/schema/qudt/LatexString>;
  skos:broader <http://qudt.org/vocab/quantitykind/SpecificVolume>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L3I0M-1H0T0D0>;
  <http://qudt.org/schema/qudt/informativeReference> "https://bigladdersoftware.com/epx/docs/8-4/engineering-reference/effective-moisture-penetration-depth-empd.html#empd-nomenclature"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/applicableUnit> unit:CentiM3-PER-GM, unit:MilliL-PER-GM,
    unit:DeciL-PER-GM, unit:DeciM3-PER-KiloGM, unit:FT3-PER-LB, unit:IN3-PER-LB, unit:L-PER-KiloGM,
    unit:M3-PER-KiloGM, unit:MilliL-PER-KiloGM, unit:MilliM3-PER-GM, unit:MilliM3-PER-KiloGM .

<http://qudt.org/vocab/quantitykind/MolecularViscosity> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:seeAlso <http://qudt.org/vocab/quantitykind/DynamicViscosity>, <http://qudt.org/vocab/quantitykind/KinematicViscosity>;
  rdfs:label "Molecular Viscosity"@en;
  dct:description "Molecules in a fluid close to a solid boundary sometime strike the boundary and transfer momentum to it. Molecules further from the boundary collide with molecules that have struck the boundary, further transferring the change in momentum into the interior of the fluid. This transfer of momentum is molecular viscosity. Molecules, however, travel only micrometers between collisions, and the process is very inefficient for transferring momentum even a few centimeters. Molecular viscosity is important only within a few millimeters of a boundary. The coefficient of molecular viscosity has the same value as the dynamic viscosity."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L-1I0M1H0T-1D0>;
  <http://qudt.org/schema/qudt/informativeReference> "http://oceanworld.tamu.edu/resources/ocng_textbook/chapter08/chapter08_01.htm"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/plainTextDescription> "Molecules in a fluid close to a solid boundary sometime strike the boundary and transfer momentum to it. Molecules further from the boundary collide with molecules that have struck the boundary, further transferring the change in momentum into the interior of the fluid. This transfer of momentum is molecular viscosity. Molecules, however, travel only micrometers between collisions, and the process is very inefficient for transferring momentum even a few centimeters. Molecular viscosity is important only within a few millimeters of a boundary. The coefficient of molecular viscosity has the same value as the dynamic viscosity." .

<http://qudt.org/vocab/quantitykind/KinematicViscosityOrDiffusionConstantOrThermalDiffusivity>
  a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "kinematic viscosity or diffusion constant or thermal diffusivity"@en-US;
  dct:description "ratio of the dynamic viscosity and the density of a material measured at the same temperature, or ratio of the diffusion current density and carrier density gradient, or ratio of thermal conductivity divided by heat capacity"@en;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L2I0M0H0T-1D0>;
  <http://qudt.org/schema/qudt/symbol> "0173-1#Z4-BAJ328#002";
  <http://qudt.org/schema/qudt/plainTextDescription> "Quotient aus der dynamischen Viskosität und der Dichte eines Stoffes oder Quotient Diffusionsstromdichte durch Gradient der Ladungsträgerdichte oder Quotient Wärmeleitfähigkeit durch Wärmekapazität"@de .

<http://qudt.org/vocab/quantitykind/KineticEnergy> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Kinetic Energy"@en;
  rdfs:comment "Applicable units are those of quantitykind:Energy";
  dct:description "$\\textit{Kinetic Energy}$ is the energy which a body possesses as a consequence of its motion, defined as one-half the product of its mass $m$ and the square of its speed $v$, $ \\frac{1}{2} mv^{2} $. The kinetic energy per unit volume of a fluid parcel is the $ \\frac{1}{2}  p v^{2}$ , where $p$ is the density and $v$ the speed of the parcel. See potential energy. For relativistic speeds the kinetic energy is given by $E_k = mc^2 - m_0 c^2$, where $c$ is the velocity of light in a vacuum, $m_0$ is the rest mass, and $m$ is the moving mass."^^<http://qudt.org/schema/qudt/LatexString>;
  skos:broader <http://qudt.org/vocab/quantitykind/Energy>;
  <http://qudt.org/schema/qudt/dbpediaMatch> "http://dbpedia.org/resource/Kinetic_energy"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L2I0M1H0T-2D0>;
  <http://qudt.org/schema/qudt/iec61360Code> "0112/2///62720#UAD071";
  <http://qudt.org/schema/qudt/informativeReference> "http://en.wikipedia.org/wiki/Kinetic_energy"^^xsd:anyURI,
    "https://cdd.iec.ch/cdd/iec61987/iec61987.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD071"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/symbol> "KE";
  <http://qudt.org/schema/qudt/latexDefinition> "$T = \\frac{mv^2}{2}$, where $m$ is mass and $v$ is speed."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/altSymbol> "K";
  <http://qudt.org/schema/qudt/applicableUnit> unit:AttoJ, unit:BTU_IT, unit:BTU_TH,
    unit:CAL_IT, unit:CAL_TH, unit:ERG, unit:EV, unit:E_h, unit:ExaJ, unit:FT-LB_F, unit:FT-PDL,
    unit:FemtoJ, unit:GigaEV, unit:GigaJ, unit:GigaW-HR, unit:J, unit:KiloBTU_IT, unit:KiloBTU_TH,
    unit:KiloCAL, unit:KiloEV, unit:KiloJ, unit:KiloV-A-HR, unit:KiloV-A_Reactive-HR,
    unit:KiloW-HR, unit:MegaEV, unit:MegaJ, unit:MegaTOE, unit:MegaV-A-HR, unit:MegaV-A_Reactive-HR,
    unit:MegaW-HR, unit:MicroJ, unit:MilliJ, unit:NanoJ, unit:PetaJ, unit:PicoJ, unit:PlanckEnergy,
    unit:QUAD, unit:THERM_EC, unit:THM_EEC, unit:THERM_US, unit:THM_US, unit:TOE, unit:TeraJ,
    unit:TeraW-HR, unit:TonEnergy, unit:V-A-HR, unit:V-A_Reactive-HR, unit:W-HR, unit:W-SEC;
  <http://qudt.org/schema/qudt/normativeReference> "http://www.iso.org/iso/catalogue_detail?csnumber=31889"^^xsd:anyURI .

<http://qudt.org/vocab/quantitykind/KineticOrThermalEnergy> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "kinetic or thermal energy"@en-US;
  rdfs:comment "Applicable units are those of quantitykind:Energy";
  dct:description "energy presented in the movement of a body, composed of translation and rotation energies, determined by the movement of this body compared to another system and by its mass (mass distribution) or energy in the terms of heat"@en;
  skos:broader <http://qudt.org/vocab/quantitykind/Energy>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L2I0M1H0T-2D0>;
  <http://qudt.org/schema/qudt/symbol> "0173-1#Z4-BAJ280#002";
  <http://qudt.org/schema/qudt/plainTextDescription> "Energie, die in der Bewegung eines Körpers steckt und sich aus Translationsenergie und Rotationsenergie zusammen setzt, die durch die Bewegung dieses Körpers gegenüber einem anderen System und durch seine Masse (Massenverteilung) bestimmt wird oder Energie in Form von Wärme"@de;
  <http://qudt.org/schema/qudt/applicableUnit> unit:AttoJ, unit:BTU_IT, unit:BTU_TH,
    unit:CAL_IT, unit:CAL_TH, unit:ERG, unit:EV, unit:E_h, unit:ExaJ, unit:FT-LB_F, unit:FT-PDL,
    unit:FemtoJ, unit:GigaEV, unit:GigaJ, unit:GigaW-HR, unit:J, unit:KiloBTU_IT, unit:KiloBTU_TH,
    unit:KiloCAL, unit:KiloEV, unit:KiloJ, unit:KiloV-A-HR, unit:KiloV-A_Reactive-HR,
    unit:KiloW-HR, unit:MegaEV, unit:MegaJ, unit:MegaTOE, unit:MegaV-A-HR, unit:MegaV-A_Reactive-HR,
    unit:MegaW-HR, unit:MicroJ, unit:MilliJ, unit:NanoJ, unit:PetaJ, unit:PicoJ, unit:PlanckEnergy,
    unit:QUAD, unit:THERM_EC, unit:THM_EEC, unit:THERM_US, unit:THM_US, unit:TOE, unit:TeraJ,
    unit:TeraW-HR, unit:TonEnergy, unit:V-A-HR, unit:V-A_Reactive-HR, unit:W-HR, unit:W-SEC .

<http://qudt.org/vocab/quantitykind/LarmorAngularFrequency> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Larmor Angular Frequency"@en;
  rdfs:comment "Applicable units are those of quantitykind:AngularFrequency";
  dct:description "The \"Larmor Frequency\" describes angular momentum vector precession about the external field axis with an angular frequency."^^<http://qudt.org/schema/qudt/LatexString>;
  skos:broader <http://qudt.org/vocab/quantitykind/AngularFrequency>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T-1D0>;
  <http://qudt.org/schema/qudt/informativeReference> "http://en.wikipedia.org/wiki/Larmor_precession#Larmor_frequency"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/isoNormativeReference> "http://www.iso.org/iso/catalogue_detail?csnumber=31895"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/plainTextDescription> "The \"Larmor Frequency\" describes angular momentum vector precession about the external field axis with an angular frequency.";
  <http://qudt.org/schema/qudt/latexSymbol> "$\\omega_L$"^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/latexDefinition> "$\\omega_L = \\frac{e}{2m_e}B$, where $e$ is the elementary charge, $m_e$ is the rest mass of electron, and $B$ is the magnetic flux density."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/applicableUnit> unit:DEG-PER-HR, unit:DEG-PER-MIN, unit:DEG-PER-SEC,
    unit:PlanckFrequency_Ang, unit:RAD-PER-HR, unit:RAD-PER-MIN, unit:RAD-PER-SEC .

