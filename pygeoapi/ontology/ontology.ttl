  <http://qudt.org/schema/qudt/prefix> <http://qudt.org/vocab/prefix/Mega> .

unit:MegaJ-PER-HR a <http://qudt.org/schema/qudt/Unit>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/unit>;
