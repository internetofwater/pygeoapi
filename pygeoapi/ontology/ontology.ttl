dct:date a rdf:Property ;
    rdfs:label "Date"@en ;
    dct:description "Date may be used to express temporal information at any level of granularity.  Recommended practice is to express the date, date/time, or period of time according to ISO 8601-1 [[ISO 8601-1](https://www.iso.org/iso-8601-date-and-time-format.html)] or a published profile of the ISO standard, such as the W3C Note on Date and Time Formats [[W3CDTF](https://www.w3.org/TR/NOTE-datetime)] or the Extended Date/Time Format Specification [[EDTF](http://www.loc.gov/standards/datetime/)].  If the full date is unknown, month and year (YYYY-MM) or just year (YYYY) may be used. Date ranges may be specified using ISO 8601 period of time specification in which start and end dates are separated by a '/' (slash) character.  Either the start or end date may be missing."@en ;
    dct:issued "2008-01-14"^^xsd:date ;
    rdfs:comment "A point or period of time associated with an event in the lifecycle of the resource."@en ;
    rdfs:isDefinedBy dct: ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf dc:date .

qudt:BinaryPrefix a owl:Class ;
    rdfs:label "Binary Prefix" ;
    rdfs:comment "A <em>Binary Prefix</em> is a prefix for multiples of units in data processing, data transmission, and digital information, notably the bit and the byte, to indicate multiplication by a power of 2." ;
    rdfs:isDefinedBy <http://qudt.org/3.0.0/schema/qudt>,
        <http://qudt.org/schema/qudt> ;
    rdfs:subClassOf qudt:Prefix .

qudt:CardinalityType a owl:Class ;
    rdfs:label "Cardinality Type" ;
    dct:description """
  In mathematics, the cardinality of a set is a measure of the number of elements of the set.
  For example, the set $A = {2, 4, 6}$ contains 3 elements, and therefore $A$ has a cardinality of 3. 
  There are two approaches to cardinality: one which compares sets directly using bijections and injections,
   and another which uses cardinal numbers.
  """^^qudt:LatexString ;
    qudt:informativeReference "http://en.wikipedia.org/wiki/Cardinal_number"^^xsd:anyURI,
        "http://en.wikipedia.org/wiki/Cardinality"^^xsd:anyURI ;
    qudt:plainTextDescription "In mathematics, the cardinality of a set is a measure of the number of elements of the set.  For example, the set 'A = {2, 4, 6}' contains 3 elements, and therefore 'A' has a cardinality of 3. There are two approaches to cardinality – one which compares sets directly using bijections and injections, and another which uses cardinal numbers." ;
    rdfs:isDefinedBy <http://qudt.org/3.0.0/schema/qudt>,
        <http://qudt.org/schema/qudt> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:int ;
            owl:onProperty ns6:literal ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:int ;
            owl:onProperty ns6:literal ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:int ;
            owl:onProperty ns6:literal ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:int ;
            owl:onProperty ns6:literal ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:int ;
            owl:onProperty ns6:literal ],
        qudt:EnumeratedValue ;
    owl:oneOf ( qudt:CT_COUNTABLY-INFINITE qudt:CT_FINITE qudt:CT_UNCOUNTABLE ),
        ( qudt:CT_COUNTABLY-INFINITE qudt:CT_FINITE qudt:CT_UNCOUNTABLE ),
        ( qudt:CT_COUNTABLY-INFINITE qudt:CT_FINITE qudt:CT_UNCOUNTABLE ),
        ( qudt:CT_COUNTABLY-INFINITE qudt:CT_FINITE qudt:CT_UNCOUNTABLE ),
        ( qudt:CT_COUNTABLY-INFINITE qudt:CT_FINITE qudt:CT_UNCOUNTABLE ) .

qudt:OrderedType a owl:Class ;
    rdfs:label "Ordered type" ;
    dct:description "Describes how a data or information structure is ordered." ;
    rdfs:isDefinedBy <http://qudt.org/3.0.0/schema/qudt>,
        <http://qudt.org/schema/qudt> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:int ;
            owl:onProperty ns6:literal ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:int ;
            owl:onProperty ns6:literal ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:int ;
            owl:onProperty ns6:literal ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:int ;
            owl:onProperty ns6:literal ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:int ;
            owl:onProperty ns6:literal ],
        qudt:EnumeratedValue ;
    owl:oneOf ( qudt:Unordered qudt:PartiallyOrdered qudt:TotallyOrdered ),
        ( qudt:Unordered qudt:PartiallyOrdered qudt:TotallyOrdered ),
        ( qudt:Unordered qudt:PartiallyOrdered qudt:TotallyOrdered ),
        ( qudt:Unordered qudt:PartiallyOrdered qudt:TotallyOrdered ),
        ( qudt:Unordered qudt:PartiallyOrdered qudt:TotallyOrdered ) .

qudt:derivedUnitOfSystem a owl:ObjectProperty ;
    rdfs:label "is derived unit of system" ;
    dct:description "This property relates a unit of measure to the system of units in which it is defined as a derived unit. That is, the derived unit is defined as a product of the base units for the system raised to some rational power."^^rdf:HTML ;
    rdfs:isDefinedBy <http://qudt.org/3.0.0/schema/qudt>,
        <http://qudt.org/schema/qudt> ;
    rdfs:subPropertyOf qudt:isUnitOfSystem ;
    owl:inverseOf qudt:hasDerivedUnit .

qudt:hasDefinedUnit a owl:ObjectProperty ;
    rdfs:label "defined unit" ;
    dct:description "This property relates a unit system with a unit of measure that is defined by the system."^^rdf:HTML ;
    rdfs:isDefinedBy <http://qudt.org/3.0.0/schema/qudt>,
        <http://qudt.org/schema/qudt> ;
    rdfs:range qudt:Unit ;
    rdfs:subPropertyOf qudt:hasUnit .

qudt:hasDerivedUnit a owl:ObjectProperty ;
    rdfs:label "derived unit" ;
    dct:description "This property relates a system of units to a unit of measure that is defined within the system in terms of the base units for the system. That is, the derived unit is defined as a product of the base units for the system raised to some rational power."^^rdf:HTML ;
    rdfs:isDefinedBy <http://qudt.org/3.0.0/schema/qudt>,
        <http://qudt.org/schema/qudt> ;
    owl:inverseOf qudt:derivedUnitOfSystem .

