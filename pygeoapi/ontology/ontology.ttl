            qudt:hasUnit unit:PA ],
        [ qudt:exponent 1 ;
            qudt:hasUnit unit:SEC ],
        [ qudt:exponent -1 ;
            qudt:hasUnit unit:M ],
        [ qudt:exponent 1 ;
            qudt:hasUnit unit:PA ],
        [ qudt:exponent 1 ;
            qudt:hasUnit unit:SEC ],
        [ qudt:exponent -1 ;
            qudt:hasUnit unit:M ],
        [ qudt:exponent 1 ;
