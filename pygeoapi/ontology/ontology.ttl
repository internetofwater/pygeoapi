  owl:onProperty <http://qudt.org/schema/qudt/standardUncertainty> .

<http://qudt.org/schema/qudt/standardUncertainty> a owl:DatatypeProperty;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/schema/qudt>;
  rdfs:label "standard uncertainty";
  rdfs:range xsd:decimal;
  dct:description "The standard uncertainty of a quantity is the estimated standard deviation of the mean taken from a series of measurements."^^rdf:HTML .

_:6bb918f5130b4a77805c72ffff92bd8c632 a owl:Restriction;
  owl:allValuesFrom xsd:double;
  owl:onProperty <http://qudt.org/schema/qudt/relativeStandardUncertainty> .

<http://qudt.org/schema/qudt/relativeStandardUncertainty> a owl:DatatypeProperty;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/schema/qudt>;
  rdfs:label "relative standard uncertainty";
  rdfs:range xsd:double;
  dct:description "The relative standard uncertainty of a measurement is the (absolute) standard uncertainty divided by the magnitude of the exact value."^^rdf:HTML .

_:6bb918f5130b4a77805c72ffff92bd8c633 a owl:Restriction;
  owl:allValuesFrom xsd:double;
  owl:onProperty <http://qudt.org/schema/qudt/standardUncertaintySN> .

