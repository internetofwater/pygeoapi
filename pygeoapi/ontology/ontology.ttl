  <http://qudt.org/schema/qudt/informativeReference> "http://standards.buildingsmart.org/IFC/DEV/IFC4_2/FINAL/HTML/link/ifccompoundplaneanglemeasure.htm"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/plainTextDescription> "A \"Compound Plane Angle\" is a compound measure of plane angle in degrees, minutes, seconds, and optionally millionth-seconds of arc.";
