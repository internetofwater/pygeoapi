  <http://qudt.org/schema/qudt/symbol> "Gy/min";
  <http://qudt.org/schema/qudt/ucumCode> "Gy.min-1"^^<http://qudt.org/schema/qudt/UCUMcs>;
  <http://qudt.org/schema/qudt/uneceCommonCode> "P57" .

