  dct:description "A \"Compound Plane Angle\" is a compound measure of plane angle in degrees, minutes, seconds, and optionally millionth-seconds of arc."^^<http://qudt.org/schema/qudt/LatexString>;
  skos:broader <http://qudt.org/vocab/quantitykind/PlaneAngle>;
