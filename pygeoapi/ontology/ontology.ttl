quantitykind:MagneticVectorPotential a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:seeAlso quantitykind:MagneticFluxDensity, quantitykind:MagneticFluxDensity;
  rdfs:label "Keupayaan vektor magnetik"@ms, "Keupayaan vektor magnetik"@ms, "magnetic vector potential"@en,
    "magnetic vector potential"@en, "magnetický potenciál"@cs, "magnetický potenciál"@cs,
    "magnetisches Potenzial"@de, "magnetisches Potenzial"@de, "manyetik potansiyeli"@tr,
    "manyetik potansiyeli"@tr, "potencial magnético"@es, "potencial magnético"@es, "potencial magnético"@pt,
    "potencial magnético"@pt, "potencjał magnetyczny"@pl, "potencjał magnetyczny"@pl,
    "potentiel magnétique"@fr, "potentiel magnétique"@fr, "potenziale vettore magnetico"@it,
    "potenziale vettore magnetico"@it, "potențial magnetic"@ro, "potențial magnetic"@ro,
    "Магнитний потенциал"@ru, "Магнитний потенциал"@ru, "پتانسیل برداری مغناطیسی"@fa,
    "پتانسیل برداری مغناطیسی"@fa, "磁向量势"@zh, "磁向量势"@zh;
  rdfs:comment "Applicable units are those of quantitykind:MagneticVectorPotential",
    "Applicable units are those of quantitykind:MagneticVectorPotential";
  dct:description "\"Magnetic Vector Potential\" is the vector potential of the magnetic flux density. The magnetic vector potential is not unique since any irrotational vector field quantity can be added to a given magnetic vector potential without changing its rotation. Under static conditions the magnetic vector potential is often chosen so that its divergence is zero."^^qudt:LatexString,
    "\"Magnetic Vector Potential\" is the vector potential of the magnetic flux density. The magnetic vector potential is not unique since any irrotational vector field quantity can be added to a given magnetic vector potential without changing its rotation. Under static conditions the magnetic vector potential is often chosen so that its divergence is zero."^^qudt:LatexString;
  qudt:hasDimensionVector dimensionvector:A0E-1L1I0M1H0T-2D0, dimensionvector:A0E-1L1I0M1H0T-2D0;
  qudt:iec61360Code "0112/2///62720#UAD103", "0112/2///62720#UAD103";
  qudt:informativeReference "http://www.iso.org/iso/home/store/catalogue_tc/catalogue_detail.htm?csnumber=31891"^^xsd:anyURI,
    "http://www.iso.org/iso/home/store/catalogue_tc/catalogue_detail.htm?csnumber=31891"^^xsd:anyURI,
    "http://www.electropedia.org/iev/iev.nsf/display?openform&ievref=121-11-23"^^xsd:anyURI,
    "http://www.electropedia.org/iev/iev.nsf/display?openform&ievref=121-11-23"^^xsd:anyURI,
    "https://cdd.iec.ch/cdd/iec61987/iec61987.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD103"^^xsd:anyURI,
    "https://cdd.iec.ch/cdd/iec61987/iec61987.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD103"^^xsd:anyURI;
  qudt:symbol "A", "A";
  qudt:plainTextDescription "\"Magnetic Vector Potential\" is the vector potential of the magnetic flux density. The magnetic vector potential is not unique since any irrotational vector field quantity can be added to a given magnetic vector potential without changing its rotation. Under static conditions the magnetic vector potential is often chosen so that its divergence is zero.",
    "\"Magnetic Vector Potential\" is the vector potential of the magnetic flux density. The magnetic vector potential is not unique since any irrotational vector field quantity can be added to a given magnetic vector potential without changing its rotation. Under static conditions the magnetic vector potential is often chosen so that its divergence is zero.";
  qudt:latexDefinition "$B = \\text{rot} A$, where $B$ is magnetic flux density."^^qudt:LatexString,
    "$B = \\text{rot} A$, where $B$ is magnetic flux density."^^qudt:LatexString;
  qudt:applicableUnit unit:KiloWB-PER-M, unit:KiloWB-PER-M, unit:V-SEC-PER-M, unit:V-SEC-PER-M,
    unit:WB-PER-M, unit:WB-PER-M, unit:WB-PER-MilliM, unit:WB-PER-MilliM .

