  <http://qudt.org/schema/qudt/hasQuantityKind> <http://qudt.org/vocab/quantitykind/Unknown>;
  <http://qudt.org/schema/qudt/symbol> "kg/(m³·s)";
  <http://qudt.org/schema/qudt/ucumCode> "kg.m-3.s-1"^^<http://qudt.org/schema/qudt/UCUMcs> .

<http://qudt.org/vocab/dimensionvector/A0E0L-3I0M1H0T-1D0> a <http://qudt.org/schema/qudt/QuantityKindDimensionVector_SI>,
    <http://qudt.org/schema/qudt/QuantityKindDimensionVector_CGS>, <http://qudt.org/schema/qudt/QuantityKindDimensionVector_ISO>,
