quantitykind:KinematicViscosity a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:seeAlso quantitykind:DynamicViscosity, quantitykind:DynamicViscosity, quantitykind:MolecularViscosity,
    quantitykind:MolecularViscosity;
  rdfs:label "viskozita"@cs, "viskozita"@cs, "لزوجة"@ar, "لزوجة"@ar, "श्यानता"@hi, "श्यानता"@hi,
    "粘度"@ja, "粘度"@ja, "Kelikatan kinematik"@ms, "Kelikatan kinematik"@ms, "Kinematik akmazlık"@tr,
    "Kinematik akmazlık"@tr, "Viscozitate cinematică"@ro, "Viscozitate cinematică"@ro,
    "kinematic viscosity"@en, "kinematic viscosity"@en, "kinematische Viskosität"@de,
    "kinematische Viskosität"@de, "kinematična viskoznost"@sl, "kinematična viskoznost"@sl,
    "lepkość kinematyczna"@pl, "lepkość kinematyczna"@pl, "viscosidad cinemática"@es,
    "viscosidad cinemática"@es, "viscosidade cinemática"@pt, "viscosidade cinemática"@pt,
    "viscosità cinematica"@it, "viscosità cinematica"@it, "viscosité cinématique"@fr,
    "viscosité cinématique"@fr, "кинематическую вязкость"@ru, "кинематическую вязкость"@ru,
    "گرانروی جنبشی/ویسکوزیته جنبشی"@fa, "گرانروی جنبشی/ویسکوزیته جنبشی"@fa, "运动粘度"@zh,
    "运动粘度"@zh;
  rdfs:comment "Applicable units are those of quantitykind:KinematicViscosity", "Applicable units are those of quantitykind:KinematicViscosity";
  dct:description "The ratio of the viscosity of a liquid to its density. Viscosity is a measure of the resistance of a fluid which is being deformed by either shear stress or tensile stress. In many situations, we are concerned with the ratio of the inertial force to the viscous force (that is the Reynolds number), the former characterized by the fluid density $\\rho$. This ratio is characterized by the kinematic viscosity (Greek letter $\\nu$), defined as follows:  $\\nu = \\mu / \\rho$. The SI unit of $\\nu$ is $m^{2}/s$. The SI unit of $\\nu$ is $kg/m^{1}$."^^qudt:LatexString,
    "The ratio of the viscosity of a liquid to its density. Viscosity is a measure of the resistance of a fluid which is being deformed by either shear stress or tensile stress. In many situations, we are concerned with the ratio of the inertial force to the viscous force (that is the Reynolds number), the former characterized by the fluid density $\\rho$. This ratio is characterized by the kinematic viscosity (Greek letter $\\nu$), defined as follows:  $\\nu = \\mu / \\rho$. The SI unit of $\\nu$ is $m^{2}/s$. The SI unit of $\\nu$ is $kg/m^{1}$."^^qudt:LatexString;
  skos:broader quantitykind:AreaPerTime, quantitykind:AreaPerTime;
  qudt:dbpediaMatch "http://dbpedia.org/resource/Viscosity"^^xsd:anyURI, "http://dbpedia.org/resource/Viscosity"^^xsd:anyURI;
  qudt:hasDimensionVector dimensionvector:A0E0L2I0M0H0T-1D0, dimensionvector:A0E0L2I0M0H0T-1D0;
  qudt:iec61360Code "0112/2///62720#UAD070", "0112/2///62720#UAD070";
  qudt:informativeReference "http://en.wikipedia.org/wiki/Viscosity"^^xsd:anyURI, "http://en.wikipedia.org/wiki/Viscosity"^^xsd:anyURI,
    "https://cdd.iec.ch/cdd/iec61987/iec61987.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD070"^^xsd:anyURI,
    "https://cdd.iec.ch/cdd/iec61987/iec61987.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD070"^^xsd:anyURI;
  qudt:isoNormativeReference "http://www.iso.org/iso/catalogue_detail?csnumber=31889"^^xsd:anyURI,
    "http://www.iso.org/iso/catalogue_detail?csnumber=31889"^^xsd:anyURI;
  qudt:latexSymbol "$\\nu$"^^qudt:LatexString, "$\\nu$"^^qudt:LatexString;
  qudt:latexDefinition "$\\nu = \\frac{\\eta}{\\rho}$, where $\\eta$ is dynamic viscosity and $\\rho$ is mass density."^^qudt:LatexString,
    "$\\nu = \\frac{\\eta}{\\rho}$, where $\\eta$ is dynamic viscosity and $\\rho$ is mass density."^^qudt:LatexString;
  qudt:applicableUnit unit:CentiST, unit:CentiST, unit:ST, unit:ST .

unit:DARCY a qudt:Unit, qudt:Unit, qudt:DerivedUnit, qudt:DerivedUnit;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/unit>, <http://qudt.org/vocab/unit>;
  rdfs:label "Darcy"@en, "Darcy"@en;
  dct:description "<p>The $darcy$ (d) is a unit of permeability named after Henry Darcy. It is not an SI unit, but it is widely used in petroleum engineering and geology. The unit has also been used in biophysics and biomechanics, where the flow of fluids such as blood through capillary beds and cerebrospinal fluid through the brain interstitial space is being examined. A darcy has dimensional units of length<sup>2</sup>.</p>"^^rdf:HTML,
    "<p>The $darcy$ (d) is a unit of permeability named after Henry Darcy. It is not an SI unit, but it is widely used in petroleum engineering and geology. The unit has also been used in biophysics and biomechanics, where the flow of fluids such as blood through capillary beds and cerebrospinal fluid through the brain interstitial space is being examined. A darcy has dimensional units of length<sup>2</sup>.</p>"^^rdf:HTML;
  qudt:applicableSystem <http://qudt.org/vocab/sou/SI>, <http://qudt.org/vocab/sou/SI>,
    <http://qudt.org/vocab/sou/CGS>, <http://qudt.org/vocab/sou/CGS>;
  qudt:conversionMultiplier 0.0000000000009869233, 0.0000000000009869233;
  qudt:conversionMultiplierSN 9.869233E-13, 9.869233E-13;
  qudt:dbpediaMatch "http://dbpedia.org/resource/Darcy_(unit)"^^xsd:anyURI, "http://dbpedia.org/resource/Darcy_(unit)"^^xsd:anyURI;
  qudt:hasDimensionVector dimensionvector:A0E0L2I0M0H0T0D0, dimensionvector:A0E0L2I0M0H0T0D0;
  qudt:hasQuantityKind quantitykind:HydraulicPermeability, quantitykind:HydraulicPermeability;
  qudt:informativeReference "https://en.wikipedia.org/wiki/Darcy_(unit)"^^xsd:anyURI,
    "https://en.wikipedia.org/wiki/Darcy_(unit)"^^xsd:anyURI;
  qudt:symbol "d", "d";
  qudt:expression "$d$"^^qudt:LatexString, "$d$"^^qudt:LatexString;
  qudt:plainTextDescription "The darcy (d) is a unit of permeability named after Henry Darcy. It is not an SI unit, but it is widely used in petroleum engineering and geology. The unit has also been used in biophysics and biomechanics, where the flow of fluids such as blood through capillary beds and cerebrospinal fluid through the brain interstitial space is being examined. A darcy has dimensional units of length².",
    "The darcy (d) is a unit of permeability named after Henry Darcy. It is not an SI unit, but it is widely used in petroleum engineering and geology. The unit has also been used in biophysics and biomechanics, where the flow of fluids such as blood through capillary beds and cerebrospinal fluid through the brain interstitial space is being examined. A darcy has dimensional units of length².";
  qudt:scalingOf unit:M2 .

