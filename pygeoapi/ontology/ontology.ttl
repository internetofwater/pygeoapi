  skos:inScheme :conceptScheme_3e018a2a;
  skos:prefLabel "Alkalinity"@en;
  skos:editorialNote "RISE ParameterUnit is ug/L"@en, "Kyle's Match Status is Match"@en,
    "RISE ParameterTimestep is periodic"@en, "RISE ParameterTransformation is instant"@en,
