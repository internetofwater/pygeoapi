<http://qudt.org/vocab/quantitykind/VisibleRadiantEnergy> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Visible Radiant Energy"@en;
  rdfs:comment "Applicable units are those of quantitykind:Energy";
  dct:description "\"Visible Radiant Energy\", also known as luminous energy, is the energy of electromagnetic waves. It is energy of the particles that are emitted, transferred, or received as radiation."^^<http://qudt.org/schema/qudt/LatexString>;
  skos:broader <http://qudt.org/vocab/quantitykind/Energy>;
