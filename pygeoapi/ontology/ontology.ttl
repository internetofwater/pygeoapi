    qudt:latexDefinition "$\\delta = \\arctan d$, where $d$ is loss factor."^^qudt:LatexString ;
    qudt:latexSymbol "$\\delta$"^^qudt:LatexString ;
    rdfs:comment "Applicable units are those of quantitykind:Angle" ;
