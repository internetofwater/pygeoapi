quantitykind:Thrust a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "Thrust"@en, "Thrust"@en;
  rdfs:comment "Applicable units are those of quantitykind:Force", "Applicable units are those of quantitykind:Force";
  dct:description """Thrust is a reaction force described quantitatively by Newton's Second and Third Laws. When a system expels or accelerates mass in one direction the accelerated mass will cause a proportional but opposite force on that system.
The pushing or pulling force developed by an aircraft engine or a rocket engine.
The force exerted in any direction by a fluid jet or by a powered screw, as, the thrust of an antitorque rotor.
Specifically, in rocketry, $ F\\,= m\\cdot v$ where m is propellant mass flow and v is exhaust velocity relative to the vehicle. Also called momentum thrust."""^^qudt:LatexString,
    """Thrust is a reaction force described quantitatively by Newton's Second and Third Laws. When a system expels or accelerates mass in one direction the accelerated mass will cause a proportional but opposite force on that system.
The pushing or pulling force developed by an aircraft engine or a rocket engine.
The force exerted in any direction by a fluid jet or by a powered screw, as, the thrust of an antitorque rotor.
Specifically, in rocketry, $ F\\,= m\\cdot v$ where m is propellant mass flow and v is exhaust velocity relative to the vehicle. Also called momentum thrust."""^^qudt:LatexString;
  skos:broader quantitykind:Force, quantitykind:Force;
  qudt:dbpediaMatch "http://dbpedia.org/resource/Thrust"^^xsd:anyURI, "http://dbpedia.org/resource/Thrust"^^xsd:anyURI;
  qudt:hasDimensionVector dimensionvector:A0E0L1I0M1H0T-2D0, dimensionvector:A0E0L1I0M1H0T-2D0;
  qudt:plainTextDescription "Thrust is a reaction force described quantitatively by Newton's Second and Third Laws. When a system expels or accelerates mass in one direction the accelerated mass will cause a proportional but opposite force on that system.",
    "Thrust is a reaction force described quantitatively by Newton's Second and Third Laws. When a system expels or accelerates mass in one direction the accelerated mass will cause a proportional but opposite force on that system.";
  qudt:applicableUnit unit:CentiN, unit:CentiN, unit:DYN, unit:DYN, unit:DeciN, unit:DeciN,
    unit:GM_F, unit:GM_F, unit:KIP_F, unit:KIP_F, unit:KiloGM-M-PER-SEC2, unit:KiloGM-M-PER-SEC2,
    unit:N, unit:N, unit:KiloGM_F, unit:KiloGM_F, unit:KiloPOND, unit:KiloPOND, unit:KiloLB_F,
    unit:KiloLB_F, unit:KiloN, unit:KiloN, unit:LB_F, unit:LB_F, unit:MegaLB_F, unit:MegaLB_F,
    unit:MegaN, unit:MegaN, unit:MicroN, unit:MicroN, unit:MilliN, unit:MilliN, unit:OZ_F,
    unit:OZ_F, unit:PDL, unit:PDL, unit:POND, unit:POND, unit:PlanckForce, unit:PlanckForce,
