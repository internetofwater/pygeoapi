quantitykind:DebyeAngularWavenumber a qudt:QuantityKind ;
    rdfs:label "Debye Angular Wavenumber"@en ;
    dct:description "\"Debye Angular Wavenumber\" is the cut-off angular wavenumber in the Debye model of the vibrational spectrum of a solid."^^qudt:LatexString ;
    qudt:applicableUnit unit:DEG-PER-M,
        unit:RAD-PER-M ;
    qudt:hasDimensionVector dimensionvector:A0E0L-1I0M0H0T0D0 ;
