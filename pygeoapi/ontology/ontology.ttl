unit:RAD-PER-MIN a qudt:Unit, qudt:Unit;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/unit>, <http://qudt.org/vocab/unit>;
  rdfs:label "Radian per Minute"@en, "Radian per Minute"@en;
  dct:description "Radian Per Minute (rad/min) is a unit in the category of Angular velocity. It is also known as radians per minute, radian/minute. Radian Per Minute (rad/min) has a dimension of aT-1 where $T$ is time. It can be converted to the corresponding standard SI unit rad/s by multiplying its value by a factor of 0.0166666666667. "^^rdf:HTML,
    "Radian Per Minute (rad/min) is a unit in the category of Angular velocity. It is also known as radians per minute, radian/minute. Radian Per Minute (rad/min) has a dimension of aT-1 where $T$ is time. It can be converted to the corresponding standard SI unit rad/s by multiplying its value by a factor of 0.0166666666667. "^^rdf:HTML;
  qudt:applicableSystem <http://qudt.org/vocab/sou/CGS-EMU>, <http://qudt.org/vocab/sou/CGS-EMU>,
    <http://qudt.org/vocab/sou/CGS-GAUSS>, <http://qudt.org/vocab/sou/CGS-GAUSS>, <http://qudt.org/vocab/sou/SI>,
    <http://qudt.org/vocab/sou/SI>, <http://qudt.org/vocab/sou/CGS>, <http://qudt.org/vocab/sou/CGS>;
  qudt:conversionMultiplier 0.01666666666666666666666666666666667, 0.016666666666666666666667;
  qudt:conversionMultiplierSN 1.666666666666666666666666666666667E-2, 1.6666666666666666666667E-2;
  qudt:hasDimensionVector dimensionvector:A0E0L0I0M0H0T-1D0, dimensionvector:A0E0L0I0M0H0T-1D0;
  qudt:hasQuantityKind quantitykind:AngularFrequency, quantitykind:AngularFrequency,
    quantitykind:AngularVelocity, quantitykind:AngularVelocity;
  qudt:symbol "rad/min", "rad/min";
  qudt:ucumCode "rad.min-1"^^qudt:UCUMcs, "rad.min-1"^^qudt:UCUMcs, "rad/min"^^qudt:UCUMcs,
    "rad/min"^^qudt:UCUMcs;
  qudt:expression "$rad/m$"^^qudt:LatexString, "$rad/m$"^^qudt:LatexString;
  qudt:hasFactorUnit _:b1cb43fcbd504833bf8a964862c3127018845, _:b1cb43fcbd504833bf8a964862c3127018846 .

