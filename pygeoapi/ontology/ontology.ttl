            qudt:hasUnit unit:J ],
        [ qudt:exponent -4 ;
            qudt:hasUnit unit:M ],
        [ qudt:exponent 1 ;
            qudt:hasUnit unit:J ],
        [ qudt:exponent -4 ;
            qudt:hasUnit unit:M ],
        [ qudt:exponent 1 ;
            qudt:hasUnit unit:J ] ;
    qudt:hasQuantityKind quantitykind:SpectralRadiantEnergyDensity ;
    qudt:iec61360Code "0112/2///62720#UAA177" ;
    qudt:informativeReference "https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAA177"^^xsd:anyURI ;
    qudt:symbol "J/m⁴" ;
