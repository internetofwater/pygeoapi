quantitykind:QuantumNumber a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "Quantum Number"@en, "Quantum Number"@en;
  rdfs:comment "Applicable units are those of quantitykind:QuantumNumber", "Applicable units are those of quantitykind:QuantumNumber";
  dct:description "The \"Quantum Number\" describes values of conserved quantities in the dynamics of the quantum system. Perhaps the most peculiar aspect of quantum mechanics is the quantization of observable quantities, since quantum numbers are discrete sets of integers or half-integers."^^qudt:LatexString,
    "The \"Quantum Number\" describes values of conserved quantities in the dynamics of the quantum system. Perhaps the most peculiar aspect of quantum mechanics is the quantization of observable quantities, since quantum numbers are discrete sets of integers or half-integers."^^qudt:LatexString;
  skos:broader quantitykind:Dimensionless, quantitykind:Dimensionless;
  qudt:hasDimensionVector dimensionvector:A0E0L0I0M0H0T0D1, dimensionvector:A0E0L0I0M0H0T0D1;
  qudt:informativeReference "http://en.wikipedia.org/wiki/Quantum_number"^^xsd:anyURI,
    "http://en.wikipedia.org/wiki/Quantum_number"^^xsd:anyURI;
  qudt:symbol "n", "n";
  qudt:isoNormativeReference "http://www.iso.org/iso/catalogue_detail?csnumber=31894"^^xsd:anyURI,
    "http://www.iso.org/iso/catalogue_detail?csnumber=31894"^^xsd:anyURI;
  qudt:plainTextDescription "The \"Quantum Number\" describes values of conserved quantities in the dynamics of the quantum system. Perhaps the most peculiar aspect of quantum mechanics is the quantization of observable quantities, since quantum numbers are discrete sets of integers or half-integers.",
    "The \"Quantum Number\" describes values of conserved quantities in the dynamics of the quantum system. Perhaps the most peculiar aspect of quantum mechanics is the quantization of observable quantities, since quantum numbers are discrete sets of integers or half-integers.";
  qudt:applicableUnit unit:NUM, unit:NUM .

quantitykind:ReynoldsNumber a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "Reynolds Number"@en, "Reynolds Number"@en;
  rdfs:comment "Applicable units are those of quantitykind:ReynoldsNumber", "Applicable units are those of quantitykind:ReynoldsNumber";
  dct:description "The \"Reynolds Number\" (Re) is a dimensionless number that gives a measure of the ratio of inertial forces to viscous forces and consequently quantifies the relative importance of these two types of forces for given flow conditions."^^qudt:LatexString,
    "The \"Reynolds Number\" (Re) is a dimensionless number that gives a measure of the ratio of inertial forces to viscous forces and consequently quantifies the relative importance of these two types of forces for given flow conditions."^^qudt:LatexString;
  skos:broader quantitykind:DimensionlessRatio, quantitykind:DimensionlessRatio;
  skos:closeMatch <http://dbpedia.org/resource/Reynolds_number>, <http://dbpedia.org/resource/Reynolds_number>;
  qudt:dbpediaMatch "http://dbpedia.org/resource/Reynolds_number"^^xsd:anyURI, "http://dbpedia.org/resource/Reynolds_number"^^xsd:anyURI;
  qudt:hasDimensionVector dimensionvector:A0E0L0I0M0H0T0D1, dimensionvector:A0E0L0I0M0H0T0D1;
  qudt:informativeReference "http://en.wikipedia.org/wiki/Reynolds_number"^^xsd:anyURI,
    "http://en.wikipedia.org/wiki/Reynolds_number"^^xsd:anyURI;
  qudt:symbol "Re", "Re";
  qudt:plainTextDescription "The \"Reynolds Number\" (Re) is a dimensionless number that gives a measure of the ratio of inertial forces to viscous forces and consequently quantifies the relative importance of these two types of forces for given flow conditions.",
    "The \"Reynolds Number\" (Re) is a dimensionless number that gives a measure of the ratio of inertial forces to viscous forces and consequently quantifies the relative importance of these two types of forces for given flow conditions.";
  qudt:latexDefinition "$Re = \\frac{\\rho uL}{\\mu} = \\frac{uL}{\\nu}$, where $\\rho$ is mass density, $u$ is speed, $L$ is length,  $\\mu$ is dynamic viscosity, and $\\nu$ is kinematic viscosity."^^qudt:LatexString,
    "$Re = \\frac{\\rho uL}{\\mu} = \\frac{uL}{\\nu}$, where $\\rho$ is mass density, $u$ is speed, $L$ is length,  $\\mu$ is dynamic viscosity, and $\\nu$ is kinematic viscosity."^^qudt:LatexString;
  qudt:applicableUnit unit:NUM, unit:NUM;
  qudt:normativeReference "http://www.iso.org/iso/catalogue_detail?csnumber=31896"^^xsd:anyURI,
    "http://www.iso.org/iso/catalogue_detail?csnumber=31896"^^xsd:anyURI .

quantitykind:SpinQuantumNumber a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "Spin Quantum Number"@en, "Spin Quantum Number"@en;
  rdfs:comment "Applicable units are those of quantitykind:SpinQuantumNumber", "Applicable units are those of quantitykind:SpinQuantumNumber";
  dct:description "The \"Spin Quantum Number\"  describes the spin (intrinsic angular momentum) of the electron within that orbital, and gives the projection of the spin angular momentum S along the specified axis"^^qudt:LatexString,
    "The \"Spin Quantum Number\"  describes the spin (intrinsic angular momentum) of the electron within that orbital, and gives the projection of the spin angular momentum S along the specified axis"^^qudt:LatexString;
  skos:broader quantitykind:QuantumNumber, quantitykind:QuantumNumber;
  skos:closeMatch quantitykind:MagneticQuantumNumber, quantitykind:MagneticQuantumNumber,
    quantitykind:OrbitalAngularMomentumQuantumNumber, quantitykind:OrbitalAngularMomentumQuantumNumber,
    quantitykind:PrincipalQuantumNumber, quantitykind:PrincipalQuantumNumber;
  qudt:hasDimensionVector dimensionvector:A0E0L0I0M0H0T0D1, dimensionvector:A0E0L0I0M0H0T0D1;
  qudt:iec61360Code "0112/2///62720#UAD371", "0112/2///62720#UAD371";
  qudt:informativeReference "http://en.wikipedia.org/wiki/Quantum_number"^^xsd:anyURI,
    "http://en.wikipedia.org/wiki/Quantum_number"^^xsd:anyURI, "https://cdd.iec.ch/cdd/iec61987/iec61987.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD371"^^xsd:anyURI,
    "https://cdd.iec.ch/cdd/iec61987/iec61987.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD371"^^xsd:anyURI;
  qudt:symbol "s", "s";
  qudt:isoNormativeReference "http://www.iso.org/iso/catalogue_detail?csnumber=31894"^^xsd:anyURI,
    "http://www.iso.org/iso/catalogue_detail?csnumber=31894"^^xsd:anyURI;
  qudt:plainTextDescription "The \"Spin Quantum Number\"  describes the spin (intrinsic angular momentum) of the electron within that orbital, and gives the projection of the spin angular momentum S along the specified axis",
    "The \"Spin Quantum Number\"  describes the spin (intrinsic angular momentum) of the electron within that orbital, and gives the projection of the spin angular momentum S along the specified axis";
  qudt:latexDefinition "$s^2 = \\hbar^2 s(s + 1)$, where $s$ is the spin quantum number and $\\hbar$ is the Planck constant."^^qudt:LatexString,
    "$s^2 = \\hbar^2 s(s + 1)$, where $s$ is the spin quantum number and $\\hbar$ is the Planck constant."^^qudt:LatexString;
  qudt:applicableUnit unit:NUM, unit:NUM .

quantitykind:StoichiometricNumber a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "Stoichiometric Number"@en, "Stoichiometric Number"@en;
  rdfs:comment "Applicable units are those of quantitykind:StoichiometricNumber", "Applicable units are those of quantitykind:StoichiometricNumber";
  dct:description "Chemical reactions, as macroscopic unit operations, consist of simply a very large number of elementary reactions, where a single molecule reacts with another molecule. As the reacting molecules (or moieties) consist of a definite set of atoms in an integer ratio, the ratio between reactants in a complete reaction is also in integer ratio. A reaction may consume more than one molecule, and the \"Stoichiometric Number\" counts this number, defined as positive for products (added) and negative for reactants (removed)."^^qudt:LatexString,
    "Chemical reactions, as macroscopic unit operations, consist of simply a very large number of elementary reactions, where a single molecule reacts with another molecule. As the reacting molecules (or moieties) consist of a definite set of atoms in an integer ratio, the ratio between reactants in a complete reaction is also in integer ratio. A reaction may consume more than one molecule, and the \"Stoichiometric Number\" counts this number, defined as positive for products (added) and negative for reactants (removed)."^^qudt:LatexString;
  skos:broader quantitykind:Dimensionless, quantitykind:Dimensionless;
  qudt:hasDimensionVector dimensionvector:A0E0L0I0M0H0T0D1, dimensionvector:A0E0L0I0M0H0T0D1;
  qudt:informativeReference "http://en.wikipedia.org/wiki/Stoichiometry"^^xsd:anyURI,
    "http://en.wikipedia.org/wiki/Stoichiometry"^^xsd:anyURI;
  qudt:isoNormativeReference "http://www.iso.org/iso/catalogue_detail?csnumber=31894"^^xsd:anyURI,
    "http://www.iso.org/iso/catalogue_detail?csnumber=31894"^^xsd:anyURI;
  qudt:plainTextDescription "Chemical reactions, as macroscopic unit operations, consist of simply a very large number of elementary reactions, where a single molecule reacts with another molecule. As the reacting molecules (or moieties) consist of a definite set of atoms in an integer ratio, the ratio between reactants in a complete reaction is also in integer ratio. A reaction may consume more than one molecule, and the \"Stoichiometric Number\" counts this number, defined as positive for products (added) and negative for reactants (removed).",
    "Chemical reactions, as macroscopic unit operations, consist of simply a very large number of elementary reactions, where a single molecule reacts with another molecule. As the reacting molecules (or moieties) consist of a definite set of atoms in an integer ratio, the ratio between reactants in a complete reaction is also in integer ratio. A reaction may consume more than one molecule, and the \"Stoichiometric Number\" counts this number, defined as positive for products (added) and negative for reactants (removed).";
  qudt:latexSymbol "$\\nu_B$"^^qudt:LatexString, "$\\nu_B$"^^qudt:LatexString;
  qudt:applicableUnit unit:NUM, unit:NUM .

