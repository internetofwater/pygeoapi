  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/unit>;
  rdfs:label "Cubic Yard per Day"@en;
  dct:description "power of the unit yard according to the Anglo-American and the Imperial system of units with the exponent 3 divided by the unit for time day"^^rdf:HTML;
