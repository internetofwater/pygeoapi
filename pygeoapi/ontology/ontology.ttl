unit:W a qudt:Unit, qudt:Unit, qudt:DerivedUnit, qudt:DerivedUnit;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/unit>, <http://qudt.org/vocab/unit>;
  rdfs:label "Watt"@de, "Watt"@de, "vatio"@es, "vatio"@es, "wat"@pl, "wat"@pl, "watt"@cs,
    "watt"@cs, "watt"@en, "watt"@en, "watt"@fr, "watt"@fr, "watt"@hu, "watt"@hu, "watt"@it,
    "watt"@it, "watt"@ms, "watt"@ms, "watt"@pt, "watt"@pt, "watt"@ro, "watt"@ro, "watt"@sl,
    "watt"@sl, "watt"@tr, "watt"@tr, "wattium"@la, "wattium"@la, "βατ"@el, "βατ"@el, "ват"@bg,
    "ват"@bg, "ватт"@ru, "ватт"@ru, "ואט"@he, "ואט"@he, "وات"@fa, "وات"@fa, "واط"@ar,
    "واط"@ar, "वाट"@hi, "वाट"@hi, "ワット"@ja, "ワット"@ja, "瓦特"@zh, "瓦特"@zh;
  dct:description "The SI unit of power. Power is the rate at which work is done, or (equivalently) the rate at which energy is expended. One watt is equal to a power rate of one joule of work per second of time. This unit is used both in mechanics and in electricity, so it links the mechanical and electrical units to one another. In mechanical terms, one watt equals about 0.001 341 02 horsepower (hp) or 0.737 562 foot-pound per second (lbf/s). In electrical terms, one watt is the power produced by a current of one ampere flowing through an electric potential of one volt. The name of the unit honors James Watt (1736-1819), the British engineer whose improvements to the steam engine are often credited with igniting the Industrial Revolution."^^rdf:HTML,
    "The SI unit of power. Power is the rate at which work is done, or (equivalently) the rate at which energy is expended. One watt is equal to a power rate of one joule of work per second of time. This unit is used both in mechanics and in electricity, so it links the mechanical and electrical units to one another. In mechanical terms, one watt equals about 0.001 341 02 horsepower (hp) or 0.737 562 foot-pound per second (lbf/s). In electrical terms, one watt is the power produced by a current of one ampere flowing through an electric potential of one volt. The name of the unit honors James Watt (1736-1819), the British engineer whose improvements to the steam engine are often credited with igniting the Industrial Revolution."^^rdf:HTML;
  qudt:applicableSystem <http://qudt.org/vocab/sou/CGS-EMU>, <http://qudt.org/vocab/sou/CGS-EMU>,
    <http://qudt.org/vocab/sou/CGS-GAUSS>, <http://qudt.org/vocab/sou/CGS-GAUSS>, <http://qudt.org/vocab/sou/PLANCK>,
    <http://qudt.org/vocab/sou/PLANCK>, <http://qudt.org/vocab/sou/SI>, <http://qudt.org/vocab/sou/SI>,
    <http://qudt.org/vocab/sou/CGS>, <http://qudt.org/vocab/sou/CGS>;
  qudt:conversionMultiplier 1.0, 1.0;
  qudt:conversionMultiplierSN 1.0E0, 1.0E0;
  qudt:dbpediaMatch "http://dbpedia.org/resource/Watt"^^xsd:anyURI, "http://dbpedia.org/resource/Watt"^^xsd:anyURI;
  qudt:hasDimensionVector dimensionvector:A0E0L2I0M1H0T-3D0, dimensionvector:A0E0L2I0M1H0T-3D0;
  qudt:hasQuantityKind quantitykind:Power, quantitykind:Power, quantitykind:ActivePower,
    quantitykind:ElectricPower;
  qudt:iec61360Code "0112/2///62720#UAA306", "0112/2///62720#UAA306";
  qudt:informativeReference "http://en.wikipedia.org/wiki/Watt?oldid=494906356"^^xsd:anyURI,
