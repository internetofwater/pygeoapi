quantitykind:OsmoticConcentration a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "Osmotic Concentration"@en, "Osmotic Concentration"@en;
  dct:description "The \"Osmotic Concentration\" is the moles of an osmotically active entity (solute) in the volume of a solution."^^qudt:LatexString,
    "The \"Osmotic Concentration\" is the moles of an osmotically active entity (solute) in the volume of a solution."^^qudt:LatexString;
  qudt:hasDimensionVector dimensionvector:A1E0L-3I0M0H0T0D0, dimensionvector:A1E0L-3I0M0H0T0D0;
  qudt:informativeReference "https://doi.org/10.1351/goldbook.O04343"^^xsd:anyURI, "https://doi.org/10.1351/goldbook.O04343"^^xsd:anyURI,
    "https://en.wikipedia.org/wiki/Osmotic_concentration"^^xsd:anyURI, "https://en.wikipedia.org/wiki/Osmotic_concentration"^^xsd:anyURI;
  qudt:plainTextDescription "The \"Osmotic Concentration\" is the moles of an osmotically active entity (solute) in the volume of a solution.",
    "The \"Osmotic Concentration\" is the moles of an osmotically active entity (solute) in the volume of a solution.";
  qudt:latexSymbol "$\\c$"^^qudt:LatexString, "$\\c$"^^qudt:LatexString;
  qudt:latexDefinition "$osmolarity = \\sum_{i} \\varphi_i n_i C_i, where \\varphi is the osmotic coefficient of the solution n, is the number of particles (e.g. ions), C is the molar concentration of the solute, and i is the index of solute$"^^qudt:LatexString,
    "$osmolarity = \\sum_{i} \\varphi_i n_i C_i, where \\varphi is the osmotic coefficient of the solution n, is the number of particles (e.g. ions), C is the molar concentration of the solute, and i is the index of solute$"^^qudt:LatexString .

quantitykind:OsmoticPressure a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "Osmotický tlak"@cs, "Osmotický tlak"@cs, "Tekanan osmotik"@ms, "Tekanan osmotik"@ms,
    "osmotic pressure"@en, "osmotic pressure"@en, "osmotischer Druck"@de, "osmotischer Druck"@de,
    "ozmotik basıç"@tr, "ozmotik basıç"@tr, "presión osmótica"@es, "presión osmótica"@es,
    "pression osmotique"@fr, "pression osmotique"@fr, "pressione osmotica"@it, "pressione osmotica"@it,
    "pressão osmótica"@pt, "pressão osmótica"@pt, "فشار اسمزی"@fa, "فشار اسمزی"@fa, "渗透压"@zh,
    "渗透压"@zh;
  rdfs:comment "Applicable units are those of quantitykind:ForcePerArea", "Applicable units are those of quantitykind:ForcePerArea";
  dct:description "The \"Osmotic Pressure\" is the pressure which needs to be applied to a solution to prevent the inward flow of water across a semipermeable membrane."^^qudt:LatexString,
    "The \"Osmotic Pressure\" is the pressure which needs to be applied to a solution to prevent the inward flow of water across a semipermeable membrane."^^qudt:LatexString;
  skos:broader quantitykind:Pressure, quantitykind:Pressure;
  qudt:hasDimensionVector dimensionvector:A0E0L-1I0M1H0T-2D0, dimensionvector:A0E0L-1I0M1H0T-2D0;
  qudt:informativeReference "http://en.wikipedia.org/wiki/Osmotic_pressure"^^xsd:anyURI,
    "http://en.wikipedia.org/wiki/Osmotic_pressure"^^xsd:anyURI;
  qudt:symbol "Π", "Π";
  qudt:plainTextDescription "The \"Osmotic Pressure\" is the pressure which needs to be applied to a solution to prevent the inward flow of water across a semipermeable membrane.",
    "The \"Osmotic Pressure\" is the pressure which needs to be applied to a solution to prevent the inward flow of water across a semipermeable membrane.";
  qudt:latexDefinition "$\\varphi = -(M_A\\sum b_B)^{-1} \\ln a_A$, where $M_A$ is the molar mass of the solvent $A$, $\\sum$ denotes summation over all the solutes, $b_B$ is the molality of solute $B$, and $a_A$ is the activity of solvent $A$."^^qudt:LatexString,
    "$\\varphi = -(M_A\\sum b_B)^{-1} \\ln a_A$, where $M_A$ is the molar mass of the solvent $A$, $\\sum$ denotes summation over all the solutes, $b_B$ is the molality of solute $B$, and $a_A$ is the activity of solvent $A$."^^qudt:LatexString;
