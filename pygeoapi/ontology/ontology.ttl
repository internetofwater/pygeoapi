quantitykind:LogarithmicFrequencyInterval a qudt:QuantityKind ;
    rdfs:label "Interval měření frekvence ?"@cs,
        "Frequenzmaßintervall"@de,
        "logarithmic frequency interval"@en,
        "فاصله فرکانس لگاریتمی"@fa,
