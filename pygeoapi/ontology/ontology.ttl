quantitykind:MacroscopicCrossSection a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "Macroscopic Cross-section"@en, "Macroscopic Cross-section"@en;
  rdfs:comment "Applicable units are those of quantitykind:Area", "Applicable units are those of quantitykind:Area";
  dct:description "\"Macroscopic Cross-section\" is the sum of the cross-sections for a reaction or process of a specified type over all atoms or other entities in a given 3D domain, divided by the volume of that domain."^^qudt:LatexString,
    "\"Macroscopic Cross-section\" is the sum of the cross-sections for a reaction or process of a specified type over all atoms or other entities in a given 3D domain, divided by the volume of that domain."^^qudt:LatexString;
  skos:broader quantitykind:CrossSection, quantitykind:CrossSection;
  qudt:hasDimensionVector dimensionvector:A0E0L2I0M0H0T0D0, dimensionvector:A0E0L2I0M0H0T0D0;
  qudt:informativeReference "http://en.wikipedia.org/wiki/Cross_section_(physics)"^^xsd:anyURI,
    "http://en.wikipedia.org/wiki/Cross_section_(physics)"^^xsd:anyURI;
  qudt:isoNormativeReference "http://www.iso.org/iso/catalogue_detail?csnumber=31895"^^xsd:anyURI,
    "http://www.iso.org/iso/catalogue_detail?csnumber=31895"^^xsd:anyURI;
  qudt:plainTextDescription "\"Macroscopic Cross-section\" is the sum of the cross-sections for a reaction or process of a specified type over all atoms or other entities in a given 3D domain, divided by the volume of that domain.",
    "\"Macroscopic Cross-section\" is the sum of the cross-sections for a reaction or process of a specified type over all atoms or other entities in a given 3D domain, divided by the volume of that domain.";
  qudt:latexSymbol "$\\sum$"^^qudt:LatexString, "$\\sum$"^^qudt:LatexString;
  qudt:latexDefinition "$\\sum = n_1\\sigma_1 + \\cdots + n_j\\sigma_j +$, where $n_j$ is the number density and $\\sigma_j$ the cross-section for entities of type $j$."^^qudt:LatexString,
    "$\\sum = n_1\\sigma_1 + \\cdots + n_j\\sigma_j +$, where $n_j$ is the number density and $\\sigma_j$ the cross-section for entities of type $j$."^^qudt:LatexString;
  qudt:applicableUnit unit:AC, unit:AC, unit:ARE, unit:ARE, unit:BARN, unit:BARN, unit:CentiM2,
    unit:CentiM2, unit:DecaARE, unit:DecaARE, unit:DeciM2, unit:DeciM2, unit:FT2, unit:FT2,
    unit:HA, unit:HA, unit:IN2, unit:IN2, unit:KiloM2, unit:KiloM2, unit:KiloMIL_Circ,
    unit:KiloMIL_Circ, unit:M2, unit:M2, unit:MI2, unit:MI2, unit:MI_US2, unit:MI_US2,
    unit:MIL_Circ, unit:MIL_Circ, unit:MicroM2, unit:MicroM2, unit:MilliM2, unit:MilliM2,
    unit:NanoM2, unit:NanoM2, unit:PlanckArea, unit:PlanckArea, unit:YD2, unit:YD2, unit:PIXEL_AREA .

