        [ qudt:exponent -1 ;
            qudt:hasUnit unit:KiloGM ],
        [ qudt:exponent 1 ;
            qudt:hasUnit unit:J ],
        [ qudt:exponent -1 ;
            qudt:hasUnit unit:KiloGM ],
        [ qudt:exponent 1 ;
            qudt:hasUnit unit:J ] ;
