<http://qudt.org/vocab/quantitykind/RadiativeHeatTransfer> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Radiative Heat Transfer"@en;
  rdfs:comment "Applicable units are those of quantitykind:HeatFlowRate";
