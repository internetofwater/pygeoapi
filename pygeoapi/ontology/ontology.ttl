  <http://qudt.org/schema/qudt/symbol> "in/revolution";
  <http://qudt.org/schema/qudt/uneceCommonCode> "H57" .

<http://qudt.org/vocab/quantitykind/Rotary-TranslatoryMotionConversion> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
