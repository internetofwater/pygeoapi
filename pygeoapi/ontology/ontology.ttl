    "belio"@es, "μπέλ"@el, "μπέλ"@el, "бел"@bg, "бел"@bg, "бел"@ru, "бел"@ru, "בל"@he,
    "בל"@he, "بل"@ar, "بل"@ar, "بل"@fa, "بل"@fa, "बेल"@hi, "बेल"@hi, "ベル"@ja, "ベル"@ja,
    "贝"@zh, "贝"@zh;
  dct:description """
  The $\\textit{Bel}$ is a logarithmic unit of sound pressure equal to 10 decibels (dB). 
  It is defined as: $1 B = (1/2) \\log_{10}(Np)$
  """^^qudt:LatexString,
    """
  The $\\textit{Bel}$ is a logarithmic unit of sound pressure equal to 10 decibels (dB). 
  It is defined as: $1 B = (1/2) \\log_{10}(Np)$
  """^^qudt:LatexString;
