quantitykind:Radiance a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "Radiance"@en, "Radiance"@en;
  rdfs:comment "Applicable units are those of quantitykind:Radiance", "Applicable units are those of quantitykind:Radiance";
  dct:description "\"Radiance\" is a radiometric measure that describes the amount of light that passes through or is emitted from a particular area, and falls within a given solid angle in a specified direction."^^qudt:LatexString,
    "\"Radiance\" is a radiometric measure that describes the amount of light that passes through or is emitted from a particular area, and falls within a given solid angle in a specified direction."^^qudt:LatexString;
  skos:broader quantitykind:PowerPerAreaAngle, quantitykind:PowerPerAreaAngle;
  qudt:hasDimensionVector dimensionvector:A0E0L0I0M1H0T-3D0, dimensionvector:A0E0L0I0M1H0T-3D0;
  qudt:iec61360Code "0112/2///62720#UAD148", "0112/2///62720#UAD148";
  qudt:informativeReference "http://en.wikipedia.org/wiki/Radiance"^^xsd:anyURI, "http://en.wikipedia.org/wiki/Radiance"^^xsd:anyURI,
    "https://cdd.iec.ch/cdd/iec61987/iec61987.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD148"^^xsd:anyURI,
    "https://cdd.iec.ch/cdd/iec61987/iec61987.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD148"^^xsd:anyURI;
  qudt:siExactMatch <https://si-digital-framework.org/SI/quantities/RADI>, <https://si-digital-framework.org/quantities/RADI>;
  qudt:symbol "L", "L";
  qudt:plainTextDescription "\"Radiance\" is a radiometric measure that describes the amount of light that passes through or is emitted from a particular area, and falls within a given solid angle in a specified direction.",
    "\"Radiance\" is a radiometric measure that describes the amount of light that passes through or is emitted from a particular area, and falls within a given solid angle in a specified direction.";
  qudt:latexDefinition "$L = \\frac{dI}{dA}\\frac{1}{cos\\alpha}$, where $dI$ is the radiant intensity emitted from an element of the surface area $dA$, and angle $\\alpha$ is the angle between the normal to the surface and the given direction."^^qudt:LatexString,
    "$L = \\frac{dI}{dA}\\frac{1}{cos\\alpha}$, where $dI$ is the radiant intensity emitted from an element of the surface area $dA$, and angle $\\alpha$ is the angle between the normal to the surface and the given direction."^^qudt:LatexString;
  qudt:applicableUnit unit:W-PER-M2-SR, unit:W-PER-M2-SR .

