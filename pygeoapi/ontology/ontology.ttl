    skos:prefLabel "Europium, dissolved" ;
    skos:topConceptOf <http://vocabulary.odm2.org/variablename> .

variablename:evapotranspiration a skos:Concept ;
    skos:definition "Evapotranspiration",
        "Evapotranspiration (ET) is the sum of evaporation and plant transpiration from the Earth's land and ocean surface to the atmosphere." ;
    skos:exactMatch "https://en.wikipedia.org/wiki/Evapotranspiration" ;
    skos:historyNote "Originally from the CUAHSI HIS VariableNameCV.  See: http://his.cuahsi.org/mastercvreg/edit_cv11.aspx?tbl=VariableNameCV.",
        "Wikipedia" ;
    skos:inScheme <http://vocabulary.odm2.org/variablename> ;
    skos:note "Added to support Critical Zone Observatory (CZO) data use cases. " ;
    skos:prefLabel "Evapotranspiration",
        "Evapotranspiration (ET)" ;
    skos:topConceptOf <http://vocabulary.odm2.org/variablename> .

variablename:evapotranspirationPotential a skos:Concept ;
    skos:definition "The amount of water that could be evaporated and transpired if there was sufficient water available." ;
    skos:historyNote "Originally from the CUAHSI HIS VariableNameCV.  See: http://his.cuahsi.org/mastercvreg/edit_cv11.aspx?tbl=VariableNameCV." ;
    skos:inScheme <http://vocabulary.odm2.org/variablename> ;
    skos:prefLabel "Evapotranspiration, potential" ;
    skos:topConceptOf <http://vocabulary.odm2.org/variablename> .

variablename:extracellularEnzymeActivity a skos:Concept ;
    skos:definition "Extracellular enzymes or exoenzymes are synthesized inside the cell and then secreted outside the cell, where their function is to break down complex macromolecules into smaller units to be taken up by the cell for growth and assimilation." ;
    skos:exactMatch "https://en.wikipedia.org/wiki/Fungal_extracellular_enzyme_activity" ;
    skos:historyNote "Wikipedia" ;
    skos:inScheme <http://vocabulary.odm2.org/variablename> ;
    skos:note "Added to support Critical Zone Observatory (CZO) data use cases. " ;
    skos:prefLabel "Extracellular enzyme activity" ;
    skos:topConceptOf <http://vocabulary.odm2.org/variablename> .

