quantitykind:HeatCapacityRatio a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "Heat Capacity Ratio"@en, "Heat Capacity Ratio"@en;
  rdfs:comment "Applicable units are those of quantitykind:DimensionlessRatio", "Applicable units are those of quantitykind:DimensionlessRatio";
  dct:description "The heat capacity ratio, or ratio of specific heats, is the ratio of the heat capacity at constant pressure ($C_P$) to heat capacity at constant volume ($C_V$). For an ideal gas, the heat capacity is constant with temperature ($\\theta$). Accordingly we can express the enthalpy as $H = C_P*\\theta$ and the internal energy as $U = C_V \\cdot \\theta$. Thus, it can also be said that the heat capacity ratio is the ratio between enthalpy and internal energy."^^qudt:LatexString,
    "The heat capacity ratio, or ratio of specific heats, is the ratio of the heat capacity at constant pressure ($C_P$) to heat capacity at constant volume ($C_V$). For an ideal gas, the heat capacity is constant with temperature ($\\theta$). Accordingly we can express the enthalpy as $H = C_P*\\theta$ and the internal energy as $U = C_V \\cdot \\theta$. Thus, it can also be said that the heat capacity ratio is the ratio between enthalpy and internal energy."^^qudt:LatexString;
  skos:broader quantitykind:DimensionlessRatio, quantitykind:DimensionlessRatio;
  qudt:dbpediaMatch "http://dbpedia.org/resource/Heat_capacity_ratio"^^xsd:anyURI, "http://dbpedia.org/resource/Heat_capacity_ratio"^^xsd:anyURI;
  qudt:hasDimensionVector dimensionvector:A0E0L0I0M0H0T0D1, dimensionvector:A0E0L0I0M0H0T0D1;
  qudt:informativeReference "http://en.wikipedia.org/wiki/Heat_capacity_ratio"^^xsd:anyURI,
    "http://en.wikipedia.org/wiki/Heat_capacity_ratio"^^xsd:anyURI;
  qudt:isoNormativeReference "http://www.iso.org/iso/catalogue_detail?csnumber=31890"^^xsd:anyURI,
    "http://www.iso.org/iso/catalogue_detail?csnumber=31890"^^xsd:anyURI;
  qudt:qkdvDenominator dimensionvector:A0E0L2I0M1H-1T-2D0, dimensionvector:A0E0L2I0M1H-1T-2D0;
  qudt:qkdvNumerator dimensionvector:A0E0L2I0M1H-1T-2D0, dimensionvector:A0E0L2I0M1H-1T-2D0;
