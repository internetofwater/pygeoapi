  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/unit>;
  rdfs:label "Newton Meter Squared per Ampere"@en-US, "Newton Metre Squared per Ampere"@en;
  dct:description "product of the SI derived unit newton and the power of SI base unit metre with exponent 2 divided by the SI base unit ampere";
