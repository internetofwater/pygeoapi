    unit:MI-PER-MIN, unit:MI-PER-SEC, unit:MI_N-PER-MIN, unit:MicroM-PER-MIN, unit:MicroM-PER-SEC,
    unit:MilliM-PER-DAY, unit:MilliM-PER-HR, unit:MilliM-PER-MIN, unit:MilliM-PER-SEC,
    unit:MilliM-PER-YR, unit:YD-PER-HR, unit:YD-PER-MIN, unit:YD-PER-SEC .

<http://qudt.org/vocab/quantitykind/ChemicalConsumptionPerMass> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Chemical Consumption per Mass"@en;
  rdfs:comment "Applicable units are those of quantitykind:SpecificVolume";
  skos:broader <http://qudt.org/vocab/quantitykind/SpecificVolume>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L3I0M-1H0T0D0>;
  <http://qudt.org/schema/qudt/plainTextDescription> "In the context of a chemical durability test, this is measure of how much of a solution (often a corrosive or reactive one) is consumed or used up per unit mass of a material being tested. In other words, this the volume of solution needed to cause a certain level of chemical reaction or damage to a given mass of the material.";
  <http://qudt.org/schema/qudt/applicableUnit> unit:CentiM3-PER-GM, unit:MilliL-PER-GM,
    unit:DeciL-PER-GM, unit:DeciM3-PER-KiloGM, unit:FT3-PER-LB, unit:IN3-PER-LB, unit:L-PER-KiloGM,
    unit:M3-PER-KiloGM, unit:MilliL-PER-KiloGM, unit:MilliM3-PER-GM, unit:MilliM3-PER-KiloGM .

<http://qudt.org/vocab/quantitykind/ChemicalPotential> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Chemický potenciál"@cs, "Keupayaan kimia"@ms, "Potencjał chemiczny"@pl,
    "Potențial chimic"@ro, "chemical potential"@en, "chemisches Potential des Stoffs B"@de,
    "kimyasal potansiyel"@tr, "potencial químico"@es, "potencial químico"@pt, "potential chimique"@fr,
    "potenziale chimico"@it, "Химический потенциал"@ru, "جهد كيميائي"@ar, "پتانسیل شیمیایی"@fa,
    "化学ポテンシャル"@ja, "化学势"@zh;
  rdfs:comment "Applicable units are those of quantitykind:MolarEnergy";
  dct:description "\"Chemical Potential\", also known as partial molar free energy, is a form of potential energy that can be absorbed or released during a chemical reaction."^^<http://qudt.org/schema/qudt/LatexString>;
  skos:broader <http://qudt.org/vocab/quantitykind/MolarEnergy>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A-1E0L2I0M1H0T-2D0>;
  <http://qudt.org/schema/qudt/informativeReference> "http://en.wikipedia.org/wiki/Chemical_potential"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/isoNormativeReference> "http://www.iso.org/iso/catalogue_detail?csnumber=31894"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/plainTextDescription> "\"Chemical Potential\", also known as partial molar free energy, is a form of potential energy that can be absorbed or released during a chemical reaction.";
  <http://qudt.org/schema/qudt/latexSymbol> "$\\mu_B$"^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/latexDefinition> "$\\mu_B = (\\frac{\\partial G}{\\partial n_B})_{T,p,n_i}$, where $G$ is Gibbs energy, and $n_B$ is the amount of substance $B$."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/applicableUnit> unit:J-PER-MOL, unit:KiloCAL-PER-MOL,
    unit:KiloJ-PER-MOL .

