        [ qudt:exponent 1 ;
            qudt:hasUnit unit:HZ ],
        [ qudt:exponent -1 ;
            qudt:hasUnit unit:K ],
        [ qudt:exponent 1 ;
            qudt:hasUnit unit:HZ ] ;
    qudt:hasQuantityKind quantitykind:InverseTimeTemperature ;
