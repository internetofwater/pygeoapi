quantitykind:DiffusionCoefficient a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "Diffusionskoeffizient"@de, "Diffusionskoeffizient"@de, "coefficient de diffusion"@fr,
    "coefficient de diffusion"@fr, "coefficiente di diffusione"@it, "coefficiente di diffusione"@it,
    "coeficiente de difusión"@es, "coeficiente de difusión"@es, "coeficiente de difusão"@pt,
    "coeficiente de difusão"@pt, "diffusion coefficient"@en, "diffusion coefficient"@en,
    "difuzijski koeficient"@sl, "difuzijski koeficient"@sl;
  rdfs:comment "Applicable units are those of quantitykind:DiffusionCoefficient", "Applicable units are those of quantitykind:DiffusionCoefficient";
  dct:description "The \"Diffusion Coefficient\" is a proportionality constant between the molar flux due to molecular diffusion and the gradient in the concentration of the species (or the driving force for diffusion). Diffusivity is encountered in Fick's law and numerous other equations of physical chemistry."^^qudt:LatexString,
    "The \"Diffusion Coefficient\" is a proportionality constant between the molar flux due to molecular diffusion and the gradient in the concentration of the species (or the driving force for diffusion). Diffusivity is encountered in Fick's law and numerous other equations of physical chemistry."^^qudt:LatexString;
  qudt:hasDimensionVector dimensionvector:A0E0L2I0M0H0T-1D0, dimensionvector:A0E0L2I0M0H0T-1D0;
  qudt:iec61360Code "0112/2///62720#UAD031", "0112/2///62720#UAD031";
  qudt:informativeReference "http://en.wikipedia.org/wiki/Mass_diffusivity"^^xsd:anyURI,
    "http://en.wikipedia.org/wiki/Mass_diffusivity"^^xsd:anyURI, "https://cdd.iec.ch/cdd/iec61987/iec61987.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD031"^^xsd:anyURI,
    "https://cdd.iec.ch/cdd/iec61987/iec61987.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD031"^^xsd:anyURI;
  qudt:symbol "D", "D";
  qudt:isoNormativeReference "http://www.iso.org/iso/catalogue_detail?csnumber=31894"^^xsd:anyURI,
    "http://www.iso.org/iso/catalogue_detail?csnumber=31894"^^xsd:anyURI;
  qudt:plainTextDescription "The \"Diffusion Coefficient\" is a proportionality constant between the molar flux due to molecular diffusion and the gradient in the concentration of the species (or the driving force for diffusion). Diffusivity is encountered in Fick's law and numerous other equations of physical chemistry.",
    "The \"Diffusion Coefficient\" is a proportionality constant between the molar flux due to molecular diffusion and the gradient in the concentration of the species (or the driving force for diffusion). Diffusivity is encountered in Fick's law and numerous other equations of physical chemistry.";
  qudt:latexDefinition "$C_B \\left \\langle \\nu_B \\right \\rangle = -D grad C_B$, where $C_B$ the local molecular concentration of substance $B$ in the mixture and $\\left \\langle \\nu_B \\right \\rangle$ is the local average velocity of the molecules of $B$."^^qudt:LatexString,
    "$C_B \\left \\langle \\nu_B \\right \\rangle = -D grad C_B$, where $C_B$ the local molecular concentration of substance $B$ in the mixture and $\\left \\langle \\nu_B \\right \\rangle$ is the local average velocity of the molecules of $B$."^^qudt:LatexString;
  qudt:applicableUnit unit:M2-PER-SEC, unit:M2-PER-SEC .

