    "طول"@fa, "लम्बाई"@hi, "長さ"@ja, "长度"@zh;
  rdfs:comment "Applicable units are those of quantitykind:Length";
  dct:description "In geometric measurements, length most commonly refers to the est dimension of an object. In some contexts, the term \"length\" is reserved for a certain dimension of an object along which the length is measured."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/dbpediaMatch> "http://dbpedia.org/resource/Length"^^xsd:anyURI;
