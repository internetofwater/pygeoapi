  <http://qudt.org/schema/qudt/plainTextDescription> "The rate at which a body moves upwards at an angle of 90 degrees to the ground. It is the component of a projectile's velocity which is concerned with lifting the projectile.";
  <http://qudt.org/schema/qudt/applicableUnit> unit:CentiM-PER-HR, unit:CentiM-PER-KiloYR,
    unit:CentiM-PER-SEC, unit:CentiM-PER-YR, unit:FT-PER-DAY, unit:FT-PER-HR, unit:FT-PER-MIN,
    unit:FT-PER-SEC, unit:GigaHZ-M, unit:IN-PER-MIN, unit:IN-PER-SEC, unit:IN-PER-YR,
