  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/unit>;
  rdfs:label "kilowatt per metre degree Celsius";
  dct:description "1,000-fold of the SI derived unit watt divided by the product of the SI base unit metre and the unit for temperature degree Celsius";
