unit:BAR-L-PER-SEC a qudt:Unit, qudt:Unit;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/unit>, <http://qudt.org/vocab/unit>;
  rdfs:label "Bar Liter per Second"@en-US, "Bar Liter per Second"@en-US, "Bar Litre per Second"@en,
    "Bar Litre per Second"@en;
