unit:LY a <http://qudt.org/schema/qudt/Unit>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/unit>;
  rdfs:label "Light Year"@en;
  dct:description "A unit of length defining the distance, in meters, that light travels in a vacuum in one year."^^rdf:HTML;
