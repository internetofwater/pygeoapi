unit:A-HR-PER-DeciM3 a qudt:Unit ;
    rdfs:label "Ampere Hour per Cubic DeciMetre",
        "ampere hour per cubic decimetre" ;
    dct:description """$\\textit{Ampere Hour per Cubic Decimetre}$ is the product of the SI base unit ampere
 and the unit hour divided by 0.001-fold of the power of the SI base unit metre with
  the exponent 3.
 """^^qudt:LatexString ;
