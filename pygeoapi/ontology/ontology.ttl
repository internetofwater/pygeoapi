  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/unit>;
  rdfs:label "Meter Kelvin"@en-US, "Meter mal Kelvin"@de, "meter kelvin"@ms, "metre kelvin"@en,
    "metro per kelvin"@it, "متر کلوین"@fa, "米开尔文"@zh;
