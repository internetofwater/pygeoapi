    skos:prefLabel "Coliform, total" ;
    skos:topConceptOf <http://vocabulary.odm2.org/variablename> .

variablename:copper a skos:Concept ;
    skos:definition "Copper is a chemical element with symbol Cu and atomic number 29. It is a soft, malleable, and ductile metal with very high thermal and electrical conductivity. A freshly exposed surface of pure copper has a pinkish-orange color. Copper is used as a conductor of heat and electricity, as a building material, and as a constituent of various metal alloys, such as sterling silver used in jewelry, cupronickel used to make marine hardware and coins, and constantan used in strain gauges and thermocouples for temperature measurement." ;
    skos:exactMatch "https://en.wikipedia.org/wiki/Copper" ;
    skos:historyNote "Wikipedia" ;
    skos:inScheme <http://vocabulary.odm2.org/variablename> ;
    skos:note "Added to support Critical Zone Observatory (CZO) data use cases. " ;
    skos:prefLabel "Copper" ;
    skos:topConceptOf <http://vocabulary.odm2.org/variablename> .

