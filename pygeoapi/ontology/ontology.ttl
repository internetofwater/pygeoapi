    quantitykind:EnergyPerElectricCharge, quantitykind:EnergyPerElectricCharge, quantitykind:Voltage,
    quantitykind:Voltage;
  qudt:latexSymbol "$\\phi$"^^qudt:LatexString, "$\\phi$"^^qudt:LatexString;
  qudt:latexDefinition "$-\\text{grad} \\; V = E + \\frac{\\partial A}{\\partial t}$, where $E$ is electric field strength, $A$ is magentic vector potential and $t$ is time."^^qudt:LatexString,
    "$-\\text{grad} \\; V = E + \\frac{\\partial A}{\\partial t}$, where $E$ is electric field strength, $A$ is magentic vector potential and $t$ is time."^^qudt:LatexString;
