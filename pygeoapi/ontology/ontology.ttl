variablename:erosionRate a skos:Concept;
  skos:definition "In earth science, erosion is the action of surface processes (such as water flow or wind) that removes soil, rock, or dissolved material from one location on the Earth's crust, and then transports it to another location (not to be confused with weathering which involves no movement).";
  skos:inScheme <http://vocabulary.odm2.org/variablename>;
  skos:topConceptOf <http://vocabulary.odm2.org/variablename>;
  skos:prefLabel "Erosion rate";
  skos:note "Added to support Critical Zone Observatory (CZO) data use cases. " .

