  <http://qudt.org/schema/qudt/hasQuantityKind> <http://qudt.org/vocab/quantitykind/Concentration>,
    <http://qudt.org/vocab/quantitykind/Solubility_Water>;
  <http://qudt.org/schema/qudt/iec61360Code> "0112/2///62720#UAA642";
  <http://qudt.org/schema/qudt/informativeReference> "https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAA642"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/symbol> "kmol/m³";
