        [ qudt:exponent -1 ;
            qudt:hasUnit unit:SEC ] ;
    qudt:hasQuantityKind quantitykind:Frequency,
        quantitykind:RotationalFrequency,
        quantitykind:RotationalVelocity ;
    qudt:iec61360Code "0112/2///62720#UAD544" ;
    qudt:informativeReference "https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAD544"^^xsd:anyURI ;
