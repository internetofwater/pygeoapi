quantitykind:ElectricCurrentPerTemperature a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "Electric Current per Temperature"@en, "Electric Current per Temperature"@en;
  rdfs:comment "Applicable units are those of quantitykind:ElectricCurrentPerTemperature",
    "Applicable units are those of quantitykind:ElectricCurrentPerTemperature";
  dct:description "\"Electric Current per Unit Temperature\" is used to express how a current is subject to temperature. Originally used in Wien's Law to describe phenomena related to filaments. One use today is to express how a current generator derates with temperature."^^qudt:LatexString,
    "\"Electric Current per Unit Temperature\" is used to express how a current is subject to temperature. Originally used in Wien's Law to describe phenomena related to filaments. One use today is to express how a current generator derates with temperature."^^qudt:LatexString;
