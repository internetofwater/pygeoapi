<http://qudt.org/vocab/quantitykind/ThermalResistance> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:seeAlso <http://qudt.org/vocab/quantitykind/HeatFlowRate>, <http://qudt.org/vocab/quantitykind/ThermalInsulance>,
    <http://qudt.org/vocab/quantitykind/ThermodynamicTemperature>;
  rdfs:label "opór cieplny"@cs, "resistencia térmica"@es, "resistenza termica"@it, "resistência térmica"@pt,
    "résistance thermique"@fr, "thermal resistance"@en, "thermischer Widerstand"@de, "مقاومة حرارية"@ar,
    "热阻"@zh, "熱抵抗"@ja;
  rdfs:comment "Applicable units are those of quantitykind:ThermalResistance";
  dct:description "$\\textit{Thermal Resistance}$ is a heat property and a measure of a temperature difference by which an object or material resists a heat flow (heat per time unit or thermal resistance). Thermal resistance is the reciprocal thermal conductance. the thermodynamic temperature difference divided by heat flow rate. Thermal resistance $R$ has the units $\\frac{m^2 \\cdot K}{W}$."^^<http://qudt.org/schema/qudt/LatexString>;
  skos:altLabel "Wärmewiderstand"@de;
  <http://qudt.org/schema/qudt/dbpediaMatch> "http://dbpedia.org/resource/Thermal_resistance"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L-2I0M-1H1T3D0>;
  <http://qudt.org/schema/qudt/iec61360Code> "0112/2///62720#UAD193";
  <http://qudt.org/schema/qudt/informativeReference> "http://en.wikipedia.org/wiki/Thermal_resistance"^^xsd:anyURI,
    "https://cdd.iec.ch/cdd/iec61987/iec61987.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD193"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/symbol> "R";
  <http://qudt.org/schema/qudt/isoNormativeReference> "http://www.iso.org/iso/catalogue_detail?csnumber=31890"^^xsd:anyURI;
