quantitykind:LuminousEfficacy a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "Luminous Efficacy"@en, "Luminous Efficacy"@en;
  rdfs:comment "Applicable units are those of quantitykind:LuminousEfficacy", "Applicable units are those of quantitykind:LuminousEfficacy";
  dct:description "Luminous Efficacy is the ratio of luminous flux (in lumens) to power (usually measured in watts). Depending on context, the power can be either the radiant flux of the source's output, or it can be the total electric power consumed by the source."^^qudt:LatexString,
    "Luminous Efficacy is the ratio of luminous flux (in lumens) to power (usually measured in watts). Depending on context, the power can be either the radiant flux of the source's output, or it can be the total electric power consumed by the source."^^qudt:LatexString;
  qudt:hasDimensionVector dimensionvector:A0E0L-2I1M-1H0T3D0, dimensionvector:A0E0L-2I1M-1H0T3D0;
  qudt:iec61360Code "0112/2///62720#UAD091", "0112/2///62720#UAD091";
  qudt:informativeReference "http://en.wikipedia.org/wiki/Luminous_efficacy"^^xsd:anyURI,
    "http://en.wikipedia.org/wiki/Luminous_efficacy"^^xsd:anyURI, "https://cdd.iec.ch/cdd/iec61987/iec61987.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD091"^^xsd:anyURI,
    "https://cdd.iec.ch/cdd/iec61987/iec61987.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD091"^^xsd:anyURI;
  qudt:expression "$lm/w$"^^qudt:LatexString, "$lm/w$"^^qudt:LatexString;
  qudt:plainTextDescription "Luminous Efficacy is the ratio of luminous flux (in lumens) to power (usually measured in watts). Depending on context, the power can be either the radiant flux of the source's output, or it can be the total electric power consumed by the source.",
    "Luminous Efficacy is the ratio of luminous flux (in lumens) to power (usually measured in watts). Depending on context, the power can be either the radiant flux of the source's output, or it can be the total electric power consumed by the source.";
  qudt:latexDefinition "$K = \\frac{\\Phi_v}{\\Phi}$, where $\\Phi_v$ is the luminous flux and $\\Phi$ is the corresponding radiant flux."^^qudt:LatexString,
    "$K = \\frac{\\Phi_v}{\\Phi}$, where $\\Phi_v$ is the luminous flux and $\\Phi$ is the corresponding radiant flux."^^qudt:LatexString;
  qudt:applicableUnit unit:LM-PER-W, unit:LM-PER-W .

unit:LM-SEC a qudt:Unit, qudt:Unit;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/unit>, <http://qudt.org/vocab/unit>;
  rdfs:label "lumen second"@en, "lumen second"@en;
  dct:description "In photometry, the lumen second is the SI derived unit of luminous energy. It is based on the lumen, the SI unit of luminous flux, and the second, the SI base unit of time.  The lumen second is sometimes called the talbot (symbol T).  An older name for the lumen second was the lumberg."^^rdf:HTML,
    "In photometry, the lumen second is the SI derived unit of luminous energy. It is based on the lumen, the SI unit of luminous flux, and the second, the SI base unit of time.  The lumen second is sometimes called the talbot (symbol T).  An older name for the lumen second was the lumberg."^^rdf:HTML;
  skos:altLabel "lumberg", "lumberg", "talbot", "talbot";
  qudt:applicableSystem <http://qudt.org/vocab/sou/SI>, <http://qudt.org/vocab/sou/SI>;
  qudt:conversionMultiplier 1.0, 1.0;
  qudt:conversionMultiplierSN 1.0E0, 1.0E0;
  qudt:hasDimensionVector dimensionvector:A0E0L0I1M0H0T1D0, dimensionvector:A0E0L0I1M0H0T1D0;
  qudt:hasQuantityKind quantitykind:LuminousEnergy, quantitykind:LuminousEnergy;
  qudt:iec61360Code "0112/2///62720#UAA722", "0112/2///62720#UAA722";
  qudt:informativeReference "https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAA722"^^xsd:anyURI,
    "https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAA722"^^xsd:anyURI;
  qudt:symbol "lm·s", "lm·s";
