  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/unit>, <http://qudt.org/vocab/unit>;
  rdfs:label "Gray"@de, "Gray"@de, "graium"@la, "graium"@la, "gray"@cs, "gray"@cs, "gray"@en,
    "gray"@en, "gray"@es, "gray"@es, "gray"@fr, "gray"@fr, "gray"@hu, "gray"@hu, "gray"@it,
    "gray"@it, "gray"@ms, "gray"@ms, "gray"@pt, "gray"@pt, "gray"@ro, "gray"@ro, "gray"@sl,
    "gray"@sl, "gray"@tr, "gray"@tr, "grej"@pl, "grej"@pl, "γκρέι"@el, "γκρέι"@el, "грей"@bg,
    "грей"@bg, "грэй"@ru, "грэй"@ru, "גריי"@he, "גריי"@he, "جراي; غراي"@ar, "جراي; غراي"@ar,
    "گری"@fa, "گری"@fa, "ग्रेय"@hi, "ग्रेय"@hi, "グレイ"@ja, "グレイ"@ja, "戈瑞"@zh, "戈瑞"@zh;
  dct:description "The SI unit of radiation dose. Radiation carries energy, and when it is absorbed by matter the matter receives this energy. The dose is the amount of energy deposited per unit of mass. One gray is defined to be the dose of one joule of energy absorbed per kilogram of matter, or 100 rad. The unit is named for the British physician L. Harold Gray (1905-1965), an authority on the use of radiation in the treatment of cancer."^^rdf:HTML,
    "The SI unit of radiation dose. Radiation carries energy, and when it is absorbed by matter the matter receives this energy. The dose is the amount of energy deposited per unit of mass. One gray is defined to be the dose of one joule of energy absorbed per kilogram of matter, or 100 rad. The unit is named for the British physician L. Harold Gray (1905-1965), an authority on the use of radiation in the treatment of cancer."^^rdf:HTML;
  qudt:applicableSystem <http://qudt.org/vocab/sou/CGS-EMU>, <http://qudt.org/vocab/sou/CGS-EMU>,
    <http://qudt.org/vocab/sou/CGS-GAUSS>, <http://qudt.org/vocab/sou/CGS-GAUSS>, <http://qudt.org/vocab/sou/SI>,
    <http://qudt.org/vocab/sou/SI>, <http://qudt.org/vocab/sou/CGS>, <http://qudt.org/vocab/sou/CGS>;
