  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:seeAlso <http://qudt.org/vocab/quantitykind/RotationalFrequency>, <http://qudt.org/vocab/quantitykind/RotationalVelocity>;
  rdfs:label "角速度"@zh, "Açısal hız"@tr, "Halaju bersudut"@ms, "Prędkość kątowa"@pl,
    "Viteză unghiulară"@ro, "Winkelgeschwindigkeit"@de, "angular velocity"@en, "kotna hitrost"@sl,
