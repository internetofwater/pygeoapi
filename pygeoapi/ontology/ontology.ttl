<http://qudt.org/vocab/quantitykind/VentilationRatePerFloorArea> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Ventilation Rate per Floor Area"@en;
  rdfs:comment "Applicable units are those of quantitykind:VentilationRatePerFloorArea";
  dct:description "Ventilation Rate is often expressed by the volumetric flowrate of outdoor air introduced to a building. However, ASHRAE now recommends ventilation rates dependent upon floor area."^^<http://qudt.org/schema/qudt/LatexString>;
