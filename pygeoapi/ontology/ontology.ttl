  <http://qudt.org/schema/qudt/informativeReference> "https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAA154"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/symbol> "GW";
