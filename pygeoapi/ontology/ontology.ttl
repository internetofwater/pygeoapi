    "rad-1"^^<http://qudt.org/schema/qudt/UCUMcs>;
  <http://qudt.org/schema/qudt/uneceCommonCode> "P97" .

unit:SAMPLE-PER-SEC a <http://qudt.org/schema/qudt/Unit>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/unit>;
