quantitykind:ElectronRadius a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "Electron Radius"@en, "Electron Radius"@en;
  rdfs:comment "Applicable units are those of quantitykind:Length", "Applicable units are those of quantitykind:Length";
  dct:description """
  $\\textit{Electron Radius}$, also known as the Lorentz radius or the Thomson scattering length, is based on a classical (i.e., non-quantum) relativistic model of the electron.
  """^^qudt:LatexString,
    """
  $\\textit{Electron Radius}$, also known as the Lorentz radius or the Thomson scattering length, is based on a classical (i.e., non-quantum) relativistic model of the electron.
  """^^qudt:LatexString;
  skos:broader quantitykind:Length, quantitykind:Length;
  qudt:hasDimensionVector dimensionvector:A0E0L1I0M0H0T0D0, dimensionvector:A0E0L1I0M0H0T0D0;
  qudt:informativeReference "http://en.wikipedia.org/wiki/Classical_electron_radius"^^xsd:anyURI,
    "http://en.wikipedia.org/wiki/Classical_electron_radius"^^xsd:anyURI;
  qudt:symbol "r_e", "r_e";
  qudt:plainTextDescription "\"Electron Radius\", also known as the Lorentz radius or the Thomson scattering length, is based on a classical (i.e., non-quantum) relativistic model of the electron.",
    "\"Electron Radius\", also known as the Lorentz radius or the Thomson scattering length, is based on a classical (i.e., non-quantum) relativistic model of the electron.";
  qudt:latexDefinition "$r_e = \\frac{e^2}{4\\pi m_e c_0^2}$, where $e$ is the elementary charge, $\\varepsilon_0$ is the electric constant, item $m_e$ is the rest mass of electrons, and $c_0$ is the speed of light in vacuum."^^qudt:LatexString,
    "$r_e = \\frac{e^2}{4\\pi m_e c_0^2}$, where $e$ is the elementary charge, $\\varepsilon_0$ is the electric constant, item $m_e$ is the rest mass of electrons, and $c_0$ is the speed of light in vacuum."^^qudt:LatexString;
