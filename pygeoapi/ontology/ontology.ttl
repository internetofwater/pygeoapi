unit:DEG-PER-MIN a <http://qudt.org/schema/qudt/Unit>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/unit>;
  rdfs:label "Degree per Minute"@en;
  dct:description "A unit of measure for the rate of change of plane angle, $d\\omega / dt$,  in durations of one minute.The vector $\\omega$ is directed along the axis of rotation in the direction for which the rotation is clockwise."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/conversionMultiplier> 0.000290888209;
  <http://qudt.org/schema/qudt/conversionMultiplierSN> 2.90888209E-4;
