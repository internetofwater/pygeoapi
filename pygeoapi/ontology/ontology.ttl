quantitykind:MicroCanonicalPartitionFunction a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "Micro Canonical Partition Function"@en, "Micro Canonical Partition Function"@en;
  rdfs:comment "Applicable units are those of quantitykind:CanonicalPartitionFunction",
    "Applicable units are those of quantitykind:CanonicalPartitionFunction";
  dct:description "A \"Micro Canonical Partition Function\" applies to a micro canonical ensemble, in which the system is allowed to exchange heat with the environment at fixed temperature, volume, and a fixed number of particles."^^qudt:LatexString,
    "A \"Micro Canonical Partition Function\" applies to a micro canonical ensemble, in which the system is allowed to exchange heat with the environment at fixed temperature, volume, and a fixed number of particles."^^qudt:LatexString;
  skos:broader quantitykind:CanonicalPartitionFunction, quantitykind:CanonicalPartitionFunction;
  qudt:hasDimensionVector dimensionvector:A0E0L0I0M0H0T0D1, dimensionvector:A0E0L0I0M0H0T0D1;
  qudt:informativeReference "http://en.wikipedia.org/wiki/Microcanonical_ensemble"^^xsd:anyURI,
    "http://en.wikipedia.org/wiki/Microcanonical_ensemble"^^xsd:anyURI, "http://en.wikipedia.org/wiki/Partition_function_(statistical_mechanics)#Grand_canonical_partition_function"^^xsd:anyURI,
    "http://en.wikipedia.org/wiki/Partition_function_(statistical_mechanics)#Grand_canonical_partition_function"^^xsd:anyURI;
  qudt:isoNormativeReference "http://www.iso.org/iso/catalogue_detail?csnumber=31894"^^xsd:anyURI,
    "http://www.iso.org/iso/catalogue_detail?csnumber=31894"^^xsd:anyURI;
  qudt:plainTextDescription "A \"Micro Canonical Partition Function\" applies to a micro canonical ensemble, in which the system is allowed to exchange heat with the environment at fixed temperature, volume, and a fixed number of particles.",
    "A \"Micro Canonical Partition Function\" applies to a micro canonical ensemble, in which the system is allowed to exchange heat with the environment at fixed temperature, volume, and a fixed number of particles.";
  qudt:latexSymbol "$\\Omega$"^^qudt:LatexString, "$\\Omega$"^^qudt:LatexString;
  qudt:latexDefinition "$\\Omega = \\sum_r 1$, where the sum is over all quantum states consistent with given energy. volume, external fields, and content."^^qudt:LatexString,
    "$\\Omega = \\sum_r 1$, where the sum is over all quantum states consistent with given energy. volume, external fields, and content."^^qudt:LatexString;
  qudt:applicableUnit unit:UNITLESS, unit:UNITLESS .

