  rdfs:label "Has Part"@en, "Has Part"@en;
  rdfs:comment "A related resource that is included either physically or logically in the described resource."@en,
    "A related resource that is included either physically or logically in the described resource."@en;
  rdfs:subPropertyOf dc:relation, dc:relation, dct:relation, dct:relation;
  dct:description "This property is intended to be used with non-literal values. This property is an inverse property of Is Part Of."@en,
    "This property is intended to be used with non-literal values. This property is an inverse property of Is Part Of."@en;
  dct:issued "2000-07-11"^^xsd:date, "2000-07-11"^^xsd:date .

dct:hasVersion a rdf:Property, rdf:Property;
  rdfs:isDefinedBy <http://purl.org/dc/terms/>, <http://purl.org/dc/terms/>;
  rdfs:label "Has Version"@en, "Has Version"@en;
  rdfs:comment "A related resource that is a version, edition, or adaptation of the described resource."@en,
    "A related resource that is a version, edition, or adaptation of the described resource."@en;
  rdfs:subPropertyOf dc:relation, dc:relation, dct:relation, dct:relation;
  dct:description "Changes in version imply substantive changes in content rather than differences in format. This property is intended to be used with non-literal values. This property is an inverse property of Is Version Of."@en,
    "Changes in version imply substantive changes in content rather than differences in format. This property is intended to be used with non-literal values. This property is an inverse property of Is Version Of."@en;
  dct:issued "2000-07-11"^^xsd:date, "2000-07-11"^^xsd:date .

dct:instructionalMethod a rdf:Property, rdf:Property;
  rdfs:isDefinedBy <http://purl.org/dc/terms/>, <http://purl.org/dc/terms/>;
  rdfs:label "Instructional Method"@en, "Instructional Method"@en;
  rdfs:comment "A process, used to engender knowledge, attitudes and skills, that the described resource is designed to support."@en,
    "A process, used to engender knowledge, attitudes and skills, that the described resource is designed to support."@en;
  dct:description "Instructional Method typically includes ways of presenting instructional materials or conducting instructional activities, patterns of learner-to-learner and learner-to-instructor interactions, and mechanisms by which group and individual levels of learning are measured.  Instructional methods include all aspects of the instruction and learning processes from planning and implementation through evaluation and feedback."@en,
    "Instructional Method typically includes ways of presenting instructional materials or conducting instructional activities, patterns of learner-to-learner and learner-to-instructor interactions, and mechanisms by which group and individual levels of learning are measured.  Instructional methods include all aspects of the instruction and learning processes from planning and implementation through evaluation and feedback."@en;
  dct:issued "2005-06-13"^^xsd:date, "2005-06-13"^^xsd:date;
  <http://purl.org/dc/dcam/rangeIncludes> dct:MethodOfInstruction, dct:MethodOfInstruction .

dct:isFormatOf a rdf:Property, rdf:Property;
  rdfs:isDefinedBy <http://purl.org/dc/terms/>, <http://purl.org/dc/terms/>;
  rdfs:label "Is Format Of"@en, "Is Format Of"@en;
  rdfs:comment "A pre-existing related resource that is substantially the same as the described resource, but in another format."@en,
    "A pre-existing related resource that is substantially the same as the described resource, but in another format."@en;
  rdfs:subPropertyOf dc:relation, dc:relation, dct:relation, dct:relation;
  dct:description "This property is intended to be used with non-literal values. This property is an inverse property of Has Format."@en,
