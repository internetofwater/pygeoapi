quantitykind:Frequency a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "Frekuensi"@ms, "Frekuensi"@ms, "Frekvence"@cs, "Frekvence"@cs, "Frequenz"@de,
    "Frequenz"@de, "częstotliwość"@pl, "częstotliwość"@pl, "frecuencia"@es, "frecuencia"@es,
    "frecvență"@ro, "frecvență"@ro, "frekans"@tr, "frekans"@tr, "frekvenca"@sl, "frekvenca"@sl,
    "frekvencia"@hu, "frekvencia"@hu, "frequency"@en, "frequency"@en, "frequentia"@la,
    "frequentia"@la, "frequenza"@it, "frequenza"@it, "frequência"@pt, "frequência"@pt,
    "fréquence"@fr, "fréquence"@fr, "Συχνότητα"@el, "Συχνότητα"@el, "Частота"@ru, "Частота"@ru,
    "Честота"@bg, "Честота"@bg, "תדירות"@he, "תדירות"@he, "التردد لدى نظام الوحدات الدولي"@ar,
    "التردد لدى نظام الوحدات الدولي"@ar, "بسامد"@fa, "بسامد"@fa, "आवृत्ति"@hi, "आवृत्ति"@hi,
    "周波数"@ja, "周波数"@ja, "频率"@zh, "频率"@zh;
  rdfs:comment "Applicable units are those of quantitykind:Frequency", "Applicable units are those of quantitykind:Frequency";
  dct:description "\"Frequency\" is the number of occurrences of a repeating event per unit time. The repetition of the events may be periodic (that is. the length of time between event repetitions is fixed) or aperiodic (i.e. the length of time between event repetitions varies). Therefore, we distinguish between periodic and aperiodic frequencies. In the SI system, periodic frequency is measured in hertz (Hz) or multiples of hertz, while aperiodic frequency is measured in becquerel (Bq).  In spectroscopy, $\\nu$ is mostly used. Light passing through different media keeps its frequency, but not its wavelength or wavenumber."^^qudt:LatexString,
    "\"Frequency\" is the number of occurrences of a repeating event per unit time. The repetition of the events may be periodic (that is. the length of time between event repetitions is fixed) or aperiodic (i.e. the length of time between event repetitions varies). Therefore, we distinguish between periodic and aperiodic frequencies. In the SI system, periodic frequency is measured in hertz (Hz) or multiples of hertz, while aperiodic frequency is measured in becquerel (Bq).  In spectroscopy, $\\nu$ is mostly used. Light passing through different media keeps its frequency, but not its wavelength or wavenumber."^^qudt:LatexString;
  skos:broader quantitykind:InverseTime, quantitykind:InverseTime;
  qudt:dbpediaMatch "http://dbpedia.org/resource/Frequency"^^xsd:anyURI, "http://dbpedia.org/resource/Frequency"^^xsd:anyURI;
  qudt:hasDimensionVector dimensionvector:A0E0L0I0M0H0T-1D0, dimensionvector:A0E0L0I0M0H0T-1D0;
  qudt:iec61360Code "0112/2///62720#UAD056", "0112/2///62720#UAD056";
  qudt:informativeReference "https://cdd.iec.ch/cdd/iec61987/iec61987.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD056"^^xsd:anyURI,
    "https://cdd.iec.ch/cdd/iec61987/iec61987.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD056"^^xsd:anyURI;
  qudt:siExactMatch <https://si-digital-framework.org/SI/quantities/FREQ>, <https://si-digital-framework.org/quantities/FREQ>;
  qudt:latexSymbol "$\\nu, f$"^^qudt:LatexString, "$\\nu, f$"^^qudt:LatexString;
  qudt:latexDefinition """$f = 1/T$, where $T$ is a period.

Alternatively,

$\\nu = 1/T$"""^^qudt:LatexString,
    """$f = 1/T$, where $T$ is a period.

Alternatively,

$\\nu = 1/T$"""^^qudt:LatexString;
