quantitykind:MolecularViscosity a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:seeAlso quantitykind:DynamicViscosity, quantitykind:DynamicViscosity, quantitykind:KinematicViscosity,
    quantitykind:KinematicViscosity;
  rdfs:label "Molecular Viscosity"@en, "Molecular Viscosity"@en;
  dct:description "Molecules in a fluid close to a solid boundary sometime strike the boundary and transfer momentum to it. Molecules further from the boundary collide with molecules that have struck the boundary, further transferring the change in momentum into the interior of the fluid. This transfer of momentum is molecular viscosity. Molecules, however, travel only micrometers between collisions, and the process is very inefficient for transferring momentum even a few centimeters. Molecular viscosity is important only within a few millimeters of a boundary. The coefficient of molecular viscosity has the same value as the dynamic viscosity."^^qudt:LatexString,
    "Molecules in a fluid close to a solid boundary sometime strike the boundary and transfer momentum to it. Molecules further from the boundary collide with molecules that have struck the boundary, further transferring the change in momentum into the interior of the fluid. This transfer of momentum is molecular viscosity. Molecules, however, travel only micrometers between collisions, and the process is very inefficient for transferring momentum even a few centimeters. Molecular viscosity is important only within a few millimeters of a boundary. The coefficient of molecular viscosity has the same value as the dynamic viscosity."^^qudt:LatexString;
  qudt:hasDimensionVector dimensionvector:A0E0L-1I0M1H0T-1D0, dimensionvector:A0E0L-1I0M1H0T-1D0;
  qudt:informativeReference "http://oceanworld.tamu.edu/resources/ocng_textbook/chapter08/chapter08_01.htm"^^xsd:anyURI,
    "http://oceanworld.tamu.edu/resources/ocng_textbook/chapter08/chapter08_01.htm"^^xsd:anyURI;
  qudt:plainTextDescription "Molecules in a fluid close to a solid boundary sometime strike the boundary and transfer momentum to it. Molecules further from the boundary collide with molecules that have struck the boundary, further transferring the change in momentum into the interior of the fluid. This transfer of momentum is molecular viscosity. Molecules, however, travel only micrometers between collisions, and the process is very inefficient for transferring momentum even a few centimeters. Molecular viscosity is important only within a few millimeters of a boundary. The coefficient of molecular viscosity has the same value as the dynamic viscosity.",
    "Molecules in a fluid close to a solid boundary sometime strike the boundary and transfer momentum to it. Molecules further from the boundary collide with molecules that have struck the boundary, further transferring the change in momentum into the interior of the fluid. This transfer of momentum is molecular viscosity. Molecules, however, travel only micrometers between collisions, and the process is very inefficient for transferring momentum even a few centimeters. Molecular viscosity is important only within a few millimeters of a boundary. The coefficient of molecular viscosity has the same value as the dynamic viscosity." .

quantitykind:KinematicViscosityOrDiffusionConstantOrThermalDiffusivity a qudt:QuantityKind,
    qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "kinematic viscosity or diffusion constant or thermal diffusivity"@en-US,
    "kinematic viscosity or diffusion constant or thermal diffusivity"@en-US;
  dct:description "ratio of the dynamic viscosity and the density of a material measured at the same temperature, or ratio of the diffusion current density and carrier density gradient, or ratio of thermal conductivity divided by heat capacity"@en,
    "ratio of the dynamic viscosity and the density of a material measured at the same temperature, or ratio of the diffusion current density and carrier density gradient, or ratio of thermal conductivity divided by heat capacity"@en;
  qudt:hasDimensionVector dimensionvector:A0E0L2I0M0H0T-1D0, dimensionvector:A0E0L2I0M0H0T-1D0;
  qudt:symbol "0173-1#Z4-BAJ328#002", "0173-1#Z4-BAJ328#002";
  qudt:plainTextDescription "Quotient aus der dynamischen Viskosität und der Dichte eines Stoffes oder Quotient Diffusionsstromdichte durch Gradient der Ladungsträgerdichte oder Quotient Wärmeleitfähigkeit durch Wärmekapazität"@de,
    "Quotient aus der dynamischen Viskosität und der Dichte eines Stoffes oder Quotient Diffusionsstromdichte durch Gradient der Ladungsträgerdichte oder Quotient Wärmeleitfähigkeit durch Wärmekapazität"@de .

quantitykind:KineticEnergy a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "Kinetic Energy"@en, "Kinetic Energy"@en;
  rdfs:comment "Applicable units are those of quantitykind:Energy", "Applicable units are those of quantitykind:Energy";
  dct:description "$\\textit{Kinetic Energy}$ is the energy which a body possesses as a consequence of its motion, defined as one-half the product of its mass $m$ and the square of its speed $v$, $ \\frac{1}{2} mv^{2} $. The kinetic energy per unit volume of a fluid parcel is the $ \\frac{1}{2}  p v^{2}$ , where $p$ is the density and $v$ the speed of the parcel. See potential energy. For relativistic speeds the kinetic energy is given by $E_k = mc^2 - m_0 c^2$, where $c$ is the velocity of light in a vacuum, $m_0$ is the rest mass, and $m$ is the moving mass."^^qudt:LatexString,
    "$\\textit{Kinetic Energy}$ is the energy which a body possesses as a consequence of its motion, defined as one-half the product of its mass $m$ and the square of its speed $v$, $ \\frac{1}{2} mv^{2} $. The kinetic energy per unit volume of a fluid parcel is the $ \\frac{1}{2}  p v^{2}$ , where $p$ is the density and $v$ the speed of the parcel. See potential energy. For relativistic speeds the kinetic energy is given by $E_k = mc^2 - m_0 c^2$, where $c$ is the velocity of light in a vacuum, $m_0$ is the rest mass, and $m$ is the moving mass."^^qudt:LatexString;
  skos:broader quantitykind:Energy, quantitykind:Energy;
  qudt:dbpediaMatch "http://dbpedia.org/resource/Kinetic_energy"^^xsd:anyURI, "http://dbpedia.org/resource/Kinetic_energy"^^xsd:anyURI;
  qudt:hasDimensionVector dimensionvector:A0E0L2I0M1H0T-2D0, dimensionvector:A0E0L2I0M1H0T-2D0;
  qudt:iec61360Code "0112/2///62720#UAD071", "0112/2///62720#UAD071";
  qudt:informativeReference "http://en.wikipedia.org/wiki/Kinetic_energy"^^xsd:anyURI,
    "http://en.wikipedia.org/wiki/Kinetic_energy"^^xsd:anyURI, "https://cdd.iec.ch/cdd/iec61987/iec61987.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD071"^^xsd:anyURI,
    "https://cdd.iec.ch/cdd/iec61987/iec61987.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD071"^^xsd:anyURI;
  qudt:symbol "KE", "KE";
  qudt:latexDefinition "$T = \\frac{mv^2}{2}$, where $m$ is mass and $v$ is speed."^^qudt:LatexString,
    "$T = \\frac{mv^2}{2}$, where $m$ is mass and $v$ is speed."^^qudt:LatexString;
  qudt:altSymbol "K", "K";
  qudt:applicableUnit unit:AttoJ, unit:AttoJ, unit:BTU_IT, unit:BTU_IT, unit:BTU_TH,
    unit:BTU_TH, unit:CAL_IT, unit:CAL_IT, unit:CAL_TH, unit:CAL_TH, unit:ERG, unit:ERG,
    unit:EV, unit:EV, unit:E_h, unit:E_h, unit:ExaJ, unit:ExaJ, unit:FT-LB_F, unit:FT-LB_F,
    unit:FT-PDL, unit:FT-PDL, unit:FemtoJ, unit:FemtoJ, unit:GigaEV, unit:GigaEV, unit:GigaJ,
    unit:GigaJ, unit:GigaW-HR, unit:GigaW-HR, unit:J, unit:J, unit:KiloBTU_IT, unit:KiloBTU_IT,
    unit:KiloBTU_TH, unit:KiloBTU_TH, unit:KiloCAL, unit:KiloCAL, unit:KiloEV, unit:KiloEV,
    unit:KiloJ, unit:KiloJ, unit:KiloV-A-HR, unit:KiloV-A_Reactive-HR, unit:KiloW-HR,
    unit:KiloW-HR, unit:MegaEV, unit:MegaEV, unit:MegaJ, unit:MegaJ, unit:MegaTOE, unit:MegaTOE,
    unit:MegaV-A-HR, unit:MegaV-A_Reactive-HR, unit:MegaW-HR, unit:MegaW-HR, unit:MicroJ,
