quantitykind:ParticleCurrent a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "Particle Current"@en, "Particle Current"@en;
  rdfs:comment "Applicable units are those of quantitykind:Frequency", "Applicable units are those of quantitykind:Frequency";
  dct:description """
  The quantity kind $\\textit{Particle Current}$ can be used to describe the net number
   of particles passing through a surface in an infinitesimal time interval.
  """^^qudt:LatexString,
    """
  The quantity kind $\\textit{Particle Current}$ can be used to describe the net number
   of particles passing through a surface in an infinitesimal time interval.
  """^^qudt:LatexString;
  skos:broader quantitykind:Frequency, quantitykind:Frequency;
  qudt:hasDimensionVector dimensionvector:A0E0L0I0M0H0T-1D0, dimensionvector:A0E0L0I0M0H0T-1D0;
  qudt:symbol "J", "J";
  qudt:isoNormativeReference "http://www.iso.org/iso/catalogue_detail?csnumber=31895"^^xsd:anyURI,
    "http://www.iso.org/iso/catalogue_detail?csnumber=31895"^^xsd:anyURI;
  qudt:plainTextDescription "\"Particle Current\" can be used to describe the net number of particles passing through a surface in an infinitesimal time interval.",
    "\"Particle Current\" can be used to describe the net number of particles passing through a surface in an infinitesimal time interval.";
  qudt:latexDefinition "$\\int J \\cdot e_n dA = \\frac{dN}{dt}$, where $e_ndA$ is the vector surface element, $N$ is the net number of particles passing over a surface, and $dt$ describes the time interval."^^qudt:LatexString,
    "$\\int J \\cdot e_n dA = \\frac{dN}{dt}$, where $e_ndA$ is the vector surface element, $N$ is the net number of particles passing over a surface, and $dt$ describes the time interval."^^qudt:LatexString;
  qudt:altSymbol "S", "S";
  qudt:applicableUnit unit:HZ, unit:HZ, unit:GigaHZ, unit:GigaHZ, unit:PER-SEC, unit:PER-SEC,
    unit:KiloHZ, unit:KiloHZ, unit:MegaHZ, unit:MegaHZ, unit:MilliHZ, unit:MilliHZ, unit:NUM-PER-HR,
    unit:NUM-PER-HR, unit:PER-HR, unit:PER-HR, unit:NUM-PER-SEC, unit:NUM-PER-SEC, unit:NUM-PER-YR,
    unit:NUM-PER-YR, unit:PER-YR, unit:PER-YR, unit:PER-DAY, unit:PER-DAY, unit:PER-MIN,
    unit:PER-MIN, unit:PER-MO, unit:PER-MO, unit:PER-MilliSEC, unit:PER-MilliSEC, unit:SAMPLE-PER-SEC,
    unit:SAMPLE-PER-SEC, unit:PER-WK, unit:PER-WK, unit:PERCENT-PER-DAY, unit:PERCENT-PER-DAY,
    unit:PERCENT-PER-HR, unit:PERCENT-PER-HR, unit:PERCENT-PER-MO, unit:PERCENT-PER-MO,
    unit:PERCENT-PER-WK, unit:PERCENT-PER-WK, unit:PERCENT-PER-YR, unit:PERCENT-PER-YR,
    unit:PPTH-PER-HR, unit:PPTH-PER-HR, unit:PetaHZ, unit:PetaHZ, unit:PlanckFrequency,
    unit:PlanckFrequency, unit:TeraHZ, unit:TeraHZ, unit:failures-in-time .

quantitykind:ParticleCurrentDensity a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "particle current density", "particle current density", "particle current density"@en-US,
    "particle current density"@en-US;
  dct:description """
  The quantity kind $\\textit{Particle Current Density}$ is a vector whose component is
   perpendicular to a surface equal to the net number of particles crossing that surface
   in the positive direction per unit area and per unit time.
  """^^qudt:LatexString,
    """
  The quantity kind $\\textit{Particle Current Density}$ is a vector whose component is
   perpendicular to a surface equal to the net number of particles crossing that surface
   in the positive direction per unit area and per unit time.
  """^^qudt:LatexString;
  qudt:hasDimensionVector dimensionvector:A0E0L-2I0M0H0T-1D0, dimensionvector:A0E0L-2I0M0H0T-1D0;
  qudt:iec61360Code "0112/2///62720#UAD132", "0112/2///62720#UAD132";
  qudt:informativeReference "https://cdd.iec.ch/cdd/iec61987/iec61987.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD132"^^xsd:anyURI,
    "https://cdd.iec.ch/cdd/iec61987/iec61987.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD132"^^xsd:anyURI;
  qudt:symbol "0173-1#Z4-BAJ388#002", "0173-1#Z4-BAJ388#002";
  qudt:plainTextDescription "Vektor, dessen Komponente senkrecht zu einer Fläche gleich der Nettoanzahl von Teilchen ist, die flächen- und zeitbezogen in positiver Richtung durch diese Fläche hindurchgehen"@de,
    "Vektor, dessen Komponente senkrecht zu einer Fläche gleich der Nettoanzahl von Teilchen ist, die flächen- und zeitbezogen in positiver Richtung durch diese Fläche hindurchgehen"@de .

quantitykind:ParticleNumberDensity a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "Particle Number Density"@en, "Particle Number Density"@en;
  rdfs:comment "Applicable units are those of quantitykind:NumberDensity", "Applicable units are those of quantitykind:NumberDensity";
  dct:description "The \"Particle Number Density\" is obtained by dividing the particle number of a system by its volume."^^qudt:LatexString,
    "The \"Particle Number Density\" is obtained by dividing the particle number of a system by its volume."^^qudt:LatexString;
  skos:broader quantitykind:NumberDensity, quantitykind:NumberDensity;
  qudt:hasDimensionVector dimensionvector:A0E0L-3I0M0H0T0D0, dimensionvector:A0E0L-3I0M0H0T0D0;
  qudt:informativeReference "http://en.wikipedia.org/wiki/Particle_number#Particle_number_density"^^xsd:anyURI,
    "http://en.wikipedia.org/wiki/Particle_number#Particle_number_density"^^xsd:anyURI;
  qudt:symbol "n", "n";
  qudt:plainTextDescription "The \"Particle Number Density\" is obtained by dividing the particle number of a system by its volume.",
    "The \"Particle Number Density\" is obtained by dividing the particle number of a system by its volume.";
  qudt:latexDefinition "$n = \\frac{N}{V}$, where $N$ is the number of particles in the 3D domain with the volume $V$."^^qudt:LatexString,
    "$n = \\frac{N}{V}$, where $N$ is the number of particles in the 3D domain with the volume $V$."^^qudt:LatexString;
  qudt:applicableUnit unit:NUM-PER-L, unit:NUM-PER-L, unit:NUM-PER-M3, unit:NUM-PER-M3,
