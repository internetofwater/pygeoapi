    skos:inScheme <http://vocabulary.odm2.org/variablename> ;
    skos:prefLabel "Carbon-14" ;
    skos:topConceptOf <http://vocabulary.odm2.org/variablename> .

variablename:carbonate a skos:Concept ;
    skos:definition "Carbonate ion (CO3-2) concentration" ;
    skos:historyNote "Originally from the CUAHSI HIS VariableNameCV.  See: http://his.cuahsi.org/mastercvreg/edit_cv11.aspx?tbl=VariableNameCV." ;
    skos:inScheme <http://vocabulary.odm2.org/variablename> ;
    skos:prefLabel "Carbonate" ;
    skos:topConceptOf <http://vocabulary.odm2.org/variablename> .

variablename:cationExchangeCapacity a skos:Concept ;
    skos:definition "Cation exchange capacity (CEC) is a measure of the total negative charges within the soil that adsorb plant nutrient cations such as calcium (Ca2+), magnesium (Mg2+) and potassium (K+). As such, the CEC is a property of a soil that describes its capacity to supply nutrient cations to the soil solution for plant uptake." ;
    skos:exactMatch "http://extension.uga.edu/publications/detail.html?number=C1040&title=Cation%20Exchange%20Capacity%20and%20Base%20Saturation" ;
    skos:inScheme <http://vocabulary.odm2.org/variablename> ;
    skos:note "Added to support Critical Zone Observatory (CZO) data use cases. " ;
    skos:prefLabel "Cation exchange capacity (CEC)" ;
    skos:topConceptOf <http://vocabulary.odm2.org/variablename> .

variablename:cellobiohydrolase a skos:Concept ;
    ns3:category "Chemistry" ;
    skos:definition "Exocellulases or cellobiohydrolases cleave two to four units from the ends of the exposed chains produced by endocellulase, resulting in tetrasaccharides or disaccharides, such as cellobiose. Exocellulases are further classified into type I, that work processively from the reducing end of the cellulose chain, and type II, that work processively from the nonreducing end." ;
    skos:exactMatch "https://en.wikipedia.org/wiki/Cellulase" ;
    skos:historyNote "Wikipedia" ;
    skos:inScheme <http://vocabulary.odm2.org/variablename> ;
    skos:prefLabel "Cellobiohydrolase" ;
    skos:topConceptOf <http://vocabulary.odm2.org/variablename> .

variablename:cerium a skos:Concept ;
    skos:definition "Cerium is a chemical element with symbol Ce and atomic number 58. Cerium is a soft, ductile and silvery-white metal that tarnishes when exposed to air, and it is soft enough to be cut with a knife." ;
    skos:exactMatch "https://en.wikipedia.org/wiki/Cerium" ;
    skos:historyNote "Wikipedia" ;
    skos:inScheme <http://vocabulary.odm2.org/variablename> ;
    skos:note "Added to support Critical Zone Observatory (CZO) data use cases. " ;
    skos:prefLabel "Cerium" ;
    skos:topConceptOf <http://vocabulary.odm2.org/variablename> .

variablename:ceriumDissolved a skos:Concept ;
    skos:definition "Dissolved Cerium (Ce). \"Dissolved \" indicates a the measurement was made on a filtered sample." ;
    skos:exactMatch "https://en.wikipedia.org/wiki/Cerium" ;
    skos:historyNote "Wikipedia" ;
    skos:inScheme <http://vocabulary.odm2.org/variablename> ;
    skos:note "Added to support Critical Zone Observatory (CZO) data use cases. " ;
    skos:prefLabel "Cerium, dissolved" ;
    skos:topConceptOf <http://vocabulary.odm2.org/variablename> .

variablename:cesium a skos:Concept ;
    skos:definition "Caesium (IUPAC spelling) or cesium (American spelling) is a chemical element with symbol Cs and atomic number 55. It is a soft, silvery-gold alkali metal with a melting point of 28.5 °C (83.3 °F), which makes it one of only five elemental metals that are liquid at or near room temperature." ;
    skos:exactMatch "https://en.wikipedia.org/wiki/Caesium" ;
    skos:historyNote "Wikipedia" ;
    skos:inScheme <http://vocabulary.odm2.org/variablename> ;
    skos:note "Added to support Critical Zone Observatory (CZO) data use cases. " ;
    skos:prefLabel "Cesium" ;
    skos:topConceptOf <http://vocabulary.odm2.org/variablename> .

