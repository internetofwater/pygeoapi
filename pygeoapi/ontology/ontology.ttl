  qudt:latexDefinition "$g\\cdot cm^{2}/s^{2}$"^^qudt:LatexString, "$g\\cdot cm^{2}/s^{2}$"^^qudt:LatexString;
  qudt:derivedUnitOfSystem <http://qudt.org/vocab/sou/CGS-GAUSS>, <http://qudt.org/vocab/sou/CGS-GAUSS>,
