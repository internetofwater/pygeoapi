unit:GRAIN a qudt:Unit, qudt:Unit;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/unit>, <http://qudt.org/vocab/unit>;
  rdfs:label "Grain"@en, "Grain"@en;
  dct:description "A grain is a unit of measurement of mass that is nominally based upon the mass of a single seed of a cereal.  The grain is the only unit of mass measure common to the three traditional English mass and weight systems; the obsolete Tower grain was, by definition, exactly  /64 of a troy grain. Since 1958, the grain or troy grain measure has been defined in terms of units of mass in the International System of Units as precisely 64.79891 milligrams. Thus, $1 gram \\approx 15.4323584 grains$.  There are precisely 7,000 grains per avoirdupois pound in the imperial and U.S. customary units, and 5,760 grains in the Troy pound."^^qudt:LatexString,
    "A grain is a unit of measurement of mass that is nominally based upon the mass of a single seed of a cereal.  The grain is the only unit of mass measure common to the three traditional English mass and weight systems; the obsolete Tower grain was, by definition, exactly  /64 of a troy grain. Since 1958, the grain or troy grain measure has been defined in terms of units of mass in the International System of Units as precisely 64.79891 milligrams. Thus, $1 gram \\approx 15.4323584 grains$.  There are precisely 7,000 grains per avoirdupois pound in the imperial and U.S. customary units, and 5,760 grains in the Troy pound."^^qudt:LatexString;
  qudt:applicableSystem <http://qudt.org/vocab/sou/IMPERIAL>, <http://qudt.org/vocab/sou/IMPERIAL>,
    <http://qudt.org/vocab/sou/USCS>, <http://qudt.org/vocab/sou/USCS>;
  qudt:conversionMultiplier 0.00006479891, 0.00006479891;
  qudt:conversionMultiplierSN 6.479891E-5, 6.479891E-5;
  qudt:dbpediaMatch "http://dbpedia.org/resource/Cereal"^^xsd:anyURI, "http://dbpedia.org/resource/Cereal"^^xsd:anyURI;
  qudt:hasDimensionVector dimensionvector:A0E0L0I0M1H0T0D0, dimensionvector:A0E0L0I0M1H0T0D0;
  qudt:hasQuantityKind quantitykind:Mass, quantitykind:Mass;
  qudt:iec61360Code "0112/2///62720#UAA523", "0112/2///62720#UAA523";
  qudt:informativeReference "http://en.wikipedia.org/wiki/Cereal?oldid=495222949"^^xsd:anyURI,
    "http://en.wikipedia.org/wiki/Cereal?oldid=495222949"^^xsd:anyURI, "https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAA523"^^xsd:anyURI,
    "https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAA523"^^xsd:anyURI;
  qudt:omUnit <http://www.ontology-of-units-of-measure.org/resource/om-2/grain>, <http://www.ontology-of-units-of-measure.org/resource/om-2/grain>;
