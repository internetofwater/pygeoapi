unit:MicroM-PER-MIN a <http://qudt.org/schema/qudt/Unit>, <http://qudt.org/schema/qudt/DerivedUnit>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/unit>;
  rdfs:label "Micrometer per Minute"@en-US, "micrometre per minute"@en;
  dct:description "Micrometre per minute is a derived unit of both speed (scalar) and velocity (vector quantity which specifies both magnitude and a specific direction), defined by distance in micronmeters divided by time in minutes."^^rdf:HTML;
  skos:altLabel "Micron per Minute"@en, "micron per minute"@en;
  <http://qudt.org/schema/qudt/applicableSystem> <http://qudt.org/vocab/sou/CGS-EMU>,
    <http://qudt.org/vocab/sou/CGS-GAUSS>, <http://qudt.org/vocab/sou/SI>, <http://qudt.org/vocab/sou/CGS>;
  <http://qudt.org/schema/qudt/conversionMultiplier> 0.0000000166666667;
  <http://qudt.org/schema/qudt/conversionMultiplierSN> 1.66666667E-8;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L1I0M0H0T-1D0>;
  <http://qudt.org/schema/qudt/hasQuantityKind> <http://qudt.org/vocab/quantitykind/Speed>,
    <http://qudt.org/vocab/quantitykind/LinearVelocity>, <http://qudt.org/vocab/quantitykind/Velocity>,
    <http://qudt.org/vocab/quantitykind/ElectromagneticWavePhaseSpeed>;
  <http://qudt.org/schema/qudt/symbol> "μm/min";
  <http://qudt.org/schema/qudt/ucumCode> "um.min-1"^^<http://qudt.org/schema/qudt/UCUMcs>,
    "um/min"^^<http://qudt.org/schema/qudt/UCUMcs>;
  <http://qudt.org/schema/qudt/expression> "$\\frac{\\mu m}{min}$"^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/derivedUnitOfSystem> <http://qudt.org/vocab/sou/SI> .

