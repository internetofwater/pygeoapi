<http://qudt.org/vocab/quantitykind/ModulusOfElasticity> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Modulus of Elasticity"@en;
  rdfs:comment "Applicable units are those of quantitykind:ModulusOfElasticity";
  dct:description "The Modulus of Elasticity is the mathematical description of an object or substance's tendency to be deformed elastically (that is, non-permanently) when a force is applied to it."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L-1I0M1H0T-2D0>;
  <http://qudt.org/schema/qudt/informativeReference> "http://en.wikipedia.org/wiki/Elastic_modulus"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/symbol> "E";
  <http://qudt.org/schema/qudt/isoNormativeReference> "http://www.iso.org/iso/catalogue_detail?csnumber=31889"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/plainTextDescription> "The Modulus of Elasticity is the mathematical description of an object or substance's tendency to be deformed elastically (that is, non-permanently) when a force is applied to it.";
  <http://qudt.org/schema/qudt/latexDefinition> "$E = \\frac{\\sigma}{\\varepsilon}$, where $\\sigma$ is the normal stress and $\\varepsilon$ is the linear strain."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/applicableUnit> unit:DecaPA, unit:GigaPA, unit:HectoPA,
    unit:KIP_F-PER-IN2, unit:PA, unit:KiloLB_F-PER-IN2, unit:KiloPA, unit:LB_F-PER-IN2,
    unit:PSI, unit:MegaPA, unit:MegaPSI, unit:MicroPA, unit:MilliPA, unit:PicoPA .

<http://qudt.org/vocab/quantitykind/ShearModulus> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Shear Modulus"@en;
  rdfs:comment "Applicable units are those of quantitykind:ShearModulus";
  dct:description "The Shear Modulus or modulus of rigidity, denoted by $G$, or sometimes $S$ or $\\mu$, is defined as the ratio of shear stress to the shear strain."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L-1I0M1H0T-2D0>;
  <http://qudt.org/schema/qudt/informativeReference> "http://en.wikipedia.org/wiki/Shear_modulus"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/symbol> "G";
  <http://qudt.org/schema/qudt/isoNormativeReference> "http://www.iso.org/iso/catalogue_detail?csnumber=31889"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/latexDefinition> "$G = \\frac{\\tau}{\\gamma}$, where $\\tau$ is the shear stress and $\\gamma$ is the shear strain."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/applicableUnit> unit:DecaPA, unit:GigaPA, unit:HectoPA,
    unit:KIP_F-PER-IN2, unit:PA, unit:KiloLB_F-PER-IN2, unit:KiloPA, unit:LB_F-PER-IN2,
    unit:PSI, unit:MegaPA, unit:MegaPSI, unit:MicroPA, unit:MilliPA, unit:PicoPA .

unit:DecaPOISE a <http://qudt.org/schema/qudt/Unit>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/unit>;
