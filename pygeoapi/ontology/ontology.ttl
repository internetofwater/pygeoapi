  <http://qudt.org/schema/qudt/applicableUnit> unit:PER-SEC-SR .

unit:PER-SEC-SR-M2 a <http://qudt.org/schema/qudt/Unit>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/unit>;
  rdfs:label "reciprocal second per steradian square metre";
