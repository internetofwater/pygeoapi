<http://qudt.org/vocab/quantitykind/Permeance> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:seeAlso <http://qudt.org/vocab/quantitykind/Reluctance>;
  rdfs:label "Permeance"@en;
  rdfs:comment "Applicable units are those of quantitykind:Permeance";
  dct:description "\"Permeance\" is the inverse of reluctance. Permeance is a measure of the quantity of flux for a number of current-turns in magnetic circuit. A magnetic circuit almost acts as though the flux is \"conducted\", therefore permeance is larger for large cross sections of a material and smaller for longer lengths. This concept is analogous to electrical conductance in the electric circuit."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E-2L2I0M1H0T-2D0>;
  <http://qudt.org/schema/qudt/iec61360Code> "0112/2///62720#UAD135";
  <http://qudt.org/schema/qudt/informativeReference> "http://www.iso.org/iso/home/store/catalogue_tc/catalogue_detail.htm?csnumber=31891"^^xsd:anyURI,
    "http://en.wikipedia.org/wiki/Permeance"^^xsd:anyURI, "https://cdd.iec.ch/cdd/iec61987/iec61987.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD135"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/plainTextDescription> "\"Permeance\" is the inverse of reluctance. Permeance is a measure of the quantity of flux for a number of current-turns in magnetic circuit. A magnetic circuit almost acts as though the flux is \"conducted\", therefore permeance is larger for large cross sections of a material and smaller for longer lengths. This concept is analogous to electrical conductance in the electric circuit.";
  <http://qudt.org/schema/qudt/latexSymbol> "$\\Lambda$"^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/latexDefinition> "$\\Lambda = \\frac{1}{R_m}$, where $R_m$ is reluctance."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/applicableUnit> unit:NanoH .

unit:NanoH-PER-M a <http://qudt.org/schema/qudt/Unit>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/unit>;
  rdfs:label "Nanohenry per Meter"@en-US, "Nanohenry per Metre"@en;
