quantitykind:EnergyPerElectricCharge a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "Energy per electric charge"@en, "Energy per electric charge"@en;
  rdfs:comment "Applicable units are those of quantitykind:EnergyPerElectricCharge",
    "Applicable units are those of quantitykind:EnergyPerElectricCharge";
  dct:description "Voltage is a representation of the electric potential energy per unit charge. If a unit of electrical charge were placed in a location, the voltage indicates the potential energy of it at that point. In other words, it is a measurement of the energy contained within an electric field, or an electric circuit, at a given point. Voltage is a scalar quantity. The SI unit of voltage is the volt, such that $1 volt = 1 joule/coulomb$."^^qudt:LatexString,
    "Voltage is a representation of the electric potential energy per unit charge. If a unit of electrical charge were placed in a location, the voltage indicates the potential energy of it at that point. In other words, it is a measurement of the energy contained within an electric field, or an electric circuit, at a given point. Voltage is a scalar quantity. The SI unit of voltage is the volt, such that $1 volt = 1 joule/coulomb$."^^qudt:LatexString;
  qudt:hasDimensionVector dimensionvector:A0E-1L2I0M1H0T-3D0, dimensionvector:A0E-1L2I0M1H0T-3D0;
  qudt:informativeReference "http://physics.about.com/od/glossary/g/voltage.htm"^^xsd:anyURI,
    "http://physics.about.com/od/glossary/g/voltage.htm"^^xsd:anyURI;
  qudt:symbol "V", "V";
  qudt:exactMatch quantitykind:ElectricPotential, quantitykind:ElectricPotential, quantitykind:ElectricPotentialDifference,
    quantitykind:ElectricPotentialDifference, quantitykind:Voltage, quantitykind:Voltage;
  qudt:applicableUnit unit:FemtoV, unit:FemtoV, unit:GigaV, unit:GigaV, unit:KiloV,
    unit:KiloV, unit:MegaV, unit:MegaV, unit:MicroV, unit:MicroV, unit:MilliV, unit:MilliV,
    unit:NanoV, unit:NanoV, unit:PicoV, unit:PicoV, unit:PlanckVolt, unit:PlanckVolt,
    unit:TeraV, unit:TeraV, unit:V, unit:V, unit:V_Ab, unit:V_Ab, unit:V_Stat, unit:V_Stat,
    unit:ExaV, unit:PetaV .

quantitykind:Voltage a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "Voltage"@en, "Voltage"@en;
  rdfs:comment "Applicable units are those of quantitykind:Voltage", "Applicable units are those of quantitykind:Voltage";
  dct:description """$\\textit{Voltage}$, also referred to as $\\textit{Electric Tension}$, is the difference between electrical potentials of two points. For an electric field within a medium, $U_{ab} = - \\int_{r_a}^{r_b} E . {dr}$, where $E$ is electric field strength.
For an irrotational electric field, the voltage is independent of the path between the two points $a$ and $b$."""^^qudt:LatexString,
    """$\\textit{Voltage}$, also referred to as $\\textit{Electric Tension}$, is the difference between electrical potentials of two points. For an electric field within a medium, $U_{ab} = - \\int_{r_a}^{r_b} E . {dr}$, where $E$ is electric field strength.
For an irrotational electric field, the voltage is independent of the path between the two points $a$ and $b$."""^^qudt:LatexString;
  qudt:hasDimensionVector dimensionvector:A0E-1L2I0M1H0T-3D0, dimensionvector:A0E-1L2I0M1H0T-3D0;
  qudt:iec61360Code "0112/2///62720#UAD237", "0112/2///62720#UAD237";
  qudt:informativeReference "http://www.iso.org/iso/home/store/catalogue_tc/catalogue_detail.htm?csnumber=31891"^^xsd:anyURI,
    "http://www.iso.org/iso/home/store/catalogue_tc/catalogue_detail.htm?csnumber=31891"^^xsd:anyURI,
    "https://cdd.iec.ch/cdd/iec61987/iec61987.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD237"^^xsd:anyURI,
    "https://cdd.iec.ch/cdd/iec61987/iec61987.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD237"^^xsd:anyURI;
  qudt:symbol "U", "U";
  qudt:exactMatch quantitykind:ElectricPotential, quantitykind:ElectricPotential, quantitykind:ElectricPotentialDifference,
    quantitykind:ElectricPotentialDifference, quantitykind:EnergyPerElectricCharge, quantitykind:EnergyPerElectricCharge;
  qudt:latexSymbol "$U_{ab}$"^^qudt:LatexString, "$U_{ab}$"^^qudt:LatexString;
  qudt:latexDefinition "$U_{ab} = V_a - V_b$, where $V_a$ and $V_b$ are electric potentials at points $a$ and $b$, respectively."^^qudt:LatexString,
    "$U_{ab} = V_a - V_b$, where $V_a$ and $V_b$ are electric potentials at points $a$ and $b$, respectively."^^qudt:LatexString;
