  <http://qudt.org/schema/qudt/symbol> "perm (0 °C)";
  <http://qudt.org/schema/qudt/uneceCommonCode> "P91";
  <http://qudt.org/schema/qudt/exactMatch> unit:PERM_Metric_0DEG_C .

