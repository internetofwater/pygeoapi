quantitykind:EinsteinTransitionProbability a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "Einstein Transition Probability"@en, "Einstein Transition Probability"@en;
  rdfs:comment "Applicable units are those of quantitykind:EinsteinTransitionProbability",
    "Applicable units are those of quantitykind:EinsteinTransitionProbability";
  dct:description "Given two atomic states of energy $E_j$ and $E_k$.  Let $E_j > E_k$.  Assume the atom is bathed in radiation of energy density $u(w)$.  Transitions between these states can take place in three different ways. Spontaneous, induced/stimulated emission, and induced absorption. $A_jk$ represents the Einstein transition probability for spontaneous emission."^^qudt:LatexString,
    "Given two atomic states of energy $E_j$ and $E_k$.  Let $E_j > E_k$.  Assume the atom is bathed in radiation of energy density $u(w)$.  Transitions between these states can take place in three different ways. Spontaneous, induced/stimulated emission, and induced absorption. $A_jk$ represents the Einstein transition probability for spontaneous emission."^^qudt:LatexString;
  qudt:hasDimensionVector dimensionvector:A0E0L0I0M0H0T0D1, dimensionvector:A0E0L0I0M0H0T0D1;
  qudt:informativeReference "http://electron6.phys.utk.edu/qm2/modules/m10/einstein.htm"^^xsd:anyURI,
    "http://electron6.phys.utk.edu/qm2/modules/m10/einstein.htm"^^xsd:anyURI;
  qudt:symbol "A_jkN_j", "A_jkN_j";
  qudt:latexDefinition "$\\frac{-dN_j}{dt} = A_jkN_j$, where $-dN_j$ is the number of molecules spontaneously leaving the state j for the state k during a time interval of duration $dt$, $N_j$ is the number of molecules in the state j, and $E_j > E_k$."^^qudt:LatexString,
    "$\\frac{-dN_j}{dt} = A_jkN_j$, where $-dN_j$ is the number of molecules spontaneously leaving the state j for the state k during a time interval of duration $dt$, $N_j$ is the number of molecules in the state j, and $E_j > E_k$."^^qudt:LatexString;
  qudt:applicableUnit unit:UNITLESS, unit:UNITLESS .

quantitykind:ElectricSusceptibility a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:seeAlso quantitykind:ElectricPolarization, quantitykind:ElectricPolarization,
    quantitykind:ElectricFieldStrength, quantitykind:ElectricFieldStrength;
  rdfs:label "electric susceptibility"@en, "electric susceptibility"@en, "elektrische Suszeptibilität"@de,
    "elektrische Suszeptibilität"@de, "podatność elektryczna"@pl, "podatność elektryczna"@pl,
    "susceptibilidad eléctrica"@es, "susceptibilidad eléctrica"@es, "susceptibilidade eléctrica"@pt,
    "susceptibilidade eléctrica"@pt, "susceptibilité électrique"@fr, "susceptibilité électrique"@fr,
    "suscettività elettrica"@it, "suscettività elettrica"@it, "электрическая восприимчивость"@ru,
    "электрическая восприимчивость"@ru, "المتأثرية الكهربائية، سرعة التأثر الكهربائية"@ar,
    "المتأثرية الكهربائية، سرعة التأثر الكهربائية"@ar, "電気感受率"@ja, "電気感受率"@ja;
  rdfs:comment "Applicable units are those of quantitykind:ElectricSusceptibility",
    "Applicable units are those of quantitykind:ElectricSusceptibility";
  dct:description "\"Electric Susceptibility\" is the ratio of electric polarization to electric field strength, normalized to the electric constant. The definition applies to an isotropic medium. For an anisotropic medium, electric susceptibility is a second order tensor."^^qudt:LatexString,
    "\"Electric Susceptibility\" is the ratio of electric polarization to electric field strength, normalized to the electric constant. The definition applies to an isotropic medium. For an anisotropic medium, electric susceptibility is a second order tensor."^^qudt:LatexString;
  skos:altLabel "susceptywność elektryczna"@pl, "susceptywność elektryczna"@pl, "диэлектрическая восприимчивость"@ru,
    "диэлектрическая восприимчивость"@ru;
  qudt:dbpediaMatch "http://dbpedia.org/resource/Permittivity"^^xsd:anyURI, "http://dbpedia.org/resource/Permittivity"^^xsd:anyURI;
  qudt:hasDimensionVector dimensionvector:A0E0L0I0M0H0T0D1, dimensionvector:A0E0L0I0M0H0T0D1;
  qudt:informativeReference "http://www.iso.org/iso/home/store/catalogue_tc/catalogue_detail.htm?csnumber=31891"^^xsd:anyURI,
    "http://www.iso.org/iso/home/store/catalogue_tc/catalogue_detail.htm?csnumber=31891"^^xsd:anyURI;
  qudt:expression "$e-susceptibility$"^^qudt:LatexString, "$e-susceptibility$"^^qudt:LatexString;
  qudt:plainTextDescription "\"Electric Susceptibility\" is the ratio of electric polarization to electric field strength, normalized to the electric constant. The definition applies to an isotropic medium. For an anisotropic medium, electric susceptibility is a second order tensor.",
    "\"Electric Susceptibility\" is the ratio of electric polarization to electric field strength, normalized to the electric constant. The definition applies to an isotropic medium. For an anisotropic medium, electric susceptibility is a second order tensor.";
  qudt:latexSymbol "$\\chi$"^^qudt:LatexString, "$\\chi$"^^qudt:LatexString;
  qudt:latexDefinition "$\\chi = \\frac{P}{(\\epsilon_0 E)}$, where $P$ is electric polorization, $\\epsilon_0$ is the electric constant, and $E$ is electric field strength."^^qudt:LatexString,
    "$\\chi = \\frac{P}{(\\epsilon_0 E)}$, where $P$ is electric polorization, $\\epsilon_0$ is the electric constant, and $E$ is electric field strength."^^qudt:LatexString;
  qudt:applicableUnit unit:UNITLESS, unit:UNITLESS .

quantitykind:Emissivity a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "Emissivity"@en, "Emissivity"@en;
  rdfs:comment "Applicable units are those of quantitykind:Emissivity", "Applicable units are those of quantitykind:Emissivity";
  dct:description "Emissivity of a material (usually written $\\varepsilon$ or e) is the relative ability of its surface to emit energy by radiation."^^qudt:LatexString,
    "Emissivity of a material (usually written $\\varepsilon$ or e) is the relative ability of its surface to emit energy by radiation."^^qudt:LatexString;
  qudt:hasDimensionVector dimensionvector:A0E0L0I0M0H0T0D1, dimensionvector:A0E0L0I0M0H0T0D1;
  qudt:informativeReference "http://en.wikipedia.org/wiki/Emissivity"^^xsd:anyURI, "http://en.wikipedia.org/wiki/Emissivity"^^xsd:anyURI;
  qudt:latexSymbol "$\\varepsilon$"^^qudt:LatexString, "$\\varepsilon$"^^qudt:LatexString;
  qudt:latexDefinition "$\\varepsilon = \\frac{M}{M_b}$, where $M$ is the radiant exitance of a thermal radiator and $M_b$ is the radiant exitance of a blackbody at the same temperature."^^qudt:LatexString,
    "$\\varepsilon = \\frac{M}{M_b}$, where $M$ is the radiant exitance of a thermal radiator and $M_b$ is the radiant exitance of a blackbody at the same temperature."^^qudt:LatexString;
  qudt:applicableUnit unit:PERCENT, unit:UNITLESS, unit:UNITLESS .

quantitykind:EquilibriumConstant a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:seeAlso quantitykind:EquilibriumConstantOnConcentrationBasis, quantitykind:EquilibriumConstantOnConcentrationBasis,
    quantitykind:EquilibriumConstantOnPressureBasis, quantitykind:EquilibriumConstantOnPressureBasis;
  rdfs:label "Equilibrium Constant"@en, "Equilibrium Constant"@en;
  rdfs:comment "Applicable units are those of quantitykind:EquilibriumConstant", "Applicable units are those of quantitykind:EquilibriumConstant";
  dct:description "The \"Equlilbrium Constant\", also known as the thermodynamic equilibrium constant, is an expression that gives us a ratio of the products and reactants of a reaction at equilibrium with respect to a specific unit."^^qudt:LatexString,
    "The \"Equlilbrium Constant\", also known as the thermodynamic equilibrium constant, is an expression that gives us a ratio of the products and reactants of a reaction at equilibrium with respect to a specific unit."^^qudt:LatexString;
  qudt:hasDimensionVector dimensionvector:A0E0L0I0M0H0T0D1, dimensionvector:A0E0L0I0M0H0T0D1;
  qudt:informativeReference "http://en.wikipedia.org/wiki/Equilibrium_constant"^^xsd:anyURI,
    "http://en.wikipedia.org/wiki/Equilibrium_constant"^^xsd:anyURI;
  qudt:isoNormativeReference "http://www.iso.org/iso/catalogue_detail?csnumber=31894"^^xsd:anyURI,
    "http://www.iso.org/iso/catalogue_detail?csnumber=31894"^^xsd:anyURI;
  qudt:plainTextDescription "The \"Equlilbrium Constant\", also known as the thermodynamic equilibrium constant, is an expression that gives us a ratio of the products and reactants of a reaction at equilibrium with respect to a specific unit.",
    "The \"Equlilbrium Constant\", also known as the thermodynamic equilibrium constant, is an expression that gives us a ratio of the products and reactants of a reaction at equilibrium with respect to a specific unit.";
  qudt:latexSymbol "$K^\\Theta$"^^qudt:LatexString, "$K^\\Theta$"^^qudt:LatexString;
  qudt:latexDefinition "$K^\\Theta = \\Pi_B(\\lambda_B^\\Theta)^{-\\nu_B}$, where $\\Pi_B$ denotes the product for all substances $B$, $\\lambda_B^\\Theta$ is the standard absolute activity of substance $B$, and $\\nu_B$ is the stoichiometric number of the substance $B$."^^qudt:LatexString,
    "$K^\\Theta = \\Pi_B(\\lambda_B^\\Theta)^{-\\nu_B}$, where $\\Pi_B$ denotes the product for all substances $B$, $\\lambda_B^\\Theta$ is the standard absolute activity of substance $B$, and $\\nu_B$ is the stoichiometric number of the substance $B$."^^qudt:LatexString;
  qudt:applicableUnit unit:UNITLESS, unit:UNITLESS .

quantitykind:FastFissionFactor a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "Fast Fission Factor"@en, "Fast Fission Factor"@en;
  rdfs:comment "Applicable units are those of quantitykind:FastFissionFactor", "Applicable units are those of quantitykind:FastFissionFactor";
  dct:description "\"Fast Fission Factor\" in an infinite medium, is the ratio of the mean number of neutrons produced by fission due to neutrons of all energies to the mean number of neutrons produced by fissions due to thermal neutrons only."^^qudt:LatexString,
    "\"Fast Fission Factor\" in an infinite medium, is the ratio of the mean number of neutrons produced by fission due to neutrons of all energies to the mean number of neutrons produced by fissions due to thermal neutrons only."^^qudt:LatexString;
  qudt:hasDimensionVector dimensionvector:A0E0L0I0M0H0T0D1, dimensionvector:A0E0L0I0M0H0T0D1;
  qudt:informativeReference "http://en.wikipedia.org/wiki/Four_factor_formula"^^xsd:anyURI,
    "http://en.wikipedia.org/wiki/Four_factor_formula"^^xsd:anyURI;
  qudt:isoNormativeReference "http://www.iso.org/iso/catalogue_detail?csnumber=31895"^^xsd:anyURI,
    "http://www.iso.org/iso/catalogue_detail?csnumber=31895"^^xsd:anyURI;
  qudt:plainTextDescription "\"Fast Fission Factor\" in an infinite medium, is the ratio of the mean number of neutrons produced by fission due to neutrons of all energies to the mean number of neutrons produced by fissions due to thermal neutrons only.",
    "\"Fast Fission Factor\" in an infinite medium, is the ratio of the mean number of neutrons produced by fission due to neutrons of all energies to the mean number of neutrons produced by fissions due to thermal neutrons only.";
  qudt:latexSymbol "$\\varphi$"^^qudt:LatexString, "$\\varphi$"^^qudt:LatexString;
  qudt:applicableUnit unit:UNITLESS, unit:UNITLESS .

quantitykind:GFactorOfNucleus a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "g-Factor of Nucleus"@en, "g-Factor of Nucleus"@en;
  rdfs:comment "Applicable units are those of quantitykind:GFactorOfNucleus", "Applicable units are those of quantitykind:GFactorOfNucleus";
  dct:description "The \"g-Factor of Nucleus\" is associated with the spin and magnetic moments of protons, neutrons, and many nuclei."^^qudt:LatexString,
    "The \"g-Factor of Nucleus\" is associated with the spin and magnetic moments of protons, neutrons, and many nuclei."^^qudt:LatexString;
  qudt:hasDimensionVector dimensionvector:A0E0L0I0M0H0T0D1, dimensionvector:A0E0L0I0M0H0T0D1;
  qudt:informativeReference "http://en.wikipedia.org/wiki/Landé_g-factor"^^xsd:anyURI,
    "http://en.wikipedia.org/wiki/Landé_g-factor"^^xsd:anyURI;
  qudt:symbol "g", "g";
  qudt:isoNormativeReference "http://www.iso.org/iso/catalogue_detail?csnumber=31895"^^xsd:anyURI,
    "http://www.iso.org/iso/catalogue_detail?csnumber=31895"^^xsd:anyURI;
  qudt:plainTextDescription "The \"g-Factor of Nucleus\" is associated with the spin and magnetic moments of protons, neutrons, and many nuclei.",
    "The \"g-Factor of Nucleus\" is associated with the spin and magnetic moments of protons, neutrons, and many nuclei.";
  qudt:latexDefinition "$g = \\frac{\\mu}{I\\mu_B}$, where $\\mu$ is the magnitude of magnetic dipole moment, $I$ is the nuclear angular momentum quantum number, and $\\mu_B$ is the Bohr magneton."^^qudt:LatexString,
    "$g = \\frac{\\mu}{I\\mu_B}$, where $\\mu$ is the magnitude of magnetic dipole moment, $I$ is the nuclear angular momentum quantum number, and $\\mu_B$ is the Bohr magneton."^^qudt:LatexString;
  qudt:applicableUnit unit:UNITLESS, unit:UNITLESS .

quantitykind:GeneralizedCoordinate a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "Generalized Coordinate"@en, "Generalized Coordinate"@en;
  rdfs:comment "Applicable units are those of quantitykind:GeneralizedCoordinate", "Applicable units are those of quantitykind:GeneralizedCoordinate";
  dct:description "Generalized Coordinates refers to the parameters that describe the configuration of the system relative to some reference configuration. These parameters must uniquely define the configuration of the system relative to the reference configuration."^^qudt:LatexString,
    "Generalized Coordinates refers to the parameters that describe the configuration of the system relative to some reference configuration. These parameters must uniquely define the configuration of the system relative to the reference configuration."^^qudt:LatexString;
  qudt:hasDimensionVector dimensionvector:A0E0L0I0M0H0T0D1, dimensionvector:A0E0L0I0M0H0T0D1;
  qudt:informativeReference "http://en.wikipedia.org/wiki/Generalized_coordinates"^^xsd:anyURI,
    "http://en.wikipedia.org/wiki/Generalized_coordinates"^^xsd:anyURI;
  qudt:symbol "q_i", "q_i";
  qudt:isoNormativeReference "http://www.iso.org/iso/catalogue_detail?csnumber=31889"^^xsd:anyURI,
    "http://www.iso.org/iso/catalogue_detail?csnumber=31889"^^xsd:anyURI;
  qudt:plainTextDescription "Generalized Coordinates refers to the parameters that describe the configuration of the system relative to some reference configuration. These parameters must uniquely define the configuration of the system relative to the reference configuration.",
    "Generalized Coordinates refers to the parameters that describe the configuration of the system relative to some reference configuration. These parameters must uniquely define the configuration of the system relative to the reference configuration.";
  qudt:latexDefinition "$q_i$, where $q_i$ is one of the coordinates that is used to describe the position of the system under consideration, and $N$ is the lowest number of coordinates necessary to fully define the position of the system."^^qudt:LatexString,
    "$q_i$, where $q_i$ is one of the coordinates that is used to describe the position of the system under consideration, and $N$ is the lowest number of coordinates necessary to fully define the position of the system."^^qudt:LatexString;
  qudt:applicableUnit unit:UNITLESS, unit:UNITLESS .

quantitykind:GeneralizedForce a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "Generalized Force"@en, "Generalized Force"@en;
  rdfs:comment "Applicable units are those of quantitykind:GeneralizedForce", "Applicable units are those of quantitykind:GeneralizedForce";
  dct:description "Generalized Forces find use in Lagrangian mechanics, where they play a role conjugate to generalized coordinates."^^qudt:LatexString,
    "Generalized Forces find use in Lagrangian mechanics, where they play a role conjugate to generalized coordinates."^^qudt:LatexString;
  qudt:hasDimensionVector dimensionvector:A0E0L0I0M0H0T0D1, dimensionvector:A0E0L0I0M0H0T0D1;
  qudt:informativeReference "http://en.wikipedia.org/wiki/Generalized_forces"^^xsd:anyURI,
    "http://en.wikipedia.org/wiki/Generalized_forces"^^xsd:anyURI;
  qudt:symbol "Q_i", "Q_i";
  qudt:isoNormativeReference "http://www.iso.org/iso/catalogue_detail?csnumber=31889"^^xsd:anyURI,
    "http://www.iso.org/iso/catalogue_detail?csnumber=31889"^^xsd:anyURI;
  qudt:plainTextDescription "Generalized Forces find use in Lagrangian mechanics, where they play a role conjugate to generalized coordinates.",
    "Generalized Forces find use in Lagrangian mechanics, where they play a role conjugate to generalized coordinates.";
  qudt:latexDefinition "$\\delta A = \\sum Q_i\\delta q_i$, where $A$ is work and $q_i$ is a generalized coordinate."^^qudt:LatexString,
    "$\\delta A = \\sum Q_i\\delta q_i$, where $A$ is work and $q_i$ is a generalized coordinate."^^qudt:LatexString;
  qudt:applicableUnit unit:UNITLESS, unit:UNITLESS .

quantitykind:GeneralizedMomentum a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "Generalized Force"@en, "Generalized Force"@en;
  rdfs:comment "Applicable units are those of quantitykind:GeneralizedMomentum", "Applicable units are those of quantitykind:GeneralizedMomentum";
  dct:description "Generalized Momentum, also known as the canonical or conjugate momentum, extends the concepts of both linear momentum and angular momentum. To distinguish it from generalized momentum, the product of mass and velocity is also referred to as mechanical, kinetic or kinematic momentum."^^qudt:LatexString,
    "Generalized Momentum, also known as the canonical or conjugate momentum, extends the concepts of both linear momentum and angular momentum. To distinguish it from generalized momentum, the product of mass and velocity is also referred to as mechanical, kinetic or kinematic momentum."^^qudt:LatexString;
  qudt:hasDimensionVector dimensionvector:A0E0L0I0M0H0T0D1, dimensionvector:A0E0L0I0M0H0T0D1;
  qudt:informativeReference "http://en.wikipedia.org/wiki/Momentum"^^xsd:anyURI, "http://en.wikipedia.org/wiki/Momentum"^^xsd:anyURI;
  qudt:symbol "p_i", "p_i";
  qudt:isoNormativeReference "http://www.iso.org/iso/catalogue_detail?csnumber=31889"^^xsd:anyURI,
    "http://www.iso.org/iso/catalogue_detail?csnumber=31889"^^xsd:anyURI;
  qudt:plainTextDescription "Generalized Momentum, also known as the canonical or conjugate momentum, extends the concepts of both linear momentum and angular momentum. To distinguish it from generalized momentum, the product of mass and velocity is also referred to as mechanical, kinetic or kinematic momentum.",
    "Generalized Momentum, also known as the canonical or conjugate momentum, extends the concepts of both linear momentum and angular momentum. To distinguish it from generalized momentum, the product of mass and velocity is also referred to as mechanical, kinetic or kinematic momentum.";
  qudt:latexDefinition "$p_i = \\frac{\\partial L}{\\partial \\dot{q_i}}$, where $L$ is the Langrange function and $\\dot{q_i}$ is a generalized velocity."^^qudt:LatexString,
    "$p_i = \\frac{\\partial L}{\\partial \\dot{q_i}}$, where $L$ is the Langrange function and $\\dot{q_i}$ is a generalized velocity."^^qudt:LatexString;
  qudt:applicableUnit unit:UNITLESS, unit:UNITLESS .

quantitykind:GeneralizedVelocity a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "Generalized Velocity"@en, "Generalized Velocity"@en;
  rdfs:comment "Applicable units are those of quantitykind:GeneralizedVelocity", "Applicable units are those of quantitykind:GeneralizedVelocity";
  dct:description "Generalized Velocities are the time derivatives of the generalized coordinates of the system."^^qudt:LatexString,
    "Generalized Velocities are the time derivatives of the generalized coordinates of the system."^^qudt:LatexString;
  qudt:hasDimensionVector dimensionvector:A0E0L0I0M0H0T0D1, dimensionvector:A0E0L0I0M0H0T0D1;
  qudt:informativeReference "http://en.wikipedia.org/wiki/Generalized_coordinates"^^xsd:anyURI,
    "http://en.wikipedia.org/wiki/Generalized_coordinates"^^xsd:anyURI;
  qudt:isoNormativeReference "http://www.iso.org/iso/catalogue_detail?csnumber=31889"^^xsd:anyURI,
    "http://www.iso.org/iso/catalogue_detail?csnumber=31889"^^xsd:anyURI;
  qudt:plainTextDescription "Generalized Velocities are the time derivatives of the generalized coordinates of the system.",
    "Generalized Velocities are the time derivatives of the generalized coordinates of the system.";
  qudt:latexSymbol "$\\dot{q_i}$"^^qudt:LatexString, "$\\dot{q_i}$"^^qudt:LatexString;
  qudt:latexDefinition "$\\dot{q_i} = \\frac{dq_i}{dt}$, where $q_i$ is the generalized coordinate and $t$ is time."^^qudt:LatexString,
    "$\\dot{q_i} = \\frac{dq_i}{dt}$, where $q_i$ is the generalized coordinate and $t$ is time."^^qudt:LatexString;
  qudt:applicableUnit unit:UNITLESS, unit:UNITLESS .

quantitykind:GruneisenParameter a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "Gruneisen Parameter"@en, "Gruneisen Parameter"@en;
  rdfs:comment "Applicable units are those of quantitykind:GruneisenParameter", "Applicable units are those of quantitykind:GruneisenParameter";
  dct:description "\"Gruneisen Parameter\" named after Eduard Grüneisen, describes the effect that changing the volume of a crystal lattice has on its vibrational properties, and, as a consequence, the effect that changing temperature has on the size or dynamics of the lattice."^^qudt:LatexString,
    "\"Gruneisen Parameter\" named after Eduard Grüneisen, describes the effect that changing the volume of a crystal lattice has on its vibrational properties, and, as a consequence, the effect that changing temperature has on the size or dynamics of the lattice."^^qudt:LatexString;
  qudt:hasDimensionVector dimensionvector:A0E0L0I0M0H0T0D1, dimensionvector:A0E0L0I0M0H0T0D1;
  qudt:informativeReference "http://en.wikipedia.org/wiki/Grüneisen_parameter"^^xsd:anyURI,
    "http://en.wikipedia.org/wiki/Grüneisen_parameter"^^xsd:anyURI;
  qudt:isoNormativeReference "http://www.iso.org/iso/catalogue_detail?csnumber=31897"^^xsd:anyURI,
    "http://www.iso.org/iso/catalogue_detail?csnumber=31897"^^xsd:anyURI;
  qudt:plainTextDescription "\"Gruneisen Parameter\" named after Eduard Grüneisen, describes the effect that changing the volume of a crystal lattice has on its vibrational properties, and, as a consequence, the effect that changing temperature has on the size or dynamics of the lattice.",
    "\"Gruneisen Parameter\" named after Eduard Grüneisen, describes the effect that changing the volume of a crystal lattice has on its vibrational properties, and, as a consequence, the effect that changing temperature has on the size or dynamics of the lattice.";
  qudt:latexSymbol "$\\gamma$"^^qudt:LatexString, "$\\gamma$"^^qudt:LatexString;
  qudt:latexDefinition "$\\gamma = \\frac{\\alpha_V}{x_T c_V\\rho}$, where $\\alpha_V$ is the cubic expansion coefficient, $x_T$ is isothermal compressibility, $c_V$ is specific heat capacity at constant volume, and $\\rho$ is mass density."^^qudt:LatexString,
    "$\\gamma = \\frac{\\alpha_V}{x_T c_V\\rho}$, where $\\alpha_V$ is the cubic expansion coefficient, $x_T$ is isothermal compressibility, $c_V$ is specific heat capacity at constant volume, and $\\rho$ is mass density."^^qudt:LatexString;
  qudt:applicableUnit unit:UNITLESS, unit:UNITLESS .

quantitykind:InternalConversionFactor a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "InternalConversionFactor"@en, "InternalConversionFactor"@en;
  rdfs:comment "Applicable units are those of quantitykind:InternalConversionFactor",
    "Applicable units are those of quantitykind:InternalConversionFactor";
  dct:description "The \"InternalConversionFactor\" describes the rate of internal conversion. It is the ratio of the number of internal conversion electrons to the number of gamma quanta emitted by the radioactive atom in a given transition."^^qudt:LatexString,
    "The \"InternalConversionFactor\" describes the rate of internal conversion. It is the ratio of the number of internal conversion electrons to the number of gamma quanta emitted by the radioactive atom in a given transition."^^qudt:LatexString;
  qudt:hasDimensionVector dimensionvector:A0E0L0I0M0H0T0D1, dimensionvector:A0E0L0I0M0H0T0D1;
  qudt:informativeReference "http://en.wikipedia.org/wiki/Internal_conversion_coefficient"^^xsd:anyURI,
    "http://en.wikipedia.org/wiki/Internal_conversion_coefficient"^^xsd:anyURI;
  qudt:symbol "a", "a";
  qudt:isoNormativeReference "http://www.iso.org/iso/catalogue_detail?csnumber=31895"^^xsd:anyURI,
    "http://www.iso.org/iso/catalogue_detail?csnumber=31895"^^xsd:anyURI;
  qudt:plainTextDescription "The \"InternalConversionFactor\" describes the rate of internal conversion. It is the ratio of the number of internal conversion electrons to the number of gamma quanta emitted by the radioactive atom in a given transition.",
    "The \"InternalConversionFactor\" describes the rate of internal conversion. It is the ratio of the number of internal conversion electrons to the number of gamma quanta emitted by the radioactive atom in a given transition.";
  qudt:applicableUnit unit:UNITLESS, unit:UNITLESS .

quantitykind:IsentropicExponent a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:seeAlso quantitykind:IsentropicCompressibility, quantitykind:IsentropicCompressibility;
  rdfs:label "Coefficiente di dilatazione adiabatica"@it, "Coefficiente di dilatazione adiabatica"@it,
    "Coeficient de transformare adiabatică"@ro, "Coeficient de transformare adiabatică"@ro,
    "Coeficiente de dilatación adiabática"@es, "Coeficiente de dilatación adiabática"@es,
    "Coeficiente de expansão adiabática"@pt, "Coeficiente de expansão adiabática"@pt,
    "Isentropenexponent"@de, "Isentropenexponent"@de, "Poissonova konstanta"@cs, "Poissonova konstanta"@cs,
    "Wykładnik adiabaty"@pl, "Wykładnik adiabaty"@pl, "adiabatni eksponent"@sl, "adiabatni eksponent"@sl,
    "exposant isoentropique"@fr, "exposant isoentropique"@fr, "isentropic exponent"@en,
    "isentropic exponent"@en, "ısı sığası oranı; adyabatik indeks"@tr, "ısı sığası oranı; adyabatik indeks"@tr,
    "Показатель адиабаты"@ru, "Показатель адиабаты"@ru, "نسبة السعة الحرارية"@ar, "نسبة السعة الحرارية"@ar,
    "比熱比"@ja, "比熱比"@ja, "绝热指数"@zh, "绝热指数"@zh;
  rdfs:comment "Applicable units are those of quantitykind:IsentropicExponent", "Applicable units are those of quantitykind:IsentropicExponent";
  dct:description """
  $\\textit{Isentropic Exponent}$ is a variant of $\\textit{Specific Heat Ratio Capacities}$. 
  For an ideal gas $\\textit{Isentropic Exponent}$, $\\varkappa$. is equal to $\\gamma$,
   the ratio of its specific heat capacities $c_p$ and $c_v$ under steady pressure and volume.
  """^^qudt:LatexString,
    """
  $\\textit{Isentropic Exponent}$ is a variant of $\\textit{Specific Heat Ratio Capacities}$. 
  For an ideal gas $\\textit{Isentropic Exponent}$, $\\varkappa$. is equal to $\\gamma$,
   the ratio of its specific heat capacities $c_p$ and $c_v$ under steady pressure and volume.
  """^^qudt:LatexString;
  skos:altLabel "indice adiabatico"@it, "indice adiabatico"@it, "indice adiabatique"@fr,
    "indice adiabatique"@fr;
  qudt:hasDimensionVector dimensionvector:A0E0L0I0M0H0T0D1, dimensionvector:A0E0L0I0M0H0T0D1;
  qudt:informativeReference "http://en.wikipedia.org/wiki/Compressibility"^^xsd:anyURI,
    "http://en.wikipedia.org/wiki/Compressibility"^^xsd:anyURI, "http://en.citizendium.org/wiki/Specific_heat_ratio"^^xsd:anyURI,
    "http://en.citizendium.org/wiki/Specific_heat_ratio"^^xsd:anyURI;
  qudt:isoNormativeReference "http://www.iso.org/iso/catalogue_detail?csnumber=31890"^^xsd:anyURI,
    "http://www.iso.org/iso/catalogue_detail?csnumber=31890"^^xsd:anyURI;
  qudt:latexSymbol "$\\varkappa$"^^qudt:LatexString, "$\\varkappa$"^^qudt:LatexString;
  qudt:latexDefinition "$\\varkappa = -\\frac{V}{p}\\left \\{  \\frac{\\partial p}{\\partial  V}\\right \\}_S$, where $V$ is volume, $p$ is pressure, and $S$ is entropy."^^qudt:LatexString,
    "$\\varkappa = -\\frac{V}{p}\\left \\{  \\frac{\\partial p}{\\partial  V}\\right \\}_S$, where $V$ is volume, $p$ is pressure, and $S$ is entropy."^^qudt:LatexString;
  qudt:applicableUnit unit:UNITLESS, unit:UNITLESS .

quantitykind:LandeGFactor a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "Lande g-Factor"@en, "Lande g-Factor"@en;
  rdfs:comment "Applicable units are those of quantitykind:LandeGFactor", "Applicable units are those of quantitykind:LandeGFactor";
  dct:description "The \"Lande g-Factor\" is a particular example of a g-factor, namely for an electron with both spin and orbital angular momenta. It is named after Alfred Landé, who first described it in 1921."^^qudt:LatexString,
    "The \"Lande g-Factor\" is a particular example of a g-factor, namely for an electron with both spin and orbital angular momenta. It is named after Alfred Landé, who first described it in 1921."^^qudt:LatexString;
  qudt:hasDimensionVector dimensionvector:A0E0L0I0M0H0T0D1, dimensionvector:A0E0L0I0M0H0T0D1;
  qudt:informativeReference "http://en.wikipedia.org/wiki/Landé_g-factor"^^xsd:anyURI,
    "http://en.wikipedia.org/wiki/Landé_g-factor"^^xsd:anyURI, "http://en.wikipedia.org/wiki/G-factor_(physics)"^^xsd:anyURI,
    "http://en.wikipedia.org/wiki/G-factor_(physics)"^^xsd:anyURI;
  qudt:symbol "g", "g";
  qudt:isoNormativeReference "http://www.iso.org/iso/catalogue_detail?csnumber=31895"^^xsd:anyURI,
    "http://www.iso.org/iso/catalogue_detail?csnumber=31895"^^xsd:anyURI;
  qudt:plainTextDescription "The \"Lande g-Factor\" is a particular example of a g-factor, namely for an electron with both spin and orbital angular momenta. It is named after Alfred Landé, who first described it in 1921.",
    "The \"Lande g-Factor\" is a particular example of a g-factor, namely for an electron with both spin and orbital angular momenta. It is named after Alfred Landé, who first described it in 1921.";
  qudt:latexDefinition "$g = \\frac{\\mu}{J\\mu_B}$, where $\\mu$ is the magnitude of magnetic dipole moment, $J$ is the total angular momentum quantum number, and $\\mu_B$ is the Bohr magneton."^^qudt:LatexString,
    "$g = \\frac{\\mu}{J\\mu_B}$, where $\\mu$ is the magnitude of magnetic dipole moment, $J$ is the total angular momentum quantum number, and $\\mu_B$ is the Bohr magneton."^^qudt:LatexString;
  qudt:applicableUnit unit:UNITLESS, unit:UNITLESS .

quantitykind:LeakageFactor a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "Leakage Factor"@en, "Leakage Factor"@en;
  rdfs:comment "Applicable units are those of quantitykind:LeakageFactor", "Applicable units are those of quantitykind:LeakageFactor";
  dct:description "\"Leakage Factor\" is the ratio of the total magnetic flux to the useful magnetic flux of a magnetic circuit."^^qudt:LatexString,
    "\"Leakage Factor\" is the ratio of the total magnetic flux to the useful magnetic flux of a magnetic circuit."^^qudt:LatexString;
  qudt:hasDimensionVector dimensionvector:A0E0L0I0M0H0T0D1, dimensionvector:A0E0L0I0M0H0T0D1;
  qudt:informativeReference "http://www.iso.org/iso/home/store/catalogue_tc/catalogue_detail.htm?csnumber=31891"^^xsd:anyURI,
    "http://www.iso.org/iso/home/store/catalogue_tc/catalogue_detail.htm?csnumber=31891"^^xsd:anyURI,
    "http://www.electropedia.org/iev/iev.nsf/display?openform&ievref=221-04-12"^^xsd:anyURI,
    "http://www.electropedia.org/iev/iev.nsf/display?openform&ievref=221-04-12"^^xsd:anyURI;
  qudt:expression "$leakage-factor$"^^qudt:LatexString, "$leakage-factor$"^^qudt:LatexString;
  qudt:plainTextDescription "\"Leakage Factor\" is the ratio of the total magnetic flux to the useful magnetic flux of a magnetic circuit.",
    "\"Leakage Factor\" is the ratio of the total magnetic flux to the useful magnetic flux of a magnetic circuit.";
  qudt:latexSymbol "$\\sigma$"^^qudt:LatexString, "$\\sigma$"^^qudt:LatexString;
  qudt:latexDefinition "$\\sigma = 1 - k^2$, where $k$ is the coupling factor."^^qudt:LatexString,
    "$\\sigma = 1 - k^2$, where $k$ is the coupling factor."^^qudt:LatexString;
  qudt:applicableUnit unit:UNITLESS, unit:UNITLESS .

quantitykind:Lethargy a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "Lethargy"@en, "Lethargy"@en;
  rdfs:comment "Applicable units are those of quantitykind:Lethargy", "Applicable units are those of quantitykind:Lethargy";
  dct:description "The \"Lethargy\" is a dimensionless logarithm of the ratio of the energy of source neutrons to the energy of neutrons after a collision."^^qudt:LatexString,
    "The \"Lethargy\" is a dimensionless logarithm of the ratio of the energy of source neutrons to the energy of neutrons after a collision."^^qudt:LatexString;
  qudt:hasDimensionVector dimensionvector:A0E0L0I0M0H0T0D1, dimensionvector:A0E0L0I0M0H0T0D1;
  qudt:informativeReference "http://www.scribd.com/doc/51548050/149/Lethargy"^^xsd:anyURI,
    "http://www.scribd.com/doc/51548050/149/Lethargy"^^xsd:anyURI;
  qudt:symbol "u", "u";
  qudt:isoNormativeReference "http://www.iso.org/iso/catalogue_detail?csnumber=31895"^^xsd:anyURI,
    "http://www.iso.org/iso/catalogue_detail?csnumber=31895"^^xsd:anyURI;
  qudt:plainTextDescription "The \"Lethargy\" is a dimensionless logarithm of the ratio of the energy of source neutrons to the energy of neutrons after a collision.",
    "The \"Lethargy\" is a dimensionless logarithm of the ratio of the energy of source neutrons to the energy of neutrons after a collision.";
  qudt:latexDefinition "$u = \\ln(\\frac{E_0}{E})$, where $E_0$ is a reference energy."^^qudt:LatexString,
    "$u = \\ln(\\frac{E_0}{E})$, where $E_0$ is a reference energy."^^qudt:LatexString;
  qudt:applicableUnit unit:UNITLESS, unit:UNITLESS .

quantitykind:LogOctanolAirPartitionCoefficient a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "Octanol Air Partition Coefficient"@en, "Octanol Air Partition Coefficient"@en;
  rdfs:comment "Applicable units are those of quantitykind:LogOctanolAirPartitionCoefficient",
    "Applicable units are those of quantitykind:LogOctanolAirPartitionCoefficient";
  dct:description "A dimensionless ratio that is the logarithm of the ratio of a compound's concentration within a two phase mixture of liquid octanol and gaseous air at equilibrium.  More simply, it is a comparison of the solubilities of the compound solute in these two immiscible substances."^^qudt:LatexString,
    "A dimensionless ratio that is the logarithm of the ratio of a compound's concentration within a two phase mixture of liquid octanol and gaseous air at equilibrium.  More simply, it is a comparison of the solubilities of the compound solute in these two immiscible substances."^^qudt:LatexString;
  skos:broader quantitykind:DimensionlessRatio, quantitykind:DimensionlessRatio;
  qudt:hasDimensionVector dimensionvector:A0E0L0I0M0H0T0D1, dimensionvector:A0E0L0I0M0H0T0D1;
  qudt:plainTextDescription "A dimensionless ratio that is the logarithm of the ratio of a compound's concentration within a two phase mixture of liquid octanol and gaseous air at equilibrium.  More simply, it is a comparison of the solubilities of the compound solute in these two immiscible substances.",
    "A dimensionless ratio that is the logarithm of the ratio of a compound's concentration within a two phase mixture of liquid octanol and gaseous air at equilibrium.  More simply, it is a comparison of the solubilities of the compound solute in these two immiscible substances.";
  qudt:applicableUnit unit:UNITLESS, unit:UNITLESS .

quantitykind:LogOctanolWaterPartitionCoefficient a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "Logarithm of Octanol Water Partition Coefficient"@en, "Logarithm of Octanol Water Partition Coefficient"@en;
  rdfs:comment "Applicable units are those of quantitykind:LogOctanolWaterPartitionCoefficient",
    "Applicable units are those of quantitykind:LogOctanolWaterPartitionCoefficient";
  dct:description "A dimensionless ratio that is the logarithm of the ratio of a compound's concentration within a two phase mixture of octanol and water at equilibrium.  More simply, it is a comparison of the solubilities of the compound solute in these two immiscible liquids.  This property is used to measure the lipophilicity and the hydrophilicity of a substance."^^qudt:LatexString,
    "A dimensionless ratio that is the logarithm of the ratio of a compound's concentration within a two phase mixture of octanol and water at equilibrium.  More simply, it is a comparison of the solubilities of the compound solute in these two immiscible liquids.  This property is used to measure the lipophilicity and the hydrophilicity of a substance."^^qudt:LatexString;
  skos:broader quantitykind:DimensionlessRatio, quantitykind:DimensionlessRatio;
  qudt:hasDimensionVector dimensionvector:A0E0L0I0M0H0T0D1, dimensionvector:A0E0L0I0M0H0T0D1;
  qudt:plainTextDescription "A dimensionless ratio that is the logarithm of the ratio of a compound's concentration within a two phase mixture of octanol and water at equilibrium.  More simply, it is a comparison of the solubilities of the compound solute in these two immiscible liquids.  This property is used to measure the lipophilicity and the hydrophilicity of a substance.",
    "A dimensionless ratio that is the logarithm of the ratio of a compound's concentration within a two phase mixture of octanol and water at equilibrium.  More simply, it is a comparison of the solubilities of the compound solute in these two immiscible liquids.  This property is used to measure the lipophilicity and the hydrophilicity of a substance.";
  qudt:applicableUnit unit:UNITLESS, unit:UNITLESS .

quantitykind:Long-RangeOrderParameter a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "Long-Range Order Parameter"@en, "Long-Range Order Parameter"@en;
  rdfs:comment "Applicable units are those of quantitykind:Long-RangeOrderParameter",
    "Applicable units are those of quantitykind:Long-RangeOrderParameter";
  dct:description "\"Long-Range Order Parameter\" is the fraction of atoms in an Ising ferromagnet having magnetic moments in one direction, minus the fraction having magnetic moments in the opposite direction."^^qudt:LatexString,
    "\"Long-Range Order Parameter\" is the fraction of atoms in an Ising ferromagnet having magnetic moments in one direction, minus the fraction having magnetic moments in the opposite direction."^^qudt:LatexString;
  qudt:hasDimensionVector dimensionvector:A0E0L0I0M0H0T0D1, dimensionvector:A0E0L0I0M0H0T0D1;
  qudt:symbol "R, s", "R, s";
  qudt:isoNormativeReference "http://www.iso.org/iso/catalogue_detail?csnumber=31897"^^xsd:anyURI,
    "http://www.iso.org/iso/catalogue_detail?csnumber=31897"^^xsd:anyURI;
  qudt:plainTextDescription "\"Long-Range Order Parameter\" is the fraction of atoms in an Ising ferromagnet having magnetic moments in one direction, minus the fraction having magnetic moments in the opposite direction.",
    "\"Long-Range Order Parameter\" is the fraction of atoms in an Ising ferromagnet having magnetic moments in one direction, minus the fraction having magnetic moments in the opposite direction.";
  qudt:applicableUnit unit:UNITLESS, unit:UNITLESS .

quantitykind:LossFactor a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:seeAlso quantitykind:Resistance, quantitykind:Resistance, quantitykind:Reactance,
    quantitykind:Reactance, quantitykind:QualityFactor, quantitykind:QualityFactor;
  rdfs:label "Loss Factor"@en, "Loss Factor"@en;
  rdfs:comment "Applicable units are those of quantitykind:LossFactor", "Applicable units are those of quantitykind:LossFactor";
  dct:description """
  $\\textit{Loss Factor}$ is the inverse of $\\textit{Quality Factor}$ and is the ratio of the $\\textit{resistance}$ and modulus of $\\textit{reactance}$.
  """^^qudt:LatexString,
    """
  $\\textit{Loss Factor}$ is the inverse of $\\textit{Quality Factor}$ and is the ratio of the $\\textit{resistance}$ and modulus of $\\textit{reactance}$.
  """^^qudt:LatexString;
  qudt:hasDimensionVector dimensionvector:A0E0L0I0M0H0T0D1, dimensionvector:A0E0L0I0M0H0T0D1;
  qudt:informativeReference "http://www.iso.org/iso/home/store/catalogue_tc/catalogue_detail.htm?csnumber=31891"^^xsd:anyURI,
    "http://www.iso.org/iso/home/store/catalogue_tc/catalogue_detail.htm?csnumber=31891"^^xsd:anyURI;
  qudt:symbol "d", "d";
  qudt:plainTextDescription "Loss Factor is the inverse of Quality Factor and is the ratio of the resistance and modulus of reactance.",
    "Loss Factor is the inverse of Quality Factor and is the ratio of the resistance and modulus of reactance.";
  qudt:latexDefinition "$d = \\frac{1}{Q}$, where $Q$ is quality factor."^^qudt:LatexString,
    "$d = \\frac{1}{Q}$, where $Q$ is quality factor."^^qudt:LatexString;
  qudt:applicableUnit unit:UNITLESS, unit:UNITLESS .

quantitykind:MadelungConstant a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "Constante de Madelung"@es, "Constante de Madelung"@es, "Constante de Madelung"@fr,
    "Constante de Madelung"@fr, "Costante di Madelung"@it, "Costante di Madelung"@it,
    "Madelung constant"@en, "Madelung constant"@en, "Madelung-Konstante"@de, "Madelung-Konstante"@de,
    "Stała Madelunga"@pl, "Stała Madelunga"@pl, "constante de Madelung"@pt, "constante de Madelung"@pt,
    "постоянная Маделунга"@ru, "постоянная Маделунга"@ru, "ثابت مادلونك"@ar, "ثابت مادلونك"@ar,
    "ثابت مادلونگ"@fa, "ثابت مادلونگ"@fa, "マーデルングエネルギー"@ja, "マーデルングエネルギー"@ja, "馬德隆常數"@zh,
    "馬德隆常數"@zh;
  rdfs:comment "Applicable units are those of quantitykind:MadelungConstant", "Applicable units are those of quantitykind:MadelungConstant";
  dct:description "\"Madelung Constant\" is used in determining the electrostatic potential of a single ion in a crystal by approximating the ions by point charges. It is named after Erwin Madelung, a German physicist."^^qudt:LatexString,
    "\"Madelung Constant\" is used in determining the electrostatic potential of a single ion in a crystal by approximating the ions by point charges. It is named after Erwin Madelung, a German physicist."^^qudt:LatexString;
  qudt:hasDimensionVector dimensionvector:A0E0L0I0M0H0T0D1, dimensionvector:A0E0L0I0M0H0T0D1;
  qudt:informativeReference "http://en.wikipedia.org/wiki/Madelung_constant"^^xsd:anyURI,
    "http://en.wikipedia.org/wiki/Madelung_constant"^^xsd:anyURI;
  qudt:isoNormativeReference "http://www.iso.org/iso/catalogue_detail?csnumber=31897"^^xsd:anyURI,
    "http://www.iso.org/iso/catalogue_detail?csnumber=31897"^^xsd:anyURI;
  qudt:plainTextDescription "\"Madelung Constant\" is used in determining the electrostatic potential of a single ion in a crystal by approximating the ions by point charges. It is named after Erwin Madelung, a German physicist.",
    "\"Madelung Constant\" is used in determining the electrostatic potential of a single ion in a crystal by approximating the ions by point charges. It is named after Erwin Madelung, a German physicist.";
  qudt:latexSymbol "$\\alpha$"^^qudt:LatexString, "$\\alpha$"^^qudt:LatexString;
  qudt:latexDefinition "For a uni-univalent ionic crystal of specified structure, the binding energy $V_b$ per pair of ions is $V_b = \\alpha\\frac{e^2}{4\\pi \\varepsilon_0 a}$, where $e$ is the elementary charge, $\\varepsilon_0$ is the electric constant, and $a$ is the lattice constant which should be specified."^^qudt:LatexString,
    "For a uni-univalent ionic crystal of specified structure, the binding energy $V_b$ per pair of ions is $V_b = \\alpha\\frac{e^2}{4\\pi \\varepsilon_0 a}$, where $e$ is the elementary charge, $\\varepsilon_0$ is the electric constant, and $a$ is the lattice constant which should be specified."^^qudt:LatexString;
  qudt:applicableUnit unit:UNITLESS, unit:UNITLESS .

quantitykind:MagneticSusceptability a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:seeAlso quantitykind:MagneticFieldStrength_H, quantitykind:MagneticFieldStrength_H,
    <http://qudt.org/vocab/constant/MagneticConstant>, <http://qudt.org/vocab/constant/MagneticConstant>,
    quantitykind:Magnetization, quantitykind:Magnetization;
  rdfs:label "Magnetic Susceptability"@en, "Magnetic Susceptability"@en;
  rdfs:comment "Applicable units are those of quantitykind:MagneticSusceptability",
    "Applicable units are those of quantitykind:MagneticSusceptability";
  dct:description "\"Magnetic Susceptability\" is a scalar or tensor quantity the product of which by the magnetic constant $\\mu_0$ and by the magnetic field strength $H$ is equal to the magnetic polarization $J$. The definition given applies to an isotropic medium. For an anisotropic medium permeability is a second order tensor."^^qudt:LatexString,
    "\"Magnetic Susceptability\" is a scalar or tensor quantity the product of which by the magnetic constant $\\mu_0$ and by the magnetic field strength $H$ is equal to the magnetic polarization $J$. The definition given applies to an isotropic medium. For an anisotropic medium permeability is a second order tensor."^^qudt:LatexString;
  qudt:hasDimensionVector dimensionvector:A0E0L0I0M0H0T0D1, dimensionvector:A0E0L0I0M0H0T0D1;
  qudt:informativeReference "http://www.iso.org/iso/home/store/catalogue_tc/catalogue_detail.htm?csnumber=31891"^^xsd:anyURI,
    "http://www.iso.org/iso/home/store/catalogue_tc/catalogue_detail.htm?csnumber=31891"^^xsd:anyURI,
    "http://www.electropedia.org/iev/iev.nsf/display?openform&ievref=121-12-37"^^xsd:anyURI,
    "http://www.electropedia.org/iev/iev.nsf/display?openform&ievref=121-12-37"^^xsd:anyURI;
  qudt:expression "$\\kappa = \\frac{M}{H}$"^^qudt:LatexString, "$\\kappa = \\frac{M}{H}$"^^qudt:LatexString;
  qudt:latexSymbol "$\\kappa$"^^qudt:LatexString, "$\\kappa$"^^qudt:LatexString;
  qudt:latexDefinition "$\\kappa = \\frac{M}{H}$,  where $M$ is magnetization,  and $H$ is magnetic field strength."^^qudt:LatexString,
    "$\\kappa = \\frac{M}{H}$,  where $M$ is magnetization,  and $H$ is magnetic field strength."^^qudt:LatexString;
  qudt:applicableUnit unit:UNITLESS, unit:UNITLESS .

quantitykind:MassFraction a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "Mass Fraction"@en, "Mass Fraction"@en;
  rdfs:comment "Applicable units are those of quantitykind:MassFraction", "Applicable units are those of quantitykind:MassFraction";
  dct:description "The \"Mass Fraction\" is the fraction of one substance with mass to the mass of the total mixture ."^^qudt:LatexString,
    "The \"Mass Fraction\" is the fraction of one substance with mass to the mass of the total mixture ."^^qudt:LatexString;
  qudt:hasDimensionVector dimensionvector:A0E0L0I0M0H0T0D1, dimensionvector:A0E0L0I0M0H0T0D1;
  qudt:informativeReference "http://en.wikipedia.org/wiki/Mass_fraction_(chemistry)"^^xsd:anyURI,
    "http://en.wikipedia.org/wiki/Mass_fraction_(chemistry)"^^xsd:anyURI;
  qudt:symbol "w_B", "w_B";
  qudt:isoNormativeReference "http://www.iso.org/iso/catalogue_detail?csnumber=31894"^^xsd:anyURI,
    "http://www.iso.org/iso/catalogue_detail?csnumber=31894"^^xsd:anyURI;
  qudt:plainTextDescription "The \"Mass Fraction\" is the fraction of one substance with mass to the mass of the total mixture .",
    "The \"Mass Fraction\" is the fraction of one substance with mass to the mass of the total mixture .";
  qudt:latexDefinition "$w_B = \\frac{m_B}{m}$, where $m_B$ is the mass of substance $B$ and $m$ is the total."^^qudt:LatexString,
    "$w_B = \\frac{m_B}{m}$, where $m_B$ is the mass of substance $B$ and $m$ is the total."^^qudt:LatexString;
  qudt:applicableUnit unit:UNITLESS, unit:UNITLESS .

quantitykind:MassFractionOfDryMatter a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:seeAlso quantitykind:MassFractionOfWater, quantitykind:MassFractionOfWater;
  rdfs:label "Mass Fraction of Dry Matter"@en, "Mass Fraction of Dry Matter"@en;
  rdfs:comment "Applicable units are those of quantitykind:MassFractionOfDryMatter",
    "Applicable units are those of quantitykind:MassFractionOfDryMatter";
  dct:description "\"Mass Fraction of Dry Matter\" is one of a number of $\\textit{Concentration}$ quantities defined by ISO 80000."^^qudt:LatexString,
    "\"Mass Fraction of Dry Matter\" is one of a number of $\\textit{Concentration}$ quantities defined by ISO 80000."^^qudt:LatexString;
  qudt:hasDimensionVector dimensionvector:A0E0L0I0M0H0T0D1, dimensionvector:A0E0L0I0M0H0T0D1;
  qudt:symbol "w_d", "w_d";
  qudt:isoNormativeReference "http://www.iso.org/iso/catalogue_detail?csnumber=31890"^^xsd:anyURI,
    "http://www.iso.org/iso/catalogue_detail?csnumber=31890"^^xsd:anyURI;
  qudt:plainTextDescription "\"Mass Fraction of Dry Matter\" is one of a number of Concentration quantities defined by ISO 80000.",
    "\"Mass Fraction of Dry Matter\" is one of a number of Concentration quantities defined by ISO 80000.";
  qudt:latexDefinition "$w_d= 1 - w_{h2o}$, where $w_{h2o}$ is mass fraction of water."^^qudt:LatexString,
    "$w_d= 1 - w_{h2o}$, where $w_{h2o}$ is mass fraction of water."^^qudt:LatexString;
  qudt:applicableUnit unit:UNITLESS, unit:UNITLESS .

quantitykind:MassFractionOfWater a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:seeAlso quantitykind:MassFractionOfDryMatter, quantitykind:MassFractionOfDryMatter;
  rdfs:label "Mass Fraction of Water"@en, "Mass Fraction of Water"@en;
  rdfs:comment "Applicable units are those of quantitykind:MassFractionOfWater", "Applicable units are those of quantitykind:MassFractionOfWater";
  dct:description "\"Mass Fraction of Water\" is one of a number of $\\textit{Concentration}$ quantities defined by ISO 80000."^^qudt:LatexString,
    "\"Mass Fraction of Water\" is one of a number of $\\textit{Concentration}$ quantities defined by ISO 80000."^^qudt:LatexString;
  qudt:hasDimensionVector dimensionvector:A0E0L0I0M0H0T0D1, dimensionvector:A0E0L0I0M0H0T0D1;
  qudt:symbol "w_{H_2o}", "w_{H_2o}";
  qudt:isoNormativeReference "http://www.iso.org/iso/catalogue_detail?csnumber=31890"^^xsd:anyURI,
    "http://www.iso.org/iso/catalogue_detail?csnumber=31890"^^xsd:anyURI;
  qudt:plainTextDescription "Mass Fraction of Water is one of a number of Concentration quantities defined by ISO 80000.",
    "Mass Fraction of Water is one of a number of Concentration quantities defined by ISO 80000.";
  qudt:latexDefinition "$w_{H_2o} = \\frac{u}{1+u}$, where $u$ is mass ratio of water to dry water."^^qudt:LatexString,
    "$w_{H_2o} = \\frac{u}{1+u}$, where $u$ is mass ratio of water to dry water."^^qudt:LatexString;
  qudt:applicableUnit unit:UNITLESS, unit:UNITLESS .

quantitykind:MassRatioOfWaterToDryMatter a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "Mass Concentration of Water To Dry Matter"@en, "Mass Concentration of Water To Dry Matter"@en;
  rdfs:comment "Applicable units are those of quantitykind:MassRatioOfWaterToDryMatter",
    "Applicable units are those of quantitykind:MassRatioOfWaterToDryMatter";
  dct:description "\"Mass Ratio of Water to Dry Matter\" is one of a number of $\\textit{Concentration Ratio}$ quantities defined by ISO 80000."^^qudt:LatexString,
    "\"Mass Ratio of Water to Dry Matter\" is one of a number of $\\textit{Concentration Ratio}$ quantities defined by ISO 80000."^^qudt:LatexString;
  qudt:hasDimensionVector dimensionvector:A0E0L0I0M0H0T0D1, dimensionvector:A0E0L0I0M0H0T0D1;
  qudt:symbol "u", "u";
  qudt:isoNormativeReference "http://www.iso.org/iso/catalogue_detail?csnumber=31890"^^xsd:anyURI,
    "http://www.iso.org/iso/catalogue_detail?csnumber=31890"^^xsd:anyURI;
  qudt:plainTextDescription "Mass Ratio of Water to Dry Matter is one of a number of Concentration Ratio quantities defined by ISO 80000.",
    "Mass Ratio of Water to Dry Matter is one of a number of Concentration Ratio quantities defined by ISO 80000.";
  qudt:latexDefinition "$u = m/m_d$, where $m$ is mass of water vapour and $m_d$ is mass of dry matter. Mass ratio of water to dry matter at saturation is denoted $u_{sat}$."^^qudt:LatexString,
    "$u = m/m_d$, where $m$ is mass of water vapour and $m_d$ is mass of dry matter. Mass ratio of water to dry matter at saturation is denoted $u_{sat}$."^^qudt:LatexString;
  qudt:applicableUnit unit:UNITLESS, unit:UNITLESS .

quantitykind:MassRatioOfWaterVapourToDryGas a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "Mass Ratio of Water Vapour to Dry Gas"@en, "Mass Ratio of Water Vapour to Dry Gas"@en;
  rdfs:comment "Applicable units are those of quantitykind:MassRatioOfWaterVapourToDryGas",
    "Applicable units are those of quantitykind:MassRatioOfWaterVapourToDryGas";
  dct:description "\"Mass Ratio of Water Vapour to Dry Gas\" is one of a number of $\\textit{Concentration Ratio}$ quantities defined by ISO 80000."^^qudt:LatexString,
    "\"Mass Ratio of Water Vapour to Dry Gas\" is one of a number of $\\textit{Concentration Ratio}$ quantities defined by ISO 80000."^^qudt:LatexString;
  qudt:hasDimensionVector dimensionvector:A0E0L0I0M0H0T0D1, dimensionvector:A0E0L0I0M0H0T0D1;
  qudt:symbol "x", "x";
  qudt:isoNormativeReference "http://www.iso.org/iso/catalogue_detail?csnumber=31890"^^xsd:anyURI,
    "http://www.iso.org/iso/catalogue_detail?csnumber=31890"^^xsd:anyURI;
  qudt:plainTextDescription "Mass Ratio of Water Vapour to Dry Gas is one of a number of Concentration Ratio quantities defined by ISO 80000.",
    "Mass Ratio of Water Vapour to Dry Gas is one of a number of Concentration Ratio quantities defined by ISO 80000.";
  qudt:latexDefinition "$x = m/m_d$, where $m$ is mass of water vapour and $m_d$ is mass of dry gas. Mass ratio of water vapour to dry gas  at saturation is denoted $x_{sat}$."^^qudt:LatexString,
    "$x = m/m_d$, where $m$ is mass of water vapour and $m_d$ is mass of dry gas. Mass ratio of water vapour to dry gas  at saturation is denoted $x_{sat}$."^^qudt:LatexString;
  qudt:applicableUnit unit:UNITLESS, unit:UNITLESS .

quantitykind:MobilityRatio a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "Mobility Ratio"@en, "Mobility Ratio"@en;
  rdfs:comment "Applicable units are those of quantitykind:MobilityRatio", "Applicable units are those of quantitykind:MobilityRatio";
  dct:description "\"MobilityRatio\" describes permeability of a porous material to a given phase divided by the viscosity of that phase."^^qudt:LatexString,
    "\"MobilityRatio\" describes permeability of a porous material to a given phase divided by the viscosity of that phase."^^qudt:LatexString;
  qudt:hasDimensionVector dimensionvector:A0E0L0I0M0H0T0D1, dimensionvector:A0E0L0I0M0H0T0D1;
  qudt:symbol "b", "b";
  qudt:isoNormativeReference "http://www.iso.org/iso/catalogue_detail?csnumber=31897"^^xsd:anyURI,
    "http://www.iso.org/iso/catalogue_detail?csnumber=31897"^^xsd:anyURI;
  qudt:plainTextDescription "\"MobilityRatio\" describes permeability of a porous material to a given phase divided by the viscosity of that phase.",
    "\"MobilityRatio\" describes permeability of a porous material to a given phase divided by the viscosity of that phase.";
  qudt:latexDefinition "$b = \\frac{\\mu_n}{\\mu_p}$, where $\\mu_n$ and $\\mu_p$ are mobilities for electrons and holes, respectively."^^qudt:LatexString,
    "$b = \\frac{\\mu_n}{\\mu_p}$, where $\\mu_n$ and $\\mu_p$ are mobilities for electrons and holes, respectively."^^qudt:LatexString;
  qudt:applicableUnit unit:UNITLESS, unit:UNITLESS .

quantitykind:MultiplicationFactor a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "Multiplication Factor"@en, "Multiplication Factor"@en;
  rdfs:comment "Applicable units are those of quantitykind:MultiplicationFactor", "Applicable units are those of quantitykind:MultiplicationFactor";
  dct:description "The \"Multiplication Factor\" is the ratio of the total number of fission or fission-dependent neutrons produced in a time interval to the total number of neutrons lost by absorption and leakage during the same interval."^^qudt:LatexString,
    "The \"Multiplication Factor\" is the ratio of the total number of fission or fission-dependent neutrons produced in a time interval to the total number of neutrons lost by absorption and leakage during the same interval."^^qudt:LatexString;
  qudt:hasDimensionVector dimensionvector:A0E0L0I0M0H0T0D1, dimensionvector:A0E0L0I0M0H0T0D1;
  qudt:informativeReference "http://en.wikipedia.org/wiki/Neutron_multiplication_factor"^^xsd:anyURI,
    "http://en.wikipedia.org/wiki/Neutron_multiplication_factor"^^xsd:anyURI;
  qudt:symbol "k", "k";
  qudt:isoNormativeReference "http://www.iso.org/iso/catalogue_detail?csnumber=31895"^^xsd:anyURI,
    "http://www.iso.org/iso/catalogue_detail?csnumber=31895"^^xsd:anyURI;
  qudt:plainTextDescription "The \"Multiplication Factor\" is the ratio of the total number of fission or fission-dependent neutrons produced in a time interval to the total number of neutrons lost by absorption and leakage during the same interval.",
    "The \"Multiplication Factor\" is the ratio of the total number of fission or fission-dependent neutrons produced in a time interval to the total number of neutrons lost by absorption and leakage during the same interval.";
  qudt:applicableUnit unit:UNITLESS, unit:UNITLESS .

quantitykind:NapierianAbsorbance a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "Napierian Absorbance"@en, "Napierian Absorbance"@en;
  rdfs:comment "Applicable units are those of quantitykind:NapierianAbsorbance", "Applicable units are those of quantitykind:NapierianAbsorbance";
  dct:description "Napierian Absorbance is the natural (Napierian) logarithm of the reciprocal of the spectral internal transmittance."^^qudt:LatexString,
    "Napierian Absorbance is the natural (Napierian) logarithm of the reciprocal of the spectral internal transmittance."^^qudt:LatexString;
  qudt:hasDimensionVector dimensionvector:A0E0L0I0M0H0T0D1, dimensionvector:A0E0L0I0M0H0T0D1;
  qudt:informativeReference "https://en.wikipedia.org/wiki/Absorbance#Beer-Lambert_law"^^xsd:anyURI,
    "https://en.wikipedia.org/wiki/Absorbance#Beer-Lambert_law"^^xsd:anyURI, "https://en.wikipedia.org/wiki/Beer%E2%80%93Lambert_law#Formulation"^^xsd:anyURI,
    "https://en.wikipedia.org/wiki/Beer%E2%80%93Lambert_law#Formulation"^^xsd:anyURI;
  qudt:symbol "A_e, B", "A_e, B";
  qudt:plainTextDescription "Napierian Absorbance is the natural (Napierian) logarithm of the reciprocal of the spectral internal transmittance.",
    "Napierian Absorbance is the natural (Napierian) logarithm of the reciprocal of the spectral internal transmittance.";
  qudt:latexDefinition "$A_e(\\lambda) = -ln(\\tau(\\lambda))$, where $\\tau$ is the transmittance at a given wavelength $\\lambda$."^^qudt:LatexString,
    "$A_e(\\lambda) = -ln(\\tau(\\lambda))$, where $\\tau$ is the transmittance at a given wavelength $\\lambda$."^^qudt:LatexString;
  qudt:applicableUnit unit:UNITLESS, unit:UNITLESS .

