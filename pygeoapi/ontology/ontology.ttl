<http://qudt.org/vocab/quantitykind/CelsiusTemperature> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "צלזיוס"@he, "Celsius sıcaklık"@tr, "Celsius temperature"@en, "Celsius-Temperatur"@de,
    "Suhu Celsius"@ms, "temperatura Celsius"@es, "temperatura Celsius"@it, "temperatura celsius"@pt,
    "temperatura"@pl, "temperatura"@sl, "temperatură Celsius"@ro, "température Celsius"@fr,
    "teplota"@cs, "Температура Цельсия"@ru, "درجة الحرارة المئوية أو السيلسيوس"@ar, "دمای سلسیوس/سانتیگراد"@fa,
    "सेल्सियस तापमान"@hi, "温度"@ja, "温度"@zh;
  rdfs:comment "Applicable units are those of quantitykind:ThermodynamicTemperature";
  dct:description "\"Celsius Temperature\", the thermodynamic temperature T_0, is exactly 0.01 kelvin below the thermodynamic temperature of the triple point of water."^^<http://qudt.org/schema/qudt/LatexString>;
  skos:broader <http://qudt.org/vocab/quantitykind/ThermodynamicTemperature>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H1T0D0>;
  <http://qudt.org/schema/qudt/iec61360Code> "0112/2///62720#UAD023";
  <http://qudt.org/schema/qudt/informativeReference> "https://cdd.iec.ch/cdd/iec61987/iec61987.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD023"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/siExactMatch> <https://si-digital-framework.org/SI/quantities/TEMC>;
  <http://qudt.org/schema/qudt/isoNormativeReference> "http://www.iso.org/iso/catalogue_detail?csnumber=31890"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/plainTextDescription> "\"Celsius Temperature\", the thermodynamic temperature T_0, is exactly 0.01 kelvin below the thermodynamic temperature of the triple point of water.";
  <http://qudt.org/schema/qudt/latexDefinition> """\"Celsius Temperature\", the thermodynamic temperature $T_0$, is exactly $0.01$kelvin below the thermodynamic temperature of the triple point of water.
$t = T - T_0$, where $T$ is Thermodynamic Temperature and $T_0 = 273.15 K$."""^^<http://qudt.org/schema/qudt/LatexString>;
  <http://www.w3.org/ns/prov#wasDerivedFrom> <http://qudt.org/vocab/quantitykind/ThermodynamicTemperature>;
  <http://qudt.org/schema/qudt/applicableUnit> unit:DEG_R, unit:K, unit:PlanckTemperature .

<http://qudt.org/vocab/quantitykind/CharacteristicAcousticImpedance> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Characteristic Acoustic Impedance"@en;
  rdfs:comment "Applicable units are those of quantitykind:AcousticImpedance";
  dct:description "Characteristic impedance at a point in a non-dissipative medium and for a plane progressive wave, the quotient of the sound pressure $p$ by the component of the sound particle velocity $v$ in the direction of the wave propagation."^^<http://qudt.org/schema/qudt/LatexString>;
  skos:broader <http://qudt.org/vocab/quantitykind/AcousticImpedance>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L-2I0M1H0T-1D0>;
  <http://qudt.org/schema/qudt/informativeReference> "http://en.wikipedia.org/wiki/Acoustic_impedance#Characteristic_acoustic_impedance"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/symbol> "Z";
  <http://qudt.org/schema/qudt/latexDefinition> "$Z_c = pc$, where $p$ is the sound pressure and $c$ is the phase speed of sound."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://www.linkedmodel.org/schema/vaem#todo> "belongs to SOQ-ISO";
  <http://qudt.org/schema/qudt/applicableUnit> unit:PA-SEC-PER-M .

<http://qudt.org/vocab/quantitykind/CharacteristicNumber> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "characteristic number"@en-US;
  rdfs:comment "Applicable units are those of quantitykind:Dimensionless";
  dct:description "quantity of dimension one (as a result of measuring technology theory) which clarifies facts, states or developments and is used as a scale e.g. to represent causes and effects of events"@en;
  skos:broader <http://qudt.org/vocab/quantitykind/Dimensionless>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1>;
  <http://qudt.org/schema/qudt/symbol> "0173-1#Z4-BAJ279#002";
  <http://qudt.org/schema/qudt/plainTextDescription> "Größe der Dimension 1 (als Ergebnis der metrisierenden Messtheorie), die Sachverhalte, Zustände oder Entwicklungen verdeutlicht und als Maßstab dient, um z. B. Ursache und Wirkung von Vorgängen in kausalem Zusammenhang darzustellen"@de;
  <http://qudt.org/schema/qudt/applicableUnit> unit:DECADE, unit:FLIGHT, unit:GigaBasePair,
    unit:HeartBeat, unit:NP, unit:NUM, unit:OCT, unit:RPK, unit:SUSCEPTIBILITY_ELEC, unit:SUSCEPTIBILITY_MAG,
    unit:UNITLESS .

