unit:BIOT a qudt:Unit, qudt:Unit;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/unit>, <http://qudt.org/vocab/unit>;
  rdfs:label "Biot"@en, "Biot"@en;
  dct:description "\"Biot\" is another name for the abampere (aA), which is the basic electromagnetic unit of electric current in the emu-cgs (centimeter-gram-second) system of units. It is called after a French physicist, astronomer, and mathematician Jean-Baptiste Biot. One abampere is equal to ten amperes in the SI system of units. One abampere is the current, which produces a force of 2 dyne/cm between two infinitively long parallel wires that are 1 cm apart."^^rdf:HTML,
    "\"Biot\" is another name for the abampere (aA), which is the basic electromagnetic unit of electric current in the emu-cgs (centimeter-gram-second) system of units. It is called after a French physicist, astronomer, and mathematician Jean-Baptiste Biot. One abampere is equal to ten amperes in the SI system of units. One abampere is the current, which produces a force of 2 dyne/cm between two infinitively long parallel wires that are 1 cm apart."^^rdf:HTML;
  qudt:applicableSystem <http://qudt.org/vocab/sou/CGS-EMU>, <http://qudt.org/vocab/sou/CGS-EMU>,
    <http://qudt.org/vocab/sou/CGS>, <http://qudt.org/vocab/sou/CGS>;
  qudt:conversionMultiplier 10.0, 10.0;
  qudt:conversionMultiplierSN 1.0E1, 1.0E1;
  qudt:dbpediaMatch "http://dbpedia.org/resource/Biot"^^xsd:anyURI, "http://dbpedia.org/resource/Biot"^^xsd:anyURI;
  qudt:hasDimensionVector dimensionvector:A0E1L0I0M0H0T0D0, dimensionvector:A0E1L0I0M0H0T0D0;
