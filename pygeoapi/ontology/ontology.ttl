    rdfs:label "prefix multiplier scientific" ;
    rdfs:isDefinedBy <http://qudt.org/schema/qudt> ;
    rdfs:range xsd:double .

qudt:quantity a owl:ObjectProperty ;
    rdfs:label "quantity" ;
    dct:description "a property to relate an observable thing with a quantity (qud:Quantity)"^^rdf:HTML ;
    rdfs:isDefinedBy <http://qudt.org/3.0.0/schema/qudt>,
        <http://qudt.org/schema/qudt> .

qudt:reference a owl:ObjectProperty ;
