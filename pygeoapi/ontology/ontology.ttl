quantitykind:TotalMassStoppingPower a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "Total Mass Stopping Power"@en, "Total Mass Stopping Power"@en;
  rdfs:comment "Applicable units are those of quantitykind:TotalMassStoppingPower",
    "Applicable units are those of quantitykind:TotalMassStoppingPower";
  dct:description "If a substance is compared in gaseous and solid form, then the linear stopping powers of the two states are very different just because of the different density. One therefore often divides S(E) by the density of the material to obtain the \"Mass Stopping Power\". The mass stopping power then depends only very little on the density of the material."^^qudt:LatexString,
    "If a substance is compared in gaseous and solid form, then the linear stopping powers of the two states are very different just because of the different density. One therefore often divides S(E) by the density of the material to obtain the \"Mass Stopping Power\". The mass stopping power then depends only very little on the density of the material."^^qudt:LatexString;
  qudt:hasDimensionVector dimensionvector:A0E0L4I0M0H0T-2D0, dimensionvector:A0E0L4I0M0H0T-2D0;
  qudt:iec61360Code "0112/2///62720#UAD204", "0112/2///62720#UAD204";
  qudt:informativeReference "http://en.wikipedia.org/wiki/Stopping_power_(particle_radiation)"^^xsd:anyURI,
    "http://en.wikipedia.org/wiki/Stopping_power_(particle_radiation)"^^xsd:anyURI, "https://cdd.iec.ch/cdd/iec61987/iec61987.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD204"^^xsd:anyURI,
    "https://cdd.iec.ch/cdd/iec61987/iec61987.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD204"^^xsd:anyURI;
  qudt:symbol "S_m", "S_m";
  qudt:isoNormativeReference "http://www.iso.org/iso/catalogue_detail?csnumber=31895"^^xsd:anyURI,
    "http://www.iso.org/iso/catalogue_detail?csnumber=31895"^^xsd:anyURI;
  qudt:plainTextDescription "If a substance is compared in gaseous and solid form, then the linear stopping powers of the two states are very different just because of the different density. One therefore often divides S(E) by the density of the material to obtain the \"Mass Stopping Power\". The mass stopping power then depends only very little on the density of the material.",
    "If a substance is compared in gaseous and solid form, then the linear stopping powers of the two states are very different just because of the different density. One therefore often divides S(E) by the density of the material to obtain the \"Mass Stopping Power\". The mass stopping power then depends only very little on the density of the material.";
  qudt:latexDefinition "$S_m = \\frac{S}{\\rho}$, where $S$ is the total linear stopping power and $\\rho$ is the mass density of the sample."^^qudt:LatexString,
    "$S_m = \\frac{S}{\\rho}$, where $S$ is the total linear stopping power and $\\rho$ is the mass density of the sample."^^qudt:LatexString;
  qudt:applicableUnit unit:ERG-CentiM2-PER-GM, unit:ERG-CentiM2-PER-GM, unit:EV-M2-PER-KiloGM,
    unit:EV-M2-PER-KiloGM, unit:J-M2-PER-KiloGM, unit:J-M2-PER-KiloGM .

