unit:PDL a qudt:Unit, qudt:Unit;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/unit>, <http://qudt.org/vocab/unit>;
  rdfs:label "Poundal"@en, "Poundal"@en;
  dct:description "The poundal is a unit of force that is part of the foot-pound-second system of units, in Imperial units introduced in 1877, and is from the specialized subsystem of English absolute (a coherent system). The poundal is defined as the force necessary to accelerate 1 pound-mass to 1 foot per second per second. $1 pdl = 0.138254954376 N$ exactly."^^qudt:LatexString,
    "The poundal is a unit of force that is part of the foot-pound-second system of units, in Imperial units introduced in 1877, and is from the specialized subsystem of English absolute (a coherent system). The poundal is defined as the force necessary to accelerate 1 pound-mass to 1 foot per second per second. $1 pdl = 0.138254954376 N$ exactly."^^qudt:LatexString;
  qudt:applicableSystem <http://qudt.org/vocab/sou/IMPERIAL>, <http://qudt.org/vocab/sou/IMPERIAL>,
    <http://qudt.org/vocab/sou/USCS>, <http://qudt.org/vocab/sou/USCS>;
