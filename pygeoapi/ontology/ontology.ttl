variablename:soilAggregateStability a skos:Concept ;
    skos:definition "Soil aggregate stability is a measure of the ability of soil aggregates to resist degradation when exposed to external forces such as water erosion and wind erosion, shrinking and swelling processes, and tillage. Soil aggregate stability is a measure of soil structure and can be impacted by soil management." ;
    skos:exactMatch "https://en.wikipedia.org/wiki/Soil_aggregate_stability" ;
    skos:historyNote "Wikipedia" ;
    skos:inScheme <http://vocabulary.odm2.org/variablename> ;
    skos:note "Added to support Critical Zone Observatory (CZO) data use cases. " ;
    skos:prefLabel "Soil aggregate stability" ;
    skos:topConceptOf <http://vocabulary.odm2.org/variablename> .

variablename:soilClassification a skos:Concept ;
    skos:definition "For soil resources, experience has shown that a natural system approach to classification, i.e. grouping soils by their intrinsic property (soil morphology), behaviour, or genesis, results in classes that can be interpreted for many diverse uses. Differing concepts of pedogenesis, and differences in the significance of morphological features to various land uses can affect the classification approach." ;
    skos:exactMatch "https://en.wikipedia.org/wiki/Soil_classification" ;
    skos:historyNote "Wikipedia" ;
    skos:inScheme <http://vocabulary.odm2.org/variablename> ;
    skos:note "Added to support Critical Zone Observatory (CZO) data use cases. " ;
    skos:prefLabel "Soil classification" ;
    skos:topConceptOf <http://vocabulary.odm2.org/variablename> .

variablename:soilCoarseFraction a skos:Concept ;
    skos:definition "Fraction of particles within a soil sample that are greater that 2mm in diameter" ;
    skos:exactMatch "http://info.reynoldscreekczo.org/dokuwiki/doku.php?id=soil_texture, https://en.wikipedia.org/wiki/Soil_texture" ;
    skos:inScheme <http://vocabulary.odm2.org/variablename> ;
    skos:note "Added to support Critical Zone Observatory (CZO) data use cases. " ;
    skos:prefLabel "Soil coarse fraction" ;
    skos:topConceptOf <http://vocabulary.odm2.org/variablename> .

variablename:soilDepth a skos:Concept ;
    skos:definition "Depth of soil" ;
    skos:exactMatch "https://en.wikipedia.org/wiki/Silicon" ;
    skos:historyNote "Wikipedia" ;
    skos:inScheme <http://vocabulary.odm2.org/variablename> ;
    skos:note "Added to support Critical Zone Observatory (CZO) data use cases. " ;
    skos:prefLabel "Depth, soil " ;
    skos:topConceptOf <http://vocabulary.odm2.org/variablename> .

variablename:soilHorizon a skos:Concept ;
    skos:definition "A soil horizon is a layer parallel to the soil surface, whose physical characteristics differ from the layers above and beneath. Each soil type usually has three or four horizons." ;
    skos:exactMatch "https://en.wikipedia.org/wiki/Soil_horizon" ;
    skos:historyNote "Wikipedia" ;
    skos:inScheme <http://vocabulary.odm2.org/variablename> ;
    skos:note "Added to support Critical Zone Observatory (CZO) data use cases. " ;
    skos:prefLabel "Soil horizon" ;
    skos:topConceptOf <http://vocabulary.odm2.org/variablename> .

variablename:soilOrganicMatter a skos:Concept ;
    skos:definition "Soil organic matter (SOM) is the organic matter component of soil, consisting of plant and animal residues at various stages of decomposition, cells and tissues of soil organisms, and substances synthesized by soil organisms." ;
    skos:exactMatch "https://en.wikipedia.org/wiki/Soil_organic_matter" ;
    skos:historyNote "Wikipedia" ;
    skos:inScheme <http://vocabulary.odm2.org/variablename> ;
    skos:note "Added to support Critical Zone Observatory (CZO) data use cases. " ;
    skos:prefLabel "Soil organic matter (SOM)" ;
    skos:topConceptOf <http://vocabulary.odm2.org/variablename> .

variablename:soilOrganicMatterDensityFractionation a skos:Concept ;
    skos:definition "Density fraction of Soil organic matter (SOM) in soil. Soil organic matter (SOM) is the organic matter component of soil, consisting of plant and animal residues at various stages of decomposition, cells and tissues of soil organisms, and substances synthesized by soil organisms." ;
    skos:exactMatch "https://en.wikipedia.org/wiki/Mass_fraction_(chemistry)" ;
    skos:historyNote "Wikipedia" ;
    skos:inScheme <http://vocabulary.odm2.org/variablename> ;
    skos:note "Added to support Critical Zone Observatory (CZO) data use cases. " ;
    skos:prefLabel "Soil organic matter (SOM) density fractionation" ;
    skos:topConceptOf <http://vocabulary.odm2.org/variablename> .

variablename:soilRespiration a skos:Concept ;
    skos:definition "Soil respiration refers to the production of carbon dioxide when soil organisms respire. This includes respiration of plant roots, the rhizosphere, microbes and fauna." ;
    skos:exactMatch "https://en.wikipedia.org/wiki/Soil_respiration" ;
    skos:historyNote "Wikipedia" ;
    skos:inScheme <http://vocabulary.odm2.org/variablename> ;
    skos:note "Added to support Critical Zone Observatory (CZO) data use cases. " ;
    skos:prefLabel "Soil respiration" ;
    skos:topConceptOf <http://vocabulary.odm2.org/variablename> .

variablename:soilTexture a skos:Concept ;
    skos:definition "Soil texture is a classification instrument used both in the field and laboratory to determine soil classes based on their physical texture. Soil texture can be determined using qualitative methods such as texture by feel, and quantitative methods such as the hydrometer method." ;
    skos:exactMatch "https://en.wikipedia.org/wiki/Soil_texture" ;
    skos:historyNote "Wikipedia" ;
    skos:inScheme <http://vocabulary.odm2.org/variablename> ;
    skos:note "Added to support Critical Zone Observatory (CZO) data use cases. " ;
    skos:prefLabel "Soil texture" ;
    skos:topConceptOf <http://vocabulary.odm2.org/variablename> .

