    unit:KiloN, unit:LB_F, unit:MegaLB_F, unit:MegaN, unit:MicroN, unit:MilliN, unit:OZ_F,
    unit:PDL, unit:POND, unit:PlanckForce, unit:TON_F_US .

<http://qudt.org/vocab/quantitykind/ThermalAdmittance> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Thermal Admittance"@en;
  rdfs:comment "Applicable units are those of quantitykind:CoefficientOfHeatTransfer";
  dct:description "The heat transfer coefficient is also known as thermal admittance in the sense that the material may be seen as admitting heat to flow."^^<http://qudt.org/schema/qudt/LatexString>;
  skos:broader <http://qudt.org/vocab/quantitykind/CoefficientOfHeatTransfer>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L0I0M1H-1T-3D0>;
  <http://qudt.org/schema/qudt/informativeReference> "https://en.wikipedia.org/wiki/Thermal_conductivity"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/plainTextDescription> "The heat transfer coefficient is also known as thermal admittance in the sense that the material may be seen as admitting heat to flow.";
  <http://qudt.org/schema/qudt/applicableUnit> unit:BTU_IT-PER-FT2-HR-DEG_F, unit:BTU_IT-PER-FT2-SEC-DEG_F,
    unit:BTU_IT-PER-HR-FT2-DEG_F, unit:BTU_IT-PER-HR-FT2-DEG_R, unit:BTU_IT-PER-SEC-FT2-DEG_F,
    unit:BTU_IT-PER-SEC-FT2-DEG_R, unit:BTU_TH-PER-HR-FT2-DEG_F, unit:BTU_TH-PER-SEC-FT2-DEG_F,
    unit:CAL_IT-PER-SEC-CentiM2-K, unit:CAL_TH-PER-SEC-CentiM2-K, unit:KiloGM-PER-SEC3-K,
    unit:KiloW-PER-M2-K, unit:W-PER-M2-K .

<http://qudt.org/vocab/quantitykind/ThermalCoefficientOfLinearExpansion> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "thermal coefficient of linear expansion"@en-US;
  dct:description "median relative change in length over a specific length of the test piece, divided by the temperature range caused by it"@en;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H-1T0D0>;
  <http://qudt.org/schema/qudt/symbol> "0173-1#Z4-BAJ473#002";
  <http://qudt.org/schema/qudt/plainTextDescription> "auf eine festgelegte Länge des Probekörpers bezogene mittlere relative Längenänderung dividiert durch die sie verursachende Temperaturänderung"@de .

<http://qudt.org/vocab/quantitykind/ThermalDiffusivity> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Thermal Diffusivity"@en;
  rdfs:comment "Applicable units are those of quantitykind:AreaPerTime";
  dct:description "In heat transfer analysis, thermal diffusivity (usually denoted $\\alpha$ but $a$, $\\kappa$,$k$, and $D$ are also used) is the thermal conductivity divided by density and specific heat capacity at constant pressure. The formula is: $\\alpha = {k \\over {\\rho c_p}}$, where k is thermal conductivity ($W/(\\mu \\cdot K)$), $\\rho$ is density ($kg/m^{3}$), and $c_p$ is specific heat capacity ($\\frac{J}{(kg \\cdot K)}$) .The denominator $\\rho c_p$, can be considered the volumetric heat capacity ($\\frac{J}{(m^{3} \\cdot K)}$)."^^<http://qudt.org/schema/qudt/LatexString>;
  skos:broader <http://qudt.org/vocab/quantitykind/AreaPerTime>;
  <http://qudt.org/schema/qudt/dbpediaMatch> "http://dbpedia.org/resource/Thermal_diffusivity"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L2I0M0H0T-1D0>;
  <http://qudt.org/schema/qudt/informativeReference> "http://en.wikipedia.org/wiki/Thermal_diffusivity"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/symbol> "a";
  <http://qudt.org/schema/qudt/latexSymbol> "$\\alpha$"^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/latexDefinition> "$a = \\frac{\\lambda}{\\rho   c_\\rho}$, where $\\lambda$ is thermal conductivity, $\\rho$ is mass density and $c_\\rho$ is specific heat capacity at constant pressure."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/applicableUnit> unit:CentiM2-PER-SEC, unit:FT2-PER-HR,
    unit:FT2-PER-SEC, unit:IN2-PER-SEC, unit:M2-HZ, unit:M2-PER-SEC, unit:MilliM2-PER-SEC .

<http://qudt.org/vocab/quantitykind/ThermalEfficiency> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Thermal Efficiency"@en;
  rdfs:comment "Applicable units are those of quantitykind:DimensionlessRatio";
  dct:description "Thermal efficiency is a dimensionless performance measure of a thermal device such as an internal combustion engine, a boiler, or a furnace. The input to the device is heat, or the heat-content of a fuel that is consumed. The desired output is mechanical work, or heat, or possibly both."^^<http://qudt.org/schema/qudt/LatexString>;
  skos:broader <http://qudt.org/vocab/quantitykind/DimensionlessRatio>;
  <http://qudt.org/schema/qudt/dbpediaMatch> "http://dbpedia.org/resource/Thermal_efficiency"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1>;
  <http://qudt.org/schema/qudt/isoNormativeReference> "http://www.iso.org/iso/catalogue_detail?csnumber=31890"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/plainTextDescription> "Thermal efficiency is a dimensionless performance measure of a thermal device such as an internal combustion engine, a boiler, or a furnace. The input to the device is heat, or the heat-content of a fuel that is consumed. The desired output is mechanical work, or heat, or possibly both.";
  <http://qudt.org/schema/qudt/qkdvDenominator> <http://qudt.org/vocab/dimensionvector/A0E0L2I0M1H0T-2D0>;
  <http://qudt.org/schema/qudt/qkdvNumerator> <http://qudt.org/vocab/dimensionvector/A0E0L2I0M1H0T-2D0>;
  <http://qudt.org/schema/qudt/applicableUnit> unit:FRACTION, unit:GR, unit:NUM, unit:PERCENT,
    unit:PERMITTIVITY_REL, unit:PPB, unit:PPM, unit:PPQ, unit:PPT, unit:PPTH, unit:PPTM,
    unit:PSU, unit:UNITLESS .

<http://qudt.org/vocab/quantitykind/ThermalInsulation> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "thermal insulation"@en-US;
  dct:description "temperature difference between two surfaces divided by areic heat flow rate in the direction of the temperature gradient"@en;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L0I0M-1H1T3D0>;
  <http://qudt.org/schema/qudt/symbol> "0173-1#Z4-BAJ404#002";
  <http://qudt.org/schema/qudt/plainTextDescription> "Temperaturdifferenz zwischen zwei Oberflächen dividiert durch den flächenbezogenen Wärmestrom in der Richtung des Temperaturgradienten"@de .

<http://qudt.org/vocab/quantitykind/ThermalTransmittance> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Thermal Transmittance"@en;
  rdfs:comment "Applicable units are those of quantitykind:CoefficientOfHeatTransfer";
  dct:description "Thermal transmittance is the rate of transfer of heat through matter. The thermal transmittance of a material (such as insulation or concrete) or an assembly (such as a wall or window) is expressed as a U-value. The concept of thermal transmittance is closely related to that of thermal resistance. The thermal resistance of a structure is the reciprocal of its thermal transmittance."^^<http://qudt.org/schema/qudt/LatexString>;
  skos:broader <http://qudt.org/vocab/quantitykind/CoefficientOfHeatTransfer>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L0I0M1H-1T-3D0>;
  <http://qudt.org/schema/qudt/iec61360Code> "0112/2///62720#UAD195";
  <http://qudt.org/schema/qudt/informativeReference> "https://cdd.iec.ch/cdd/iec61987/iec61987.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD195"^^xsd:anyURI,
    "https://en.wikipedia.org/wiki/Thermal_transmittance"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/plainTextDescription> "Thermal transmittance is the rate of transfer of heat through matter. The thermal transmittance of a material (such as insulation or concrete) or an assembly (such as a wall or window) is expressed as a U-value. The concept of thermal transmittance is closely related to that of thermal resistance. The thermal resistance of a structure is the reciprocal of its thermal transmittance.";
  <http://qudt.org/schema/qudt/applicableUnit> unit:BTU_IT-PER-FT2-HR-DEG_F, unit:BTU_IT-PER-FT2-SEC-DEG_F,
    unit:BTU_IT-PER-HR-FT2-DEG_F, unit:BTU_IT-PER-HR-FT2-DEG_R, unit:BTU_IT-PER-SEC-FT2-DEG_F,
    unit:BTU_IT-PER-SEC-FT2-DEG_R, unit:BTU_TH-PER-HR-FT2-DEG_F, unit:BTU_TH-PER-SEC-FT2-DEG_F,
    unit:CAL_IT-PER-SEC-CentiM2-K, unit:CAL_TH-PER-SEC-CentiM2-K, unit:KiloGM-PER-SEC3-K,
    unit:KiloW-PER-M2-K, unit:W-PER-M2-K .

<http://qudt.org/vocab/quantitykind/ThermalUtilizationFactorForFission> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Thermal Utilization Factor For Fission"@en;
  rdfs:comment "Applicable units are those of quantitykind:Dimensionless";
  dct:description "Probability that a neutron that gets absorbed does so in the fuel material."^^<http://qudt.org/schema/qudt/LatexString>;
  skos:broader <http://qudt.org/vocab/quantitykind/Dimensionless>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1>;
  <http://qudt.org/schema/qudt/symbol> "f";
  <http://qudt.org/schema/qudt/plainTextDescription> "Probability that a neutron that gets absorbed does so in the fuel material.";
  <http://qudt.org/schema/qudt/applicableUnit> unit:DECADE, unit:FLIGHT, unit:GigaBasePair,
    unit:HeartBeat, unit:NP, unit:NUM, unit:OCT, unit:RPK, unit:SUSCEPTIBILITY_ELEC, unit:SUSCEPTIBILITY_MAG,
    unit:UNITLESS .

<http://qudt.org/vocab/quantitykind/ThermodynamicCriticalMagneticFluxDensity> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Thermodynamic Critical Magnetic Flux Density"@en;
  rdfs:comment "Applicable units are those of quantitykind:MagneticFluxDensity";
  dct:description "\"Thermodynamic Critical Magnetic Flux Density\" is the maximum magnetic field strength below which a material remains superconducting."^^<http://qudt.org/schema/qudt/LatexString>;
  skos:broader <http://qudt.org/vocab/quantitykind/MagneticFluxDensity>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E-1L0I0M1H0T-2D0>;
  <http://qudt.org/schema/qudt/symbol> "B_c";
  <http://qudt.org/schema/qudt/isoNormativeReference> "http://www.iso.org/iso/catalogue_detail?csnumber=31897"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/plainTextDescription> "\"Thermodynamic Critical Magnetic Flux Density\" is the maximum magnetic field strength below which a material remains superconducting.";
  <http://qudt.org/schema/qudt/latexDefinition> "$G_n - G_s = \\frac{1}{2}\\frac{B_c^2 \\cdot V}{\\mu_0}$, where $G_n$ and $G_s$ are the Gibbs energies at zero magnetic flux density in a normal conductor and superconductor, respectively, $\\mu_0$ is the magnetic constant, and $V$ is volume."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/applicableUnit> unit:GAUSS, unit:Gs, unit:T_Ab, unit:Gamma,
    unit:KiloGAUSS, unit:KiloT, unit:MicroT, unit:MilliT, unit:NanoT, unit:T .

<http://qudt.org/vocab/quantitykind/ThermodynamicEntropy> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Thermodynamic Entropy"@en;
  rdfs:comment "Applicable units are those of quantitykind:EnergyPerTemperature";
  dct:description "Thermodynamic Entropy is a measure of the unavailability of a system’s energy to do work. It is a measure of the randomness of molecules in a system and is central to the second law of thermodynamics and the fundamental thermodynamic relation, which deal with physical processes and whether they occur spontaneously. The dimensions of entropy are energy divided by temperature, which is the same as the dimensions of Boltzmann's constant ($kB$) and heat capacity. The SI unit of entropy is $joule\\ per\\ kelvin$. [Wikipedia]"^^<http://qudt.org/schema/qudt/LatexString>;
  skos:broader <http://qudt.org/vocab/quantitykind/EnergyPerTemperature>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L2I0M1H-1T-2D0>;
  <http://qudt.org/schema/qudt/isoNormativeReference> "http://www.iso.org/iso/catalogue_detail?csnumber=31890"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/applicableUnit> unit:KiloJ-PER-K .

<http://qudt.org/vocab/quantitykind/Thickness> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Thickness"@en;
  rdfs:comment "Applicable units are those of quantitykind:Length";
  dct:description "\"Thickness\" is the the smallest of three dimensions: length, width, thickness."^^<http://qudt.org/schema/qudt/LatexString>;
  skos:broader <http://qudt.org/vocab/quantitykind/Length>;
  <http://qudt.org/schema/qudt/dbpediaMatch> "http://dbpedia.org/resource/Thickness"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L1I0M0H0T0D0>;
  <http://qudt.org/schema/qudt/informativeReference> "http://www.merriam-webster.com/dictionary/thickness"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/symbol> "d";
  <http://qudt.org/schema/qudt/isoNormativeReference> "http://www.iso.org/iso/catalogue_detail?csnumber=43012"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/plainTextDescription> "\"Thickness\" is the the smallest of three dimensions: length, width, thickness.";
  <http://qudt.org/schema/qudt/applicableUnit> unit:ANGSTROM, unit:AU, unit:BTU_IT-PER-LB_F,
    unit:CH, unit:CHAIN_US, unit:CentiM, unit:DecaM, unit:DeciM, unit:FATH, unit:FM, unit:FemtoM,
    unit:FT, unit:FT_US, unit:FUR, unit:FUR_Long, unit:GAUGE_FR, unit:GA_Charriere, unit:HectoM,
    unit:IN, unit:KiloM, unit:LY, unit:M, unit:MI, unit:MI_N, unit:MI_US, unit:MicroIN,
    unit:MicroM, unit:MilLength, unit:MilliIN, unit:MilliM, unit:NanoM, unit:PARSEC, unit:PCA,
    unit:PT, unit:PicoM, unit:PlanckLength, unit:ROD, unit:YD, unit:ZOLL .

<http://qudt.org/vocab/quantitykind/ThrustCoefficient> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Thrust Coefficient"@en;
  dct:description "The thrust force of a jet-propulsion engine per unit of frontal area per unit of incompressible dynamic pressure "^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L-1I0M1H0T-2D0>;
  <http://qudt.org/schema/qudt/symbol> "C_{F}";
  <http://qudt.org/schema/qudt/plainTextDescription> "The thrust force of a jet-propulsion engine per unit of frontal area per unit of incompressible dynamic pressure " .

<http://qudt.org/vocab/quantitykind/ThrustToWeightRatio> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Thrust To Weight Ratio"@en;
  rdfs:comment "Applicable units are those of quantitykind:DimensionlessRatio";
  dct:description "Thrust-to-weight ratio is a ratio of thrust to weight of a rocket, jet engine, propeller engine, or a vehicle propelled by such an engine. It is a dimensionless quantity and is an indicator of the performance of the engine or vehicle."^^<http://qudt.org/schema/qudt/LatexString>;
  skos:broader <http://qudt.org/vocab/quantitykind/DimensionlessRatio>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1>;
  <http://qudt.org/schema/qudt/plainTextDescription> "Thrust-to-weight ratio is a ratio of thrust to weight of a rocket, jet engine, propeller engine, or a vehicle propelled by such an engine. It is a dimensionless quantity and is an indicator of the performance of the engine or vehicle.";
  <http://qudt.org/schema/qudt/latexSymbol> "$\\psi$"^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/applicableUnit> unit:FRACTION, unit:GR, unit:NUM, unit:PERCENT,
    unit:PERMITTIVITY_REL, unit:PPB, unit:PPM, unit:PPQ, unit:PPT, unit:PPTH, unit:PPTM,
    unit:PSU, unit:UNITLESS .

<http://qudt.org/vocab/quantitykind/Tilt> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Tilt"@en;
  rdfs:comment "Applicable units are those of quantitykind:Angle";
  dct:description """The angle between an object's orientation vector relative to a reference frame.  
  In the context of architecture, this would refer to the angle between the ground and the face of a surface.""";
  skos:broader <http://qudt.org/vocab/quantitykind/Angle>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1>;
  <http://qudt.org/schema/qudt/plainTextDescription> """The angle between an object's orientation vector relative to a reference frame.  
  In the context of architecture, this would refer to the angle between the ground and the face of a surface.""";
