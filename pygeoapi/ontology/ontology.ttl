  <http://qudt.org/schema/qudt/dimensionlessExponent> 0 .

<http://qudt.org/vocab/dimensionvector/A0E0L3I0M1H0T1D0> a <http://qudt.org/schema/qudt/QuantityKindDimensionVector>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/dimensionvector>;
  rdfs:label "A0E0L3I0M1H0T1D0";
  <http://qudt.org/schema/qudt/latexDefinition> "$L^3 M T $"^^<http://qudt.org/schema/qudt/LatexString>;
