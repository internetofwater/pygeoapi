<http://qudt.org/vocab/quantitykind/LogarithmicFrequencyIntervalToBase10> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "logarithmic frequency interval to base 10"@en-US;
  dct:description "common logarithm of the ratio of two frequencies, whereby the frequency that forms the numerator is greater than the frequency that forms the denominator"@en;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1>;
  <http://qudt.org/schema/qudt/symbol> "0173-1#Z4-BAJ472#001";
  <http://qudt.org/schema/qudt/plainTextDescription> "dekadischer Logarithmus des Quotienten aus zwei Frequenzen, wobei die im Zähler stehende Frequenz größer als die Frequenz im Nenner ist"@de .

<http://qudt.org/vocab/quantitykind/LogarithmicMedianInformationFlow_SourceToBase10>
  a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "median information flow (from a source of information), expressed as a common logarithm "@en-US;
  dct:description "ratio of the median information content divided by the expected value for the duration of a character, expressed as a logarithm to base 10"@en;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T-1D0>;
  <http://qudt.org/schema/qudt/symbol> "0173-1#Z4-BAJ470#001";
  <http://qudt.org/schema/qudt/plainTextDescription> "Quotient mittlerer Informationsgehalt durch den Erwartungswert für die Dauer eines Zeichens, ausgedrückt als Logarithmus zur Basis 10"@de .

<http://qudt.org/vocab/quantitykind/LogarithmicMedianInformationFlow_SourceToBase2>
  a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "median information flow (from a source of information), expressed as a binary logarithm"@en-US;
  dct:description "ratio of the median information content divided by the expected value for the duration of a character, expressed as a logarithm to base 2"@en;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T-1D0>;
  <http://qudt.org/schema/qudt/symbol> "0173-1#Z4-BAJ464#001";
  <http://qudt.org/schema/qudt/plainTextDescription> "Quotient mittlerer Informationsgehalt durch den Erwartungswert für die Dauer eines Zeichens, ausgedrückt als Logarithmus zur Basis 2"@de .

<http://qudt.org/vocab/quantitykind/LogarithmicMedianInformationFlow_SourceToBaseE>
  a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "median information flow (from a source of information), expressed as a natural logarithm "@en-US;
  dct:description "ratio of the median information content divided by the expected value for the duration of a character, expressed as a logarithm to base e"@en;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T-1D0>;
  <http://qudt.org/schema/qudt/symbol> "0173-1#Z4-BAJ471#001";
  <http://qudt.org/schema/qudt/plainTextDescription> "Quotient mittlerer Informationsgehalt durch den Erwartungswert für die Dauer eines Zeichens, ausgedrückt als Logarithmus zur Basis e"@de .

<http://qudt.org/vocab/quantitykind/LondonPenetrationDepth> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "London Penetration Depth"@en;
  rdfs:comment "Applicable units are those of quantitykind:Length";
  dct:description "\"London Penetration Depth\" characterizes the distance to which a magnetic field penetrates into a superconductor and becomes equal to 1/e times that of the magnetic field at the surface of the superconductor."^^<http://qudt.org/schema/qudt/LatexString>;
  skos:broader <http://qudt.org/vocab/quantitykind/Length>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L1I0M0H0T0D0>;
  <http://qudt.org/schema/qudt/informativeReference> "http://en.wikipedia.org/wiki/London_penetration_depth"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/symbol> "λₗ";
  <http://qudt.org/schema/qudt/plainTextDescription> "\"London Penetration Depth\" characterizes the distance to which a magnetic field penetrates into a superconductor and becomes equal to 1/e times that of the magnetic field at the surface of the superconductor.";
  <http://qudt.org/schema/qudt/latexDefinition> "If an applied magnetic field is parallel to the plane surface of a semi-infinite superconductor, the field penetrates the superconductor according to the expression $B(x) = B(0) \\exp{(\\frac{-x}{\\lambda_L})}$, where $B$ is magnetic flux density and $x$ is the distance from the surface."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/applicableUnit> unit:ANGSTROM, unit:AU, unit:BTU_IT-PER-LB_F,
    unit:CH, unit:CHAIN_US, unit:CentiM, unit:DecaM, unit:DeciM, unit:FATH, unit:FM, unit:FemtoM,
    unit:FT, unit:FT_US, unit:FUR, unit:FUR_Long, unit:GAUGE_FR, unit:GA_Charriere, unit:HectoM,
    unit:IN, unit:KiloM, unit:LY, unit:M, unit:MI, unit:MI_N, unit:MI_US, unit:MicroIN,
    unit:MicroM, unit:MilLength, unit:MilliIN, unit:MilliM, unit:NanoM, unit:PARSEC, unit:PCA,
    unit:PT, unit:PicoM, unit:PlanckLength, unit:ROD, unit:YD, unit:ZOLL;
  <http://qudt.org/schema/qudt/normativeReference> "http://www.iso.org/iso/catalogue_detail?csnumber=31897"^^xsd:anyURI .

<http://qudt.org/vocab/quantitykind/LossAngle> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Loss Angle"@en;
  rdfs:comment "Applicable units are those of quantitykind:Angle";
  skos:broader <http://qudt.org/vocab/quantitykind/Angle>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1>;
  <http://qudt.org/schema/qudt/informativeReference> "http://www.iso.org/iso/home/store/catalogue_tc/catalogue_detail.htm?csnumber=31891"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/latexSymbol> "$\\delta$"^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/latexDefinition> "$\\delta = \\arctan d$, where $d$ is loss factor."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/applicableUnit> unit:ARCMIN, unit:MIN_Angle, unit:ARCSEC,
    unit:DEG, unit:GON, unit:GRAD, unit:MIL, unit:MicroRAD, unit:MilliARCSEC, unit:MilliRAD,
    unit:RAD, unit:REV .

<http://qudt.org/vocab/quantitykind/Loudness> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "loudness", "loudness"@en-US;
  rdfs:comment "Applicable units are those of quantitykind:Dimensionless";
  dct:description "measure of the subjective hearing sensation on a scale extending from soft to loud; a progressive mono-frequency (single-frequency) wave of frequency 1 kHz and sound pressure level 40 dB, directed head-on to hearers is assigned the loudness 1 sone, and a tone which is identified by the listeners as being n-times as loud as that identified by 1 sone is assigned the loudness n sone"@en;
  skos:broader <http://qudt.org/vocab/quantitykind/Dimensionless>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1>;
  <http://qudt.org/schema/qudt/iec61360Code> "0112/2///62720#UAD088";
  <http://qudt.org/schema/qudt/informativeReference> "https://cdd.iec.ch/cdd/iec61987/iec61987.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD088"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/symbol> "0173-1#Z4-BAJ334#002";
  <http://qudt.org/schema/qudt/plainTextDescription> "Maß für die Stärke der subjektiven Hörempfindung, welche auf einer Skala \"leise-laut\" in sone skaliert wird; einer frei fortschreitenden monofrequenten Welle mit der Frequenz 1 kHz und dem Schalldruckpegel 40 dB, die frontal auf die Zuhörer trifft, ist die Lautheit 1 sone zugeordnet und ein Laut, welcher von den Zuhörern als n-mal so laut wie derjenige mit 1 sone bezeichnet wird, erhält die Lautheit n sone zugeordnet"@de;
  <http://qudt.org/schema/qudt/applicableUnit> unit:DECADE, unit:FLIGHT, unit:GigaBasePair,
    unit:HeartBeat, unit:NP, unit:NUM, unit:OCT, unit:RPK, unit:SUSCEPTIBILITY_ELEC, unit:SUSCEPTIBILITY_MAG,
    unit:UNITLESS .

<http://qudt.org/vocab/quantitykind/LoudnessLevel> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "loudness level", "loudness level"@en-US;
  rdfs:comment "Applicable units are those of quantitykind:Dimensionless";
  dct:description "value specified in phon as a measure of the level of the subjective perception of a sound which corresponds to the sound pressure level of a reference sound specified in dB which comprises a wave coming from the front with a frequency of 1000 Hz and assessed to be just as loud as the noise"@en;
  skos:broader <http://qudt.org/vocab/quantitykind/Dimensionless>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1>;
  <http://qudt.org/schema/qudt/iec61360Code> "0112/2///62720#UAD089";
  <http://qudt.org/schema/qudt/informativeReference> "https://cdd.iec.ch/cdd/iec61987/iec61987.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD089"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/symbol> "0173-1#Z4-BAJ361#002";
  <http://qudt.org/schema/qudt/plainTextDescription> "in phon angegebener Wert als Maß für die Stärke der subjektiven Wahrnehmung eines Schallvorgange, der zahlenmäßig dem in dB angegebenen Schalldruckpegel eines Referenzschalls entspricht, der aus einer frontal einfallenden ebenen Welle mit der Frequenz 1000 Hz besteht und als gleich laut wie das Geräusch empfunden wird"@de;
  <http://qudt.org/schema/qudt/applicableUnit> unit:DECADE, unit:FLIGHT, unit:GigaBasePair,
    unit:HeartBeat, unit:NP, unit:NUM, unit:OCT, unit:RPK, unit:SUSCEPTIBILITY_ELEC, unit:SUSCEPTIBILITY_MAG,
    unit:UNITLESS .

<http://qudt.org/vocab/quantitykind/LowerCriticalMagneticFluxDensity> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Lower Critical Magnetic Flux Density"@en;
  rdfs:comment "Applicable units are those of quantitykind:MagneticFluxDensity";
  dct:description "\"Lower Critical Magnetic Flux Density\" for type II superconductors, is the threshold magnetic flux density for magnetic flux entering the superconductor."^^<http://qudt.org/schema/qudt/LatexString>;
  skos:broader <http://qudt.org/vocab/quantitykind/MagneticFluxDensity>;
  skos:closeMatch <http://qudt.org/vocab/quantitykind/UpperCriticalMagneticFluxDensity>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E-1L0I0M1H0T-2D0>;
  <http://qudt.org/schema/qudt/symbol> "B_{c1}";
  <http://qudt.org/schema/qudt/isoNormativeReference> "http://www.iso.org/iso/catalogue_detail?csnumber=31897"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/plainTextDescription> "\"Lower Critical Magnetic Flux Density\" for type II superconductors, is the threshold magnetic flux density for magnetic flux entering the superconductor.";
  <http://qudt.org/schema/qudt/applicableUnit> unit:GAUSS, unit:Gs, unit:T_Ab, unit:Gamma,
    unit:KiloGAUSS, unit:KiloT, unit:MicroT, unit:MilliT, unit:NanoT, unit:T .

<http://qudt.org/vocab/quantitykind/UpperCriticalMagneticFluxDensity> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Upper Critical Magnetic Flux Density"@en;
  rdfs:comment "Applicable units are those of quantitykind:MagneticFluxDensity";
  dct:description "\"Upper Critical Magnetic Flux Density\" for type II superconductors, is the threshold magnetic flux density for disappearance of bulk superconductivity."^^<http://qudt.org/schema/qudt/LatexString>;
  skos:broader <http://qudt.org/vocab/quantitykind/MagneticFluxDensity>;
  skos:closeMatch <http://qudt.org/vocab/quantitykind/LowerCriticalMagneticFluxDensity>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E-1L0I0M1H0T-2D0>;
  <http://qudt.org/schema/qudt/symbol> "B_{c2}";
  <http://qudt.org/schema/qudt/isoNormativeReference> "http://www.iso.org/iso/catalogue_detail?csnumber=31897"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/plainTextDescription> "\"Upper Critical Magnetic Flux Density\" for type II superconductors, is the threshold magnetic flux density for disappearance of bulk superconductivity.";
  <http://qudt.org/schema/qudt/applicableUnit> unit:GAUSS, unit:Gs, unit:T_Ab, unit:Gamma,
    unit:KiloGAUSS, unit:KiloT, unit:MicroT, unit:MilliT, unit:NanoT, unit:T .

<http://qudt.org/vocab/quantitykind/LuminousEmittance> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Luminous Emmitance"@en;
  rdfs:comment "Applicable units are those of quantitykind:LuminousFluxPerArea";
