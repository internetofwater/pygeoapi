unit:MicroCi a qudt:Unit ;
    rdfs:label "MicroCurie"@en ;
    dct:description "Another commonly used measure of radioactivity, the microcurie: $1 \\micro Ci = 3.7 \\times 10 disintegrations per second = 2.22 \\times 10 disintegrations per minute$. A radiotherapy machine may have roughly 1000 Ci of a radioisotope such as caesium-137 or cobalt-60. This quantity of radioactivity can produce serious health effects with only a few minutes of close-range, un-shielded exposure. The typical human body contains roughly $0.1\\micro Ci$ of naturally occurring potassium-40. "^^qudt:LatexString ;
    dct:isReplacedBy unit:MicroCI ;
    qudt:applicableSystem <http://qudt.org/vocab/sou/CGS> ;
    qudt:conversionMultiplier 37000.0 ;
    qudt:conversionMultiplierSN 3.7e+04 ;
    qudt:dbpediaMatch "http://dbpedia.org/resource/Curie"^^xsd:anyURI ;
    qudt:deprecated true ;
    qudt:hasDimensionVector dimensionvector:A0E0L0I0M0H0T-1D0 ;
    qudt:hasQuantityKind quantitykind:Activity ;
    qudt:iec61360Code "0112/2///62720#UAA062" ;
    qudt:informativeReference "http://en.wikipedia.org/wiki/Curie?oldid=495080313"^^xsd:anyURI,
        "https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAA062"^^xsd:anyURI ;
    qudt:prefix <http://qudt.org/vocab/prefix/Micro> ;
    qudt:scalingOf unit:CI ;
    qudt:symbol "μCi" ;
    qudt:ucumCode "uCi"^^qudt:UCUMcs ;
    qudt:uneceCommonCode "M5" ;
    rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/unit>,
        <http://qudt.org/vocab/unit> .

