unit:WB a qudt:Unit, qudt:Unit, qudt:DerivedUnit, qudt:DerivedUnit;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/unit>, <http://qudt.org/vocab/unit>;
  rdfs:label "Weber"@de, "Weber"@de, "weber"@cs, "weber"@cs, "weber"@en, "weber"@en,
    "weber"@es, "weber"@es, "weber"@fr, "weber"@fr, "weber"@hu, "weber"@hu, "weber"@it,
    "weber"@it, "weber"@ms, "weber"@ms, "weber"@pl, "weber"@pl, "weber"@pt, "weber"@pt,
    "weber"@ro, "weber"@ro, "weber"@sl, "weber"@sl, "weber"@tr, "weber"@tr, "weberium"@la,
    "weberium"@la, "βέμπερ"@el, "βέμπερ"@el, "вебер"@bg, "вебер"@bg, "вебер"@ru, "вебер"@ru,
    "ובר"@he, "ובר"@he, "وبر"@fa, "وبر"@fa, "ويبر; فيبر"@ar, "ويبر; فيبر"@ar, "वैबर"@hi,
    "वैबर"@hi, "ウェーバ"@ja, "ウェーバ"@ja, "韦伯"@zh, "韦伯"@zh;
  dct:description "The SI unit of magnetic flux. \"Flux\" is the rate (per unit of time) at which something crosses a surface perpendicular to the flow. The weber is a large unit, equal to $10^{8}$ maxwells, and practical fluxes are usually fractions of one weber. The weber is the magnetic flux which, linking a circuit of one turn, would produce in it an electromotive force of 1 volt if it were reduced to zero at a uniform rate in 1 second. In SI base units, the dimensions of the weber are $(kg \\cdot m^2)/(s^2 \\cdot A)$. The weber is commonly expressed in terms of other derived units as the Tesla-square meter ($T \\cdot m^2$), volt-seconds ($V \\cdot s$), or joules per ampere ($J/A$)."^^qudt:LatexString,
    "The SI unit of magnetic flux. \"Flux\" is the rate (per unit of time) at which something crosses a surface perpendicular to the flow. The weber is a large unit, equal to $10^{8}$ maxwells, and practical fluxes are usually fractions of one weber. The weber is the magnetic flux which, linking a circuit of one turn, would produce in it an electromotive force of 1 volt if it were reduced to zero at a uniform rate in 1 second. In SI base units, the dimensions of the weber are $(kg \\cdot m^2)/(s^2 \\cdot A)$. The weber is commonly expressed in terms of other derived units as the Tesla-square meter ($T \\cdot m^2$), volt-seconds ($V \\cdot s$), or joules per ampere ($J/A$)."^^qudt:LatexString;
  qudt:applicableSystem <http://qudt.org/vocab/sou/CGS-EMU>, <http://qudt.org/vocab/sou/CGS-EMU>,
    <http://qudt.org/vocab/sou/CGS-GAUSS>, <http://qudt.org/vocab/sou/CGS-GAUSS>, <http://qudt.org/vocab/sou/SI>,
    <http://qudt.org/vocab/sou/SI>;
  qudt:conversionMultiplier 1.0, 1.0;
  qudt:conversionMultiplierSN 1.0E0, 1.0E0;
  qudt:dbpediaMatch "http://dbpedia.org/resource/Weber"^^xsd:anyURI, "http://dbpedia.org/resource/Weber"^^xsd:anyURI;
  qudt:hasDimensionVector dimensionvector:A0E-1L2I0M1H0T-2D0, dimensionvector:A0E-1L2I0M1H0T-2D0;
  qudt:hasQuantityKind quantitykind:MagneticFlux, quantitykind:MagneticFlux;
  qudt:iec61360Code "0112/2///62720#UAA317", "0112/2///62720#UAA317";
  qudt:informativeReference "https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAA317"^^xsd:anyURI,
    "https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAA317"^^xsd:anyURI,
