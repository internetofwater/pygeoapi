<http://qudt.org/vocab/quantitykind/LengthRatio> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Length Ratio"@en;
  rdfs:comment "Applicable units are those of quantitykind:LengthRatio";
  skos:broader <http://qudt.org/vocab/quantitykind/DimensionlessRatio>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1>;
  <http://qudt.org/schema/qudt/qkdvDenominator> <http://qudt.org/vocab/dimensionvector/A0E0L1I0M0H0T0D0>;
  <http://qudt.org/schema/qudt/qkdvNumerator> <http://qudt.org/vocab/dimensionvector/A0E0L1I0M0H0T0D0>;
  <http://qudt.org/schema/qudt/applicableUnit> unit:PERCENT .

<http://qudt.org/vocab/quantitykind/LuminousFluxRatio> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Luminous Flux Ratio"@en;
  rdfs:comment "Applicable units are those of quantitykind:LuminousFluxRatio";
  dct:description "Luminous Flux Ratio (or Relative Luminous Flux or Relative Luminous Power) is the measure of the perceived power of light. It differs from radiant flux, the measure of the total power of light emitted, in that luminous flux is adjusted to reflect the varying sensitivity of the human eye to different wavelengths of light. It is expressed as a percentage or fraction of full power."^^<http://qudt.org/schema/qudt/LatexString>;
  skos:broader <http://qudt.org/vocab/quantitykind/DimensionlessRatio>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1>;
  <http://qudt.org/schema/qudt/informativeReference> "http://en.wikipedia.org/wiki/Luminous_flux"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/plainTextDescription> "Luminous Flux Ratio (or Relative Luminous Flux or Relative Luminous Power) is the measure of the perceived power of light. It differs from radiant flux, the measure of the total power of light emitted, in that luminous flux is adjusted to reflect the varying sensitivity of the human eye to different wavelengths of light. It is expressed as a percentage or fraction of full power.";
  <http://qudt.org/schema/qudt/qkdvDenominator> <http://qudt.org/vocab/dimensionvector/A0E0L2I0M1H0T-3D0>;
  <http://qudt.org/schema/qudt/qkdvNumerator> <http://qudt.org/vocab/dimensionvector/A0E0L2I0M1H0T-3D0>;
  <http://qudt.org/schema/qudt/applicableUnit> unit:PERCENT .

<http://qudt.org/vocab/quantitykind/Prevalence> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Prevalence"@en;
  rdfs:comment "Applicable units are those of quantitykind:Prevalence";
  dct:description "In epidemiology, prevalence is the proportion of a particular population found to be affected by a medical condition (typically a disease or a risk factor such as smoking or seatbelt use) at a specific time. (Wikipedia)"^^<http://qudt.org/schema/qudt/LatexString>;
  skos:broader <http://qudt.org/vocab/quantitykind/DimensionlessRatio>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1>;
  <http://qudt.org/schema/qudt/informativeReference> "https://en.wikipedia.org/wiki/Prevalence"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/plainTextDescription> "In epidemiology, prevalence is the proportion of a particular population found to be affected by a medical condition (typically a disease or a risk factor such as smoking or seatbelt use) at a specific time. (Wikipedia)";
  <http://qudt.org/schema/qudt/qkdvDenominator> <http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1>;
  <http://qudt.org/schema/qudt/qkdvNumerator> <http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1>;
  <http://qudt.org/schema/qudt/applicableUnit> unit:PERCENT .

<http://qudt.org/vocab/quantitykind/RelativeHumidity> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:seeAlso <http://qudt.org/vocab/quantitykind/AbsoluteHumidity>;
  rdfs:label "Relative Humidity"@en;
  rdfs:comment "Applicable units are those of quantitykind:RelativeHumidity";
  dct:description """
  $\\textit{Relative Humidity}$ is the ratio of the partial pressure of water vapor in an air-water mixture to the saturated vapor pressure of water at a prescribed temperature. 
  The relative humidity of air depends not only on temperature but also on the pressure of the system of interest. 
  $$$$
  $\\textit{Relative Humidity}$ is also referred to as $\\textit{Relative Partial Pressure}$. 
  $$$$
  Relative partial pressure is often referred to as $RH$ and expressed in percent.
  """^^<http://qudt.org/schema/qudt/LatexString>;
  skos:altLabel "RH";
  skos:broader <http://qudt.org/vocab/quantitykind/RelativePartialPressure>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1>;
  <http://qudt.org/schema/qudt/informativeReference> "http://en.wikipedia.org/wiki/Relative_humidity"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/isoNormativeReference> "http://www.iso.org/iso/catalogue_detail?csnumber=31890"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/latexSymbol> "$\\varphi$"^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/latexDefinition> "$\\varphi = p / p_{sat}$, where $p$ is partial pressure of vapour,  $p_{sat}$ is thermodynamic temperature and $V$ is its partial pressure at saturation (at the same temperature). Relative partial pressure is often referred to as $RH$ and expressed in percent. $\\textit{Relative Humidity}$ is also referred to as $\\textit{Relative Partial Pressure}$."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/applicableUnit> unit:PERCENT, unit:PERCENT_RH .

<http://qudt.org/vocab/quantitykind/RelativePartialPressure> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Relative Partial Pressure"@en;
  rdfs:comment "Applicable units are those of quantitykind:RelativePartialPressure";
  skos:altLabel "RH";
  skos:broader <http://qudt.org/vocab/quantitykind/PressureRatio>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1>;
  <http://qudt.org/schema/qudt/isoNormativeReference> "http://www.iso.org/iso/catalogue_detail?csnumber=31890"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/latexSymbol> "$\\varphi$"^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/latexDefinition> "$\\varphi = p / p_{sat}$, where $p$ is partial pressure of vapour,  $p_{sat}$ is thermodynamic temperature and $V$ is its partial pressure at saturation (at the same temperature). Relative partial pressure is often referred to as $RH$ and expressed in percent. $\\textit{Relative Partial Pressure}$ is also referred to as $\\textit{Relative Humidity}$."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/applicableUnit> unit:PERCENT .

<http://qudt.org/vocab/quantitykind/ResistanceRatio> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Resistance Ratio"@en;
  rdfs:comment "Applicable units are those of quantitykind:ResistanceRatio";
  skos:broader <http://qudt.org/vocab/quantitykind/DimensionlessRatio>;
