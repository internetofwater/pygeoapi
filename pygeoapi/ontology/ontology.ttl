unit:MHO_Stat a qudt:Unit, qudt:Unit;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/unit>, <http://qudt.org/vocab/unit>;
  rdfs:label "Statmho"@en, "Statmho"@en;
  dct:description "\"StatMHO\" is the unit of conductance, admittance, and susceptance in the C.G.S e.s.u system of units. One $statmho$ is the conductance between two points in a conductor when a constant potential difference of $1 \\; statvolt$ applied between the points produces in the conductor a current of $1 \\; statampere$, the conductor not being the source of any electromotive force, approximately $1.1126 \\times 10^{-12} mho$."^^qudt:LatexString,
    "\"StatMHO\" is the unit of conductance, admittance, and susceptance in the C.G.S e.s.u system of units. One $statmho$ is the conductance between two points in a conductor when a constant potential difference of $1 \\; statvolt$ applied between the points produces in the conductor a current of $1 \\; statampere$, the conductor not being the source of any electromotive force, approximately $1.1126 \\times 10^{-12} mho$."^^qudt:LatexString;
  qudt:applicableSystem <http://qudt.org/vocab/sou/SI>, <http://qudt.org/vocab/sou/SI>,
    <http://qudt.org/vocab/sou/CGS>, <http://qudt.org/vocab/sou/CGS>;
  qudt:conversionMultiplier 0.0000000000011126500561, 0.0000000000011126500561;
  qudt:conversionMultiplierSN 1.1126500561E-12, 1.1126500561E-12;
  qudt:hasDimensionVector dimensionvector:A0E2L-3I0M-1H0T3D0, dimensionvector:A0E2L-3I0M-1H0T3D0;
  qudt:hasQuantityKind quantitykind:ElectricConductivity, quantitykind:ElectricConductivity;
  qudt:informativeReference "http://www.sizes.com/units/statmho.htm"^^xsd:anyURI, "http://www.sizes.com/units/statmho.htm"^^xsd:anyURI;
  qudt:omUnit <http://www.ontology-of-units-of-measure.org/resource/om-2/statmho>, <http://www.ontology-of-units-of-measure.org/resource/om-2/statmho>;
  qudt:symbol "stat℧", "stat℧";
  qudt:exactMatch unit:S_Stat, unit:S_Stat;
