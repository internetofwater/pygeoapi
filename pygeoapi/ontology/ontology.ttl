<http://qudt.org/vocab/quantitykind/BitDataVolume> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "bit data volume"@en-US;
