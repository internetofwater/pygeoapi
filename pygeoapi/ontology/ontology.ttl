  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "Akım yoğunluğu"@tr, "Akım yoğunluğu"@tr, "Densitate de curent"@ro, "Densitate de curent"@ro,
