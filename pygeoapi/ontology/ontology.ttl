unit:MicroT a <http://qudt.org/schema/qudt/Unit>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/unit>;
  rdfs:label "Microtesla"@en;
  dct:description "0.000001-fold of the SI derived unit tesla"^^rdf:HTML;
  <http://qudt.org/schema/qudt/applicableSystem> <http://qudt.org/vocab/sou/CGS-EMU>,
