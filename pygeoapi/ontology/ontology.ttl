quantitykind:Impedance a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:seeAlso quantitykind:ElectricCurrentPhasor, quantitykind:ElectricCurrentPhasor,
    quantitykind:VoltagePhasor, quantitykind:VoltagePhasor;
  rdfs:label "Impedance"@en, "Impedance"@en;
  rdfs:comment "Applicable units are those of quantitykind:Impedance", "Applicable units are those of quantitykind:Impedance";
  dct:description "\"Impedance\" is the measure of the opposition that a circuit presents to the passage of a current when a voltage is applied. In quantitative terms, it is the complex ratio of the voltage to the current in an alternating current (AC) circuit. Impedance extends the concept of resistance to AC circuits, and possesses both magnitude and phase, unlike resistance, which has only magnitude. When a circuit is driven with direct current (DC), there is no distinction between impedance and resistance; the latter can be thought of as impedance with zero phase angle."^^qudt:LatexString,
    "\"Impedance\" is the measure of the opposition that a circuit presents to the passage of a current when a voltage is applied. In quantitative terms, it is the complex ratio of the voltage to the current in an alternating current (AC) circuit. Impedance extends the concept of resistance to AC circuits, and possesses both magnitude and phase, unlike resistance, which has only magnitude. When a circuit is driven with direct current (DC), there is no distinction between impedance and resistance; the latter can be thought of as impedance with zero phase angle."^^qudt:LatexString;
  qudt:dbpediaMatch "http://dbpedia.org/resource/Electrical_impedance"^^xsd:anyURI,
    "http://dbpedia.org/resource/Electrical_impedance"^^xsd:anyURI;
  qudt:hasDimensionVector dimensionvector:A0E-2L2I0M1H0T-3D0, dimensionvector:A0E-2L2I0M1H0T-3D0;
  qudt:informativeReference "http://www.iso.org/iso/home/store/catalogue_tc/catalogue_detail.htm?csnumber=31891"^^xsd:anyURI,
    "http://www.iso.org/iso/home/store/catalogue_tc/catalogue_detail.htm?csnumber=31891"^^xsd:anyURI,
    "http://en.wikipedia.org/wiki/Electrical_impedance"^^xsd:anyURI, "http://en.wikipedia.org/wiki/Electrical_impedance"^^xsd:anyURI,
    "http://www.electropedia.org/iev/iev.nsf/display?openform&ievref=131-12-43"^^xsd:anyURI,
    "http://www.electropedia.org/iev/iev.nsf/display?openform&ievref=131-12-43"^^xsd:anyURI;
  qudt:isoNormativeReference "http://www.iso.org/iso/catalogue_detail?csnumber=43012"^^xsd:anyURI,
    "http://www.iso.org/iso/catalogue_detail?csnumber=43012"^^xsd:anyURI;
  qudt:plainTextDescription "\"Impedance\" is the measure of the opposition that a circuit presents to the passage of a current when a voltage is applied. In quantitative terms, it is the complex ratio of the voltage to the current in an alternating current (AC) circuit. Impedance extends the concept of resistance to AC circuits, and possesses both magnitude and phase, unlike resistance, which has only magnitude. When a circuit is driven with direct current (DC), there is no distinction between impedance and resistance; the latter can be thought of as impedance with zero phase angle.",
    "\"Impedance\" is the measure of the opposition that a circuit presents to the passage of a current when a voltage is applied. In quantitative terms, it is the complex ratio of the voltage to the current in an alternating current (AC) circuit. Impedance extends the concept of resistance to AC circuits, and possesses both magnitude and phase, unlike resistance, which has only magnitude. When a circuit is driven with direct current (DC), there is no distinction between impedance and resistance; the latter can be thought of as impedance with zero phase angle.";
  qudt:latexSymbol "$\\underline{Z}$"^^qudt:LatexString, "$\\underline{Z}$"^^qudt:LatexString;
  qudt:latexDefinition "$\\underline{Z} = \\underline{U} / \\underline{I}$, where $\\underline{U}$ is the voltage phasor and $\\underline{I}$ is the electric current phasor."^^qudt:LatexString,
    "$\\underline{Z} = \\underline{U} / \\underline{I}$, where $\\underline{U}$ is the voltage phasor and $\\underline{I}$ is the electric current phasor."^^qudt:LatexString;
  qudt:applicableUnit unit:OHM, unit:OHM .

quantitykind:ModulusOfImpedance a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:seeAlso quantitykind:Impedance, quantitykind:Impedance;
  rdfs:label "Modulus Of Impedance"@en, "Modulus Of Impedance"@en;
  rdfs:comment "Applicable units are those of quantitykind:ModulusOfImpedance", "Applicable units are those of quantitykind:ModulusOfImpedance";
  dct:description """\"Modulus Of Impedance} is the absolute value of the quantity $\\textit{impedance}$. Apparent impedance is defined more generally as

the quotient of rms voltage and rms electric current; it is often denoted by $Z$."""^^qudt:LatexString,
    """\"Modulus Of Impedance} is the absolute value of the quantity $\\textit{impedance}$. Apparent impedance is defined more generally as

the quotient of rms voltage and rms electric current; it is often denoted by $Z$."""^^qudt:LatexString;
  qudt:hasDimensionVector dimensionvector:A0E-2L2I0M1H0T-3D0, dimensionvector:A0E-2L2I0M1H0T-3D0;
  qudt:informativeReference "http://www.iso.org/iso/home/store/catalogue_tc/catalogue_detail.htm?csnumber=31891"^^xsd:anyURI,
    "http://www.iso.org/iso/home/store/catalogue_tc/catalogue_detail.htm?csnumber=31891"^^xsd:anyURI,
    "http://en.wikipedia.org/wiki/Electrical_impedance"^^xsd:anyURI, "http://en.wikipedia.org/wiki/Electrical_impedance"^^xsd:anyURI,
    "http://en.wikipedia.org/wiki/Absolute_value"^^xsd:anyURI, "http://en.wikipedia.org/wiki/Absolute_value"^^xsd:anyURI;
  qudt:symbol "Z", "Z";
  qudt:latexDefinition "$Z = \\left | \\underline{Z} \\right |$, where $\\underline{Z}$ is impedance."^^qudt:LatexString,
    "$Z = \\left | \\underline{Z} \\right |$, where $\\underline{Z}$ is impedance."^^qudt:LatexString;
  qudt:applicableUnit unit:OHM, unit:OHM .

quantitykind:Reactance a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:seeAlso quantitykind:Impedance, quantitykind:Impedance;
  rdfs:label "Reactance"@en, "Reactance"@en;
  rdfs:comment "Applicable units are those of quantitykind:Reactance", "Applicable units are those of quantitykind:Reactance";
  dct:description """
  $\\textit{Reactance}$ is the opposition of a circuit element to a change of electric current or voltage,
   due to that element's inductance or capacitance. 
  A built-up electric field resists the change of voltage on the element,
   while a magnetic field resists the change of current. 
  The notion of reactance is similar to electrical resistance, but they differ in several respects. 
  Capacitance and inductance are inherent properties of an element, just like resistance.
  """^^qudt:LatexString,
    """
  $\\textit{Reactance}$ is the opposition of a circuit element to a change of electric current or voltage,
   due to that element's inductance or capacitance. 
  A built-up electric field resists the change of voltage on the element,
   while a magnetic field resists the change of current. 
  The notion of reactance is similar to electrical resistance, but they differ in several respects. 
  Capacitance and inductance are inherent properties of an element, just like resistance.
  """^^qudt:LatexString;
  qudt:dbpediaMatch "http://dbpedia.org/resource/Electrical_reactance"^^xsd:anyURI,
    "http://dbpedia.org/resource/Electrical_reactance"^^xsd:anyURI;
  qudt:hasDimensionVector dimensionvector:A0E-2L2I0M1H0T-3D0, dimensionvector:A0E-2L2I0M1H0T-3D0;
  qudt:informativeReference "http://www.iso.org/iso/home/store/catalogue_tc/catalogue_detail.htm?csnumber=31891"^^xsd:anyURI,
    "http://www.iso.org/iso/home/store/catalogue_tc/catalogue_detail.htm?csnumber=31891"^^xsd:anyURI,
    "http://en.wikipedia.org/wiki/Electrical_reactance?oldid=494180019"^^xsd:anyURI, "http://en.wikipedia.org/wiki/Electrical_reactance?oldid=494180019"^^xsd:anyURI,
    "http://www.electropedia.org/iev/iev.nsf/display?openform&ievref=131-12-46"^^xsd:anyURI,
    "http://www.electropedia.org/iev/iev.nsf/display?openform&ievref=131-12-46"^^xsd:anyURI;
  qudt:symbol "X", "X";
  qudt:plainTextDescription "\"Reactance\" is the opposition of a circuit element to a change of electric current or voltage, due to that element's inductance or capacitance. A built-up electric field resists the change of voltage on the element, while a magnetic field resists the change of current. The notion of reactance is similar to electrical resistance, but they differ in several respects. Capacitance and inductance are inherent properties of an element, just like resistance.",
    "\"Reactance\" is the opposition of a circuit element to a change of electric current or voltage, due to that element's inductance or capacitance. A built-up electric field resists the change of voltage on the element, while a magnetic field resists the change of current. The notion of reactance is similar to electrical resistance, but they differ in several respects. Capacitance and inductance are inherent properties of an element, just like resistance.";
  qudt:latexDefinition "$X = im \\underline{Z}$, where $\\underline{Z}$ is impedance and $im$ denotes the imaginary part."^^qudt:LatexString,
    "$X = im \\underline{Z}$, where $\\underline{Z}$ is impedance and $im$ denotes the imaginary part."^^qudt:LatexString;
  qudt:applicableUnit unit:OHM, unit:OHM .

