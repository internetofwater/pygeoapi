  qudt:hasQuantityKind quantitykind:Dimensionless, quantitykind:Dimensionless;
  qudt:iec61360Code "0112/2///62720#UAA253", "0112/2///62720#UAA253";
  qudt:informativeReference "https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAA253"^^xsd:anyURI,
    "https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAA253"^^xsd:anyURI,
    "https://en.wikipedia.org/wiki/Neper"^^xsd:anyURI, "https://en.wikipedia.org/wiki/Neper"^^xsd:anyURI;
  qudt:siExactMatch <https://si-digital-framework.org/SI/units/neper>, <https://si-digital-framework.org/SI/units/neper>;
  qudt:symbol "Np", "Np";
  qudt:ucumCode "Np"^^qudt:UCUMcs, "Np"^^qudt:UCUMcs;
