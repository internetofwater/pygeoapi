variablename:europium a skos:Concept ;
    skos:definition "Europium is a chemical element with symbol Eu and atomic number 63. It was isolated in 1901 and is named after the continent of Europe. It is a moderately hard, silvery metal which readily oxidizes in air and water." ;
    skos:exactMatch "https://en.wikipedia.org/wiki/Europium" ;
    skos:historyNote "Wikipedia" ;
    skos:inScheme <http://vocabulary.odm2.org/variablename> ;
    skos:note "Added to support Critical Zone Observatory (CZO) data use cases. " ;
    skos:prefLabel "Europium" ;
    skos:topConceptOf <http://vocabulary.odm2.org/variablename> .

