  qudt:definedUnitOfSystem <http://qudt.org/vocab/sou/SI>, <http://qudt.org/vocab/sou/SI>;
  qudt:siUnitsExpression "cd.sr", "cd.sr";
  qudt:hasFactorUnit _:b1cb43fcbd504833bf8a964862c3127016870, _:b1cb43fcbd504833bf8a964862c3127016871 .

