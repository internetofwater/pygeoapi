quantitykind:SpeedRatio a qudt:QuantityKind ;
    rdfs:label "Speed Ratio"@en ;
    dct:description "Speed ratio generally refers to the ratio of the rotational speeds of two interconnected rotating components, but it sometimes relates linear speeds." ;
