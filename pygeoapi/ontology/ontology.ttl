variablename:hail a skos:Concept;
  skos:definition "Hail is a form of solid precipitation. It is distinct from ice pellets (American English \"sleet\"), though the two are often confused. It consists of balls or irregular lumps of ice, each of which is called a hailstone.";
  skos:inScheme <http://vocabulary.odm2.org/variablename>;
