unit:MegaHZ-M a <http://qudt.org/schema/qudt/Unit>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/unit>;
  rdfs:label "Megahertz Meter"@en-US, "Megahertz Metre"@en;
