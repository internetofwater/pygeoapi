    "https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAA275"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/symbol> "R";
  <http://qudt.org/schema/qudt/ucumCode> "R"^^<http://qudt.org/schema/qudt/UCUMcs>;
  <http://qudt.org/schema/qudt/udunitsCode> "R";
