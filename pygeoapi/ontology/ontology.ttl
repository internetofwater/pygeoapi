    unit:SUSCEPTIBILITY_MAG, unit:SUSCEPTIBILITY_MAG, unit:UNITLESS, unit:UNITLESS, unit:COUNT .

quantitykind:LoudnessLevel a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "loudness level", "loudness level", "loudness level"@en-US, "loudness level"@en-US;
  rdfs:comment "Applicable units are those of quantitykind:Dimensionless", "Applicable units are those of quantitykind:Dimensionless";
  dct:description "value specified in phon as a measure of the level of the subjective perception of a sound which corresponds to the sound pressure level of a reference sound specified in dB which comprises a wave coming from the front with a frequency of 1000 Hz and assessed to be just as loud as the noise"@en,
    "value specified in phon as a measure of the level of the subjective perception of a sound which corresponds to the sound pressure level of a reference sound specified in dB which comprises a wave coming from the front with a frequency of 1000 Hz and assessed to be just as loud as the noise"@en;
  skos:broader quantitykind:Dimensionless, quantitykind:Dimensionless;
  qudt:hasDimensionVector dimensionvector:A0E0L0I0M0H0T0D1, dimensionvector:A0E0L0I0M0H0T0D1;
