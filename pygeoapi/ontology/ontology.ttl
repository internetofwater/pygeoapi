unit:MilliARCSEC a qudt:Unit, qudt:Unit, qudt:DerivedUnit, qudt:DerivedUnit;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/unit>, <http://qudt.org/vocab/unit>;
  rdfs:label "Milli ArcSecond"@en, "Milli ArcSecond"@en;
  dct:description "A minute of arc, arcminute, or minute arc (MOA), is a unit of angular measurement equal to one sixtieth (1/60) of one degree (circle/21,600), or $\\pi /10,800 radians$. In turn, a second of arc or arcsecond is one sixtieth (1/60) of one minute of arc. Since one degree is defined as one three hundred and sixtieth (1/360) of a rotation, one minute of arc is 1/21,600 of a rotation.  the milliarcsecond, abbreviated mas, is used in astronomy."^^qudt:LatexString,
    "A minute of arc, arcminute, or minute arc (MOA), is a unit of angular measurement equal to one sixtieth (1/60) of one degree (circle/21,600), or $\\pi /10,800 radians$. In turn, a second of arc or arcsecond is one sixtieth (1/60) of one minute of arc. Since one degree is defined as one three hundred and sixtieth (1/360) of a rotation, one minute of arc is 1/21,600 of a rotation.  the milliarcsecond, abbreviated mas, is used in astronomy."^^qudt:LatexString;
  qudt:applicableSystem <http://qudt.org/vocab/sou/USCS>, <http://qudt.org/vocab/sou/USCS>;
  qudt:conversionMultiplier 0.00000000484813681, 0.00000000484813681;
  qudt:conversionMultiplierSN 4.84813681E-9, 4.84813681E-9;
  qudt:hasDimensionVector dimensionvector:A0E0L0I0M0H0T0D1, dimensionvector:A0E0L0I0M0H0T0D1;
  qudt:hasQuantityKind quantitykind:Angle, quantitykind:Angle, quantitykind:PlaneAngle,
    quantitykind:PlaneAngle;
  qudt:informativeReference "http://en.wikipedia.org/wiki/Minute_of_arc"^^xsd:anyURI,
    "http://en.wikipedia.org/wiki/Minute_of_arc"^^xsd:anyURI;
  qudt:symbol "mas", "mas";
  qudt:ucumCode "m''"^^qudt:UCUMcs, "m''"^^qudt:UCUMcs;
  qudt:prefix <http://qudt.org/vocab/prefix/Milli>;
  qudt:scalingOf unit:ARCSEC .

