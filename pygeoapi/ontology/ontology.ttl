<http://qudt.org/vocab/quantitykind/LiftCoefficient> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Lift Coefficient"@en;
  rdfs:comment "Applicable units are those of quantitykind:Dimensionless";
  dct:description "The lift coefficient is a dimensionless coefficient that relates the lift generated by a lifting body, the dynamic pressure of the fluid flow around the body, and a reference area associated with the body."^^<http://qudt.org/schema/qudt/LatexString>;
  skos:broader <http://qudt.org/vocab/quantitykind/Dimensionless>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1>;
  <http://qudt.org/schema/qudt/symbol> "C_{L}";
  <http://qudt.org/schema/qudt/plainTextDescription> "The lift coefficient is a dimensionless coefficient that relates the lift generated by a lifting body, the dynamic pressure of the fluid flow around the body, and a reference area associated with the body.";
  <http://qudt.org/schema/qudt/applicableUnit> unit:DECADE, unit:FLIGHT, unit:GigaBasePair,
    unit:HeartBeat, unit:NP, unit:NUM, unit:OCT, unit:RPK, unit:SUSCEPTIBILITY_ELEC, unit:SUSCEPTIBILITY_MAG,
    unit:UNITLESS .

<http://qudt.org/vocab/quantitykind/LiftForce> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Lift Force"@en;
  rdfs:comment "Applicable units are those of quantitykind:Force";
  dct:description "The lift force, lifting force or simply lift is the sum of all the forces on a body that force it to move perpendicular to the direction of flow."^^<http://qudt.org/schema/qudt/LatexString>;
  skos:broader <http://qudt.org/vocab/quantitykind/Force>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L1I0M1H0T-2D0>;
  <http://qudt.org/schema/qudt/symbol> "L";
  <http://qudt.org/schema/qudt/plainTextDescription> "The lift force, lifting force or simply lift is the sum of all the forces on a body that force it to move perpendicular to the direction of flow.";
  <http://qudt.org/schema/qudt/applicableUnit> unit:CentiN, unit:DYN, unit:DeciN, unit:GM_F,
    unit:KIP_F, unit:KiloGM-M-PER-SEC2, unit:N, unit:KiloGM_F, unit:KiloPOND, unit:KiloLB_F,
    unit:KiloN, unit:LB_F, unit:MegaLB_F, unit:MegaN, unit:MicroN, unit:MilliN, unit:OZ_F,
