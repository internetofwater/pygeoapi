quantitykind:HallCoefficient a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "Hall Coefficient"@en, "Hall Coefficient"@en;
  rdfs:comment "Applicable units are those of quantitykind:HallCoefficient", "Applicable units are those of quantitykind:HallCoefficient";
  dct:description "\"Hall Coefficient\" is defined as the ratio of the induced electric field to the product of the current density and the applied magnetic field."^^qudt:LatexString,
    "\"Hall Coefficient\" is defined as the ratio of the induced electric field to the product of the current density and the applied magnetic field."^^qudt:LatexString;
  qudt:hasDimensionVector dimensionvector:A0E-1L3I0M0H0T-1D0, dimensionvector:A0E-1L3I0M0H0T-1D0;
  qudt:iec61360Code "0112/2///62720#UAD060", "0112/2///62720#UAD060";
  qudt:informativeReference "http://en.wikipedia.org/wiki/Hall_effect"^^xsd:anyURI,
    "http://en.wikipedia.org/wiki/Hall_effect"^^xsd:anyURI, "https://cdd.iec.ch/cdd/iec61987/iec61987.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD060"^^xsd:anyURI,
    "https://cdd.iec.ch/cdd/iec61987/iec61987.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD060"^^xsd:anyURI;
  qudt:symbol "R_H, A_H", "R_H, A_H";
  qudt:isoNormativeReference "http://www.iso.org/iso/catalogue_detail?csnumber=31897"^^xsd:anyURI,
    "http://www.iso.org/iso/catalogue_detail?csnumber=31897"^^xsd:anyURI;
  qudt:plainTextDescription "\"Hall Coefficient\" is defined as the ratio of the induced electric field to the product of the current density and the applied magnetic field.",
    "\"Hall Coefficient\" is defined as the ratio of the induced electric field to the product of the current density and the applied magnetic field.";
  qudt:latexDefinition "In an isotropic conductor, the relation between electric field strength, $E$, and electric current density, $J$ is $E = \\rho J + R_H(B X J)$, where $\\rho$ is resistivity, and $B$ is magnetic flux density."^^qudt:LatexString,
    "In an isotropic conductor, the relation between electric field strength, $E$, and electric current density, $J$ is $E = \\rho J + R_H(B X J)$, where $\\rho$ is resistivity, and $B$ is magnetic flux density."^^qudt:LatexString;
  qudt:applicableUnit unit:M3-PER-C, unit:M3-PER-C, unit:V-IN2-PER-LB_F, unit:V-IN2-PER-LB_F,
    unit:V-PER-BAR, unit:V-PER-BAR, unit:V-PER-PA, unit:V-PER-PA .

