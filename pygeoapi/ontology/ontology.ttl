<http://qudt.org/vocab/quantitykind/IntinsicCarrierDensity> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Intinsic Carrier Density"@en;
  rdfs:comment "Applicable units are those of quantitykind:NumberDensity";
  dct:description "\"Intinsic Carrier Density\" is proportional to electron and hole densities."^^<http://qudt.org/schema/qudt/LatexString>;
  skos:broader <http://qudt.org/vocab/quantitykind/NumberDensity>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L-3I0M0H0T0D0>;
  <http://qudt.org/schema/qudt/symbol> "n_i";
  <http://qudt.org/schema/qudt/plainTextDescription> "\"Intinsic Carrier Density\" is proportional to electron and hole densities.";
  <http://qudt.org/schema/qudt/latexDefinition> "$np = n_i^2$, where $n$ is electron density and $p$ is hole density."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/applicableUnit> unit:NUM-PER-L, unit:NUM-PER-M3, unit:NUM-PER-MicroL,
    unit:NUM-PER-MilliL, unit:NUM-PER-MilliM3, unit:NUM-PER-NanoL, unit:NUM-PER-PicoL;
