  rdfs:label "standard uncertainty", "standard uncertainty";
  rdfs:range xsd:decimal, xsd:decimal;
  dct:description "The standard uncertainty of a quantity is the estimated standard deviation of the mean taken from a series of measurements."^^rdf:HTML,
    "The standard uncertainty of a quantity is the estimated standard deviation of the mean taken from a series of measurements."^^rdf:HTML .

_:6bb918f5130b4a77805c72ffff92bd8c632 a owl:Restriction;
