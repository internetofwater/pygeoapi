  rdfs:label "temperature-based quantity"@en-US;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/NotApplicable> .

<http://qudt.org/vocab/quantitykind/TemperatureBasedVelocity> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "temperature-based velocity"@en-US;
  dct:description "ratio of velocity divided by the related temperature"@en;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/NotApplicable>;
  <http://qudt.org/schema/qudt/symbol> "0173-1#Z4-BAJ391#001";
  <http://qudt.org/schema/qudt/plainTextDescription> "Quotient aus Geschwindigkeit dividiert durch die zugehörige Temperatur"@de .

