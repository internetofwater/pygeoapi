qudt:CurrencyUnit a owl:Class, owl:Class;
  rdfs:subClassOf qudt:DimensionlessUnit, qudt:DimensionlessUnit, _:6bb918f5130b4a77805c72ffff92bd8c545,
    _:6bb918f5130b4a77805c72ffff92bd8c546, _:b1cb43fcbd504833bf8a964862c3127019312, _:b1cb43fcbd504833bf8a964862c3127019313;
