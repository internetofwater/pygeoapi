unit:J a qudt:Unit, qudt:Unit, qudt:DerivedUnit, qudt:DerivedUnit;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/unit>, <http://qudt.org/vocab/unit>;
  rdfs:label "Joule"@de, "Joule"@de, "dżul"@pl, "dżul"@pl, "joule"@cs, "joule"@cs, "joule"@en,
    "joule"@en, "joule"@fr, "joule"@fr, "joule"@hu, "joule"@hu, "joule"@it, "joule"@it,
    "joule"@ms, "joule"@ms, "joule"@pt, "joule"@pt, "joule"@ro, "joule"@ro, "joule"@sl,
    "joule"@sl, "joule"@tr, "joule"@tr, "joulium"@la, "joulium"@la, "julio"@es, "julio"@es,
    "τζάουλ"@el, "τζάουλ"@el, "джаул"@bg, "джаул"@bg, "джоуль"@ru, "джоуль"@ru, "ژول"@fa,
    "ژول"@fa, "जूल"@hi, "जूल"@hi, "ジュール"@ja, "ジュール"@ja, "焦耳"@zh, "焦耳"@zh;
  dct:description """$\\textit{Joule}$ is the SI unit of work or energy, defined to be the work done by a force of one newton acting to move an object through a distance of one meter in the direction in which the force is applied. 
  Equivalently, since kinetic energy is one half the mass times the square of the velocity, one joule is the kinetic energy of a mass of two kilograms moving at a velocity of $1 m/s$.
  """^^qudt:LatexString,
    """$\\textit{Joule}$ is the SI unit of work or energy, defined to be the work done by a force of one newton acting to move an object through a distance of one meter in the direction in which the force is applied. 
  Equivalently, since kinetic energy is one half the mass times the square of the velocity, one joule is the kinetic energy of a mass of two kilograms moving at a velocity of $1 m/s$.
  """^^qudt:LatexString;
  qudt:applicableSystem <http://qudt.org/vocab/sou/CGS-EMU>, <http://qudt.org/vocab/sou/CGS-EMU>,
    <http://qudt.org/vocab/sou/CGS-GAUSS>, <http://qudt.org/vocab/sou/CGS-GAUSS>, <http://qudt.org/vocab/sou/SI>,
    <http://qudt.org/vocab/sou/SI>, <http://qudt.org/vocab/sou/CGS>, <http://qudt.org/vocab/sou/CGS>;
  qudt:conversionMultiplier 1.0, 1.0;
  qudt:conversionMultiplierSN 1.0E0, 1.0E0;
  qudt:dbpediaMatch "http://dbpedia.org/resource/Joule"^^xsd:anyURI, "http://dbpedia.org/resource/Joule"^^xsd:anyURI;
  qudt:hasDimensionVector dimensionvector:A0E0L2I0M1H0T-2D0, dimensionvector:A0E0L2I0M1H0T-2D0;
  qudt:hasQuantityKind quantitykind:Energy, quantitykind:Energy, quantitykind:ThermalEnergy,
    quantitykind:ThermalEnergy, quantitykind:ExchangeIntegral, quantitykind:ExchangeIntegral,
    quantitykind:HamiltonFunction, quantitykind:HamiltonFunction, quantitykind:LagrangeFunction,
    quantitykind:LagrangeFunction, quantitykind:LevelWidth, quantitykind:LevelWidth;
  qudt:iec61360Code "0112/2///62720#UAA172", "0112/2///62720#UAA172";
  qudt:informativeReference "http://en.wikipedia.org/wiki/Joule?oldid=494340406"^^xsd:anyURI,
    "http://en.wikipedia.org/wiki/Joule?oldid=494340406"^^xsd:anyURI, "https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAA172"^^xsd:anyURI,
    "https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAA172"^^xsd:anyURI;
  qudt:omUnit <http://www.ontology-of-units-of-measure.org/resource/om-2/joule>, <http://www.ontology-of-units-of-measure.org/resource/om-2/joule>;
  qudt:siExactMatch <https://si-digital-framework.org/SI/units/joule>, <https://si-digital-framework.org/SI/units/joule>;
  qudt:symbol "J", "J";
  qudt:ucumCode "J"^^qudt:UCUMcs, "J"^^qudt:UCUMcs;
  qudt:udunitsCode "J", "J";
  qudt:uneceCommonCode "JOU", "JOU";
  qudt:plainTextDescription "The SI unit of work or energy, defined to be the work done by a force of one newton acting to move an object through a distance of one meter in the direction in which the force is applied. Equivalently, since kinetic energy is one half the mass times the square of the velocity, one joule is the kinetic energy of a mass of two kilograms moving at a velocity of 1 m/s. This is the same as 107 ergs in the CGS system, or approximately 0.737 562 foot-pound in the traditional English system. In other energy units, one joule equals about 9.478 170 x 10-4 Btu, 0.238 846 (small) calories, or 2.777 778 x 10-4 watt hour. The joule is named for the British physicist James Prescott Joule (1818-1889), who demonstrated the equivalence of mechanical and thermal energy in a famous experiment in 1843. ",
    "The SI unit of work or energy, defined to be the work done by a force of one newton acting to move an object through a distance of one meter in the direction in which the force is applied. Equivalently, since kinetic energy is one half the mass times the square of the velocity, one joule is the kinetic energy of a mass of two kilograms moving at a velocity of 1 m/s. This is the same as 107 ergs in the CGS system, or approximately 0.737 562 foot-pound in the traditional English system. In other energy units, one joule equals about 9.478 170 x 10-4 Btu, 0.238 846 (small) calories, or 2.777 778 x 10-4 watt hour. The joule is named for the British physicist James Prescott Joule (1818-1889), who demonstrated the equivalence of mechanical and thermal energy in a famous experiment in 1843. ";
  qudt:exactMatch unit:N-M, unit:N-M;
  qudt:latexDefinition "$$\\text{J}\\ \\equiv\\ \\text{joule}\\ \\equiv\\ \\text{CV}\\ \\equiv\\ \\text{coulomb.volt}\\ \\equiv\\ \\frac{\\text{eV}}{1.602\\ 10^{-19}}\\ \\equiv\\ \\frac{\\text{electron.volt}}{1.602\\ 10^{-19}}$$"^^qudt:LatexString,
    "$$\\text{J}\\ \\equiv\\ \\text{joule}\\ \\equiv\\ \\text{CV}\\ \\equiv\\ \\text{coulomb.volt}\\ \\equiv\\ \\frac{\\text{eV}}{1.602\\ 10^{-19}}\\ \\equiv\\ \\frac{\\text{electron.volt}}{1.602\\ 10^{-19}}$$"^^qudt:LatexString;
  qudt:hasFactorUnit _:b1cb43fcbd504833bf8a964862c3127015882, _:b1cb43fcbd504833bf8a964862c3127015883 .

unit:N-M a qudt:Unit, qudt:Unit, qudt:DerivedUnit, qudt:DerivedUnit;
