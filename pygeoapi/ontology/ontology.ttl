unit:MicroCi a qudt:Unit, qudt:Unit;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/unit>, <http://qudt.org/vocab/unit>;
  rdfs:label "MicroCurie"@en, "MicroCurie"@en;
  dct:description "Another commonly used measure of radioactivity, the microcurie: $1 \\micro Ci = 3.7 \\times 10 disintegrations per second = 2.22 \\times 10 disintegrations per minute$. A radiotherapy machine may have roughly 1000 Ci of a radioisotope such as caesium-137 or cobalt-60. This quantity of radioactivity can produce serious health effects with only a few minutes of close-range, un-shielded exposure. The typical human body contains roughly $0.1\\micro Ci$ of naturally occurring potassium-40. "^^qudt:LatexString,
    "Another commonly used measure of radioactivity, the microcurie: $1 \\micro Ci = 3.7 \\times 10 disintegrations per second = 2.22 \\times 10 disintegrations per minute$. A radiotherapy machine may have roughly 1000 Ci of a radioisotope such as caesium-137 or cobalt-60. This quantity of radioactivity can produce serious health effects with only a few minutes of close-range, un-shielded exposure. The typical human body contains roughly $0.1\\micro Ci$ of naturally occurring potassium-40. "^^qudt:LatexString;
  qudt:applicableSystem <http://qudt.org/vocab/sou/CGS>, <http://qudt.org/vocab/sou/CGS>;
  qudt:conversionMultiplier 37000.0, 37000.0;
  qudt:conversionMultiplierSN 3.7E4, 3.7E4;
  qudt:dbpediaMatch "http://dbpedia.org/resource/Curie"^^xsd:anyURI, "http://dbpedia.org/resource/Curie"^^xsd:anyURI;
  qudt:hasDimensionVector dimensionvector:A0E0L0I0M0H0T-1D0, dimensionvector:A0E0L0I0M0H0T-1D0;
  qudt:hasQuantityKind quantitykind:Activity, quantitykind:Activity;
  qudt:iec61360Code "0112/2///62720#UAA062", "0112/2///62720#UAA062";
  qudt:informativeReference "http://en.wikipedia.org/wiki/Curie?oldid=495080313"^^xsd:anyURI,
    "http://en.wikipedia.org/wiki/Curie?oldid=495080313"^^xsd:anyURI, "https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAA062"^^xsd:anyURI,
    "https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAA062"^^xsd:anyURI;
  qudt:symbol "μCi", "μCi";
  qudt:ucumCode "uCi"^^qudt:UCUMcs, "uCi"^^qudt:UCUMcs;
  qudt:uneceCommonCode "M5", "M5" .

unit:MicroFARAD a qudt:Unit, qudt:Unit, qudt:DerivedUnit, qudt:DerivedUnit;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/unit>, <http://qudt.org/vocab/unit>;
  rdfs:label "microfarad"@en, "microfarad"@en;
  dct:description "The \"microfarad\" (symbolized $\\mu F$) is a unit of capacitance, equivalent to 0.000001 (10 to the -6th power) farad. The microfarad is a moderate unit of capacitance. In utility alternating-current (AC) and audio-frequency (AF) circuits, capacitors with values on the order of $1 \\mu F$ or more are common. At radio frequencies (RF), a smaller unit, the picofarad (pF), is often used."^^qudt:LatexString,
    "The \"microfarad\" (symbolized $\\mu F$) is a unit of capacitance, equivalent to 0.000001 (10 to the -6th power) farad. The microfarad is a moderate unit of capacitance. In utility alternating-current (AC) and audio-frequency (AF) circuits, capacitors with values on the order of $1 \\mu F$ or more are common. At radio frequencies (RF), a smaller unit, the picofarad (pF), is often used."^^qudt:LatexString;
  qudt:applicableSystem <http://qudt.org/vocab/sou/CGS-EMU>, <http://qudt.org/vocab/sou/CGS-EMU>,
    <http://qudt.org/vocab/sou/CGS-GAUSS>, <http://qudt.org/vocab/sou/CGS-GAUSS>, <http://qudt.org/vocab/sou/PLANCK>,
    <http://qudt.org/vocab/sou/PLANCK>, <http://qudt.org/vocab/sou/SI>, <http://qudt.org/vocab/sou/SI>,
    <http://qudt.org/vocab/sou/CGS>, <http://qudt.org/vocab/sou/CGS>;
  qudt:conversionMultiplier 0.000001, 0.000001;
  qudt:conversionMultiplierSN 1.0E-6, 1.0E-6;
  qudt:hasDimensionVector dimensionvector:A0E2L-2I0M-1H0T4D0, dimensionvector:A0E2L-2I0M-1H0T4D0;
  qudt:hasQuantityKind quantitykind:Capacitance, quantitykind:Capacitance;
  qudt:iec61360Code "0112/2///62720#UAA063", "0112/2///62720#UAA063";
  qudt:informativeReference "https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAA063"^^xsd:anyURI,
    "https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAA063"^^xsd:anyURI;
  qudt:symbol "μF", "μF";
  qudt:ucumCode "uF"^^qudt:UCUMcs, "uF"^^qudt:UCUMcs;
  qudt:uneceCommonCode "4O", "4O";
  qudt:prefix <http://qudt.org/vocab/prefix/Micro>, <http://qudt.org/vocab/prefix/Micro>;
