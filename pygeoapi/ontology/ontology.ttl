variablename:titaniumDioxide a skos:Concept ;
    skos:definition """Titanium dioxide, also known as titanium(IV) oxide or titania, is the naturally occurring oxide of titanium, chemical formula TiO
 2. When used as a pigment, it is called titanium white, Pigment White 6 (PW6), or CI 77891.""" ;
    skos:exactMatch "https://en.wikipedia.org/wiki/Titanium_dioxide" ;
