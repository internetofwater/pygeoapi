  rdfs:label "Delta u,v"@en, "Delta u,v"@en;
  rdfs:comment "Applicable units are those of quantitykind:Duv", "Applicable units are those of quantitykind:Duv";
  dct:description "Duv is a metric that is short for Delta u,v (not to be confused with Delta u',v') and describes the distance of a light color point from the black body curve."^^qudt:LatexString,
    "Duv is a metric that is short for Delta u,v (not to be confused with Delta u',v') and describes the distance of a light color point from the black body curve."^^qudt:LatexString;
  qudt:hasDimensionVector dimensionvector:A0E0L0I0M0H0T0D1, dimensionvector:A0E0L0I0M0H0T0D1;
  qudt:informativeReference "https://www.waveformlighting.com/tech/calculate-duv-from-cie-1931-xy-coordinates"^^xsd:anyURI,
