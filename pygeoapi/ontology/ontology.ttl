:c_256a156d a skos:Concept;
  skos:inScheme :conceptScheme_28b55cfc;
  skos:prefLabel "H&H CoP Priorities"@en;
  skos:broader :c_27cef761 .

:c_b8dbc0ce a skos:Concept;
  skos:inScheme :conceptScheme_28b55cfc;
  skos:prefLabel "Best Practices"@en;
  skos:note "Developing best practices for H&H studies and investigations was identified as the highest priority H&H CoP function "@en;
  skos:broader :c_256a156d .

:c_3ca9b422 a skos:Concept;
  skos:inScheme :conceptScheme_28b55cfc;
  skos:prefLabel "Training"@en;
  skos:note "identified as  the leading need for overcoming challenges faced by H&H practioners"@en;
  skos:broader :c_256a156d .

:c_503f4682 a skos:Concept;
  skos:inScheme :conceptScheme_28b55cfc;
  skos:prefLabel "Coordination"@en;
  skos:note "H&H CoP workshop respondents indicated limited exposure to practices in other offices and indicated  to be aware of practices in other offices as important or of interest."@en;
  skos:broader :c_256a156d .

:c_07f27992 a skos:Concept;
  skos:inScheme :conceptScheme_28b55cfc;
  skos:prefLabel "Outreach Resources"@en;
  skos:note "An H&H sharepoint site was creatd; it is recognized that continued develop of this and similar resources will be important to the success of the H&H CoP"@en;
  skos:broader :c_256a156d .

:c_364161ef a skos:Concept;
  skos:definition "Aims to provide support and leadership to enable community to make significants strides in advancing H&H tools and methods. Reclemation stands to benefit from CoPs to shared experiences and practices, helping to ensure that agency capacities and practices are at the forefront of water management field"@en;
  skos:inScheme :conceptScheme_28b55cfc;
  skos:prefLabel "H&H CoP Objectives"@en;
  skos:broader :c_27cef761 .

:c_95d7196c a skos:Concept;
  skos:definition """The Implementation Team Chair is hereby authorized to interface with management as required,
negotiate for resources, delegate responsibilities within the framework of the project, and to
communicate with the team and stakeholders, as required, to ensure successful and timely
implementation of CoP activities. The chair is responsible for developing the project plan,
monitoring the schedule, cost, and scope of the project during implementation, and maintaining
control over the implementation by measuring performance and taking corrective action to stay
within scope and objectives."""@en;
  skos:inScheme :conceptScheme_28b55cfc;
  skos:prefLabel "H&H CoP Implementation Team Chair"@en;
  skos:broader :c_97692aa8 .

:c_45ec57c5 a skos:Concept;
  skos:definition """The Implementation Team will meet bi-weekly to accomplish its scope. Subcommittee meetings
will be scheduled as needed to meet particular scope tasks. Depending on the status of activities
at a given time, meetings may be cancelled, or additional meetings of the Implementation Team
or its subcommittees may be added."""@en;
  skos:inScheme :conceptScheme_28b55cfc;
  skos:prefLabel "H&H Implementation Team Schedule"@en;
  skos:broader :c_97692aa8 .

