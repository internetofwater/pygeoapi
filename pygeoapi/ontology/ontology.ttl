quantitykind:ComplexPower a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:seeAlso quantitykind:ElectricCurrentPhasor, quantitykind:ElectricCurrentPhasor,
    quantitykind:VoltagePhasor, quantitykind:VoltagePhasor;
  rdfs:label "Complex Power"@en, "Complex Power"@en;
  rdfs:comment "Applicable units are those of quantitykind:ComplexPower", "Applicable units are those of quantitykind:ElectricPower";
  dct:description """
  $\\textit{Complex Power}$, under sinusoidal conditions,
   is the product of the phasor $\\mathbf{U}$ representing the voltage between the terminals of a linear two-terminal element,
   or two-terminal circuit and the complex conjugate of the phasor $I$ representing the electric current in the element or circuit.
  """^^qudt:LatexString,
    """
  $\\textit{Complex Power}$, under sinusoidal conditions,
   is the product of the phasor $\\mathbf{U}$ representing the voltage between the terminals of a linear two-terminal element,
   or two-terminal circuit and the complex conjugate of the phasor $I$ representing the electric current in the element or circuit.
  """^^qudt:LatexString;
  skos:broader quantitykind:ElectricPower, quantitykind:ElectricPower;
  qudt:hasDimensionVector dimensionvector:A0E0L2I0M1H0T-3D0, dimensionvector:A0E0L2I0M1H0T-3D0;
  qudt:informativeReference "http://www.iso.org/iso/home/store/catalogue_tc/catalogue_detail.htm?csnumber=31891"^^xsd:anyURI,
    "http://www.iso.org/iso/home/store/catalogue_tc/catalogue_detail.htm?csnumber=31891"^^xsd:anyURI,
    "http://www.electropedia.org/iev/iev.nsf/display?openform&ievref=131-11-39"^^xsd:anyURI,
    "http://www.electropedia.org/iev/iev.nsf/display?openform&ievref=131-11-39"^^xsd:anyURI;
  qudt:expression "$complex-power$"^^qudt:LatexString, "$complex-power$"^^qudt:LatexString;
  qudt:latexSymbol "$\\underline{S}$"^^qudt:LatexString, "$\\underline{S}$"^^qudt:LatexString;
  qudt:latexDefinition "$\\underline{S} = \\underline{U}\\underline{I^*}$, where $\\underline{U}$ is voltage phasor and $\\underline{I^*}$ is the complex conjugate of the current phasor."^^qudt:LatexString,
    "$\\underline{S} = \\underline{U}\\underline{I^*}$, where $\\underline{U}$ is voltage phasor and $\\underline{I^*}$ is the complex conjugate of the current phasor."^^qudt:LatexString;
  dct:isReplacedBy quantitykind:ElectricPower;
  qudt:deprecated true;
  qudt:applicableUnit unit:ExaV-A, unit:ExaW, unit:GigaV-A, unit:GigaW, unit:KiloV-A,
    unit:KiloW, unit:MegaV-A, unit:MegaW, unit:MicroV-A, unit:MicroW, unit:MilliV-A, unit:MilliW,
    unit:NanoV-A, unit:NanoW, unit:PetaV-A, unit:PetaW, unit:PicoV-A, unit:PicoW, unit:TeraJ-PER-SEC,
    unit:TeraV-A, unit:TeraW, unit:V-A, unit:W .

quantitykind:NonActivePower a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:seeAlso quantitykind:ActivePower, quantitykind:ActivePower, quantitykind:ApparentPower,
    quantitykind:ApparentPower;
  rdfs:label "Non-active Power"@en, "Non-active Power"@en;
  rdfs:comment "Applicable units are those of quantitykind:NonActivePower";
  dct:description "\"Non-active Power\", for a two-terminal element or a two-terminal circuit under periodic conditions, is the quantity equal to the square root of the difference of the squares of the apparent power and the active power."^^qudt:LatexString,
    "\"Non-active Power\", for a two-terminal element or a two-terminal circuit under periodic conditions, is the quantity equal to the square root of the difference of the squares of the apparent power and the active power."^^qudt:LatexString;
  qudt:hasDimensionVector dimensionvector:A0E0L2I0M1H0T-3D0, dimensionvector:A0E0L2I0M1H0T-3D0;
  qudt:informativeReference "http://www.iso.org/iso/home/store/catalogue_tc/catalogue_detail.htm?csnumber=31891"^^xsd:anyURI,
    "http://www.iso.org/iso/home/store/catalogue_tc/catalogue_detail.htm?csnumber=31891"^^xsd:anyURI,
    "http://www.electropedia.org/iev/iev.nsf/display?openform&ievref=131-11-43"^^xsd:anyURI,
    "http://www.electropedia.org/iev/iev.nsf/display?openform&ievref=131-11-43"^^xsd:anyURI;
  qudt:symbol "Q'", "Q'";
  qudt:plainTextDescription "\"Non-active Power\", for a two-terminal element or a two-terminal circuit under periodic conditions, is the quantity equal to the square root of the difference of the squares of the apparent power and the active power.",
    "\"Non-active Power\", for a two-terminal element or a two-terminal circuit under periodic conditions, is the quantity equal to the square root of the difference of the squares of the apparent power and the active power.";
  qudt:latexDefinition "$Q^{'} = \\sqrt{{\\left | \\underline{S} \\right |}^2 - P^2}$, where $\\underline{S}$ is apparent power and $P$ is active power."^^qudt:LatexString,
    "$Q^{'} = \\sqrt{{\\left | \\underline{S} \\right |}^2 - P^2}$, where $\\underline{S}$ is apparent power and $P$ is active power."^^qudt:LatexString;
  qudt:applicableUnit unit:ExaV-A, unit:GigaV-A, unit:MicroV-A, unit:MilliV-A, unit:NanoV-A,
    unit:PetaV-A, unit:PicoV-A, unit:TeraV-A, unit:V-A .

