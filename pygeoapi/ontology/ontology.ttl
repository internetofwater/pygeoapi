rdfs:ContainerMembershipProperty a rdfs:Class ;
    rdfs:label "ContainerMembershipProperty" ;
    rdfs:comment """The class of container membership properties, rdf:_1, rdf:_2, ...,
                    all of which are sub-properties of 'member'.""" ;
