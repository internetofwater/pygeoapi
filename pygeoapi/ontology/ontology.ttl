  <http://qudt.org/schema/qudt/informativeReference> "https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAA550"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/symbol> "in³/h";
  <http://qudt.org/schema/qudt/ucumCode> "[cin_i].h-1"^^<http://qudt.org/schema/qudt/UCUMcs>;
  <http://qudt.org/schema/qudt/uneceCommonCode> "G56";
  <http://qudt.org/schema/qudt/plainTextDescription> "power of the unit inch according to the Anglo-American and the Imperial system of units with the exponent 3 divided by the unit hour" .

