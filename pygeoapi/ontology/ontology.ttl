  <http://qudt.org/schema/qudt/informativeReference> "http://en.wikipedia.org/wiki/Area"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/symbol> "A";
  <http://qudt.org/schema/qudt/plainTextDescription> "\"Area\" is a quantity that expresses the extent of a two-dimensional surface or shape, or planar lamina, in the plane.";
  <http://qudt.org/schema/qudt/latexDefinition> "$A = \\int\\int dxdy$, where $x$ and $y$ are cartesian coordinates."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/abbreviation> "area";
