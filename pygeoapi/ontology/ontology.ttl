  skos:topConceptOf :conceptScheme_28b55cfc;
  skos:prefLabel "US Bureau of Reclamation"@en;
  skos:altLabel "Reclamation"@en, "USBR"@en .

:c_df3ec047 a skos:Concept;
  skos:definition "Deliver water and power in an environmentally and economically sound manner"@en;
  skos:inScheme :conceptScheme_28b55cfc;
  skos:prefLabel "Mission"@en;
  skos:broader :c_31da8bb8 .

:c_373429a5 a skos:Concept;
  skos:definition "Created to promote and support best practices within the Hydrology & Hydraulics, Climate Change and Peer Review to ensure REclamation continues to meet its mission in a changing environment"@en;
  skos:inScheme :conceptScheme_28b55cfc;
  skos:prefLabel "Coordination Council for Operations Community of Practice"@en;
  skos:altLabel "Council"@en;
  skos:note "established by the Deputy Commisioner - Operations"@en, "made up of senior managers from Reclamation directoratesand organizations who directly report to the Reclamation Leadership  Team (RLT)"@en;
  skos:broader :c_e887364e;
  skos:related :c_e3222c25 .

:c_b812e429 a skos:Concept;
  skos:inScheme :conceptScheme_28b55cfc;
  skos:prefLabel "Climate Change"@en;
  skos:broader :c_31da8bb8 .

:c_e887364e a skos:Concept;
  rdfs:seeAlso "https://en.wikipedia.org/wiki/Community_of_practice"^^xsd:anyURI;
  skos:inScheme :conceptScheme_28b55cfc;
  skos:prefLabel "Reclamation Community of Practice"@en;
  skos:altLabel "CoP"@en;
  skos:broader :c_31da8bb8 .

:c_c1f57079 a skos:Concept;
  skos:inScheme :conceptScheme_28b55cfc;
  skos:prefLabel "Deputy Commissioner"@en;
  skos:broader :c_31da8bb8 .

:c_e3222c25 a skos:Concept;
  skos:inScheme :conceptScheme_28b55cfc;
  skos:prefLabel "Operations"@en;
  skos:broader :c_c1f57079;
  skos:related :c_373429a5 .

:c_27cef761 a skos:Concept;
  skos:definition "Serves Reclamation's programs and their staff. Brings together practitioners of the H&H subcommunity topics to discusss, share experiences and resources, and support conversations at an agency level to continue bringing the best available ifnormation to the forefront of water managment."@en;
  skos:inScheme :conceptScheme_28b55cfc;
  skos:prefLabel "Hydrology and Hydraulics Community of Practice"@en;
  skos:altLabel "H&H"@en, "H&H CoP"@en;
  skos:note "sponsored by Deputy Commisioner - Operations"@en, "established in Fall 2021"@en;
  skos:broader :c_373429a5;
  skos:related :c_e3222c25 .

:c_97692aa8 a skos:Concept;
  skos:definition "Plans and supports the implementation of the activities of the H&H CoP"@en;
  skos:inScheme :conceptScheme_28b55cfc;
  skos:prefLabel "H&H CoP Implementation Team"@en;
  skos:altLabel "Implementation Team"@en;
  skos:note "Sponsored by the Deputy Commissioner - Operations"@en, "formed in November 2022"@en,
    "Comprised of program managers and subject matter experts from Reclamation regional and Denver directorates"@en,
    "Consissts of representatives from other offices involved in the project who contribute within their area of expertise and accomplish assigned action items to implement the day-to-day development adn execution of the Project"@en,
    "Implementation TEam members are empowered to actively participate in the H&H CoP and invest the time necessary to undertake activities under the H&H CoP Charter."@en;
  skos:broader :c_27cef761 .

:c_04e73b7f a skos:Concept;
  skos:inScheme :conceptScheme_28b55cfc;
  skos:prefLabel "Climate Change Community of Practice"@en;
  skos:altLabel "CC CoP"@en, "CC"@en;
  skos:note "sponsored by Deputy Commisioner - Operations"@en;
  skos:broader :c_373429a5;
  skos:related :c_e3222c25 .

:c_f3880480 a skos:Concept;
  skos:inScheme :conceptScheme_28b55cfc;
  skos:prefLabel "Peer Review Community of Practice"@en;
  skos:note "sponsored by Deputy Commisioner - Operations"@en;
  skos:broader :c_373429a5;
  skos:related :c_e3222c25 .

:c_bc01c7b9 a skos:Concept;
  skos:definition "formed and used to better structure the topics that fall within the H&H field and provide optimum discussion for each topic"@en;
  skos:inScheme :conceptScheme_28b55cfc;
  skos:prefLabel "H&H Subcommunities"@en;
  skos:broader :c_27cef761;
  skos:related :c_97692aa8 .

:c_2958ec19 a skos:Concept;
  skos:definition "Operation of facilities on short-term timescale, forecasting, dam and powerplant logistics"@en;
  skos:inScheme :conceptScheme_28b55cfc;
  skos:prefLabel "H&H Operations Subcommunity"@en;
  skos:altLabel "Operations"@en;
  skos:broader :c_bc01c7b9 .

:c_bcd9aaee a skos:Concept;
  skos:definition "Longer term facility operation, years or decades in the future, policy analysis"@en;
  skos:inScheme :conceptScheme_28b55cfc;
  skos:prefLabel "H&H Planning Subcommunity"@en;
  skos:broader :c_bc01c7b9 .

:c_cd446a1f a skos:Concept;
  skos:definition "Studies on evaporation, new hydrology datasets, naturalizing streamflow, etc."@en;
  skos:inScheme :conceptScheme_28b55cfc;
  skos:prefLabel "H&H Hydraulic Analyses Subcommunity"@en;
  skos:broader :c_bc01c7b9 .

:c_ac0ee642 a skos:Concept;
  skos:definition "Studies on channel dynamics, fish passage, sediment transport, scour, etc."@en;
  skos:inScheme :conceptScheme_28b55cfc;
  skos:prefLabel "H&H Hydraulic and Ecologic Analyses Subcommunity"@en;
  skos:broader :c_bc01c7b9 .

