<http://qudt.org/vocab/quantitykind/SourceVoltage> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Source Voltage"@en;
  rdfs:comment "Applicable units are those of quantitykind:Voltage";
  dct:description """
  The quantity kind $\\textit{Source Voltage}$, also referred to as $\\textit{Source Tension}$
   is the voltage between the two terminals of a voltage source when there is no electric current through the source. 
  The name $\\text{electromotive force}$ with the abbreviation $\\textit{EMF}$ and the symbol $E$ is deprecated.
  """^^<http://qudt.org/schema/qudt/LatexString>;
  skos:broader <http://qudt.org/vocab/quantitykind/Voltage>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E-1L2I0M1H0T-3D0>;
  <http://qudt.org/schema/qudt/informativeReference> "http://www.iso.org/iso/home/store/catalogue_tc/catalogue_detail.htm?csnumber=31891"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/symbol> "U_s";
  <http://qudt.org/schema/qudt/applicableUnit> unit:FemtoV, unit:GigaV, unit:KiloV,
    unit:MegaV, unit:MicroV, unit:MilliV, unit:NanoV, unit:PicoV, unit:PlanckVolt, unit:TeraV,
    unit:V, unit:V_Ab, unit:V_Stat .

<http://qudt.org/vocab/quantitykind/SourceVoltageBetweenSubstances> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Source Voltage Between Substances"@en;
  rdfs:comment "Applicable units are those of quantitykind:Voltage";
  dct:description "\"Source Voltage Between Substances\" is the source voltage between substance a and b."^^<http://qudt.org/schema/qudt/LatexString>;
  skos:broader <http://qudt.org/vocab/quantitykind/Voltage>;
