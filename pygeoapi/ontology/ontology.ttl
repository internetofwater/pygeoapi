quantitykind:ElectricCharge a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:seeAlso quantitykind:ElectricCurrent, quantitykind:ElectricCurrent;
  rdfs:label "Cas elektrik"@ms, "Cas elektrik"@ms, "Charge électrique"@fr, "Charge électrique"@fr,
    "Elektrický náboj"@cs, "Elektrický náboj"@cs, "carga eléctrica"@es, "carga eléctrica"@es,
    "carga elétrica"@pt, "carga elétrica"@pt, "carica elettrica"@it, "carica elettrica"@it,
    "electric charge"@en, "electric charge"@en, "elektrik yükü"@tr, "elektrik yükü"@tr,
    "elektrische Ladung"@de, "elektrische Ladung"@de, "električni naboj"@sl, "električni naboj"@sl,
    "elektromos töltés"@hu, "elektromos töltés"@hu, "onus electricum"@la, "onus electricum"@la,
    "sarcină electrică"@ro, "sarcină electrică"@ro, "ładunek elektryczny"@pl, "ładunek elektryczny"@pl,
    "Ηλεκτρικό φορτίο"@el, "Ηλεκτρικό φορτίο"@el, "Електрически заряд"@bg, "Електрически заряд"@bg,
    "Электрический заряд"@ru, "Электрический заряд"@ru, "מטען חשמלי"@he, "מטען חשמלי"@he,
    "الشحنة الكهربائية"@ar, "الشحنة الكهربائية"@ar, "بار الکتریکی"@fa, "بار الکتریکی"@fa,
    "विद्युत आवेग या विद्युत बहाव"@hi, "विद्युत आवेग या विद्युत बहाव"@hi, "电荷"@zh, "电荷"@zh,
    "電荷"@ja, "電荷"@ja;
  rdfs:comment "Applicable units are those of quantitykind:ElectricCharge", "Applicable units are those of quantitykind:ElectricCharge";
  dct:description "\"Electric Charge\" is a fundamental conserved property of some subatomic particles, which determines their electromagnetic interaction. Electrically charged matter is influenced by, and produces, electromagnetic fields. The electric charge on a body may be positive or negative. Two positively charged bodies experience a mutual repulsive force, as do two negatively charged bodies. A positively charged body and a negatively charged body experience an attractive force. Electric charge is carried by discrete particles and can be positive or negative. The sign convention is such that the elementary electric charge $e$, that is, the charge of the proton, is positive. The SI derived unit of electric charge is the coulomb."^^qudt:LatexString,
    "\"Electric Charge\" is a fundamental conserved property of some subatomic particles, which determines their electromagnetic interaction. Electrically charged matter is influenced by, and produces, electromagnetic fields. The electric charge on a body may be positive or negative. Two positively charged bodies experience a mutual repulsive force, as do two negatively charged bodies. A positively charged body and a negatively charged body experience an attractive force. Electric charge is carried by discrete particles and can be positive or negative. The sign convention is such that the elementary electric charge $e$, that is, the charge of the proton, is positive. The SI derived unit of electric charge is the coulomb."^^qudt:LatexString;
  skos:altLabel "cantitate de electricitate"@ro, "cantitate de electricitate"@ro;
  qudt:hasDimensionVector dimensionvector:A0E1L0I0M0H0T1D0, dimensionvector:A0E1L0I0M0H0T1D0;
  qudt:iec61360Code "0112/2///62720#UAD037", "0112/2///62720#UAD037";
  qudt:informativeReference "http://www.iso.org/iso/home/store/catalogue_tc/catalogue_detail.htm?csnumber=31891"^^xsd:anyURI,
    "http://www.iso.org/iso/home/store/catalogue_tc/catalogue_detail.htm?csnumber=31891"^^xsd:anyURI,
    "http://en.wikipedia.org/wiki/Electric_charge"^^xsd:anyURI, "http://en.wikipedia.org/wiki/Electric_charge"^^xsd:anyURI,
    "http://en.wikipedia.org/wiki/Electric_charge?oldid=492961669"^^xsd:anyURI, "http://en.wikipedia.org/wiki/Electric_charge?oldid=492961669"^^xsd:anyURI,
    "https://cdd.iec.ch/cdd/iec61987/iec61987.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD037"^^xsd:anyURI,
    "https://cdd.iec.ch/cdd/iec61987/iec61987.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD037"^^xsd:anyURI;
  qudt:siExactMatch <https://si-digital-framework.org/SI/quantities/ELCH>, <https://si-digital-framework.org/quantities/ELCH>;
