unit:BTU_39DEG_F a <http://qudt.org/schema/qudt/Unit>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/unit>;
  rdfs:label "British thermal unit (39 °F)";
  dct:description "unit of heat energy according to the Imperial system of units in a reference temperature of 39 °F";
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L2I0M1H0T-2D0>;
  <http://qudt.org/schema/qudt/hasQuantityKind> <http://qudt.org/vocab/quantitykind/ThermalEnergy>;
  <http://qudt.org/schema/qudt/iec61360Code> "0112/2///62720#UAB216";
