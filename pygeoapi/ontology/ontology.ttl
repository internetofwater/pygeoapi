  dct:description "\"Molar Conductivity\" is the conductivity of an electrolyte solution divided by the molar concentration of the electrolyte, and so measures the efficiency with which a given electrolyte conducts electricity in solution."^^qudt:LatexString,
    "\"Molar Conductivity\" is the conductivity of an electrolyte solution divided by the molar concentration of the electrolyte, and so measures the efficiency with which a given electrolyte conducts electricity in solution."^^qudt:LatexString;
  qudt:hasDimensionVector dimensionvector:A-1E2L0I0M-1H0T3D0, dimensionvector:A-1E2L0I0M-1H0T3D0;
  qudt:iec61360Code "0112/2///62720#UAD121", "0112/2///62720#UAD121";
