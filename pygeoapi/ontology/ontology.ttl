  rdfs:comment "Applicable units are those of quantitykind:HyperfineStructureQuantumNumber",
    "Applicable units are those of quantitykind:HyperfineStructureQuantumNumber";
  dct:description "The \"Hyperfine Structure Quantum Number\" is a quantum number of an atom describing inclination of the nuclear spin with respect to a quantization axis given by the magnetic field produced by the orbital electrons."^^qudt:LatexString,
    "The \"Hyperfine Structure Quantum Number\" is a quantum number of an atom describing inclination of the nuclear spin with respect to a quantization axis given by the magnetic field produced by the orbital electrons."^^qudt:LatexString;
  skos:broader quantitykind:QuantumNumber, quantitykind:QuantumNumber;
  qudt:hasDimensionVector dimensionvector:A0E0L0I0M0H0T0D1, dimensionvector:A0E0L0I0M0H0T0D1;
