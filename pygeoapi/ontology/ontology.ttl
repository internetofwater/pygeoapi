  dct:description "Recommended practice is to use this property with non-literal values from a vocabulary of audience types."@en,
    "Recommended practice is to use this property with non-literal values from a vocabulary of audience types."@en;
  dct:issued "2001-05-21"^^xsd:date, "2001-05-21"^^xsd:date;
  <http://purl.org/dc/dcam/rangeIncludes> dct:AgentClass, dct:AgentClass .

dct:available a rdf:Property, rdf:Property;
  rdfs:isDefinedBy <http://purl.org/dc/terms/>, <http://purl.org/dc/terms/>;
  rdfs:label "Date Available"@en, "Date Available"@en;
  rdfs:comment "Date that the resource became or will become available."@en, "Date that the resource became or will become available."@en;
  rdfs:range rdfs:Literal, rdfs:Literal;
  rdfs:subPropertyOf dc:date, dc:date, dct:date, dct:date;
  dct:description "Recommended practice is to describe the date, date/time, or period of time as recommended for the property Date, of which this is a subproperty."@en,
    "Recommended practice is to describe the date, date/time, or period of time as recommended for the property Date, of which this is a subproperty."@en;
  dct:issued "2000-07-11"^^xsd:date, "2000-07-11"^^xsd:date .

dct:bibliographicCitation a rdf:Property, rdf:Property;
  rdfs:isDefinedBy <http://purl.org/dc/terms/>, <http://purl.org/dc/terms/>;
  rdfs:label "Bibliographic Citation"@en, "Bibliographic Citation"@en;
  rdfs:comment "A bibliographic reference for the resource."@en, "A bibliographic reference for the resource."@en;
  rdfs:range rdfs:Literal, rdfs:Literal;
  rdfs:subPropertyOf dc:identifier, dc:identifier, dct:identifier, dct:identifier;
  dct:description "Recommended practice is to include sufficient bibliographic detail to identify the resource as unambiguously as possible."@en,
    "Recommended practice is to include sufficient bibliographic detail to identify the resource as unambiguously as possible."@en;
  dct:issued "2003-02-15"^^xsd:date, "2003-02-15"^^xsd:date .

dct:identifier a rdf:Property, rdf:Property;
  rdfs:isDefinedBy <http://purl.org/dc/terms/>, <http://purl.org/dc/terms/>;
  rdfs:label "Identifier"@en, "Identifier"@en;
  rdfs:comment "An unambiguous reference to the resource within a given context."@en,
    "An unambiguous reference to the resource within a given context."@en;
  rdfs:range rdfs:Literal, rdfs:Literal;
  rdfs:subPropertyOf dc:identifier, dc:identifier;
  dct:description "Recommended practice is to identify the resource by means of a string conforming to an identification system. Examples include International Standard Book Number (ISBN), Digital Object Identifier (DOI), and Uniform Resource Name (URN).  Persistent identifiers should be provided as HTTP URIs."@en,
    "Recommended practice is to identify the resource by means of a string conforming to an identification system. Examples include International Standard Book Number (ISBN), Digital Object Identifier (DOI), and Uniform Resource Name (URN).  Persistent identifiers should be provided as HTTP URIs."@en;
  dct:issued "2008-01-14"^^xsd:date, "2008-01-14"^^xsd:date .

dct:conformsTo a rdf:Property, rdf:Property;
  rdfs:isDefinedBy <http://purl.org/dc/terms/>, <http://purl.org/dc/terms/>;
  rdfs:label "Conforms To"@en, "Conforms To"@en;
  rdfs:comment "An established standard to which the described resource conforms."@en,
    "An established standard to which the described resource conforms."@en;
  rdfs:subPropertyOf dc:relation, dc:relation, dct:relation, dct:relation;
  dct:issued "2001-05-21"^^xsd:date, "2001-05-21"^^xsd:date;
  <http://purl.org/dc/dcam/rangeIncludes> dct:Standard, dct:Standard .

dct:relation a rdf:Property, rdf:Property;
  rdfs:isDefinedBy <http://purl.org/dc/terms/>, <http://purl.org/dc/terms/>;
  rdfs:label "Relation"@en, "Relation"@en;
  rdfs:comment "A related resource."@en, "A related resource."@en;
  rdfs:subPropertyOf dc:relation, dc:relation;
  dct:description "Recommended practice is to identify the related resource by means of a URI.  If this is not possible or feasible, a string conforming to a formal identification system may be provided."@en,
    "Recommended practice is to identify the related resource by means of a URI.  If this is not possible or feasible, a string conforming to a formal identification system may be provided."@en;
  dct:issued "2008-01-14"^^xsd:date, "2008-01-14"^^xsd:date .

dct:coverage a rdf:Property, rdf:Property;
  rdfs:isDefinedBy <http://purl.org/dc/terms/>, <http://purl.org/dc/terms/>;
  rdfs:label "Coverage"@en, "Coverage"@en;
  rdfs:comment "The spatial or temporal topic of the resource, spatial applicability of the resource, or jurisdiction under which the resource is relevant."@en,
    "The spatial or temporal topic of the resource, spatial applicability of the resource, or jurisdiction under which the resource is relevant."@en;
  rdfs:subPropertyOf dc:coverage, dc:coverage;
  dct:description "Spatial topic and spatial applicability may be a named place or a location specified by its geographic coordinates. Temporal topic may be a named period, date, or date range. A jurisdiction may be a named administrative entity or a geographic place to which the resource applies. Recommended practice is to use a controlled vocabulary such as the Getty Thesaurus of Geographic Names [[TGN](https://www.getty.edu/research/tools/vocabulary/tgn/index.html)]. Where appropriate, named places or time periods may be used in preference to numeric identifiers such as sets of coordinates or date ranges.  Because coverage is so broadly defined, it is preferable to use the more specific subproperties Temporal Coverage and Spatial Coverage."@en,
    "Spatial topic and spatial applicability may be a named place or a location specified by its geographic coordinates. Temporal topic may be a named period, date, or date range. A jurisdiction may be a named administrative entity or a geographic place to which the resource applies. Recommended practice is to use a controlled vocabulary such as the Getty Thesaurus of Geographic Names [[TGN](https://www.getty.edu/research/tools/vocabulary/tgn/index.html)]. Where appropriate, named places or time periods may be used in preference to numeric identifiers such as sets of coordinates or date ranges.  Because coverage is so broadly defined, it is preferable to use the more specific subproperties Temporal Coverage and Spatial Coverage."@en;
  dct:issued "2008-01-14"^^xsd:date, "2008-01-14"^^xsd:date;
  <http://purl.org/dc/dcam/rangeIncludes> dct:Jurisdiction, dct:Jurisdiction, dct:Location,
    dct:Location, dct:Period, dct:Period .

dct:dateAccepted a rdf:Property, rdf:Property;
  rdfs:isDefinedBy <http://purl.org/dc/terms/>, <http://purl.org/dc/terms/>;
  rdfs:label "Date Accepted"@en, "Date Accepted"@en;
  rdfs:comment "Date of acceptance of the resource."@en, "Date of acceptance of the resource."@en;
  rdfs:range rdfs:Literal, rdfs:Literal;
  rdfs:subPropertyOf dc:date, dc:date, dct:date, dct:date;
  dct:description "Recommended practice is to describe the date, date/time, or period of time as recommended for the property Date, of which this is a subproperty.  Examples of resources to which a date of acceptance may be relevant are a thesis (accepted by a university department) or an article (accepted by a journal)."@en,
    "Recommended practice is to describe the date, date/time, or period of time as recommended for the property Date, of which this is a subproperty.  Examples of resources to which a date of acceptance may be relevant are a thesis (accepted by a university department) or an article (accepted by a journal)."@en;
  dct:issued "2002-07-13"^^xsd:date, "2002-07-13"^^xsd:date .

dct:dateCopyrighted a rdf:Property, rdf:Property;
  rdfs:isDefinedBy <http://purl.org/dc/terms/>, <http://purl.org/dc/terms/>;
  rdfs:label "Date Copyrighted"@en, "Date Copyrighted"@en;
  rdfs:comment "Date of copyright of the resource."@en, "Date of copyright of the resource."@en;
  rdfs:range rdfs:Literal, rdfs:Literal;
  rdfs:subPropertyOf dc:date, dc:date, dct:date, dct:date;
  dct:description "Typically a year.  Recommended practice is to describe the date, date/time, or period of time as recommended for the property Date, of which this is a subproperty."@en,
    "Typically a year.  Recommended practice is to describe the date, date/time, or period of time as recommended for the property Date, of which this is a subproperty."@en;
  dct:issued "2002-07-13"^^xsd:date, "2002-07-13"^^xsd:date .

dct:dateSubmitted a rdf:Property, rdf:Property;
  rdfs:isDefinedBy <http://purl.org/dc/terms/>, <http://purl.org/dc/terms/>;
  rdfs:label "Date Submitted"@en, "Date Submitted"@en;
  rdfs:comment "Date of submission of the resource."@en, "Date of submission of the resource."@en;
  rdfs:range rdfs:Literal, rdfs:Literal;
  rdfs:subPropertyOf dc:date, dc:date, dct:date, dct:date;
  dct:description "Recommended practice is to describe the date, date/time, or period of time as recommended for the property Date, of which this is a subproperty.  Examples of resources to which a 'Date Submitted' may be relevant include a thesis (submitted to a university department) or an article (submitted to a journal)."@en,
    "Recommended practice is to describe the date, date/time, or period of time as recommended for the property Date, of which this is a subproperty.  Examples of resources to which a 'Date Submitted' may be relevant include a thesis (submitted to a university department) or an article (submitted to a journal)."@en;
  dct:issued "2002-07-13"^^xsd:date, "2002-07-13"^^xsd:date .

dct:educationLevel a rdf:Property, rdf:Property;
