quantitykind:Force a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "Daya"@ms, "Daya"@ms, "Kraft"@de, "Kraft"@de, "Síla"@cs, "Síla"@cs, "erő"@hu,
    "erő"@hu, "force"@en, "force"@en, "force"@fr, "force"@fr, "forza"@it, "forza"@it,
    "força"@pt, "força"@pt, "forță"@ro, "forță"@ro, "fuerza"@es, "fuerza"@es, "kuvvet"@tr,
    "kuvvet"@tr, "sila"@sl, "sila"@sl, "siła"@pl, "siła"@pl, "vis"@la, "vis"@la, "Δύναμη"@el,
    "Δύναμη"@el, "Сила"@ru, "Сила"@ru, "сила"@bg, "сила"@bg, "כוח"@he, "כוח"@he, "نیرو"@fa,
    "نیرو"@fa, "وحدة القوة في نظام متر كيلوغرام ثانية"@ar, "وحدة القوة في نظام متر كيلوغرام ثانية"@ar,
    "बल"@hi, "बल"@hi, "力"@ja, "力"@ja, "力"@zh, "力"@zh;
  rdfs:comment "Applicable units are those of quantitykind:Force", "Applicable units are those of quantitykind:Force";
  dct:description "\"Force\" is an influence that causes mass to accelerate. It may be experienced as a lift, a push, or a pull. Force is defined by Newton's Second Law as $F = m \\times a $, where $F$ is force, $m$ is mass and $a$ is acceleration. Net force is mathematically equal to the time rate of change of the momentum of the body on which it acts. Since momentum is a vector quantity (has both a magnitude and direction), force also is a vector quantity."^^qudt:LatexString,
    "\"Force\" is an influence that causes mass to accelerate. It may be experienced as a lift, a push, or a pull. Force is defined by Newton's Second Law as $F = m \\times a $, where $F$ is force, $m$ is mass and $a$ is acceleration. Net force is mathematically equal to the time rate of change of the momentum of the body on which it acts. Since momentum is a vector quantity (has both a magnitude and direction), force also is a vector quantity."^^qudt:LatexString;
  skos:altLabel "भार"@hi, "भार"@hi;
  qudt:dbpediaMatch "http://dbpedia.org/resource/Force"^^xsd:anyURI, "http://dbpedia.org/resource/Force"^^xsd:anyURI;
  qudt:hasDimensionVector dimensionvector:A0E0L1I0M1H0T-2D0, dimensionvector:A0E0L1I0M1H0T-2D0;
  qudt:iec61360Code "0112/2///62720#UAD054", "0112/2///62720#UAD054";
  qudt:informativeReference "http://en.wikipedia.org/wiki/Force"^^xsd:anyURI, "http://en.wikipedia.org/wiki/Force"^^xsd:anyURI,
    "https://cdd.iec.ch/cdd/iec61987/iec61987.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD054"^^xsd:anyURI,
    "https://cdd.iec.ch/cdd/iec61987/iec61987.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD054"^^xsd:anyURI;
  qudt:siExactMatch <https://si-digital-framework.org/SI/quantities/FORC>, <https://si-digital-framework.org/quantities/FORC>;
  qudt:symbol "F", "F";
  qudt:isoNormativeReference "http://www.iso.org/iso/catalogue_detail?csnumber=43012"^^xsd:anyURI,
    "http://www.iso.org/iso/catalogue_detail?csnumber=43012"^^xsd:anyURI;
  qudt:latexDefinition "$F = \\frac{dp}{dt}$, where $F$ is the resultant force acting on a body, $p$ is momentum of a body, and $t$ is time."^^qudt:LatexString,
    "$F = \\frac{dp}{dt}$, where $F$ is the resultant force acting on a body, $p$ is momentum of a body, and $t$ is time."^^qudt:LatexString;
  qudt:applicableUnit unit:CentiN, unit:CentiN, unit:DYN, unit:DYN, unit:DeciN, unit:DeciN,
    unit:GM_F, unit:GM_F, unit:KIP_F, unit:KIP_F, unit:KiloGM-M-PER-SEC2, unit:KiloGM-M-PER-SEC2,
    unit:N, unit:N, unit:KiloGM_F, unit:KiloGM_F, unit:KiloPOND, unit:KiloPOND, unit:KiloLB_F,
    unit:KiloLB_F, unit:KiloN, unit:KiloN, unit:LB_F, unit:LB_F, unit:MegaLB_F, unit:MegaLB_F,
    unit:MegaN, unit:MegaN, unit:MicroN, unit:MicroN, unit:MilliN, unit:MilliN, unit:OZ_F,
    unit:OZ_F, unit:PDL, unit:PDL, unit:POND, unit:POND, unit:PlanckForce, unit:PlanckForce,
    unit:TON_F_US, unit:TON_F_US, unit:GigaN, unit:NanoN .

