    skos:broader quantitykind:DimensionlessRatio .

quantitykind:SphericalIlluminance a qudt:QuantityKind ;
    rdfs:label "Illuminance"@en ;
    dct:description "Spherical illuminance is equal to quotient of the total luminous flux $\\Phi_v$ incident on a small sphere by the cross section area of that sphere."^^qudt:LatexString ;
