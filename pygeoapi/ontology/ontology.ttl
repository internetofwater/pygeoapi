variablename: a owl:Ontology ;
    owl:imports dct: .

variablename:c_1ebf5e4c a skos:Concept ;
    dct:creator "Faith Sternlieb"@en,
        "Sara Larsen"@en ;
    skos:altLabel "streamflow"@en,
        "upstream"@en ;
    skos:definition """Amount of water entering a reservoir from upstream sources.  Usually measured in cubic feet per second (CFS) or cubic meters per second (CMS). Typically tied to streamgage data. Usually upstream of reservoir.  Can be multiple inflows to a reservoir.  

"""@en ;
    skos:editorialNote "Preferred Units: CFS, CMS (scientific)"@en,
        "Timestap: Daily"@en ;
