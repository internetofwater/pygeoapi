unit:HectoPA-PER-HR a <http://qudt.org/schema/qudt/Unit>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/unit>;
  rdfs:label "Hectopascals per hour"@en;
  dct:description "A change in pressure of one hundred Newtons per square metre (100 Pascals) per hour. Equivalent to a change of one millibar per hour."@en;
  <http://qudt.org/schema/qudt/applicableSystem> <http://qudt.org/vocab/sou/CGS-EMU>,
    <http://qudt.org/vocab/sou/CGS-GAUSS>, <http://qudt.org/vocab/sou/SI>, <http://qudt.org/vocab/sou/CGS>;
  <http://qudt.org/schema/qudt/conversionMultiplier> 0.0277777777777778;
  <http://qudt.org/schema/qudt/conversionMultiplierSN> 2.77777777777778E-2;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L-1I0M1H0T-3D0>;
  <http://qudt.org/schema/qudt/hasQuantityKind> <http://qudt.org/vocab/quantitykind/ForcePerAreaTime>;
  <http://qudt.org/schema/qudt/symbol> "hPa/h";
  <http://qudt.org/schema/qudt/ucumCode> "hPa.h-1"^^<http://qudt.org/schema/qudt/UCUMcs> .

unit:HectoPA-PER-K a <http://qudt.org/schema/qudt/Unit>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/unit>;
  rdfs:label "Hectopascal per Kelvin"@en;
  dct:description "100-fold of the SI derived unit pascal divided by the SI base unit kelvin"^^rdf:HTML;
