quantitykind:PeltierCoefficient a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "Peltier Coefficient"@en, "Peltier Coefficient"@en;
  dct:description "\"Peltier Coefficient\" represents how much heat current is carried per unit charge through a given material. It is the heat power developed at a junction, divided by the electric current flowing from substance a to substance b."^^qudt:LatexString,
    "\"Peltier Coefficient\" represents how much heat current is carried per unit charge through a given material. It is the heat power developed at a junction, divided by the electric current flowing from substance a to substance b."^^qudt:LatexString;
  qudt:hasDimensionVector dimensionvector:A0E-1L2I0M1H0T-3D0, dimensionvector:A0E-1L2I0M1H0T-3D0;
  qudt:informativeReference "http://en.wikipedia.org/wiki/Thermoelectric_effect"^^xsd:anyURI,
    "http://en.wikipedia.org/wiki/Thermoelectric_effect"^^xsd:anyURI;
  qudt:isoNormativeReference "http://www.iso.org/iso/catalogue_detail?csnumber=31897"^^xsd:anyURI,
    "http://www.iso.org/iso/catalogue_detail?csnumber=31897"^^xsd:anyURI;
  qudt:plainTextDescription "\"Peltier Coefficient\" represents how much heat current is carried per unit charge through a given material. It is the heat power developed at a junction, divided by the electric current flowing from substance a to substance b.",
    "\"Peltier Coefficient\" represents how much heat current is carried per unit charge through a given material. It is the heat power developed at a junction, divided by the electric current flowing from substance a to substance b.";
  qudt:latexSymbol "$\\Pi_{ab}$"^^qudt:LatexString, "$\\Pi_{ab}$"^^qudt:LatexString .

quantitykind:PhaseDifference a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "Phasenverschiebungswinkel"@de, "Phasenverschiebungswinkel"@de, "diferencia de fase"@es,
    "diferencia de fase"@es, "diferença de fase"@pt, "diferença de fase"@pt, "différence de phase"@fr,
    "différence de phase"@fr, "phase difference"@en, "phase difference"@en, "przesunięcie fazowe"@pl,
    "przesunięcie fazowe"@pl, "sfasamento angolare"@it, "sfasamento angolare"@it, "اختلاف طور"@ar,
    "اختلاف طور"@ar, "位相差"@ja, "位相差"@ja;
  rdfs:comment "Applicable units are those of quantitykind:Angle", "Applicable units are those of quantitykind:Angle";
  dct:description "\"Phase Difference\" is the difference, expressed in electrical degrees or time, between two waves having the same frequency and referenced to the same point in time. Two oscillators that have the same frequency and different phases have a phase difference, and the oscillators are said to be out of phase with each other. The amount by which such oscillators are out of step with each other can be expressed in degrees from $0^\\circ$ to $360^\\circ$, or in radians from 0 to ${2\\pi}$. If the phase difference is $180^\\circ$ ($\\pi$ radians), then the two oscillators are said to be in antiphase."^^qudt:LatexString,
    "\"Phase Difference\" is the difference, expressed in electrical degrees or time, between two waves having the same frequency and referenced to the same point in time. Two oscillators that have the same frequency and different phases have a phase difference, and the oscillators are said to be out of phase with each other. The amount by which such oscillators are out of step with each other can be expressed in degrees from $0^\\circ$ to $360^\\circ$, or in radians from 0 to ${2\\pi}$. If the phase difference is $180^\\circ$ ($\\pi$ radians), then the two oscillators are said to be in antiphase."^^qudt:LatexString;
  skos:altLabel "desfasagem"@pt, "desfasagem"@pt, "déphasage"@fr, "déphasage"@fr;
  skos:broader quantitykind:Angle, quantitykind:Angle;
  qudt:hasDimensionVector dimensionvector:A0E0L0I0M0H0T0D1, dimensionvector:A0E0L0I0M0H0T0D1;
  qudt:informativeReference "http://www.iso.org/iso/home/store/catalogue_tc/catalogue_detail.htm?csnumber=31891"^^xsd:anyURI,
    "http://www.iso.org/iso/home/store/catalogue_tc/catalogue_detail.htm?csnumber=31891"^^xsd:anyURI,
    "http://en.wikipedia.org/wiki/Phase_(waves)#Phase_difference"^^xsd:anyURI, "http://en.wikipedia.org/wiki/Phase_(waves)#Phase_difference"^^xsd:anyURI,
    "http://www.electropedia.org/iev/iev.nsf/display?openform&ievref=103-07-06"^^xsd:anyURI,
    "http://www.electropedia.org/iev/iev.nsf/display?openform&ievref=103-07-06"^^xsd:anyURI;
  qudt:expression "$phase-difference$"^^qudt:LatexString, "$phase-difference$"^^qudt:LatexString;
  qudt:isoNormativeReference "http://www.iso.org/iso/catalogue_detail?csnumber=43012"^^xsd:anyURI,
    "http://www.iso.org/iso/catalogue_detail?csnumber=43012"^^xsd:anyURI;
  qudt:latexSymbol "$\\varphi$"^^qudt:LatexString, "$\\varphi$"^^qudt:LatexString;
  qudt:latexDefinition "$\\varphi = \\varphi_u - \\varphi_i$, where $\\varphi_u$ is the initial phase of the voltage and $\\varphi_i$ is the initial phase of the electric current."^^qudt:LatexString,
    "$\\varphi = \\varphi_u - \\varphi_i$, where $\\varphi_u$ is the initial phase of the voltage and $\\varphi_i$ is the initial phase of the electric current."^^qudt:LatexString;
