<http://qudt.org/vocab/quantitykind/ReactionEnergy> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Reaction Energy"@en;
  rdfs:comment "Applicable units are those of quantitykind:Energy";
  dct:description "\"Reaction Energy\" in a nuclear reaction, is the sum of the kinetic energies and photon energies of the reaction products minus the sum of the kinetic and photon energies of the reactants."^^<http://qudt.org/schema/qudt/LatexString>;
