quantitykind:Wavelength a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "Jarak gelombang"@ms, "Jarak gelombang"@ms, "Vlnové délka"@cs, "Vlnové délka"@cs,
    "Wellenlänge"@de, "Wellenlänge"@de, "comprimento de onda"@pt, "comprimento de onda"@pt,
    "dalga boyu"@tr, "dalga boyu"@tr, "longitud de onda"@es, "longitud de onda"@es, "longueur d'onde"@fr,
    "longueur d'onde"@fr, "lunghezza d'onda"@it, "lunghezza d'onda"@it, "wavelength"@en,
    "wavelength"@en, "длина волны"@ru, "длина волны"@ru, "طول موج"@fa, "طول موج"@fa, "波长"@zh,
    "波长"@zh;
  rdfs:comment "Applicable units are those of quantitykind:Length", "Applicable units are those of quantitykind:Length";
  dct:description "For a monochromatic wave, \"wavelength\" is the distance between two successive points in a direction perpendicular to the wavefront where at a given instant the phase differs by $2\\pi$. The wavelength of a sinusoidal wave is the spatial period of the wave—the distance over which the wave's shape repeats. The SI unit of wavelength is the meter."^^qudt:LatexString,
    "For a monochromatic wave, \"wavelength\" is the distance between two successive points in a direction perpendicular to the wavefront where at a given instant the phase differs by $2\\pi$. The wavelength of a sinusoidal wave is the spatial period of the wave—the distance over which the wave's shape repeats. The SI unit of wavelength is the meter."^^qudt:LatexString;
  skos:broader quantitykind:Length, quantitykind:Length;
  qudt:hasDimensionVector dimensionvector:A0E0L1I0M0H0T0D0, dimensionvector:A0E0L1I0M0H0T0D0;
  qudt:informativeReference "http://en.wikipedia.org/wiki/Wavelength"^^xsd:anyURI, "http://en.wikipedia.org/wiki/Wavelength"^^xsd:anyURI;
  qudt:symbol "λ", "λ";
  qudt:latexDefinition "$\\lambda = \\frac{c}{\\nu}$, where $\\lambda$ is the wave length, $\\nu$ is the frequency, and $c$ is the speed of light in the medium."^^qudt:LatexString,
    "$\\lambda = \\frac{c}{\\nu}$, where $\\lambda$ is the wave length, $\\nu$ is the frequency, and $c$ is the speed of light in the medium."^^qudt:LatexString;
