unit:MilliGAL-PER-MO a <http://qudt.org/schema/qudt/Unit>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/unit>;
  rdfs:label "MilliGals per month"@en;
  dct:description "A rate of change of one millionth part of a unit of gravitational acceleration equal to one centimetre per second per second over a time duration of 30.4375 days or 2629800 seconds."@en;
  <http://qudt.org/schema/qudt/conversionMultiplier> 0.000000000003919350772901616281311709002114104;
  <http://qudt.org/schema/qudt/conversionMultiplierSN> 3.919350772901616281311709002114104E-12;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L1I0M0H0T-3D0>;
  <http://qudt.org/schema/qudt/hasQuantityKind> <http://qudt.org/vocab/quantitykind/Unknown>;
  <http://qudt.org/schema/qudt/symbol> "mgal/mo";
