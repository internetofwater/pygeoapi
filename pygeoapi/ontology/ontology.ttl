unit:OHM a qudt:Unit, qudt:Unit, qudt:DerivedUnit, qudt:DerivedUnit;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/unit>, <http://qudt.org/vocab/unit>;
  rdfs:label "Ohm"@de, "Ohm"@de, "ohm"@cs, "ohm"@cs, "ohm"@en, "ohm"@en, "ohm"@fr, "ohm"@fr,
    "ohm"@hu, "ohm"@hu, "ohm"@it, "ohm"@it, "ohm"@ms, "ohm"@ms, "ohm"@pt, "ohm"@pt, "ohm"@ro,
    "ohm"@ro, "ohm"@sl, "ohm"@sl, "ohm"@tr, "ohm"@tr, "ohmio"@es, "ohmio"@es, "ohmium"@la,
    "ohmium"@la, "om"@pl, "om"@pl, "ωμ"@el, "ωμ"@el, "ом"@bg, "ом"@bg, "ом"@ru, "ом"@ru,
    "אוהם"@he, "אוהם"@he, "أوم"@ar, "أوم"@ar, "اهم"@fa, "اهم"@fa, "ओह्म"@hi, "ओह्म"@hi,
    "オーム"@ja, "オーム"@ja, "欧姆"@zh, "欧姆"@zh;
  dct:description """
  The $\\textit{ohm}$ is the SI derived unit of electrical resistance, named after German physicist Georg Simon Ohm. 
  
  It is defined as:
  
  $$\\Omega \\equiv\\ \\frac{\\text{V}}{\\text{A}}\\ \\equiv\\ \\frac{\\text{volt}}{\\text{amp}}\\ \\equiv\\ \\frac{\\text{W}}{\\text {A}^{2}}\\ \\equiv\\ \\frac{\\text{watt}}{\\text{amp}^{2}}\\ \\equiv\\ \\frac{\\text{H}}{\\text {s}}\\ \\equiv\\ \\frac{\\text{henry}}{\\text{second}}$$
  
  """^^qudt:LatexString,
    """
  The $\\textit{ohm}$ is the SI derived unit of electrical resistance, named after German physicist Georg Simon Ohm. 
  
  It is defined as:
  
  $$\\Omega \\equiv\\ \\frac{\\text{V}}{\\text{A}}\\ \\equiv\\ \\frac{\\text{volt}}{\\text{amp}}\\ \\equiv\\ \\frac{\\text{W}}{\\text {A}^{2}}\\ \\equiv\\ \\frac{\\text{watt}}{\\text{amp}^{2}}\\ \\equiv\\ \\frac{\\text{H}}{\\text {s}}\\ \\equiv\\ \\frac{\\text{henry}}{\\text{second}}$$
  
  """^^qudt:LatexString;
  qudt:applicableSystem <http://qudt.org/vocab/sou/CGS-EMU>, <http://qudt.org/vocab/sou/CGS-EMU>,
    <http://qudt.org/vocab/sou/CGS-GAUSS>, <http://qudt.org/vocab/sou/CGS-GAUSS>, <http://qudt.org/vocab/sou/PLANCK>,
    <http://qudt.org/vocab/sou/PLANCK>, <http://qudt.org/vocab/sou/SI>, <http://qudt.org/vocab/sou/SI>;
  qudt:conversionMultiplier 1.0, 1.0;
  qudt:conversionMultiplierSN 1.0E0, 1.0E0;
  qudt:dbpediaMatch "http://dbpedia.org/resource/Ohm"^^xsd:anyURI, "http://dbpedia.org/resource/Ohm"^^xsd:anyURI;
  qudt:hasDimensionVector dimensionvector:A0E-2L2I0M1H0T-3D0, dimensionvector:A0E-2L2I0M1H0T-3D0;
  qudt:hasQuantityKind quantitykind:Resistance, quantitykind:Resistance, quantitykind:Impedance,
    quantitykind:Impedance, quantitykind:ModulusOfImpedance, quantitykind:ModulusOfImpedance,
    quantitykind:Reactance, quantitykind:Reactance;
  qudt:iec61360Code "0112/2///62720#UAA017", "0112/2///62720#UAA017";
  qudt:informativeReference "http://en.wikipedia.org/wiki/Ohm?oldid=494685555"^^xsd:anyURI,
    "http://en.wikipedia.org/wiki/Ohm?oldid=494685555"^^xsd:anyURI, "https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAA017"^^xsd:anyURI,
    "https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAA017"^^xsd:anyURI;
  qudt:omUnit <http://www.ontology-of-units-of-measure.org/resource/om-2/ohm>, <http://www.ontology-of-units-of-measure.org/resource/om-2/ohm>;
  qudt:siExactMatch <https://si-digital-framework.org/SI/units/ohm>, <https://si-digital-framework.org/SI/units/ohm>;
  qudt:symbol "Ω", "Ω";
