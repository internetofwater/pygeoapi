  qudt:informativeReference "http://wordinfo.info/results/abampere"^^xsd:anyURI, "http://wordinfo.info/results/abampere"^^xsd:anyURI,
    "http://www.efunda.com/glossary/units/units--electric_current_density--abampere_per_square_centimeter.cfm"^^xsd:anyURI,
    "http://www.efunda.com/glossary/units/units--electric_current_density--abampere_per_square_centimeter.cfm"^^xsd:anyURI;
  qudt:symbol "abA/cm²", "abA/cm²";
