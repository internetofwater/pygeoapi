quantitykind:SignalStrength a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "Signal Strength"@en, "Signal Strength"@en;
  rdfs:comment "Applicable units are those of quantitykind:ElectricField", "Applicable units are those of quantitykind:ElectricField";
  dct:description "In telecommunications, particularly in radio, signal strength refers to the magnitude of the electric field at a reference point that is a significant distance from the transmitting antenna. It may also be referred to as received signal level or field strength. Typically, it is expressed in voltage per length or signal power received by a reference antenna. High-powered transmissions, such as those used in broadcasting, are expressed in dB-millivolts per metre (dBmV/m)."^^qudt:LatexString,
    "In telecommunications, particularly in radio, signal strength refers to the magnitude of the electric field at a reference point that is a significant distance from the transmitting antenna. It may also be referred to as received signal level or field strength. Typically, it is expressed in voltage per length or signal power received by a reference antenna. High-powered transmissions, such as those used in broadcasting, are expressed in dB-millivolts per metre (dBmV/m)."^^qudt:LatexString;
  skos:broader quantitykind:ElectricFieldStrength, quantitykind:ElectricFieldStrength,
    quantitykind:ElectricField, quantitykind:ElectricField;
  qudt:dbpediaMatch "http://dbpedia.org/resource/Signal_strength"^^xsd:anyURI, "http://dbpedia.org/resource/Signal_strength"^^xsd:anyURI;
  qudt:hasDimensionVector dimensionvector:A0E-1L1I0M1H0T-3D0, dimensionvector:A0E-1L1I0M1H0T-3D0;
  qudt:plainTextDescription "In telecommunications, particularly in radio, signal strength refers to the magnitude of the electric field at a reference point that is a significant distance from the transmitting antenna. It may also be referred to as received signal level or field strength. Typically, it is expressed in voltage per length or signal power received by a reference antenna. High-powered transmissions, such as those used in broadcasting, are expressed in dB-millivolts per metre (dBmV/m).",
    "In telecommunications, particularly in radio, signal strength refers to the magnitude of the electric field at a reference point that is a significant distance from the transmitting antenna. It may also be referred to as received signal level or field strength. Typically, it is expressed in voltage per length or signal power received by a reference antenna. High-powered transmissions, such as those used in broadcasting, are expressed in dB-millivolts per metre (dBmV/m).";
