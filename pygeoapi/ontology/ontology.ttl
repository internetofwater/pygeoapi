quantitykind:AverageSpecificImpulse a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "Average Specific Impulse"@en, "Average Specific Impulse"@en;
  rdfs:comment "Avg Specific Impulse (lbf-sec/lbm) ", "Avg Specific Impulse (lbf-sec/lbm) ";
  skos:broader quantitykind:SpecificImpulse, quantitykind:SpecificImpulse;
  qudt:hasDimensionVector dimensionvector:A0E0L0I0M0H0T1D0, dimensionvector:A0E0L0I0M0H0T1D0 .

quantitykind:SpecificImpulse a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:seeAlso quantitykind:MassFlowRate, quantitykind:MassFlowRate;
  rdfs:label "Specific Impulse"@en, "Specific Impulse"@en;
  dct:description "The impulse produced by a rocket divided by the mass $mp$ of propellant consumed. Specific impulse ${I_{sp}}$ is a widely used measure of performance for chemical, nuclear, and electric rockets. It is usually given in seconds for both U.S. Customary and International System (SI) units.  The impulse produced by a rocket is the thrust force $F$ times its duration $t$ in seconds. $I_{sp}$ is the thrust per unit mass flowrate, but with $g_o$, is the thrust per weight flowrate. The specific impulse is given by the equation: $I_{sp} = \\frac{F}{\\dot{m}g_o}$."^^qudt:LatexString,
    "The impulse produced by a rocket divided by the mass $mp$ of propellant consumed. Specific impulse ${I_{sp}}$ is a widely used measure of performance for chemical, nuclear, and electric rockets. It is usually given in seconds for both U.S. Customary and International System (SI) units.  The impulse produced by a rocket is the thrust force $F$ times its duration $t$ in seconds. $I_{sp}$ is the thrust per unit mass flowrate, but with $g_o$, is the thrust per weight flowrate. The specific impulse is given by the equation: $I_{sp} = \\frac{F}{\\dot{m}g_o}$."^^qudt:LatexString;
  qudt:hasDimensionVector dimensionvector:A0E0L0I0M0H0T1D0, dimensionvector:A0E0L0I0M0H0T1D0;
  qudt:informativeReference "http://www.grc.nasa.gov/WWW/K-12/airplane/specimp.html"^^xsd:anyURI,
    "http://www.grc.nasa.gov/WWW/K-12/airplane/specimp.html"^^xsd:anyURI .

