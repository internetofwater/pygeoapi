unit:PERM_Metric a qudt:Unit, qudt:Unit;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/unit>, <http://qudt.org/vocab/unit>;
  rdfs:label "Metric Perm"@en, "Metric Perm"@en;
  dct:description "A perm is a unit of permeance or \"water vapor transmission\" given a certain differential in partial pressures on either side of a material or membrane. The metric perm (not an SI unit) is defined as 1 gram of water vapor per day, per square metre, per millimeter of mercury."@en,
    "The rate of water vapor transmission through a specific thickness of a material—i.e., the permeability divided by the thickness.";
  qudt:conversionMultiplier 0.000000000001, 0.0000000000868127;
  qudt:conversionMultiplierSN 1.0E-12, 8.68127E-11;
  qudt:hasDimensionVector dimensionvector:A0E0L-1I0M0H0T1D0, dimensionvector:A0E0L-1I0M0H0T1D0;
  qudt:hasQuantityKind quantitykind:VaporPermeance, quantitykind:VapourPermeance;
  qudt:informativeReference "https://en.wikipedia.org/wiki/Perm_(unit)"^^xsd:anyURI,
    "https://en.wikipedia.org/wiki/Perm_(unit)"^^xsd:anyURI;
  qudt:symbol "perm{Metric}", "perm{Metric}";
  qudt:latexDefinition "\\frac{ng}{s \\cdot m^2 \\cdot Pa}"^^qudt:LatexString;
  qudt:scalingOf unit:SEC-PER-M .

