  rdfs:label "Systolic Blood Pressure"@en;
  rdfs:comment "Applicable units are those of quantitykind:ForcePerArea";
  dct:description "The pressure of blood in the arteries which rises to a maximum as blood is pumped out by the left ventricle (systole) and drops to a minimum in diastole. The systolic/diastolic pressure is normally ~120/80 mmHg in a young adult."^^<http://qudt.org/schema/qudt/LatexString>;
  skos:broader <http://qudt.org/vocab/quantitykind/Pressure>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L-1I0M1H0T-2D0>;
  <http://qudt.org/schema/qudt/informativeReference> "http://www.oxfordreference.com/display/10.1093/acref/9780199549351.001.0001/acref-9780199549351-e-1162"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/plainTextDescription> "The pressure of blood in the arteries which rises to a maximum as blood is pumped out by the left ventricle (systole) and drops to a minimum in diastole. The systolic/diastolic pressure is normally ~120/80 mmHg in a young adult.";
