    "http://www.iso.org/iso/catalogue_detail?csnumber=31889"^^xsd:anyURI;
  qudt:plainTextDescription "A strain is a normalized measure of deformation representing the displacement between particles in the body relative to a reference length.",
    "A strain is a normalized measure of deformation representing the displacement between particles in the body relative to a reference length.";
  qudt:exactMatch quantitykind:Strain, quantitykind:Strain;
  qudt:latexSymbol "$\\xi$"^^qudt:LatexString, "$\\xi$"^^qudt:LatexString;
