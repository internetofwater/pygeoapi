  skos:broader :c_373429a5;
  skos:related :c_e3222c25 .

:c_97692aa8 a skos:Concept;
  skos:definition "Plans and supports the implementation of the activities of the H&H CoP"@en;
  skos:inScheme :conceptScheme_28b55cfc;
  skos:prefLabel "H&H CoP Implementation Team"@en;
  skos:altLabel "Implementation Team"@en;
  skos:note "Sponsored by the Deputy Commissioner - Operations"@en, "formed in November 2022"@en,
    "Comprised of program managers and subject matter experts from Reclamation regional and Denver directorates"@en,
    "Consissts of representatives from other offices involved in the project who contribute within their area of expertise and accomplish assigned action items to implement the day-to-day development adn execution of the Project"@en,
    "Implementation TEam members are empowered to actively participate in the H&H CoP and invest the time necessary to undertake activities under the H&H CoP Charter."@en;
  skos:broader :c_27cef761 .

