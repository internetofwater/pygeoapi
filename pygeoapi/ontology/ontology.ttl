  <http://qudt.org/schema/qudt/symbol> "0173-1#Z4-BAJ325#003";
  <http://qudt.org/schema/qudt/plainTextDescription> "Durchlassstrom-Kennwert als Bemessungsgröße für Sicherungen und Schalter, welcher abgeleitet ist aus dem sogenannten Joule-Integral"@de .

<http://qudt.org/vocab/quantitykind/CyclotronAngularFrequency> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Larmor Angular Frequency"@en;
  rdfs:comment "Applicable units are those of quantitykind:AngularFrequency";
  dct:description "The \"Cyclotron Angular Frequency\" describes angular momentum vector precession about the external field axis with an angular frequency."^^<http://qudt.org/schema/qudt/LatexString>;
  skos:broader <http://qudt.org/vocab/quantitykind/AngularFrequency>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T-1D0>;
  <http://qudt.org/schema/qudt/informativeReference> "http://en.wikipedia.org/wiki/Electron_cyclotron_resonance"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/isoNormativeReference> "http://www.iso.org/iso/catalogue_detail?csnumber=31895"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/plainTextDescription> "The \"Cyclotron Angular Frequency\" describes angular momentum vector precession about the external field axis with an angular frequency.";
  <http://qudt.org/schema/qudt/latexSymbol> "$\\omega_c$"^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/latexDefinition> "$\\omega_c = \\frac{\\left | q \\right |}{m}B$, where $q$ is the electric charge, $m$ is its mass, and $B$ is the magnetic flux density."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/applicableUnit> unit:DEG-PER-HR, unit:DEG-PER-MIN, unit:DEG-PER-SEC,
    unit:PlanckFrequency_Ang, unit:RAD-PER-HR, unit:RAD-PER-MIN, unit:RAD-PER-SEC .

<http://qudt.org/vocab/quantitykind/DELTA-V> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Delta-V"@en;
  rdfs:comment "Applicable units are those of quantitykind:Velocity";
  dct:description "The change in translational velocity including all losses for a propulsive system or module. Delta-V losses include, but are not limited to, gravity losses and steering losses."^^<http://qudt.org/schema/qudt/LatexString>;
  skos:broader <http://qudt.org/vocab/quantitykind/Velocity>;
