  <http://qudt.org/schema/qudt/iec61360Code> "0112/2///62720#UAD045";
  <http://qudt.org/schema/qudt/informativeReference> "https://cdd.iec.ch/cdd/iec61987/iec61987.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD045"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/siExactMatch> <https://si-digital-framework.org/SI/quantities/ELRE>;
  <http://qudt.org/schema/qudt/symbol> "0173-1#Z4-BAJ215#003";
  <http://qudt.org/schema/qudt/applicableUnit> unit:NanoOHM .

