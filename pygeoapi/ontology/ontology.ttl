  <http://qudt.org/schema/qudt/udunitsCode> "psi";
  <http://qudt.org/schema/qudt/uneceCommonCode> "PS";
  <http://qudt.org/schema/qudt/plainTextDescription> "Pounds of force per square inch, the unit for pressure as a compounded unit pound-force according to the Anglo-American system of units divided by the power of the unit Inch according to the Anglo-American and Imperial system of units by exponent 2";
  <http://qudt.org/schema/qudt/definedUnitOfSystem> <http://qudt.org/vocab/sou/IMPERIAL>,
    <http://qudt.org/vocab/sou/USCS>;
