<http://qudt.org/vocab/quantitykind/LogarithmRatioToBase10> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "logarithm ratio to base 10"@en-US;
  dct:description "common logarithm of the ratio between the value of a defined variable and the value of a reference variable of the same type"@en,
    "dekadischer Logarithmus des Verhältnisses des Werts einer gegebenen Größe zum Wert einer Bezugsgröße gleicher Art"@de;
