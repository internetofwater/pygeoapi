  <http://qudt.org/schema/qudt/applicableUnit> unit:NUM, unit:UNITLESS .

<http://qudt.org/vocab/quantitykind/PlanarForce> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Flächenlast"@de, "Planar Force"@en;
  rdfs:comment "Applicable units are those of quantitykind:ForcePerArea";
  dct:description "Another name for Force Per Area, used by the Industry Foundation Classes (IFC) standard."^^<http://qudt.org/schema/qudt/LatexString>;
  skos:broader <http://qudt.org/vocab/quantitykind/ForcePerArea>;
