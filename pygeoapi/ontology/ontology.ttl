quantitykind:MagneticDipoleMoment a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "Magnetic Dipole Moment"@en, "Magnetic Dipole Moment"@en;
  rdfs:comment "Applicable units are those of quantitykind:MagneticDipoleMoment", "Applicable units are those of quantitykind:MagneticDipoleMoment";
  dct:description "\"Magnetic Dipole Moment\" is the magnetic moment of a system is a measure of the magnitude and the direction of its magnetism. Magnetic moment usually refers to its Magnetic Dipole Moment, and quantifies the contribution of the system's internal magnetism to the external dipolar magnetic field produced by the system (that is, the component of the external magnetic field that is inversely proportional to the cube of the distance to the observer). The Magnetic Dipole Moment is a vector-valued quantity. For a particle or nucleus, vector quantity causing an increment $\\Delta W = -\\mu \\cdot B$ to its energy $W$ in an external magnetic field with magnetic flux density $B$."^^qudt:LatexString,
    "\"Magnetic Dipole Moment\" is the magnetic moment of a system is a measure of the magnitude and the direction of its magnetism. Magnetic moment usually refers to its Magnetic Dipole Moment, and quantifies the contribution of the system's internal magnetism to the external dipolar magnetic field produced by the system (that is, the component of the external magnetic field that is inversely proportional to the cube of the distance to the observer). The Magnetic Dipole Moment is a vector-valued quantity. For a particle or nucleus, vector quantity causing an increment $\\Delta W = -\\mu \\cdot B$ to its energy $W$ in an external magnetic field with magnetic flux density $B$."^^qudt:LatexString;
  qudt:hasDimensionVector dimensionvector:A0E-1L3I0M1H0T-2D0, dimensionvector:A0E-1L3I0M1H0T-2D0;
  qudt:iec61360Code "0112/2///62720#UAD096", "0112/2///62720#UAD096";
  qudt:informativeReference "http://www.iso.org/iso/home/store/catalogue_tc/catalogue_detail.htm?csnumber=31891"^^xsd:anyURI,
    "http://www.iso.org/iso/home/store/catalogue_tc/catalogue_detail.htm?csnumber=31891"^^xsd:anyURI,
    "http://www.electropedia.org/iev/iev.nsf/display?openform&ievref=121-11-55"^^xsd:anyURI,
    "http://www.electropedia.org/iev/iev.nsf/display?openform&ievref=121-11-55"^^xsd:anyURI,
    "https://cdd.iec.ch/cdd/iec61987/iec61987.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD096"^^xsd:anyURI,
    "https://cdd.iec.ch/cdd/iec61987/iec61987.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD096"^^xsd:anyURI,
    "https://www.simetric.co.uk/siderived.htm"^^xsd:anyURI, "https://www.simetric.co.uk/siderived.htm"^^xsd:anyURI;
  qudt:symbol "J_m", "J_m";
  qudt:isoNormativeReference "http://www.iso.org/iso/catalogue_detail?csnumber=31895"^^xsd:anyURI,
    "http://www.iso.org/iso/catalogue_detail?csnumber=31895"^^xsd:anyURI, "http://www.iso.org/iso/catalogue_detail?csnumber=31894"^^xsd:anyURI,
    "http://www.iso.org/iso/catalogue_detail?csnumber=31894"^^xsd:anyURI;
  qudt:latexSymbol "$\\mu$"^^qudt:LatexString, "$\\mu$"^^qudt:LatexString;
  qudt:latexDefinition """$E_m = -m \\cdot B$, where $E_m$ is the interaction energy of the molecule with magnetic diploe moment $m$ and a magnetic field with magnetic flux density $B$

or,

$J_m = \\mu_0 M$ where $\\mu_0$ is the magnetic constant and $M$ is Magnetization."""^^qudt:LatexString,
    """$E_m = -m \\cdot B$, where $E_m$ is the interaction energy of the molecule with magnetic diploe moment $m$ and a magnetic field with magnetic flux density $B$

or,

$J_m = \\mu_0 M$ where $\\mu_0$ is the magnetic constant and $M$ is Magnetization."""^^qudt:LatexString;
  qudt:applicableUnit unit:N-M2-PER-A, unit:N-M2-PER-A, unit:WB-M, unit:WB-M .

