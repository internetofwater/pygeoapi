variablename:bromide a skos:Concept;
  skos:definition "A bromide is a chemical compound containing a bromide ion or ligand. This is a bromine atom with an ionic charge of −1 (Br−); for example, in caesium bromide, caesium cations (Cs+) are electrically attracted to bromide anions (Br−) to form the electrically neutral ionic compound CsBr. The term \"bromide\" can also refer to a bromine atom with an oxidation number of −1 in covalent compounds such as sulfur dibromide (SBr2). ";
  skos:inScheme <http://vocabulary.odm2.org/variablename>;
  skos:topConceptOf <http://vocabulary.odm2.org/variablename>;
  skos:prefLabel "Bromide";
  skos:note "Added to support Critical Zone Observatory (CZO) data use cases. ";
  skos:historyNote "Wikipedia";
  skos:exactMatch "https://en.wikipedia.org/wiki/Bromide" .

