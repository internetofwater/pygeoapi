<http://qudt.org/vocab/quantitykind/Flux> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Flux"@en;
  rdfs:comment "Applicable units are those of quantitykind:Flux";
  dct:description "Flux describes any effect that appears to pass or travel (whether it actually moves or not) through a surface or substance. [Wikipedia]"^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L-2I0M0H0T-1D0>;
  <http://qudt.org/schema/qudt/informativeReference> "https://en.wikipedia.org/wiki/Flux"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/plainTextDescription> "Flux describes any effect that appears to pass or travel (whether it actually moves or not) through a surface or substance. [Wikipedia]";
  <http://qudt.org/schema/qudt/applicableUnit> unit:MicroM-PER-L-DAY, unit:NUM-PER-HA-YR,
    unit:NUM-PER-M2-DAY, unit:PER-M2-SEC, unit:PER-SEC-M2 .

<http://qudt.org/vocab/quantitykind/ParticleFluenceRate> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Particle Fluence Rate"@en;
  rdfs:comment "Applicable units are those of quantitykind:ParticleFluenceRate";
  dct:description "\"Particle Fluence Rate\" can be defined as the total number of particles (typically Gamma Ray Photons ) crossing over a sphere of unit cross section which surrounds a Point Source of Ionising Radiation."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L-2I0M0H0T-1D0>;
  <http://qudt.org/schema/qudt/informativeReference> "http://www.encyclo.co.uk/define/Fluence+Rate"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/isoNormativeReference> "http://www.iso.org/iso/catalogue_detail?csnumber=31895"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/plainTextDescription> "\"Particle Fluence Rate\" can be defined as the total number of particles (typically Gamma Ray Photons ) crossing over a sphere of unit cross section which surrounds a Point Source of Ionising Radiation.";
  <http://qudt.org/schema/qudt/latexSymbol> "$\\theta$"^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/latexDefinition> "$\\theta = \\frac{d\\Phi}{dt}$, where $d\\Phi$ is the increment of the particle fluence during an infinitesimal time interval with duration $dt$."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/applicableUnit> unit:MicroM-PER-L-DAY, unit:PER-M2-SEC .

