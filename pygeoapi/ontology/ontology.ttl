  rdfs:label "A0E0L2I0M1H0T-1D0";
  <http://qudt.org/schema/qudt/latexDefinition> "$L^2 M T^-1$"^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/hasReferenceQuantityKind> <http://qudt.org/vocab/quantitykind/AngularMomentum>;
