  qudt:symbol "L", "L";
  qudt:latexDefinition "$L_W = 10 \\log_{10} \\frac{P}{P_0} dB$, where $P$ is sound power and the reference value is $P_0 =1pW$."^^qudt:LatexString,
    "$L_W = 10 \\log_{10} \\frac{P}{P_0} dB$, where $P$ is sound power and the reference value is $P_0 =1pW$."^^qudt:LatexString;
  <http://www.linkedmodel.org/schema/vaem#todo> "belongs to SOQ-ISO", "belongs to SOQ-ISO";
  qudt:applicableUnit unit:B, unit:B, unit:DeciB, unit:DeciB, unit:DeciB_A, unit:DeciB_A,
