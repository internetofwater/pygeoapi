  dct:issued "2000-07-11"^^xsd:date, "2000-07-11"^^xsd:date .

dct:isRequiredBy a rdf:Property, rdf:Property;
  rdfs:isDefinedBy <http://purl.org/dc/terms/>, <http://purl.org/dc/terms/>;
  rdfs:label "Is Required By"@en, "Is Required By"@en;
  rdfs:comment "A related resource that requires the described resource to support its function, delivery, or coherence."@en,
