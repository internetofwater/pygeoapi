<http://www.w3.org/1999/02/22-rdf-syntax-ns#> a owl:Ontology, owl:Ontology;
  dc:title "The RDF Concepts Vocabulary (RDF)", "The RDF Concepts Vocabulary (RDF)";
  dc:description "This is the RDF Schema for the RDF vocabulary terms in the RDF Namespace, defined in RDF 1.1 Concepts.",
    "This is the RDF Schema for the RDF vocabulary terms in the RDF Namespace, defined in RDF 1.1 Concepts.";
  rdfs:seeAlso <http://www.w3.org/2000/01/rdf-schema-more>, <http://www.w3.org/2000/01/rdf-schema-more> .

rdf:type a rdf:Property, rdf:Property;
  rdfs:isDefinedBy <http://www.w3.org/1999/02/22-rdf-syntax-ns#>, <http://www.w3.org/1999/02/22-rdf-syntax-ns#>;
  rdfs:label "type", "type";
  rdfs:comment "The subject is an instance of a class.", "The subject is an instance of a class.";
  rdfs:range rdfs:Class, rdfs:Class;
  rdfs:domain rdfs:Resource, rdfs:Resource .

owl:Ontology a rdfs:Class, rdfs:Class;
  rdfs:subClassOf rdfs:Resource, rdfs:Resource;
  rdfs:isDefinedBy <http://www.w3.org/2002/07/owl#>, <http://www.w3.org/2002/07/owl#>;
  rdfs:label "Ontology", "Ontology";
  rdfs:comment "The class of ontologies.", "The class of ontologies." .

rdf:HTML a rdfs:Datatype, rdfs:Datatype;
  rdfs:subClassOf rdfs:Literal, rdfs:Literal;
  rdfs:isDefinedBy <http://www.w3.org/1999/02/22-rdf-syntax-ns#>, <http://www.w3.org/1999/02/22-rdf-syntax-ns#>;
  rdfs:seeAlso <http://www.w3.org/TR/rdf11-concepts/#section-html>, <http://www.w3.org/TR/rdf11-concepts/#section-html>;
  rdfs:label "HTML", "HTML";
  rdfs:comment "The datatype of RDF literals storing fragments of HTML content", "The datatype of RDF literals storing fragments of HTML content" .

rdfs:Datatype a rdfs:Class, rdfs:Class;
  rdfs:subClassOf rdfs:Class, rdfs:Class;
  rdfs:isDefinedBy <http://www.w3.org/2000/01/rdf-schema#>, <http://www.w3.org/2000/01/rdf-schema#>;
  rdfs:label "Datatype", "Datatype";
  rdfs:comment "The class of RDF datatypes.", "The class of RDF datatypes." .

rdfs:subClassOf a rdf:Property, rdf:Property;
  rdfs:isDefinedBy <http://www.w3.org/2000/01/rdf-schema#>, <http://www.w3.org/2000/01/rdf-schema#>;
  rdfs:label "subClassOf", "subClassOf";
  rdfs:comment "The subject is a subclass of a class.", "The subject is a subclass of a class.";
  rdfs:range rdfs:Class, rdfs:Class;
  rdfs:domain rdfs:Class, rdfs:Class .

rdfs:Literal a rdfs:Class, rdfs:Class;
  rdfs:subClassOf rdfs:Resource, rdfs:Resource;
  rdfs:isDefinedBy <http://www.w3.org/2000/01/rdf-schema#>, <http://www.w3.org/2000/01/rdf-schema#>;
  rdfs:label "Literal", "Literal";
  rdfs:comment "The class of literal values, eg. textual strings and integers.", "The class of literal values, eg. textual strings and integers." .

rdfs:isDefinedBy a rdf:Property, rdf:Property;
  rdfs:isDefinedBy <http://www.w3.org/2000/01/rdf-schema#>, <http://www.w3.org/2000/01/rdf-schema#>;
  rdfs:label "isDefinedBy", "isDefinedBy";
  rdfs:comment "The defininition of the subject resource.", "The defininition of the subject resource.";
  rdfs:range rdfs:Resource, rdfs:Resource;
  rdfs:domain rdfs:Resource, rdfs:Resource;
  rdfs:subPropertyOf rdfs:seeAlso, rdfs:seeAlso .

rdfs:seeAlso a rdf:Property, rdf:Property;
  rdfs:isDefinedBy <http://www.w3.org/2000/01/rdf-schema#>, <http://www.w3.org/2000/01/rdf-schema#>;
  rdfs:label "seeAlso", "seeAlso";
  rdfs:comment "Further information about the subject resource.", "Further information about the subject resource.";
  rdfs:range rdfs:Resource, rdfs:Resource;
  rdfs:domain rdfs:Resource, rdfs:Resource .

rdfs:label a rdf:Property, rdf:Property;
  rdfs:isDefinedBy <http://www.w3.org/2000/01/rdf-schema#>, <http://www.w3.org/2000/01/rdf-schema#>;
  rdfs:label "label", "label";
  rdfs:comment "A human-readable name for the subject.", "A human-readable name for the subject.";
  rdfs:range rdfs:Literal, rdfs:Literal;
  rdfs:domain rdfs:Resource, rdfs:Resource .

rdfs:comment a rdf:Property, rdf:Property;
  rdfs:isDefinedBy <http://www.w3.org/2000/01/rdf-schema#>, <http://www.w3.org/2000/01/rdf-schema#>;
  rdfs:label "comment", "comment";
  rdfs:comment "A description of the subject resource.", "A description of the subject resource.";
  rdfs:range rdfs:Literal, rdfs:Literal;
  rdfs:domain rdfs:Resource, rdfs:Resource .

rdf:langString a rdfs:Datatype, rdfs:Datatype;
  rdfs:subClassOf rdfs:Literal, rdfs:Literal;
  rdfs:isDefinedBy <http://www.w3.org/1999/02/22-rdf-syntax-ns#>, <http://www.w3.org/1999/02/22-rdf-syntax-ns#>;
  rdfs:seeAlso <http://www.w3.org/TR/rdf11-concepts/#section-Graph-Literal>, <http://www.w3.org/TR/rdf11-concepts/#section-Graph-Literal>;
  rdfs:label "langString", "langString";
  rdfs:comment "The datatype of language-tagged string values", "The datatype of language-tagged string values" .

rdf:PlainLiteral a rdfs:Datatype, rdfs:Datatype;
  rdfs:subClassOf rdfs:Literal, rdfs:Literal;
  rdfs:isDefinedBy <http://www.w3.org/1999/02/22-rdf-syntax-ns#>, <http://www.w3.org/1999/02/22-rdf-syntax-ns#>;
  rdfs:seeAlso <http://www.w3.org/TR/rdf-plain-literal/>, <http://www.w3.org/TR/rdf-plain-literal/>;
  rdfs:label "PlainLiteral", "PlainLiteral";
  rdfs:comment "The class of plain (i.e. untyped) literal values, as used in RIF and OWL 2",
    "The class of plain (i.e. untyped) literal values, as used in RIF and OWL 2" .

rdf:Property a rdfs:Class, rdfs:Class;
  rdfs:subClassOf rdfs:Resource, rdfs:Resource;
  rdfs:isDefinedBy <http://www.w3.org/1999/02/22-rdf-syntax-ns#>, <http://www.w3.org/1999/02/22-rdf-syntax-ns#>;
  rdfs:label "Property", "Property";
  rdfs:comment "The class of RDF properties.", "The class of RDF properties." .

rdfs:range a rdf:Property, rdf:Property;
  rdfs:isDefinedBy <http://www.w3.org/2000/01/rdf-schema#>, <http://www.w3.org/2000/01/rdf-schema#>;
  rdfs:label "range", "range";
  rdfs:comment "A range of the subject property.", "A range of the subject property.";
  rdfs:range rdfs:Class, rdfs:Class;
  rdfs:domain rdf:Property, rdf:Property .

rdfs:Class a rdfs:Class, rdfs:Class;
  rdfs:subClassOf rdfs:Resource, rdfs:Resource;
  rdfs:isDefinedBy <http://www.w3.org/2000/01/rdf-schema#>, <http://www.w3.org/2000/01/rdf-schema#>;
  rdfs:label "Class", "Class";
  rdfs:comment "The class of classes.", "The class of classes." .

rdfs:domain a rdf:Property, rdf:Property;
  rdfs:isDefinedBy <http://www.w3.org/2000/01/rdf-schema#>, <http://www.w3.org/2000/01/rdf-schema#>;
  rdfs:label "domain", "domain";
  rdfs:comment "A domain of the subject property.", "A domain of the subject property.";
  rdfs:range rdfs:Class, rdfs:Class;
  rdfs:domain rdf:Property, rdf:Property .

rdfs:Resource a rdfs:Class, rdfs:Class;
  rdfs:isDefinedBy <http://www.w3.org/2000/01/rdf-schema#>, <http://www.w3.org/2000/01/rdf-schema#>;
  rdfs:label "Resource", "Resource";
  rdfs:comment "The class resource, everything.", "The class resource, everything." .

rdf:Statement a rdfs:Class, rdfs:Class;
  rdfs:subClassOf rdfs:Resource, rdfs:Resource;
  rdfs:isDefinedBy <http://www.w3.org/1999/02/22-rdf-syntax-ns#>, <http://www.w3.org/1999/02/22-rdf-syntax-ns#>;
  rdfs:label "Statement", "Statement";
  rdfs:comment "The class of RDF statements.", "The class of RDF statements." .

rdf:subject a rdf:Property, rdf:Property;
  rdfs:isDefinedBy <http://www.w3.org/1999/02/22-rdf-syntax-ns#>, <http://www.w3.org/1999/02/22-rdf-syntax-ns#>;
  rdfs:label "subject", "subject";
  rdfs:comment "The subject of the subject RDF statement.", "The subject of the subject RDF statement.";
  rdfs:range rdfs:Resource, rdfs:Resource;
  rdfs:domain rdf:Statement, rdf:Statement .

rdf:predicate a rdf:Property, rdf:Property;
  rdfs:isDefinedBy <http://www.w3.org/1999/02/22-rdf-syntax-ns#>, <http://www.w3.org/1999/02/22-rdf-syntax-ns#>;
  rdfs:label "predicate", "predicate";
  rdfs:comment "The predicate of the subject RDF statement.", "The predicate of the subject RDF statement.";
  rdfs:range rdfs:Resource, rdfs:Resource;
  rdfs:domain rdf:Statement, rdf:Statement .

rdf:object a rdf:Property, rdf:Property;
  rdfs:isDefinedBy <http://www.w3.org/1999/02/22-rdf-syntax-ns#>, <http://www.w3.org/1999/02/22-rdf-syntax-ns#>;
  rdfs:label "object", "object";
  rdfs:comment "The object of the subject RDF statement.", "The object of the subject RDF statement.";
  rdfs:range rdfs:Resource, rdfs:Resource;
  rdfs:domain rdf:Statement, rdf:Statement .

rdf:Bag a rdfs:Class, rdfs:Class;
  rdfs:subClassOf rdfs:Container, rdfs:Container;
  rdfs:isDefinedBy <http://www.w3.org/1999/02/22-rdf-syntax-ns#>, <http://www.w3.org/1999/02/22-rdf-syntax-ns#>;
  rdfs:label "Bag", "Bag";
  rdfs:comment "The class of unordered containers.", "The class of unordered containers." .

rdfs:Container a rdfs:Class, rdfs:Class;
  rdfs:subClassOf rdfs:Resource, rdfs:Resource;
  rdfs:isDefinedBy <http://www.w3.org/2000/01/rdf-schema#>, <http://www.w3.org/2000/01/rdf-schema#>;
  rdfs:label "Container", "Container";
  rdfs:comment "The class of RDF containers.", "The class of RDF containers." .

rdf:Seq a rdfs:Class, rdfs:Class;
  rdfs:subClassOf rdfs:Container, rdfs:Container;
  rdfs:isDefinedBy <http://www.w3.org/1999/02/22-rdf-syntax-ns#>, <http://www.w3.org/1999/02/22-rdf-syntax-ns#>;
  rdfs:label "Seq", "Seq";
  rdfs:comment "The class of ordered containers.", "The class of ordered containers." .

rdf:Alt a rdfs:Class, rdfs:Class;
  rdfs:subClassOf rdfs:Container, rdfs:Container;
  rdfs:isDefinedBy <http://www.w3.org/1999/02/22-rdf-syntax-ns#>, <http://www.w3.org/1999/02/22-rdf-syntax-ns#>;
  rdfs:label "Alt", "Alt";
  rdfs:comment "The class of containers of alternatives.", "The class of containers of alternatives." .

rdf:value a rdf:Property, rdf:Property;
  rdfs:isDefinedBy <http://www.w3.org/1999/02/22-rdf-syntax-ns#>, <http://www.w3.org/1999/02/22-rdf-syntax-ns#>;
  rdfs:label "value", "value";
  rdfs:comment "Idiomatic property used for structured values.", "Idiomatic property used for structured values.";
  rdfs:range rdfs:Resource, rdfs:Resource;
  rdfs:domain rdfs:Resource, rdfs:Resource .

rdf:List a rdfs:Class, rdfs:Class;
  rdfs:subClassOf rdfs:Resource, rdfs:Resource;
  rdfs:isDefinedBy <http://www.w3.org/1999/02/22-rdf-syntax-ns#>, <http://www.w3.org/1999/02/22-rdf-syntax-ns#>;
  rdfs:label "List", "List";
  rdfs:comment "The class of RDF Lists.", "The class of RDF Lists." .

rdf:nil a rdf:List, rdf:List;
  rdfs:isDefinedBy <http://www.w3.org/1999/02/22-rdf-syntax-ns#>, <http://www.w3.org/1999/02/22-rdf-syntax-ns#>;
  rdfs:label "nil", "nil";
  rdfs:comment "The empty list, with no items in it. If the rest of a list is nil then the list has no more items in it.",
    "The empty list, with no items in it. If the rest of a list is nil then the list has no more items in it." .

rdf:first a rdf:Property, rdf:Property;
  rdfs:isDefinedBy <http://www.w3.org/1999/02/22-rdf-syntax-ns#>, <http://www.w3.org/1999/02/22-rdf-syntax-ns#>;
  rdfs:label "first", "first";
  rdfs:comment "The first item in the subject RDF list.", "The first item in the subject RDF list.";
  rdfs:range rdfs:Resource, rdfs:Resource;
  rdfs:domain rdf:List, rdf:List .

rdf:rest a rdf:Property, rdf:Property;
  rdfs:isDefinedBy <http://www.w3.org/1999/02/22-rdf-syntax-ns#>, <http://www.w3.org/1999/02/22-rdf-syntax-ns#>;
  rdfs:label "rest", "rest";
  rdfs:comment "The rest of the subject RDF list after the first item.", "The rest of the subject RDF list after the first item.";
  rdfs:range rdf:List, rdf:List;
  rdfs:domain rdf:List, rdf:List .

rdf:XMLLiteral a rdfs:Datatype, rdfs:Datatype;
  rdfs:subClassOf rdfs:Literal, rdfs:Literal;
  rdfs:isDefinedBy <http://www.w3.org/1999/02/22-rdf-syntax-ns#>, <http://www.w3.org/1999/02/22-rdf-syntax-ns#>;
  rdfs:label "XMLLiteral", "XMLLiteral";
  rdfs:comment "The datatype of XML literal values.", "The datatype of XML literal values." .

<http://www.w3.org/2002/07/owl> a owl:Ontology, owl:Ontology;
  dc:title "The OWL 2 Schema vocabulary (OWL 2)", "The OWL 2 Schema vocabulary (OWL 2)";
  rdfs:isDefinedBy <http://www.w3.org/TR/owl2-rdf-based-semantics/>, <http://www.w3.org/TR/owl2-rdf-based-semantics/>,
    <http://www.w3.org/TR/owl2-syntax/>, <http://www.w3.org/TR/owl2-syntax/>, <http://www.w3.org/TR/owl2-mapping-to-rdf/>,
    <http://www.w3.org/TR/owl2-mapping-to-rdf/>;
  rdfs:seeAlso <http://www.w3.org/TR/owl2-rdf-based-semantics/#table-axiomatic-classes>,
    <http://www.w3.org/TR/owl2-rdf-based-semantics/#table-axiomatic-classes>, <http://www.w3.org/TR/owl2-rdf-based-semantics/#table-axiomatic-properties>,
    <http://www.w3.org/TR/owl2-rdf-based-semantics/#table-axiomatic-properties>;
  rdfs:comment """
  This ontology partially describes the built-in classes and
  properties that together form the basis of the RDF/XML syntax of OWL 2.
  The content of this ontology is based on Tables 6.1 and 6.2
  in Section 6.4 of the OWL 2 RDF-Based Semantics specification,
  available at http://www.w3.org/TR/owl2-rdf-based-semantics/.
  Please note that those tables do not include the different annotations
  (labels, comments and rdfs:isDefinedBy links) used in this file.
  Also note that the descriptions provided in this ontology do not
  provide a complete and correct formal description of either the syntax
  or the semantics of the introduced terms (please see the OWL 2
  recommendations for the complete and normative specifications).
  Furthermore, the information provided by this ontology may be
  misleading if not used with care. This ontology SHOULD NOT be imported
  into OWL ontologies. Importing this file into an OWL 2 DL ontology
  will cause it to become an OWL 2 Full ontology and may have other,
  unexpected, consequences.
   """,
    """
  This ontology partially describes the built-in classes and
  properties that together form the basis of the RDF/XML syntax of OWL 2.
  The content of this ontology is based on Tables 6.1 and 6.2
  in Section 6.4 of the OWL 2 RDF-Based Semantics specification,
  available at http://www.w3.org/TR/owl2-rdf-based-semantics/.
  Please note that those tables do not include the different annotations
  (labels, comments and rdfs:isDefinedBy links) used in this file.
  Also note that the descriptions provided in this ontology do not
  provide a complete and correct formal description of either the syntax
  or the semantics of the introduced terms (please see the OWL 2
  recommendations for the complete and normative specifications).
  Furthermore, the information provided by this ontology may be
  misleading if not used with care. This ontology SHOULD NOT be imported
  into OWL ontologies. Importing this file into an OWL 2 DL ontology
  will cause it to become an OWL 2 Full ontology and may have other,
  unexpected, consequences.
   """;
  grddl:namespaceTransformation <http://dev.w3.org/cvsweb/2009/owl-grddl/owx2rdf.xsl>,
    <http://dev.w3.org/cvsweb/2009/owl-grddl/owx2rdf.xsl>;
  owl:versionIRI <http://www.w3.org/2002/07/owl>, <http://www.w3.org/2002/07/owl>;
  owl:imports <http://www.w3.org/2000/01/rdf-schema>, <http://www.w3.org/2000/01/rdf-schema>;
  owl:versionInfo "$Date: 2009/11/15 10:54:12 $", "$Date: 2009/11/15 10:54:12 $" .

owl:versionIRI a owl:OntologyProperty, owl:OntologyProperty;
  rdfs:isDefinedBy <http://www.w3.org/2002/07/owl#>, <http://www.w3.org/2002/07/owl#>;
  rdfs:label "versionIRI", "versionIRI";
  rdfs:comment "The property that identifies the version IRI of an ontology.", "The property that identifies the version IRI of an ontology.";
  rdfs:range owl:Ontology, owl:Ontology;
  rdfs:domain owl:Ontology, owl:Ontology .

owl:imports a owl:OntologyProperty, owl:OntologyProperty;
  rdfs:isDefinedBy <http://www.w3.org/2002/07/owl#>, <http://www.w3.org/2002/07/owl#>;
  rdfs:label "imports", "imports";
  rdfs:comment "The property that is used for importing other ontologies into a given ontology.",
    "The property that is used for importing other ontologies into a given ontology.";
  rdfs:range owl:Ontology, owl:Ontology;
  rdfs:domain owl:Ontology, owl:Ontology .

owl:versionInfo a owl:AnnotationProperty, owl:AnnotationProperty;
  rdfs:isDefinedBy <http://www.w3.org/2002/07/owl#>, <http://www.w3.org/2002/07/owl#>;
  rdfs:label "versionInfo", "versionInfo";
  rdfs:comment "The annotation property that provides version information for an ontology or another OWL construct.",
    "The annotation property that provides version information for an ontology or another OWL construct.";
  rdfs:range rdfs:Resource, rdfs:Resource;
  rdfs:domain rdfs:Resource, rdfs:Resource .

owl:AllDifferent a rdfs:Class, rdfs:Class;
  rdfs:subClassOf rdfs:Resource, rdfs:Resource;
  rdfs:isDefinedBy <http://www.w3.org/2002/07/owl#>, <http://www.w3.org/2002/07/owl#>;
  rdfs:label "AllDifferent", "AllDifferent";
  rdfs:comment "The class of collections of pairwise different individuals.", "The class of collections of pairwise different individuals." .

owl:AllDisjointClasses a rdfs:Class, rdfs:Class;
  rdfs:subClassOf rdfs:Resource, rdfs:Resource;
  rdfs:isDefinedBy <http://www.w3.org/2002/07/owl#>, <http://www.w3.org/2002/07/owl#>;
  rdfs:label "AllDisjointClasses", "AllDisjointClasses";
  rdfs:comment "The class of collections of pairwise disjoint classes.", "The class of collections of pairwise disjoint classes." .

owl:AllDisjointProperties a rdfs:Class, rdfs:Class;
  rdfs:subClassOf rdfs:Resource, rdfs:Resource;
  rdfs:isDefinedBy <http://www.w3.org/2002/07/owl#>, <http://www.w3.org/2002/07/owl#>;
  rdfs:label "AllDisjointProperties", "AllDisjointProperties";
  rdfs:comment "The class of collections of pairwise disjoint properties.", "The class of collections of pairwise disjoint properties." .

owl:Annotation a rdfs:Class, rdfs:Class;
  rdfs:subClassOf rdfs:Resource, rdfs:Resource;
  rdfs:isDefinedBy <http://www.w3.org/2002/07/owl#>, <http://www.w3.org/2002/07/owl#>;
  rdfs:label "Annotation", "Annotation";
  rdfs:comment "The class of annotated annotations for which the RDF serialization consists of an annotated subject, predicate and object.",
    "The class of annotated annotations for which the RDF serialization consists of an annotated subject, predicate and object." .

owl:AnnotationProperty a rdfs:Class, rdfs:Class;
  rdfs:subClassOf rdf:Property, rdf:Property;
  rdfs:isDefinedBy <http://www.w3.org/2002/07/owl#>, <http://www.w3.org/2002/07/owl#>;
  rdfs:label "AnnotationProperty", "AnnotationProperty";
  rdfs:comment "The class of annotation properties.", "The class of annotation properties." .

owl:AsymmetricProperty a rdfs:Class, rdfs:Class;
  rdfs:subClassOf owl:ObjectProperty, owl:ObjectProperty;
  rdfs:isDefinedBy <http://www.w3.org/2002/07/owl#>, <http://www.w3.org/2002/07/owl#>;
  rdfs:label "AsymmetricProperty", "AsymmetricProperty";
  rdfs:comment "The class of asymmetric properties.", "The class of asymmetric properties." .

owl:ObjectProperty a rdfs:Class, rdfs:Class;
  rdfs:subClassOf rdf:Property, rdf:Property;
  rdfs:isDefinedBy <http://www.w3.org/2002/07/owl#>, <http://www.w3.org/2002/07/owl#>;
  rdfs:label "ObjectProperty", "ObjectProperty";
  rdfs:comment "The class of object properties.", "The class of object properties." .

owl:Axiom a rdfs:Class, rdfs:Class;
  rdfs:subClassOf rdfs:Resource, rdfs:Resource;
  rdfs:isDefinedBy <http://www.w3.org/2002/07/owl#>, <http://www.w3.org/2002/07/owl#>;
  rdfs:label "Axiom", "Axiom";
  rdfs:comment "The class of annotated axioms for which the RDF serialization consists of an annotated subject, predicate and object.",
    "The class of annotated axioms for which the RDF serialization consists of an annotated subject, predicate and object." .

owl:Class a rdfs:Class, rdfs:Class;
  rdfs:subClassOf rdfs:Class, rdfs:Class;
  rdfs:isDefinedBy <http://www.w3.org/2002/07/owl#>, <http://www.w3.org/2002/07/owl#>;
  rdfs:label "Class", "Class";
  rdfs:comment "The class of OWL classes.", "The class of OWL classes." .

owl:DataRange a rdfs:Class, rdfs:Class;
  rdfs:subClassOf rdfs:Datatype, rdfs:Datatype;
  rdfs:isDefinedBy <http://www.w3.org/2002/07/owl#>, <http://www.w3.org/2002/07/owl#>;
  rdfs:label "DataRange", "DataRange";
