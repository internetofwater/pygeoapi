unit:PA-SEC-PER-M a qudt:Unit, qudt:Unit, qudt:DerivedUnit, qudt:DerivedUnit;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/unit>, <http://qudt.org/vocab/unit>;
  rdfs:label "Pascal Second per Meter"@en-US, "Pascal Second per Meter"@en-US, "Pascal Second per Metre"@en,
    "Pascal Second per Metre"@en;
  dct:description "Pascal Second Per Meter ($Pa-s/m$) is a unit in the category of Specific acoustic impedance. It is also known as pascal-second/meter. Pascal Second Per Meter has a dimension of $ML^2T^{-1}$ where $M$ is mass, $L$ is length, and $T$ is time. It essentially the same as the corresponding standard SI unit $kg/m2\\cdot s$."^^qudt:LatexString,
    "Pascal Second Per Meter ($Pa-s/m$) is a unit in the category of Specific acoustic impedance. It is also known as pascal-second/meter. Pascal Second Per Meter has a dimension of $ML^2T^{-1}$ where $M$ is mass, $L$ is length, and $T$ is time. It essentially the same as the corresponding standard SI unit $kg/m2\\cdot s$."^^qudt:LatexString;
  qudt:applicableSystem <http://qudt.org/vocab/sou/CGS-EMU>, <http://qudt.org/vocab/sou/CGS-EMU>,
    <http://qudt.org/vocab/sou/CGS-GAUSS>, <http://qudt.org/vocab/sou/CGS-GAUSS>, <http://qudt.org/vocab/sou/SI>,
    <http://qudt.org/vocab/sou/SI>, <http://qudt.org/vocab/sou/CGS>, <http://qudt.org/vocab/sou/CGS>;
  qudt:conversionMultiplier 1.0, 1.0;
  qudt:conversionMultiplierSN 1.0E0, 1.0E0;
  qudt:hasDimensionVector dimensionvector:A0E0L-2I0M1H0T-1D0, dimensionvector:A0E0L-2I0M1H0T-1D0;
  qudt:hasQuantityKind quantitykind:AcousticImpedance, quantitykind:AcousticImpedance;
  qudt:iec61360Code "0112/2///62720#UAA268", "0112/2///62720#UAA268";
  qudt:informativeReference "http://www.efunda.com/glossary/units/units--specific_acoustic_impedance--pascal_second_per_meter.cfm"^^xsd:anyURI,
    "http://www.efunda.com/glossary/units/units--specific_acoustic_impedance--pascal_second_per_meter.cfm"^^xsd:anyURI,
    "https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAA268"^^xsd:anyURI,
    "https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAA268"^^xsd:anyURI;
  qudt:symbol "Pa·s/m", "Pa·s/m";
  qudt:ucumCode "Pa.s.m-1"^^qudt:UCUMcs, "Pa.s.m-1"^^qudt:UCUMcs, "Pa.s/m"^^qudt:UCUMcs,
