unit:AC-FT a qudt:Unit, qudt:Unit, qudt:DerivedUnit, qudt:DerivedUnit;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/unit>, <http://qudt.org/vocab/unit>;
  rdfs:label "Acre Foot"@en, "Acre Foot"@en;
  dct:description "An acre-foot is a unit of volume commonly used in the United States in reference to large-scale water resources, such as reservoirs, aqueducts, canals, sewer flow capacity, and river flows. It is defined by the volume of one acre of surface area to a depth of one foot. Since the acre is defined as a chain by a furlong ($66 ft \\times 660 ft$) the acre-foot is exactly $43,560 cubic feet$. For irrigation water, the volume of $1 ft \\times 1 \\; ac = 43,560 \\; ft^{3} (1,233.482 \\; m^{3}, 325,851 \\; US gal)$."^^qudt:LatexString,
    "An acre-foot is a unit of volume commonly used in the United States in reference to large-scale water resources, such as reservoirs, aqueducts, canals, sewer flow capacity, and river flows. It is defined by the volume of one acre of surface area to a depth of one foot. Since the acre is defined as a chain by a furlong ($66 ft \\times 660 ft$) the acre-foot is exactly $43,560 cubic feet$. For irrigation water, the volume of $1 ft \\times 1 \\; ac = 43,560 \\; ft^{3} (1,233.482 \\; m^{3}, 325,851 \\; US gal)$."^^qudt:LatexString;
  qudt:applicableSystem <http://qudt.org/vocab/sou/IMPERIAL>, <http://qudt.org/vocab/sou/IMPERIAL>,
    <http://qudt.org/vocab/sou/USCS>, <http://qudt.org/vocab/sou/USCS>;
  qudt:conversionMultiplier 1233.4818375475202, 1233.48183754752;
  qudt:conversionMultiplierSN 1.2334818375475202E3, 1.23348183754752E3;
  qudt:hasDimensionVector dimensionvector:A0E0L3I0M0H0T0D0, dimensionvector:A0E0L3I0M0H0T0D0;
  qudt:hasQuantityKind quantitykind:Volume, quantitykind:Volume;
  qudt:iec61360Code "0112/2///62720#UAB288", "0112/2///62720#UAB288";
  qudt:informativeReference "http://en.wikipedia.org/wiki/Acre-foot"^^xsd:anyURI, "http://en.wikipedia.org/wiki/Acre-foot"^^xsd:anyURI,
    "http://www.oxfordreference.com/view/10.1093/acref/9780198605225.001.0001/acref-9780198605225-e-35"^^xsd:anyURI,
    "https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAB288"^^xsd:anyURI,
    "https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAB288"^^xsd:anyURI,
