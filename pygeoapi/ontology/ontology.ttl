  <http://qudt.org/schema/qudt/plainTextDescription> "square metre divided by metre: plain text description in English" .

<http://qudt.org/vocab/quantitykind/AreaPerLength> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Fläche pro Längeneinheit"@de, "area per length"@en;
  rdfs:comment "Applicable units are those of quantitykind:AreaPerLength";
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L1I0M0H0T0D0>;
  <http://qudt.org/schema/qudt/informativeReference> "https://www.easysteel.co.nz/web/assets/EasysteelSurfaceAreaofSections-Feb14.pdf"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/plainTextDescription> "Measure used to indicate the surface area of structural steel per unit length of the steel part.";
  <http://qudt.org/schema/qudt/qkdvDenominator> <http://qudt.org/vocab/dimensionvector/A0E0L1I0M0H0T0D0>;
  <http://qudt.org/schema/qudt/qkdvNumerator> <http://qudt.org/vocab/dimensionvector/A0E0L2I0M0H0T0D0>;
  <http://qudt.org/schema/qudt/applicableUnit> unit:M2-PER-M .

unit:M2-PER-M2 a <http://qudt.org/schema/qudt/Unit>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/unit>;
  rdfs:label "square meter per square meter"@en-US, "square metre per square metre"@en;
  dct:description "A square metre unit of area per square metre"^^rdf:HTML;
  <http://qudt.org/schema/qudt/applicableSystem> <http://qudt.org/vocab/sou/CGS-EMU>,
    <http://qudt.org/vocab/sou/CGS-GAUSS>, <http://qudt.org/vocab/sou/SI>, <http://qudt.org/vocab/sou/CGS>;
  <http://qudt.org/schema/qudt/conversionMultiplier> 1.0;
  <http://qudt.org/schema/qudt/conversionMultiplierSN> 1.0E0;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1>;
  <http://qudt.org/schema/qudt/hasQuantityKind> <http://qudt.org/vocab/quantitykind/AreaRatio>;
  <http://qudt.org/schema/qudt/symbol> "m²/m²";
  <http://qudt.org/schema/qudt/ucumCode> "m2.m-2"^^<http://qudt.org/schema/qudt/UCUMcs>;
  <http://qudt.org/schema/qudt/plainTextDescription> "A square metre unit of area per square metre";
  <http://qudt.org/schema/qudt/conversionOffset> 0.0;
