  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/unit>;
  rdfs:label "Cubic Inch per Minute"@en;
  dct:description "\"Cubic Inch per Minute\" is an Imperial unit for  'Volume Per Unit Time' expressed as $in^{3}/min$."^^<http://qudt.org/schema/qudt/LatexString>;
