quantitykind:Concentration a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "Concentration"@en, "Concentration"@en;
  rdfs:comment "Applicable units are those of quantitykind:Concentration", "Applicable units are those of quantitykind:Concentration";
  dct:description "In chemistry, concentration is defined as the abundance of a constituent divided by the total volume of a mixture. Furthermore, in chemistry, four types of mathematical description can be distinguished: mass concentration, molar concentration, number concentration, and volume concentration. The term concentration can be applied to any kind of chemical mixture, but most frequently it refers to solutes in solutions."^^qudt:LatexString,
    "In chemistry, concentration is defined as the abundance of a constituent divided by the total volume of a mixture. Furthermore, in chemistry, four types of mathematical description can be distinguished: mass concentration, molar concentration, number concentration, and volume concentration. The term concentration can be applied to any kind of chemical mixture, but most frequently it refers to solutes in solutions."^^qudt:LatexString;
  qudt:dbpediaMatch "http://dbpedia.org/resource/Concentration"^^xsd:anyURI, "http://dbpedia.org/resource/Concentration"^^xsd:anyURI;
  qudt:hasDimensionVector dimensionvector:A1E0L-3I0M0H0T0D0, dimensionvector:A1E0L-3I0M0H0T0D0;
