variablename:mass a skos:Concept ;
    ns3:category "Physical Property" ;
    skos:definition "Mass is a property of a physical body. It is generally a measure of an object's resistance to changing its state of motion when a force is applied." ;
    skos:exactMatch "https://en.wikipedia.org/wiki/Mass" ;
    skos:historyNote "wikipedia" ;
    skos:inScheme <http://vocabulary.odm2.org/variablename> ;
