quantitykind:IonizationEnergy a qudt:QuantityKind ;
    rdfs:label "Ionization Energy"@en ;
    dct:description "\"Ionization Energy\" is the energy difference between an electron at rest at infinity and an electron at a certain energy level. The amount of energy required to remove an electron from that atom or molecule in the gas phase."^^qudt:LatexString ;
    qudt:applicableUnit unit:AttoJ,
        unit:BTU_IT,
