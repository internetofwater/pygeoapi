    skos:topConceptOf <http://vocabulary.odm2.org/variablename> .

variablename:hail a skos:Concept ;
    skos:definition "Hail is a form of solid precipitation. It is distinct from ice pellets (American English \"sleet\"), though the two are often confused. It consists of balls or irregular lumps of ice, each of which is called a hailstone." ;
    skos:exactMatch "https://en.wikipedia.org/wiki/Hail" ;
    skos:historyNote "Wikipedia" ;
    skos:inScheme <http://vocabulary.odm2.org/variablename> ;
    skos:note "Added to support Critical Zone Observatory (CZO) data use cases. " ;
    skos:prefLabel "Hail" ;
    skos:topConceptOf <http://vocabulary.odm2.org/variablename> .

variablename:halloysite a skos:Concept ;
    skos:definition "Halloysite is an aluminosilicate clay mineral with the empirical formula Al2Si2O5(OH)4. Its main constituents are aluminium (20.90%), silicon (21.76%) and hydrogen (1.56%)." ;
    skos:exactMatch "https://en.wikipedia.org/wiki/Halloysite" ;
    skos:historyNote "Wikipedia" ;
    skos:inScheme <http://vocabulary.odm2.org/variablename> ;
