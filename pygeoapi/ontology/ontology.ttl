unit:N-SEC-PER-M3 a qudt:Unit, qudt:Unit, qudt:DerivedUnit, qudt:DerivedUnit;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/unit>, <http://qudt.org/vocab/unit>;
  rdfs:label "Newton second per Cubic Meter"@en-US, "Newton second per Cubic Meter"@en-US,
    "Newton second per Cubic Metre"@en, "Newton second per Cubic Metre"@en;
  dct:description """
  The SI unit of specific acoustic impedance. 
  When sound waves pass through any physical substance the pressure of the waves causes the particles of the substance to move. 
  The sound specific impedance is the ratio between the sound pressure and the particle velocity it produces. 
  The specific impedance is $1 N \\cdot s \\cdot m^{-3}$ if unit pressure produces unit velocity.
  """^^qudt:LatexString,
    """
  The SI unit of specific acoustic impedance. 
  When sound waves pass through any physical substance the pressure of the waves causes the particles of the substance to move. 
  The sound specific impedance is the ratio between the sound pressure and the particle velocity it produces. 
  The specific impedance is $1 N \\cdot s \\cdot m^{-3}$ if unit pressure produces unit velocity.
  """^^qudt:LatexString;
  qudt:applicableSystem <http://qudt.org/vocab/sou/CGS-EMU>, <http://qudt.org/vocab/sou/CGS-EMU>,
    <http://qudt.org/vocab/sou/CGS-GAUSS>, <http://qudt.org/vocab/sou/CGS-GAUSS>, <http://qudt.org/vocab/sou/SI>,
    <http://qudt.org/vocab/sou/SI>, <http://qudt.org/vocab/sou/CGS>, <http://qudt.org/vocab/sou/CGS>;
  qudt:conversionMultiplier 1.0, 1.0;
  qudt:conversionMultiplierSN 1.0E0, 1.0E0;
  qudt:hasDimensionVector dimensionvector:A0E0L-2I0M1H0T-1D0, dimensionvector:A0E0L-2I0M1H0T-1D0;
  qudt:hasQuantityKind quantitykind:SpecificAcousticImpedance, quantitykind:SpecificAcousticImpedance;
  qudt:symbol "N·s/m³", "N·s/m³";
  qudt:ucumCode "N.s.m-3"^^qudt:UCUMcs, "N.s.m-3"^^qudt:UCUMcs;
  qudt:expression "$N \\cdot s \\cdot m^{-3}$"^^qudt:LatexString, "$N \\cdot s \\cdot m^{-3}$"^^qudt:LatexString;
  qudt:definedUnitOfSystem <http://qudt.org/vocab/sou/SI>, <http://qudt.org/vocab/sou/SI>;
  qudt:latexSymbol "$N \\cdot s \\cdot m^{-3}$"^^qudt:LatexString, "$N \\cdot s \\cdot m^{-3}$"^^qudt:LatexString;
  qudt:hasFactorUnit _:b1cb43fcbd504833bf8a964862c3127018022, _:b1cb43fcbd504833bf8a964862c3127018023,
    _:b1cb43fcbd504833bf8a964862c3127018024 .

