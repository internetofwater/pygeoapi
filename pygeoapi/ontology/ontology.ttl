    qudt:latexSymbol "$\\alpha$"^^qudt:LatexString ;
    qudt:plainTextDescription "A duty cycle or power cycle is the fraction of one period in which a signal or system is active." ;
    qudt:symbol "α" ;
    rdfs:comment "Applicable units are those of quantitykind:DutyCycle" ;
    rdfs:isDefinedBy <http://qudt.org/vocab/quantitykind> ;
    skos:broader quantitykind:DimensionlessRatio .

quantitykind:ElectricChargePerAmountOfSubstance a qudt:QuantityKind ;
    rdfs:label "Electric charge per amount of substance"@en ;
    dct:description "\"Electric Charge Per Amount Of Substance\" is the charge assocated with a given amount of substance. Un the ISO and SI systems this is $1 mol$."^^qudt:LatexString ;
