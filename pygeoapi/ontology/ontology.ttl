        unit:J-PER-CentiM2-DAY,
        unit:KiloCAL-PER-CentiM2-MIN,
        unit:KiloCAL-PER-CentiM2-SEC,
        unit:KiloW-PER-M2,
        unit:M-PA-PER-SEC,
        unit:MicroW-PER-M2,
        unit:MilliW-PER-M2,
        unit:NanoW-PER-M2,
        unit:PicoW-PER-M2,
        unit:W-PER-CentiM2,
        unit:W-PER-FT2,
        unit:W-PER-IN2,
        unit:W-PER-M2 ;
    qudt:hasDimensionVector dimensionvector:A0E0L0I0M1H0T-3D0 ;
    qudt:informativeReference "http://en.wikipedia.org/wiki/Heat_flux"^^xsd:anyURI ;
    qudt:isoNormativeReference "http://www.iso.org/iso/catalogue_detail?csnumber=31890"^^xsd:anyURI ;
    qudt:qkdvDenominator dimensionvector:A0E0L2I0M0H0T0D0 ;
    qudt:qkdvNumerator dimensionvector:A0E0L2I0M1H0T-3D0 ;
    rdfs:comment "Applicable units are those of quantitykind:PowerPerArea" ;
    rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>,
        <http://qudt.org/vocab/quantitykind> ;
    skos:broader quantitykind:PowerPerArea .

quantitykind:HeatFluxDensity a qudt:QuantityKind ;
    rdfs:label "Heat Flux Density"@en ;
