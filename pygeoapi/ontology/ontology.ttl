quantitykind:GrandCanonicalPartitionFunction a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "Grand Canonical Partition Function"@en, "Grand Canonical Partition Function"@en;
  rdfs:comment "Applicable units are those of quantitykind:CanonicalPartitionFunction",
    "Applicable units are those of quantitykind:CanonicalPartitionFunction";
  dct:description "An \"Grand Canonical Partition Function\" for a grand canonical ensemble, a system that can exchange both heat and particles with the environment, which has a constant temperature and a chemical potential."^^qudt:LatexString,
    "An \"Grand Canonical Partition Function\" for a grand canonical ensemble, a system that can exchange both heat and particles with the environment, which has a constant temperature and a chemical potential."^^qudt:LatexString;
  skos:broader quantitykind:CanonicalPartitionFunction, quantitykind:CanonicalPartitionFunction;
  qudt:hasDimensionVector dimensionvector:A0E0L0I0M0H0T0D1, dimensionvector:A0E0L0I0M0H0T0D1;
  qudt:informativeReference "http://en.wikipedia.org/wiki/Partition_function_(statistical_mechanics)"^^xsd:anyURI,
    "http://en.wikipedia.org/wiki/Partition_function_(statistical_mechanics)"^^xsd:anyURI;
  qudt:isoNormativeReference "http://www.iso.org/iso/catalogue_detail?csnumber=31894"^^xsd:anyURI,
    "http://www.iso.org/iso/catalogue_detail?csnumber=31894"^^xsd:anyURI;
  qudt:plainTextDescription "An \"Grand Canonical Partition Function\" for a grand canonical ensemble, a system that can exchange both heat and particles with the environment, which has a constant temperature and a chemical potential.",
    "An \"Grand Canonical Partition Function\" for a grand canonical ensemble, a system that can exchange both heat and particles with the environment, which has a constant temperature and a chemical potential.";
  qudt:latexSymbol "$\\Xi$"^^qudt:LatexString, "$\\Xi$"^^qudt:LatexString;
  qudt:latexDefinition "$\\Xi = \\sum_{N_A, N_B, ...} Z(N_A, N_B, ...) \\cdot \\lambda_A^{N_A} \\cdot \\lambda_B^{N_B} \\cdot ...$, where $Z(N_A, N_B, ...)$ is the canonical partition function for the given number of particles $A, B, ...,$, and $\\lambda_A, \\lambda_B, ...$ are the absolute activities of particles $A, B, ...$."^^qudt:LatexString,
    "$\\Xi = \\sum_{N_A, N_B, ...} Z(N_A, N_B, ...) \\cdot \\lambda_A^{N_A} \\cdot \\lambda_B^{N_B} \\cdot ...$, where $Z(N_A, N_B, ...)$ is the canonical partition function for the given number of particles $A, B, ...,$, and $\\lambda_A, \\lambda_B, ...$ are the absolute activities of particles $A, B, ...$."^^qudt:LatexString;
  qudt:applicableUnit unit:UNITLESS, unit:UNITLESS .

quantitykind:GravitationalAttraction a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "Gravitational Attraction"@en, "Gravitational Attraction"@en;
  rdfs:comment "Applicable units are those of quantitykind:Force", "Applicable units are those of quantitykind:Force";
  dct:description "The force of attraction between all masses in the universe; especially the attraction of the earth's mass for bodies near its surface; the more remote the body the less the gravity; the gravitation between two bodies is proportional to the product of their masses and inversely proportional to the square of the distance between them."^^qudt:LatexString,
    "The force of attraction between all masses in the universe; especially the attraction of the earth's mass for bodies near its surface; the more remote the body the less the gravity; the gravitation between two bodies is proportional to the product of their masses and inversely proportional to the square of the distance between them."^^qudt:LatexString;
  skos:broader quantitykind:Force, quantitykind:Force;
  qudt:hasDimensionVector dimensionvector:A0E0L1I0M1H0T-2D0, dimensionvector:A0E0L1I0M1H0T-2D0;
