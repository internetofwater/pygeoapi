    rdfs:comment "Applicable units are those of quantitykind:TimeTemperature" ;
    rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>,
        <http://qudt.org/vocab/quantitykind> .

unit:A-PER-M a qudt:DerivedUnit,
        qudt:Unit ;
    rdfs:label "مقياس التبادل، الأس السالب للمتر"@ar,
        "Ampérů Na Metr"@cs,
        "ampérů na metr"@cs,
        "Ampere Je Meter"@de,
        "Ampere je Meter"@de,
        "Ampere per Metre"@en,
        "ampere per metre"@en,
        "Ampere per Meter"@en-US,
        "Amperio Por Metro"@es,
        "amperio por metro"@es,
        "آمپر بر متر"@fa,
        "Ampère Par Mètre"@fr,
        "ampère par mètre"@fr,
        "प्रति मीटर एम्पीयर"@hi,
        "Ampere Al Metro"@it,
        "ampere al metro"@it,
        "アンペア毎メートル"@ja,
        "Ampere per Meter"@ms,
        "ampere per meter"@ms,
        "Amper Na Metr"@pl,
        "amper na metr"@pl,
        "Ampere Por Metro"@pt,
        "ampere por metro"@pt,
        "Ampere Pe Metru"@ro,
        "ampere pe metru"@ro,
        "Ампер На Метр"@ru,
        "ампер на метр"@ru,
        "Amper Na Meter"@sl,
        "amper na meter"@sl,
        "Amper Bölü Metre"@tr,
        "amper bölü metre"@tr,
        "安培每米"@zh ;
    dct:description " is the SI unit of magnetic field strength. One ampere per meter is equal to $\\pi/250$ oersteds ($12.566\\, 371\\,millioersteds$) in CGS units. The ampere per meter is also the SI unit of \"magnetization\" in the sense of magnetic dipole moment per unit volume; in this context $1 A/m = 0.001\\,emu\\,per\\,cubic\\,centimeter$."^^qudt:LatexString ;
    qudt:applicableSystem <http://qudt.org/vocab/sou/CGS-EMU>,
        <http://qudt.org/vocab/sou/CGS-GAUSS>,
        <http://qudt.org/vocab/sou/SI> ;
    qudt:conversionMultiplier 1.0 ;
    qudt:conversionMultiplierSN 1e+00 ;
    qudt:definedUnitOfSystem <http://qudt.org/vocab/sou/SI> ;
    qudt:derivedCoherentUnitOfSystem <http://qudt.org/vocab/sou/SI> ;
    qudt:expression "$A/m$"^^qudt:LatexString ;
    qudt:hasDimensionVector dimensionvector:A0E1L-1I0M0H0T0D0 ;
    qudt:hasFactorUnit [ qudt:exponent -1 ;
            qudt:hasUnit unit:M ],
        [ qudt:exponent 1 ;
