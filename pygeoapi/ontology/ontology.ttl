unit:MOL_LB a <http://qudt.org/schema/qudt/Unit>, <http://qudt.org/schema/qudt/DerivedUnit>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/unit>;
  rdfs:label "Pound Mole"@en;
