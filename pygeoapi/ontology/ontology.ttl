            qudt:hasUnit unit:M ],
        [ qudt:exponent -1 ;
            qudt:hasUnit unit:SEC ],
        [ qudt:exponent 3 ;
            qudt:hasUnit unit:M ],
        [ qudt:exponent -1 ;
            qudt:hasUnit unit:SEC ],
        [ qudt:exponent 3 ;
            qudt:hasUnit unit:M ] ;
