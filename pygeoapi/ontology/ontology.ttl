<http://qudt.org/vocab/quantitykind/EccentricityOfOrbit> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Eccentricity Of Orbit"@en;
  rdfs:comment "Applicable units are those of quantitykind:DimensionlessRatio";
  dct:description "The orbital eccentricity of an astronomical object is a parameter that determines the amount by which its orbit around another body deviates from a perfect circle. In a two-body problem with inverse-square-law force, every orbit is a Kepler orbit. The eccentricity of this Kepler orbit is a positive number that defines its shape."^^<http://qudt.org/schema/qudt/LatexString>;
  skos:broader <http://qudt.org/vocab/quantitykind/DimensionlessRatio>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1>;
  <http://qudt.org/schema/qudt/plainTextDescription> "The orbital eccentricity of an astronomical object is a parameter that determines the amount by which its orbit around another body deviates from a perfect circle. In a two-body problem with inverse-square-law force, every orbit is a Kepler orbit. The eccentricity of this Kepler orbit is a positive number that defines its shape.";
  <http://qudt.org/schema/qudt/latexSymbol> "$\\varepsilon$"^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/applicableUnit> unit:FRACTION, unit:GR, unit:NUM, unit:PERCENT,
    unit:PERMITTIVITY_REL, unit:PPB, unit:PPM, unit:PPQ, unit:PPT, unit:PPTH, unit:PPTM,
    unit:PSU, unit:UNITLESS .

<http://qudt.org/vocab/quantitykind/EffectiveExhaustVelocity> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Effective Exhaustvelocity"@en;
  rdfs:comment "Applicable units are those of quantitykind:Velocity";
  dct:description "The velocity of an exhaust stream after reduction by effects such as friction, non-axially directed flow, and pressure differences between the inside of the rocket and its surroundings. The effective exhaust velocity is one of two factors determining the thrust, or accelerating force, that a rocket can develop, the other factor being the quantity of reaction mass expelled from the rocket in unit time. In most cases, the effective exhaust velocity is close to the actual exhaust velocity."^^<http://qudt.org/schema/qudt/LatexString>;
  skos:broader <http://qudt.org/vocab/quantitykind/Velocity>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L1I0M0H0T-1D0>;
  <http://qudt.org/schema/qudt/symbol> "v_{e}";
  <http://qudt.org/schema/qudt/plainTextDescription> "The velocity of an exhaust stream after reduction by effects such as friction, non-axially directed flow, and pressure differences between the inside of the rocket and its surroundings. The effective exhaust velocity is one of two factors determining the thrust, or accelerating force, that a rocket can develop, the other factor being the quantity of reaction mass expelled from the rocket in unit time. In most cases, the effective exhaust velocity is close to the actual exhaust velocity.";
  <http://qudt.org/schema/qudt/applicableUnit> unit:CentiM-PER-HR, unit:CentiM-PER-KiloYR,
    unit:CentiM-PER-SEC, unit:CentiM-PER-YR, unit:FT-PER-DAY, unit:FT-PER-HR, unit:FT-PER-MIN,
    unit:FT-PER-SEC, unit:GigaHZ-M, unit:IN-PER-MIN, unit:IN-PER-SEC, unit:IN-PER-YR,
    unit:KN, unit:MI_N-PER-HR, unit:KiloM-PER-DAY, unit:KiloM-PER-HR, unit:KiloM-PER-SEC,
    unit:M-PER-DAY, unit:M-PER-HR, unit:M-PER-MIN, unit:M-PER-SEC, unit:M-PER-YR, unit:MI-PER-HR,
    unit:MI-PER-MIN, unit:MI-PER-SEC, unit:MI_N-PER-MIN, unit:MicroM-PER-MIN, unit:MicroM-PER-SEC,
    unit:MilliM-PER-DAY, unit:MilliM-PER-HR, unit:MilliM-PER-MIN, unit:MilliM-PER-SEC,
    unit:MilliM-PER-YR, unit:YD-PER-HR, unit:YD-PER-MIN, unit:YD-PER-SEC .

<http://qudt.org/vocab/quantitykind/EffectiveMass> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Effective Mass"@en;
  rdfs:comment "Applicable units are those of quantitykind:Mass";
  dct:description "\"Effective Mass\" is used in the motional equation for electrons in solid state bodies, depending on the wavenumber and corresponding to its velocity and energy level."^^<http://qudt.org/schema/qudt/LatexString>;
  skos:broader <http://qudt.org/vocab/quantitykind/Mass>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L0I0M1H0T0D0>;
  <http://qudt.org/schema/qudt/informativeReference> "http://en.wikipedia.org/wiki/Effective_mass_(solid-state_physics)"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/symbol> "m^*";
  <http://qudt.org/schema/qudt/isoNormativeReference> "http://www.iso.org/iso/catalogue_detail?csnumber=31897"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/plainTextDescription> "\"Effective Mass\" is used in the motional equation for electrons in solid state bodies, depending on the wavenumber and corresponding to its velocity and energy level.";
  <http://qudt.org/schema/qudt/latexDefinition> "$m^* = \\hbar^2k(\\frac{d\\varepsilon}{dk})$, where $\\hbar$ is the reduced Planck constant, $k$ is the wavenumber, and $\\varepsilon$ is the energy of the electron."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/applicableUnit> unit:AMU, unit:U, unit:CARAT, unit:CWT_LONG,
    unit:Hundredweight_UK, unit:CWT_SHORT, unit:Hundredweight_US, unit:CentiGM, unit:DRAM_UK,
    unit:DRAM_US, unit:DWT, unit:Pennyweight, unit:DecaGM, unit:DeciGM, unit:DeciTONNE,
    unit:DeciTON_Metric, unit:EarthMass, unit:FemtoGM, unit:GM, unit:GRAIN, unit:HectoGM,
    unit:KiloGM, unit:KiloTONNE, unit:KiloTON_Metric, unit:LB, unit:LB_M, unit:LB_T, unit:LunarMass,
    unit:MOMME_Pearl, unit:MOMME_Textile, unit:MegaGM, unit:MegaTON, unit:MegaTONNE, unit:MicroGM,
    unit:MilliGM, unit:NanoGM, unit:OZ, unit:OZ_M, unit:OZ_TROY, unit:PFUND, unit:PicoGM,
    unit:PlanckMass, unit:Quarter_UK, unit:SLUG, unit:SolarMass, unit:Stone_UK, unit:TON,
    unit:TON_SHORT, unit:TON_US, unit:TONNE, unit:TON_Metric, unit:TON_Assay, unit:TON_LONG,
    unit:TON_UK .

<http://qudt.org/vocab/quantitykind/EffectiveMultiplicationFactor> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Effective Multiplication Factor"@en;
  rdfs:comment "Applicable units are those of quantitykind:MultiplicationFactor";
  dct:description "The \"Effective Multiplication Factor\" is the multiplication factor for a finite medium."^^<http://qudt.org/schema/qudt/LatexString>;
  skos:broader <http://qudt.org/vocab/quantitykind/MultiplicationFactor>;
  skos:closeMatch <http://qudt.org/vocab/quantitykind/InfiniteMultiplicationFactor>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1>;
  <http://qudt.org/schema/qudt/informativeReference> "http://en.wikipedia.org/wiki/Nuclear_chain_reaction#Effective_neutron_multiplication_factor"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/symbol> "k_{eff}";
  <http://qudt.org/schema/qudt/isoNormativeReference> "http://www.iso.org/iso/catalogue_detail?csnumber=31895"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/plainTextDescription> "The \"Effective Multiplication Factor\" is the multiplication factor for a finite medium.";
  <http://qudt.org/schema/qudt/applicableUnit> unit:UNITLESS .

<http://qudt.org/vocab/quantitykind/InfiniteMultiplicationFactor> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Infinite Multiplication Factor"@en;
  rdfs:comment "Applicable units are those of quantitykind:MultiplicationFactor";
