unit:KiloPOND a <http://qudt.org/schema/qudt/Unit>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/unit>;
  rdfs:label "Kilopond"@en;
  dct:description "illegal unit of the weight, defined as mass of 1 kg which receives a weight of 1 kp through gravitation at sea level, which equates to a force of 9,806 65 newton"^^rdf:HTML;
  <http://qudt.org/schema/qudt/conversionMultiplier> 9.80665;
  <http://qudt.org/schema/qudt/conversionMultiplierSN> 9.80665E0;
