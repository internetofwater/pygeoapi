    qudt:hasFactorUnit [ qudt:exponent 1 ;
            qudt:hasUnit unit:A ],
        [ qudt:exponent 1 ;
            qudt:hasUnit unit:GigaV ],
        [ qudt:exponent 1 ;
            qudt:hasUnit unit:A ],
        [ qudt:exponent 1 ;
            qudt:hasUnit unit:GigaV ],
        [ qudt:exponent 1 ;
            qudt:hasUnit unit:A ],
        [ qudt:exponent 1 ;
            qudt:hasUnit unit:GigaV ] ;
