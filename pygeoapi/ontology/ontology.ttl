<http://qudt.org/vocab/quantitykind/TimeRelatedLogarithmicRatio> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "time-related logarithmic ratio"@en-US;
  dct:description "logarithm of the ratio of the value of a defined variable to the value of a reference variable of the same type, divided by the related time"@en;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T-1D0>;
  <http://qudt.org/schema/qudt/symbol> "0173-1#Z4-BAJ415#002";
  <http://qudt.org/schema/qudt/plainTextDescription> "Logarithmus des Verhältnisses des Werts einer gegebenen Größe zum Wert einer Bezugsgröße gleicher Art dividiert durch die zugehörige Zeit"@de .

<http://qudt.org/vocab/quantitykind/TorqueConstant> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "torque constant", "torque constant"@en-US;
  dct:description "product of magnetic induction, number of turns per unit length, and the area enclosed by the coil corresponding to the gradient of the curve representing the ratio between the torque of the motor and the current"@en;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E-1L2I0M1H0T-2D0>;
  <http://qudt.org/schema/qudt/iec61360Code> "0112/2///62720#UAD201";
  <http://qudt.org/schema/qudt/informativeReference> "https://cdd.iec.ch/cdd/iec61987/iec61987.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD201"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/symbol> "0173-1#Z4-BAJ298#002";
  <http://qudt.org/schema/qudt/plainTextDescription> "Produkt aus der magnetischen Induktion, der Windungszahl und der von der Spule eingeschlossenen Fläche entsprechend der Steigung der Kurve des Verhältnisses Drehmoment des Motors zum Strom"@de .

<http://qudt.org/vocab/quantitykind/TorsionalRigidity> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "torsional rigidity";
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L2I0M1H0T-2D0>;
  <http://qudt.org/schema/qudt/iec61360Code> "0112/2///62720#UAD202";
  <http://qudt.org/schema/qudt/informativeReference> "https://cdd.iec.ch/cdd/iec61987/iec61987.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD202"^^xsd:anyURI .

<http://qudt.org/vocab/quantitykind/TotalAngularMomentum> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Total Angular Momentum"@en;
  rdfs:comment "Applicable units are those of quantitykind:AngularMomentum";
  dct:description "\"Total Angular Momentum\" combines both the spin and orbital angular momentum of all particles and fields. In atomic and nuclear physics, orbital angular momentum is usually denoted by $l$ or $L$ instead of $\\Lambda$. The magnitude of $J$ is quantized so that $J^2 = \\hbar^2 j(j + 1)$, where $j$ is the total angular momentum quantum number."^^<http://qudt.org/schema/qudt/LatexString>;
  skos:broader <http://qudt.org/vocab/quantitykind/AngularMomentum>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L2I0M1H0T-1D0>;
  <http://qudt.org/schema/qudt/informativeReference> "http://en.wikipedia.org/wiki/Angular_momentum#Spin.2C_orbital.2C_and_total_angular_momentum"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/symbol> "J";
  <http://qudt.org/schema/qudt/applicableUnit> unit:ERG-SEC, unit:EV-SEC, unit:FT-LB_F-SEC,
    unit:J-SEC, unit:KiloGM-M2-PER-SEC, unit:N-M-SEC;
  <http://qudt.org/schema/qudt/normativeReference> "http://www.iso.org/iso/catalogue_detail?csnumber=31895"^^xsd:anyURI .

<http://qudt.org/vocab/quantitykind/TotalCrossSection> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Total Cross-section"@en;
  rdfs:comment "Applicable units are those of quantitykind:Area";
  dct:description "\"Total Cross-section\" is related to the absorbance of the light intensity through Beer-Lambert's law. It is the sum of all cross-sections corresponding to the various reactions or processes between an incident particle of specified type and energy and a target particle."^^<http://qudt.org/schema/qudt/LatexString>;
  skos:broader <http://qudt.org/vocab/quantitykind/CrossSection>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L2I0M0H0T0D0>;
  <http://qudt.org/schema/qudt/informativeReference> "http://en.wikipedia.org/wiki/Cross_section_(physics)"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/symbol> "σₜ";
  <http://qudt.org/schema/qudt/plainTextDescription> "\"Total Cross-section\" is related to the absorbance of the light intensity through Beer-Lambert's law. It is the sum of all cross-sections corresponding to the various reactions or processes between an incident particle of specified type and energy and a target particle.";
  <http://qudt.org/schema/qudt/applicableUnit> unit:AC, unit:ARE, unit:BARN, unit:CentiM2,
    unit:DecaARE, unit:DeciM2, unit:FT2, unit:HA, unit:IN2, unit:KiloM2, unit:KiloMIL_Circ,
    unit:M2, unit:MI2, unit:MI_US2, unit:MIL_Circ, unit:MicroM2, unit:MilliM2, unit:NanoM2,
    unit:PlanckArea, unit:YD2;
  <http://qudt.org/schema/qudt/normativeReference> "http://www.iso.org/iso/catalogue_detail?csnumber=31895"^^xsd:anyURI .

<http://qudt.org/vocab/quantitykind/TotalPressure> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Total Pressure"@en;
  rdfs:comment "Applicable units are those of quantitykind:ForcePerArea";
  dct:description " The total pressure is the sum of the dynamic and static pressures, that is $P_0 = P + q$."^^<http://qudt.org/schema/qudt/LatexString>;
  skos:broader <http://qudt.org/vocab/quantitykind/Pressure>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L-1I0M1H0T-2D0>;
  <http://qudt.org/schema/qudt/symbol> "P_0";
