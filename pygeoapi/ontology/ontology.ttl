quantitykind:ThermalInsulance a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:seeAlso quantitykind:CoefficientOfHeatTransfer, quantitykind:CoefficientOfHeatTransfer;
  rdfs:label "Thermal Insulance"@en, "Thermal Insulance"@en;
  rdfs:comment "Applicable units are those of quantitykind:ThermalInsulance", "Applicable units are those of quantitykind:ThermalInsulance";
  dct:description "$\\textit{Thermal Insulance}$ is the reduction of heat transfer (the transfer of thermal energy between objects of differing temperature) between objects in thermal contact or in range of radiative influence. In building technology, this quantity is often called $\\textit{Thermal Resistance}$, with the symbol $R$."^^qudt:LatexString,
    "$\\textit{Thermal Insulance}$ is the reduction of heat transfer (the transfer of thermal energy between objects of differing temperature) between objects in thermal contact or in range of radiative influence. In building technology, this quantity is often called $\\textit{Thermal Resistance}$, with the symbol $R$."^^qudt:LatexString;
  qudt:hasDimensionVector dimensionvector:A0E0L0I0M-1H1T3D0, dimensionvector:A0E0L0I0M-1H1T3D0;
  qudt:iec61360Code "0112/2///62720#UAD192", "0112/2///62720#UAD192";
  qudt:informativeReference "http://en.wikipedia.org/wiki/Thermal_insulation"^^xsd:anyURI,
    "http://en.wikipedia.org/wiki/Thermal_insulation"^^xsd:anyURI, "https://cdd.iec.ch/cdd/iec61987/iec61987.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD192"^^xsd:anyURI,
    "https://cdd.iec.ch/cdd/iec61987/iec61987.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD192"^^xsd:anyURI;
  qudt:symbol "M", "M";
  qudt:latexDefinition "$M = 1/K$, where $K$ is \"Coefficient of Heat Transfer\""^^qudt:LatexString,
    "$M = 1/K$, where $K$ is \"Coefficient of Heat Transfer\""^^qudt:LatexString;
  qudt:applicableUnit unit:CLO, unit:CLO, unit:DEG_F-HR-FT2-PER-BTU_IT, unit:DEG_F-HR-FT2-PER-BTU_IT,
    unit:DEG_F-HR-FT2-PER-BTU_TH, unit:DEG_F-HR-FT2-PER-BTU_TH, unit:FT2-HR-DEG_F-PER-BTU_IT,
    unit:FT2-HR-DEG_F-PER-BTU_IT, unit:M2-HR-DEG_C-PER-KiloCAL_IT, unit:M2-HR-DEG_C-PER-KiloCAL_IT,
    unit:M2-K-PER-W, unit:M2-K-PER-W .

unit:CORD a qudt:Unit, qudt:Unit;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/unit>, <http://qudt.org/vocab/unit>;
  rdfs:label "Cord"@en, "Cord"@en;
  dct:description "The cord is a unit of measure of dry volume used in Canada and the United States to measure firewood and pulpwood. A cord is the amount of wood that, when 'ranked and well stowed' (arranged so pieces are aligned, parallel, touching and compact), occupies a volume of 128 cubic feet (3.62 cubic metres). This corresponds to a well stacked woodpile 4 feet (122 cm) wide, 4 feet (122 cm) high, and 8 feet (244 cm) long; or any other arrangement of linear measurements that yields the same volume. The name cord probably comes from the use of a cord or string to measure it. "^^rdf:HTML,
    "The cord is a unit of measure of dry volume used in Canada and the United States to measure firewood and pulpwood. A cord is the amount of wood that, when 'ranked and well stowed' (arranged so pieces are aligned, parallel, touching and compact), occupies a volume of 128 cubic feet (3.62 cubic metres). This corresponds to a well stacked woodpile 4 feet (122 cm) wide, 4 feet (122 cm) high, and 8 feet (244 cm) long; or any other arrangement of linear measurements that yields the same volume. The name cord probably comes from the use of a cord or string to measure it. "^^rdf:HTML;
  qudt:applicableSystem <http://qudt.org/vocab/sou/USCS>, <http://qudt.org/vocab/sou/USCS>;
  qudt:conversionMultiplier 3.62, 3.62;
  qudt:conversionMultiplierSN 3.62E0, 3.62E0;
  qudt:dbpediaMatch "http://dbpedia.org/resource/Cord"^^xsd:anyURI, "http://dbpedia.org/resource/Cord"^^xsd:anyURI;
  qudt:hasDimensionVector dimensionvector:A0E0L3I0M0H0T0D0, dimensionvector:A0E0L3I0M0H0T0D0;
  qudt:hasQuantityKind quantitykind:DryVolume, quantitykind:DryVolume;
  qudt:iec61360Code "0112/2///62720#UAB289", "0112/2///62720#UAB289";
  qudt:informativeReference "http://en.wikipedia.org/wiki/Cord?oldid=490232340"^^xsd:anyURI,
    "http://en.wikipedia.org/wiki/Cord?oldid=490232340"^^xsd:anyURI, "https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAB289"^^xsd:anyURI,
    "https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAB289"^^xsd:anyURI;
  qudt:omUnit <http://www.ontology-of-units-of-measure.org/resource/om-2/cord>, <http://www.ontology-of-units-of-measure.org/resource/om-2/cord>;
  qudt:symbol "cord", "cord";
  qudt:ucumCode "[crd_us]"^^qudt:UCUMcs, "[crd_us]"^^qudt:UCUMcs;
  qudt:uneceCommonCode "M68", "M68", "WCD", "WCD";
