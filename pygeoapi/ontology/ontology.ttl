    skos:broader quantitykind:PowerPerArea .

quantitykind:EnergyImparted a qudt:QuantityKind ;
    rdfs:label "Energy Imparted"@en ;
    dct:description "The \"Energy Imparted\", is a physical quantity associated with the energy delivered to a particular volume of matter by all the directly and indirectly ionizing particles (i.e. charged and uncharged) entering that volume."^^qudt:LatexString ;
    qudt:applicableUnit unit:AttoJ,
        unit:BTU_IT,
        unit:BTU_TH,
        unit:CAL_IT,
        unit:CAL_TH,
        unit:ERG,
        unit:EV,
        unit:E_h,
        unit:ExaJ,
        unit:FT-LB_F,
        unit:FT-PDL,
        unit:FemtoJ,
        unit:GigaEV,
        unit:GigaJ,
        unit:GigaW-HR,
