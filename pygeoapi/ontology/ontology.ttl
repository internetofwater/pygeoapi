variablename:groundwaterDepth a skos:Concept ;
    skos:definition "Groundwater depth is the distance between the water surface and the ground surface at a specific location specified by the site location and offset." ;
    skos:historyNote "Originally from the CUAHSI HIS VariableNameCV.  See: http://his.cuahsi.org/mastercvreg/edit_cv11.aspx?tbl=VariableNameCV." ;
