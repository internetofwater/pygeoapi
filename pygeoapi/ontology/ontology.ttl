    rdfs:label "Standard"@en ;
    dct:description "non SI-conform unit of the volume of readily finished wood material : 1 standard = 1,980 board feet or approximate 4.672 cubic metre"^^rdf:HTML ;
    dct:isReplacedBy unit:STANDARD ;
