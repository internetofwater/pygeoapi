quantitykind:DiffusionArea a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "Diffusion Area"@en, "Diffusion Area"@en;
  rdfs:comment "Applicable units are those of quantitykind:Area", "Applicable units are those of quantitykind:Area";
  dct:description "\"Diffusion Area\" in an infinite homogenous medium, is one-sixth of the mean square distance between the point where a neutron enters a specified class and the point where it leaves that class."^^qudt:LatexString,
