<http://qudt.org/vocab/quantitykind/RestEnergy> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Rest Energy"@en;
  rdfs:comment "Applicable units are those of quantitykind:Energy";
  dct:description "\"Rest Energy\" is the energy equivalent of the rest mass of a body, equal to the rest mass multiplied by the speed of light squared."^^<http://qudt.org/schema/qudt/LatexString>;
  skos:broader <http://qudt.org/vocab/quantitykind/Energy>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L2I0M1H0T-2D0>;
  <http://qudt.org/schema/qudt/informativeReference> "http://www.iso.org/iso/home/store/catalogue_tc/catalogue_detail.htm?csnumber=31895"^^xsd:anyURI,
    "http://en.wikipedia.org/wiki/Invariant_mass#Rest_energy"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/symbol> "E_0";
  <http://qudt.org/schema/qudt/plainTextDescription> "\"Rest Energy\" is the energy equivalent of the rest mass of a body, equal to the rest mass multiplied by the speed of light squared.";
  <http://qudt.org/schema/qudt/latexDefinition> "For a particle, $E_0 = m_0 c_0^2$, where $m_0$ is the rest mass of that particle, and $c_0$ is the speed of light in vacuum."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/applicableUnit> unit:AttoJ, unit:BTU_IT, unit:BTU_TH,
