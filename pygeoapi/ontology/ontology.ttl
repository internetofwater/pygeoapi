        qudt:Unit ;
    rdfs:label "Revolution per Minute"@en ;
    dct:description "\"Revolution per Minute\" is a unit for  'Angular Velocity' expressed as $rev/min$.  One revolution per minute is equivalent to 1/60 hertz."^^qudt:LatexString ;
    qudt:altSymbol "RPM",
        "r/min",
        "rpm" ;
