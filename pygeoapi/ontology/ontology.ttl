qudt:ucumCode a owl:DatatypeProperty ;
    rdfs:label "ucum code" ;
    dct:description "<p><em>ucumCode</em> associates a QUDT unit with its UCUM code (case-sensitive). </p><p>In SHACL the values are derived from specific ucum properties using 'sh:values'.</p>"^^rdf:HTML ;
    dct:source "https://ucum.org/ucum.html"^^xsd:anyURI ;
    rdfs:isDefinedBy <http://qudt.org/3.0.0/schema/qudt>,
        <http://qudt.org/schema/qudt> ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( qudt:UCUMcs qudt:UCUMcs-term ) ],
        [ a owl:Class ;
            owl:unionOf ( qudt:UCUMcs qudt:UCUMcs-term ) ],
        [ a owl:Class ;
            owl:unionOf ( qudt:UCUMcs qudt:UCUMcs-term ) ],
        [ a owl:Class ;
            owl:unionOf ( qudt:UCUMcs qudt:UCUMcs-term ) ],
        [ a owl:Class ;
            owl:unionOf ( qudt:UCUMcs qudt:UCUMcs-term ) ] ;
    rdfs:seeAlso <https://ucum.org/ucum.html> ;
    rdfs:subPropertyOf skos:notation .

