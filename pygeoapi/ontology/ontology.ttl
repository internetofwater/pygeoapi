  owl:minCardinality "0"^^xsd:nonNegativeInteger;
  owl:onProperty <http://qudt.org/schema/qudt/hasQuantityKind> .

_:6bb918f5130b4a77805c72ffff92bd8c703 a owl:Restriction;
  owl:allValuesFrom <http://qudt.org/schema/qudt/PhysicalConstant>;
  owl:onProperty <http://qudt.org/schema/qudt/applicablePhysicalConstant> .

<http://qudt.org/schema/qudt/applicablePhysicalConstant> a owl:ObjectProperty;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/schema/qudt>;
  rdfs:label "applicable physical constant" .

_:6bb918f5130b4a77805c72ffff92bd8c704 a owl:Restriction;
  owl:allValuesFrom <http://qudt.org/schema/qudt/Prefix>;
  owl:onProperty <http://qudt.org/schema/qudt/prefix> .

_:6bb918f5130b4a77805c72ffff92bd8c705 a owl:Restriction;
  owl:allValuesFrom <http://qudt.org/schema/qudt/Unit>;
  owl:onProperty <http://qudt.org/schema/qudt/hasAllowedUnit> .

<http://qudt.org/schema/qudt/hasAllowedUnit> a owl:ObjectProperty;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/schema/qudt>;
  rdfs:label "allowed unit";
  rdfs:subPropertyOf <http://qudt.org/schema/qudt/hasUnit>;
  dct:description "This property relates a unit system with a unit of measure that is not defined by or part of the system, but is allowed for use within the system. An allowed unit must be convertible to some dimensionally eqiuvalent unit that is defined by the system."^^rdf:HTML .

_:6bb918f5130b4a77805c72ffff92bd8c706 a owl:Restriction;
  owl:allValuesFrom <http://qudt.org/schema/qudt/Unit>;
  owl:onProperty <http://qudt.org/schema/qudt/hasBaseUnit> .

<http://qudt.org/schema/qudt/hasBaseUnit> a owl:ObjectProperty;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/schema/qudt>;
  rdfs:label "base unit";
  owl:inverseOf <http://qudt.org/schema/qudt/baseUnitOfSystem>;
  rdfs:subPropertyOf <http://qudt.org/schema/qudt/hasCoherentUnit>;
  dct:description "This property relates a system of units to a base unit defined within the system. The base units of a system are used to define the derived units of the system by expressing the derived units as products of the base units raised to a rational power."^^rdf:HTML .

_:6bb918f5130b4a77805c72ffff92bd8c707 a owl:Restriction;
  owl:allValuesFrom <http://qudt.org/schema/qudt/Unit>;
  owl:onProperty <http://qudt.org/schema/qudt/hasCoherentUnit> .

<http://qudt.org/schema/qudt/hasCoherentUnit> a owl:ObjectProperty;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/schema/qudt>;
  rdfs:label "coherent unit";
  owl:inverseOf <http://qudt.org/schema/qudt/coherentUnitOfSystem>;
  rdfs:subPropertyOf <http://qudt.org/schema/qudt/hasDefinedUnit>;
  dct:description "A coherent unit of measurement for a unit system is a defined unit that may be expressed as a product of powers of the system's base units with the proportionality factor of one."^^rdf:HTML .

_:6bb918f5130b4a77805c72ffff92bd8c708 a owl:Restriction;
  owl:allValuesFrom <http://qudt.org/schema/qudt/Unit>;
  owl:onProperty <http://qudt.org/schema/qudt/hasDefinedUnit> .

<http://qudt.org/schema/qudt/hasDefinedUnit> a owl:ObjectProperty;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/schema/qudt>;
  rdfs:label "defined unit";
  rdfs:subPropertyOf <http://qudt.org/schema/qudt/hasUnit>;
  dct:description "This property relates a unit system with a unit of measure that is defined by the system."^^rdf:HTML .

_:6bb918f5130b4a77805c72ffff92bd8c709 a owl:Restriction;
  owl:allValuesFrom <http://qudt.org/schema/qudt/Unit>;
  owl:onProperty <http://qudt.org/schema/qudt/hasDerivedCoherentUnit> .

<http://qudt.org/schema/qudt/hasDerivedCoherentUnit> a owl:ObjectProperty;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/schema/qudt>;
  rdfs:label "derived coherent unit";
  owl:inverseOf <http://qudt.org/schema/qudt/derivedCoherentUnitOfSystem>;
  rdfs:subPropertyOf <http://qudt.org/schema/qudt/hasCoherentUnit>, <http://qudt.org/schema/qudt/hasDerivedUnit> .

_:6bb918f5130b4a77805c72ffff92bd8c710 a owl:Restriction;
  owl:allValuesFrom <http://qudt.org/schema/qudt/Unit>;
  owl:onProperty <http://qudt.org/schema/qudt/hasDerivedUnit> .

<http://qudt.org/schema/qudt/hasDerivedUnit> a owl:ObjectProperty;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/schema/qudt>;
  rdfs:label "derived unit";
  owl:inverseOf <http://qudt.org/schema/qudt/derivedUnitOfSystem>;
  dct:description "This property relates a system of units to a unit of measure that is defined within the system in terms of the base units for the system. That is, the derived unit is defined as a product of the base units for the system raised to some rational power."^^rdf:HTML .

_:6bb918f5130b4a77805c72ffff92bd8c711 a owl:Restriction;
  owl:allValuesFrom <http://qudt.org/schema/qudt/Unit>;
  owl:onProperty <http://qudt.org/schema/qudt/hasUnit> .

_:6bb918f5130b4a77805c72ffff92bd8c712 rdf:first _:6bb918f5130b4a77805c72ffff92bd8c713;
  rdf:rest rdf:nil .

_:6bb918f5130b4a77805c72ffff92bd8c713 xsd:pattern "[\\x21-\\x7e]+" .

_:6bb918f5130b4a77805c72ffff92bd8c714 rdf:first _:6bb918f5130b4a77805c72ffff92bd8c715;
  rdf:rest rdf:nil .

