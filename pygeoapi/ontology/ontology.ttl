variablename:snowLayerHardness a skos:Concept;
  skos:definition "Snow layers within the snowpack are a record of the winter’s weather. Like tree rings or strata of rock, layers can be traced to dates and conditions that formed them. One of the most important characteristics of a layer is its hardness. Harder snow is stronger and cohesive, while softer snow is weaker. ";
  skos:inScheme <http://vocabulary.odm2.org/variablename>;
  skos:topConceptOf <http://vocabulary.odm2.org/variablename>;
  skos:prefLabel "Snow layer hardness";
  skos:note "Added to support Critical Zone Observatory (CZO) data use cases. ";
  skos:exactMatch "http://cbavalanchecenter.org/interpreting-snowpack-layers-and-hardness/" .

variablename:lutetiumDissolved a skos:Concept;
  skos:definition "Dissolved Lutetium (Lu). \"Dissolved \" indicates a the measurement was made on a filtered sample.";
