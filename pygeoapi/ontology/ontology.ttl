  qudt:hasQuantityKind quantitykind:LuminousExposure, quantitykind:LuminousExposure;
  qudt:iec61360Code "0112/2///62720#UAA724", "0112/2///62720#UAA724";
  qudt:informativeReference "http://en.wikipedia.org/wiki/Lux?oldid=494700274"^^xsd:anyURI,
