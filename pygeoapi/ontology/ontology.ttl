quantitykind:NuclearRadius a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "Nuclear Radius"@en, "Nuclear Radius"@en;
  rdfs:comment "Applicable units are those of quantitykind:Length", "Applicable units are those of quantitykind:Length";
  dct:description "\"Nuclear Radius\" is the conventional radius of sphere in which the nuclear matter is included"^^qudt:LatexString,
    "\"Nuclear Radius\" is the conventional radius of sphere in which the nuclear matter is included"^^qudt:LatexString;
  skos:broader quantitykind:Length, quantitykind:Length;
  qudt:hasDimensionVector dimensionvector:A0E0L1I0M0H0T0D0, dimensionvector:A0E0L1I0M0H0T0D0;
  qudt:informativeReference "http://en.wikipedia.org/wiki/Atomic_nucleus"^^xsd:anyURI,
    "http://en.wikipedia.org/wiki/Atomic_nucleus"^^xsd:anyURI;
  qudt:symbol "R", "R";
  qudt:plainTextDescription "\"Nuclear Radius\" is the conventional radius of sphere in which the nuclear matter is included",
    "\"Nuclear Radius\" is the conventional radius of sphere in which the nuclear matter is included";
  qudt:latexDefinition "This quantity is not exactly defined. It is given approximately for nuclei in their ground state only by $R = r_0 A^{\\frac{1}{3}}$, where $r_0 \\approx 1.2 x 10^{-15} m$ and $A$ is the nucleon number."^^qudt:LatexString,
