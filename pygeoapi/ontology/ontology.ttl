unit:KiloMOL-PER-M3 a <http://qudt.org/schema/qudt/Unit>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/unit>;
  rdfs:label "Kilomole per Cubic Meter"@en-US, "Kilomole per Cubic Metre"@en;
