unit:MilliGAL-PER-MO a qudt:Unit ;
    rdfs:label "MilliGals per Month"@en,
        "MilliGals per month"@en ;
    dct:description "A rate of change of one millionth part of a unit of gravitational acceleration equal to one centimetre per second per second over a time duration of 30.4375 days or 2629800 seconds."@en ;
    dct:isReplacedBy unit:MilliGALILEO-PER-MO ;
    qudt:conversionMultiplier 0.00000000000391935077290161628,
        0.000000000003919350772901616281311709002114104 ;
    qudt:conversionMultiplierSN 3.919351e-12 ;
    qudt:deprecated true ;
    qudt:hasDimensionVector dimensionvector:A0E0L1I0M0H0T-3D0 ;
    qudt:hasFactorUnit [ qudt:exponent -1 ;
            qudt:hasUnit unit:MO ],
        [ qudt:exponent 1 ;
            qudt:hasUnit unit:MilliGAL ],
        [ qudt:exponent -1 ;
            qudt:hasUnit unit:MO ],
        [ qudt:exponent 1 ;
            qudt:hasUnit unit:MilliGALILEO ],
        [ qudt:exponent -1 ;
            qudt:hasUnit unit:MO ],
        [ qudt:exponent 1 ;
            qudt:hasUnit unit:MilliGAL ] ;
    qudt:hasQuantityKind quantitykind:Unknown ;
    qudt:symbol "mgal/mo" ;
    qudt:ucumCode "mGal.mo-1"^^qudt:UCUMcs,
        "mGal/mo"^^qudt:UCUMcs ;
    rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/unit>,
        <http://qudt.org/vocab/unit> .

