unit:MicroMOL-PER-M2-SEC a qudt:Unit, qudt:Unit;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/unit>, <http://qudt.org/vocab/unit>;
  rdfs:label "Micromoles per square metre second"@en, "Micromoles per square metre second"@en;
  dct:description "One part per 10**6 (million) of the SI unit of quantity of matter (the mole) per SI unit area per SI unit of time.  This term is based on the number of photons in a certain waveband incident per unit time (s) on a unit area (m2) divided by the Avogadro constant (6.022 x 1023 mol-1). It is used commonly to describe PAR in the 400-700 nm waveband. Definition Source: Thimijan, Richard W., and Royal D. Heins. 1982. Photometric, Radiometric, and Quantum Light Units of Measure: A Review of Procedures for Interconversion. HortScience 18:818-822."@en,
    "One part per 10**6 (million) of the SI unit of quantity of matter (the mole) per SI unit area per SI unit of time.  This term is based on the number of photons in a certain waveband incident per unit time (s) on a unit area (m2) divided by the Avogadro constant (6.022 x 1023 mol-1). It is used commonly to describe PAR in the 400-700 nm waveband. Definition Source: Thimijan, Richard W., and Royal D. Heins. 1982. Photometric, Radiometric, and Quantum Light Units of Measure: A Review of Procedures for Interconversion. HortScience 18:818-822."@en;
  qudt:applicableSystem <http://qudt.org/vocab/sou/SI>, <http://qudt.org/vocab/sou/SI>;
  qudt:conversionMultiplier 0.000001, 0.000001;
  qudt:conversionMultiplierSN 1.0E-6, 1.0E-6;
  qudt:hasDimensionVector dimensionvector:A1E0L-2I0M0H0T-1D0, dimensionvector:A1E0L-2I0M0H0T-1D0;
  qudt:hasQuantityKind quantitykind:PhotosyntheticPhotonFluxDensity, quantitykind:PhotosyntheticPhotonFluxDensity;
  qudt:symbol "μmol/(m²·s)", "μmol/(m²·s)";
  qudt:ucumCode "umol.m-2.s-1"^^qudt:UCUMcs, "umol.m-2.s-1"^^qudt:UCUMcs, "umol/m2/s"^^qudt:UCUMcs,
    "umol/m2/s"^^qudt:UCUMcs;
  qudt:hasFactorUnit _:b1cb43fcbd504833bf8a964862c3127017432, _:b1cb43fcbd504833bf8a964862c3127017433,
    _:b1cb43fcbd504833bf8a964862c3127017434 .

