quantitykind:ModulusOfElasticity a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "Modulus of Elasticity"@en, "Modulus of Elasticity"@en;
  rdfs:comment "Applicable units are those of quantitykind:ModulusOfElasticity", "Applicable units are those of quantitykind:ModulusOfElasticity";
  dct:description "The Modulus of Elasticity is the mathematical description of an object or substance's tendency to be deformed elastically (that is, non-permanently) when a force is applied to it."^^qudt:LatexString,
    "The Modulus of Elasticity is the mathematical description of an object or substance's tendency to be deformed elastically (that is, non-permanently) when a force is applied to it."^^qudt:LatexString;
  qudt:hasDimensionVector dimensionvector:A0E0L-1I0M1H0T-2D0, dimensionvector:A0E0L-1I0M1H0T-2D0;
  qudt:informativeReference "http://en.wikipedia.org/wiki/Elastic_modulus"^^xsd:anyURI,
    "http://en.wikipedia.org/wiki/Elastic_modulus"^^xsd:anyURI;
  qudt:symbol "E", "E";
  qudt:isoNormativeReference "http://www.iso.org/iso/catalogue_detail?csnumber=31889"^^xsd:anyURI,
    "http://www.iso.org/iso/catalogue_detail?csnumber=31889"^^xsd:anyURI;
  qudt:plainTextDescription "The Modulus of Elasticity is the mathematical description of an object or substance's tendency to be deformed elastically (that is, non-permanently) when a force is applied to it.",
    "The Modulus of Elasticity is the mathematical description of an object or substance's tendency to be deformed elastically (that is, non-permanently) when a force is applied to it.";
  qudt:latexDefinition "$E = \\frac{\\sigma}{\\varepsilon}$, where $\\sigma$ is the normal stress and $\\varepsilon$ is the linear strain."^^qudt:LatexString,
    "$E = \\frac{\\sigma}{\\varepsilon}$, where $\\sigma$ is the normal stress and $\\varepsilon$ is the linear strain."^^qudt:LatexString;
  qudt:applicableUnit unit:DecaPA, unit:DecaPA, unit:GigaPA, unit:GigaPA, unit:HectoPA,
    unit:HectoPA, unit:KIP_F-PER-IN2, unit:KIP_F-PER-IN2, unit:PA, unit:PA, unit:KiloLB_F-PER-IN2,
    unit:KiloLB_F-PER-IN2, unit:KiloPA, unit:KiloPA, unit:LB_F-PER-IN2, unit:LB_F-PER-IN2,
    unit:PSI, unit:PSI, unit:MegaPA, unit:MegaPA, unit:MegaPSI, unit:MegaPSI, unit:MicroPA,
    unit:MicroPA, unit:MilliPA, unit:MilliPA, unit:PicoPA, unit:PicoPA .

quantitykind:ShearModulus a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "Shear Modulus"@en, "Shear Modulus"@en;
  rdfs:comment "Applicable units are those of quantitykind:ShearModulus", "Applicable units are those of quantitykind:ShearModulus";
  dct:description "The Shear Modulus or modulus of rigidity, denoted by $G$, or sometimes $S$ or $\\mu$, is defined as the ratio of shear stress to the shear strain."^^qudt:LatexString,
    "The Shear Modulus or modulus of rigidity, denoted by $G$, or sometimes $S$ or $\\mu$, is defined as the ratio of shear stress to the shear strain."^^qudt:LatexString;
  qudt:hasDimensionVector dimensionvector:A0E0L-1I0M1H0T-2D0, dimensionvector:A0E0L-1I0M1H0T-2D0;
