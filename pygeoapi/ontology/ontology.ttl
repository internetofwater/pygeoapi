  owl:allValuesFrom <http://qudt.org/schema/qudt/QuantityKind>;
  owl:onProperty <http://qudt.org/schema/qudt/systemDerivedQuantityKind> .

<http://qudt.org/schema/qudt/systemDerivedQuantityKind> a owl:ObjectProperty;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/schema/qudt>;
  rdfs:label "system derived quantity kind";
  rdfs:subPropertyOf <http://qudt.org/schema/qudt/hasQuantityKind> .

_:6bb918f5130b4a77805c72ffff92bd8c700 a owl:Restriction;
  owl:allValuesFrom <http://qudt.org/schema/qudt/SystemOfUnits>;
  owl:onProperty <http://qudt.org/schema/qudt/hasUnitSystem> .

<http://qudt.org/schema/qudt/hasUnitSystem> a owl:ObjectProperty, owl:FunctionalProperty;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/schema/qudt>;
  rdfs:label "has unit system" .

_:6bb918f5130b4a77805c72ffff92bd8c701 a owl:Restriction;
  owl:maxCardinality "1"^^xsd:int;
  owl:onProperty <http://qudt.org/schema/qudt/baseDimensionEnumeration> .

