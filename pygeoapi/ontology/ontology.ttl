  qudt:hasDimensionVector dimensionvector:A0E0L3I0M0H0T0D0, dimensionvector:A0E0L3I0M0H0T0D0;
  qudt:hasQuantityKind quantitykind:Volume, quantitykind:Volume;
  qudt:iec61360Code "0112/2///62720#UAB006", "0112/2///62720#UAB006";
