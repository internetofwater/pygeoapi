    unit:PicoJ, unit:PicoJ, unit:PlanckEnergy, unit:PlanckEnergy, unit:QUAD, unit:QUAD,
    unit:THERM_EC, unit:THERM_EC, unit:THM_EEC, unit:THM_EEC, unit:THERM_US, unit:THERM_US,
