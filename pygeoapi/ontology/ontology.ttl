quantitykind:CharacteristicAcousticImpedance a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "Characteristic Acoustic Impedance"@en, "Characteristic Acoustic Impedance"@en;
  rdfs:comment "Applicable units are those of quantitykind:AcousticImpedance", "Applicable units are those of quantitykind:AcousticImpedance";
  dct:description "Characteristic impedance at a point in a non-dissipative medium and for a plane progressive wave, the quotient of the sound pressure $p$ by the component of the sound particle velocity $v$ in the direction of the wave propagation."^^qudt:LatexString,
    "Characteristic impedance at a point in a non-dissipative medium and for a plane progressive wave, the quotient of the sound pressure $p$ by the component of the sound particle velocity $v$ in the direction of the wave propagation."^^qudt:LatexString;
