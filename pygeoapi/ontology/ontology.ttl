unit:KiloW-PER-M2-K a <http://qudt.org/schema/qudt/Unit>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/unit>;
  rdfs:label "kilowatt per square metre kelvin";
  dct:description "1,000-fold of the SI derived unit watt divided by the product of the power of the SI base unit metre by exponent 2 and the SI base unit kelvin";
  <http://qudt.org/schema/qudt/conversionMultiplier> 1000.0;
  <http://qudt.org/schema/qudt/conversionMultiplierSN> 1.0E3;
