quantitykind:Absorptance a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "Absorptance"@en, "Absorptance"@en;
  rdfs:comment "Applicable units are those of quantitykind:Absorptance", "Applicable units are those of quantitykind:Absorptance";
  dct:description "Absorptance is the ratio of the radiation absorbed by a surface to that incident upon it. Also known as absorbance."^^qudt:LatexString,
    "Absorptance is the ratio of the radiation absorbed by a surface to that incident upon it. Also known as absorbance."^^qudt:LatexString;
  qudt:hasDimensionVector dimensionvector:A0E0L0I0M0H0T0D1, dimensionvector:A0E0L0I0M0H0T0D1;
  qudt:informativeReference "http://en.wikipedia.org/wiki/Absorbance"^^xsd:anyURI, "http://en.wikipedia.org/wiki/Absorbance"^^xsd:anyURI,
    "https://en.wikipedia.org/wiki/Absorptance"^^xsd:anyURI, "https://en.wikipedia.org/wiki/Absorptance"^^xsd:anyURI,
    "https://www.researchgate.net/post/Absorptance_or_absorbance"^^xsd:anyURI, "https://www.researchgate.net/post/Absorptance_or_absorbance"^^xsd:anyURI;
  qudt:plainTextDescription "Absorptance is the ratio of the radiation absorbed by a surface to that incident upon it. Also known as absorbance.",
    "Absorptance is the ratio of the radiation absorbed by a surface to that incident upon it. Also known as absorbance.";
  qudt:latexSymbol "$\\alpha$"^^qudt:LatexString, "$\\alpha$"^^qudt:LatexString;
  qudt:latexDefinition "$\\alpha = \\frac{\\Phi_a}{\\Phi_m}$, where $\\Phi_a$ is the absorbed radiant flux or the absorbed luminous flux, and $\\Phi_m$ is the radiant flux or luminous flux of the incident radiation."^^qudt:LatexString,
    "$\\alpha = \\frac{\\Phi_a}{\\Phi_m}$, where $\\Phi_a$ is the absorbed radiant flux or the absorbed luminous flux, and $\\Phi_m$ is the radiant flux or luminous flux of the incident radiation."^^qudt:LatexString;
  <http://www.linkedmodel.org/schema/vaem#todo> "belongs to SOQ-ISO", "belongs to SOQ-ISO";
  qudt:applicableUnit unit:UNITLESS, unit:UNITLESS .

quantitykind:ActivityCoefficient a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "Activity Coefficient"@en, "Activity Coefficient"@en;
  rdfs:comment "Applicable units are those of quantitykind:ActivityCoefficient", "Applicable units are those of quantitykind:ActivityCoefficient";
  dct:description "An \"Activity Coefficient\" is a factor used in thermodynamics to account for deviations from ideal behaviour in a mixture of chemical substances. In an ideal mixture, the interactions between each pair of chemical species are the same (or more formally, the enthalpy change of solution is zero) and, as a result, properties of the mixtures can be expressed directly in terms of simple concentrations or partial pressures of the substances present e.g. Raoult's law. Deviations from ideality are accommodated by modifying the concentration by an activity coefficient. "^^qudt:LatexString,
    "An \"Activity Coefficient\" is a factor used in thermodynamics to account for deviations from ideal behaviour in a mixture of chemical substances. In an ideal mixture, the interactions between each pair of chemical species are the same (or more formally, the enthalpy change of solution is zero) and, as a result, properties of the mixtures can be expressed directly in terms of simple concentrations or partial pressures of the substances present e.g. Raoult's law. Deviations from ideality are accommodated by modifying the concentration by an activity coefficient. "^^qudt:LatexString;
  qudt:hasDimensionVector dimensionvector:A0E0L0I0M0H0T0D1, dimensionvector:A0E0L0I0M0H0T0D1;
  qudt:informativeReference "http://en.wikipedia.org/wiki/Activity_coefficient"^^xsd:anyURI,
    "http://en.wikipedia.org/wiki/Activity_coefficient"^^xsd:anyURI;
  qudt:symbol "f_B", "f_B";
  qudt:isoNormativeReference "http://www.iso.org/iso/catalogue_detail?csnumber=31894"^^xsd:anyURI,
    "http://www.iso.org/iso/catalogue_detail?csnumber=31894"^^xsd:anyURI;
  qudt:plainTextDescription "An \"Activity Coefficient\" is a factor used in thermodynamics to account for deviations from ideal behaviour in a mixture of chemical substances. In an ideal mixture, the interactions between each pair of chemical species are the same (or more formally, the enthalpy change of solution is zero) and, as a result, properties of the mixtures can be expressed directly in terms of simple concentrations or partial pressures of the substances present e.g. Raoult's law. Deviations from ideality are accommodated by modifying the concentration by an activity coefficient. ",
    "An \"Activity Coefficient\" is a factor used in thermodynamics to account for deviations from ideal behaviour in a mixture of chemical substances. In an ideal mixture, the interactions between each pair of chemical species are the same (or more formally, the enthalpy change of solution is zero) and, as a result, properties of the mixtures can be expressed directly in terms of simple concentrations or partial pressures of the substances present e.g. Raoult's law. Deviations from ideality are accommodated by modifying the concentration by an activity coefficient. ";
  qudt:latexDefinition "$f_B = \\frac{\\lambda_B}{(\\lambda_B^*x_B)}$, where $\\lambda_B$ the absolute activity of substance $B$, $\\lambda_B^*$ is the absolute activity of the pure substance $B$ at the same temperature and pressure, and $x_B$ is the amount-of-substance fraction of substance $B$."^^qudt:LatexString,
    "$f_B = \\frac{\\lambda_B}{(\\lambda_B^*x_B)}$, where $\\lambda_B$ the absolute activity of substance $B$, $\\lambda_B^*$ is the absolute activity of the pure substance $B$ at the same temperature and pressure, and $x_B$ is the amount-of-substance fraction of substance $B$."^^qudt:LatexString;
  qudt:applicableUnit unit:UNITLESS, unit:UNITLESS .

quantitykind:AmountOfSubstanceFraction a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "Fractional Amount of Substance"@en, "Fractional Amount of Substance"@en;
  rdfs:comment "Applicable units are those of quantitykind:AmountOfSubstanceFraction",
    "Applicable units are those of quantitykind:AmountOfSubstanceFraction";
  dct:description "\"Fractional Amount of Substance\" is defined as tthe amount of a constituent divided by the total amount of all constituents in a mixture."^^qudt:LatexString,
    "\"Fractional Amount of Substance\" is defined as tthe amount of a constituent divided by the total amount of all constituents in a mixture."^^qudt:LatexString;
  qudt:hasDimensionVector dimensionvector:A0E0L0I0M0H0T0D1, dimensionvector:A0E0L0I0M0H0T0D1;
  qudt:informativeReference "http://en.wikipedia.org/wiki/Amount_fraction"^^xsd:anyURI,
    "http://en.wikipedia.org/wiki/Amount_fraction"^^xsd:anyURI;
  qudt:symbol "X_B", "X_B";
  qudt:isoNormativeReference "http://www.iso.org/iso/catalogue_detail?csnumber=31894"^^xsd:anyURI,
    "http://www.iso.org/iso/catalogue_detail?csnumber=31894"^^xsd:anyURI;
  qudt:plainTextDescription "\"Fractional Amount of Substance\" is defined as tthe amount of a constituent divided by the total amount of all constituents in a mixture.",
    "\"Fractional Amount of Substance\" is defined as tthe amount of a constituent divided by the total amount of all constituents in a mixture.";
  qudt:latexDefinition "$x_B = \\frac{n_B}{n}$, where $n_B$ is the amount of substance $B$ and $n$ is the total amount of substance."^^qudt:LatexString,
    "$x_B = \\frac{n_B}{n}$, where $n_B$ is the amount of substance $B$ and $n$ is the total amount of substance."^^qudt:LatexString;
  qudt:applicableUnit unit:UNITLESS, unit:UNITLESS .

quantitykind:AtomScatteringFactor a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "Atom Scattering Factor"@en, "Atom Scattering Factor"@en;
  rdfs:comment "Applicable units are those of quantitykind:AtomScatteringFactor", "Applicable units are those of quantitykind:AtomScatteringFactor";
  dct:description "\"Atom Scattering Factor\" is measure of the scattering power of an isolated atom."^^qudt:LatexString,
    "\"Atom Scattering Factor\" is measure of the scattering power of an isolated atom."^^qudt:LatexString;
  qudt:hasDimensionVector dimensionvector:A0E0L0I0M0H0T0D1, dimensionvector:A0E0L0I0M0H0T0D1;
  qudt:informativeReference "http://reference.iucr.org/dictionary/Atomic_scattering_factor"^^xsd:anyURI,
    "http://reference.iucr.org/dictionary/Atomic_scattering_factor"^^xsd:anyURI;
  qudt:symbol "f", "f";
  qudt:isoNormativeReference "http://www.iso.org/iso/catalogue_detail?csnumber=31897"^^xsd:anyURI,
    "http://www.iso.org/iso/catalogue_detail?csnumber=31897"^^xsd:anyURI;
  qudt:plainTextDescription "\"Atom Scattering Factor\" is measure of the scattering power of an isolated atom.",
    "\"Atom Scattering Factor\" is measure of the scattering power of an isolated atom.";
  qudt:latexDefinition "$f = \\frac{E_a}{E_e}$, where $E_a$ is the radiation amplitude scattered by the atom and $E_e$ is the radiation ampliture scattered by a single electron."^^qudt:LatexString,
    "$f = \\frac{E_a}{E_e}$, where $E_a$ is the radiation amplitude scattered by the atom and $E_e$ is the radiation ampliture scattered by a single electron."^^qudt:LatexString;
  qudt:applicableUnit unit:UNITLESS, unit:UNITLESS .

quantitykind:AverageLogarithmicEnergyDecrement a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "Average Logarithmic Energy Decrement"@en, "Average Logarithmic Energy Decrement"@en;
  rdfs:comment "Applicable units are those of quantitykind:AverageLogarithmicEnergyDecrement",
    "Applicable units are those of quantitykind:AverageLogarithmicEnergyDecrement";
  dct:description "\"Average Logarithmic Energy Decrement\" is a measure of the amount of energy a neutron loses upon colliding with various nuclei. It is the average value of the increase in lethargy in elastic collisions between neutrons and nuclei whose kinetic energy is negligible compared with that of the neutrons."^^qudt:LatexString,
    "\"Average Logarithmic Energy Decrement\" is a measure of the amount of energy a neutron loses upon colliding with various nuclei. It is the average value of the increase in lethargy in elastic collisions between neutrons and nuclei whose kinetic energy is negligible compared with that of the neutrons."^^qudt:LatexString;
  qudt:hasDimensionVector dimensionvector:A0E0L0I0M0H0T0D1, dimensionvector:A0E0L0I0M0H0T0D1;
  qudt:informativeReference "http://everything2.com/title/Average+logarithmic+energy+decrement+per+collision"^^xsd:anyURI,
    "http://everything2.com/title/Average+logarithmic+energy+decrement+per+collision"^^xsd:anyURI;
  qudt:isoNormativeReference "http://www.iso.org/iso/catalogue_detail?csnumber=31895"^^xsd:anyURI,
    "http://www.iso.org/iso/catalogue_detail?csnumber=31895"^^xsd:anyURI;
  qudt:plainTextDescription "\"Average Logarithmic Energy Decrement\" is a measure of the amount of energy a neutron loses upon colliding with various nuclei. It is the average value of the increase in lethargy in elastic collisions between neutrons and nuclei whose kinetic energy is negligible compared with that of the neutrons.",
    "\"Average Logarithmic Energy Decrement\" is a measure of the amount of energy a neutron loses upon colliding with various nuclei. It is the average value of the increase in lethargy in elastic collisions between neutrons and nuclei whose kinetic energy is negligible compared with that of the neutrons.";
  qudt:latexSymbol "$\\xi$"^^qudt:LatexString, "$\\xi$"^^qudt:LatexString;
  qudt:applicableUnit unit:UNITLESS, unit:UNITLESS .

quantitykind:BindingFraction a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "Binding Fraction"@en, "Binding Fraction"@en;
  rdfs:comment "Applicable units are those of quantitykind:BindingFraction", "Applicable units are those of quantitykind:BindingFraction";
  dct:description "The \"Binding Fraction\" is the ratio of the binding energy of a nucleus to the atomic mass number."^^qudt:LatexString,
    "The \"Binding Fraction\" is the ratio of the binding energy of a nucleus to the atomic mass number."^^qudt:LatexString;
  qudt:hasDimensionVector dimensionvector:A0E0L0I0M0H0T0D1, dimensionvector:A0E0L0I0M0H0T0D1;
  qudt:informativeReference "http://encyclopedia2.thefreedictionary.com/binding+fraction"^^xsd:anyURI,
    "http://encyclopedia2.thefreedictionary.com/binding+fraction"^^xsd:anyURI;
  qudt:symbol "b", "b";
  qudt:isoNormativeReference "http://www.iso.org/iso/catalogue_detail?csnumber=31895"^^xsd:anyURI,
    "http://www.iso.org/iso/catalogue_detail?csnumber=31895"^^xsd:anyURI;
  qudt:plainTextDescription "The \"Binding Fraction\" is the ratio of the binding energy of a nucleus to the atomic mass number.",
    "The \"Binding Fraction\" is the ratio of the binding energy of a nucleus to the atomic mass number.";
  qudt:latexDefinition "$b = \\frac{B_r}{A}$, where $B_r$ is the relative mass defect and $A$ is the nucleon number."^^qudt:LatexString,
    "$b = \\frac{B_r}{A}$, where $B_r$ is the relative mass defect and $A$ is the nucleon number."^^qudt:LatexString;
  qudt:applicableUnit unit:UNITLESS, unit:UNITLESS .

quantitykind:BioconcentrationFactor a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "Bioconcentration Factor"@en, "Bioconcentration Factor"@en;
  rdfs:comment "Applicable units are those of quantitykind:BioconcentrationFactor",
    "Applicable units are those of quantitykind:BioconcentrationFactor";
  dct:description "The bioconcentration factor is the ratio of the concentration of a chemical substance in biota over the concentration of the same chemical substance in water. It is related to the octanol-water partition coefficient."^^qudt:LatexString,
    "The bioconcentration factor is the ratio of the concentration of a chemical substance in biota over the concentration of the same chemical substance in water. It is related to the octanol-water partition coefficient."^^qudt:LatexString;
  skos:broader quantitykind:DimensionlessRatio, quantitykind:DimensionlessRatio;
  qudt:hasDimensionVector dimensionvector:A0E0L0I0M0H0T0D1, dimensionvector:A0E0L0I0M0H0T0D1;
  qudt:plainTextDescription "The bioconcentration factor is the ratio of the concentration of a chemical substance in biota over the concentration of the same chemical substance in water. It is related to the octanol-water partition coefficient.",
    "The bioconcentration factor is the ratio of the concentration of a chemical substance in biota over the concentration of the same chemical substance in water. It is related to the octanol-water partition coefficient.";
  qudt:applicableUnit unit:UNITLESS, unit:UNITLESS .

quantitykind:CanonicalPartitionFunction a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "Canonical Partition Function"@en, "Canonical Partition Function"@en;
  rdfs:comment "Applicable units are those of quantitykind:CanonicalPartitionFunction",
    "Applicable units are those of quantitykind:CanonicalPartitionFunction";
  dct:description "A \"Canonical Partition Function\" applies to a canonical ensemble, in which the system is allowed to exchange heat with the environment at fixed temperature, volume, and number of particles."^^qudt:LatexString,
    "A \"Canonical Partition Function\" applies to a canonical ensemble, in which the system is allowed to exchange heat with the environment at fixed temperature, volume, and number of particles."^^qudt:LatexString;
  qudt:hasDimensionVector dimensionvector:A0E0L0I0M0H0T0D1, dimensionvector:A0E0L0I0M0H0T0D1;
  qudt:informativeReference "http://en.wikipedia.org/wiki/Partition_function_(statistical_mechanics)"^^xsd:anyURI,
    "http://en.wikipedia.org/wiki/Partition_function_(statistical_mechanics)"^^xsd:anyURI;
  qudt:symbol "Z", "Z";
  qudt:isoNormativeReference "http://www.iso.org/iso/catalogue_detail?csnumber=31894"^^xsd:anyURI,
    "http://www.iso.org/iso/catalogue_detail?csnumber=31894"^^xsd:anyURI;
  qudt:plainTextDescription "A \"Canonical Partition Function\" applies to a canonical ensemble, in which the system is allowed to exchange heat with the environment at fixed temperature, volume, and number of particles.",
    "A \"Canonical Partition Function\" applies to a canonical ensemble, in which the system is allowed to exchange heat with the environment at fixed temperature, volume, and number of particles.";
  qudt:latexDefinition "$Z = \\sum_r e^{-\\frac{E_r}{kT}}$, where the sum is over all quantum states consistent with given energy, volume, external fields, and content, $E_r$ is the energy in the $rth$ quantum state, $k$ is the Boltzmann constant, and $T$ is thermodynamic temperature."^^qudt:LatexString,
    "$Z = \\sum_r e^{-\\frac{E_r}{kT}}$, where the sum is over all quantum states consistent with given energy, volume, external fields, and content, $E_r$ is the energy in the $rth$ quantum state, $k$ is the Boltzmann constant, and $T$ is thermodynamic temperature."^^qudt:LatexString;
  qudt:applicableUnit unit:UNITLESS, unit:UNITLESS .

quantitykind:Chromaticity a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "Chromaticity"@en, "Chromaticity"@en;
  rdfs:comment "Applicable units are those of quantitykind:Chromaticity", "Applicable units are those of quantitykind:Chromaticity";
  dct:description "Chromaticity is an objective specification of the quality of a color regardless of its luminance"^^qudt:LatexString,
    "Chromaticity is an objective specification of the quality of a color regardless of its luminance"^^qudt:LatexString;
  qudt:hasDimensionVector dimensionvector:A0E0L0I0M0H0T0D1, dimensionvector:A0E0L0I0M0H0T0D1;
  qudt:informativeReference "https://en.wikipedia.org/wiki/Chromaticity"^^xsd:anyURI,
    "https://en.wikipedia.org/wiki/Chromaticity"^^xsd:anyURI;
  qudt:plainTextDescription "Chromaticity is an objective specification of the quality of a color regardless of its luminance",
    "Chromaticity is an objective specification of the quality of a color regardless of its luminance";
  qudt:applicableUnit unit:UNITLESS, unit:UNITLESS .

quantitykind:Constringence a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "Constringence"@en, "Constringence"@en;
  rdfs:comment "Applicable units are those of quantitykind:Constringence", "Applicable units are those of quantitykind:Constringence";
  dct:description "In optics and lens design, constringence of a transparent material, also known as the Abbe number or the V-number, is an approximate measure of the material's dispersion (change of refractive index versus wavelength), with high values of V indicating low dispersion."^^qudt:LatexString,
    "In optics and lens design, constringence of a transparent material, also known as the Abbe number or the V-number, is an approximate measure of the material's dispersion (change of refractive index versus wavelength), with high values of V indicating low dispersion."^^qudt:LatexString;
  skos:altLabel "Abbe Number"@en, "Abbe Number"@en, "V-number"@en, "V-number"@en;
  skos:broader quantitykind:DimensionlessRatio, quantitykind:DimensionlessRatio;
  qudt:hasDimensionVector dimensionvector:A0E0L0I0M0H0T0D1, dimensionvector:A0E0L0I0M0H0T0D1;
  qudt:informativeReference "https://en.wikipedia.org/wiki/Abbe_number"^^xsd:anyURI,
    "https://en.wikipedia.org/wiki/Abbe_number"^^xsd:anyURI;
  qudt:symbol "V", "V";
  qudt:applicableUnit unit:UNITLESS, unit:UNITLESS .

quantitykind:CouplingFactor a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "Constantă de cuplaj"@ro, "Constantă de cuplaj"@ro, "constante de acoplamiento"@es,
    "constante de acoplamiento"@es, "constante de couplage"@fr, "constante de couplage"@fr,
    "coupling factor"@en, "coupling factor"@en, "fattore di accoppiamento"@it, "fattore di accoppiamento"@it,
    "stała sprzężenia"@pl, "stała sprzężenia"@pl, "Çiftlenim sabiti"@tr, "Çiftlenim sabiti"@tr,
    "Константа взаимодействия"@ru, "Константа взаимодействия"@ru, "結合定数"@ja, "結合定数"@ja,
    "耦合常數"@zh, "耦合常數"@zh;
  rdfs:comment "Applicable units are those of quantitykind:CouplingFactor", "Applicable units are those of quantitykind:CouplingFactor";
  dct:description "\"Coupling Factor\" is the ratio of an electromagnetic quantity, usually voltage or current, appearing at a specified location of a given circuit to the corresponding quantity at a specified location in the circuit from which energy is transferred by coupling."^^qudt:LatexString,
    "\"Coupling Factor\" is the ratio of an electromagnetic quantity, usually voltage or current, appearing at a specified location of a given circuit to the corresponding quantity at a specified location in the circuit from which energy is transferred by coupling."^^qudt:LatexString;
  qudt:hasDimensionVector dimensionvector:A0E0L0I0M0H0T0D1, dimensionvector:A0E0L0I0M0H0T0D1;
  qudt:informativeReference "http://www.iso.org/iso/home/store/catalogue_tc/catalogue_detail.htm?csnumber=31891"^^xsd:anyURI,
    "http://www.iso.org/iso/home/store/catalogue_tc/catalogue_detail.htm?csnumber=31891"^^xsd:anyURI,
    "http://www.electropedia.org/iev/iev.nsf/display?openform&ievref=161-03-18"^^xsd:anyURI,
    "http://www.electropedia.org/iev/iev.nsf/display?openform&ievref=161-03-18"^^xsd:anyURI;
  qudt:symbol "k", "k";
  qudt:plainTextDescription "\"Coupling Factor\" is the ratio of an electromagnetic quantity, usually voltage or current, appearing at a specified location of a given circuit to the corresponding quantity at a specified location in the circuit from which energy is transferred by coupling.",
    "\"Coupling Factor\" is the ratio of an electromagnetic quantity, usually voltage or current, appearing at a specified location of a given circuit to the corresponding quantity at a specified location in the circuit from which energy is transferred by coupling.";
  qudt:latexDefinition "For inductive coupling between two inductive elements, $k = \\frac{\\left | L_{mn} \\right |}{\\sqrt{L_m L_n}}$, where $L_m$ and $L_n$ are their self inductances, and $L_{mn}$ is their mutual inductance."^^qudt:LatexString,
    "For inductive coupling between two inductive elements, $k = \\frac{\\left | L_{mn} \\right |}{\\sqrt{L_m L_n}}$, where $L_m$ and $L_n$ are their self inductances, and $L_{mn}$ is their mutual inductance."^^qudt:LatexString;
  qudt:applicableUnit unit:UNITLESS, unit:UNITLESS .

quantitykind:Debye-WallerFactor a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "Debye-Waller Factor"@en, "Debye-Waller Factor"@en;
  rdfs:comment "Applicable units are those of quantitykind:Debye-WallerFactor", "Applicable units are those of quantitykind:Debye-WallerFactor";
  dct:description "\"Debye-Waller Factor\" (DWF), named after Peter Debye and Ivar Waller, is used in condensed matter physics to describe the attenuation of x-ray scattering or coherent neutron scattering caused by thermal motion. Also, a factor by which the intensity of a diffraction line is reduced because of the lattice vibrations."^^qudt:LatexString,
    "\"Debye-Waller Factor\" (DWF), named after Peter Debye and Ivar Waller, is used in condensed matter physics to describe the attenuation of x-ray scattering or coherent neutron scattering caused by thermal motion. Also, a factor by which the intensity of a diffraction line is reduced because of the lattice vibrations."^^qudt:LatexString;
  qudt:hasDimensionVector dimensionvector:A0E0L0I0M0H0T0D1, dimensionvector:A0E0L0I0M0H0T0D1;
  qudt:informativeReference "http://en.wikipedia.org/wiki/Debye–Waller_factor"^^xsd:anyURI,
    "http://en.wikipedia.org/wiki/Debye–Waller_factor"^^xsd:anyURI;
  qudt:symbol "D, B", "D, B";
  qudt:isoNormativeReference "http://www.iso.org/iso/catalogue_detail?csnumber=31897"^^xsd:anyURI,
    "http://www.iso.org/iso/catalogue_detail?csnumber=31897"^^xsd:anyURI;
  qudt:plainTextDescription "\"Debye-Waller Factor\" (DWF), named after Peter Debye and Ivar Waller, is used in condensed matter physics to describe the attenuation of x-ray scattering or coherent neutron scattering caused by thermal motion. Also, a factor by which the intensity of a diffraction line is reduced because of the lattice vibrations.",
    "\"Debye-Waller Factor\" (DWF), named after Peter Debye and Ivar Waller, is used in condensed matter physics to describe the attenuation of x-ray scattering or coherent neutron scattering caused by thermal motion. Also, a factor by which the intensity of a diffraction line is reduced because of the lattice vibrations.";
  qudt:latexDefinition "$u = R - R_0$, where $R$ is the particle position vector and $R_0$ is the equilibrium position vector of a particle."^^qudt:LatexString,
    "$u = R - R_0$, where $R$ is the particle position vector and $R_0$ is the equilibrium position vector of a particle."^^qudt:LatexString;
  qudt:applicableUnit unit:UNITLESS, unit:UNITLESS .

quantitykind:DegreeOfDissociation a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "Degree of Dissociation"@en, "Degree of Dissociation"@en;
  rdfs:comment "Applicable units are those of quantitykind:DegreeOfDissociation", "Applicable units are those of quantitykind:DegreeOfDissociation";
  dct:description "The \"Degree of Dissociation\" is the fraction of original solute molecules that have dissociated."^^qudt:LatexString,
    "The \"Degree of Dissociation\" is the fraction of original solute molecules that have dissociated."^^qudt:LatexString;
  qudt:dbpediaMatch "http://dbpedia.org/resource/Faraday_constant"^^xsd:anyURI, "http://dbpedia.org/resource/Faraday_constant"^^xsd:anyURI;
  qudt:hasDimensionVector dimensionvector:A0E0L0I0M0H0T0D1, dimensionvector:A0E0L0I0M0H0T0D1;
  qudt:informativeReference "http://en.wikipedia.org/wiki/Dissociation_(chemistry)"^^xsd:anyURI,
    "http://en.wikipedia.org/wiki/Dissociation_(chemistry)"^^xsd:anyURI;
  qudt:isoNormativeReference "http://www.iso.org/iso/catalogue_detail?csnumber=31894"^^xsd:anyURI,
    "http://www.iso.org/iso/catalogue_detail?csnumber=31894"^^xsd:anyURI;
  qudt:plainTextDescription "The \"Degree of Dissociation\" is the fraction of original solute molecules that have dissociated.",
    "The \"Degree of Dissociation\" is the fraction of original solute molecules that have dissociated.";
  qudt:latexSymbol "$\\alpha$"^^qudt:LatexString, "$\\alpha$"^^qudt:LatexString;
  qudt:applicableUnit unit:UNITLESS, unit:UNITLESS .

quantitykind:Dissipance a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "Dissipance"@en, "Dissipance"@en;
  rdfs:comment "Applicable units are those of quantitykind:Dissipance", "Applicable units are those of quantitykind:Dissipance";
  dct:description "Dissipance, or dissipation factor for sound power, is the ratio of dissipated sound power to incident sound power. The dissipation factor (DF) is a measure of loss-rate of energy of a mode of oscillation (mechanical, electrical, or electromechanical) in a dissipative system. It is the reciprocal of quality factor, which represents the quality of oscillation."^^qudt:LatexString,
    "Dissipance, or dissipation factor for sound power, is the ratio of dissipated sound power to incident sound power. The dissipation factor (DF) is a measure of loss-rate of energy of a mode of oscillation (mechanical, electrical, or electromechanical) in a dissipative system. It is the reciprocal of quality factor, which represents the quality of oscillation."^^qudt:LatexString;
  qudt:hasDimensionVector dimensionvector:A0E0L0I0M0H0T0D1, dimensionvector:A0E0L0I0M0H0T0D1;
  qudt:informativeReference "http://en.wikipedia.org/wiki/Dissipation_factor"^^xsd:anyURI,
    "http://en.wikipedia.org/wiki/Dissipation_factor"^^xsd:anyURI;
  qudt:plainTextDescription "Dissipance, or dissipation factor for sound power, is the ratio of dissipated sound power to incident sound power. The dissipation factor (DF) is a measure of loss-rate of energy of a mode of oscillation (mechanical, electrical, or electromechanical) in a dissipative system. It is the reciprocal of quality factor, which represents the quality of oscillation.",
    "Dissipance, or dissipation factor for sound power, is the ratio of dissipated sound power to incident sound power. The dissipation factor (DF) is a measure of loss-rate of energy of a mode of oscillation (mechanical, electrical, or electromechanical) in a dissipative system. It is the reciprocal of quality factor, which represents the quality of oscillation.";
  qudt:latexSymbol "$\\delta$"^^qudt:LatexString, "$\\delta$"^^qudt:LatexString;
  qudt:latexDefinition "$\\delta = \\frac{P_d}{P_i}$, where $P_d$ is the dissipated sound power, and $P_i$ is the incident sound power."^^qudt:LatexString,
    "$\\delta = \\frac{P_d}{P_i}$, where $P_d$ is the dissipated sound power, and $P_i$ is the incident sound power."^^qudt:LatexString;
  <http://www.linkedmodel.org/schema/vaem#todo> "belongs to SOQ-ISO", "belongs to SOQ-ISO";
  qudt:applicableUnit unit:UNITLESS, unit:UNITLESS .

quantitykind:DoseEquivalentQualityFactor a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "Dose Equivalent Quality Factor"@en, "Dose Equivalent Quality Factor"@en;
  rdfs:comment "Applicable units are those of quantitykind:DoseEquivalentQualityFactor",
    "Applicable units are those of quantitykind:DoseEquivalentQualityFactor";
  dct:description "\"Dose Equivalent Quality Factor\" is a factor in the caculation and measurement of dose equivalent, by which the absorbed dose is to be weighted in order to account for different biological effectiveness of radiations, for radiation protection purposes."^^qudt:LatexString,
    "\"Dose Equivalent Quality Factor\" is a factor in the caculation and measurement of dose equivalent, by which the absorbed dose is to be weighted in order to account for different biological effectiveness of radiations, for radiation protection purposes."^^qudt:LatexString;
  qudt:hasDimensionVector dimensionvector:A0E0L0I0M0H0T0D1, dimensionvector:A0E0L0I0M0H0T0D1;
  qudt:informativeReference "http://en.wikipedia.org/wiki/Equivalent_dose"^^xsd:anyURI,
    "http://en.wikipedia.org/wiki/Equivalent_dose"^^xsd:anyURI;
  qudt:symbol "Q", "Q";
  qudt:isoNormativeReference "http://www.iso.org/iso/catalogue_detail?csnumber=31895"^^xsd:anyURI,
    "http://www.iso.org/iso/catalogue_detail?csnumber=31895"^^xsd:anyURI;
  qudt:plainTextDescription "\"Dose Equivalent Quality Factor\" is a factor in the caculation and measurement of dose equivalent, by which the absorbed dose is to be weighted in order to account for different biological effectiveness of radiations, for radiation protection purposes.",
    "\"Dose Equivalent Quality Factor\" is a factor in the caculation and measurement of dose equivalent, by which the absorbed dose is to be weighted in order to account for different biological effectiveness of radiations, for radiation protection purposes.";
  qudt:applicableUnit unit:UNITLESS, unit:UNITLESS .

quantitykind:Duv a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
