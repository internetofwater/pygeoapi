qudt:currencyCode a owl:DatatypeProperty, owl:DatatypeProperty, owl:FunctionalProperty,
    owl:FunctionalProperty;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/schema/qudt>, <http://qudt.org/schema/qudt>;
  rdfs:seeAlso "https://en.wikipedia.org/wiki/ISO_4217"^^xsd:anyURI, "https://en.wikipedia.org/wiki/ISO_4217"^^xsd:anyURI;
  rdfs:label "currency code", "currency code";
  rdfs:range xsd:string, xsd:string;
  dct:description "Alphabetic Currency Code as defined by ISO 4217. For example, US Dollar has the code 'USD'."^^rdf:HTML,
    "Alphabetic Currency Code as defined by ISO 4217. For example, US Dollar has the code 'USD'."^^rdf:HTML .

_:6bb918f5130b4a77805c72ffff92bd8c546 a owl:Restriction;
  owl:maxCardinality 1;
  owl:onProperty qudt:currencyExponent .

qudt:currencyExponent a owl:DatatypeProperty, owl:DatatypeProperty, owl:FunctionalProperty,
    owl:FunctionalProperty;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/schema/qudt>, <http://qudt.org/schema/qudt>;
  rdfs:label "currency exponent", "currency exponent";
  rdfs:range xsd:integer, xsd:integer;
  dct:description "The currency exponent indicates the number of decimal places between a major currency unit and its minor currency unit. For example, the US dollar is the major currency unit of the United States, and the US cent is the minor currency unit. Since one cent is 1/100 of a dollar, the US dollar has a currency exponent of 2. However, the Japanese Yen has no minor currency units, so the yen has a currency exponent of 0."^^rdf:HTML,
    "The currency exponent indicates the number of decimal places between a major currency unit and its minor currency unit. For example, the US dollar is the major currency unit of the United States, and the US cent is the minor currency unit. Since one cent is 1/100 of a dollar, the US dollar has a currency exponent of 2. However, the Japanese Yen has no minor currency units, so the yen has a currency exponent of 0."^^rdf:HTML .

