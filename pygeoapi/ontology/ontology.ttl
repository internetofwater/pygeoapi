  <http://qudt.org/schema/qudt/hasQuantityKind> <http://qudt.org/vocab/quantitykind/Dimensionless>;
  <http://qudt.org/schema/qudt/informativeReference> "https://www.genome.gov/genetics-glossary/Gigabase"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/symbol> "Gbp";
  <http://qudt.org/schema/qudt/plainTextDescription> "A gigabase (abbreviated Gb, or Gbp for gigabase pairs.) is a unit of measurement used to help designate the length of DNA. One gigabase is equal to 1 billion bases. " .

