unit:RAD-PER-SEC2 a qudt:Unit, qudt:Unit, qudt:DerivedUnit, qudt:DerivedUnit;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/unit>, <http://qudt.org/vocab/unit>;
  rdfs:label "Radian per Square Second"@en, "Radian per Square Second"@en;
  dct:description "Angular acceleration is the rate of change of angular velocity. In SI units, it is measured in radians per Square second ($rad/s^2$), and is usually denoted by the Greek letter $\\alpha$."^^qudt:LatexString,
    "Angular acceleration is the rate of change of angular velocity. In SI units, it is measured in radians per Square second ($rad/s^2$), and is usually denoted by the Greek letter $\\alpha$."^^qudt:LatexString;
