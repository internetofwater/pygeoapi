    "This property is intended to be used with non-literal values. This property is an inverse property of Requires."@en;
  dct:issued "2000-07-11"^^xsd:date, "2000-07-11"^^xsd:date .

dct:isVersionOf a rdf:Property, rdf:Property;
  rdfs:isDefinedBy <http://purl.org/dc/terms/>, <http://purl.org/dc/terms/>;
  rdfs:label "Is Version Of"@en, "Is Version Of"@en;
  rdfs:comment "A related resource of which the described resource is a version, edition, or adaptation."@en,
    "A related resource of which the described resource is a version, edition, or adaptation."@en;
  rdfs:subPropertyOf dc:relation, dc:relation, dct:relation, dct:relation;
  dct:description "Changes in version imply substantive changes in content rather than differences in format. This property is intended to be used with non-literal values. This property is an inverse property of Has Version."@en,
    "Changes in version imply substantive changes in content rather than differences in format. This property is intended to be used with non-literal values. This property is an inverse property of Has Version."@en;
  dct:issued "2000-07-11"^^xsd:date, "2000-07-11"^^xsd:date .

dct:language a rdf:Property, rdf:Property;
