unit:FBM a qudt:Unit ;
    rdfs:label "Board Foot"@en ;
    dct:description "The board-foot is a specialized unit of measure for the volume of lumber in the United States and Canada. It is the volume of a one-foot length of a board one foot wide and one inch thick. Board-foot can be abbreviated FBM (for 'foot, board measure'), BDFT, or BF. Thousand board-feet can be abbreviated as MFBM, MBFT or MBF. "^^rdf:HTML ;
    qudt:applicableSystem <http://qudt.org/vocab/sou/IMPERIAL>,
        <http://qudt.org/vocab/sou/USCS> ;
