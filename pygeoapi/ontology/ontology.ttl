unit:BTU_IT-FT-PER-FT2-HR-DEG_F a qudt:Unit, qudt:Unit, qudt:DerivedUnit, qudt:DerivedUnit;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/unit>, <http://qudt.org/vocab/unit>;
  rdfs:label "BTU (IT) Foot per Square Foot Hour Degree Fahrenheit"@en, "BTU (IT) Foot per Square Foot Hour Degree Fahrenheit"@en;
  dct:description """
  A $BTU_{IT}$, $\\italic{Foot per Square Foot Hour Degree Fahrenheit}$ is an Imperial unit for 'Thermal Conductivity',
   expressed as $Btu_{it} \\cdot ft/(h \\cdot ft^2  \\cdot degF)$.
  """^^qudt:LatexString,
    """
  A $BTU_{IT}$, $\\italic{Foot per Square Foot Hour Degree Fahrenheit}$ is an Imperial unit for 'Thermal Conductivity',
   expressed as $Btu_{it} \\cdot ft/(h \\cdot ft^2  \\cdot degF)$.
