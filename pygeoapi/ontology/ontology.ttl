quantitykind:SpecificModulus a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "Specific Modulus"@en, "Specific Modulus"@en;
  rdfs:comment "Applicable units are those of quantitykind:SpecificModulus", "Applicable units are those of quantitykind:SpecificModulus";
  dct:description "<p><b>Specific modulus</b> is a <a href=\"/wiki/Materials_property\" class=\"mw-redirect\" title=\"Materials property\">materials property</a> consisting of the <a href=\"/wiki/Elastic_modulus\" title=\"Elastic modulus\">elastic modulus</a> per mass <a href=\"/wiki/Density\" title=\"Density\">density</a> of a material. It is also known as the <b>stiffness to weight ratio</b> or <b>specific stiffness</b>. High specific modulus materials find wide application in <a href=\"/wiki/Aerospace\" title=\"Aerospace\">aerospace</a> applications where minimum structural <a href=\"/wiki/Weight\" title=\"Weight\">weight</a> is required. The <a href=\"/wiki/Dimensional_analysis\" title=\"Dimensional analysis\">dimensional analysis</a> yields units of distance squared per time squared.</p>"^^qudt:LatexString,
    "<p><b>Specific modulus</b> is a <a href=\"/wiki/Materials_property\" class=\"mw-redirect\" title=\"Materials property\">materials property</a> consisting of the <a href=\"/wiki/Elastic_modulus\" title=\"Elastic modulus\">elastic modulus</a> per mass <a href=\"/wiki/Density\" title=\"Density\">density</a> of a material. It is also known as the <b>stiffness to weight ratio</b> or <b>specific stiffness</b>. High specific modulus materials find wide application in <a href=\"/wiki/Aerospace\" title=\"Aerospace\">aerospace</a> applications where minimum structural <a href=\"/wiki/Weight\" title=\"Weight\">weight</a> is required. The <a href=\"/wiki/Dimensional_analysis\" title=\"Dimensional analysis\">dimensional analysis</a> yields units of distance squared per time squared.</p>"^^qudt:LatexString;
  skos:altLabel "Specific Stiffness"@en, "Specific Stiffness"@en, "Stiffness to Weight Ratio"@en,
    "Stiffness to Weight Ratio"@en;
  qudt:dbpediaMatch "http://dbpedia.org/resource/Specific_modulus"^^xsd:anyURI, "http://dbpedia.org/resource/Specific_modulus"^^xsd:anyURI;
  qudt:hasDimensionVector dimensionvector:A0E0L2I0M0H0T-2D0, dimensionvector:A0E0L2I0M0H0T-2D0;
  qudt:informativeReference "https://en.wikipedia.org/wiki/Specific_modulus"^^xsd:anyURI,
    "https://en.wikipedia.org/wiki/Specific_modulus"^^xsd:anyURI;
  qudt:latexDefinition "$specific modulus = E/\\rho$, where $E$ is elastic modulus and $\\rho$ is density."^^qudt:LatexString,
    "$specific modulus = E/\\rho$, where $E$ is elastic modulus and $\\rho$ is density."^^qudt:LatexString;
  qudt:applicableUnit unit:GigaPA-CentiM3-PER-GM, unit:GigaPA-CentiM3-PER-GM, unit:KiloM2-PER-SEC2,
    unit:KiloM2-PER-SEC2, unit:M2-PER-SEC2, unit:M2-PER-SEC2 .

