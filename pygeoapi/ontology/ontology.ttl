unit:M2-PER-SEC a qudt:Unit, qudt:Unit, qudt:DerivedUnit, qudt:DerivedUnit;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/unit>, <http://qudt.org/vocab/unit>;
  rdfs:label "Quadratmeter je Sekunde"@de, "Quadratmeter je Sekunde"@de, "Square Meter per Second"@en-US,
    "Square Meter per Second"@en-US, "kvadratni meter na sekundo"@sl, "kvadratni meter na sekundo"@sl,
    "meter persegi per saat"@ms, "meter persegi per saat"@ms, "metr kwadratowy na sekundę"@pl,
    "metr kwadratowy na sekundę"@pl, "metrekare bölü saniye"@tr, "metrekare bölü saniye"@tr,
    "metro cuadrado por segundo"@es, "metro cuadrado por segundo"@es, "metro quadrado por segundo"@pt,
    "metro quadrado por segundo"@pt, "metro quadrato al secondo"@it, "metro quadrato al secondo"@it,
    "metru pătrat pe secundă"@ro, "metru pătrat pe secundă"@ro, "mètre carré par seconde"@fr,
    "mètre carré par seconde"@fr, "square metre per second"@en, "square metre per second"@en,
    "čtvereční metr za sekundu"@cs, "čtvereční metr za sekundu"@cs, "квадратный метр в секунду"@ru,
    "квадратный метр в секунду"@ru, "متر مربع بر ثانیه"@fa, "متر مربع بر ثانیه"@fa, "متر مربع في الثانية"@ar,
    "متر مربع في الثانية"@ar, "वर्ग मीटर प्रति सैकिण्ड"@hi, "वर्ग मीटर प्रति सैकिण्ड"@hi,
    "平方メートル毎秒"@ja, "平方メートル毎秒"@ja, "平方米每秒"@zh, "平方米每秒"@zh;
  dct:description """
  The unit $\\textit{Square Metres per Second}$ is the SI derived unit of angular momentum, defined by distance
   or displacement in metres multiplied by distance again in metres and divided by time in seconds. 
  The unit is written in symbols as $m^2/s$ or $m^22s^{-1}$. 
  It may be better understood when phrased as $\\textit{metres per second times metres}$, i.e. the momentum
   of an object with respect to a position.
  """^^qudt:LatexString,
    """
  The unit $\\textit{Square Metres per Second}$ is the SI derived unit of angular momentum, defined by distance
   or displacement in metres multiplied by distance again in metres and divided by time in seconds. 
  The unit is written in symbols as $m^2/s$ or $m^22s^{-1}$. 
  It may be better understood when phrased as $\\textit{metres per second times metres}$, i.e. the momentum
   of an object with respect to a position.
  """^^qudt:LatexString;
  qudt:applicableSystem <http://qudt.org/vocab/sou/CGS-EMU>, <http://qudt.org/vocab/sou/CGS-EMU>,
    <http://qudt.org/vocab/sou/CGS-GAUSS>, <http://qudt.org/vocab/sou/CGS-GAUSS>, <http://qudt.org/vocab/sou/SI>,
    <http://qudt.org/vocab/sou/SI>, <http://qudt.org/vocab/sou/CGS>, <http://qudt.org/vocab/sou/CGS>;
  qudt:conversionMultiplier 1.0, 1.0;
