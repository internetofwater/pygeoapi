<http://qudt.org/schema/qudt/QuantityType> a owl:Class;
  rdfs:subClassOf <http://qudt.org/schema/qudt/EnumeratedValue>, _:6bb918f5130b4a77805c72ffff92bd8c674;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/schema/qudt>;
  rdfs:label "Quantity type";
