<http://qudt.org/vocab/quantitykind/ResistanceBasedInductance> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "resistance-based inductance"@en-US;
  dct:description "magnetic flux through the loop, caused by an electric current in the loop, divided by the product of this current and the resistance which prevents the flow of current"@en;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T1D0>;
  <http://qudt.org/schema/qudt/symbol> "0173-1#Z4-BAJ411#002";
  <http://qudt.org/schema/qudt/plainTextDescription> "Magnetfluss durch die Schleife, verursacht durch einen elektrischen Strom in der Schleife, dividiert durch das Produkt aus diesen Strom und dem Widerstand, der diesen Stromfluss behindert"@de .

