unit:CentiM2-PER-SR-ERG a <http://qudt.org/schema/qudt/Unit>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/unit>;
  rdfs:label "square centimetre per steradian erg";
  dct:description "[CGS] unit of the spectral angle profile";
  <http://qudt.org/schema/qudt/conversionMultiplier> 1000.0;
  <http://qudt.org/schema/qudt/conversionMultiplierSN> 1.0E3;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L0I0M-1H0T2D0>;
  <http://qudt.org/schema/qudt/hasQuantityKind> <http://qudt.org/vocab/quantitykind/SpectralAngularCrossSection>;
  <http://qudt.org/schema/qudt/iec61360Code> "0112/2///62720#UAB169";
  <http://qudt.org/schema/qudt/informativeReference> "https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAB169"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/symbol> "cm²/(sr·erg)";
  <http://qudt.org/schema/qudt/ucumCode> "cm2.sr-1.erg-1"^^<http://qudt.org/schema/qudt/UCUMcs>;
  <http://qudt.org/schema/qudt/uneceCommonCode> "D17" .

<http://qudt.org/vocab/quantitykind/SpectralAngularCrossSection> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Spectral Angular Cross-section"@en;
  rdfs:comment "Applicable units are those of quantitykind:SpectralAngularCrossSection";
  dct:description "\"Spectral Angular Cross-section\" is the cross-section for ejecting or scattering a particle into an elementary cone with energy $E$ in an energy interval, divided by the solid angle $d\\Omega$ of that cone and the range $dE$ of that interval."^^<http://qudt.org/schema/qudt/LatexString>;
  skos:closeMatch <http://qudt.org/vocab/quantitykind/SpectralCrossSection>, <http://qudt.org/vocab/quantitykind/AngularCrossSection>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L0I0M-1H0T2D0>;
  <http://qudt.org/schema/qudt/informativeReference> "http://en.wikipedia.org/wiki/Cross_section_(physics)"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/isoNormativeReference> "http://www.iso.org/iso/catalogue_detail?csnumber=31895"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/latexSymbol> "$\\sigma_{\\Omega, E}$"^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/latexDefinition> "$\\sigma = \\int \\int \\sigma_{\\Omega,E} d\\Omega dE$"^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/applicableUnit> unit:CentiM2-PER-SR-ERG, unit:M2-PER-SR-J .

