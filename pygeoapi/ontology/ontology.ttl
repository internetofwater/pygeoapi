        [ qudt:exponent 1 ;
            qudt:hasUnit unit:A ],
        [ qudt:exponent 1 ;
            qudt:hasUnit unit:HR ],
        [ qudt:exponent -1 ;
            qudt:hasUnit unit:DEG_C ],
