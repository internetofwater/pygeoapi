quantitykind:ParticleFluence a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "Particle Fluence"@en, "Particle Fluence"@en;
  rdfs:comment "Applicable units are those of quantitykind:ParticleFluence", "Applicable units are those of quantitykind:ParticleFluence";
  dct:description """
  The quantity kind $\\textit{Particle Fluence}$ is the total number of particles that
   intersect a unit area in a specific time interval of interest, and has units of $m^{-2}$
    (number of particles per meter squared).
  """^^qudt:LatexString,
    """
  The quantity kind $\\textit{Particle Fluence}$ is the total number of particles that
   intersect a unit area in a specific time interval of interest, and has units of $m^{-2}$
    (number of particles per meter squared).
  """^^qudt:LatexString;
  qudt:hasDimensionVector dimensionvector:A0E0L-2I0M0H0T0D0, dimensionvector:A0E0L-2I0M0H0T0D0;
  qudt:iec61360Code "0112/2///62720#UAD133", "0112/2///62720#UAD133";
  qudt:informativeReference "http://en.wikipedia.org/wiki/Fluence"^^xsd:anyURI, "http://en.wikipedia.org/wiki/Fluence"^^xsd:anyURI,
    "https://cdd.iec.ch/cdd/iec61987/iec61987.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD133"^^xsd:anyURI,
    "https://cdd.iec.ch/cdd/iec61987/iec61987.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD133"^^xsd:anyURI;
  qudt:isoNormativeReference "http://www.iso.org/iso/catalogue_detail?csnumber=31895"^^xsd:anyURI,
    "http://www.iso.org/iso/catalogue_detail?csnumber=31895"^^xsd:anyURI;
  qudt:plainTextDescription "\"Particle Fluence\" is the total number of particles that intersect a unit area in a specific time interval of interest, and has units of /m2 (number of particles per meter squared).",
    "\"Particle Fluence\" is the total number of particles that intersect a unit area in a specific time interval of interest, and has units of /m2 (number of particles per meter squared).";
  qudt:latexSymbol "$\\Phi$"^^qudt:LatexString, "$\\Phi$"^^qudt:LatexString;
  qudt:latexDefinition "$\\Phi = \\frac{dN}{dA}$, where $dN$ describes the number of particles incident on a small spherical domain at a given point in space, and $dA$ describes the cross-sectional area of that domain."^^qudt:LatexString,
    "$\\Phi = \\frac{dN}{dA}$, where $dN$ describes the number of particles incident on a small spherical domain at a given point in space, and $dA$ describes the cross-sectional area of that domain."^^qudt:LatexString;
  qudt:applicableUnit unit:NUM-PER-HA, unit:NUM-PER-HA, unit:NUM-PER-KiloM2, unit:NUM-PER-KiloM2,
