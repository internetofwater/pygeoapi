    skos:definition "Acid neutralizing capacity" ;
    skos:historyNote "Originally from the CUAHSI HIS VariableNameCV.  See: http://his.cuahsi.org/mastercvreg/edit_cv11.aspx?tbl=VariableNameCV." ;
    skos:inScheme <http://vocabulary.odm2.org/variablename> ;
    skos:prefLabel "Acid neutralizing capacity" ;
    skos:topConceptOf <http://vocabulary.odm2.org/variablename> .

variablename:acidPhosphatase a skos:Concept ;
    ns3:category "Chemistry" ;
    skos:definition "Phosphatase enzymes are used by soil microorganisms to access organically bound phosphate nutrients. An assay on the rates of activity of these enzymes may be used to ascertain biological demand for phosphates in the soil. Some plant roots, especially cluster roots, exude carboxylates that perform acid phosphatase activity, helping to mobilise phosphorus in nutrient-deficient soils." ;
    skos:exactMatch "https://en.wikipedia.org/wiki/Acid_phosphatase" ;
    skos:historyNote "Wikipedia" ;
    skos:inScheme <http://vocabulary.odm2.org/variablename> ;
    skos:prefLabel "Acid phosphatase" ;
    skos:topConceptOf <http://vocabulary.odm2.org/variablename> .

variablename:acidityCO2Acidity a skos:Concept ;
    skos:definition "CO2 acidity" ;
    skos:historyNote "Originally from the CUAHSI HIS VariableNameCV.  See: http://his.cuahsi.org/mastercvreg/edit_cv11.aspx?tbl=VariableNameCV." ;
    skos:inScheme <http://vocabulary.odm2.org/variablename> ;
    skos:prefLabel "Acidity, CO2 acidity" ;
    skos:topConceptOf <http://vocabulary.odm2.org/variablename> .

variablename:acidityExchange a skos:Concept ;
    skos:definition "The total amount of the Cation Exchange Capacity (CEC) of a soil that is due to H+ and Al3+ ions. It is a proportion of the total acidity and it is dependent on the type of soil and the percentage of the CEC that is composed of exchangeable bases (Ca2+, Mg2+, K+)." ;
    skos:historyNote "Originally from the CUAHSI HIS VariableNameCV.  See: http://his.cuahsi.org/mastercvreg/edit_cv11.aspx?tbl=VariableNameCV." ;
    skos:inScheme <http://vocabulary.odm2.org/variablename> ;
    skos:prefLabel "Acidity, exchange" ;
    skos:topConceptOf <http://vocabulary.odm2.org/variablename> .

variablename:acidityHot a skos:Concept ;
    skos:definition "Hot Acidity" ;
    skos:historyNote "Originally from the CUAHSI HIS VariableNameCV.  See: http://his.cuahsi.org/mastercvreg/edit_cv11.aspx?tbl=VariableNameCV." ;
    skos:inScheme <http://vocabulary.odm2.org/variablename> ;
    skos:prefLabel "Acidity, hot" ;
    skos:topConceptOf <http://vocabulary.odm2.org/variablename> .

variablename:acidityMineralAcidity a skos:Concept ;
    skos:definition "Mineral Acidity" ;
    skos:historyNote "Originally from the CUAHSI HIS VariableNameCV.  See: http://his.cuahsi.org/mastercvreg/edit_cv11.aspx?tbl=VariableNameCV." ;
    skos:inScheme <http://vocabulary.odm2.org/variablename> ;
    skos:prefLabel "Acidity, mineral acidity" ;
    skos:topConceptOf <http://vocabulary.odm2.org/variablename> .

