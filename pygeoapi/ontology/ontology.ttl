:c_27cef761 a skos:Concept;
  skos:definition "Serves Reclamation's programs and their staff. Brings together practitioners of the H&H subcommunity topics to discusss, share experiences and resources, and support conversations at an agency level to continue bringing the best available ifnormation to the forefront of water managment."@en;
  skos:inScheme :conceptScheme_28b55cfc;
  skos:prefLabel "Hydrology and Hydraulics Community of Practice"@en;
  skos:altLabel "H&H"@en, "H&H CoP"@en;
