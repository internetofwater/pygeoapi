unit:PlanckPower a qudt:Unit, qudt:Unit;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/unit>, <http://qudt.org/vocab/unit>;
  rdfs:label "Planck Power"@en, "Planck Power"@en;
  dct:description "The Planck energy divided by the Planck time is the Planck power $P_p $, equal to about $3.62831 \\times 10^{52} W$. This is an extremely large unit; even gamma-ray bursts, the most luminous phenomena known, have output on the order of $1 \\times 10^{45} W$, less than one ten-millionth of the Planck power."^^qudt:LatexString,
    "The Planck energy divided by the Planck time is the Planck power $P_p $, equal to about $3.62831 \\times 10^{52} W$. This is an extremely large unit; even gamma-ray bursts, the most luminous phenomena known, have output on the order of $1 \\times 10^{45} W$, less than one ten-millionth of the Planck power."^^qudt:LatexString;
  qudt:applicableSystem <http://qudt.org/vocab/sou/PLANCK>, <http://qudt.org/vocab/sou/PLANCK>;
  qudt:conversionMultiplier 36283100000000000000000000000000000000000000000000000.0,
    36283100000000000000000000000000000000000000000000000.0;
  qudt:conversionMultiplierSN 3.62831E52, 3.62831E52;
  qudt:dbpediaMatch "http://dbpedia.org/resource/Planck_power"^^xsd:anyURI, "http://dbpedia.org/resource/Planck_power"^^xsd:anyURI;
  qudt:hasDimensionVector dimensionvector:A0E0L2I0M1H0T-3D0, dimensionvector:A0E0L2I0M1H0T-3D0;
  qudt:hasQuantityKind quantitykind:Power, quantitykind:Power;
  qudt:informativeReference "http://en.wikipedia.org/wiki/Planck_power?oldid=493642483"^^xsd:anyURI,
    "http://en.wikipedia.org/wiki/Planck_power?oldid=493642483"^^xsd:anyURI;
  qudt:symbol "planckpower", "planckpower";
  qudt:latexDefinition "$P_p = {\\frac{ c^5}{G}}$, where $c$ is the speed of light in a vacuum, and $G$ is the gravitational constant."^^qudt:LatexString,
    "$P_p = {\\frac{ c^5}{G}}$, where $c$ is the speed of light in a vacuum, and $G$ is the gravitational constant."^^qudt:LatexString;
