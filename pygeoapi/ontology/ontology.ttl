    "http://en.wikipedia.org/wiki/Planck_force?oldid=493643031"^^xsd:anyURI;
  qudt:symbol "planckforce", "planckforce";
  qudt:derivedUnitOfSystem <http://qudt.org/vocab/sou/PLANCK>, <http://qudt.org/vocab/sou/PLANCK>;
