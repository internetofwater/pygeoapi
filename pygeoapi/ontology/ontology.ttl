  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/unit>;
  rdfs:label "Megajoule Per Square Meter Per Day"@en-US, "Megajoule Per Square Metre Per Day"@en;
  dct:description "MegaJoule Per Square Meter Per Day (\\(MegaJ/m^2/day\\)) is a unit in the category of Energy density over time."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/applicableSystem> <http://qudt.org/vocab/sou/CGS-EMU>,
    <http://qudt.org/vocab/sou/CGS-GAUSS>, <http://qudt.org/vocab/sou/SI>, <http://qudt.org/vocab/sou/CGS>;
  <http://qudt.org/schema/qudt/conversionMultiplier> 11.57407407407407;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L0I0M1H0T-3D0>;
  <http://qudt.org/schema/qudt/hasQuantityKind> <http://qudt.org/vocab/quantitykind/Irradiance>;
  <http://qudt.org/schema/qudt/symbol> "MJ/(m²·d)";
  <http://qudt.org/schema/qudt/ucumCode> "MJ.m-2.d-1"^^<http://qudt.org/schema/qudt/UCUMcs>;
  <http://qudt.org/schema/qudt/plainTextDescription> "1,000,000-fold of the SI derived unit joule divided by the power of the SI base unit metre with the exponent 2" .

<http://qudt.org/vocab/quantitykind/Irradiance> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Bestrahlungsstärke"@de, "Intenzita záření"@cs, "Kepenyinaran"@ms, "irradiance"@en,
    "irradiancia"@es, "irradianza"@it, "irradiância"@pt, "yoğunluk"@tr, "éclairement énergétique"@fr,
    "Поверхностная плотность потока энергии"@ru, "الطاقة الهلامية"@ar, "پرتو افکنی/چگالی تابش"@fa,
    "熱流束"@ja, "辐照度"@zh;
  rdfs:comment "Applicable units are those of quantitykind:Irradiance";
  dct:description "Irradiance and Radiant Emittance are radiometry terms for the power per unit area of electromagnetic radiation at a surface. \"Irradiance\" is used when the electromagnetic radiation is incident on the surface. \"Radiant emmitance\" (or \"radiant exitance\") is used when the radiation is emerging from the surface."^^<http://qudt.org/schema/qudt/LatexString>;
  skos:altLabel "koyuluk"@tr;
  skos:broader <http://qudt.org/vocab/quantitykind/PowerPerArea>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L0I0M1H0T-3D0>;
  <http://qudt.org/schema/qudt/iec61360Code> "0112/2///62720#UAD068";
  <http://qudt.org/schema/qudt/informativeReference> "http://en.wikipedia.org/wiki/Irradiance"^^xsd:anyURI,
    "https://cdd.iec.ch/cdd/iec61987/iec61987.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD068"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/symbol> "E";
  <http://qudt.org/schema/qudt/plainTextDescription> "Irradiance and Radiant Emittance are radiometry terms for the power per unit area of electromagnetic radiation at a surface. \"Irradiance\" is used when the electromagnetic radiation is incident on the surface. \"Radiant emmitance\" (or \"radiant exitance\") is used when the radiation is emerging from the surface.";
  <http://qudt.org/schema/qudt/latexDefinition> "$E = \\frac{d\\Phi}{dA}$, where $d\\Phi$ is the radiant flux incident on an element of the surface with area $dA$."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/abbreviation> "W-PER-M2";
  <http://qudt.org/schema/qudt/applicableUnit> unit:MegaJ-PER-M2-DAY .

