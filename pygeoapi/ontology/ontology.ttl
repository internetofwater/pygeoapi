    skos:definition "Carlson Trophic State Index is a measurement of eutrophication based on Secchi depth" ;
    skos:historyNote "Originally from the CUAHSI HIS VariableNameCV.  See: http://his.cuahsi.org/mastercvreg/edit_cv11.aspx?tbl=VariableNameCV." ;
    skos:inScheme <http://vocabulary.odm2.org/variablename> ;
    skos:prefLabel "TSI" ;
    skos:topConceptOf <http://vocabulary.odm2.org/variablename> .

variablename:absorbance a skos:Concept ;
    skos:definition "The amount of radiation absorbed by a material" ;
    skos:historyNote "Originally from the CUAHSI HIS VariableNameCV.  See: http://his.cuahsi.org/mastercvreg/edit_cv11.aspx?tbl=VariableNameCV." ;
    skos:inScheme <http://vocabulary.odm2.org/variablename> ;
    skos:prefLabel "Absorbance" ;
    skos:topConceptOf <http://vocabulary.odm2.org/variablename> .

variablename:absorbanceUltraviolet a skos:Concept ;
    skos:definition "Absorbance of ultraviolet light at a specified wavelength, typically at 254 or 280 nm for water samples. Not normalized to DOC concentration like variables such as SUVA280." ;
    skos:exactMatch "https://en.wikipedia.org/wiki/Specific_ultraviolet_absorbance" ;
    skos:historyNote "Wikipedia" ;
    skos:inScheme <http://vocabulary.odm2.org/variablename> ;
    skos:note "Added to support Critical Zone Observatory (CZO) data use cases. " ;
    skos:prefLabel "Absorbance, ultraviolet" ;
    skos:topConceptOf <http://vocabulary.odm2.org/variablename> .

variablename:abundance a skos:Concept ;
    skos:definition "The relative representation of a species in a particular ecosystem. If this generic term is used, the publisher should specify/qualify the species, class, etc. being measured in the method, qualifier, or other appropriate field." ;
    skos:historyNote "Originally from the CUAHSI HIS VariableNameCV.  See: http://his.cuahsi.org/mastercvreg/edit_cv11.aspx?tbl=VariableNameCV." ;
    skos:inScheme <http://vocabulary.odm2.org/variablename> ;
    skos:prefLabel "Abundance" ;
    skos:topConceptOf <http://vocabulary.odm2.org/variablename> .

variablename:acetate a skos:Concept ;
    skos:definition "Acetate" ;
    skos:historyNote "Originally from the CUAHSI HIS VariableNameCV.  See: http://his.cuahsi.org/mastercvreg/edit_cv11.aspx?tbl=VariableNameCV." ;
    skos:inScheme <http://vocabulary.odm2.org/variablename> ;
    skos:prefLabel "Acetate" ;
    skos:topConceptOf <http://vocabulary.odm2.org/variablename> .

