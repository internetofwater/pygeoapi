quantitykind:RadiantEmmitance a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "Radiant Emmitance"@en, "Radiant Emmitance"@en;
  rdfs:comment "Applicable units are those of quantitykind:PowerPerArea", "Applicable units are those of quantitykind:PowerPerArea";
  dct:description "Irradiance and Radiant Emittance are radiometry terms for the power per unit area of electromagnetic radiation at a surface. \"Irradiance\" is used when the electromagnetic radiation is incident on the surface. \"Radiant emmitance\" (or \"radiant exitance\") is used when the radiation is emerging from the surface."^^qudt:LatexString,
    "Irradiance and Radiant Emittance are radiometry terms for the power per unit area of electromagnetic radiation at a surface. \"Irradiance\" is used when the electromagnetic radiation is incident on the surface. \"Radiant emmitance\" (or \"radiant exitance\") is used when the radiation is emerging from the surface."^^qudt:LatexString;
  skos:broader quantitykind:PowerPerArea, quantitykind:PowerPerArea;
  qudt:hasDimensionVector dimensionvector:A0E0L0I0M1H0T-3D0, dimensionvector:A0E0L0I0M1H0T-3D0;
  qudt:informativeReference "http://en.wikipedia.org/wiki/Irradiance"^^xsd:anyURI, "http://en.wikipedia.org/wiki/Irradiance"^^xsd:anyURI;
  qudt:plainTextDescription "Irradiance and Radiant Emittance are radiometry terms for the power per unit area of electromagnetic radiation at a surface. \"Irradiance\" is used when the electromagnetic radiation is incident on the surface. \"Radiant emmitance\" (or \"radiant exitance\") is used when the radiation is emerging from the surface.",
    "Irradiance and Radiant Emittance are radiometry terms for the power per unit area of electromagnetic radiation at a surface. \"Irradiance\" is used when the electromagnetic radiation is incident on the surface. \"Radiant emmitance\" (or \"radiant exitance\") is used when the radiation is emerging from the surface.";
  qudt:latexDefinition "$M = \\frac{d\\Phi}{dA}$, where $d\\Phi$ is the radiant flux leaving the element of the surface area $dA$."^^qudt:LatexString,
    "$M = \\frac{d\\Phi}{dA}$, where $d\\Phi$ is the radiant flux leaving the element of the surface area $dA$."^^qudt:LatexString;
