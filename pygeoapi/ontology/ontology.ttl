unit:MI-PER-HR a qudt:Unit ;
    rdfs:label "Mile per Hour"@en ;
    dct:description "Miles per hour is an imperial unit of speed expressing the number of statute miles covered in one hour. It is currently the standard unit used for speed limits, and to express speeds generally, on roads in the United Kingdom and the United States. A common abbreviation is mph or MPH."^^rdf:HTML ;
