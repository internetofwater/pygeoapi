unit:SCF a qudt:Unit, qudt:Unit;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/unit>, <http://qudt.org/vocab/unit>;
  rdfs:label "Standard Cubic Foot"@en, "Standard Cubic Foot"@en;
  dct:description """
The $\\textit{standard cubic foot}$ (scf) is a unit representing the amount of gas (such as natural gas) 
contained in a volume of one cubic foot at reference temperature and pressure conditions. As such, it is a measure of the actual amount of gas,
not the volume of the gas. The reference conditions for standard cubic foot are 60 degrees Fahrenheit and 14.7 pounds per square inch (psi) of pressure.
  """^^qudt:LatexString,
    """
The $\\textit{standard cubic foot}$ (scf) is a unit representing the amount of gas (such as natural gas) 
contained in a volume of one cubic foot at reference temperature and pressure conditions. As such, it is a measure of the actual amount of gas,
not the volume of the gas. The reference conditions for standard cubic foot are 60 degrees Fahrenheit and 14.7 pounds per square inch (psi) of pressure.
  """^^qudt:LatexString;
  qudt:conversionMultiplier 1.1981, 1.1981;
  qudt:conversionMultiplierSN 1.1981E0, 1.1981E0;
  qudt:hasDimensionVector dimensionvector:A1E0L0I0M0H0T0D0, dimensionvector:A1E0L0I0M0H0T0D0;
  qudt:hasQuantityKind quantitykind:AmountOfSubstance, quantitykind:AmountOfSubstance;
  qudt:informativeReference "https://en.wikipedia.org/wiki/Standard_cubic_foot"^^xsd:anyURI,
    "https://en.wikipedia.org/wiki/Standard_cubic_foot"^^xsd:anyURI;
  qudt:symbol "scf", "scf" .

