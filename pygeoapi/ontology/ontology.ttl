quantitykind:Acceleration a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "Beschleunigung"@de, "Beschleunigung"@de, "Pecutan"@ms, "Pecutan"@ms, "Zrychlení"@cs,
    "Zrychlení"@cs, "acceleratio"@la, "acceleratio"@la, "acceleration"@en, "acceleration"@en,
    "accelerazione"@it, "accelerazione"@it, "accelerație"@ro, "accelerație"@ro, "accélération"@fr,
    "accélération"@fr, "aceleración"@es, "aceleración"@es, "aceleração"@pt, "aceleração"@pt,
    "ivme"@tr, "ivme"@tr, "pospešek"@sl, "pospešek"@sl, "przyspieszenie"@pl, "przyspieszenie"@pl,
    "Όγκος"@el, "Όγκος"@el, "Ускоре́ние"@ru, "Ускоре́ние"@ru, "التسارع"@ar, "التسارع"@ar,
    "شتاب"@fa, "شتاب"@fa, "त्वरण"@hi, "त्वरण"@hi, "加速度"@ja, "加速度"@ja, "加速度"@zh, "加速度"@zh;
  rdfs:comment "Applicable units are those of quantitykind:Acceleration", "Applicable units are those of quantitykind:Acceleration";
  dct:description """
  $\\textit{Acceleration}$ is the (instantaneous) rate of change of velocity. 
  Acceleration may be either linear acceleration, or angular acceleration. 
  It is a vector quantity with dimension $length/time^{2}$ for linear acceleration,
   or in the case of angular acceleration, with dimension $angle/time^{2}$. 
  $$$$
  In SI units, linear acceleration is measured in $meters/second^{2}$ ($m \\cdot s^{-2}$),
   and angular acceleration is measured in $radians/second^{2}$. 
  $$$$
  In physics, any increase or decrease in speed is referred to as acceleration and similarly,
   motion in a circle at constant speed is also an acceleration, since the direction component of the velocity is changing.
  """^^qudt:LatexString,
    """
  $\\textit{Acceleration}$ is the (instantaneous) rate of change of velocity. 
  Acceleration may be either linear acceleration, or angular acceleration. 
  It is a vector quantity with dimension $length/time^{2}$ for linear acceleration,
   or in the case of angular acceleration, with dimension $angle/time^{2}$. 
  $$$$
  In SI units, linear acceleration is measured in $meters/second^{2}$ ($m \\cdot s^{-2}$),
   and angular acceleration is measured in $radians/second^{2}$. 
  $$$$
  In physics, any increase or decrease in speed is referred to as acceleration and similarly,
   motion in a circle at constant speed is also an acceleration, since the direction component of the velocity is changing.
  """^^qudt:LatexString;
  qudt:dbpediaMatch "http://dbpedia.org/resource/Acceleration"^^xsd:anyURI, "http://dbpedia.org/resource/Acceleration"^^xsd:anyURI;
  qudt:hasDimensionVector dimensionvector:A0E0L1I0M0H0T-2D0, dimensionvector:A0E0L1I0M0H0T-2D0;
  qudt:iec61360Code "0112/2///62720#UAD002", "0112/2///62720#UAD002";
  qudt:informativeReference "http://en.wikipedia.org/wiki/Acceleration"^^xsd:anyURI,
    "http://en.wikipedia.org/wiki/Acceleration"^^xsd:anyURI, "https://cdd.iec.ch/cdd/iec61987/iec61987.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD002"^^xsd:anyURI,
    "https://cdd.iec.ch/cdd/iec61987/iec61987.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD002"^^xsd:anyURI;
  qudt:siExactMatch <https://si-digital-framework.org/SI/quantities/ACCE>, <https://si-digital-framework.org/quantities/ACCE>;
  qudt:exactMatch quantitykind:LinearAcceleration, quantitykind:LinearAcceleration;
  qudt:applicableUnit unit:CentiM-PER-SEC2, unit:CentiM-PER-SEC2, unit:FT-PER-SEC2,
    unit:FT-PER-SEC2, unit:G, unit:G, unit:GALILEO, unit:GALILEO, unit:IN-PER-SEC2, unit:IN-PER-SEC2,
    unit:KN-PER-SEC, unit:KN-PER-SEC, unit:KiloM-PER-SEC2, unit:KiloM-PER-SEC2, unit:KiloPA-M2-PER-GM,
    unit:KiloPA-M2-PER-GM, unit:M-PER-SEC2, unit:M-PER-SEC2, unit:MI_US-PER-SEC2, unit:MI_US-PER-SEC2,
    unit:MicroG, unit:MicroG, unit:MilliG, unit:MilliG, unit:MilliGAL, unit:MilliGAL,
    unit:MilliM-PER-SEC2, unit:MilliM-PER-SEC2, unit:YD-PER-SEC2, unit:YD-PER-SEC2 .

