quantitykind:Weight a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "Ağırlık"@tr, "Ağırlık"@tr, "Berat"@ms, "Berat"@ms, "Gewicht"@de, "Gewicht"@de,
    "Siła ciężkości"@pl, "Siła ciężkości"@pl, "forza peso"@it, "forza peso"@it, "greutate"@ro,
    "greutate"@ro, "peso"@es, "peso"@es, "peso"@pt, "peso"@pt, "poids"@fr, "poids"@fr,
    "tíha"@cs, "tíha"@cs, "weight"@en, "weight"@en, "Вес"@ru, "Вес"@ru, "وزن"@ar, "وزن"@ar,
    "وزن"@fa, "وزن"@fa, "重さ"@ja, "重さ"@ja, "重量"@zh, "重量"@zh;
  rdfs:comment "Applicable units are those of quantitykind:Force", "Applicable units are those of quantitykind:Force";
  dct:description "The force with which a body is attracted toward an astronomical body.  Or, the product of the mass of a body and the acceleration acting on a body.  In a dynamic situation, the weight can be a multiple of that under resting conditions. Weight also varies on other planets in accordance with their gravity."^^qudt:LatexString,
    "The force with which a body is attracted toward an astronomical body.  Or, the product of the mass of a body and the acceleration acting on a body.  In a dynamic situation, the weight can be a multiple of that under resting conditions. Weight also varies on other planets in accordance with their gravity."^^qudt:LatexString;
  skos:broader quantitykind:Force, quantitykind:Force;
