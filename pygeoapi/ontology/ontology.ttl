unit:NUM-PER-HA a <http://qudt.org/schema/qudt/Unit>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/unit>;
  rdfs:label "Number per hectare"@en;
  dct:description "Count of an entity or phenomenon's occurrence in 10,000 times the SI unit area (square metre)."@en;
  <http://qudt.org/schema/qudt/conversionMultiplier> 0.0001;
  <http://qudt.org/schema/qudt/conversionMultiplierSN> 1.0E-4;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L-2I0M0H0T0D0>;
  <http://qudt.org/schema/qudt/hasQuantityKind> <http://qudt.org/vocab/quantitykind/ParticleFluence>;
  <http://qudt.org/schema/qudt/symbol> "#/ha";
  <http://qudt.org/schema/qudt/ucumCode> "/har"^^<http://qudt.org/schema/qudt/UCUMcs>,
    "{#}.har-1"^^<http://qudt.org/schema/qudt/UCUMcs>, "{#}/har"^^<http://qudt.org/schema/qudt/UCUMcs> .

<http://qudt.org/vocab/quantitykind/ParticleFluence> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Particle Fluence"@en;
  rdfs:comment "Applicable units are those of quantitykind:ParticleFluence";
  dct:description """
  The quantity kind $\\textit{Particle Fluence}$ is the total number of particles that
   intersect a unit area in a specific time interval of interest, and has units of $m^{-2}$
    (number of particles per meter squared).
  """^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L-2I0M0H0T0D0>;
  <http://qudt.org/schema/qudt/iec61360Code> "0112/2///62720#UAD133";
  <http://qudt.org/schema/qudt/informativeReference> "http://en.wikipedia.org/wiki/Fluence"^^xsd:anyURI,
    "https://cdd.iec.ch/cdd/iec61987/iec61987.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD133"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/isoNormativeReference> "http://www.iso.org/iso/catalogue_detail?csnumber=31895"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/plainTextDescription> "\"Particle Fluence\" is the total number of particles that intersect a unit area in a specific time interval of interest, and has units of /m2 (number of particles per meter squared).";
  <http://qudt.org/schema/qudt/latexSymbol> "$\\Phi$"^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/latexDefinition> "$\\Phi = \\frac{dN}{dA}$, where $dN$ describes the number of particles incident on a small spherical domain at a given point in space, and $dA$ describes the cross-sectional area of that domain."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/applicableUnit> unit:NUM-PER-HA, unit:NUM-PER-KiloM2,
    unit:NUM-PER-M2, unit:PER-M2, unit:PER-IN2, unit:PER-M-NanoM .

unit:NUM-PER-HA-YR a <http://qudt.org/schema/qudt/Unit>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/unit>;
  rdfs:label "Number per Hectare Year"@en;
  <http://qudt.org/schema/qudt/conversionMultiplier> 0.000000000003168808781402895;
  <http://qudt.org/schema/qudt/conversionMultiplierSN> 3.168808781402895E-12;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L-2I0M0H0T-1D0>;
  <http://qudt.org/schema/qudt/hasQuantityKind> <http://qudt.org/vocab/quantitykind/Flux>;
  <http://qudt.org/schema/qudt/symbol> "#/(ha·a)";
  <http://qudt.org/schema/qudt/ucumCode> "{#}.har-1.a-1"^^<http://qudt.org/schema/qudt/UCUMcs>;
  <http://qudt.org/schema/qudt/plainTextDescription> "number divided by the unit hectare and by the unit year" .

unit:NUM-PER-HR a <http://qudt.org/schema/qudt/Unit>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/unit>;
  rdfs:label "Number per hour"@en;
  <http://qudt.org/schema/qudt/conversionMultiplier> 0.0002777777777777777777777777777777778;
  <http://qudt.org/schema/qudt/conversionMultiplierSN> 2.777777777777777777777777777777778E-4;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T-1D0>;
  <http://qudt.org/schema/qudt/hasQuantityKind> <http://qudt.org/vocab/quantitykind/Frequency>,
    <http://qudt.org/vocab/quantitykind/CountRate>;
  <http://qudt.org/schema/qudt/symbol> "#/h";
  <http://qudt.org/schema/qudt/ucumCode> "/h"^^<http://qudt.org/schema/qudt/UCUMcs>,
