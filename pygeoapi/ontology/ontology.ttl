qudt:ContextualUnit a owl:Class;
  rdfs:subClassOf qudt:Unit, _:b1cb43fcbd504833bf8a964862c3127019311;
  rdfs:isDefinedBy <http://qudt.org/schema/qudt>;
  rdfs:label "Contextual Unit" .

qudt:DataItem a owl:Class;
  rdfs:subClassOf qudt:Concept, _:b1cb43fcbd504833bf8a964862c3127019319, _:b1cb43fcbd504833bf8a964862c3127019320;
  rdfs:isDefinedBy <http://qudt.org/schema/qudt>;
  rdfs:label "Data Item";
  dct:description """
  <p>A <em>Data Item</em> holds a value that maybe a scalar or structured datatype.
  <em>Quantity Value</em> specifies which case applies.
  </p>"""^^rdf:HTML .

qudt:scalingOf a owl:ObjectProperty;
  rdfs:isDefinedBy <http://qudt.org/schema/qudt>;
  rdfs:label "scalingOf";
  dct:description "This property relates a unit that is scaled to the base unit that its qudt:conversionMultiplier converts it to"^^rdf:HTML,
    "This property relates a unit to another unit it is scaled from"^^rdf:HTML .

qudt:hasFactorUnit a owl:ObjectProperty;
  rdfs:isDefinedBy <http://qudt.org/schema/qudt>;
  rdfs:label "hasFactorUnit";
  dct:description "This property relates a derived unit to one of its constituent factor units"^^rdf:HTML .

qudt:factorUnitScalar a owl:DatatypeProperty;
  rdfs:isDefinedBy <http://qudt.org/schema/qudt>;
  rdfs:label "factorUnitScalar";
  dct:description "For a derived unit that is not exactly the product of its factor units, this property defines the scalar with which that product has to be multiplied with."^^rdf:HTML .

qudt:exponent a owl:ObjectProperty;
  rdfs:isDefinedBy <http://qudt.org/schema/qudt>;
  rdfs:label "exponent";
  dct:description "This property relates a factor unit its exponent"^^rdf:HTML .

qudt:prefixMultiplierSN a owl:DatatypeProperty, owl:FunctionalProperty;
  rdfs:isDefinedBy <http://qudt.org/schema/qudt>;
  rdfs:label "prefix multiplier scientific";
  rdfs:range xsd:double .

unit:2PiRAD a qudt:Unit;
  rdfs:isDefinedBy <http://qudt.org/vocab/unit>;
  rdfs:label "2PiRAD";
  qudt:hasDimensionVector dimensionvector:A0E0L0I0M0H0T0D1;
  qudt:hasQuantityKind quantitykind:Angle, quantitykind:PlaneAngle;
  dct:isReplacedBy unit:REV;
  qudt:deprecated true .

unit:DA a qudt:Unit;
  rdfs:isDefinedBy <http://qudt.org/vocab/unit>;
  rdfs:label "Dalton"@en;
  dct:description "The unified atomic mass unit (symbol: $\\mu$) or dalton (symbol: Da) is a unit that is used for indicating mass on an atomic or molecular scale. It is defined as one twelfth of the rest mass of an unbound atom of carbon-12 in its nuclear and electronic ground state, and has a value of $1.660538782(83) \\times 10^{-27} kg$. One $Da$ is approximately equal to the mass of one proton or one neutron. The CIPM have categorised it as a \"non-SI unit whose values in SI units must be obtained experimentally\"."^^qudt:LatexString;
  skos:altLabel "atomic-mass-unit";
  qudt:applicableSystem <http://qudt.org/vocab/sou/CGS>;
  qudt:conversionMultiplier 0.00000000000000000000000000166053878283;
  qudt:conversionMultiplierSN 1.66053878283E-27;
  qudt:dbpediaMatch "http://dbpedia.org/resource/Dalton"^^xsd:anyURI;
  qudt:hasDimensionVector dimensionvector:A0E0L0I0M1H0T0D0;
  qudt:hasQuantityKind quantitykind:MolecularMass;
  qudt:informativeReference "http://en.wikipedia.org/wiki/Atomic_mass_unit"^^xsd:anyURI,
    "http://en.wikipedia.org/wiki/Dalton?oldid=495038954"^^xsd:anyURI;
  qudt:siExactMatch <https://si-digital-framework.org/SI/units/dalton>;
  qudt:symbol "Da";
  qudt:ucumCode "u"^^qudt:UCUMcs;
  qudt:uneceCommonCode "D43";
  qudt:exactMatch unit:AMU, unit:U .

unit:BBL_US_PET a qudt:Unit, qudt:ContextualUnit;
  rdfs:isDefinedBy <http://qudt.org/vocab/unit>;
  rdfs:label "Barrel (US Petroleum)"@en;
  dct:description "unit of the volume barrel (US petroleum) for crude oil according to the Anglo-American system of units"^^rdf:HTML;
  skos:broader unit:BBL_US;
  qudt:applicableSystem <http://qudt.org/vocab/sou/USCS>;
  qudt:conversionMultiplier 0.1589873;
  qudt:conversionMultiplierSN 1.589873E-1;
  qudt:hasDimensionVector dimensionvector:A0E0L3I0M0H0T0D0;
  qudt:hasQuantityKind quantitykind:LiquidVolume;
  qudt:symbol "bbl{US petroleum}";
  qudt:ucumCode "[bbl_us]"^^qudt:UCUMcs;
  qudt:plainTextDescription "unit of the volume barrel (US petroleum) for crude oil according to the Anglo-American system of units" .

unit:NUM-PER-MIN a qudt:Unit, qudt:DerivedUnit;
  rdfs:isDefinedBy <http://qudt.org/vocab/unit>;
