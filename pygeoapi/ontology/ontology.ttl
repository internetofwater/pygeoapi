  <http://qudt.org/schema/qudt/iec61360Code> "0112/2///62720#UAA060";
  <http://qudt.org/schema/qudt/informativeReference> "https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAA060"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/symbol> "μC/m²";
