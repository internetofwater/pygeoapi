unit:V_Ab a qudt:Unit, qudt:Unit;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/unit>, <http://qudt.org/vocab/unit>;
  rdfs:label "Abvolt"@en, "Abvolt"@en;
  dct:description "A unit of electrical potential equal to one hundred millionth of a volt ($10^{-8}\\,volts$), used in the centimeter-gram-second (CGS) system of units. One abV is the potential difference that exists between two points when the work done to transfer one abcoulomb of charge between them equals: $1\\,erg\\cdot\\,1\\,abV\\,=\\,10\\,nV$."^^qudt:LatexString,
    "A unit of electrical potential equal to one hundred millionth of a volt ($10^{-8}\\,volts$), used in the centimeter-gram-second (CGS) system of units. One abV is the potential difference that exists between two points when the work done to transfer one abcoulomb of charge between them equals: $1\\,erg\\cdot\\,1\\,abV\\,=\\,10\\,nV$."^^qudt:LatexString;
  qudt:applicableSystem <http://qudt.org/vocab/sou/CGS-EMU>, <http://qudt.org/vocab/sou/CGS-EMU>,
    <http://qudt.org/vocab/sou/CGS>, <http://qudt.org/vocab/sou/CGS>;
  qudt:conversionMultiplier 0.00000001, 0.00000001;
  qudt:conversionMultiplierSN 1.0E-8, 1.0E-8;
  qudt:dbpediaMatch "http://dbpedia.org/resource/Abvolt"^^xsd:anyURI, "http://dbpedia.org/resource/Abvolt"^^xsd:anyURI;
  qudt:hasDimensionVector dimensionvector:A0E-1L2I0M1H0T-3D0, dimensionvector:A0E-1L2I0M1H0T-3D0;
  qudt:hasQuantityKind quantitykind:ElectricPotential, quantitykind:ElectricPotential,
    quantitykind:ElectricPotentialDifference, quantitykind:ElectricPotentialDifference,
    quantitykind:EnergyPerElectricCharge, quantitykind:EnergyPerElectricCharge, quantitykind:Voltage,
    quantitykind:Voltage;
  qudt:informativeReference "http://en.wikipedia.org/wiki/Abvolt?oldid=477198646"^^xsd:anyURI,
    "http://en.wikipedia.org/wiki/Abvolt?oldid=477198646"^^xsd:anyURI, "http://www.lexic.us/definition-of/abvolt"^^xsd:anyURI,
    "http://www.lexic.us/definition-of/abvolt"^^xsd:anyURI, "http://www.oxfordreference.com/view/10.1093/acref/9780198605225.001.0001/acref-9780198605225-e-27"^^xsd:anyURI,
    "http://www.oxfordreference.com/view/10.1093/acref/acref-9780198605225-e-27"^^xsd:anyURI;
  qudt:omUnit <http://www.ontology-of-units-of-measure.org/resource/om-2/abvolt>, <http://www.ontology-of-units-of-measure.org/resource/om-2/abvolt>;
  qudt:symbol "abV", "abV";
