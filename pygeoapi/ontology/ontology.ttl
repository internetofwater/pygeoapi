unit:ST a qudt:Unit, qudt:Unit, qudt:DerivedUnit, qudt:DerivedUnit;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/unit>, <http://qudt.org/vocab/unit>;
  rdfs:label "Stokes"@en, "Stokes"@en;
  dct:description "$\\textit{Stokes (St)}$ is a unit in the category of Kinematic viscosity. This unit is commonly used in the cgs unit system. Stokes (St) has a dimension of $L^2T^{-1}$ where $L$ is length, and $T$ is time. It can be converted to the corresponding standard SI unit $m^2/s$ by multiplying its value by a factor of 0.0001."^^qudt:LatexString,
    "$\\textit{Stokes (St)}$ is a unit in the category of Kinematic viscosity. This unit is commonly used in the cgs unit system. Stokes (St) has a dimension of $L^2T^{-1}$ where $L$ is length, and $T$ is time. It can be converted to the corresponding standard SI unit $m^2/s$ by multiplying its value by a factor of 0.0001."^^qudt:LatexString;
