<http://qudt.org/vocab/quantitykind/PressureGradient> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "pressure gradient", "pressure gradient"@en-US;
