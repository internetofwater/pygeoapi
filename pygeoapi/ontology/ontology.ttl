        "gigavolt" ;
    dct:description "1,000,000,000-fold of the SI derived unit volt" ;
    qudt:conversionMultiplier 1000000000.0 ;
    qudt:conversionMultiplierSN 1e+09 ;
    qudt:hasDimensionVector dimensionvector:A0E-1L2I0M1H0T-3D0 ;
    qudt:hasQuantityKind quantitykind:ElectricPotential,
