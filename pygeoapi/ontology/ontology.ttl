quantitykind:Permittivity a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "Permittivity"@en, "Permittivity"@en;
  rdfs:comment "Applicable units are those of quantitykind:Permittivity", "Applicable units are those of quantitykind:Permittivity";
  dct:description "\"Permittivity\" is a physical quantity that describes how an electric field affects, and is affected by a dielectric medium, and is determined by the ability of a material to polarize in response to the field, and thereby reduce the total electric field inside the material.  Permittivity is often a scalar valued quantity, however in the general case it is tensor-valued."^^qudt:LatexString,
    "\"Permittivity\" is a physical quantity that describes how an electric field affects, and is affected by a dielectric medium, and is determined by the ability of a material to polarize in response to the field, and thereby reduce the total electric field inside the material.  Permittivity is often a scalar valued quantity, however in the general case it is tensor-valued."^^qudt:LatexString;
  qudt:dbpediaMatch "http://dbpedia.org/resource/Permittivity"^^xsd:anyURI, "http://dbpedia.org/resource/Permittivity"^^xsd:anyURI;
  qudt:hasDimensionVector dimensionvector:A0E2L-3I0M-1H0T4D0, dimensionvector:A0E2L-3I0M-1H0T4D0;
  qudt:iec61360Code "0112/2///62720#UAD136", "0112/2///62720#UAD136";
  qudt:informativeReference "http://www.iso.org/iso/home/store/catalogue_tc/catalogue_detail.htm?csnumber=31891"^^xsd:anyURI,
    "http://www.iso.org/iso/home/store/catalogue_tc/catalogue_detail.htm?csnumber=31891"^^xsd:anyURI,
    "http://en.wikipedia.org/wiki/Permittivity?oldid=494094133"^^xsd:anyURI, "http://en.wikipedia.org/wiki/Permittivity?oldid=494094133"^^xsd:anyURI,
    "http://maxwells-equations.com/materials/permittivity.php"^^xsd:anyURI, "http://maxwells-equations.com/materials/permittivity.php"^^xsd:anyURI,
    "https://cdd.iec.ch/cdd/iec61987/iec61987.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD136"^^xsd:anyURI,
    "https://cdd.iec.ch/cdd/iec61987/iec61987.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD136"^^xsd:anyURI;
  qudt:siExactMatch <https://si-digital-framework.org/SI/quantities/PRMI>, <https://si-digital-framework.org/quantities/PRMI>;
  qudt:plainTextDescription "\"Permittivity\" is a physical quantity that describes how an electric field affects, and is affected by a dielectric medium, and is determined by the ability of a material to polarize in response to the field, and thereby reduce the total electric field inside the material.  Permittivity is often a scalar valued quantity, however in the general case it is tensor-valued.",
    "\"Permittivity\" is a physical quantity that describes how an electric field affects, and is affected by a dielectric medium, and is determined by the ability of a material to polarize in response to the field, and thereby reduce the total electric field inside the material.  Permittivity is often a scalar valued quantity, however in the general case it is tensor-valued.";
  qudt:latexSymbol "$\\epsilon$"^^qudt:LatexString, "$\\epsilon$"^^qudt:LatexString;
  qudt:latexDefinition "$\\epsilon = \\frac{D}{E}$, where $D$ is electric flux density and $E$ is electric field strength."^^qudt:LatexString,
    "$\\epsilon = \\frac{D}{E}$, where $D$ is electric flux density and $E$ is electric field strength."^^qudt:LatexString;
  qudt:applicableUnit unit:FARAD-PER-KiloM, unit:FARAD-PER-KiloM, unit:FARAD-PER-M,
