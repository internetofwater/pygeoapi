    qudt:iec61360Code "0112/2///62720#UAD157" ;
    qudt:informativeReference "https://cdd.iec.ch/cdd/iec61987/iec61987.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD157"^^xsd:anyURI ;
    rdfs:comment "Applicable units are those of quantitykind:InverseMass" ;
    rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>,
        <http://qudt.org/vocab/quantitykind> .

quantitykind:InversePressure a qudt:QuantityKind ;
    rdfs:label "Inverse Pressure"@en ;
    qudt:applicableUnit unit:PER-BAR,
        unit:PER-MILLE-PSI,
        unit:PER-MegaPA,
        unit:PER-PA,
        unit:PER-PSI ;
    qudt:exactMatch quantitykind:IsothermalCompressibility ;
    qudt:hasDimensionVector dimensionvector:A0E0L1I0M-1H0T2D0 ;
