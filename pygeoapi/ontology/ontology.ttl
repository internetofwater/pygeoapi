    "s-1.m-2.sr-1"^^<http://qudt.org/schema/qudt/UCUMcs>;
  <http://qudt.org/schema/qudt/uneceCommonCode> "D2";
  <http://qudt.org/schema/qudt/expression> "$/sec-m^2-sr$"^^<http://qudt.org/schema/qudt/LatexString> .

<http://qudt.org/vocab/quantitykind/PhotonRadiance> a <http://qudt.org/schema/qudt/QuantityKind>;
