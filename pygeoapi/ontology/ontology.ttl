unit:TON_Assay a qudt:Unit, qudt:Unit;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/unit>, <http://qudt.org/vocab/unit>;
  rdfs:label "Assay Ton"@en, "Assay Ton"@en;
  dct:description "In the United States, a unit of mass, approximately $29.167\\, grams$. The number of milligrams of precious metal in one assay ton of the ore being tested is equal to the number of troy ounces of pure precious metal in one 2000-pound ton of the ore. i.e. a bead is obtained that weights 3 milligrams, thus the precious metals in the bead would equal three troy ounces to each ton of ore with the understanding that this varies considerably in the real world as the amount of precious values in each ton of ore varies considerably."^^qudt:LatexString,
    "In the United States, a unit of mass, approximately $29.167\\, grams$. The number of milligrams of precious metal in one assay ton of the ore being tested is equal to the number of troy ounces of pure precious metal in one 2000-pound ton of the ore. i.e. a bead is obtained that weights 3 milligrams, thus the precious metals in the bead would equal three troy ounces to each ton of ore with the understanding that this varies considerably in the real world as the amount of precious values in each ton of ore varies considerably."^^qudt:LatexString;
  qudt:applicableSystem <http://qudt.org/vocab/sou/SI>, <http://qudt.org/vocab/sou/SI>;
  qudt:conversionMultiplier 0.02916667, 0.02916667;
  qudt:conversionMultiplierSN 2.916667E-2, 2.916667E-2;
  qudt:hasDimensionVector dimensionvector:A0E0L0I0M1H0T0D0, dimensionvector:A0E0L0I0M1H0T0D0;
  qudt:hasQuantityKind quantitykind:Mass, quantitykind:Mass;
  qudt:iec61360Code "0112/2///62720#UAB234", "0112/2///62720#UAB234";
