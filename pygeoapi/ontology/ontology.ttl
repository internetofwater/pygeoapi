variablename:DNADamageOliveDailMoment a skos:Concept ;
    skos:definition "In a single cell gel electrophoresis assay (comet assay), olive tail moment is the product of the percentage of DNA in the tail and the distance between the intesity centroids of the head and tail along the x-axis (Olive, et al., 1990)" ;
    skos:historyNote "Originally from the CUAHSI HIS VariableNameCV.  See: http://his.cuahsi.org/mastercvreg/edit_cv11.aspx?tbl=VariableNameCV." ;
    skos:inScheme <http://vocabulary.odm2.org/variablename> ;
    skos:prefLabel "DNA damage, olive tail moment" ;
    skos:topConceptOf <http://vocabulary.odm2.org/variablename> .

variablename:DNADamagePercentTailDNA a skos:Concept ;
    skos:definition "In a single cell gel electrophoresis assay (comet assay), percent tail DNA is the ratio of fluorescent intensity of the tail over the total fluorescent intensity of the head (nuclear core) and tail multiplied by 100." ;
    skos:historyNote "Originally from the CUAHSI HIS VariableNameCV.  See: http://his.cuahsi.org/mastercvreg/edit_cv11.aspx?tbl=VariableNameCV." ;
    skos:inScheme <http://vocabulary.odm2.org/variablename> ;
    skos:prefLabel "DNA damage, percent tail DNA" ;
    skos:topConceptOf <http://vocabulary.odm2.org/variablename> .

variablename:DNADamageTailLength a skos:Concept ;
    skos:definition "In a single cell gel electrophoresis assay (comet assay), tail length is the distance of DNA migration from the body of the nuclear core" ;
    skos:historyNote "Originally from the CUAHSI HIS VariableNameCV.  See: http://his.cuahsi.org/mastercvreg/edit_cv11.aspx?tbl=VariableNameCV." ;
    skos:inScheme <http://vocabulary.odm2.org/variablename> ;
    skos:prefLabel "DNA damage, tail length" ;
    skos:topConceptOf <http://vocabulary.odm2.org/variablename> .

