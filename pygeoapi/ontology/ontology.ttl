quantitykind:MolecularConcentration a qudt:QuantityKind ;
    rdfs:label "Molecular Concentration"@en ;
    dct:description "The \"Molecular Concentration\" of substance B  is defined as the number of molecules of B  divided by the volume of the mixture "^^qudt:LatexString ;
    qudt:abbreviation "m^{-3}" ;
    qudt:applicableUnit unit:NUM-PER-L,
        unit:NUM-PER-M3,
        unit:NUM-PER-MicroL,
