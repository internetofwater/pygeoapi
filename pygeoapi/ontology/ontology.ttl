  skos:topConceptOf <http://vocabulary.odm2.org/variablename>;
  skos:prefLabel "Phosphorus, organic";
  skos:historyNote "Originally from the CUAHSI HIS VariableNameCV.  See: http://his.cuahsi.org/mastercvreg/edit_cv11.aspx?tbl=VariableNameCV." .

variablename:carbonSuspendedInorganic a skos:Concept;
  skos:definition "Suspended Inorganic Carbon";
  skos:topConceptOf <http://vocabulary.odm2.org/variablename>;
  skos:prefLabel "Carbon, suspended inorganic";
  skos:historyNote "Originally from the CUAHSI HIS VariableNameCV.  See: http://his.cuahsi.org/mastercvreg/edit_cv11.aspx?tbl=VariableNameCV." .

variablename:tideStage a skos:Concept;
  skos:definition "Tidal stage";
  skos:topConceptOf <http://vocabulary.odm2.org/variablename>;
  skos:prefLabel "Tide stage";
  skos:historyNote "Originally from the CUAHSI HIS VariableNameCV.  See: http://his.cuahsi.org/mastercvreg/edit_cv11.aspx?tbl=VariableNameCV." .

variablename:timeStamp a skos:Concept;
  skos:definition "The time at which a sensor produces output";
  skos:topConceptOf <http://vocabulary.odm2.org/variablename>;
  skos:prefLabel "Time Stamp";
  skos:historyNote "Originally from the CUAHSI HIS VariableNameCV.  See: http://his.cuahsi.org/mastercvreg/edit_cv11.aspx?tbl=VariableNameCV." .

variablename:nitrogen_15_StableIsotopeRatioDelta a skos:Concept;
  skos:definition "Difference in the 15N:14N ratio between the sample and standard (del N 15)";
  skos:topConceptOf <http://vocabulary.odm2.org/variablename>;
  skos:prefLabel "Nitrogen-15, stable isotope ratio delta";
  skos:historyNote "Originally from the CUAHSI HIS VariableNameCV.  See: http://his.cuahsi.org/mastercvreg/edit_cv11.aspx?tbl=VariableNameCV." .

variablename:rechargeGroundwater a skos:Concept;
  skos:definition "Groundwater recharge or deep drainage or deep percolation is a hydrologic process where water moves downward from surface water to groundwater. Recharge is the primary method through which water enters an aquifer. This process usually occurs in the vadose zone below plant roots and is often expressed as a flux to the water table surface. Recharge occurs both naturally (through the water cycle) and through anthropogenic processes (i.e., \"artificial groundwater recharge\"), where rainwater and or reclaimed water is routed to the subsurface.";
  skos:topConceptOf <http://vocabulary.odm2.org/variablename>;
  skos:prefLabel "Recharge, groundwater ";
  skos:note "Added to support Critical Zone Observatory (CZO) data use cases. ";
  skos:historyNote "Wikipedia";
  skos:exactMatch "https://en.wikipedia.org/wiki/Groundwater_recharge" .

variablename:baseSaturation a skos:Concept;
  skos:definition "Percent base saturation (BS) is the percentage of the Cation Exchange Capacity (CEC) occupied by the basic cations Ca2+, Mg2+ and K+.";
  skos:topConceptOf <http://vocabulary.odm2.org/variablename>;
  skos:prefLabel "Base saturation";
  skos:note "Added to support Critical Zone Observatory (CZO) data use cases. ";
  skos:exactMatch "http://extension.uga.edu/publications/detail.html?number=C1040&title=Cation+Exchange+Capacity+and+Base+Saturation" .

variablename:seleniumDissolved a skos:Concept;
  skos:definition "Dissolved selenium (Se). For chemical terms, dissolved indicates a filtered sample.";
  skos:topConceptOf <http://vocabulary.odm2.org/variablename>;
  skos:prefLabel "Selenium, dissolved";
  skos:historyNote "Originally from the CUAHSI HIS VariableNameCV.  See: http://his.cuahsi.org/mastercvreg/edit_cv11.aspx?tbl=VariableNameCV." .

variablename:biomassAboveGround a skos:Concept;
  skos:definition "The biomass is the mass of living biological organisms in a given area or ecosystem at a given time on or above the surface of the ground";
  skos:topConceptOf <http://vocabulary.odm2.org/variablename>;
  skos:prefLabel "Biomass, above-ground";
  skos:note "Added to support Critical Zone Observatory (CZO) data use cases. ";
  skos:historyNote "Wikipedia";
  skos:exactMatch "https://en.wiktionary.org/wiki/aboveground https://en.wikipedia.org/wiki/Biomass_(ecology)" .

variablename:wellheadPressure a skos:Concept;
  skos:definition "The pressure exerted by the fluid at the wellhead or casinghead after the well has been shut off for a period of time, typically 24 hours";
  skos:topConceptOf <http://vocabulary.odm2.org/variablename>;
  skos:prefLabel "Wellhead pressure";
