  <http://qudt.org/schema/qudt/uneceCommonCode> "A8";
  <http://qudt.org/schema/qudt/plainTextDescription> "product out of the SI base unit ampere and the SI base unit second" .

unit:A-SEC2 a <http://qudt.org/schema/qudt/Unit>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/unit>;
  rdfs:label "ampere per square second";
  dct:description "product out of the power of the SI base unit ampere and the SI base unit second with the exponent 2";
  <http://qudt.org/schema/qudt/conversionMultiplier> 1.0;
  <http://qudt.org/schema/qudt/conversionMultiplierSN> 1.0E0;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E1L0I0M0H0T2D0>;
  <http://qudt.org/schema/qudt/hasQuantityKind> <http://qudt.org/vocab/quantitykind/Unknown>;
  <http://qudt.org/schema/qudt/symbol> "A·s²";
  <http://qudt.org/schema/qudt/ucumCode> "A.s2"^^<http://qudt.org/schema/qudt/UCUMcs> .

<http://qudt.org/vocab/dimensionvector/A0E1L0I0M0H0T2D0> a <http://qudt.org/schema/qudt/QuantityKindDimensionVector_SI>,
    <http://qudt.org/schema/qudt/QuantityKindDimensionVector_ISO>, <http://qudt.org/schema/qudt/QuantityKindDimensionVector_Imperial>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/dimensionvector>;
  rdfs:label "A0E1L0I0M0H0T2D0";
  <http://qudt.org/schema/qudt/latexDefinition> "$T^2 I$"^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/dimensionExponentForAmountOfSubstance> 0;
  <http://qudt.org/schema/qudt/dimensionExponentForElectricCurrent> 1;
  <http://qudt.org/schema/qudt/dimensionExponentForLength> 0;
  <http://qudt.org/schema/qudt/dimensionExponentForLuminousIntensity> 0;
  <http://qudt.org/schema/qudt/dimensionExponentForMass> 0;
  <http://qudt.org/schema/qudt/dimensionExponentForThermodynamicTemperature> 0;
  <http://qudt.org/schema/qudt/dimensionExponentForTime> 2;
  <http://qudt.org/schema/qudt/dimensionlessExponent> 0 .

unit:A2-SEC a <http://qudt.org/schema/qudt/Unit>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/unit>;
  rdfs:label "ampere squared second";
  dct:description "product out of the power of the SI base unit ampere with the exponent 2 and the SI base unit second";
  <http://qudt.org/schema/qudt/conversionMultiplier> 1.0;
  <http://qudt.org/schema/qudt/conversionMultiplierSN> 1.0E0;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E2L0I0M0H0T1D0>;
