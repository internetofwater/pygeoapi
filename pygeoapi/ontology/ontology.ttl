unit:A a qudt:Unit, qudt:Unit;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/unit>, <http://qudt.org/vocab/unit>;
  rdfs:label "Ampere"@de, "Ampere"@de, "amper"@hu, "amper"@hu, "amper"@pl, "amper"@pl,
    "amper"@ro, "amper"@ro, "amper"@sl, "amper"@sl, "amper"@tr, "amper"@tr, "ampere"@en,
    "ampere"@en, "ampere"@it, "ampere"@it, "ampere"@ms, "ampere"@ms, "ampere"@pt, "ampere"@pt,
    "amperio"@es, "amperio"@es, "amperium"@la, "amperium"@la, "ampère"@fr, "ampère"@fr,
    "ampér"@cs, "ampér"@cs, "αμπέρ"@el, "αμπέρ"@el, "ампер"@bg, "ампер"@bg, "ампер"@ru,
    "ампер"@ru, "אמפר"@he, "אמפר"@he, "آمپر"@fa, "آمپر"@fa, "أمبير"@ar, "أمبير"@ar, "एम्पीयर"@hi,
    "एम्पीयर"@hi, "アンペア"@ja, "アンペア"@ja, "安培"@zh, "安培"@zh;
  dct:description """$\\textit{Ampere}$, often shortened to $\\text{amp}$, 
is the SI unit of electric current and is one of the seven SI base units defined as:

$$\\text{A} \\equiv \\frac{\\textit{C}}{\\textit{s}} 
\\equiv \\frac{\\textit{coulomb}}{\\textit{second}} 
\\equiv \\frac{\\text{joule}}{\\text{weber}}$$

Note that SI supports only the use of symbols and deprecates the use of any abbreviations for units.
"""^^qudt:LatexString,
    """$\\textit{Ampere}$, often shortened to $\\text{amp}$, 
is the SI unit of electric current and is one of the seven SI base units defined as:

$$\\text{A} \\equiv \\frac{\\textit{C}}{\\textit{s}} 
\\equiv \\frac{\\textit{coulomb}}{\\textit{second}} 
\\equiv \\frac{\\text{joule}}{\\text{weber}}$$

Note that SI supports only the use of symbols and deprecates the use of any abbreviations for units.
"""^^qudt:LatexString;
  skos:altLabel "amp", "amp";
  qudt:applicableSystem <http://qudt.org/vocab/sou/CGS-EMU>, <http://qudt.org/vocab/sou/CGS-EMU>,
    <http://qudt.org/vocab/sou/CGS-GAUSS>, <http://qudt.org/vocab/sou/CGS-GAUSS>, <http://qudt.org/vocab/sou/PLANCK>,
    <http://qudt.org/vocab/sou/PLANCK>, <http://qudt.org/vocab/sou/SI>, <http://qudt.org/vocab/sou/SI>;
  qudt:conversionMultiplier 1.0, 1.0;
  qudt:conversionMultiplierSN 1.0E0, 1.0E0;
  qudt:dbpediaMatch "http://dbpedia.org/resource/Ampere"^^xsd:anyURI, "http://dbpedia.org/resource/Ampere"^^xsd:anyURI;
  qudt:hasDimensionVector dimensionvector:A0E1L0I0M0H0T0D0, dimensionvector:A0E1L0I0M0H0T0D0;
  qudt:hasQuantityKind quantitykind:CurrentLinkage, quantitykind:CurrentLinkage, quantitykind:DisplacementCurrent,
    quantitykind:DisplacementCurrent, quantitykind:ElectricCurrent, quantitykind:ElectricCurrent,
    quantitykind:ElectricCurrentPhasor, quantitykind:ElectricCurrentPhasor, quantitykind:MagneticTension,
    quantitykind:MagneticTension, quantitykind:MagnetomotiveForce, quantitykind:MagnetomotiveForce,
    quantitykind:TotalCurrent, quantitykind:TotalCurrent;
  qudt:iec61360Code "0112/2///62720#UAA101", "0112/2///62720#UAA101", "0112/2///62720#UAD717";
  qudt:informativeReference "http://en.wikipedia.org/wiki/Ampere?oldid=494026699"^^xsd:anyURI,
    "http://en.wikipedia.org/wiki/Ampere?oldid=494026699"^^xsd:anyURI, "https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAA101"^^xsd:anyURI,
    "https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAA101"^^xsd:anyURI,
    "https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAD717"^^xsd:anyURI;
  qudt:omUnit <http://www.ontology-of-units-of-measure.org/resource/om-2/ampere>, <http://www.ontology-of-units-of-measure.org/resource/om-2/ampere>;
  qudt:siExactMatch <https://si-digital-framework.org/SI/units/ampere>, <https://si-digital-framework.org/SI/units/ampere>;
  qudt:symbol "A", "A";
  qudt:ucumCode "A"^^qudt:UCUMcs, "A"^^qudt:UCUMcs;
