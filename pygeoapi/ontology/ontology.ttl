unit:H a <http://qudt.org/schema/qudt/Unit>, <http://qudt.org/schema/qudt/DerivedUnit>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/unit>;
  rdfs:label "Henry"@de, "henr"@pl, "henrio"@es, "henrium"@la, "henry"@cs, "henry"@en,
    "henry"@fr, "henry"@hu, "henry"@it, "henry"@ms, "henry"@pt, "henry"@ro, "henry"@sl,
    "henry"@tr, "χένρι"@el, "генри"@ru, "хенри"@bg, "הנרי"@he, "هنري"@ar, "هنری"@fa, "हेनरी"@hi,
    "ヘンリー"@ja, "亨利"@zh;
  dct:description """
  The unit $\\textit{Henry}$ is the SI unit of electric inductance. 
  A changing magnetic field induces an electric current in a loop of wire (or in a coil of many loops) located in the field. 
  Although the induced voltage depends only on the rate at which the magnetic flux changes, measured in webers per second, the amount of the current depends also on the physical properties of the coil. 
  A coil with an inductance of one henry requires a flux of one weber for each ampere of induced current. 
  If, on the other hand, it is the current which changes, then the induced field will generate a potential difference within the coil: 
  if the inductance is one henry a current change of one ampere per second generates a potential difference of one volt. 
  The henry is a large unit; inductances in practical circuits are measured in millihenrys (mH) or microhenrys (u03bc H). 
  The unit is named for the American physicist Joseph Henry (1797-1878), one of several scientists who discovered independently how magnetic fields can be used to generate alternating currents. 

  A $\\textit{Henry}$ is defined as:

  $$\\text{H} \\; \\equiv \\; \\text{henry}\\; \\equiv\\; \\frac{\\text{Wb}}{\\text{A}}\\; \\equiv\\; \\frac{\\text{weber}}{\\text{amp}}\\; \\equiv\\ \\frac{\\text{V}\\cdot\\text{s}}{\\text{A}}\\; \\equiv\\; \\frac{\\text{volt} \\cdot \\text{second}}{\\text{amp}}\\; \\equiv\\ \\Omega\\cdot\\text{s}\\; \\equiv\\; \\text{ohm.second}$$
  """^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/applicableSystem> <http://qudt.org/vocab/sou/CGS-EMU>,
    <http://qudt.org/vocab/sou/CGS-GAUSS>, <http://qudt.org/vocab/sou/SI>;
  <http://qudt.org/schema/qudt/conversionMultiplier> 1.0;
  <http://qudt.org/schema/qudt/conversionMultiplierSN> 1.0E0;
  <http://qudt.org/schema/qudt/dbpediaMatch> "http://dbpedia.org/resource/Henry"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E-2L2I0M1H0T-2D0>;
  <http://qudt.org/schema/qudt/hasQuantityKind> <http://qudt.org/vocab/quantitykind/Inductance>;
  <http://qudt.org/schema/qudt/iec61360Code> "0112/2///62720#UAA165";
  <http://qudt.org/schema/qudt/informativeReference> "http://en.wikipedia.org/wiki/Henry?oldid=491435978"^^xsd:anyURI,
    "https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAA165"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/omUnit> <http://www.ontology-of-units-of-measure.org/resource/om-2/henry>;
  <http://qudt.org/schema/qudt/siExactMatch> <https://si-digital-framework.org/SI/units/henry>;
  <http://qudt.org/schema/qudt/symbol> "H";
  <http://qudt.org/schema/qudt/ucumCode> "H"^^<http://qudt.org/schema/qudt/UCUMcs>;
  <http://qudt.org/schema/qudt/uneceCommonCode> "81";
  <http://qudt.org/schema/qudt/derivedCoherentUnitOfSystem> <http://qudt.org/vocab/sou/SI>;
  <http://qudt.org/schema/qudt/definedUnitOfSystem> <http://qudt.org/vocab/sou/SI>;
  <http://qudt.org/schema/qudt/siUnitsExpression> "Wb/A" .

<http://qudt.org/vocab/dimensionvector/A0E-2L2I0M1H0T-2D0> a <http://qudt.org/schema/qudt/QuantityKindDimensionVector_SI>,
    <http://qudt.org/schema/qudt/QuantityKindDimensionVector_ISO>, <http://qudt.org/schema/qudt/QuantityKindDimensionVector_Imperial>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/dimensionvector>;
  rdfs:label "A0E-2L2I0M1H0T-2D0";
  <http://qudt.org/schema/qudt/latexDefinition> "$L^2 M T^-2 I^-2$"^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/hasReferenceQuantityKind> <http://qudt.org/vocab/quantitykind/Inductance>;
  <http://qudt.org/schema/qudt/dimensionExponentForAmountOfSubstance> 0;
  <http://qudt.org/schema/qudt/dimensionExponentForElectricCurrent> -2;
  <http://qudt.org/schema/qudt/dimensionExponentForLength> 2;
  <http://qudt.org/schema/qudt/dimensionExponentForLuminousIntensity> 0;
  <http://qudt.org/schema/qudt/dimensionExponentForMass> 1;
  <http://qudt.org/schema/qudt/dimensionExponentForThermodynamicTemperature> 0;
  <http://qudt.org/schema/qudt/dimensionExponentForTime> -2;
  <http://qudt.org/schema/qudt/dimensionlessExponent> 0 .

<http://qudt.org/vocab/quantitykind/Inductance> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:seeAlso <http://qudt.org/vocab/quantitykind/MutualInductance>;
  rdfs:label "Inductance électrique"@fr, "Indukstans"@ms, "Induktivität"@de, "Indukčnost"@cs,
    "inductance"@en, "inductancia"@es, "inductantia"@la, "inductanță"@ro, "indukcyjność"@pl,
    "induktivitás"@hu, "induktivnost"@sl, "induttanza"@it, "indutância"@pt, "İndüktans"@tr,
    "Индуктивност"@bg, "Индуктивность"@ru, "השראות"@he, "القاوری"@fa, "المحاثة (التحريض)"@ar,
    "प्रेरकत्व"@hi, "インダクタンス・誘導係数"@ja, "电感"@zh;
  rdfs:comment "Applicable units are those of quantitykind:Inductance";
  dct:description "\"Inductance\" is an electromagentic quantity that characterizes a circuit's resistance to any change of electric current; a change in the electric current through induces an opposing electromotive force (EMF). Quantitatively, inductance is proportional to the magnetic flux per unit of electric current."^^<http://qudt.org/schema/qudt/LatexString>;
  skos:altLabel "Induktiviti"@ms, "inductivity"@en;
  <http://qudt.org/schema/qudt/dbpediaMatch> "http://dbpedia.org/resource/Inductance"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E-2L2I0M1H0T-2D0>;
  <http://qudt.org/schema/qudt/iec61360Code> "0112/2///62720#UAD065";
  <http://qudt.org/schema/qudt/informativeReference> "http://www.iso.org/iso/home/store/catalogue_tc/catalogue_detail.htm?csnumber=31891"^^xsd:anyURI,
    "http://www.electropedia.org/iev/iev.nsf/display?openform&ievref=131-12-19"^^xsd:anyURI,
    "https://cdd.iec.ch/cdd/iec61987/iec61987.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD065"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/siExactMatch> <https://si-digital-framework.org/SI/quantities/ELIN>;
  <http://qudt.org/schema/qudt/symbol> "L";
  <http://qudt.org/schema/qudt/plainTextDescription> "\"Inductance\" is an electromagentic quantity that characterizes a circuit's resistance to any change of electric current; a change in the electric current through induces an opposing electromotive force (EMF). Quantitatively, inductance is proportional to the magnetic flux per unit of electric current.";
  <http://qudt.org/schema/qudt/latexDefinition> "$L =\\frac{\\Psi}{I}$, where $I$ is an electric current in a thin conducting loop, and $\\Psi$ is the linked flux caused by that electric current."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/applicableUnit> unit:H, unit:H_Ab, unit:NanoH, unit:H_Stat,
    unit:KiloH, unit:MicroH, unit:MilliH, unit:PicoH .

unit:H-PER-KiloOHM a <http://qudt.org/schema/qudt/Unit>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/unit>;
  rdfs:label "Henry per Kiloohm"@en;
  dct:description "SI derived unit henry divided by the 1 000-fold of the SI derived unit ohm"^^rdf:HTML;
  <http://qudt.org/schema/qudt/applicableSystem> <http://qudt.org/vocab/sou/CGS-EMU>,
    <http://qudt.org/vocab/sou/CGS-GAUSS>, <http://qudt.org/vocab/sou/SI>;
  <http://qudt.org/schema/qudt/conversionMultiplier> 0.001;
  <http://qudt.org/schema/qudt/conversionMultiplierSN> 1.0E-3;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T1D0>;
  <http://qudt.org/schema/qudt/hasQuantityKind> <http://qudt.org/vocab/quantitykind/Time>;
  <http://qudt.org/schema/qudt/iec61360Code> "0112/2///62720#UAA167";
