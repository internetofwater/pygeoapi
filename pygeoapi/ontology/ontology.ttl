<http://qudt.org/vocab/quantitykind/ReactorTimeConstant> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Reactor Time Constant"@en;
  rdfs:comment "Applicable units are those of quantitykind:Time";
  dct:description "The \"Reactor Time Constant\", also called the reactor period, is the time during which the neutron flux density in a reactor changes by the factor e = 2.718 (e: basis of natural logarithms), when the neutron flux density increases or decreases exponentially."^^<http://qudt.org/schema/qudt/LatexString>;
