quantitykind:Permeance a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:seeAlso quantitykind:Reluctance, quantitykind:Reluctance;
  rdfs:label "Permeance"@en, "Permeance"@en;
  rdfs:comment "Applicable units are those of quantitykind:Permeance", "Applicable units are those of quantitykind:Permeance";
  dct:description "\"Permeance\" is the inverse of reluctance. Permeance is a measure of the quantity of flux for a number of current-turns in magnetic circuit. A magnetic circuit almost acts as though the flux is \"conducted\", therefore permeance is larger for large cross sections of a material and smaller for longer lengths. This concept is analogous to electrical conductance in the electric circuit."^^qudt:LatexString,
    "\"Permeance\" is the inverse of reluctance. Permeance is a measure of the quantity of flux for a number of current-turns in magnetic circuit. A magnetic circuit almost acts as though the flux is \"conducted\", therefore permeance is larger for large cross sections of a material and smaller for longer lengths. This concept is analogous to electrical conductance in the electric circuit."^^qudt:LatexString;
  qudt:hasDimensionVector dimensionvector:A0E-2L2I0M1H0T-2D0, dimensionvector:A0E-2L2I0M1H0T-2D0;
  qudt:iec61360Code "0112/2///62720#UAD135", "0112/2///62720#UAD135";
  qudt:informativeReference "http://www.iso.org/iso/home/store/catalogue_tc/catalogue_detail.htm?csnumber=31891"^^xsd:anyURI,
    "http://www.iso.org/iso/home/store/catalogue_tc/catalogue_detail.htm?csnumber=31891"^^xsd:anyURI,
    "http://en.wikipedia.org/wiki/Permeance"^^xsd:anyURI, "http://en.wikipedia.org/wiki/Permeance"^^xsd:anyURI,
    "https://cdd.iec.ch/cdd/iec61987/iec61987.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD135"^^xsd:anyURI,
    "https://cdd.iec.ch/cdd/iec61987/iec61987.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD135"^^xsd:anyURI;
  qudt:plainTextDescription "\"Permeance\" is the inverse of reluctance. Permeance is a measure of the quantity of flux for a number of current-turns in magnetic circuit. A magnetic circuit almost acts as though the flux is \"conducted\", therefore permeance is larger for large cross sections of a material and smaller for longer lengths. This concept is analogous to electrical conductance in the electric circuit.",
    "\"Permeance\" is the inverse of reluctance. Permeance is a measure of the quantity of flux for a number of current-turns in magnetic circuit. A magnetic circuit almost acts as though the flux is \"conducted\", therefore permeance is larger for large cross sections of a material and smaller for longer lengths. This concept is analogous to electrical conductance in the electric circuit.";
  qudt:latexSymbol "$\\Lambda$"^^qudt:LatexString, "$\\Lambda$"^^qudt:LatexString;
  qudt:latexDefinition "$\\Lambda = \\frac{1}{R_m}$, where $R_m$ is reluctance."^^qudt:LatexString,
    "$\\Lambda = \\frac{1}{R_m}$, where $R_m$ is reluctance."^^qudt:LatexString;
  qudt:applicableUnit unit:NanoH, unit:NanoH .

