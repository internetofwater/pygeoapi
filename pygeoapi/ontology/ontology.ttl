<http://qudt.org/vocab/quantitykind/TemperaturePerMagneticFluxDensity> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Temperature per Magnetic Flux Density"@en;
  rdfs:comment "Applicable units are those of quantitykind:TemperaturePerMagneticFluxDensity";
