  rdfs:label "Kilogram per Second Square Meter"@en-US, "Kilogram per Second Square Metre"@en;
  dct:description "SI base unit kilogram divided by the product of the power of the SI base unit metre with the exponent 2 and the SI base unit second"^^rdf:HTML;
