  qudt:hasDimensionVector dimensionvector:A0E0L-1I0M1H0T-2D0, dimensionvector:A0E0L-1I0M1H0T-2D0;
  qudt:hasQuantityKind quantitykind:ForcePerArea, quantitykind:ForcePerArea, quantitykind:VaporPressure,
    quantitykind:VaporPressure;
  qudt:informativeReference "http://en.wikipedia.org/wiki/Barye?oldid=478631158"^^xsd:anyURI,
    "http://en.wikipedia.org/wiki/Barye?oldid=478631158"^^xsd:anyURI;
  qudt:omUnit <http://www.ontology-of-units-of-measure.org/resource/om-2/barye>, <http://www.ontology-of-units-of-measure.org/resource/om-2/barye>;
