  qudt:dbpediaMatch "http://dbpedia.org/resource/Pascal"^^xsd:anyURI, "http://dbpedia.org/resource/Pascal"^^xsd:anyURI;
  qudt:hasDimensionVector dimensionvector:A0E0L-1I0M1H0T-2D0, dimensionvector:A0E0L-1I0M1H0T-2D0;
  qudt:hasQuantityKind quantitykind:ForcePerArea, quantitykind:ForcePerArea, quantitykind:VaporPressure,
    quantitykind:VaporPressure;
  qudt:iec61360Code "0112/2///62720#UAD540";
  qudt:informativeReference "https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAD540"^^xsd:anyURI;
  qudt:symbol "kg/(m·s²)", "kg/(m·s²)";
  qudt:ucumCode "kg.m-1.s-2"^^qudt:UCUMcs, "kg.m-1.s-2"^^qudt:UCUMcs;
  qudt:exactMatch unit:N-PER-M2, unit:N-PER-M2, unit:PA, unit:PA;
  qudt:siUnitsExpression "kg/m/s^2", "kg/m/s^2";
  qudt:hasFactorUnit _:b1cb43fcbd504833bf8a964862c3127016187, _:b1cb43fcbd504833bf8a964862c3127016188,
