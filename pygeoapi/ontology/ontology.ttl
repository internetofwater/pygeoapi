quantitykind:Reflectance a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "Reflectance"@en, "Reflectance"@en;
  rdfs:comment "Applicable units are those of quantitykind:Reflectance", "Applicable units are those of quantitykind:Reflectance";
  dct:description "Reflectance generally refers to the fraction of incident power that is reflected at an interface, while the term \"reflection coefficient\" is used for the fraction of electric field reflected. Reflectance is always a real number between zero and 1.0."^^qudt:LatexString,
    "Reflectance generally refers to the fraction of incident power that is reflected at an interface, while the term \"reflection coefficient\" is used for the fraction of electric field reflected. Reflectance is always a real number between zero and 1.0."^^qudt:LatexString;
  skos:broader quantitykind:DimensionlessRatio, quantitykind:DimensionlessRatio;
  qudt:hasDimensionVector dimensionvector:A0E0L0I0M0H0T0D1, dimensionvector:A0E0L0I0M0H0T0D1;
  qudt:informativeReference "http://en.wikipedia.org/wiki/Reflectivity"^^xsd:anyURI,
    "http://en.wikipedia.org/wiki/Reflectivity"^^xsd:anyURI;
  qudt:plainTextDescription "Reflectance generally refers to the fraction of incident power that is reflected at an interface, while the term \"reflection coefficient\" is used for the fraction of electric field reflected. Reflectance is always a real number between zero and 1.0.",
    "Reflectance generally refers to the fraction of incident power that is reflected at an interface, while the term \"reflection coefficient\" is used for the fraction of electric field reflected. Reflectance is always a real number between zero and 1.0.";
  qudt:latexSymbol "$\\rho$"^^qudt:LatexString, "$\\rho$"^^qudt:LatexString;
  qudt:latexDefinition "$\\rho = \\frac{\\Phi_t}{\\Phi_m}$, where $\\Phi_t$ is the reflected radiant flux, the reflected luminous flux, or the reflected sound power and $\\Phi_m$ is the incident radiant flux, incident luminous flux, or incident sound power, respectively."^^qudt:LatexString,
    "$\\rho = \\frac{\\Phi_t}{\\Phi_m}$, where $\\Phi_t$ is the reflected radiant flux, the reflected luminous flux, or the reflected sound power and $\\Phi_m$ is the incident radiant flux, incident luminous flux, or incident sound power, respectively."^^qudt:LatexString;
  qudt:applicableUnit unit:FRACTION, unit:FRACTION, unit:PERCENT, unit:PERCENT, unit:UNITLESS,
