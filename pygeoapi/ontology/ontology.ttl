  qudt:scalingOf unit:M3 .

unit:CP a qudt:Unit, qudt:Unit;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/unit>, <http://qudt.org/vocab/unit>;
  rdfs:label "Candlepower"@en, "Candlepower"@en;
  dct:description "\"Candlepower\" (abbreviated as cp) is a now-obsolete unit which was used to express levels of light intensity in terms of the light emitted by a candle of specific size and constituents. In modern usage Candlepower equates directly to the unit known as the candela."^^rdf:HTML,
