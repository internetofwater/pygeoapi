        [ qudt:exponent -2 ;
            qudt:hasUnit unit:M ],
        [ qudt:exponent 1 ;
            qudt:hasUnit unit:N ],
        [ qudt:exponent -2 ;
            qudt:hasUnit unit:M ],
        [ qudt:exponent 1 ;
            qudt:hasUnit unit:N ] ;
