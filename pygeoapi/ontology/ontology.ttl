quantitykind:IncidenceRate a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:seeAlso quantitykind:IncidenceProportion, quantitykind:IncidenceProportion;
  rdfs:label "Incidence Rate"@en, "Incidence Rate"@en;
  rdfs:comment "Applicable units are those of quantitykind:Frequency", "Applicable units are those of quantitykind:Incidence";
  dct:description "The incidence rate is a measure of the frequency with which a disease or other incident occurs over a specified time period. It is also known as the incidence density rate or person-time incidence rate, when the denominator is the combined person-time of the population at risk (the sum of the time duration of exposure across all persons exposed)"^^qudt:LatexString,
    "The incidence rate is a measure of the frequency with which a disease or other incident occurs over a specified time period. It is also known as the incidence density rate or person-time incidence rate, when the denominator is the combined person-time of the population at risk (the sum of the time duration of exposure across all persons exposed)"^^qudt:LatexString;
  skos:broader quantitykind:Incidence, quantitykind:Incidence;
  qudt:hasDimensionVector dimensionvector:A0E0L0I0M0H0T-1D0, dimensionvector:A0E0L0I0M0H0T-1D0;
