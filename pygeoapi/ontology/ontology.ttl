unit:N-PER-C a qudt:DerivedUnit,
        qudt:Unit ;
    rdfs:label "Newton per Coulomb"@en ;
    dct:description "Newton Per Coulomb ( N/C) is a unit in the category of Electric field strength. It is also known as newtons/coulomb. Newton Per Coulomb ( N/C) has a dimension of MLT-3I-1 where $M$ is mass, $L$ is length, $T$ is time, and $I$ is electric current. It essentially the same as the corresponding standard SI unit V/m."^^rdf:HTML ;
    qudt:applicableSystem <http://qudt.org/vocab/sou/CGS>,
        <http://qudt.org/vocab/sou/CGS-EMU>,
        <http://qudt.org/vocab/sou/CGS-GAUSS>,
        <http://qudt.org/vocab/sou/SI> ;
    qudt:conversionMultiplier 1.0 ;
    qudt:conversionMultiplierSN 1e+00 ;
    qudt:definedUnitOfSystem <http://qudt.org/vocab/sou/SI> ;
    qudt:derivedCoherentUnitOfSystem <http://qudt.org/vocab/sou/SI> ;
    qudt:expression "$N/C$"^^qudt:LatexString ;
    qudt:hasDimensionVector dimensionvector:A0E-1L1I0M1H0T-3D0 ;
    qudt:hasFactorUnit [ qudt:exponent -1 ;
            qudt:hasUnit unit:C ],
        [ qudt:exponent 1 ;
            qudt:hasUnit unit:N ],
        [ qudt:exponent -1 ;
            qudt:hasUnit unit:C ],
        [ qudt:exponent 1 ;
            qudt:hasUnit unit:N ],
        [ qudt:exponent -1 ;
            qudt:hasUnit unit:C ],
        [ qudt:exponent 1 ;
            qudt:hasUnit unit:N ] ;
    qudt:hasQuantityKind quantitykind:ForcePerElectricCharge ;
    qudt:symbol "N/C" ;
    qudt:ucumCode "N.C-1"^^qudt:UCUMcs,
        "N/C"^^qudt:UCUMcs ;
    rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/unit>,
        <http://qudt.org/vocab/unit> .

unit:N-PER-KiloGM a qudt:DerivedUnit,
        qudt:Unit ;
    rdfs:label "Newton per KiloGram"@en,
        "Newton per Kilogram"@en ;
    dct:description "Gravitational field strength at a point is the gravitational force per unit mass at that point. It is a vector and its S.I. unit is N kg-1."^^rdf:HTML ;
