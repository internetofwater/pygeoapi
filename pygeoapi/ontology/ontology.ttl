quantitykind:ActivePower a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:seeAlso quantitykind:ComplexPower, quantitykind:InstantaneousPower, quantitykind:InstantaneousPower;
  rdfs:label "Active Power"@en, "Active Power"@en;
  rdfs:comment "Applicable units are those of quantitykind:ActivePower", "Applicable units are those of quantitykind:ElectricPower";
  dct:description """
  An $Active Power$ is, under periodic conditions, the mean value, taken over one period $T$, of the instantaneous power $p$. 
  In complex notation, $P = \\mathbf{Re} \\; \\underline{S}$, where $\\underline{S}$ is $\\textit{complex power}$.
  """^^qudt:LatexString,
    """
  An $Active Power$ is, under periodic conditions, the mean value, taken over one period $T$, of the instantaneous power $p$. 
  In complex notation, $P = \\mathbf{Re} \\; \\underline{S}$, where $\\underline{S}$ is $\\textit{complex power}$.
  """^^qudt:LatexString;
  skos:broader quantitykind:ComplexPower, quantitykind:ElectricPower;
  qudt:hasDimensionVector dimensionvector:A0E0L2I0M1H0T-3D0, dimensionvector:A0E0L2I0M1H0T-3D0;
  qudt:iec61360Code "0112/2///62720#UAD003", "0112/2///62720#UAD003";
  qudt:informativeReference "http://www.iso.org/iso/home/store/catalogue_tc/catalogue_detail.htm?csnumber=31891"^^xsd:anyURI,
    "http://www.iso.org/iso/home/store/catalogue_tc/catalogue_detail.htm?csnumber=31891"^^xsd:anyURI,
    "http://www.electropedia.org/iev/iev.nsf/display?openform&ievref=131-11-42"^^xsd:anyURI,
    "http://www.electropedia.org/iev/iev.nsf/display?openform&ievref=131-11-42"^^xsd:anyURI,
    "https://cdd.iec.ch/cdd/iec61987/iec61987.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD003"^^xsd:anyURI,
    "https://cdd.iec.ch/cdd/iec61987/iec61987.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD003"^^xsd:anyURI;
  qudt:symbol "P", "P";
  qudt:latexDefinition "$P = \\frac{1}{T}\\int_{0}^{T} pdt$, where $T$ is the period and $p$ is instantaneous power."^^qudt:LatexString,
    "$P = \\frac{1}{T}\\int_{0}^{T} pdt$, where $T$ is the period and $p$ is instantaneous power."^^qudt:LatexString;
  qudt:applicableUnit unit:ExaW, unit:ExaW, unit:FT-LB_F-PER-HR, unit:FT-LB_F-PER-MIN,
    unit:FT-LB_F-PER-SEC, unit:GigaW, unit:GigaW, unit:HP_Boiler, unit:HP_H2O, unit:KiloGM_F-M-PER-SEC,
    unit:KiloW, unit:KiloW, unit:MegaW, unit:MegaW, unit:MicroW, unit:MicroW, unit:MilliW,
    unit:MilliW, unit:NanoW, unit:NanoW, unit:PFERDESTAERKE, unit:PetaW, unit:PetaW, unit:PicoW,
    unit:PicoW, unit:TeraJ-PER-SEC, unit:TeraJ-PER-SEC, unit:TeraW, unit:TeraW, unit:W,
    unit:W .

