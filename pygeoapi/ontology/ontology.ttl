quantitykind:DynamicFrictionCoefficient a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "Dynamic Friction Coefficient"@en, "Dynamic Friction Coefficient"@en;
  rdfs:comment "Applicable units are those of quantitykind:FrictionCoefficient", "Applicable units are those of quantitykind:FrictionCoefficient";
  dct:description "Kinetic (or dynamic) friction occurs when two objects are moving relative to each other and rub together (like a sled on the ground)."^^qudt:LatexString,
    "Kinetic (or dynamic) friction occurs when two objects are moving relative to each other and rub together (like a sled on the ground)."^^qudt:LatexString;
  skos:broader quantitykind:FrictionCoefficient, quantitykind:FrictionCoefficient;
  qudt:dbpediaMatch "http://dbpedia.org/resource/Friction"^^xsd:anyURI, "http://dbpedia.org/resource/Friction"^^xsd:anyURI;
  qudt:hasDimensionVector dimensionvector:A0E0L0I0M0H0T0D1, dimensionvector:A0E0L0I0M0H0T0D1;
