quantitykind:SpecificEnergyImparted a qudt:QuantityKind ;
    rdfs:label "Specific Energy Imparted"@en ;
    dct:description "The \"Specific Energy Imparted\", is the energy imparted to an element of irradiated matter divided by the mass, dm, of that element."^^qudt:LatexString ;
    qudt:applicableUnit unit:BTU_IT-PER-LB,
        unit:BTU_TH-PER-LB,
        unit:CAL_IT-PER-GM,
