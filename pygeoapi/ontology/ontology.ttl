<http://qudt.org/vocab/quantitykind/PartialPressure> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Partial Pressure"@en;
  rdfs:comment "Applicable units are those of quantitykind:ForcePerArea";
  dct:description """
  The quantity kind $\\textit{Partial Pressure}$ is the pressure that the gas would
   have if it alone occupied the volume of the mixture at the same temperature.
  """^^<http://qudt.org/schema/qudt/LatexString>;
  skos:broader <http://qudt.org/vocab/quantitykind/Pressure>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L-1I0M1H0T-2D0>;
  <http://qudt.org/schema/qudt/informativeReference> "http://en.wikipedia.org/wiki/Partial_pressure"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/symbol> "p_B";
  <http://qudt.org/schema/qudt/plainTextDescription> "\"Partial Pressure\" is the pressure that the gas would have if it alone occupied the volume of the mixture at the same temperature.";
  <http://qudt.org/schema/qudt/latexDefinition> "$p_B = x_B \\cdot p$, where $x_B$ is the amount-of-substance fraction of substance $B$ and $p$ is the total pressure."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/abbreviation> "pa";
  <http://qudt.org/schema/qudt/applicableUnit> unit:ATM, unit:ATM_T, unit:BAR, unit:BARAD,
    unit:BARYE, unit:CentiBAR, unit:CentiM_H2O, unit:CentiM_H2O_4DEG_C, unit:CentiM_HG,
