quantitykind:MutualInductance a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:seeAlso quantitykind:Inductance, quantitykind:Inductance;
  rdfs:label "Mutual Inductance"@en, "Mutual Inductance"@en;
  rdfs:comment "Applicable units are those of quantitykind:Inductance", "Applicable units are those of quantitykind:Inductance";
  dct:description "$\\textit{Mutual Inductance}$ is the non-diagonal term of the inductance matrix. For two loops, the symbol $M$ is used for $L_{12}$."^^qudt:LatexString,
    "$\\textit{Mutual Inductance}$ is the non-diagonal term of the inductance matrix. For two loops, the symbol $M$ is used for $L_{12}$."^^qudt:LatexString;
  skos:broader quantitykind:Inductance, quantitykind:Inductance;
  qudt:hasDimensionVector dimensionvector:A0E-2L2I0M1H0T-2D0, dimensionvector:A0E-2L2I0M1H0T-2D0;
  qudt:informativeReference "http://www.iso.org/iso/home/store/catalogue_tc/catalogue_detail.htm?csnumber=31891"^^xsd:anyURI,
    "http://www.iso.org/iso/home/store/catalogue_tc/catalogue_detail.htm?csnumber=31891"^^xsd:anyURI,
    "http://www.electropedia.org/iev/iev.nsf/display?openform&ievref=131-12-36"^^xsd:anyURI,
    "http://www.electropedia.org/iev/iev.nsf/display?openform&ievref=131-12-36"^^xsd:anyURI;
  qudt:symbol "L_{mn}", "L_{mn}";
  qudt:latexDefinition "$L_{mn} = \\frac{\\Psi_m}{I_n}$, where $I_n$ is an electric current in a thin conducting loop $n$ and $\\Psi_m$ is the linked flux caused by that electric current in another loop $m$."^^qudt:LatexString,
    "$L_{mn} = \\frac{\\Psi_m}{I_n}$, where $I_n$ is an electric current in a thin conducting loop $n$ and $\\Psi_m$ is the linked flux caused by that electric current in another loop $m$."^^qudt:LatexString;
  qudt:applicableUnit unit:H, unit:H, unit:H_Ab, unit:H_Ab, unit:NanoH, unit:NanoH,
    unit:H_Stat, unit:H_Stat, unit:KiloH, unit:KiloH, unit:MicroH, unit:MicroH, unit:MilliH,
    unit:MilliH, unit:PicoH, unit:PicoH .

