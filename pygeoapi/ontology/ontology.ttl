unit:C a qudt:Unit, qudt:Unit, qudt:DerivedUnit, qudt:DerivedUnit;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/unit>, <http://qudt.org/vocab/unit>;
  rdfs:label "Coulomb"@de, "Coulomb"@de, "coulomb"@cs, "coulomb"@cs, "coulomb"@en, "coulomb"@en,
    "coulomb"@fr, "coulomb"@fr, "coulomb"@hu, "coulomb"@hu, "coulomb"@it, "coulomb"@it,
    "coulomb"@ms, "coulomb"@ms, "coulomb"@pt, "coulomb"@pt, "coulomb"@ro, "coulomb"@ro,
    "coulomb"@sl, "coulomb"@sl, "coulomb"@tr, "coulomb"@tr, "coulombium"@la, "coulombium"@la,
    "culombio"@es, "culombio"@es, "kulomb"@pl, "kulomb"@pl, "κουλόμπ"@el, "κουλόμπ"@el,
    "кулон"@bg, "кулон"@bg, "кулон"@ru, "кулон"@ru, "קולון"@he, "קולון"@he, "كولوم"@ar,
    "كولوم"@ar, "کولمب/کولن"@fa, "کولمب/کولن"@fa, "कूलम्ब"@hi, "कूलम्ब"@hi, "クーロン"@ja,
    "クーロン"@ja, "库伦"@zh, "库伦"@zh;
  dct:description "The SI unit of electric charge. One coulomb is the amount of charge accumulated in one second by a current of one ampere. Electricity is actually a flow of charged particles, such as electrons, protons, or ions. The charge on one of these particles is a whole-number multiple of the charge e on a single electron, and one coulomb represents a charge of approximately 6.241 506 x 1018 e. The coulomb is named for a French physicist, Charles-Augustin de Coulomb (1736-1806), who was the first to measure accurately the forces exerted between electric charges."^^rdf:HTML,
    "The SI unit of electric charge. One coulomb is the amount of charge accumulated in one second by a current of one ampere. Electricity is actually a flow of charged particles, such as electrons, protons, or ions. The charge on one of these particles is a whole-number multiple of the charge e on a single electron, and one coulomb represents a charge of approximately 6.241 506 x 1018 e. The coulomb is named for a French physicist, Charles-Augustin de Coulomb (1736-1806), who was the first to measure accurately the forces exerted between electric charges."^^rdf:HTML;
  qudt:applicableSystem <http://qudt.org/vocab/sou/CGS-EMU>, <http://qudt.org/vocab/sou/CGS-EMU>,
    <http://qudt.org/vocab/sou/CGS-GAUSS>, <http://qudt.org/vocab/sou/CGS-GAUSS>, <http://qudt.org/vocab/sou/PLANCK>,
    <http://qudt.org/vocab/sou/PLANCK>, <http://qudt.org/vocab/sou/SI>, <http://qudt.org/vocab/sou/SI>,
    <http://qudt.org/vocab/sou/CGS>, <http://qudt.org/vocab/sou/CGS>;
  qudt:conversionMultiplier 1.0, 1.0;
  qudt:conversionMultiplierSN 1.0E0, 1.0E0;
  qudt:dbpediaMatch "http://dbpedia.org/resource/Coulomb"^^xsd:anyURI, "http://dbpedia.org/resource/Coulomb"^^xsd:anyURI;
  qudt:hasDimensionVector dimensionvector:A0E1L0I0M0H0T1D0, dimensionvector:A0E1L0I0M0H0T1D0;
