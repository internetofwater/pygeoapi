  rdfs:isDefinedBy <http://qudt.org/3.0.0/schema/qudt>;
  rdfs:label "deprecated";
  rdfs:range xsd:boolean .

_:6bb918f5130b4a77805c72ffff92bd8c542 a owl:Restriction;
  owl:maxCardinality "1"^^xsd:int;
  owl:onProperty <http://qudt.org/schema/qudt/id> .

<http://qudt.org/schema/qudt/id> a owl:DatatypeProperty;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/schema/qudt>;
  rdfs:label "qudt id";
  rdfs:range xsd:string;
  rdfs:domain <http://qudt.org/schema/qudt/Concept>;
  dct:description "The \"qudt:id\" is an identifier string that uniquely identifies a QUDT concept.  The identifier is constructed using a prefix. For example, units are coded using the pattern: \"UCCCENNNN\", where \"CCC\" is a numeric code or a category and \"NNNN\" is a digit string for a member element of that category. For scaled units there may be an addition field that has the format \"QNN\" where \"NN\" is a digit string representing an exponent power, and \"Q\" is a qualifier that indicates with the code \"P\" that the power is a positive decimal exponent, or the code \"N\" for a negative decimal exponent, or the code \"B\" for binary positive exponents."^^rdf:HTML .

_:6bb918f5130b4a77805c72ffff92bd8c543 a owl:Restriction;
  owl:maxCardinality "1"^^xsd:int;
  owl:onProperty <http://qudt.org/schema/qudt/plainTextDescription> .

<http://qudt.org/schema/qudt/ConstantValue> a owl:Class;
  rdfs:subClassOf <http://qudt.org/schema/qudt/QuantityValue>, _:6bb918f5130b4a77805c72ffff92bd8c544;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/schema/qudt>;
  rdfs:label "Constant value";
  rdfs:comment "Used to specify the values of a constant."^^rdf:HTML .

<http://qudt.org/schema/qudt/QuantityValue> a owl:Class;
  rdfs:subClassOf <http://qudt.org/schema/qudt/Concept>, <http://qudt.org/schema/qudt/Quantifiable>,
    _:6bb918f5130b4a77805c72ffff92bd8c675, _:6bb918f5130b4a77805c72ffff92bd8c676;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/schema/qudt>;
  rdfs:label "Quantity value";
  rdfs:comment "A <i>Quantity Value</i> expresses the magnitude and kind of a quantity and is given by the product of a numerical value <code>n</code> and a unit of measure <code>U</code>. The number multiplying the unit is referred to as the numerical value of the quantity expressed in that unit. Refer to <a href=\"http://physics.nist.gov/Pubs/SP811/sec07.html\">NIST SP 811 section 7</a> for more on quantity values."^^rdf:HTML .

_:6bb918f5130b4a77805c72ffff92bd8c544 a owl:Restriction;
  owl:minCardinality "0"^^xsd:nonNegativeInteger;
  owl:onProperty <http://qudt.org/schema/qudt/exactConstant> .

<http://qudt.org/schema/qudt/exactConstant> a owl:DatatypeProperty;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/schema/qudt>;
  rdfs:label "exact constant";
  rdfs:range xsd:boolean .

<http://qudt.org/schema/qudt/CurrencyUnit> a owl:Class;
  rdfs:subClassOf <http://qudt.org/schema/qudt/DimensionlessUnit>, _:6bb918f5130b4a77805c72ffff92bd8c545,
    _:6bb918f5130b4a77805c72ffff92bd8c546;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/schema/qudt>;
  rdfs:label "Currency Unit";
  rdfs:comment "Currency Units have their own subclass of unit because: (a) they have additonal properites such as 'country' and (b) their URIs do not conform to the same rules as other units."^^rdf:HTML,
    "Used for all units that express currency."^^rdf:HTML .

_:6bb918f5130b4a77805c72ffff92bd8c545 a owl:Restriction;
  owl:maxCardinality 1;
  owl:onProperty <http://qudt.org/schema/qudt/currencyCode>;
  xsd:pattern "^\\d{3}$" .

<http://qudt.org/schema/qudt/currencyCode> a owl:DatatypeProperty, owl:FunctionalProperty;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/schema/qudt>;
  rdfs:seeAlso "https://en.wikipedia.org/wiki/ISO_4217"^^xsd:anyURI;
  rdfs:label "currency code";
  rdfs:range xsd:string;
  dct:description "Alphabetic Currency Code as defined by ISO 4217. For example, US Dollar has the code 'USD'."^^rdf:HTML .

_:6bb918f5130b4a77805c72ffff92bd8c546 a owl:Restriction;
  owl:maxCardinality 1;
  owl:onProperty <http://qudt.org/schema/qudt/currencyExponent> .

<http://qudt.org/schema/qudt/currencyExponent> a owl:DatatypeProperty, owl:FunctionalProperty;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/schema/qudt>;
  rdfs:label "currency exponent";
  rdfs:range xsd:integer;
  dct:description "The currency exponent indicates the number of decimal places between a major currency unit and its minor currency unit. For example, the US dollar is the major currency unit of the United States, and the US cent is the minor currency unit. Since one cent is 1/100 of a dollar, the US dollar has a currency exponent of 2. However, the Japanese Yen has no minor currency units, so the yen has a currency exponent of 0."^^rdf:HTML .

<http://qudt.org/schema/qudt/DataEncoding> a owl:Class;
  rdfs:subClassOf <http://qudt.org/schema/qudt/Aspect>, _:6bb918f5130b4a77805c72ffff92bd8c547,
