    "http://en.wikipedia.org/wiki/Sound_energy_density"^^xsd:anyURI;
  qudt:symbol "E", "E";
  qudt:latexDefinition "$E = \\frac{I}{c}$, where $I$ is the sound intensity in $\\frac{W}{m^2}$ and $c$ is the sound speed in $\\frac{m}{s}$."^^qudt:LatexString,
    "$E = \\frac{I}{c}$, where $I$ is the sound intensity in $\\frac{W}{m^2}$ and $c$ is the sound speed in $\\frac{m}{s}$."^^qudt:LatexString;
