unit:M2-PER-SEC-PA a qudt:Unit, qudt:Unit;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/unit>, <http://qudt.org/vocab/unit>;
  rdfs:label "square metre per second pascal", "square metre per second pascal";
  dct:description """
  The unit $\\textit{Square Metre per Second Pascal}$, symbol $m^{2}/s\\cdot Pa$, is a measure of permeability, which describes the ability
   of a material to allow fluids to pass through it under a pressure gradient. 
  It's particularly relevant in fields like hydrogeology, petroleum engineering, and civil engineering,
   where understanding fluid flow through porous materials is essential.
  """^^qudt:LatexString,
    """
  The unit $\\textit{Square Metre per Second Pascal}$, symbol $m^{2}/s\\cdot Pa$, is a measure of permeability, which describes the ability
   of a material to allow fluids to pass through it under a pressure gradient. 
  It's particularly relevant in fields like hydrogeology, petroleum engineering, and civil engineering,
   where understanding fluid flow through porous materials is essential.
  """^^qudt:LatexString;
  qudt:conversionMultiplier 1.0, 1.0;
  qudt:conversionMultiplierSN 1.0E0, 1.0E0;
  qudt:hasDimensionVector dimensionvector:A0E0L3I0M-1H0T1D0, dimensionvector:A0E0L3I0M-1H0T1D0;
  qudt:hasQuantityKind quantitykind:Unknown, quantitykind:Unknown;
