variablename:extracellularEnzymeActivity a skos:Concept;
  skos:definition "Extracellular enzymes or exoenzymes are synthesized inside the cell and then secreted outside the cell, where their function is to break down complex macromolecules into smaller units to be taken up by the cell for growth and assimilation.";
  skos:topConceptOf <http://vocabulary.odm2.org/variablename>;
  skos:prefLabel "Extracellular enzyme activity";
  skos:note "Added to support Critical Zone Observatory (CZO) data use cases. ";
  skos:historyNote "Wikipedia";
  skos:exactMatch "https://en.wikipedia.org/wiki/Fungal_extracellular_enzyme_activity" .

variablename:nickelDissolved a skos:Concept;
  skos:definition "Dissolved Nickel (Ni)";
