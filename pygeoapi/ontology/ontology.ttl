  <http://qudt.org/schema/qudt/conversionMultiplierSN> 8.479768781217653545564583782058114E17;
  <http://qudt.org/schema/qudt/dbpediaMatch> "http://dbpedia.org/resource/Exbibyte"^^xsd:anyURI;
