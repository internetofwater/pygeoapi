<http://qudt.org/vocab/quantitykind/ParticleCurrent> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Particle Current"@en;
  rdfs:comment "Applicable units are those of quantitykind:Frequency";
  dct:description """
  The quantity kind $\\textit{Particle Current}$ can be used to describe the net number
   of particles passing through a surface in an infinitesimal time interval.
  """^^<http://qudt.org/schema/qudt/LatexString>;
  skos:broader <http://qudt.org/vocab/quantitykind/Frequency>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T-1D0>;
  <http://qudt.org/schema/qudt/symbol> "J";
  <http://qudt.org/schema/qudt/isoNormativeReference> "http://www.iso.org/iso/catalogue_detail?csnumber=31895"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/plainTextDescription> "\"Particle Current\" can be used to describe the net number of particles passing through a surface in an infinitesimal time interval.";
  <http://qudt.org/schema/qudt/latexDefinition> "$\\int J \\cdot e_n dA = \\frac{dN}{dt}$, where $e_ndA$ is the vector surface element, $N$ is the net number of particles passing over a surface, and $dt$ describes the time interval."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/altSymbol> "S";
  <http://qudt.org/schema/qudt/applicableUnit> unit:HZ, unit:GigaHZ, unit:PER-SEC, unit:KiloHZ,
    unit:MegaHZ, unit:MilliHZ, unit:NUM-PER-HR, unit:PER-HR, unit:NUM-PER-SEC, unit:NUM-PER-YR,
    unit:PER-YR, unit:PER-DAY, unit:PER-MIN, unit:PER-MO, unit:PER-MilliSEC, unit:SAMPLE-PER-SEC,
    unit:PER-WK, unit:PERCENT-PER-DAY, unit:PERCENT-PER-HR, unit:PERCENT-PER-MO, unit:PERCENT-PER-WK,
    unit:PERCENT-PER-YR, unit:PPTH-PER-HR, unit:PetaHZ, unit:PlanckFrequency, unit:TeraHZ,
    unit:failures-in-time .

<http://qudt.org/vocab/quantitykind/ParticleCurrentDensity> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "particle current density", "particle current density"@en-US;
  dct:description """
  The quantity kind $\\textit{Particle Current Density}$ is a vector whose component is
   perpendicular to a surface equal to the net number of particles crossing that surface
   in the positive direction per unit area and per unit time.
  """^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L-2I0M0H0T-1D0>;
  <http://qudt.org/schema/qudt/iec61360Code> "0112/2///62720#UAD132";
  <http://qudt.org/schema/qudt/informativeReference> "https://cdd.iec.ch/cdd/iec61987/iec61987.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD132"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/symbol> "0173-1#Z4-BAJ388#002";
  <http://qudt.org/schema/qudt/plainTextDescription> "Vektor, dessen Komponente senkrecht zu einer Fläche gleich der Nettoanzahl von Teilchen ist, die flächen- und zeitbezogen in positiver Richtung durch diese Fläche hindurchgehen"@de .

<http://qudt.org/vocab/quantitykind/ParticleNumberDensity> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Particle Number Density"@en;
  rdfs:comment "Applicable units are those of quantitykind:NumberDensity";
  dct:description "The \"Particle Number Density\" is obtained by dividing the particle number of a system by its volume."^^<http://qudt.org/schema/qudt/LatexString>;
  skos:broader <http://qudt.org/vocab/quantitykind/NumberDensity>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L-3I0M0H0T0D0>;
  <http://qudt.org/schema/qudt/informativeReference> "http://en.wikipedia.org/wiki/Particle_number#Particle_number_density"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/symbol> "n";
  <http://qudt.org/schema/qudt/plainTextDescription> "The \"Particle Number Density\" is obtained by dividing the particle number of a system by its volume.";
  <http://qudt.org/schema/qudt/latexDefinition> "$n = \\frac{N}{V}$, where $N$ is the number of particles in the 3D domain with the volume $V$."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/applicableUnit> unit:NUM-PER-L, unit:NUM-PER-M3, unit:NUM-PER-MicroL,
    unit:NUM-PER-MilliL, unit:NUM-PER-MilliM3, unit:NUM-PER-NanoL, unit:NUM-PER-PicoL;
  <http://qudt.org/schema/qudt/normativeReference> "http://www.iso.org/iso/catalogue_detail?csnumber=31895"^^xsd:anyURI .

