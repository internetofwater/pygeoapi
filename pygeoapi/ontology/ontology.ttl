variablename:zinc a skos:Concept;
  skos:definition "Zinc is a chemical element with symbol Zn and atomic number 30. It is the first element in group 12 of the periodic table. In some respects zinc is chemically similar to magnesium: both elements exhibit only one normal oxidation state (+2), and the Zn2+ and Mg2+ ions are of similar size. Zinc is the 24th most abundant element in Earth's crust and has five stable isotopes. The most common zinc ore is sphalerite (zinc blende), a zinc sulfide mineral. The largest workable lodes are in Australia, Asia, and the United States. Zinc is refined by froth flotation of the ore, roasting, and final extraction using electricity (electrowinning).";
  skos:topConceptOf <http://vocabulary.odm2.org/variablename>;
  skos:prefLabel "Zinc";
  skos:note "Added to support Critical Zone Observatory (CZO) data use cases. ";
  skos:historyNote "Wikipedia";
  skos:exactMatch "https://en.wikipedia.org/wiki/Zinc" .

variablename:fluorescenceDissolvedOrganicMatter a skos:Concept;
  skos:definition "Fluorescence of dissolved organic matter (DOM).";
  skos:topConceptOf <http://vocabulary.odm2.org/variablename>;
  skos:prefLabel "Fluorescence, dissolved organic matter (DOM)";
  skos:note "Added to support Critical Zone Observatory (CZO) data use cases. ";
  skos:exactMatch "https://aslopubs.onlinelibrary.wiley.com/doi/abs/10.4319/lo.2001.46.1.0039" .

variablename:baseflow a skos:Concept;
