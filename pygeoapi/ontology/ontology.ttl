<http://qudt.org/vocab/quantitykind/Force> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Daya"@ms, "Kraft"@de, "Síla"@cs, "erő"@hu, "force"@en, "force"@fr, "forza"@it,
    "força"@pt, "forță"@ro, "fuerza"@es, "kuvvet"@tr, "sila"@sl, "siła"@pl, "vis"@la,
    "Δύναμη"@el, "Сила"@ru, "сила"@bg, "כוח"@he, "نیرو"@fa, "وحدة القوة في نظام متر كيلوغرام ثانية"@ar,
    "बल"@hi, "力"@ja, "力"@zh;
  rdfs:comment "Applicable units are those of quantitykind:Force";
  dct:description "\"Force\" is an influence that causes mass to accelerate. It may be experienced as a lift, a push, or a pull. Force is defined by Newton's Second Law as $F = m \\times a $, where $F$ is force, $m$ is mass and $a$ is acceleration. Net force is mathematically equal to the time rate of change of the momentum of the body on which it acts. Since momentum is a vector quantity (has both a magnitude and direction), force also is a vector quantity."^^<http://qudt.org/schema/qudt/LatexString>;
  skos:altLabel "भार"@hi;
  <http://qudt.org/schema/qudt/dbpediaMatch> "http://dbpedia.org/resource/Force"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L1I0M1H0T-2D0>;
  <http://qudt.org/schema/qudt/iec61360Code> "0112/2///62720#UAD054";
  <http://qudt.org/schema/qudt/informativeReference> "http://en.wikipedia.org/wiki/Force"^^xsd:anyURI,
    "https://cdd.iec.ch/cdd/iec61987/iec61987.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD054"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/siExactMatch> <https://si-digital-framework.org/SI/quantities/FORC>;
  <http://qudt.org/schema/qudt/symbol> "F";
  <http://qudt.org/schema/qudt/isoNormativeReference> "http://www.iso.org/iso/catalogue_detail?csnumber=43012"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/latexDefinition> "$F = \\frac{dp}{dt}$, where $F$ is the resultant force acting on a body, $p$ is momentum of a body, and $t$ is time."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/applicableUnit> unit:CentiN, unit:DYN, unit:DeciN, unit:GM_F,
    unit:KIP_F, unit:KiloGM-M-PER-SEC2, unit:N, unit:KiloGM_F, unit:KiloPOND, unit:KiloLB_F,
    unit:KiloN, unit:LB_F, unit:MegaLB_F, unit:MegaN, unit:MicroN, unit:MilliN, unit:OZ_F,
    unit:PDL, unit:POND, unit:PlanckForce, unit:TON_F_US .

unit:CentiN-M a <http://qudt.org/schema/qudt/Unit>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/unit>;
