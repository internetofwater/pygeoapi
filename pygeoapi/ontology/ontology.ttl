quantitykind:DoseEquivalent a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "Dose Equivalent"@en, "Dose Equivalent"@en;
  rdfs:comment "Applicable units are those of quantitykind:DoseEquivalent", "Applicable units are those of quantitykind:DoseEquivalent";
  dct:description "\"Dose Equivalent\" (former), or $\\textit{Equivalent Absorbed Radiation Dose}$, usually shortened to $\\textit{Equivalent Dose}$, is a computed average measure of the radiation absorbed by a fixed mass of biological tissue, that attempts to account for the different biological damage potential of different types of ionizing radiation. The equivalent dose to a tissue is found by multiplying the absorbed dose, in gray, by a dimensionless \"quality factor\" $Q$, dependent upon radiation type, and by another dimensionless factor $N$, dependent on all other pertinent factors. N depends upon the part of the body irradiated, the time and volume over which the dose was spread, even the species of the subject."^^qudt:LatexString,
    "\"Dose Equivalent\" (former), or $\\textit{Equivalent Absorbed Radiation Dose}$, usually shortened to $\\textit{Equivalent Dose}$, is a computed average measure of the radiation absorbed by a fixed mass of biological tissue, that attempts to account for the different biological damage potential of different types of ionizing radiation. The equivalent dose to a tissue is found by multiplying the absorbed dose, in gray, by a dimensionless \"quality factor\" $Q$, dependent upon radiation type, and by another dimensionless factor $N$, dependent on all other pertinent factors. N depends upon the part of the body irradiated, the time and volume over which the dose was spread, even the species of the subject."^^qudt:LatexString;
  skos:broader quantitykind:SpecificEnergy, quantitykind:SpecificEnergy;
  qudt:dbpediaMatch "http://dbpedia.org/resource/Equivalent_dose"^^xsd:anyURI, "http://dbpedia.org/resource/Equivalent_dose"^^xsd:anyURI;
  qudt:hasDimensionVector dimensionvector:A0E0L2I0M0H0T-2D0, dimensionvector:A0E0L2I0M0H0T-2D0;
  qudt:iec61360Code "0112/2///62720#UAD033", "0112/2///62720#UAD033";
  qudt:informativeReference "http://en.wikipedia.org/wiki/Equivalent_dose"^^xsd:anyURI,
    "http://en.wikipedia.org/wiki/Equivalent_dose"^^xsd:anyURI, "https://cdd.iec.ch/cdd/iec61987/iec61987.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD033"^^xsd:anyURI,
    "https://cdd.iec.ch/cdd/iec61987/iec61987.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD033"^^xsd:anyURI;
  qudt:siExactMatch <https://si-digital-framework.org/SI/quantities/DOEQ>, <https://si-digital-framework.org/quantities/DOEQ>;
  qudt:symbol "H", "H";
  qudt:isoNormativeReference "http://www.iso.org/iso/catalogue_detail?csnumber=31895"^^xsd:anyURI,
    "http://www.iso.org/iso/catalogue_detail?csnumber=31895"^^xsd:anyURI;
  qudt:latexDefinition "At the point of interest in tissue, $H = DQ$, where $D$ is the absorbed dose and $Q$ is the quality factor at that point."^^qudt:LatexString,
    "At the point of interest in tissue, $H = DQ$, where $D$ is the absorbed dose and $Q$ is the quality factor at that point."^^qudt:LatexString;
  qudt:applicableUnit unit:MicroSV, unit:MicroSV, unit:MilliR_man, unit:MilliR_man,
    unit:MilliSV, unit:MilliSV, unit:REM, unit:REM, unit:R_man, unit:R_man, unit:SV, unit:SV,
    unit:NanoSV .

