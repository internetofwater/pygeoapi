unit:PERMEABILITY_REL a qudt:Unit, qudt:Unit;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/unit>, <http://qudt.org/vocab/unit>;
  rdfs:label "Relative Permeability"@en, "Relative Permeability"@en;
  dct:description "In multiphase flow in porous media, the relative permeability of a phase is a dimensionless measure of the effective permeability of that phase. It is the ratio of the effective permeability of that phase to the absolute permeability. It can be viewed as an adaptation of Darcy's law to multiphase flow. For two-phase flow in porous media given steady-state conditions, we can write where is the flux, is the pressure drop, is the viscosity."^^qudt:LatexString,
    "In multiphase flow in porous media, the relative permeability of a phase is a dimensionless measure of the effective permeability of that phase. It is the ratio of the effective permeability of that phase to the absolute permeability. It can be viewed as an adaptation of Darcy's law to multiphase flow. For two-phase flow in porous media given steady-state conditions, we can write where is the flux, is the pressure drop, is the viscosity."^^qudt:LatexString;
  qudt:applicableSystem <http://qudt.org/vocab/sou/CGS-EMU>, <http://qudt.org/vocab/sou/CGS-EMU>;
  qudt:conversionMultiplier 0.00000125663706, 0.00000125663706;
  qudt:conversionMultiplierSN 1.25663706E-6, 1.25663706E-6;
  qudt:dbpediaMatch "http://dbpedia.org/resource/Relative_permeability"^^xsd:anyURI,
    "http://dbpedia.org/resource/Relative_permeability"^^xsd:anyURI;
  qudt:hasDimensionVector dimensionvector:A0E0L0I0M0H0T0D1, dimensionvector:A0E0L0I0M0H0T0D1;
  qudt:hasQuantityKind quantitykind:PermeabilityRatio, quantitykind:PermeabilityRatio;
  qudt:informativeReference "http://en.wikipedia.org/wiki/Relative_permeability"^^xsd:anyURI,
    "http://en.wikipedia.org/wiki/Relative_permeability"^^xsd:anyURI;
  qudt:symbol "kᵣ", "kᵣ";
  qudt:derivedUnitOfSystem <http://qudt.org/vocab/sou/CGS-EMU>, <http://qudt.org/vocab/sou/CGS-EMU> .

