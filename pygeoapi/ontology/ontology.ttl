  <http://qudt.org/schema/qudt/conversionMultiplierSN> 1.0E0;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L-2I0M0H0T-1D0>;
  <http://qudt.org/schema/qudt/hasQuantityKind> <http://qudt.org/vocab/quantitykind/Unknown>;
  <http://qudt.org/schema/qudt/iec61360Code> "0112/2///62720#UAA977";
  <http://qudt.org/schema/qudt/informativeReference> "https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAA977"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/symbol> "/(s·sr·m²)";
  <http://qudt.org/schema/qudt/ucumCode> "s-1.sr-1.m-2"^^<http://qudt.org/schema/qudt/UCUMcs>;
  <http://qudt.org/schema/qudt/uneceCommonCode> "D2" .

