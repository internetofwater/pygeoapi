  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Temperature Amount of Substance"@en;
  rdfs:comment "Applicable units are those of quantitykind:TemperatureAmountOfSubstance";
