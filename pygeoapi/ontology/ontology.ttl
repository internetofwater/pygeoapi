quantitykind:LuminousFluxPerArea a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "Luminous Flux per Area"@en, "Luminous Flux per Area"@en;
  rdfs:comment "Applicable units are those of quantitykind:LuminousFluxPerArea", "Applicable units are those of quantitykind:LuminousFluxPerArea";
  dct:description "In photometry, illuminance is the total luminous flux incident on a surface, per unit area. It is a measure of how much the incident light illuminates the surface, wavelength-weighted by the luminosity function to correlate with human brightness perception. Similarly, luminous emittance is the luminous flux per unit area emitted from a surface. In SI derived units these are measured in $lux (lx)$ or $lumens per square metre$ ($cd \\cdot m^{-2}$). In the CGS system, the unit of illuminance is the $phot$, which is equal to $10,000 lux$. The $foot-candle$ is a non-metric unit of illuminance that is used in photography."^^qudt:LatexString,
    "In photometry, illuminance is the total luminous flux incident on a surface, per unit area. It is a measure of how much the incident light illuminates the surface, wavelength-weighted by the luminosity function to correlate with human brightness perception. Similarly, luminous emittance is the luminous flux per unit area emitted from a surface. In SI derived units these are measured in $lux (lx)$ or $lumens per square metre$ ($cd \\cdot m^{-2}$). In the CGS system, the unit of illuminance is the $phot$, which is equal to $10,000 lux$. The $foot-candle$ is a non-metric unit of illuminance that is used in photography."^^qudt:LatexString;
  qudt:hasDimensionVector dimensionvector:A0E0L-2I1M0H0T0D0, dimensionvector:A0E0L-2I1M0H0T0D0;
  qudt:informativeReference "http://en.wikipedia.org/wiki/Illuminance"^^xsd:anyURI,
    "http://en.wikipedia.org/wiki/Illuminance"^^xsd:anyURI;
  qudt:applicableUnit unit:FC, unit:FC, unit:LUX, unit:LUX, unit:PHOT, unit:PHOT .

