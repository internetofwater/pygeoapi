        [ qudt:exponent -1 ;
            qudt:hasUnit unit:DAY ],
        [ qudt:exponent 1 ;
            qudt:hasUnit unit:M ] ;
    qudt:hasQuantityKind quantitykind:LinearVelocity,
        quantitykind:Velocity ;
    qudt:symbol "m/d" ;
    qudt:ucumCode "m.d-1"^^qudt:UCUMcs,
        "m/d"^^qudt:UCUMcs ;
    rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/unit>,
