quantitykind:Acidity a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:seeAlso quantitykind:Basicity, quantitykind:Basicity;
  rdfs:label "Acidity"@en, "Acidity"@en;
  rdfs:comment "Applicable units are those of quantitykind:Acidity", "Applicable units are those of quantitykind:Acidity";
  dct:description """
  Chemicals or substances having a pH less than 7 are said to be acidic;
   lower pH means higher acidity.
  """^^qudt:LatexString,
    """
  Chemicals or substances having a pH less than 7 are said to be acidic;
   lower pH means higher acidity.
