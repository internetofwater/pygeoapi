  rdfs:label "Linear Strain"@en, "Linear Strain"@en;
  rdfs:comment "Applicable units are those of quantitykind:LengthRatio", "Applicable units are those of quantitykind:LengthRatio";
  dct:description "A strain is a normalized measure of deformation representing the displacement between particles in the body relative to a reference length."^^qudt:LatexString,
    "A strain is a normalized measure of deformation representing the displacement between particles in the body relative to a reference length."^^qudt:LatexString;
  skos:broader quantitykind:LengthRatio, quantitykind:LengthRatio;
  qudt:hasDimensionVector dimensionvector:A0E0L0I0M0H0T0D1, dimensionvector:A0E0L0I0M0H0T0D1;
