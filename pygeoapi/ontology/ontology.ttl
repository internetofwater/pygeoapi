unit:M-PER-HR a qudt:DerivedUnit,
        qudt:Unit ;
    rdfs:label "Metre per Hour"@en,
        "Meter per Hour"@en-US ;
    dct:description "Metre per hour is a metric unit of both speed (scalar) and velocity (Vector (geometry)). Its symbol is m/h or mu00b7h-1 (not to be confused with the imperial unit symbol mph. By definition, an object travelling at a speed of 1 m/h for an hour would move 1 metre."^^rdf:HTML ;
