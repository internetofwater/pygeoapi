  qudt:conversionMultiplierSN 3.636872E-2, 3.636872E-2;
  qudt:dbpediaMatch "http://dbpedia.org/resource/Bushel"^^xsd:anyURI, "http://dbpedia.org/resource/Bushel"^^xsd:anyURI;
  qudt:hasDimensionVector dimensionvector:A0E0L3I0M0H0T0D0, dimensionvector:A0E0L3I0M0H0T0D0;
  qudt:hasQuantityKind quantitykind:DryVolume, quantitykind:DryVolume;
