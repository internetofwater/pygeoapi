unit:A-PER-CentiM a <http://qudt.org/schema/qudt/Unit>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/unit>;
  rdfs:label "Ampere per Centimeter"@en-US, "Ampere per Centimetre"@en;
  dct:description "SI base unit ampere divided by the 0.01-fold of the SI base unit metre"^^rdf:HTML;
  <http://qudt.org/schema/qudt/applicableSystem> <http://qudt.org/vocab/sou/CGS-EMU>,
