variablename:curvature a skos:Concept;
  skos:definition "Curvature of a DEM measures the shape or curvature of the slope. A part of a surface can be concave or convex; you can tell that by looking at the curvature value. The curvature is calculated by computing the second derivative of the surface.";
  skos:topConceptOf <http://vocabulary.odm2.org/variablename>;
  skos:prefLabel "Curvature";
  skos:note "Added to support Critical Zone Observatory (CZO) data use cases. ";
