    "https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAA226"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/symbol> "Mbit/s";
  <http://qudt.org/schema/qudt/ucumCode> "MBd"^^<http://qudt.org/schema/qudt/UCUMcs>,
    "Mbit/s"^^<http://qudt.org/schema/qudt/UCUMcs>;
  <http://qudt.org/schema/qudt/uneceCommonCode> "E20" .

