unit:W-PER-M2-K a qudt:Unit, qudt:Unit, qudt:DerivedUnit, qudt:DerivedUnit;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/unit>, <http://qudt.org/vocab/unit>;
  rdfs:label "Watt per Square Meter Kelvin"@en-US, "Watt per Square Meter Kelvin"@en-US,
    "Watt per Square Metre Kelvin"@en, "Watt per Square Metre Kelvin"@en;
  dct:description """
  The unit $\\textit{Watt Per Square Meter Kelvin }$ ($W m^{-2} K^{-1}$) is a unit in the category of Thermal heat transfer coefficient. 
  It is also known as $\\textit{watt/square meter-kelvin}$. 
  This unit is commonly used in the SI unit system. 
  $\\textit{Watt Per Square Meter Kelvin }$ has a dimension of $MT^{-1}Q^{-1}$ where $M$ is mass, $T$ is time, and $Q$ is temperature. 
  This unit is the standard SI unit in this category.
  """^^qudt:LatexString,
    """
  The unit $\\textit{Watt Per Square Meter Kelvin }$ ($W m^{-2} K^{-1}$) is a unit in the category of Thermal heat transfer coefficient. 
  It is also known as $\\textit{watt/square meter-kelvin}$. 
  This unit is commonly used in the SI unit system. 
  $\\textit{Watt Per Square Meter Kelvin }$ has a dimension of $MT^{-1}Q^{-1}$ where $M$ is mass, $T$ is time, and $Q$ is temperature. 
  This unit is the standard SI unit in this category.
  """^^qudt:LatexString;
  qudt:applicableSystem <http://qudt.org/vocab/sou/SI>, <http://qudt.org/vocab/sou/SI>;
  qudt:conversionMultiplier 1.0, 1.0;
  qudt:conversionMultiplierSN 1.0E0, 1.0E0;
  qudt:hasDimensionVector dimensionvector:A0E0L0I0M1H-1T-3D0, dimensionvector:A0E0L0I0M1H-1T-3D0;
  qudt:hasQuantityKind quantitykind:CoefficientOfHeatTransfer, quantitykind:CoefficientOfHeatTransfer,
    quantitykind:CombinedNonEvaporativeHeatTransferCoefficient, quantitykind:CombinedNonEvaporativeHeatTransferCoefficient,
    quantitykind:SurfaceCoefficientOfHeatTransfer, quantitykind:SurfaceCoefficientOfHeatTransfer;
  qudt:iec61360Code "0112/2///62720#UAA311", "0112/2///62720#UAA311";
  qudt:informativeReference "https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAA311"^^xsd:anyURI,
    "https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAA311"^^xsd:anyURI;
  qudt:symbol "W/(m²·K)", "W/(m²·K)";
  qudt:ucumCode "W.m-2.K-1"^^qudt:UCUMcs, "W.m-2.K-1"^^qudt:UCUMcs;
  qudt:uneceCommonCode "D55", "D55";
  qudt:expression "$W/(m^{2}-K)$"^^qudt:LatexString, "$W/(m^{2}-K)$"^^qudt:LatexString;
  qudt:derivedCoherentUnitOfSystem <http://qudt.org/vocab/sou/SI>, <http://qudt.org/vocab/sou/SI>;
  qudt:definedUnitOfSystem <http://qudt.org/vocab/sou/SI>, <http://qudt.org/vocab/sou/SI>;
  qudt:hasFactorUnit _:b1cb43fcbd504833bf8a964862c3127019205, _:b1cb43fcbd504833bf8a964862c3127019206,
    _:b1cb43fcbd504833bf8a964862c3127019207 .

