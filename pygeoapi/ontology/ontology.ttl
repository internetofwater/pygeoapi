<http://qudt.org/vocab/quantitykind/Incidence> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Incidence"@en;
  rdfs:comment "Applicable units are those of quantitykind:Incidence";
  dct:description "In epidemiology, incidence is a measure of the probability of occurrence of a given medical condition in a population within a specified period of time."^^<http://qudt.org/schema/qudt/LatexString>;
  skos:broader <http://qudt.org/vocab/quantitykind/Frequency>;
