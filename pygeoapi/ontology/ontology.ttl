    skos:topConceptOf <http://vocabulary.odm2.org/variablename> .

variablename:radon_222 a skos:Concept ;
    skos:definition "An isotope of radon" ;
    skos:historyNote "Originally from the CUAHSI HIS VariableNameCV.  See: http://his.cuahsi.org/mastercvreg/edit_cv11.aspx?tbl=VariableNameCV." ;
    skos:inScheme <http://vocabulary.odm2.org/variablename> ;
    skos:prefLabel "Radon-222" ;
    skos:topConceptOf <http://vocabulary.odm2.org/variablename> .

variablename:rainfallRate a skos:Concept ;
    skos:definition "A measure of the intensity of rainfall, calculated as the depth of water to fall over a given time period if the intensity were to remain constant over that time interval (in/hr, mm/hr, etc)" ;
    skos:historyNote "Originally from the CUAHSI HIS VariableNameCV.  See: http://his.cuahsi.org/mastercvreg/edit_cv11.aspx?tbl=VariableNameCV." ;
    skos:inScheme <http://vocabulary.odm2.org/variablename> ;
    skos:prefLabel "Rainfall rate" ;
    skos:topConceptOf <http://vocabulary.odm2.org/variablename> .

variablename:realDielectricConstant a skos:Concept ;
    skos:definition "Soil reponse of a reflected standing electromagnetic wave of a particular frequency which is related to the stored energy within the medium. This is the real portion of the complex dielectric constant." ;
    skos:historyNote "Originally from the CUAHSI HIS VariableNameCV.  See: http://his.cuahsi.org/mastercvreg/edit_cv11.aspx?tbl=VariableNameCV." ;
    skos:inScheme <http://vocabulary.odm2.org/variablename> ;
    skos:prefLabel "Real dielectric constant" ;
    skos:topConceptOf <http://vocabulary.odm2.org/variablename> .

variablename:receivedSignalStrenghtIndication a skos:Concept ;
    ns3:category "Level" ;
    skos:definition "In telecommunications, received signal strength indicator (RSSI) is a measurement of the power present in a received radio signal." ;
    skos:exactMatch "https://en.wikipedia.org/wiki/Received_signal_strength_indication" ;
    skos:historyNote "Wikipedia" ;
    skos:inScheme <http://vocabulary.odm2.org/variablename> ;
    skos:prefLabel "Received signal strength indication" ;
    skos:topConceptOf <http://vocabulary.odm2.org/variablename> .

variablename:rechargeGroundwater a skos:Concept ;
    skos:definition "Groundwater recharge or deep drainage or deep percolation is a hydrologic process where water moves downward from surface water to groundwater. Recharge is the primary method through which water enters an aquifer. This process usually occurs in the vadose zone below plant roots and is often expressed as a flux to the water table surface. Recharge occurs both naturally (through the water cycle) and through anthropogenic processes (i.e., \"artificial groundwater recharge\"), where rainwater and or reclaimed water is routed to the subsurface." ;
    skos:exactMatch "https://en.wikipedia.org/wiki/Groundwater_recharge" ;
    skos:historyNote "Wikipedia" ;
    skos:inScheme <http://vocabulary.odm2.org/variablename> ;
    skos:note "Added to support Critical Zone Observatory (CZO) data use cases. " ;
    skos:prefLabel "Recharge, groundwater " ;
    skos:topConceptOf <http://vocabulary.odm2.org/variablename> .

variablename:recorderCode a skos:Concept ;
    skos:definition "A code used to identifier a data recorder." ;
    skos:historyNote "Originally from the CUAHSI HIS VariableNameCV.  See: http://his.cuahsi.org/mastercvreg/edit_cv11.aspx?tbl=VariableNameCV." ;
    skos:inScheme <http://vocabulary.odm2.org/variablename> ;
    skos:prefLabel "Recorder code" ;
    skos:topConceptOf <http://vocabulary.odm2.org/variablename> .

variablename:reflectivity a skos:Concept ;
    skos:definition "dBZ stands for decibel relative to Z. It is a logarithmic dimensionless technical unit used in radar, mostly in weather radar, to compare the equivalent reflectivity factor (Z) of a radar signal reflected off a remote object (in mm6 per m3) to the return of a droplet of rain with a diameter of 1 mm (1 mm6 per m3). It is proportional to the number of drops per unit volume and the sixth power of drops' diameter and is thus used to estimate the rain or snow intensity." ;
    skos:exactMatch "https://en.wikipedia.org/wiki/DBZ_(meteorology)" ;
    skos:historyNote "Wikipedia" ;
    skos:inScheme <http://vocabulary.odm2.org/variablename> ;
    skos:note "Added to support Critical Zone Observatory (CZO) data use cases. " ;
    skos:prefLabel "Reflectivity" ;
    skos:topConceptOf <http://vocabulary.odm2.org/variablename> .

variablename:remark a skos:Concept ;
    skos:definition "Manually added comment field to provide additional information about a particular record." ;
    skos:historyNote "Originally from the CUAHSI HIS VariableNameCV.  See: http://his.cuahsi.org/mastercvreg/edit_cv11.aspx?tbl=VariableNameCV." ;
    skos:inScheme <http://vocabulary.odm2.org/variablename> ;
    skos:prefLabel "Remark" ;
    skos:topConceptOf <http://vocabulary.odm2.org/variablename> .

variablename:resistivityElectrical a skos:Concept ;
    skos:definition "The electrical resistance of an object is a measure of its opposition to the flow of electric current. The inverse quantity is electrical conductance, and is the ease with which an electric current passes." ;
    skos:exactMatch "https://en.wikipedia.org/wiki/Electrical_resistance_and_conductance" ;
    skos:historyNote "Wikipedia" ;
    skos:inScheme <http://vocabulary.odm2.org/variablename> ;
    skos:note "Added to support Critical Zone Observatory (CZO) data use cases. " ;
    skos:prefLabel "Resistivity, electrical" ;
    skos:topConceptOf <http://vocabulary.odm2.org/variablename> .

variablename:respirationEcosystem a skos:Concept ;
    skos:definition "Gross carbon dioxide production by all organisms in an ecosystem. Ecosystem respiration is the sum of all respiration occurring by the living organisms in a specific ecosystem." ;
    skos:historyNote "Originally from the CUAHSI HIS VariableNameCV.  See: http://his.cuahsi.org/mastercvreg/edit_cv11.aspx?tbl=VariableNameCV." ;
    skos:inScheme <http://vocabulary.odm2.org/variablename> ;
    skos:prefLabel "Respiration, ecosystem" ;
    skos:topConceptOf <http://vocabulary.odm2.org/variablename> .

variablename:respirationNet a skos:Concept ;
    skos:definition "Net respiration" ;
    skos:historyNote "Originally from the CUAHSI HIS VariableNameCV.  See: http://his.cuahsi.org/mastercvreg/edit_cv11.aspx?tbl=VariableNameCV." ;
    skos:inScheme <http://vocabulary.odm2.org/variablename> ;
    skos:prefLabel "Respiration, net" ;
    skos:topConceptOf <http://vocabulary.odm2.org/variablename> .

variablename:retene a skos:Concept ;
    skos:definition "Retene (C18H18), a polycyclic aromatic hydrocarbon (PAH), also known as methyl isopropyl phenanthrene or 1-methyl-7-isopropyl phenanthrene" ;
    skos:historyNote "Originally from the CUAHSI HIS VariableNameCV.  See: http://his.cuahsi.org/mastercvreg/edit_cv11.aspx?tbl=VariableNameCV." ;
    skos:inScheme <http://vocabulary.odm2.org/variablename> ;
    skos:prefLabel "Retene" ;
    skos:topConceptOf <http://vocabulary.odm2.org/variablename> .

variablename:rheniumTotal a skos:Concept ;
    skos:definition "Total Rhenium (Re)" ;
    skos:historyNote "Originally from the CUAHSI HIS VariableNameCV.  See: http://his.cuahsi.org/mastercvreg/edit_cv11.aspx?tbl=VariableNameCV." ;
    skos:inScheme <http://vocabulary.odm2.org/variablename> ;
    skos:prefLabel "Rhenium, total" ;
    skos:topConceptOf <http://vocabulary.odm2.org/variablename> .

variablename:roundness a skos:Concept ;
    skos:definition "Roundness is the measure of how closely the shape of an object approaches that of a mathematically perfect circle. Roundness applies in two dimensions, such as the cross sectional circles along a cylindrical object such as a shaft or a cylindrical roller for a bearing. In geometric dimensioning and tolerancing, control of a cylinder can also include its fidelity to the longitudinal axis, yielding cylindricity. The analogue of roundness in three dimensions (that is, for spheres) is sphericity." ;
    skos:exactMatch "https://en.wikipedia.org/wiki/Roundness_(object)" ;
    skos:historyNote "Wikipedia" ;
    skos:inScheme <http://vocabulary.odm2.org/variablename> ;
    skos:note "Added to support Critical Zone Observatory (CZO) data use cases. " ;
    skos:prefLabel "Roundness" ;
    skos:topConceptOf <http://vocabulary.odm2.org/variablename> .

variablename:rubidium a skos:Concept ;
    skos:definition "A chemical element with symbol Rb and atomic number 37. Rubidium is a soft, silvery-white metallic element of the alkali metal group, with a standard atomic weight of 85.4678. Elemental rubidium is highly reactive, with properties similar to those of other alkali metals, including rapid oxidation in air. On Earth, natural rubidium comprises two isotopes: 72% is the stable isotope, 85Rb; 28% is the slightly radioactive 87Rb, with a half-life of 49 billion years—more than three times longer than the estimated age of the universe." ;
    skos:exactMatch "https://en.wikipedia.org/wiki/Rubidium" ;
    skos:historyNote "Wikipedia" ;
    skos:inScheme <http://vocabulary.odm2.org/variablename> ;
    skos:note "Added to support Critical Zone Observatory (CZO) data use cases. " ;
    skos:prefLabel "Rubidium" ;
    skos:topConceptOf <http://vocabulary.odm2.org/variablename> .

variablename:ruthenium_106 a skos:Concept ;
    skos:definition "The most stable isotope of ruthenium with a half life of 373.59 days." ;
    skos:historyNote "Originally from the CUAHSI HIS VariableNameCV.  See: http://his.cuahsi.org/mastercvreg/edit_cv11.aspx?tbl=VariableNameCV." ;
    skos:inScheme <http://vocabulary.odm2.org/variablename> ;
    skos:prefLabel "Ruthenium-106" ;
    skos:topConceptOf <http://vocabulary.odm2.org/variablename> .

variablename:salicorniaBigeloviiCoverage a skos:Concept ;
    skos:definition "Areal coverage of the plant Salicornia bigelovii" ;
    skos:historyNote "Originally from the CUAHSI HIS VariableNameCV.  See: http://his.cuahsi.org/mastercvreg/edit_cv11.aspx?tbl=VariableNameCV." ;
    skos:inScheme <http://vocabulary.odm2.org/variablename> ;
    skos:prefLabel "Salicornia bigelovii coverage" ;
    skos:topConceptOf <http://vocabulary.odm2.org/variablename> .

variablename:salicorniaVirginicaCoverage a skos:Concept ;
    skos:definition "Areal coverage of the plant Salicornia virginica" ;
    skos:historyNote "Originally from the CUAHSI HIS VariableNameCV.  See: http://his.cuahsi.org/mastercvreg/edit_cv11.aspx?tbl=VariableNameCV." ;
    skos:inScheme <http://vocabulary.odm2.org/variablename> ;
    skos:prefLabel "Salicornia virginica coverage" ;
    skos:topConceptOf <http://vocabulary.odm2.org/variablename> .

variablename:samarium a skos:Concept ;
    skos:definition "A chemical element with symbol Sm and atomic number 62. It is a moderately hard silvery metal that slowly oxidizes in air. Being a typical member of the lanthanide series, samarium usually assumes the oxidation state +3." ;
    skos:exactMatch "https://en.wikipedia.org/wiki/Samarium" ;
    skos:historyNote "Wikipedia" ;
    skos:inScheme <http://vocabulary.odm2.org/variablename> ;
    skos:note "Added to support Critical Zone Observatory (CZO) data use cases. " ;
    skos:prefLabel "Samarium" ;
    skos:topConceptOf <http://vocabulary.odm2.org/variablename> .

variablename:samariumDissolved a skos:Concept ;
    skos:definition "Dissolved Samarium (Sm). \"Dissolved \" indicates a the measurement was made on a filtered sample." ;
    skos:exactMatch "https://en.wikipedia.org/wiki/Samarium" ;
    skos:historyNote "Wikipedia" ;
    skos:inScheme <http://vocabulary.odm2.org/variablename> ;
    skos:note "Added to support Critical Zone Observatory (CZO) data use cases. " ;
    skos:prefLabel "Samarium, dissolved" ;
    skos:topConceptOf <http://vocabulary.odm2.org/variablename> .

variablename:sapFlow a skos:Concept ;
    skos:definition "Movement of xylem sap in trees." ;
    skos:exactMatch "http://his.cuahsi.org/mastercvreg/edit_cv11.aspx?tbl=VariableNameCV&id=1157579162" ;
    skos:inScheme <http://vocabulary.odm2.org/variablename> ;
    skos:note "Added to support Critical Zone Observatory (CZO) data use cases. " ;
    skos:prefLabel "Sap flow" ;
    skos:topConceptOf <http://vocabulary.odm2.org/variablename> .

variablename:scandium a skos:Concept ;
    skos:definition "A chemical element with symbol Sc and atomic number 21. A silvery-white metallic d-block element, it has historically been classified as a rare-earth element, together with yttrium and the lanthanides. It was discovered in 1879 by spectral analysis of the minerals euxenite and gadolinite from Scandinavia." ;
    skos:exactMatch "https://en.wikipedia.org/wiki/Scandium" ;
    skos:historyNote "Wikipedia" ;
    skos:inScheme <http://vocabulary.odm2.org/variablename> ;
    skos:note "Added to support Critical Zone Observatory (CZO) data use cases. " ;
    skos:prefLabel "Scandium" ;
    skos:topConceptOf <http://vocabulary.odm2.org/variablename> .

variablename:scatterAntiStokes a skos:Concept ;
    skos:definition "The material loses energy and the emitted photon has a higher energy than the absorbed photon. This outcome is labeled anti-Stokes Raman scattering." ;
    skos:exactMatch "https://en.wikipedia.org/wiki/Raman_scattering#Stokes_and_anti-Stokes" ;
    skos:historyNote "Wikipedia" ;
    skos:inScheme <http://vocabulary.odm2.org/variablename> ;
    skos:note "Added to support Critical Zone Observatory (CZO) data use cases. " ;
    skos:prefLabel "Scatter, anti-stokes" ;
    skos:topConceptOf <http://vocabulary.odm2.org/variablename> .

variablename:scatterStokes a skos:Concept ;
    skos:definition "The material absorbs energy and the emitted photon has a lower energy than the incident photon. This outcome is labeled Stokes Raman scattering in honor of George Stokes who showed in 1852 that fluorescence is due to light emission at longer wavelength (now known to correspond to lower energy) than the absorbed incident light." ;
    skos:exactMatch "https://en.wikipedia.org/wiki/Raman_scattering#Stokes_and_anti-Stokes" ;
    skos:historyNote "Wikipedia" ;
    skos:inScheme <http://vocabulary.odm2.org/variablename> ;
    skos:note "Added to support Critical Zone Observatory (CZO) data use cases. " ;
    skos:prefLabel "Scatter, Stokes" ;
    skos:topConceptOf <http://vocabulary.odm2.org/variablename> .

variablename:secchiDepth a skos:Concept ;
    skos:definition "Secchi depth" ;
    skos:historyNote "Originally from the CUAHSI HIS VariableNameCV.  See: http://his.cuahsi.org/mastercvreg/edit_cv11.aspx?tbl=VariableNameCV." ;
    skos:inScheme <http://vocabulary.odm2.org/variablename> ;
    skos:prefLabel "Secchi depth" ;
    skos:topConceptOf <http://vocabulary.odm2.org/variablename> .

variablename:sedimentPassingSieve a skos:Concept ;
    skos:definition "The amount of sediment passing a sieve in a gradation test" ;
    skos:historyNote "Originally from the CUAHSI HIS VariableNameCV.  See: http://his.cuahsi.org/mastercvreg/edit_cv11.aspx?tbl=VariableNameCV." ;
    skos:inScheme <http://vocabulary.odm2.org/variablename> ;
    skos:prefLabel "Sediment, passing sieve" ;
    skos:topConceptOf <http://vocabulary.odm2.org/variablename> .

variablename:sedimentRetainedOnSieve a skos:Concept ;
    skos:definition "The amount of sediment retained on a sieve in a gradation test" ;
    skos:historyNote "Originally from the CUAHSI HIS VariableNameCV.  See: http://his.cuahsi.org/mastercvreg/edit_cv11.aspx?tbl=VariableNameCV." ;
    skos:inScheme <http://vocabulary.odm2.org/variablename> ;
    skos:prefLabel "Sediment, retained on sieve" ;
    skos:topConceptOf <http://vocabulary.odm2.org/variablename> .

variablename:sedimentSuspended a skos:Concept ;
    skos:definition "Suspended Sediment" ;
    skos:historyNote "Originally from the CUAHSI HIS VariableNameCV.  See: http://his.cuahsi.org/mastercvreg/edit_cv11.aspx?tbl=VariableNameCV." ;
    skos:inScheme <http://vocabulary.odm2.org/variablename> ;
    skos:prefLabel "Sediment, suspended" ;
    skos:topConceptOf <http://vocabulary.odm2.org/variablename> .

variablename:seismicRefraction a skos:Concept ;
    skos:definition "Seismic refraction is a geophysical principle (see refraction) governed by Snell's Law. Used in the fields of engineering geology, geotechnical engineering and exploration geophysics, seismic refraction traverses (seismic lines) are performed using a seismograph(s) and/or geophone(s), in an array and an energy source." ;
    skos:exactMatch "https://en.wikipedia.org/wiki/Seismic_refraction" ;
    skos:historyNote "Wikipedia" ;
    skos:inScheme <http://vocabulary.odm2.org/variablename> ;
    skos:note "Added to support Critical Zone Observatory (CZO) data use cases. " ;
    skos:prefLabel "Seismic refraction" ;
    skos:topConceptOf <http://vocabulary.odm2.org/variablename> .

variablename:seleniumDissolved a skos:Concept ;
    skos:definition "Dissolved selenium (Se). For chemical terms, dissolved indicates a filtered sample." ;
    skos:historyNote "Originally from the CUAHSI HIS VariableNameCV.  See: http://his.cuahsi.org/mastercvreg/edit_cv11.aspx?tbl=VariableNameCV." ;
    skos:inScheme <http://vocabulary.odm2.org/variablename> ;
    skos:prefLabel "Selenium, dissolved" ;
    skos:topConceptOf <http://vocabulary.odm2.org/variablename> .

variablename:seleniumDistributionCoefficient a skos:Concept ;
    skos:definition "Ratio of concentrations of selenium in two phases in equilibrium with each other. Phases must be specified." ;
    skos:historyNote "Originally from the CUAHSI HIS VariableNameCV.  See: http://his.cuahsi.org/mastercvreg/edit_cv11.aspx?tbl=VariableNameCV." ;
    skos:inScheme <http://vocabulary.odm2.org/variablename> ;
    skos:prefLabel "Selenium, distribution coefficient" ;
    skos:topConceptOf <http://vocabulary.odm2.org/variablename> .

variablename:seleniumParticulate a skos:Concept ;
    skos:definition "Particulate selenium (Se) in suspension" ;
    skos:historyNote "Originally from the CUAHSI HIS VariableNameCV.  See: http://his.cuahsi.org/mastercvreg/edit_cv11.aspx?tbl=VariableNameCV." ;
    skos:inScheme <http://vocabulary.odm2.org/variablename> ;
    skos:prefLabel "Selenium, particulate" ;
    skos:topConceptOf <http://vocabulary.odm2.org/variablename> .

variablename:seleniumTotal a skos:Concept ;
    skos:definition "Total Selenium (Se). For chemical terms, total indicates an unfiltered sample" ;
    skos:historyNote "Originally from the CUAHSI HIS VariableNameCV.  See: http://his.cuahsi.org/mastercvreg/edit_cv11.aspx?tbl=VariableNameCV." ;
    skos:inScheme <http://vocabulary.odm2.org/variablename> ;
    skos:prefLabel "Selenium, total" ;
    skos:topConceptOf <http://vocabulary.odm2.org/variablename> .

variablename:sensibleHeatFlux a skos:Concept ;
    skos:definition "Sensible Heat Flux" ;
    skos:historyNote "Originally from the CUAHSI HIS VariableNameCV.  See: http://his.cuahsi.org/mastercvreg/edit_cv11.aspx?tbl=VariableNameCV." ;
    skos:inScheme <http://vocabulary.odm2.org/variablename> ;
    skos:prefLabel "Sensible heat flux" ;
    skos:topConceptOf <http://vocabulary.odm2.org/variablename> .

variablename:sequenceNumber a skos:Concept ;
    skos:definition "A counter of events in a sequence" ;
    skos:historyNote "Originally from the CUAHSI HIS VariableNameCV.  See: http://his.cuahsi.org/mastercvreg/edit_cv11.aspx?tbl=VariableNameCV." ;
    skos:inScheme <http://vocabulary.odm2.org/variablename> ;
    skos:prefLabel "Sequence number" ;
    skos:topConceptOf <http://vocabulary.odm2.org/variablename> .

variablename:shannonDiversityIndex a skos:Concept ;
    skos:definition "A diversity index that is based on the number of taxa, and the proportion of individuals in each taxa relative to the entire community, evaluated as entropy. Also known as Shannon-Weaver diversity index, the Shannon-Wiener index, the Shannon index and the Shannon entropy." ;
    skos:historyNote "Originally from the CUAHSI HIS VariableNameCV.  See: http://his.cuahsi.org/mastercvreg/edit_cv11.aspx?tbl=VariableNameCV." ;
    skos:inScheme <http://vocabulary.odm2.org/variablename> ;
    skos:prefLabel "Shannon diversity index" ;
    skos:topConceptOf <http://vocabulary.odm2.org/variablename> .

variablename:shannonEvennessIndex a skos:Concept ;
    skos:definition "A dimensionless diversity index, calculated as a ratio of the Shannon diversity index over its maximum. Also known as the Shannon Weaver evenness index" ;
    skos:historyNote "Originally from the CUAHSI HIS VariableNameCV.  See: http://his.cuahsi.org/mastercvreg/edit_cv11.aspx?tbl=VariableNameCV." ;
    skos:inScheme <http://vocabulary.odm2.org/variablename> ;
    skos:prefLabel "Shannon evenness index" ;
    skos:topConceptOf <http://vocabulary.odm2.org/variablename> .

variablename:sigma_t a skos:Concept ;
    skos:definition "Density of seawater calculated with in situ salinity and temperature, but pressure equal to zero, rather than the in situ pressure, and 1000 kg/m^3 is subtracted. Defined as (S,T)-1000 kg m-3, where (S,T) is the density of a sample of seawater at temperature T and salinity S, measured in kg m-3, at standard atmospheric pressure." ;
    skos:historyNote "Originally from the CUAHSI HIS VariableNameCV.  See: http://his.cuahsi.org/mastercvreg/edit_cv11.aspx?tbl=VariableNameCV." ;
    skos:inScheme <http://vocabulary.odm2.org/variablename> ;
    skos:prefLabel "Sigma-t" ;
    skos:topConceptOf <http://vocabulary.odm2.org/variablename> .

variablename:signalQuality a skos:Concept ;
    skos:definition "Internal signature measurent quality" ;
    skos:exactMatch "https://tech.africa/the-difference-between-signal-strength-and-quality/" ;
    skos:inScheme <http://vocabulary.odm2.org/variablename> ;
    skos:note "Added to support Critical Zone Observatory (CZO) data use cases. " ;
    skos:prefLabel "Signal quality" ;
    skos:topConceptOf <http://vocabulary.odm2.org/variablename> .

variablename:signalToNoiseRatio a skos:Concept ;
    skos:definition "Signal-to-noise ratio (often abbreviated SNR or S/N) is defined as the ratio of a signal power to the noise power corrupting the signal. The higher the ratio, the less obtrusive the background noise is." ;
    skos:historyNote "Originally from the CUAHSI HIS VariableNameCV.  See: http://his.cuahsi.org/mastercvreg/edit_cv11.aspx?tbl=VariableNameCV." ;
    skos:inScheme <http://vocabulary.odm2.org/variablename> ;
    skos:prefLabel "Signal-to-noise ratio" ;
    skos:topConceptOf <http://vocabulary.odm2.org/variablename> .

variablename:silica a skos:Concept ;
    skos:definition "Silica (SiO2)" ;
    skos:historyNote "Originally from the CUAHSI HIS VariableNameCV.  See: http://his.cuahsi.org/mastercvreg/edit_cv11.aspx?tbl=VariableNameCV." ;
    skos:inScheme <http://vocabulary.odm2.org/variablename> ;
    skos:prefLabel "Silica" ;
    skos:topConceptOf <http://vocabulary.odm2.org/variablename> .

variablename:silicaDissolved a skos:Concept ;
    skos:definition "Dissolved silica (SiO2)" ;
    skos:historyNote "Originally from the CUAHSI HIS VariableNameCV.  See: http://his.cuahsi.org/mastercvreg/edit_cv11.aspx?tbl=VariableNameCV." ;
    skos:inScheme <http://vocabulary.odm2.org/variablename> ;
    skos:prefLabel "Silica, dissolved" ;
    skos:topConceptOf <http://vocabulary.odm2.org/variablename> .

variablename:silicate a skos:Concept ;
    skos:definition "Silicate. Chemical compound containing silicon, oxygen, and one or more metals, e.g., aluminum, barium, beryllium, calcium, iron, magnesium, manganese, potassium, sodium, or zirconium." ;
    skos:historyNote "Originally from the CUAHSI HIS VariableNameCV.  See: http://his.cuahsi.org/mastercvreg/edit_cv11.aspx?tbl=VariableNameCV." ;
    skos:inScheme <http://vocabulary.odm2.org/variablename> ;
    skos:prefLabel "Silicate" ;
    skos:topConceptOf <http://vocabulary.odm2.org/variablename> .

variablename:silicicAcid a skos:Concept ;
    skos:definition "Hydrated silica disolved in water" ;
    skos:historyNote "Originally from the CUAHSI HIS VariableNameCV.  See: http://his.cuahsi.org/mastercvreg/edit_cv11.aspx?tbl=VariableNameCV." ;
    skos:inScheme <http://vocabulary.odm2.org/variablename> ;
    skos:prefLabel "Silicic acid" ;
    skos:topConceptOf <http://vocabulary.odm2.org/variablename> .

variablename:silicicAcidFlux a skos:Concept ;
    skos:definition "Silicate acid (H4SiO4) flux" ;
