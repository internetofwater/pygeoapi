<http://qudt.org/vocab/quantitykind/LogarithmRatioToBaseE> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "logarithm ratio to base e"@en-US;
