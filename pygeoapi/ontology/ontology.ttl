quantitykind:HydraulicPermeability a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "Hydraulic Permeability"@en, "Hydraulic Permeability"@en;
  rdfs:comment "Applicable units are those of quantitykind:HydraulicPermeability", "Applicable units are those of quantitykind:HydraulicPermeability";
  dct:description "Permeability is a property of porous materials that is an indication of the ability for fluids (gas or liquid) to flow through them. Fluids can more easily flow through a material with high permeability than one with low permeability. The permeability of a medium is related to the porosity, but also to the shapes of the pores in the medium and their level of connectedness."^^qudt:LatexString,
    "Permeability is a property of porous materials that is an indication of the ability for fluids (gas or liquid) to flow through them. Fluids can more easily flow through a material with high permeability than one with low permeability. The permeability of a medium is related to the porosity, but also to the shapes of the pores in the medium and their level of connectedness."^^qudt:LatexString;
  skos:altLabel "Permeability"@en, "Permeability"@en, "Fluid Permeability"@en, "Fluid Permeability"@en;
  qudt:dbpediaMatch "http://dbpedia.org/resource/Permeability_(Earth_sciences)"^^xsd:anyURI,
    "http://dbpedia.org/resource/Permeability_(Earth_sciences)"^^xsd:anyURI;
  qudt:hasDimensionVector dimensionvector:A0E0L2I0M0H0T0D0, dimensionvector:A0E0L2I0M0H0T0D0;
  qudt:informativeReference "https://en.wikipedia.org/wiki/Permeability_(Earth_sciences)"^^xsd:anyURI,
    "https://en.wikipedia.org/wiki/Permeability_(Earth_sciences)"^^xsd:anyURI;
  qudt:plainTextDescription "Permeability is a property of porous materials that is an indication of the ability for fluids (gas or liquid) to flow through them. Fluids can more easily flow through a material with high permeability than one with low permeability. The permeability of a medium is related to the porosity, but also to the shapes of the pores in the medium and their level of connectedness.",
    "Permeability is a property of porous materials that is an indication of the ability for fluids (gas or liquid) to flow through them. Fluids can more easily flow through a material with high permeability than one with low permeability. The permeability of a medium is related to the porosity, but also to the shapes of the pores in the medium and their level of connectedness.";
