unit:CARAT a qudt:Unit, qudt:Unit;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/unit>, <http://qudt.org/vocab/unit>;
  rdfs:label "Carat"@en, "Carat"@en;
  dct:description "The carat is a unit of mass equal to 200 mg and is used for measuring gemstones and pearls. The current definition, sometimes known as the metric carat, was adopted in 1907 at the Fourth General Conference on Weights and Measures, and soon afterward in many countries around the world. The carat is divisible into one hundred points of two milligrams each. Other subdivisions, and slightly different mass values, have been used in the past in different locations. In terms of diamonds, a paragon is a flawless stone of at least 100 carats (20 g). The ANSI X.12 EDI standard abbreviation for the carat is $CD$."^^qudt:LatexString,
    "The carat is a unit of mass equal to 200 mg and is used for measuring gemstones and pearls. The current definition, sometimes known as the metric carat, was adopted in 1907 at the Fourth General Conference on Weights and Measures, and soon afterward in many countries around the world. The carat is divisible into one hundred points of two milligrams each. Other subdivisions, and slightly different mass values, have been used in the past in different locations. In terms of diamonds, a paragon is a flawless stone of at least 100 carats (20 g). The ANSI X.12 EDI standard abbreviation for the carat is $CD$."^^qudt:LatexString;
  skos:altLabel "metric carat", "metric carat";
  qudt:applicableSystem <http://qudt.org/vocab/sou/CGS>, <http://qudt.org/vocab/sou/CGS>;
  qudt:conversionMultiplier 0.0002, 0.0002;
  qudt:conversionMultiplierSN 2.0E-4, 2.0E-4;
  qudt:dbpediaMatch "http://dbpedia.org/resource/Carat"^^xsd:anyURI, "http://dbpedia.org/resource/Carat"^^xsd:anyURI;
  qudt:hasDimensionVector dimensionvector:A0E0L0I0M1H0T0D0, dimensionvector:A0E0L0I0M1H0T0D0;
  qudt:hasQuantityKind quantitykind:Mass, quantitykind:Mass;
  qudt:iec61360Code "0112/2///62720#UAB166", "0112/2///62720#UAB166";
  qudt:informativeReference "http://en.wikipedia.org/wiki/Carat?oldid=477129057"^^xsd:anyURI,
    "http://en.wikipedia.org/wiki/Carat?oldid=477129057"^^xsd:anyURI, "https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAB166"^^xsd:anyURI,
    "https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAB166"^^xsd:anyURI;
  qudt:symbol "ct", "ct";
  qudt:ucumCode "[car_m]"^^qudt:UCUMcs, "[car_m]"^^qudt:UCUMcs;
  qudt:uneceCommonCode "CTM", "CTM";
  qudt:expression "$Nm/ct$"^^qudt:LatexString, "$Nm/ct$"^^qudt:LatexString;
