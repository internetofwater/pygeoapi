variablename:lanthanum a skos:Concept;
  skos:definition "lanthanum is a chemical element with symbol La and atomic number 57. It is a soft, ductile, silvery-white metal that tarnishes rapidly when exposed to air and is soft enough to be cut with a knife.";
  skos:inScheme <http://vocabulary.odm2.org/variablename>;
