quantitykind:DynamicFrictionCoefficient a qudt:QuantityKind ;
    rdfs:label "Dynamic Friction Coefficient"@en ;
    dct:description "Kinetic (or dynamic) friction occurs when two objects are moving relative to each other and rub together (like a sled on the ground)."^^qudt:LatexString ;
    qudt:applicableUnit unit:NUM,
        unit:UNITLESS ;
