<http://qudt.org/vocab/quantitykind/FlightPathAngle> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Flight Path Angle"@en;
  rdfs:comment "Applicable units are those of quantitykind:Angle";
  dct:description "Flight path angle is defined in two different ways. To the aerodynamicist, it is the angle between the flight path vector (where the airplane is going) and the local atmosphere. To the flight crew, it is normally known as the angle between the flight path vector and the horizon, also known as the climb (or descent) angle."^^<http://qudt.org/schema/qudt/LatexString>;
  skos:broader <http://qudt.org/vocab/quantitykind/Angle>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1>;
  <http://qudt.org/schema/qudt/plainTextDescription> "Flight path angle is defined in two different ways. To the aerodynamicist, it is the angle between the flight path vector (where the airplane is going) and the local atmosphere. To the flight crew, it is normally known as the angle between the flight path vector and the horizon, also known as the climb (or descent) angle.";
  <http://qudt.org/schema/qudt/latexSymbol> "$\\gamma$"^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/applicableUnit> unit:ARCMIN, unit:MIN_Angle, unit:ARCSEC,
    unit:DEG, unit:GON, unit:GRAD, unit:MIL, unit:MicroRAD, unit:MilliARCSEC, unit:MilliRAD,
    unit:RAD, unit:REV .

