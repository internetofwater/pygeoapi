  rdfs:subPropertyOf dc:language, dc:language;
  dct:description "Recommended practice is to use either a non-literal value representing a language from a controlled vocabulary such as ISO 639-2 or ISO 639-3, or a literal value consisting of an IETF Best Current Practice 47 [[IETF-BCP47](https://tools.ietf.org/html/bcp47)] language tag."@en,
    "Recommended practice is to use either a non-literal value representing a language from a controlled vocabulary such as ISO 639-2 or ISO 639-3, or a literal value consisting of an IETF Best Current Practice 47 [[IETF-BCP47](https://tools.ietf.org/html/bcp47)] language tag."@en;
  dct:issued "2008-01-14"^^xsd:date, "2008-01-14"^^xsd:date;
  <http://purl.org/dc/dcam/rangeIncludes> dct:LinguisticSystem, dct:LinguisticSystem .

dct:license a rdf:Property, rdf:Property;
  rdfs:isDefinedBy <http://purl.org/dc/terms/>, <http://purl.org/dc/terms/>;
  rdfs:label "License"@en, "License"@en;
