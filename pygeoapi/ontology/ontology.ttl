unit:KiloGM-PER-MOL a qudt:Unit, qudt:Unit;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/unit>, <http://qudt.org/vocab/unit>;
  rdfs:label "Kilogram per Mol"@en, "Kilogram per Mol"@en;
  dct:description """
  The unit $\\textit{}$, symbol $kg/mol$, is the base SI unit for molar mass.
  In chemistry, the molar mass $M$ is defined as the mass of a given substance (chemical element or chemical compound) divided by its amount of substance. 
  It is a physical property of a given substance.  
  However, for historical reasons, molar masses are almost always expressed in $g/mol$. 
  As an example, the molar mass of water is approximately: $18.01528(33) \\; g/mol$.
  """^^qudt:LatexString,
    """
  The unit $\\textit{}$, symbol $kg/mol$, is the base SI unit for molar mass.
  In chemistry, the molar mass $M$ is defined as the mass of a given substance (chemical element or chemical compound) divided by its amount of substance. 
  It is a physical property of a given substance.  
  However, for historical reasons, molar masses are almost always expressed in $g/mol$. 
  As an example, the molar mass of water is approximately: $18.01528(33) \\; g/mol$.
  """^^qudt:LatexString;
  qudt:applicableSystem <http://qudt.org/vocab/sou/SI>, <http://qudt.org/vocab/sou/SI>;
  qudt:conversionMultiplier 1.0, 1.0;
  qudt:conversionMultiplierSN 1.0E0, 1.0E0;
  qudt:hasDimensionVector dimensionvector:A-1E0L0I0M1H0T0D0, dimensionvector:A-1E0L0I0M1H0T0D0;
  qudt:hasQuantityKind quantitykind:MolarMass, quantitykind:MolarMass;
  qudt:iec61360Code "0112/2///62720#UAA628", "0112/2///62720#UAA628";
