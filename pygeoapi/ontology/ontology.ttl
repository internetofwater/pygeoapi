<http://qudt.org/vocab/quantitykind/WaterVapourPermeability> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "water vapour permeability", "water vapour permeability"@en-US;
  rdfs:comment "Applicable units are those of quantitykind:WaterVapourPermeability";
  dct:description "mass of water vapour passing a surface divided by the area of this surface, the pressure difference, and the corresponding time"@en;
