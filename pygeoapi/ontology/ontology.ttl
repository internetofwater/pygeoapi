unit:M-PER-DAY a <http://qudt.org/schema/qudt/Unit>, <http://qudt.org/schema/qudt/DerivedUnit>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/unit>;
  rdfs:label "Meter per Day"@en-US, "Metre per Day"@en;
  dct:description "Meter Per Day (m/day) is a unit in the category of Velocity. It is also known as meter/day, meters per day, metre per day, metres per day. Meter Per Day (m/day) has a dimension of L*T-1 where L is length, and T is time. It can be converted to the corresponding standard SI unit m/s by multiplying its value by a factor of 0.00001157407407407407"^^rdf:HTML;
  <http://qudt.org/schema/qudt/applicableSystem> <http://qudt.org/vocab/sou/CGS-EMU>,
    <http://qudt.org/vocab/sou/CGS-GAUSS>, <http://qudt.org/vocab/sou/SI>, <http://qudt.org/vocab/sou/CGS>;
  <http://qudt.org/schema/qudt/conversionMultiplier> 0.00001157407407407407;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L1I0M0H0T-1D0>;
  <http://qudt.org/schema/qudt/hasQuantityKind> <http://qudt.org/vocab/quantitykind/LinearVelocity>,
    <http://qudt.org/vocab/quantitykind/Velocity>;
  <http://qudt.org/schema/qudt/symbol> "m/d";
  <http://qudt.org/schema/qudt/ucumCode> "m.d-1"^^<http://qudt.org/schema/qudt/UCUMcs>,
    "m/d"^^<http://qudt.org/schema/qudt/UCUMcs>;
  <http://qudt.org/schema/qudt/expression> "\\(m/day\\)"^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/definedUnitOfSystem> <http://qudt.org/vocab/sou/SI> .

unit:M-PER-DEG_C-M a <http://qudt.org/schema/qudt/Unit>;
