quantitykind:OsmoticCoefficient a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "Osmotic Coefficient"@en, "Osmotic Coefficient"@en;
  rdfs:comment "Applicable units are those of quantitykind:OsmoticCoefficient", "Applicable units are those of quantitykind:OsmoticCoefficient";
  dct:description "The \"Osmotic Coefficient\" is a quantity which characterises the deviation of a solvent from ideal behavior."^^qudt:LatexString,
    "The \"Osmotic Coefficient\" is a quantity which characterises the deviation of a solvent from ideal behavior."^^qudt:LatexString;
  qudt:hasDimensionVector dimensionvector:A0E0L0I0M0H0T0D1, dimensionvector:A0E0L0I0M0H0T0D1;
  qudt:informativeReference "http://en.wikipedia.org/wiki/Osmotic_coefficient"^^xsd:anyURI,
    "http://en.wikipedia.org/wiki/Osmotic_coefficient"^^xsd:anyURI;
  qudt:isoNormativeReference "http://www.iso.org/iso/catalogue_detail?csnumber=31894"^^xsd:anyURI,
    "http://www.iso.org/iso/catalogue_detail?csnumber=31894"^^xsd:anyURI;
  qudt:plainTextDescription "The \"Osmotic Coefficient\" is a quantity which characterises the deviation of a solvent from ideal behavior.",
    "The \"Osmotic Coefficient\" is a quantity which characterises the deviation of a solvent from ideal behavior.";
  qudt:latexSymbol "$\\varphi$"^^qudt:LatexString, "$\\varphi$"^^qudt:LatexString;
  qudt:latexDefinition "$\\varphi = -(M_A\\sum b_B)^{-1} \\ln a_A$, where $M_A$ is the molar mass of the solvent $A$, $\\sum$ denotes summation over all the solutes, $b_B$ is the molality of solute $B$, and $a_A$ is the activity of solvent $A$."^^qudt:LatexString,
    "$\\varphi = -(M_A\\sum b_B)^{-1} \\ln a_A$, where $M_A$ is the molar mass of the solvent $A$, $\\sum$ denotes summation over all the solutes, $b_B$ is the molality of solute $B$, and $a_A$ is the activity of solvent $A$."^^qudt:LatexString;
  qudt:applicableUnit unit:UNITLESS, unit:UNITLESS .

quantitykind:PackingFraction a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "Packing Fraction"@en, "Packing Fraction"@en;
  rdfs:comment "Applicable units are those of quantitykind:PackingFraction", "Applicable units are those of quantitykind:PackingFraction";
  dct:description "The \"Packing Fraction\" is the fraction of volume in a crystal structure that is occupied by atoms."^^qudt:LatexString,
    "The \"Packing Fraction\" is the fraction of volume in a crystal structure that is occupied by atoms."^^qudt:LatexString;
  qudt:hasDimensionVector dimensionvector:A0E0L0I0M0H0T0D1, dimensionvector:A0E0L0I0M0H0T0D1;
  qudt:informativeReference "http://en.wikipedia.org/wiki/Atomic_packing_factor"^^xsd:anyURI,
    "http://en.wikipedia.org/wiki/Atomic_packing_factor"^^xsd:anyURI;
  qudt:symbol "f", "f";
  qudt:isoNormativeReference "http://www.iso.org/iso/catalogue_detail?csnumber=31895"^^xsd:anyURI,
    "http://www.iso.org/iso/catalogue_detail?csnumber=31895"^^xsd:anyURI;
  qudt:plainTextDescription "The \"Packing Fraction\" is the fraction of volume in a crystal structure that is occupied by atoms.",
    "The \"Packing Fraction\" is the fraction of volume in a crystal structure that is occupied by atoms.";
  qudt:latexDefinition "$f = \\frac{\\Delta_r}{A}$, where $\\Delta_r$ is the relative mass excess and $A$ is the nucleon number."^^qudt:LatexString,
    "$f = \\frac{\\Delta_r}{A}$, where $\\Delta_r$ is the relative mass excess and $A$ is the nucleon number."^^qudt:LatexString;
  qudt:applicableUnit unit:UNITLESS, unit:UNITLESS .

quantitykind:PermittivityRatio a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:seeAlso quantitykind:Permittivity, quantitykind:Permittivity;
