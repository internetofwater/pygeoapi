<http://qudt.org/vocab/quantitykind/VerticalVelocity> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Vertical Velocity"@en;
  rdfs:comment "Applicable units are those of quantitykind:Velocity";
