<http://qudt.org/vocab/quantitykind/MigrationLength> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Migration Length"@en;
  rdfs:comment "Applicable units are those of quantitykind:Length";
  dct:description "\"Migration Length\" is the square root of the migration area."^^<http://qudt.org/schema/qudt/LatexString>;
  skos:broader <http://qudt.org/vocab/quantitykind/Length>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L1I0M0H0T0D0>;
  <http://qudt.org/schema/qudt/informativeReference> "http://encyclopedia2.thefreedictionary.com/migration+area"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/symbol> "M";
  <http://qudt.org/schema/qudt/plainTextDescription> "\"Migration Length\" is the square root of the migration area.";
  <http://qudt.org/schema/qudt/latexDefinition> "$M = \\sqrt{M^2}$, where $M^2$ is the migration area."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/applicableUnit> unit:ANGSTROM, unit:AU, unit:BTU_IT-PER-LB_F,
