<http://qudt.org/vocab/quantitykind/SecondAxialMomentOfArea> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Second Axial Moment of Area"@en;
  rdfs:comment "Applicable units are those of quantitykind:SecondAxialMomentOfArea";
  dct:description "The moment of inertia, also called mass moment of inertia, rotational inertia, polar moment of inertia of mass, or the angular mass is a property of a distribution of mass in space that measures its resistance to rotational acceleration about an axis."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L4I0M0H0T0D0>;
  <http://qudt.org/schema/qudt/iec61360Code> "0112/2///62720#UAD165";
  <http://qudt.org/schema/qudt/informativeReference> "http://en.wikipedia.org/wiki/Second_moment_of_area"^^xsd:anyURI,
    "https://cdd.iec.ch/cdd/iec61987/iec61987.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD165"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/symbol> "I";
  <http://qudt.org/schema/qudt/isoNormativeReference> "http://www.iso.org/iso/catalogue_detail?csnumber=31889"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/plainTextDescription> "The moment of inertia, also called mass moment of inertia, rotational inertia, polar moment of inertia of mass, or the angular mass is a property of a distribution of mass in space that measures its resistance to rotational acceleration about an axis.";
  <http://qudt.org/schema/qudt/latexDefinition> "$I_a = \\int r^2_Q dA$, where $r_Q$ is the radial distance from a $Q-axis$ and $A$ is area."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/applicableUnit> unit:CentiM4, unit:FT4, unit:IN4, unit:M4,
    unit:MilliM4 .

<http://qudt.org/vocab/quantitykind/SecondMomentOfArea> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Flächenträgheitsmoment"@de, "Geometryczny moment bezwładności"@pl, "Segundo momento de área"@pt,
    "moment quadratique"@fr, "second moment of area"@en, "secondo momento di area"@it,
    "segundo momento de érea"@es, "گشتاور دوم سطح"@fa, "क्षेत्रफल का द्वितीय आघूर्ण"@hi,
    "截面二次轴矩"@zh, "断面二次モーメント"@ja;
  rdfs:comment "Applicable units are those of quantitykind:SecondMomentOfArea";
  dct:description "The second moment of area is a property of a physical object that can be used to predict its resistance to bending and deflection. The deflection of an object under load depends not only on the load, but also on the geometry of the object's cross-section."^^<http://qudt.org/schema/qudt/LatexString>;
  skos:altLabel "momento de inércia de área"@pt;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L4I0M0H0T0D0>;
  <http://qudt.org/schema/qudt/informativeReference> "http://en.wikipedia.org/wiki/Second_moment_of_area"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/symbol> "J";
  <http://qudt.org/schema/qudt/plainTextDescription> "The second moment of area is a property of a physical object that can be used to predict its resistance to bending and deflection. The deflection of an object under load depends not only on the load, but also on the geometry of the object's cross-section.";
  <http://qudt.org/schema/qudt/applicableUnit> unit:CentiM4, unit:FT4, unit:IN4, unit:M4,
    unit:MilliM4 .

<http://qudt.org/vocab/quantitykind/SecondPolarMomentOfArea> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Second Polar Moment of Area"@en;
  rdfs:comment "Applicable units are those of quantitykind:SecondPolarMomentOfArea";
  dct:description "The moment of inertia, also called mass moment of inertia, rotational inertia, polar moment of inertia of mass, or the angular mass is a property of a distribution of mass in space that measures its resistance to rotational acceleration about an axis."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L4I0M0H0T0D0>;
  <http://qudt.org/schema/qudt/iec61360Code> "0112/2///62720#UAD166";
  <http://qudt.org/schema/qudt/informativeReference> "http://en.wikipedia.org/wiki/Second_moment_of_area"^^xsd:anyURI,
    "https://cdd.iec.ch/cdd/iec61987/iec61987.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD166"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/symbol> "I";
  <http://qudt.org/schema/qudt/isoNormativeReference> "http://www.iso.org/iso/catalogue_detail?csnumber=31889"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/plainTextDescription> "The moment of inertia, also called mass moment of inertia, rotational inertia, polar moment of inertia of mass, or the angular mass is a property of a distribution of mass in space that measures its resistance to rotational acceleration about an axis.";
  <http://qudt.org/schema/qudt/latexDefinition> "$I_p = \\int r^2_Q dA$, where $r_Q$ is the radial distance from a $Q-axis$ and $A$ is area."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/applicableUnit> unit:CentiM4, unit:FT4, unit:IN4, unit:M4,
    unit:MilliM4 .

