<http://qudt.org/vocab/quantitykind/SoilAdsorptionCoefficient> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Soil Adsorption Coefficient"@en;
  rdfs:comment "Applicable units are those of quantitykind:SoilAdsorptionCoefficient";
  dct:description "A specific volume that is the ratio of the amount of substance adsorbed per unit weight of organic carbon in the soil or sediment to the concentration of the chemical in aqueous solution at equilibrium."^^<http://qudt.org/schema/qudt/LatexString>;
  skos:broader <http://qudt.org/vocab/quantitykind/SpecificVolume>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L3I0M-1H0T0D0>;
  <http://qudt.org/schema/qudt/plainTextDescription> "A specific volume that is the ratio of the amount of substance adsorbed per unit weight of organic carbon in the soil or sediment to the concentration of the chemical in aqueous solution at equilibrium.";
  <http://qudt.org/schema/qudt/applicableUnit> unit:CentiM3-PER-GM, unit:MilliL-PER-GM,
    unit:DeciM3-PER-KiloGM, unit:FT3-PER-LB, unit:IN3-PER-LB, unit:L-PER-KiloGM, unit:M3-PER-KiloGM,
    unit:MilliM3-PER-GM, unit:MilliM3-PER-KiloGM .

<http://qudt.org/vocab/quantitykind/SpecificVolume> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:seeAlso <http://qudt.org/vocab/quantitykind/Density>;
  rdfs:label "Specific Volume"@en;
  rdfs:comment "Applicable units are those of quantitykind:SpecificVolume";
  dct:description "\"Specific Volume\" ($\\nu$) is the volume occupied by a unit of mass of a material. It is equal to the inverse of density."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L3I0M-1H0T0D0>;
  <http://qudt.org/schema/qudt/iec61360Code> "0112/2///62720#UAD175";
  <http://qudt.org/schema/qudt/informativeReference> "http://en.wikipedia.org/wiki/Specific_volume"^^xsd:anyURI,
    "https://cdd.iec.ch/cdd/iec61987/iec61987.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD175"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/siExactMatch> <https://si-digital-framework.org/SI/quantities/SPVO>;
  <http://qudt.org/schema/qudt/isoNormativeReference> "http://www.iso.org/iso/catalogue_detail?csnumber=31889"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/latexDefinition> "$sv = \\frac{1}{\\rho}$, where $\\rho$ is mass density."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/applicableUnit> unit:CentiM3-PER-GM, unit:MilliL-PER-GM,
    unit:DeciL-PER-GM, unit:DeciM3-PER-KiloGM, unit:FT3-PER-LB, unit:IN3-PER-LB, unit:L-PER-KiloGM,
    unit:M3-PER-KiloGM, unit:MilliL-PER-KiloGM, unit:MilliM3-PER-GM, unit:MilliM3-PER-KiloGM .

unit:CentiM3-PER-HR a <http://qudt.org/schema/qudt/Unit>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/unit>;
  rdfs:label "Cubic Centimeter per Hour"@en-US, "Cubic Centimetre per Hour"@en;
