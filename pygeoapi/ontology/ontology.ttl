quantitykind:ThermodynamicCriticalMagneticFluxDensity a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "Thermodynamic Critical Magnetic Flux Density"@en, "Thermodynamic Critical Magnetic Flux Density"@en;
  rdfs:comment "Applicable units are those of quantitykind:MagneticFluxDensity", "Applicable units are those of quantitykind:MagneticFluxDensity";
  dct:description "\"Thermodynamic Critical Magnetic Flux Density\" is the maximum magnetic field strength below which a material remains superconducting."^^qudt:LatexString,
    "\"Thermodynamic Critical Magnetic Flux Density\" is the maximum magnetic field strength below which a material remains superconducting."^^qudt:LatexString;
  skos:broader quantitykind:MagneticFluxDensity, quantitykind:MagneticFluxDensity;
  qudt:hasDimensionVector dimensionvector:A0E-1L0I0M1H0T-2D0, dimensionvector:A0E-1L0I0M1H0T-2D0;
  qudt:symbol "B_c", "B_c";
  qudt:isoNormativeReference "http://www.iso.org/iso/catalogue_detail?csnumber=31897"^^xsd:anyURI,
    "http://www.iso.org/iso/catalogue_detail?csnumber=31897"^^xsd:anyURI;
  qudt:plainTextDescription "\"Thermodynamic Critical Magnetic Flux Density\" is the maximum magnetic field strength below which a material remains superconducting.",
    "\"Thermodynamic Critical Magnetic Flux Density\" is the maximum magnetic field strength below which a material remains superconducting.";
  qudt:latexDefinition "$G_n - G_s = \\frac{1}{2}\\frac{B_c^2 \\cdot V}{\\mu_0}$, where $G_n$ and $G_s$ are the Gibbs energies at zero magnetic flux density in a normal conductor and superconductor, respectively, $\\mu_0$ is the magnetic constant, and $V$ is volume."^^qudt:LatexString,
    "$G_n - G_s = \\frac{1}{2}\\frac{B_c^2 \\cdot V}{\\mu_0}$, where $G_n$ and $G_s$ are the Gibbs energies at zero magnetic flux density in a normal conductor and superconductor, respectively, $\\mu_0$ is the magnetic constant, and $V$ is volume."^^qudt:LatexString;
