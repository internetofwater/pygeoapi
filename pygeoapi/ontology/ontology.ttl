unit:KiloN-M-PER-DEG a <http://qudt.org/schema/qudt/Unit>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/unit>;
  rdfs:label "Kilonewton Metre per Degree"@en;
  <http://qudt.org/schema/qudt/applicableSystem> <http://qudt.org/vocab/sou/SI>;
  <http://qudt.org/schema/qudt/conversionMultiplier> 57295.77957855229894302178227976183;
  <http://qudt.org/schema/qudt/conversionMultiplierSN> 5.729577957855229894302178227976183E4;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L2I0M1H0T-2D0>;
