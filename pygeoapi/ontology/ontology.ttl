  <http://qudt.org/schema/qudt/iec61360Code> "0112/2///62720#UAB175";
  <http://qudt.org/schema/qudt/informativeReference> "https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAB175"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/symbol> "W/(m²·K⁴)";
  <http://qudt.org/schema/qudt/ucumCode> "W.m-2.K-4"^^<http://qudt.org/schema/qudt/UCUMcs>;
  <http://qudt.org/schema/qudt/uneceCommonCode> "D56";
  <http://qudt.org/schema/qudt/expression> "$W/(m^2.K^4)$"^^<http://qudt.org/schema/qudt/LatexString> .

<http://qudt.org/vocab/dimensionvector/A0E0L0I0M1H-4T-3D0> a <http://qudt.org/schema/qudt/QuantityKindDimensionVector_SI>,
    <http://qudt.org/schema/qudt/QuantityKindDimensionVector_ISO>, <http://qudt.org/schema/qudt/QuantityKindDimensionVector_Imperial>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/dimensionvector>;
  rdfs:label "A0E0L0I0M1H-4T-3D0";
  <http://qudt.org/schema/qudt/latexSymbol> "$M T^{-3}.\\Theta^{-4}$"^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/latexDefinition> "$M T^{-3}.H^{-4}$"^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/hasReferenceQuantityKind> <http://qudt.org/vocab/quantitykind/PowerPerAreaQuarticTemperature>;
  <http://qudt.org/schema/qudt/dimensionExponentForAmountOfSubstance> 0;
  <http://qudt.org/schema/qudt/dimensionExponentForElectricCurrent> 0;
  <http://qudt.org/schema/qudt/dimensionExponentForLength> 0;
  <http://qudt.org/schema/qudt/dimensionExponentForLuminousIntensity> 0;
  <http://qudt.org/schema/qudt/dimensionExponentForMass> 1;
  <http://qudt.org/schema/qudt/dimensionExponentForThermodynamicTemperature> -4;
  <http://qudt.org/schema/qudt/dimensionExponentForTime> -3;
  <http://qudt.org/schema/qudt/dimensionlessExponent> 0 .

