quantitykind:MassieuFunction a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:seeAlso quantitykind:SpecificEnergy, quantitykind:SpecificEnergy, quantitykind:PlanckFunction,
    quantitykind:PlanckFunction, quantitykind:SpecificEnthalpy, quantitykind:SpecificEnthalpy,
    quantitykind:SpecificGibbsEnergy, quantitykind:SpecificGibbsEnergy, quantitykind:SpecificHelmholtzEnergy,
    quantitykind:SpecificHelmholtzEnergy, quantitykind:SpecificInternalEnergy, quantitykind:SpecificInternalEnergy;
  rdfs:label "Massieu Function"@en, "Massieu Function"@en;
  dct:description "The Massieu function, $\\Psi$, is defined as: $\\Psi = \\Psi (X_1, \\dots , X_i, Y_{i+1}, \\dots , Y_r  )$,  where for every system with degree of freedom $r$ one may choose $r$ variables, e.g. , to define a coordinate system, where $X$ and $Y$ are extensive and intensive variables, respectively, and where at least one extensive variable must be within this set in order to define the size of the system. The $(r + 1)^{th}$ variable,$\\Psi$ , is then called the Massieu function."^^qudt:LatexString,
    "The Massieu function, $\\Psi$, is defined as: $\\Psi = \\Psi (X_1, \\dots , X_i, Y_{i+1}, \\dots , Y_r  )$,  where for every system with degree of freedom $r$ one may choose $r$ variables, e.g. , to define a coordinate system, where $X$ and $Y$ are extensive and intensive variables, respectively, and where at least one extensive variable must be within this set in order to define the size of the system. The $(r + 1)^{th}$ variable,$\\Psi$ , is then called the Massieu function."^^qudt:LatexString;
  qudt:hasDimensionVector dimensionvector:A0E0L2I0M1H-1T-2D0, dimensionvector:A0E0L2I0M1H-1T-2D0;
  qudt:informativeReference "http://en.wikipedia.org/wiki/Massieu_function"^^xsd:anyURI,
    "http://en.wikipedia.org/wiki/Massieu_function"^^xsd:anyURI;
  qudt:symbol "J", "J";
  qudt:isoNormativeReference "http://www.iso.org/iso/catalogue_detail?csnumber=31890"^^xsd:anyURI,
    "http://www.iso.org/iso/catalogue_detail?csnumber=31890"^^xsd:anyURI;
  qudt:latexDefinition "$J = -A/T$, where $A$ is Helmholtz energy and $T$ is thermodynamic temperature."^^qudt:LatexString,
    "$J = -A/T$, where $A$ is Helmholtz energy and $T$ is thermodynamic temperature."^^qudt:LatexString .

quantitykind:PlanckFunction a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:seeAlso quantitykind:SpecificEnergy, quantitykind:SpecificEnergy, quantitykind:MassieuFunction,
    quantitykind:MassieuFunction, quantitykind:SpecificEnthalpy, quantitykind:SpecificEnthalpy,
    quantitykind:SpecificGibbsEnergy, quantitykind:SpecificGibbsEnergy, quantitykind:SpecificHelmholtzEnergy,
    quantitykind:SpecificHelmholtzEnergy, quantitykind:SpecificInternalEnergy, quantitykind:SpecificInternalEnergy;
  rdfs:label "Planck Function"@en, "Planck Function"@en;
  dct:description "The $\\textit{Planck function}$ is used to compute the radiance emitted from objects that radiate like a perfect \"Black Body\". The inverse of the $\\textit{Planck Function}$ is used to find the $\\textit{Brightness Temperature}$ of an object. The precise formula for the Planck Function depends on whether the radiance is determined on a $\\textit{per unit wavelength}$ or a $\\textit{per unit frequency}$. In the ISO System of Quantities, $\\textit{Planck Function}$ is defined by the formula: $Y = -G/T$, where $G$ is Gibbs Energy and $T$ is thermodynamic temperature."^^qudt:LatexString,
    "The $\\textit{Planck function}$ is used to compute the radiance emitted from objects that radiate like a perfect \"Black Body\". The inverse of the $\\textit{Planck Function}$ is used to find the $\\textit{Brightness Temperature}$ of an object. The precise formula for the Planck Function depends on whether the radiance is determined on a $\\textit{per unit wavelength}$ or a $\\textit{per unit frequency}$. In the ISO System of Quantities, $\\textit{Planck Function}$ is defined by the formula: $Y = -G/T$, where $G$ is Gibbs Energy and $T$ is thermodynamic temperature."^^qudt:LatexString;
  qudt:hasDimensionVector dimensionvector:A0E0L2I0M1H0T-2D0, dimensionvector:A0E0L2I0M1H0T-2D0;
  qudt:informativeReference "http://pds-atmospheres.nmsu.edu/education_and_outreach/encyclopedia/planck_function.htm"^^xsd:anyURI,
    "http://pds-atmospheres.nmsu.edu/education_and_outreach/encyclopedia/planck_function.htm"^^xsd:anyURI,
    "http://www.star.nesdis.noaa.gov/smcd/spb/calibration/planck.html"^^xsd:anyURI, "http://www.star.nesdis.noaa.gov/smcd/spb/calibration/planck.html"^^xsd:anyURI;
  qudt:expression "$B_{\\nu}(T)$"^^qudt:LatexString, "$B_{\\nu}(T)$"^^qudt:LatexString;
  qudt:isoNormativeReference "http://www.iso.org/iso/catalogue_detail?csnumber=31890"^^xsd:anyURI,
    "http://www.iso.org/iso/catalogue_detail?csnumber=31890"^^xsd:anyURI;
  qudt:latexDefinition """The Planck function, $B_{\\tilde{\\nu}}(T)$, is given by:
$B_{\\nu}(T) = \\frac{2h c^2\\tilde{\\nu}^3}{e^{hc / k \\tilde{\\nu} T}-1}$
where, $\\tilde{\\nu}$ is wavelength, $h$ is Planck's Constant, $k$ is Boltzman's Constant, $c$ is the speed of light in a vacuum, $T$ is thermodynamic temperature."""^^qudt:LatexString,
    """The Planck function, $B_{\\tilde{\\nu}}(T)$, is given by:
$B_{\\nu}(T) = \\frac{2h c^2\\tilde{\\nu}^3}{e^{hc / k \\tilde{\\nu} T}-1}$
where, $\\tilde{\\nu}$ is wavelength, $h$ is Planck's Constant, $k$ is Boltzman's Constant, $c$ is the speed of light in a vacuum, $T$ is thermodynamic temperature."""^^qudt:LatexString .

quantitykind:SpecificEnthalpy a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:seeAlso quantitykind:SpecificEnergy, quantitykind:SpecificEnergy, quantitykind:Enthalpy,
    quantitykind:Enthalpy, quantitykind:MassieuFunction, quantitykind:MassieuFunction,
    quantitykind:PlanckFunction, quantitykind:PlanckFunction, quantitykind:SpecificGibbsEnergy,
    quantitykind:SpecificGibbsEnergy, quantitykind:SpecificHelmholtzEnergy, quantitykind:SpecificHelmholtzEnergy,
    quantitykind:SpecificInternalEnergy, quantitykind:SpecificInternalEnergy;
  rdfs:label "Specific Enthalpy"@en, "Specific Enthalpy"@en;
  rdfs:comment "Applicable units are those of quantitykind:SpecificEnergy", "Applicable units are those of quantitykind:SpecificEnergy";
  dct:description "$\\textit{Specific Enthalpy}$ is enthalpy per mass of substance involved. Specific enthalpy is denoted by a lower case h, with dimension of energy per mass (SI unit: joule/kg). In thermodynamics, $\\textit{enthalpy}$ is the sum of the internal energy U and the product of pressure p and volume V of a system: $H = U + pV$.  The internal energy U and the work term pV have dimension of energy, in SI units this is joule; the extensive (linear in size) quantity H has the same dimension."^^qudt:LatexString,
    "$\\textit{Specific Enthalpy}$ is enthalpy per mass of substance involved. Specific enthalpy is denoted by a lower case h, with dimension of energy per mass (SI unit: joule/kg). In thermodynamics, $\\textit{enthalpy}$ is the sum of the internal energy U and the product of pressure p and volume V of a system: $H = U + pV$.  The internal energy U and the work term pV have dimension of energy, in SI units this is joule; the extensive (linear in size) quantity H has the same dimension."^^qudt:LatexString;
  skos:broader quantitykind:SpecificEnergy, quantitykind:SpecificEnergy;
  qudt:dbpediaMatch "http://dbpedia.org/resource/Entropy"^^xsd:anyURI, "http://dbpedia.org/resource/Entropy"^^xsd:anyURI;
  qudt:hasDimensionVector dimensionvector:A0E0L2I0M0H0T-2D0, dimensionvector:A0E0L2I0M0H0T-2D0;
  qudt:informativeReference "http://en.citizendium.org/wiki/Enthalpy"^^xsd:anyURI, "http://en.citizendium.org/wiki/Enthalpy"^^xsd:anyURI;
  qudt:symbol "h", "h";
  qudt:isoNormativeReference "http://www.iso.org/iso/catalogue_detail?csnumber=31890"^^xsd:anyURI,
    "http://www.iso.org/iso/catalogue_detail?csnumber=31890"^^xsd:anyURI;
  qudt:latexDefinition "$h = H/m$, where $H$ is enthalpy and $m$ is mass."^^qudt:LatexString,
    "$h = H/m$, where $H$ is enthalpy and $m$ is mass."^^qudt:LatexString;
  qudt:applicableUnit unit:BTU_IT-PER-LB, unit:BTU_IT-PER-LB, unit:BTU_TH-PER-LB, unit:BTU_TH-PER-LB,
    unit:CAL_IT-PER-GM, unit:CAL_IT-PER-GM, unit:CAL_TH-PER-GM, unit:CAL_TH-PER-GM, unit:ERG-PER-GM,
    unit:ERG-PER-GM, unit:J-PER-GM, unit:J-PER-GM, unit:J-PER-KiloGM, unit:J-PER-KiloGM,
    unit:KiloCAL-PER-GM, unit:KiloCAL-PER-GM, unit:KiloJ-PER-KiloGM, unit:KiloJ-PER-KiloGM,
    unit:KiloLB_F-FT-PER-LB, unit:KiloLB_F-FT-PER-LB, unit:MegaJ-PER-KiloGM, unit:MegaJ-PER-KiloGM,
    unit:MilliJ-PER-GM, unit:MilliJ-PER-GM, unit:N-M-PER-KiloGM, unit:N-M-PER-KiloGM,
    unit:W-HR-PER-KiloGM, unit:W-HR-PER-KiloGM .

quantitykind:SpecificGibbsEnergy a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:seeAlso quantitykind:SpecificEnergy, quantitykind:SpecificEnergy, quantitykind:MassieuFunction,
    quantitykind:MassieuFunction, quantitykind:PlanckFunction, quantitykind:PlanckFunction,
    quantitykind:SpecificEnthalpy, quantitykind:SpecificEnthalpy, quantitykind:SpecificHelmholtzEnergy,
    quantitykind:SpecificHelmholtzEnergy, quantitykind:SpecificInternalEnergy, quantitykind:SpecificInternalEnergy;
  rdfs:label "Specific Gibbs Energy"@en, "Specific Gibbs Energy"@en;
  rdfs:comment "Applicable units are those of quantitykind:SpecificEnergy", "Applicable units are those of quantitykind:SpecificEnergy";
  dct:description """
  $\\textit{Specific Gibbs Energy}$ is a \"corresponding intensive property\",
   which is $\\textit{Gibbs Energy}$ per mass of substance involved. 
  Energy has corresponding intensive (size-independent) properties for pure materials. 
  $\\textit{Specific Gibbs Energy}$ is denoted by a lower case $g$,
   with dimension of energy per mass (SI unit: $joule/kg$).
