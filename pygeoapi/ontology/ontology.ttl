quantitykind:Admittance a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:seeAlso quantitykind:Impedance, quantitykind:Impedance;
  rdfs:label "Admittance"@en, "Admittance"@en;
  rdfs:comment "Applicable units are those of quantitykind:Admittance", "Applicable units are those of quantitykind:Admittance";
  dct:description "\"Admittance\" is a measure of how easily a circuit or device will allow a current to flow. It is defined as the inverse of the impedance ($Z$). "^^qudt:LatexString,
    "\"Admittance\" is a measure of how easily a circuit or device will allow a current to flow. It is defined as the inverse of the impedance ($Z$). "^^qudt:LatexString;
  qudt:hasDimensionVector dimensionvector:A0E2L-2I0M-1H0T3D0, dimensionvector:A0E2L-2I0M-1H0T3D0;
  qudt:informativeReference "http://www.iso.org/iso/home/store/catalogue_tc/catalogue_detail.htm?csnumber=31891"^^xsd:anyURI,
    "http://www.iso.org/iso/home/store/catalogue_tc/catalogue_detail.htm?csnumber=31891"^^xsd:anyURI,
    "http://en.wikipedia.org/wiki/Admittance"^^xsd:anyURI, "http://en.wikipedia.org/wiki/Admittance"^^xsd:anyURI,
    "http://www.electropedia.org/iev/iev.nsf/display?openform&ievref=131-12-51"^^xsd:anyURI,
    "http://www.electropedia.org/iev/iev.nsf/display?openform&ievref=131-12-51"^^xsd:anyURI;
  qudt:latexSymbol "$Y$"^^qudt:LatexString, "$Y$"^^qudt:LatexString;
  qudt:latexDefinition "$Y = \\frac{1}{Z}$, where $Z$ is impedance."^^qudt:LatexString,
    "$Y = \\frac{1}{Z}$, where $Z$ is impedance."^^qudt:LatexString;
  qudt:applicableUnit unit:DeciS, unit:DeciS, unit:KiloS, unit:KiloS, unit:MHO, unit:MHO,
    unit:S, unit:S, unit:MegaS, unit:MegaS, unit:MicroMHO, unit:MicroMHO, unit:MicroS,
    unit:MicroS, unit:MilliS, unit:MilliS, unit:NanoS, unit:NanoS, unit:PicoS, unit:PicoS .

quantitykind:Conductance a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:seeAlso quantitykind:Admittance, quantitykind:Admittance;
  rdfs:label "Conductance"@en, "Conductance"@en;
  rdfs:comment "Applicable units are those of quantitykind:Conductance", "Applicable units are those of quantitykind:Conductance";
  dct:description "$\\textit{Conductance}$, for a resistive two-terminal element or two-terminal circuit with terminals A and B, quotient of the electric current i in the element or circuit by the voltage $u_{AB}$ between the terminals: $G = \\frac{1}{R}$, where the electric current is taken as positive if its direction is from A to B and negative in the opposite case. The conductance of an element or circuit is the inverse of its resistance."^^qudt:LatexString,
    "$\\textit{Conductance}$, for a resistive two-terminal element or two-terminal circuit with terminals A and B, quotient of the electric current i in the element or circuit by the voltage $u_{AB}$ between the terminals: $G = \\frac{1}{R}$, where the electric current is taken as positive if its direction is from A to B and negative in the opposite case. The conductance of an element or circuit is the inverse of its resistance."^^qudt:LatexString;
  qudt:hasDimensionVector dimensionvector:A0E2L-2I0M-1H0T3D0, dimensionvector:A0E2L-2I0M-1H0T3D0;
  qudt:informativeReference "http://www.iso.org/iso/home/store/catalogue_tc/catalogue_detail.htm?csnumber=31891"^^xsd:anyURI,
    "http://www.iso.org/iso/home/store/catalogue_tc/catalogue_detail.htm?csnumber=31891"^^xsd:anyURI,
    "http://www.electropedia.org/iev/iev.nsf/display?openform&ievref=131-12-06"^^xsd:anyURI,
    "http://www.electropedia.org/iev/iev.nsf/display?openform&ievref=131-12-06"^^xsd:anyURI;
  qudt:symbol "G", "G";
  qudt:latexDefinition """$G = Re\\underline{Y}$, where $\\underline{Y}$ is admittance.

Alternatively:

$G = \\frac{1}{R}$, where $R$ is resistance."""^^qudt:LatexString,
    """$G = Re\\underline{Y}$, where $\\underline{Y}$ is admittance.

Alternatively:

$G = \\frac{1}{R}$, where $R$ is resistance."""^^qudt:LatexString;
  qudt:applicableUnit unit:DeciS, unit:DeciS, unit:KiloS, unit:KiloS, unit:MHO, unit:MHO,
    unit:S, unit:S, unit:MegaS, unit:MegaS, unit:MicroMHO, unit:MicroMHO, unit:MicroS,
    unit:MicroS, unit:MilliS, unit:MilliS, unit:NanoS, unit:NanoS, unit:PicoS, unit:PicoS .

