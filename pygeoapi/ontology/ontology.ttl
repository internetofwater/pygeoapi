unit:M3-PER-HA-YR a <http://qudt.org/schema/qudt/Unit>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/unit>;
  rdfs:label "Cubic Meter per Hectare Year"@en-US, "Cubic Metre per Hectare Year"@en;
