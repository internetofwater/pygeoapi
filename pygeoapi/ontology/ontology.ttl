<http://qudt.org/vocab/quantitykind/Radius> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Radius"@en;
  rdfs:comment "Applicable units are those of quantitykind:Length";
  dct:description "In classical geometry, the \"Radius\" of a circle or sphere is any line segment from its center to its perimeter the radius of a circle or sphere is the length of any such segment."^^<http://qudt.org/schema/qudt/LatexString>;
  skos:broader <http://qudt.org/vocab/quantitykind/Length>;
  <http://qudt.org/schema/qudt/dbpediaMatch> "http://dbpedia.org/resource/Radius"^^xsd:anyURI;
