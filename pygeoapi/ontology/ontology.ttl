unit:V-PER-CentiM a <http://qudt.org/schema/qudt/Unit>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/unit>;
  rdfs:label "Volt per Centimeter"@en-US, "Volt per Centimetre"@en;
  dct:description "derived SI unit volt divided by the 0.01-fold of the SI base unit metre"^^rdf:HTML;
  <http://qudt.org/schema/qudt/applicableSystem> <http://qudt.org/vocab/sou/CGS-EMU>,
    <http://qudt.org/vocab/sou/CGS-GAUSS>, <http://qudt.org/vocab/sou/SI>;
