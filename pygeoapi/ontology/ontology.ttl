quantitykind:EffectiveMass a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "Effective Mass"@en, "Effective Mass"@en;
  rdfs:comment "Applicable units are those of quantitykind:Mass", "Applicable units are those of quantitykind:Mass";
  dct:description "\"Effective Mass\" is used in the motional equation for electrons in solid state bodies, depending on the wavenumber and corresponding to its velocity and energy level."^^qudt:LatexString,
    "\"Effective Mass\" is used in the motional equation for electrons in solid state bodies, depending on the wavenumber and corresponding to its velocity and energy level."^^qudt:LatexString;
  skos:broader quantitykind:Mass, quantitykind:Mass;
  qudt:hasDimensionVector dimensionvector:A0E0L0I0M1H0T0D0, dimensionvector:A0E0L0I0M1H0T0D0;
  qudt:informativeReference "http://en.wikipedia.org/wiki/Effective_mass_(solid-state_physics)"^^xsd:anyURI,
    "http://en.wikipedia.org/wiki/Effective_mass_(solid-state_physics)"^^xsd:anyURI;
  qudt:symbol "m^*", "m^*";
  qudt:isoNormativeReference "http://www.iso.org/iso/catalogue_detail?csnumber=31897"^^xsd:anyURI,
    "http://www.iso.org/iso/catalogue_detail?csnumber=31897"^^xsd:anyURI;
  qudt:plainTextDescription "\"Effective Mass\" is used in the motional equation for electrons in solid state bodies, depending on the wavenumber and corresponding to its velocity and energy level.",
    "\"Effective Mass\" is used in the motional equation for electrons in solid state bodies, depending on the wavenumber and corresponding to its velocity and energy level.";
  qudt:latexDefinition "$m^* = \\hbar^2k(\\frac{d\\varepsilon}{dk})$, where $\\hbar$ is the reduced Planck constant, $k$ is the wavenumber, and $\\varepsilon$ is the energy of the electron."^^qudt:LatexString,
    "$m^* = \\hbar^2k(\\frac{d\\varepsilon}{dk})$, where $\\hbar$ is the reduced Planck constant, $k$ is the wavenumber, and $\\varepsilon$ is the energy of the electron."^^qudt:LatexString;
