  <http://qudt.org/schema/qudt/hasQuantityKind> <http://qudt.org/vocab/quantitykind/Power>;
  <http://qudt.org/schema/qudt/iec61360Code> "0112/2///62720#UAB515";
  <http://qudt.org/schema/qudt/informativeReference> "https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAB515"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/symbol> "EJ/s";
