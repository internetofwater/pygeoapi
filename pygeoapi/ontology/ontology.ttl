quantitykind:StaticFrictionCoefficient a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "Static Friction Coefficient"@en, "Static Friction Coefficient"@en;
  rdfs:comment "Applicable units are those of quantitykind:FrictionCoefficient", "Applicable units are those of quantitykind:FrictionCoefficient";
  dct:description "Static friction is friction between two or more solid objects that are not moving relative to each other. For example, static friction can prevent an object from sliding down a sloped surface. "^^qudt:LatexString,
    "Static friction is friction between two or more solid objects that are not moving relative to each other. For example, static friction can prevent an object from sliding down a sloped surface. "^^qudt:LatexString;
  skos:broader quantitykind:FrictionCoefficient, quantitykind:FrictionCoefficient;
  qudt:dbpediaMatch "http://dbpedia.org/resource/Friction"^^xsd:anyURI, "http://dbpedia.org/resource/Friction"^^xsd:anyURI;
  qudt:hasDimensionVector dimensionvector:A0E0L0I0M0H0T0D1, dimensionvector:A0E0L0I0M0H0T0D1;
  qudt:informativeReference "http://en.wikipedia.org/wiki/Friction"^^xsd:anyURI, "http://en.wikipedia.org/wiki/Friction"^^xsd:anyURI;
  qudt:isoNormativeReference "http://www.iso.org/iso/catalogue_detail?csnumber=31889"^^xsd:anyURI,
    "http://www.iso.org/iso/catalogue_detail?csnumber=31889"^^xsd:anyURI;
  qudt:plainTextDescription "Static friction is friction between two or more solid objects that are not moving relative to each other. For example, static friction can prevent an object from sliding down a sloped surface. ",
    "Static friction is friction between two or more solid objects that are not moving relative to each other. For example, static friction can prevent an object from sliding down a sloped surface. ";
  qudt:latexSymbol "$\\mu$"^^qudt:LatexString, "$\\mu$"^^qudt:LatexString;
  qudt:latexDefinition "$\\mu = \\frac{F_max}{N}$, where $F_max$ is the maximum tangential component of the contact force and $N$ is the normal component of the contact force between two bodies at relative rest."^^qudt:LatexString,
    "$\\mu = \\frac{F_max}{N}$, where $F_max$ is the maximum tangential component of the contact force and $N$ is the normal component of the contact force between two bodies at relative rest."^^qudt:LatexString;
  qudt:qkdvDenominator dimensionvector:A0E0L1I0M1H0T-2D0, dimensionvector:A0E0L1I0M1H0T-2D0;
  qudt:qkdvNumerator dimensionvector:A0E0L1I0M1H0T-2D0, dimensionvector:A0E0L1I0M1H0T-2D0;
  qudt:applicableUnit unit:NUM, unit:NUM, unit:UNITLESS, unit:UNITLESS .

quantitykind:StaticPressure a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "Static pressure"@en, "Static pressure"@en;
  rdfs:comment "Applicable units are those of quantitykind:ForcePerArea", "Applicable units are those of quantitykind:ForcePerArea";
  dct:description "\"Static Pressure\" is the pressure at a nominated point in a fluid. Every point in a steadily flowing fluid, regardless of the fluid speed at that point, has its own static pressure $P$, dynamic pressure $q$, and total pressure $P_0$. The total pressure is the sum of the dynamic and static pressures, that is $P_0 = P + q$."^^qudt:LatexString,
    "\"Static Pressure\" is the pressure at a nominated point in a fluid. Every point in a steadily flowing fluid, regardless of the fluid speed at that point, has its own static pressure $P$, dynamic pressure $q$, and total pressure $P_0$. The total pressure is the sum of the dynamic and static pressures, that is $P_0 = P + q$."^^qudt:LatexString;
  skos:broader quantitykind:Pressure, quantitykind:Pressure;
  qudt:hasDimensionVector dimensionvector:A0E0L-1I0M1H0T-2D0, dimensionvector:A0E0L-1I0M1H0T-2D0;
