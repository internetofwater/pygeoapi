    unit:KiloJ-PER-MOL .

<http://qudt.org/vocab/quantitykind/StateDensity> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "state density"@en-US;
  dct:description "function of energy in a solid, determined by the number of permissible quantum states in the energy range between E and E+dE per volume of material of this solid"@en;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/NotApplicable>;
  <http://qudt.org/schema/qudt/symbol> "0173-1#Z4-BAJ427#001";
  <http://qudt.org/schema/qudt/plainTextDescription> "Funktion der Energie in einem Festkörper, bestimmt durch die Anzahl von erlaubten Quantenzuständen im Energiebereich zwischen E und E+dE je Volumen des Materials dieses Festkörpers"@de .

<http://qudt.org/vocab/quantitykind/StateDensityAsExpressionOfAngularFrequency> a
    <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "state density as expression of angular frequency"@en-US, "state density as expression of angular frequency)";
  dct:description "ratio between number of vibration modes in an infinitesimal interval of the angular frequency and the length of this interval and the volume"@en;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L-3I0M0H0T1D0>;
  <http://qudt.org/schema/qudt/iec61360Code> "0112/2///62720#UAD180";
  <http://qudt.org/schema/qudt/informativeReference> "https://cdd.iec.ch/cdd/iec61987/iec61987.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD180"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/symbol> "0173-1#Z4-BAJ454#001";
  <http://qudt.org/schema/qudt/plainTextDescription> "Quotient aus Anzahl von Vibrationsmodi in einem infinitesimalen Intervall der Kreisfrequenz durch die Spannweite dieses Intervalls und das Volumen"@de .

<http://qudt.org/vocab/quantitykind/StaticFriction> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Static Friction"@en;
  rdfs:comment "Applicable units are those of quantitykind:Force";
  dct:description "Static friction is friction between two or more solid objects that are not moving relative to each other. For example, static friction can prevent an object from sliding down a sloped surface. "^^<http://qudt.org/schema/qudt/LatexString>;
  skos:broader <http://qudt.org/vocab/quantitykind/Friction>;
  <http://qudt.org/schema/qudt/dbpediaMatch> "http://dbpedia.org/resource/Friction"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L1I0M1H0T-2D0>;
  <http://qudt.org/schema/qudt/informativeReference> "http://en.wikipedia.org/wiki/Friction"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/isoNormativeReference> "http://www.iso.org/iso/catalogue_detail?csnumber=31889"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/plainTextDescription> "Static friction is friction between two or more solid objects that are not moving relative to each other. For example, static friction can prevent an object from sliding down a sloped surface. ";
  <http://qudt.org/schema/qudt/applicableUnit> unit:CentiN, unit:DYN, unit:DeciN, unit:GM_F,
    unit:KIP_F, unit:KiloGM-M-PER-SEC2, unit:N, unit:KiloGM_F, unit:KiloPOND, unit:KiloLB_F,
    unit:KiloN, unit:LB_F, unit:MegaLB_F, unit:MegaN, unit:MicroN, unit:MilliN, unit:OZ_F,
    unit:PDL, unit:POND, unit:PlanckForce, unit:TON_F_US .

<http://qudt.org/vocab/quantitykind/StaticFrictionCoefficient> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Static Friction Coefficient"@en;
  rdfs:comment "Applicable units are those of quantitykind:FrictionCoefficient";
  dct:description "Static friction is friction between two or more solid objects that are not moving relative to each other. For example, static friction can prevent an object from sliding down a sloped surface. "^^<http://qudt.org/schema/qudt/LatexString>;
  skos:broader <http://qudt.org/vocab/quantitykind/FrictionCoefficient>;
  <http://qudt.org/schema/qudt/dbpediaMatch> "http://dbpedia.org/resource/Friction"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1>;
  <http://qudt.org/schema/qudt/informativeReference> "http://en.wikipedia.org/wiki/Friction"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/isoNormativeReference> "http://www.iso.org/iso/catalogue_detail?csnumber=31889"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/plainTextDescription> "Static friction is friction between two or more solid objects that are not moving relative to each other. For example, static friction can prevent an object from sliding down a sloped surface. ";
  <http://qudt.org/schema/qudt/latexSymbol> "$\\mu$"^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/latexDefinition> "$\\mu = \\frac{F_max}{N}$, where $F_max$ is the maximum tangential component of the contact force and $N$ is the normal component of the contact force between two bodies at relative rest."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/qkdvDenominator> <http://qudt.org/vocab/dimensionvector/A0E0L1I0M1H0T-2D0>;
  <http://qudt.org/schema/qudt/qkdvNumerator> <http://qudt.org/vocab/dimensionvector/A0E0L1I0M1H0T-2D0>;
  <http://qudt.org/schema/qudt/applicableUnit> unit:NUM, unit:UNITLESS .

<http://qudt.org/vocab/quantitykind/StaticPressure> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Static pressure"@en;
  rdfs:comment "Applicable units are those of quantitykind:ForcePerArea";
  dct:description "\"Static Pressure\" is the pressure at a nominated point in a fluid. Every point in a steadily flowing fluid, regardless of the fluid speed at that point, has its own static pressure $P$, dynamic pressure $q$, and total pressure $P_0$. The total pressure is the sum of the dynamic and static pressures, that is $P_0 = P + q$."^^<http://qudt.org/schema/qudt/LatexString>;
  skos:broader <http://qudt.org/vocab/quantitykind/Pressure>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L-1I0M1H0T-2D0>;
  <http://qudt.org/schema/qudt/informativeReference> "http://en.wikipedia.org/wiki/Static_pressure"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/symbol> "p";
  <http://www.linkedmodel.org/schema/vaem#todo> "belongs to SOQ-ISO";
  <http://qudt.org/schema/qudt/abbreviation> "p";
  <http://qudt.org/schema/qudt/applicableUnit> unit:ATM, unit:ATM_T, unit:BAR, unit:BARAD,
    unit:BARYE, unit:CentiBAR, unit:CentiM_H2O, unit:CentiM_H2O_4DEG_C, unit:CentiM_HG,
    unit:CentiM_HG_0DEG_C, unit:DYN-PER-CentiM2, unit:DecaPA, unit:DeciBAR, unit:FT_H2O,
    unit:FT_H2O_39dot2DEG_F, unit:FT_HG, unit:GM_F-PER-CentiM2, unit:GigaPA, unit:HectoBAR,
    unit:HectoPA, unit:MilliBAR, unit:IN_H2O, unit:IN_H2O_39dot2DEG_F, unit:IN_H2O_60DEG_F,
    unit:IN_HG, unit:IN_HG_32DEG_F, unit:IN_HG_60DEG_F, unit:KIP_F-PER-IN2, unit:KiloBAR,
    unit:KiloGM-PER-M-SEC2, unit:N-PER-M2, unit:PA, unit:KiloGM_F-PER-CentiM2, unit:KiloGM_F-PER-M2,
    unit:KiloGM_F-PER-MilliM2, unit:KiloLB_F-PER-IN2, unit:KiloN-PER-M2, unit:KiloPA,
    unit:KiloPA_A, unit:LB_F-PER-FT2, unit:LB_F-PER-IN2, unit:PSI, unit:M_H2O, unit:MegaBAR,
    unit:MegaPA, unit:MegaPSI, unit:MicroATM, unit:MicroBAR, unit:MicroPA, unit:MicroTORR,
    unit:MilliM_H2O, unit:MilliM_HG, unit:MilliM_HGA, unit:MilliPA, unit:MilliTORR, unit:N-PER-CentiM2,
    unit:N-PER-MilliM2, unit:PDL-PER-FT2, unit:PDL-PER-IN2, unit:PicoPA, unit:PlanckPressure,
    unit:TORR .

<http://qudt.org/vocab/quantitykind/StrainEnergyDensity> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Strain Energy Density"@en;
  rdfs:comment "Applicable units are those of quantitykind:EnergyDensity";
  dct:description "Defined as the 'work done' for a given strain, that is the area under the stress-strain curve after a specified eation. Source(s): http://www.prepol.com/product-range/product-subpages/terminology"^^<http://qudt.org/schema/qudt/LatexString>;
  skos:broader <http://qudt.org/vocab/quantitykind/EnergyDensity>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L-1I0M1H0T-2D0>;
  <http://qudt.org/schema/qudt/symbol> "u";
  <http://qudt.org/schema/qudt/plainTextDescription> "Defined as the 'work done' for a given strain, that is the area under the stress-strain curve after a specified eation. Source(s): http://www.prepol.com/product-range/product-subpages/terminology";
  <http://qudt.org/schema/qudt/applicableUnit> unit:BTU_IT-PER-FT3, unit:BTU_TH-PER-FT3,
    unit:ERG-PER-CentiM3, unit:J-PER-M3, unit:MegaJ-PER-M3, unit:W-HR-PER-M3 .

<http://qudt.org/vocab/quantitykind/StructuralEfficiency> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Structural Efficiency"@en;
  rdfs:comment "Applicable units are those of quantitykind:Dimensionless";
  dct:description "Structural efficiency is a function of the weight of structure to the afforded vehicle's strength."^^<http://qudt.org/schema/qudt/LatexString>;
  skos:broader <http://qudt.org/vocab/quantitykind/Dimensionless>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1>;
  <http://qudt.org/schema/qudt/plainTextDescription> "Structural efficiency is a function of the weight of structure to the afforded vehicle's strength.";
  <http://qudt.org/schema/qudt/latexSymbol> "$\\gamma$"^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/applicableUnit> unit:DECADE, unit:FLIGHT, unit:GigaBasePair,
    unit:HeartBeat, unit:NP, unit:NUM, unit:OCT, unit:RPK, unit:SUSCEPTIBILITY_ELEC, unit:SUSCEPTIBILITY_MAG,
    unit:UNITLESS .

