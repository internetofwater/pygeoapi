  rdfs:label "is coherent derived unit of system";
  owl:inverseOf <http://qudt.org/schema/qudt/hasDerivedCoherentUnit>;
  rdfs:subPropertyOf <http://qudt.org/schema/qudt/derivedUnitOfSystem>, <http://qudt.org/schema/qudt/coherentUnitOfSystem>;
  dct:description "This property relates a unit of measure to the unit system in which the unit is derived from the system's base units with a proportionality constant of one."^^rdf:HTML .

<http://qudt.org/vocab/dimensionvector/A0E1L-2I0M-1H0T2D0> a <http://qudt.org/schema/qudt/QuantityKindDimensionVector_SI>,
    <http://qudt.org/schema/qudt/QuantityKindDimensionVector_ISO>, <http://qudt.org/schema/qudt/QuantityKindDimensionVector_Imperial>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/dimensionvector>;
