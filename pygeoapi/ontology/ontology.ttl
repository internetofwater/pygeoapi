quantitykind:StrainEnergyReleaseRate a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "Strain Energy Release Rate"@en, "Strain Energy Release Rate"@en;
  rdfs:comment "Applicable units are those of quantitykind:StrainEnergyReleaseRate",
    "Applicable units are those of quantitykind:StrainEnergyReleaseRate";
  dct:description "In fracture mechanics, the <b>energy release rate</b>, G, is the rate at which energy is transformed as a material undergoes fracture. Mathematically, the energy release rate is expressed as the decrease in total potential energy per increase in fracture surface area, and is thus expressed in terms of energy per unit area."^^qudt:LatexString,
    "In fracture mechanics, the <b>energy release rate</b>, G, is the rate at which energy is transformed as a material undergoes fracture. Mathematically, the energy release rate is expressed as the decrease in total potential energy per increase in fracture surface area, and is thus expressed in terms of energy per unit area."^^qudt:LatexString;
  skos:broader quantitykind:EnergyPerArea, quantitykind:EnergyPerArea;
  qudt:hasDimensionVector dimensionvector:A0E0L0I0M1H0T-2D0, dimensionvector:A0E0L0I0M1H0T-2D0;
  qudt:informativeReference "https://en.wikipedia.org/wiki/Energy_release_rate_(fracture_mechanics)"^^xsd:anyURI,
    "https://en.wikipedia.org/wiki/Energy_release_rate_(fracture_mechanics)"^^xsd:anyURI;
  qudt:symbol "G", "G";
  qudt:plainTextDescription "In fracture mechanics, the energy release rate, G, is the rate at which energy is transformed as a material undergoes fracture. Mathematically, the energy release rate is expressed as the decrease in total potential energy per increase in fracture surface area, and is thus expressed in terms of energy per unit area.",
    "In fracture mechanics, the energy release rate, G, is the rate at which energy is transformed as a material undergoes fracture. Mathematically, the energy release rate is expressed as the decrease in total potential energy per increase in fracture surface area, and is thus expressed in terms of energy per unit area.";
  qudt:latexSymbol "$\\G$"^^qudt:LatexString, "$\\G$"^^qudt:LatexString;
