unit:H-PER-OHM a qudt:Unit ;
    rdfs:label "Henry per Ohm"@en ;
    dct:description "SI derived unit henry divided by the SI derived unit ohm"^^rdf:HTML ;
    qudt:applicableSystem <http://qudt.org/vocab/sou/CGS-EMU>,
