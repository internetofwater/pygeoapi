unit:J-PER-KiloGM-K a qudt:Unit, qudt:Unit, qudt:DerivedUnit, qudt:DerivedUnit;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/unit>, <http://qudt.org/vocab/unit>;
  rdfs:label "Joule per Kilogram Kelvin"@en, "Joule per Kilogram Kelvin"@en;
  dct:description """
  Specific heat capacity - The heat required to raise unit mass of a substance by unit temperature interval under specified conditions,
   such as constant pressure: usually measured in joules per kelvin per kilogram. 
  Symbol $c_p$ (for constant pressure).
  Also called specific heat.
  """^^qudt:LatexString,
    """
  Specific heat capacity - The heat required to raise unit mass of a substance by unit temperature interval under specified conditions,
   such as constant pressure: usually measured in joules per kelvin per kilogram. 
  Symbol $c_p$ (for constant pressure).
  Also called specific heat.
  """^^qudt:LatexString;
  qudt:applicableSystem <http://qudt.org/vocab/sou/SI>, <http://qudt.org/vocab/sou/SI>;
