  <http://qudt.org/schema/qudt/ucumCode> "kg.m-2.s-2"^^<http://qudt.org/schema/qudt/UCUMcs> .

<http://qudt.org/vocab/quantitykind/PressureLossPerLength> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Pressure Loss per Length"@en;
  rdfs:comment "Applicable units are those of quantitykind:PressureLossPerLength";
  dct:description "\"Pressure Loss per Length\" refers to the power lost in overcoming the friction between two moving surfaces. Also referred to as \"Friction Loss\"."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L-2I0M1H0T-2D0>;
