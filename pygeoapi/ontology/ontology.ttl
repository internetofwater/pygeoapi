        unit:KiloV-A_Reactive-HR,
        unit:KiloVA-HR,
        unit:KiloVAR-HR,
        unit:KiloW-HR,
        unit:MegaBTU_IT,
        unit:MegaEV,
        unit:MegaJ,
        unit:MegaTOE,
        unit:MegaV-A-HR,
        unit:MegaV-A_Reactive-HR,
        unit:MegaVA-HR,
        unit:MegaVAR-HR,
        unit:MegaW-HR,
        unit:MicroJ,
        unit:MilliJ,
        unit:NanoJ,
        unit:PetaJ,
        unit:PicoJ,
        unit:PlanckEnergy,
        unit:QUAD,
        unit:THERM_EC,
