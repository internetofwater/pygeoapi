<http://qudt.org/vocab/quantitykind/ActivityRelatedByMass> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "activity related by mass"@en-US;
  rdfs:comment "Applicable units are those of quantitykind:MassicActivity";
  dct:description """
  $\\textit{Activity Related By Mass}$ is quantitative data of the radioactivity of the amount of a radionuclide in a particular state of energy at a defined point in time, 
   divided by the related mass of this quantity.
  """^^<http://qudt.org/schema/qudt/LatexString>;
  skos:broader <http://qudt.org/vocab/quantitykind/MassicActivity>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L0I0M-1H0T-1D0>;
  <http://qudt.org/schema/qudt/symbol> "0173-1#Z4-BAJ342#002";
  <http://qudt.org/schema/qudt/plainTextDescription> "quantitative Angabe der Radioaktivität einer Menge eines Radionuklids in einem bestimmten Energiezustand zu einem gegebenen Zeitpunkt dividiert durch die zugehörige Masse dieser Menge"@de,
    "quantitative data of the radioactivity of the amount of a radionuclide in a particular state of energy at a defined point in time, divided by the related mass of this quantity"@en;
  <http://qudt.org/schema/qudt/applicableUnit> unit:BQ-PER-KiloGM, unit:CI-PER-KiloGM,
    unit:KiloBQ-PER-KiloGM, unit:MegaBQ-PER-KiloGM .

