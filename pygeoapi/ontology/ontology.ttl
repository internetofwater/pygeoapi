quantitykind:ThermalResistance a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:seeAlso quantitykind:HeatFlowRate, quantitykind:HeatFlowRate, quantitykind:ThermalInsulance,
    quantitykind:ThermalInsulance, quantitykind:ThermodynamicTemperature, quantitykind:ThermodynamicTemperature;
  rdfs:label "opór cieplny"@cs, "opór cieplny"@cs, "resistencia térmica"@es, "resistencia térmica"@es,
    "resistenza termica"@it, "resistenza termica"@it, "resistência térmica"@pt, "resistência térmica"@pt,
    "résistance thermique"@fr, "résistance thermique"@fr, "thermal resistance"@en, "thermal resistance"@en,
    "thermischer Widerstand"@de, "thermischer Widerstand"@de, "مقاومة حرارية"@ar, "مقاومة حرارية"@ar,
    "热阻"@zh, "热阻"@zh, "熱抵抗"@ja, "熱抵抗"@ja;
  rdfs:comment "Applicable units are those of quantitykind:ThermalResistance", "Applicable units are those of quantitykind:ThermalResistance";
  dct:description "$\\textit{Thermal Resistance}$ is a heat property and a measure of a temperature difference by which an object or material resists a heat flow (heat per time unit or thermal resistance). Thermal resistance is the reciprocal thermal conductance. the thermodynamic temperature difference divided by heat flow rate. Thermal resistance $R$ has the units $\\frac{m^2 \\cdot K}{W}$."^^qudt:LatexString,
    "$\\textit{Thermal Resistance}$ is a heat property and a measure of a temperature difference by which an object or material resists a heat flow (heat per time unit or thermal resistance). Thermal resistance is the reciprocal thermal conductance. the thermodynamic temperature difference divided by heat flow rate. Thermal resistance $R$ has the units $\\frac{m^2 \\cdot K}{W}$."^^qudt:LatexString;
  skos:altLabel "Wärmewiderstand"@de, "Wärmewiderstand"@de;
  qudt:dbpediaMatch "http://dbpedia.org/resource/Thermal_resistance"^^xsd:anyURI, "http://dbpedia.org/resource/Thermal_resistance"^^xsd:anyURI;
