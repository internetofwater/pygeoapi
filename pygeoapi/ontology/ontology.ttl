  skos:note "Added to support Critical Zone Observatory (CZO) data use cases. ";
  skos:exactMatch "http://sis.agr.gc.ca/cansis/glossary/h/index.html" .

variablename:absorbance a skos:Concept;
  skos:definition "The amount of radiation absorbed by a material";
  skos:inScheme <http://vocabulary.odm2.org/variablename>;
  skos:topConceptOf <http://vocabulary.odm2.org/variablename>;
  skos:prefLabel "Absorbance";
  skos:historyNote "Originally from the CUAHSI HIS VariableNameCV.  See: http://his.cuahsi.org/mastercvreg/edit_cv11.aspx?tbl=VariableNameCV." .

variablename:phosphorus a skos:Concept;
  skos:definition "Phosphorus is a chemical element with symbol P and atomic number 15. Elemental phosphorus exists in two major forms, white phosphorus and red phosphorus, but because it is highly reactive, phosphorus is never found as a free element on Earth. It has a concentration in the Earth's crust of about one gram per kilogram (compare copper at about 0.06 grams). With few exceptions, minerals containing phosphorus are in the maximally oxidized state as inorganic phosphate rocks.";
  skos:inScheme <http://vocabulary.odm2.org/variablename>;
  skos:topConceptOf <http://vocabulary.odm2.org/variablename>;
  skos:prefLabel "Phosphorus";
  skos:note "Added to support Critical Zone Observatory (CZO) data use cases. ";
  skos:historyNote "Wikipedia";
  skos:exactMatch "https://en.wikipedia.org/wiki/Phosphorus" .

variablename:michaelisConstant a skos:Concept;
  skos:definition "The Michaelis constant is the substrate concentration at which the reaction rate is half of Vmax. Vmax represents the maximum rate achieved by the system, at saturating substrate concentration";
  skos:inScheme <http://vocabulary.odm2.org/variablename>;
  skos:topConceptOf <http://vocabulary.odm2.org/variablename>;
  skos:prefLabel "Michaelis constant";
  skos:note "Added to support Critical Zone Observatory (CZO) data use cases. ";
  skos:historyNote "Wikipedia";
  skos:exactMatch "https://en.wikipedia.org/wiki/Michaelis%E2%80%93Menten_kinetics" .

variablename:carbonDissolvedOrganic a skos:Concept;
  skos:definition "Dissolved Organic Carbon";
  skos:inScheme <http://vocabulary.odm2.org/variablename>;
  skos:topConceptOf <http://vocabulary.odm2.org/variablename>;
