<http://qudt.org/vocab/quantitykind/DiffusionArea> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Diffusion Area"@en;
  rdfs:comment "Applicable units are those of quantitykind:Area";
  dct:description "\"Diffusion Area\" in an infinite homogenous medium, is one-sixth of the mean square distance between the point where a neutron enters a specified class and the point where it leaves that class."^^<http://qudt.org/schema/qudt/LatexString>;
  skos:broader <http://qudt.org/vocab/quantitykind/Area>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L2I0M0H0T0D0>;
  <http://qudt.org/schema/qudt/informativeReference> "http://encyclopedia2.thefreedictionary.com/diffusion+area"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/symbol> "L^2";
  <http://qudt.org/schema/qudt/plainTextDescription> "\"Diffusion Area\" in an infinite homogenous medium, is one-sixth of the mean square distance between the point where a neutron enters a specified class and the point where it leaves that class.";
  <http://qudt.org/schema/qudt/applicableUnit> unit:AC, unit:ARE, unit:BARN, unit:CentiM2,
    unit:DecaARE, unit:DeciM2, unit:FT2, unit:HA, unit:IN2, unit:KiloM2, unit:KiloMIL_Circ,
    unit:M2, unit:MI2, unit:MI_US2, unit:MIL_Circ, unit:MicroM2, unit:MilliM2, unit:NanoM2,
    unit:PlanckArea, unit:YD2;
  <http://qudt.org/schema/qudt/normativeReference> "http://www.iso.org/iso/catalogue_detail?csnumber=31895"^^xsd:anyURI .

<http://qudt.org/vocab/quantitykind/DiffusionCoefficientForFluenceRate> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Diffusion Coefficient for Fluence Rate"@en;
  rdfs:comment "Applicable units are those of quantitykind:Length";
  dct:description "The \"Diffusion Coefficient for Fluence Rate\" is a proportionality constant between the ."^^<http://qudt.org/schema/qudt/LatexString>;
  skos:broader <http://qudt.org/vocab/quantitykind/Length>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L1I0M0H0T0D0>;
  <http://qudt.org/schema/qudt/informativeReference> "http://en.wikipedia.org/wiki/Mass_diffusivity"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/symbol> "Dᵩ";
  <http://qudt.org/schema/qudt/plainTextDescription> "The \"Diffusion Coefficient for Fluence Rate\" is a proportionality constant between the .";
  <http://qudt.org/schema/qudt/latexDefinition> "$D_\\varphi = -\\frac{J_x}{\\frac{\\partial d\\varphi}{\\partial dx}}$, where $J_x$ is the $x-component$ of the particle current and $\\varphi$ is the particle fluence rate."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/abbreviation> "m";
  <http://qudt.org/schema/qudt/applicableUnit> unit:ANGSTROM, unit:AU, unit:BTU_IT-PER-LB_F,
    unit:CH, unit:CHAIN_US, unit:CentiM, unit:DecaM, unit:DeciM, unit:FATH, unit:FM, unit:FemtoM,
    unit:FT, unit:FT_US, unit:FUR, unit:FUR_Long, unit:GAUGE_FR, unit:GA_Charriere, unit:HectoM,
    unit:IN, unit:KiloM, unit:LY, unit:M, unit:MI, unit:MI_N, unit:MI_US, unit:MicroIN,
