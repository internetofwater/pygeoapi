    skos:topConceptOf <http://vocabulary.odm2.org/variablename> .

variablename:tantalum a skos:Concept ;
    skos:definition "Tantalum is a rare, hard, blue-gray, lustrous transition metal that is highly corrosion-resistant. It is part of the refractory metals group, which are widely used as minor components in alloys." ;
    skos:exactMatch "https://en.wikipedia.org/wiki/Tantalum" ;
    skos:historyNote "Wikipedia" ;
    skos:inScheme <http://vocabulary.odm2.org/variablename> ;
    skos:note "Added to support Critical Zone Observatory (CZO) data use cases. " ;
    skos:prefLabel "Tantalum" ;
    skos:topConceptOf <http://vocabulary.odm2.org/variablename> .

variablename:taxaCount a skos:Concept ;
