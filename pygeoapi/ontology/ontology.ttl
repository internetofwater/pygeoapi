  <http://qudt.org/schema/qudt/isoNormativeReference> "http://www.iso.org/iso/catalogue_detail?csnumber=31897"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/plainTextDescription> "\"Density of States\" is the number of vibrational modes in an infinitesimal interval of angular frequency divided by the range of that interval and by volume.";
