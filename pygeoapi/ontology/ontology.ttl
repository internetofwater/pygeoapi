unit:V a qudt:Unit, qudt:Unit;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/unit>, <http://qudt.org/vocab/unit>;
  rdfs:label "Volt"@de, "Volt"@de, "volt"@cs, "volt"@cs, "volt"@en, "volt"@en, "volt"@fr,
    "volt"@fr, "volt"@hu, "volt"@hu, "volt"@it, "volt"@it, "volt"@ms, "volt"@ms, "volt"@pt,
    "volt"@pt, "volt"@ro, "volt"@ro, "volt"@sl, "volt"@sl, "volt"@tr, "volt"@tr, "voltio"@es,
    "voltio"@es, "voltium"@la, "voltium"@la, "wolt"@pl, "wolt"@pl, "βολτ"@el, "βολτ"@el,
    "волт"@bg, "волт"@bg, "вольт"@ru, "вольт"@ru, "וולט"@he, "וולט"@he, "فولت"@ar, "فولت"@ar,
    "ولت"@fa, "ولت"@fa, "वोल्ट"@hi, "वोल्ट"@hi, "ボルト"@ja, "ボルト"@ja, "伏特"@zh, "伏特"@zh;
  dct:description """$\\textit{Volt}$ is the SI unit of electric potential. 
  Separating electric charges creates potential energy, which can be measured in energy units such as joules. 
  Electric potential is defined as the amount of potential energy present per unit of charge. 
  Electric potential is measured in volts, with one volt representing a potential of one joule per coulomb of charge. 
  The name of the unit honors the Italian scientist Count Alessandro Volta (1745-1827), the inventor of the first battery.
  The volt also may be expressed with a variety of other units. 
  For example, a volt is also equal to one watt per ampere ($W/A$) and one joule per ampere per second ($J/A/s$).
  """^^qudt:LatexString,
    """$\\textit{Volt}$ is the SI unit of electric potential. 
  Separating electric charges creates potential energy, which can be measured in energy units such as joules. 
  Electric potential is defined as the amount of potential energy present per unit of charge. 
  Electric potential is measured in volts, with one volt representing a potential of one joule per coulomb of charge. 
  The name of the unit honors the Italian scientist Count Alessandro Volta (1745-1827), the inventor of the first battery.
  The volt also may be expressed with a variety of other units. 
  For example, a volt is also equal to one watt per ampere ($W/A$) and one joule per ampere per second ($J/A/s$).
  """^^qudt:LatexString;
  qudt:applicableSystem <http://qudt.org/vocab/sou/CGS-EMU>, <http://qudt.org/vocab/sou/CGS-EMU>,
    <http://qudt.org/vocab/sou/CGS-GAUSS>, <http://qudt.org/vocab/sou/CGS-GAUSS>, <http://qudt.org/vocab/sou/PLANCK>,
    <http://qudt.org/vocab/sou/PLANCK>, <http://qudt.org/vocab/sou/SI>, <http://qudt.org/vocab/sou/SI>;
  qudt:conversionMultiplier 1.0, 1.0;
  qudt:conversionMultiplierSN 1.0E0, 1.0E0;
  qudt:dbpediaMatch "http://dbpedia.org/resource/Volt"^^xsd:anyURI, "http://dbpedia.org/resource/Volt"^^xsd:anyURI;
  qudt:hasDimensionVector dimensionvector:A0E-1L2I0M1H0T-3D0, dimensionvector:A0E-1L2I0M1H0T-3D0;
  qudt:hasQuantityKind quantitykind:ElectricPotential, quantitykind:ElectricPotential,
    quantitykind:ElectricPotentialDifference, quantitykind:ElectricPotentialDifference,
    quantitykind:EnergyPerElectricCharge, quantitykind:EnergyPerElectricCharge, quantitykind:Voltage,
    quantitykind:Voltage;
  qudt:iec61360Code "0112/2///62720#UAA296", "0112/2///62720#UAA296";
  qudt:informativeReference "http://en.wikipedia.org/wiki/Volt?oldid=494812083"^^xsd:anyURI,
    "http://en.wikipedia.org/wiki/Volt?oldid=494812083"^^xsd:anyURI, "https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAA296"^^xsd:anyURI,
    "https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAA296"^^xsd:anyURI;
  qudt:omUnit <http://www.ontology-of-units-of-measure.org/resource/om-2/volt>, <http://www.ontology-of-units-of-measure.org/resource/om-2/volt>;
  qudt:siExactMatch <https://si-digital-framework.org/SI/units/volt>, <https://si-digital-framework.org/SI/units/volt>;
  qudt:symbol "V", "V";
  qudt:ucumCode "V"^^qudt:UCUMcs, "V"^^qudt:UCUMcs;
  qudt:udunitsCode "V", "V";
