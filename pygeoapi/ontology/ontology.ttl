quantitykind:ElectricFlux a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:seeAlso quantitykind:ElectricFluxDensity, quantitykind:ElectricFluxDensity;
  rdfs:label "Electric Flux"@en, "Electric Flux"@en;
  rdfs:comment "Applicable units are those of quantitykind:ElectricFlux", "Applicable units are those of quantitykind:ElectricFlux";
  dct:description "\"Electric Flux\" through an area is defined as the electric field multiplied by the area of the surface projected in a plane perpendicular to the field. Electric Flux is a scalar-valued quantity."^^qudt:LatexString,
    "\"Electric Flux\" through an area is defined as the electric field multiplied by the area of the surface projected in a plane perpendicular to the field. Electric Flux is a scalar-valued quantity."^^qudt:LatexString;
  qudt:dbpediaMatch "http://dbpedia.org/resource/Electric_flux"^^xsd:anyURI, "http://dbpedia.org/resource/Electric_flux"^^xsd:anyURI;
  qudt:hasDimensionVector dimensionvector:A0E-1L3I0M1H0T-3D0, dimensionvector:A0E-1L3I0M1H0T-3D0;
  qudt:informativeReference "http://www.iso.org/iso/home/store/catalogue_tc/catalogue_detail.htm?csnumber=31891"^^xsd:anyURI,
    "http://www.iso.org/iso/home/store/catalogue_tc/catalogue_detail.htm?csnumber=31891"^^xsd:anyURI;
  qudt:expression "$electirc-flux$"^^qudt:LatexString, "$electirc-flux$"^^qudt:LatexString;
  qudt:plainTextDescription "\"Electric Flux\" through an area is defined as the electric field multiplied by the area of the surface projected in a plane perpendicular to the field. Electric Flux is a scalar-valued quantity.",
    "\"Electric Flux\" through an area is defined as the electric field multiplied by the area of the surface projected in a plane perpendicular to the field. Electric Flux is a scalar-valued quantity.";
  qudt:latexSymbol "$\\Psi$"^^qudt:LatexString, "$\\Psi$"^^qudt:LatexString;
  qudt:latexDefinition "$\\Psi = \\int_S D \\cdot e_n dA$, over a surface $S$, where $D$ is electric flux density and $e_n dA$ is the vector surface element."^^qudt:LatexString,
    "$\\Psi = \\int_S D \\cdot e_n dA$, over a surface $S$, where $D$ is electric flux density and $e_n dA$ is the vector surface element."^^qudt:LatexString;
