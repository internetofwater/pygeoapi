unit:M a <http://qudt.org/schema/qudt/Unit>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/unit>;
  rdfs:label "Meter"@de, "Meter"@en-US, "meter"@ms, "meter"@sl, "metr"@cs, "metr"@pl,
    "metre"@en, "metre"@tr, "metro"@es, "metro"@it, "metro"@pt, "metru"@ro, "metrum"@la,
    "mètre"@fr, "méter"@hu, "μέτρο"@el, "метр"@ru, "метър"@bg, "מטר"@he, "متر"@ar, "متر"@fa,
    "मीटर"@hi, "メートル"@ja, "米"@zh;
  dct:description "The metric and SI base unit of distance.  The 17th General Conference on Weights and Measures in 1983 defined the meter as that distance that makes the speed of light in a vacuum equal to exactly 299 792 458 meters per second. The speed of light in a vacuum, $c$, is one of the fundamental constants of nature. The meter is equal to approximately 1.093 613 3 yards, 3.280 840 feet, or 39.370 079 inches."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/applicableSystem> <http://qudt.org/vocab/sou/CGS-EMU>,
    <http://qudt.org/vocab/sou/CGS-GAUSS>, <http://qudt.org/vocab/sou/SI>, <http://qudt.org/vocab/sou/CGS>;
  <http://qudt.org/schema/qudt/conversionMultiplier> 1.0;
  <http://qudt.org/schema/qudt/conversionMultiplierSN> 1.0E0;
  <http://qudt.org/schema/qudt/dbpediaMatch> "http://dbpedia.org/resource/Metre"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L1I0M0H0T0D0>;
  <http://qudt.org/schema/qudt/hasQuantityKind> <http://qudt.org/vocab/quantitykind/Length>,
    <http://qudt.org/vocab/quantitykind/ElevationRelativeToNAP>;
  <http://qudt.org/schema/qudt/iec61360Code> "0112/2///62720#UAA726", "0112/2///62720#UAD718";
  <http://qudt.org/schema/qudt/informativeReference> "http://en.wikipedia.org/wiki/Metre?oldid=495145797"^^xsd:anyURI,
    "https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAA726"^^xsd:anyURI,
    "https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAD718"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/omUnit> <http://www.ontology-of-units-of-measure.org/resource/om-2/metre>;
  <http://qudt.org/schema/qudt/siExactMatch> <https://si-digital-framework.org/SI/units/metre>;
  <http://qudt.org/schema/qudt/symbol> "m";
  <http://qudt.org/schema/qudt/ucumCode> "m"^^<http://qudt.org/schema/qudt/UCUMcs>;
  <http://qudt.org/schema/qudt/udunitsCode> "m";
  <http://qudt.org/schema/qudt/uneceCommonCode> "MTR";
  <http://qudt.org/schema/qudt/plainTextDescription> "The metric and SI base unit of distance.   The meter is equal to approximately 1.093 613 3 yards, 3.280 840 feet, or 39.370 079 inches.";
  <http://qudt.org/schema/qudt/definedUnitOfSystem> <http://qudt.org/vocab/sou/SI> .

<http://qudt.org/vocab/quantitykind/ElevationRelativeToNAP> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Elevation relative to NAP"@en, "Hoogte ten opzichte van NAP"@nl;
  rdfs:comment "Height measurement relative to the Normaal Amsterdams Peil (NAP) (en: Amsterdam Ordnance System). Being a form of gravity related height",
    "Applicable units are those of quantitykind:ElevationRelativeToNAP";
  skos:prefLabel "Elevation relative to NAP"@en, "Hoogte ten opzichte van NAP"@nl;
  skos:broader <http://qudt.org/vocab/quantitykind/Altitude>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L1I0M0H0T0D0>;
  <http://qudt.org/schema/qudt/symbol> "mNAP";
  <http://qudt.org/schema/qudt/plainTextDescription> "Height measurement relative to the Normaal Amsterdams Peil (NAP) (en: Amsterdam Ordnance System). Being a form of gravity related height";
  <http://www.w3.org/ns/prov#wasDerivedFrom> <https://www.opengis.net/def/crs/EPSG/0/5709>;
  <http://qudt.org/schema/qudt/applicableUnit> unit:M;
  <http://www.w3.org/ns/prov#wasInfluencedBy> <https://epsg.io/5709> .

