variablename:glutathione_S_TransferaseDeltaCycleThreshold a skos:Concept ;
    skos:definition "Delta cycle threshold for glutathione S-transferase (gst). Cycle threshold is the PCR cycle number at which the fluorescent signal of the gene being amplified crosses the set threshold. Delta cycle threshold for gst is the difference between the cycle threshold (Ct) of gst gene expression and the cycle threshold (Ct) for the gene expression of the reference gene (e.g., beta-actin)." ;
    skos:historyNote "Originally from the CUAHSI HIS VariableNameCV.  See: http://his.cuahsi.org/mastercvreg/edit_cv11.aspx?tbl=VariableNameCV." ;
    skos:inScheme <http://vocabulary.odm2.org/variablename> ;
    skos:prefLabel "Glutathione S-transferase, delta cycle threshold" ;
    skos:topConceptOf <http://vocabulary.odm2.org/variablename> .

variablename:goethite a skos:Concept ;
    skos:definition "Goethite, FeO(OH), is an iron-bearing hydroxide mineral of the diaspore group. It is found in soil and other low-temperature environments. " ;
    skos:exactMatch "https://en.wikipedia.org/wiki/Goethite" ;
    skos:historyNote "Wikipedia" ;
    skos:inScheme <http://vocabulary.odm2.org/variablename> ;
    skos:note "Added to support Critical Zone Observatory (CZO) data use cases. " ;
    skos:prefLabel "Goethite" ;
    skos:topConceptOf <http://vocabulary.odm2.org/variablename> .

variablename:grainSize a skos:Concept ;
    skos:definition "Grain size (or particle size) is the diameter of individual grains of sediment, or the lithified particles in clastic rocks. The term may also be applied to other granular materials." ;
    skos:exactMatch "https://en.wikipedia.org/wiki/Grain_size" ;
    skos:historyNote "Wikipedia" ;
    skos:inScheme <http://vocabulary.odm2.org/variablename> ;
    skos:note "Added to support Critical Zone Observatory (CZO) data use cases. " ;
    skos:prefLabel "Grain size" ;
    skos:topConceptOf <http://vocabulary.odm2.org/variablename> .

