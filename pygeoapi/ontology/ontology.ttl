variablename:topographicWetnessIndex a skos:Concept ;
    skos:definition "Topographic wetness index (TWI), also known as the compound topographic index (CTI), is a steady state wetness index. It is commonly used to quantify topographic control on hydrological processes." ;
    skos:exactMatch "https://en.wikipedia.org/wiki/Topographic_wetness_index" ;
    skos:historyNote "Wikipedia" ;
    skos:inScheme <http://vocabulary.odm2.org/variablename> ;
    skos:note "Added to support Critical Zone Observatory (CZO) data use cases. " ;
    skos:prefLabel "Topographic Wetness Index (TWI)" ;
