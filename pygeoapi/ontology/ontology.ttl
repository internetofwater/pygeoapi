    qudt:informativeReference "https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAA456"^^xsd:anyURI ;
    qudt:symbol "ft³" ;
    qudt:ucumCode "[cft_i]"^^qudt:UCUMcs,
