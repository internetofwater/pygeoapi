quantitykind:SecondRadiationConstant a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "second radiation constant"@en-US, "second radiation constant"@en-US;
  dct:description "constant in Planck's radiation law on the dependence of the spectral density of various radiation variables on the wavelength of the electromagnetic radiation and the absolute temperature of the black radiator, derived from the product of Planck's quantum of action times the velocity of light in relation to Boltzmann's constant"@en,
    "constant in Planck's radiation law on the dependence of the spectral density of various radiation variables on the wavelength of the electromagnetic radiation and the absolute temperature of the black radiator, derived from the product of Planck's quantum of action times the velocity of light in relation to Boltzmann's constant"@en;
