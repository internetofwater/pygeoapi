quantitykind:RadiantEnergy a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "Işınım erkesi"@tr, "Işınım erkesi"@tr, "Strahlungsenergie"@de, "Strahlungsenergie"@de,
    "Tenaga sinaran"@ms, "Tenaga sinaran"@ms, "energia promienista"@pl, "energia promienista"@pl,
    "energia radiante"@it, "energia radiante"@it, "energia radiante"@pt, "energia radiante"@pt,
    "energie záření"@cs, "energie záření"@cs, "energía radiante"@es, "energía radiante"@es,
    "radiant energy"@en, "radiant energy"@en, "énergie rayonnante"@fr, "énergie rayonnante"@fr,
    "энергия излучения"@ru, "энергия излучения"@ru, "انرژی تابشی"@fa, "انرژی تابشی"@fa,
    "طاقة إشعاعية"@ar, "طاقة إشعاعية"@ar, "विकिरण ऊर्जा"@hi, "विकिरण ऊर्जा"@hi, "放射エネルギー"@ja,
