<http://qudt.org/vocab/quantitykind/TemperatureRateOfChange> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Temperature Rate of Change"@en;
  rdfs:comment "Applicable units are those of quantitykind:TemperaturePerTime";
  dct:description "The \"Temperature Rate of Change\" measures the difference of a temperature per time (positive: rise, negative: fall), as for instance used with heat sensors. It is for example measured in K/s."^^<http://qudt.org/schema/qudt/LatexString>;
  skos:broader <http://qudt.org/vocab/quantitykind/TemperaturePerTime>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H1T-1D0>;
  <http://qudt.org/schema/qudt/iec61360Code> "0112/2///62720#UAD186";
  <http://qudt.org/schema/qudt/informativeReference> "https://cdd.iec.ch/cdd/iec61987/iec61987.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD186"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/symbol> "0173-1#Z4-BAJ416#002";
  <http://qudt.org/schema/qudt/plainTextDescription> "The \"Temperature Rate of Change\" measures the difference of a temperature per time (positive: rise, negative: fall), as for instance used with heat sensors. It is for example measured in K/s.";
  <http://qudt.org/schema/qudt/applicableUnit> unit:DEG_C-PER-HR, unit:DEG_C-PER-MIN,
    unit:DEG_C-PER-SEC, unit:DEG_C-PER-YR, unit:DEG_F-PER-HR, unit:DEG_F-PER-MIN, unit:DEG_F-PER-SEC,
    unit:DEG_R-PER-HR, unit:DEG_R-PER-MIN, unit:DEG_R-PER-SEC, unit:K-PER-HR, unit:K-PER-MIN,
    unit:K-PER-SEC .

<http://qudt.org/vocab/quantitykind/TemperatureRelatedMolarMass> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "temperature-related molar mass"@en-US;
  dct:description "molarity (mass of a substance in relation to the amount of this substance) divided by temperature"@en;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/NotApplicable>;
  <http://qudt.org/schema/qudt/symbol> "0173-1#Z4-BAJ443#002";
  <http://qudt.org/schema/qudt/plainTextDescription> "Molarität (Masse einer Substanz bezogen auf die Stoffmenge dieser Substanz ) dividiert durch die Temperatur"@de .

<http://qudt.org/vocab/quantitykind/TemperatureRelatedVolume> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "temperature-related volume  "@en-US;
  dct:description "volume divided by temperature"@en;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L3I0M0H-1T0D0>;
  <http://qudt.org/schema/qudt/symbol> "0173-1#Z4-BAJ398#002";
  <http://qudt.org/schema/qudt/plainTextDescription> "Volumen dividiert durch Temperatur"@de .

<http://qudt.org/vocab/quantitykind/Tension> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Tension"@en;
