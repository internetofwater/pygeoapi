quantitykind:LondonPenetrationDepth a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "London Penetration Depth"@en, "London Penetration Depth"@en;
  rdfs:comment "Applicable units are those of quantitykind:Length", "Applicable units are those of quantitykind:Length";
  dct:description "\"London Penetration Depth\" characterizes the distance to which a magnetic field penetrates into a superconductor and becomes equal to 1/e times that of the magnetic field at the surface of the superconductor."^^qudt:LatexString,
    "\"London Penetration Depth\" characterizes the distance to which a magnetic field penetrates into a superconductor and becomes equal to 1/e times that of the magnetic field at the surface of the superconductor."^^qudt:LatexString;
  skos:broader quantitykind:Length, quantitykind:Length;
  qudt:hasDimensionVector dimensionvector:A0E0L1I0M0H0T0D0, dimensionvector:A0E0L1I0M0H0T0D0;
  qudt:informativeReference "http://en.wikipedia.org/wiki/London_penetration_depth"^^xsd:anyURI,
    "http://en.wikipedia.org/wiki/London_penetration_depth"^^xsd:anyURI;
  qudt:symbol "λₗ", "λₗ";
  qudt:plainTextDescription "\"London Penetration Depth\" characterizes the distance to which a magnetic field penetrates into a superconductor and becomes equal to 1/e times that of the magnetic field at the surface of the superconductor.",
    "\"London Penetration Depth\" characterizes the distance to which a magnetic field penetrates into a superconductor and becomes equal to 1/e times that of the magnetic field at the surface of the superconductor.";
  qudt:latexDefinition "If an applied magnetic field is parallel to the plane surface of a semi-infinite superconductor, the field penetrates the superconductor according to the expression $B(x) = B(0) \\exp{(\\frac{-x}{\\lambda_L})}$, where $B$ is magnetic flux density and $x$ is the distance from the surface."^^qudt:LatexString,
    "If an applied magnetic field is parallel to the plane surface of a semi-infinite superconductor, the field penetrates the superconductor according to the expression $B(x) = B(0) \\exp{(\\frac{-x}{\\lambda_L})}$, where $B$ is magnetic flux density and $x$ is the distance from the surface."^^qudt:LatexString;
