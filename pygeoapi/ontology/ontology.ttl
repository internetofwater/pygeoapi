quantitykind:MolarHeatCapacity a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "Molar Heat Capacity"@en, "Molar Heat Capacity"@en;
  rdfs:comment "Applicable units are those of quantitykind:MolarHeatCapacity", "Applicable units are those of quantitykind:MolarHeatCapacity";
  dct:description "\"Molar Heat Capacity\" is the amount of heat energy required to raise the temperature of 1 mole of a substance. In SI units, molar heat capacity (symbol: cn) is the amount of heat in joules required to raise 1 mole of a substance 1 Kelvin."^^qudt:LatexString,
    "\"Molar Heat Capacity\" is the amount of heat energy required to raise the temperature of 1 mole of a substance. In SI units, molar heat capacity (symbol: cn) is the amount of heat in joules required to raise 1 mole of a substance 1 Kelvin."^^qudt:LatexString;
  qudt:hasDimensionVector dimensionvector:A-1E0L2I0M1H-1T-2D0, dimensionvector:A-1E0L2I0M1H-1T-2D0;
  qudt:iec61360Code "0112/2///62720#UAD123", "0112/2///62720#UAD123";
  qudt:informativeReference "http://chemistry.about.com/od/chemistryglossary/g/Molar-Heat-Capacity-Definition.htm"^^xsd:anyURI,
    "http://chemistry.about.com/od/chemistryglossary/g/Molar-Heat-Capacity-Definition.htm"^^xsd:anyURI,
    "https://cdd.iec.ch/cdd/iec61987/iec61987.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD123"^^xsd:anyURI,
    "https://cdd.iec.ch/cdd/iec61987/iec61987.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD123"^^xsd:anyURI;
  qudt:symbol "C_m", "C_m";
  qudt:isoNormativeReference "http://www.iso.org/iso/catalogue_detail?csnumber=31894"^^xsd:anyURI,
    "http://www.iso.org/iso/catalogue_detail?csnumber=31894"^^xsd:anyURI;
  qudt:plainTextDescription "\"Molar Heat Capacity\" is the amount of heat energy required to raise the temperature of 1 mole of a substance. In SI units, molar heat capacity (symbol: cn) is the amount of heat in joules required to raise 1 mole of a substance 1 Kelvin.",
    "\"Molar Heat Capacity\" is the amount of heat energy required to raise the temperature of 1 mole of a substance. In SI units, molar heat capacity (symbol: cn) is the amount of heat in joules required to raise 1 mole of a substance 1 Kelvin.";
  qudt:latexDefinition "$C_m = \\frac{C}{n}$, where $C$ is heat capacity and $n$ is amount of substance."^^qudt:LatexString,
    "$C_m = \\frac{C}{n}$, where $C$ is heat capacity and $n$ is amount of substance."^^qudt:LatexString;
  qudt:altSymbol "cn", "cn";
  qudt:applicableUnit unit:BTU_IT-PER-MOL_LB-DEG_F, unit:BTU_IT-PER-MOL_LB-DEG_F, unit:J-PER-MOL-K,
    unit:J-PER-MOL-K, unit:KiloCAL-PER-MOL-DEG_C, unit:KiloCAL-PER-MOL-DEG_C .

