quantitykind:VisionThresholds a qudt:QuantityKind ;
    rdfs:label "Vision Thresholds"@en ;
    dct:description "\"Vision Thresholds\" is an abstract term to refer to a variety of measures for the thresholds of sensitivity of the eye."^^qudt:LatexString ;
