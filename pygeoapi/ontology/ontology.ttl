quantitykind:MagneticAreaMoment a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "Magnetic Area Moment"@en, "Magnetic Area Moment"@en;
  rdfs:comment "Applicable units are those of quantitykind:MagneticAreaMoment", "Applicable units are those of quantitykind:MagneticAreaMoment";
  dct:description "\"Magnetic Area Moment\", for a magnetic dipole, is a vector quantity equal to the product of the current, the loop area, and the unit vector normal to the loop plane, the direction of which corresponds to the loop orientation. \"Magnetic Area Moment\" is also referred to as \"Magnetic Moment\"."^^qudt:LatexString,
    "\"Magnetic Area Moment\", for a magnetic dipole, is a vector quantity equal to the product of the current, the loop area, and the unit vector normal to the loop plane, the direction of which corresponds to the loop orientation. \"Magnetic Area Moment\" is also referred to as \"Magnetic Moment\"."^^qudt:LatexString;
  qudt:hasDimensionVector dimensionvector:A0E1L2I0M0H0T0D0, dimensionvector:A0E1L2I0M0H0T0D0;
  qudt:informativeReference "http://www.iso.org/iso/home/store/catalogue_tc/catalogue_detail.htm?csnumber=31891"^^xsd:anyURI,
    "http://www.iso.org/iso/home/store/catalogue_tc/catalogue_detail.htm?csnumber=31891"^^xsd:anyURI,
    "http://www.electropedia.org/iev/iev.nsf/display?openform&ievref=121-11-49"^^xsd:anyURI,
    "http://www.electropedia.org/iev/iev.nsf/display?openform&ievref=121-11-49"^^xsd:anyURI;
  qudt:symbol "m", "m";
  qudt:plainTextDescription "\"Magnetic Area Moment\", for a magnetic dipole, is a vector quantity equal to the product of the current, the loop area, and the unit vector normal to the loop plane, the direction of which corresponds to the loop orientation. \"Magnetic Area Moment\" is also referred to as \"Magnetic Moment\".",
    "\"Magnetic Area Moment\", for a magnetic dipole, is a vector quantity equal to the product of the current, the loop area, and the unit vector normal to the loop plane, the direction of which corresponds to the loop orientation. \"Magnetic Area Moment\" is also referred to as \"Magnetic Moment\".";
  qudt:exactMatch quantitykind:MagneticMoment, quantitykind:MagneticMoment;
  qudt:latexDefinition "$m = I e_n A$, where $I$ is electric current in a small closed loop, $e_n$ is a unit vector perpendicular to the loop, and $A$ is the area of the loop. The magnetic moment of a substance within a domain is the vector sum of the magnetic moments of all entities included in the domain."^^qudt:LatexString,
    "$m = I e_n A$, where $I$ is electric current in a small closed loop, $e_n$ is a unit vector perpendicular to the loop, and $A$ is the area of the loop. The magnetic moment of a substance within a domain is the vector sum of the magnetic moments of all entities included in the domain."^^qudt:LatexString;
  qudt:applicableUnit unit:A-M2, unit:A-M2, unit:A_Ab-CentiM2, unit:A_Ab-CentiM2, unit:EV-PER-T,
    unit:EV-PER-T, unit:J-PER-T, unit:J-PER-T .

