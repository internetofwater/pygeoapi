<http://qudt.org/vocab/quantitykind/Pressure> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Druck"@de, "Tekanan"@ms, "Tlak"@cs, "basınç"@tr, "ciśnienie"@pl, "nyomás"@hu,
    "presiune"@ro, "presión"@es, "pressio"@la, "pression"@fr, "pressione"@it, "pressure"@en,
    "pressão"@pt, "tlak"@sl, "Πίεση - τάση"@el, "Давление"@ru, "Налягане"@bg, "לחץ"@he,
    "الضغط أو الإجهاد"@ar, "فشار، تنش"@fa, "दबाव"@hi, "压强、压力"@zh, "圧力"@ja;
  rdfs:comment "Applicable units are those of quantitykind:ForcePerArea";
  dct:description "Pressure is an effect which occurs when a force is applied on a surface. Pressure is the amount of force acting on a unit area. Pressure is distinct from stress, as the former is the ratio of the component of force normal to a surface to the surface area. Stress is a tensor that relates the vector force to the vector area."^^<http://qudt.org/schema/qudt/LatexString>;
  skos:altLabel "naprężenie"@pl, "pritisk"@sl, "tegasan"@ms, "tensione meccanica"@it,
    "tensiune mecanică"@ro, "tensão"@pt, "механично напрежение"@bg, "दाब"@hi;
  skos:broader <http://qudt.org/vocab/quantitykind/ForcePerArea>;
  <http://qudt.org/schema/qudt/dbpediaMatch> "http://dbpedia.org/resource/Pressure"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L-1I0M1H0T-2D0>;
  <http://qudt.org/schema/qudt/iec61360Code> "0112/2///62720#UAD142";
  <http://qudt.org/schema/qudt/informativeReference> "http://en.wikipedia.org/wiki/Pressure"^^xsd:anyURI,
    "https://cdd.iec.ch/cdd/iec61987/iec61987.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD142"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/siExactMatch> <https://si-digital-framework.org/SI/quantities/PRES>;
  <http://qudt.org/schema/qudt/isoNormativeReference> "http://www.iso.org/iso/catalogue_detail?csnumber=31889"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/plainTextDescription> "Pressure is an effect which occurs when a force is applied on a surface. Pressure is the amount of force acting on a unit area. Pressure is distinct from stress, as the former is the ratio of the component of force normal to a surface to the surface area. Stress is a tensor that relates the vector force to the vector area.";
  <http://qudt.org/schema/qudt/latexDefinition> "$p = \\frac{dF}{dA}$, where $dF$ is the force component perpendicular to the surface element of area $dA$."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/applicableUnit> unit:ATM, unit:ATM_T, unit:BAR, unit:BARAD,
    unit:BARYE, unit:CentiBAR, unit:CentiM_H2O, unit:CentiM_H2O_4DEG_C, unit:CentiM_HG,
    unit:CentiM_HG_0DEG_C, unit:DYN-PER-CentiM2, unit:DecaPA, unit:DeciBAR, unit:FT_H2O,
