quantitykind:Wavenumber a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:seeAlso quantitykind:AngularWavenumber, quantitykind:AngularWavenumber;
  rdfs:label "Bilangan gelombang"@ms, "Bilangan gelombang"@ms, "Liczba falowa"@pl, "Liczba falowa"@pl,
    "Repetenz"@de, "Repetenz"@de, "Vlnové číslo"@cs, "Vlnové číslo"@cs, "dalga sayısı"@tr,
    "dalga sayısı"@tr, "nombre d'onde"@fr, "nombre d'onde"@fr, "numero d'onda"@it, "numero d'onda"@it,
    "número de ola"@es, "número de ola"@es, "número de onda"@pt, "número de onda"@pt,
    "valovno število"@sl, "valovno število"@sl, "wavenumber"@en, "wavenumber"@en, "Волновое число"@ru,
    "Волновое число"@ru, "عدد الموجة"@ar, "عدد الموجة"@ar, "عدد موج"@fa, "عدد موج"@fa,
    "波数"@ja, "波数"@ja, "波数"@zh, "波数"@zh;
  rdfs:comment "Applicable units are those of quantitykind:InverseLength", "Applicable units are those of quantitykind:InverseLength";
  dct:description "\"Wavenumber\" is the spatial frequency of a wave - the number of waves that exist over a specified distance. More formally, it is the reciprocal of the wavelength. It is also the magnitude of the wave vector. Light passing through different media keeps its frequency, but not its wavelength or wavenumber. The unit for wavenumber commonly used in spectroscopy is centimetre to power minus one, PER-CM, rather than metre to power minus one, PER-M."^^qudt:LatexString,
    "\"Wavenumber\" is the spatial frequency of a wave - the number of waves that exist over a specified distance. More formally, it is the reciprocal of the wavelength. It is also the magnitude of the wave vector. Light passing through different media keeps its frequency, but not its wavelength or wavenumber. The unit for wavenumber commonly used in spectroscopy is centimetre to power minus one, PER-CM, rather than metre to power minus one, PER-M."^^qudt:LatexString;
  skos:altLabel "Wellenzahl"@de, "Wellenzahl"@de;
  skos:broader quantitykind:InverseLength, quantitykind:InverseLength;
  qudt:hasDimensionVector dimensionvector:A0E0L-1I0M0H0T0D0, dimensionvector:A0E0L-1I0M0H0T0D0;
  qudt:informativeReference "http://en.wikipedia.org/wiki/Wavenumber"^^xsd:anyURI, "http://en.wikipedia.org/wiki/Wavenumber"^^xsd:anyURI;
  qudt:siExactMatch <https://si-digital-framework.org/SI/quantities/WANU>, <https://si-digital-framework.org/quantities/WANU>;
  qudt:plainTextDescription "\"Wavenumber\" is the spatial frequency of a wave - the number of waves that exist over a specified distance. More formally, it is the reciprocal of the wavelength. It is also the magnitude of the wave vector. Light passing through different media keeps its frequency, but not its wavelength or wavenumber. The unit for wavenumber commonly used in spectroscopy is centimetre to power minus one, PER-CM, rather than metre to power minus one, PER-M.",
    "\"Wavenumber\" is the spatial frequency of a wave - the number of waves that exist over a specified distance. More formally, it is the reciprocal of the wavelength. It is also the magnitude of the wave vector. Light passing through different media keeps its frequency, but not its wavelength or wavenumber. The unit for wavenumber commonly used in spectroscopy is centimetre to power minus one, PER-CM, rather than metre to power minus one, PER-M.";
  qudt:latexSymbol "$\\sigma$"^^qudt:LatexString, "$\\sigma$"^^qudt:LatexString;
  qudt:latexDefinition """$\\sigma = \\frac{\\nu}{c}$, where $\\sigma$ is the wave number, $\\nu$ is the frequency, and $c$ is the speed of light in the medium.

Or:

$k = \\frac{2\\pi}{\\lambda}= \\frac{2\\pi\\upsilon}{\\upsilon_p}=\\frac{\\omega}{\\upsilon_p}$, where $\\upsilon$ is the frequency of the wave, $\\lambda$ is the wavelength, $\\omega = 2\\pi \\upsilon$ is the angular frequency of the wave, and $\\upsilon_p$ is the phase velocity of the wave."""^^qudt:LatexString,
    """$\\sigma = \\frac{\\nu}{c}$, where $\\sigma$ is the wave number, $\\nu$ is the frequency, and $c$ is the speed of light in the medium.

Or:

$k = \\frac{2\\pi}{\\lambda}= \\frac{2\\pi\\upsilon}{\\upsilon_p}=\\frac{\\omega}{\\upsilon_p}$, where $\\upsilon$ is the frequency of the wave, $\\lambda$ is the wavelength, $\\omega = 2\\pi \\upsilon$ is the angular frequency of the wave, and $\\upsilon_p$ is the phase velocity of the wave."""^^qudt:LatexString;
  qudt:applicableUnit unit:DPI, unit:KY, unit:KY, unit:M-PER-HA, unit:M-PER-HA, unit:M-PER-M2,
    unit:M-PER-M2, unit:MESH, unit:MESH, unit:NUM-PER-M, unit:NUM-PER-M, unit:PER-M, unit:PER-M,
    unit:PER-ANGSTROM, unit:PER-ANGSTROM, unit:PER-CentiM, unit:PER-CentiM, unit:PER-KiloM,
    unit:PER-KiloM, unit:PER-MicroM, unit:PER-MicroM, unit:PER-MilliM, unit:PER-MilliM,
    unit:PER-NanoM, unit:PER-NanoM, unit:PER-PicoM, unit:PER-PicoM .

