quantitykind:CombinedNonEvaporativeHeatTransferCoefficient a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "Combined Non Evaporative Heat Transfer Coefficient"@en, "Combined Non Evaporative Heat Transfer Coefficient"@en;
  rdfs:comment "Applicable units are those of quantitykind:CombinedNonEvaporativeHeatTransferCoefficient",
    "Applicable units are those of quantitykind:CombinedNonEvaporativeHeatTransferCoefficient";
  dct:description "\"Combined Non Evaporative Heat Transfer Coefficient\" is the "^^qudt:LatexString;
  qudt:hasDimensionVector dimensionvector:A0E0L0I0M1H-1T-3D0, dimensionvector:A0E0L0I0M1H-1T-3D0;
  qudt:symbol "h", "h";
  qudt:isoNormativeReference "http://www.iso.org/iso/catalogue_detail?csnumber=43012"^^xsd:anyURI,
    "http://www.iso.org/iso/catalogue_detail?csnumber=43012"^^xsd:anyURI;
  qudt:plainTextDescription "\"Combined Non Evaporative Heat Transfer Coefficient\" is the ";
  qudt:latexDefinition "$h = h_r + h_c + h_k$, where $h_r$ is the linear radiative heat transfer coefficient, $h_c$ is the convective heat transfer coefficient, and $h_k$ is the conductive heat transfer coefficient."^^qudt:LatexString,
    "$h = h_r + h_c + h_k$, where $h_r$ is the linear radiative heat transfer coefficient, $h_c$ is the convective heat transfer coefficient, and $h_k$ is the conductive heat transfer coefficient."^^qudt:LatexString;
  qudt:applicableUnit unit:KiloW-PER-M2-K, unit:KiloW-PER-M2-K, unit:W-PER-M2-K, unit:W-PER-M2-K .

