  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "temperature-based volume flow rate"@en-US;
  dct:description "ratio of volume flow divided by the related temperature"@en;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/NotApplicable>;
  <http://qudt.org/schema/qudt/symbol> "0173-1#Z4-BAJ397#002";
  <http://qudt.org/schema/qudt/plainTextDescription> "Quotient aus Volumenstrom dividiert durch die zugehörige Temperatur"@de .

<http://qudt.org/vocab/quantitykind/TemperatureDifference> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
