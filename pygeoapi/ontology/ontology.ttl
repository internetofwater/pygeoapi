variablename:depthUnsaturatedZone a skos:Concept;
  skos:definition "Depth of the Unsaturated zone. The vadose zone, also termed the unsaturated zone, is the part of Earth between the land surface and the top of the phreatic zone, the position at which the groundwater (the water in the soil's pores) is at atmospheric pressure (\"vadose\" is from the Latin for \"shallow\"). Hence, the vadose zone extends from the top of the ground surface to the water table.";
  skos:topConceptOf <http://vocabulary.odm2.org/variablename>;
  skos:prefLabel "Depth, unsaturated zone ";
  skos:note "Added to support Critical Zone Observatory (CZO) data use cases. ";
  skos:historyNote "Wikipedia";
  skos:exactMatch "https://en.wikipedia.org/wiki/Vadose_zone" .

variablename:radon_222 a skos:Concept;
  skos:definition "An isotope of radon";
  skos:topConceptOf <http://vocabulary.odm2.org/variablename>;
  skos:prefLabel "Radon-222";
  skos:historyNote "Originally from the CUAHSI HIS VariableNameCV.  See: http://his.cuahsi.org/mastercvreg/edit_cv11.aspx?tbl=VariableNameCV." .

variablename:augelite a skos:Concept;
  skos:definition "Augelite is an aluminium phosphate mineral with formula: Al2(PO4)(OH)3. The shade varies from colorless to white, yellow or rose. Its crystal system is monoclinic";
  skos:topConceptOf <http://vocabulary.odm2.org/variablename>;
  skos:prefLabel "Augelite";
  skos:note "Added to support Critical Zone Observatory (CZO) data use cases. ";
  skos:historyNote "Wikipedia";
  skos:exactMatch "https://en.wikipedia.org/wiki/Augelite" .

variablename:bis_2_Ethylhexyl_Phthalate a skos:Concept;
  skos:definition "Bis-(2-ethylhexyl) phthalate (C6H4(C8H17COO)2)";
  skos:topConceptOf <http://vocabulary.odm2.org/variablename>;
  skos:prefLabel "Bis-(2-ethylhexyl) phthalate";
  skos:historyNote "Originally from the CUAHSI HIS VariableNameCV.  See: http://his.cuahsi.org/mastercvreg/edit_cv11.aspx?tbl=VariableNameCV." .

variablename:beryllium a skos:Concept;
  skos:definition "Beryllium is a chemical element with symbol Be and atomic number 4. It is a relatively rare element in the universe, usually occurring as a product of the spallation of larger atomic nuclei that have collided with cosmic rays. Within the cores of stars beryllium is depleted as it is fused and creates larger elements. It is a divalent element which occurs naturally only in combination with other elements in minerals. Notable gemstones which contain beryllium include beryl (aquamarine, emerald) and chrysoberyl. As a free element it is a steel-gray, strong, lightweight and brittle alkaline earth metal.";
  skos:topConceptOf <http://vocabulary.odm2.org/variablename>;
  skos:prefLabel "Beryllium";
  skos:note "Added to support Critical Zone Observatory (CZO) data use cases. ";
  skos:historyNote "Wikipedia";
  skos:exactMatch "https://en.wikipedia.org/wiki/Beryllium" .

variablename:indicator a skos:Concept;
