unit:TON_SHORT a qudt:Unit, qudt:Unit;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/unit>, <http://qudt.org/vocab/unit>;
  rdfs:label "Short Ton"@en, "Short Ton"@en;
  dct:description "<p>The short ton is a unit of mass equal to 2,000 pounds (907.18474 kg). In the United States it is often called simply ton without distinguishing it from the metric ton (tonne, 1,000 kilograms / 2,204.62262 pounds) or the long ton (2,240 pounds / 1,016.0469088 kilograms); rather, the other two are specifically noted. There are, however, some U.S. applications for which unspecified tons normally means long tons.</p>"^^rdf:HTML,
    "<p>The short ton is a unit of mass equal to 2,000 pounds (907.18474 kg). In the United States it is often called simply ton without distinguishing it from the metric ton (tonne, 1,000 kilograms / 2,204.62262 pounds) or the long ton (2,240 pounds / 1,016.0469088 kilograms); rather, the other two are specifically noted. There are, however, some U.S. applications for which unspecified tons normally means long tons.</p>"^^rdf:HTML;
  qudt:applicableSystem <http://qudt.org/vocab/sou/CGS>, <http://qudt.org/vocab/sou/CGS>,
    <http://qudt.org/vocab/sou/USCS>, <http://qudt.org/vocab/sou/USCS>;
  qudt:conversionMultiplier 907.18474, 907.18474;
  qudt:conversionMultiplierSN 9.0718474E2, 9.0718474E2;
  qudt:hasDimensionVector dimensionvector:A0E0L0I0M1H0T0D0, dimensionvector:A0E0L0I0M1H0T0D0;
  qudt:hasQuantityKind quantitykind:Mass, quantitykind:Mass;
  qudt:informativeReference "http://en.wikipedia.org/wiki/Short_ton"^^xsd:anyURI, "http://en.wikipedia.org/wiki/Short_ton"^^xsd:anyURI;
  qudt:symbol "ton{short}", "ton{short}";
  qudt:ucumCode "[ston_av]"^^qudt:UCUMcs, "[ston_av]"^^qudt:UCUMcs;
  qudt:uneceCommonCode "STN", "STN";
  qudt:definedUnitOfSystem <http://qudt.org/vocab/sou/USCS>, <http://qudt.org/vocab/sou/USCS>;
  qudt:exactMatch unit:TON, unit:TON, unit:TON_US, unit:TON_US;
  qudt:scalingOf unit:KiloGM .

unit:TON_US a qudt:Unit, qudt:Unit;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/unit>, <http://qudt.org/vocab/unit>;
  rdfs:label "Ton (US)"@en, "Ton (US)"@en;
  dct:description "A ton is a unit of mass in the US customary system, where 1 ton is equal to 2000 pounds of mass."^^rdf:HTML,
