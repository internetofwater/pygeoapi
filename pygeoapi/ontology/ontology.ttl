variablename:berylium_10 a skos:Concept ;
    skos:definition "Beryllium-10 (10Be) is a radioactive isotope of beryllium." ;
    skos:exactMatch "https://en.wikipedia.org/wiki/Beryllium-10" ;
    skos:historyNote "Wikipedia" ;
    skos:inScheme <http://vocabulary.odm2.org/variablename> ;
    skos:note "Added to support Critical Zone Observatory (CZO) data use cases. " ;
    skos:prefLabel "Beryllium-10" ;
    skos:topConceptOf <http://vocabulary.odm2.org/variablename> .

variablename:beryllium a skos:Concept ;
    skos:definition "Beryllium is a chemical element with symbol Be and atomic number 4. It is a relatively rare element in the universe, usually occurring as a product of the spallation of larger atomic nuclei that have collided with cosmic rays. Within the cores of stars beryllium is depleted as it is fused and creates larger elements. It is a divalent element which occurs naturally only in combination with other elements in minerals. Notable gemstones which contain beryllium include beryl (aquamarine, emerald) and chrysoberyl. As a free element it is a steel-gray, strong, lightweight and brittle alkaline earth metal." ;
    skos:exactMatch "https://en.wikipedia.org/wiki/Beryllium" ;
    skos:historyNote "Wikipedia" ;
    skos:inScheme <http://vocabulary.odm2.org/variablename> ;
    skos:note "Added to support Critical Zone Observatory (CZO) data use cases. " ;
    skos:prefLabel "Beryllium" ;
    skos:topConceptOf <http://vocabulary.odm2.org/variablename> .

variablename:berylliumDissolved a skos:Concept ;
    skos:definition "Dissolved Beryllium (Be) . For chemical terms, \"dissolved\"indicates a filtered sample." ;
    skos:historyNote "Originally from the CUAHSI HIS VariableNameCV.  See: http://his.cuahsi.org/mastercvreg/edit_cv11.aspx?tbl=VariableNameCV." ;
    skos:inScheme <http://vocabulary.odm2.org/variablename> ;
    skos:prefLabel "Beryllium, dissolved" ;
    skos:topConceptOf <http://vocabulary.odm2.org/variablename> .

variablename:betaGlucosidase a skos:Concept ;
    ns3:category "Chemistry" ;
    skos:definition "Beta-glucosidase catalyzes the hydrolysis of the glycosidic bonds to terminal non-reducing residues in beta-D-glucosides and oligosaccharides, with release of glucose." ;
    skos:exactMatch "https://en.wikipedia.org/wiki/Beta-glucosidase" ;
    skos:historyNote "Wikipedia" ;
    skos:inScheme <http://vocabulary.odm2.org/variablename> ;
    skos:prefLabel "Beta-glucosidase" ;
    skos:topConceptOf <http://vocabulary.odm2.org/variablename> .

