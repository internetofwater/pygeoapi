quantitykind:MassNumber a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "Mass Number"@en, "Mass Number"@en;
  rdfs:comment "Applicable units are those of quantitykind:MassNumber", "Applicable units are those of quantitykind:MassNumber";
  dct:description "The \"Mass Number\" (A), also called atomic mass number or nucleon number, is the total number of protons and neutrons (together known as nucleons) in an atomic nucleus. Nuclides with the same value of $A$ are called isobars."^^qudt:LatexString,
    "The \"Mass Number\" (A), also called atomic mass number or nucleon number, is the total number of protons and neutrons (together known as nucleons) in an atomic nucleus. Nuclides with the same value of $A$ are called isobars."^^qudt:LatexString;
  skos:broader quantitykind:Count, quantitykind:Count;
  qudt:hasDimensionVector dimensionvector:A0E0L0I0M0H0T0D1, dimensionvector:A0E0L0I0M0H0T0D1;
  qudt:informativeReference "http://en.wikipedia.org/wiki/Mass_number"^^xsd:anyURI,
    "http://en.wikipedia.org/wiki/Mass_number"^^xsd:anyURI;
  qudt:symbol "A", "A";
  qudt:isoNormativeReference "http://www.iso.org/iso/catalogue_detail?csnumber=31895"^^xsd:anyURI,
    "http://www.iso.org/iso/catalogue_detail?csnumber=31895"^^xsd:anyURI;
  qudt:latexDefinition "$A = Z + N$, where $Z$ is the atomic number and $N$ is the neutron number."^^qudt:LatexString,
    "$A = Z + N$, where $Z$ is the atomic number and $N$ is the neutron number."^^qudt:LatexString;
  qudt:applicableUnit unit:NUM, unit:NUM .

