unit:B a qudt:Unit, qudt:Unit, qudt:DimensionlessUnit, qudt:DimensionlessUnit, qudt:LogarithmicUnit,
    qudt:LogarithmicUnit;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/unit>, <http://qudt.org/vocab/unit>;
  rdfs:label "Bel"@de, "Bel"@de, "bel"@cs, "bel"@cs, "bel"@en, "bel"@en, "bel"@fr, "bel"@fr,
    "bel"@hu, "bel"@hu, "bel"@it, "bel"@it, "bel"@ms, "bel"@ms, "bel"@pl, "bel"@pl, "bel"@pt,
