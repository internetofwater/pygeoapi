  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "Radiance Factor"@en, "Radiance Factor"@en;
  rdfs:comment "Applicable units are those of quantitykind:RadianceFactor", "Applicable units are those of quantitykind:RadianceFactor";
  dct:description "Radiance Factor is the ratio of the radiance of the surface element in the given direction to that of a perfect reflecting or transmitting diffuser identically irradiated unit."^^qudt:LatexString,
    "Radiance Factor is the ratio of the radiance of the surface element in the given direction to that of a perfect reflecting or transmitting diffuser identically irradiated unit."^^qudt:LatexString;
  qudt:hasDimensionVector dimensionvector:A0E0L0I0M0H0T0D1, dimensionvector:A0E0L0I0M0H0T0D1;
  qudt:informativeReference "http://www.encyclo.co.uk/define/radiance%20factor"^^xsd:anyURI,
    "http://www.encyclo.co.uk/define/radiance%20factor"^^xsd:anyURI;
  qudt:plainTextDescription "Radiance Factor is the ratio of the radiance of the surface element in the given direction to that of a perfect reflecting or transmitting diffuser identically irradiated unit.",
    "Radiance Factor is the ratio of the radiance of the surface element in the given direction to that of a perfect reflecting or transmitting diffuser identically irradiated unit.";
  qudt:latexSymbol "$\\beta$"^^qudt:LatexString, "$\\beta$"^^qudt:LatexString;
  qudt:latexDefinition "$\\beta = \\frac{L_n}{L_d}$, where $L_n$ is the radiance of a surface element in a given direction and $L_d$ is the radiance of the perfect reflecting or transmitting diffuser identically irradiated and viewed. Reflectance factor is equivalent to radiance factor or luminance factor (when the cone angle is infinitely small, and is equivalent to reflectance when the cone angle is $2π sr$."^^qudt:LatexString,
    "$\\beta = \\frac{L_n}{L_d}$, where $L_n$ is the radiance of a surface element in a given direction and $L_d$ is the radiance of the perfect reflecting or transmitting diffuser identically irradiated and viewed. Reflectance factor is equivalent to radiance factor or luminance factor (when the cone angle is infinitely small, and is equivalent to reflectance when the cone angle is $2π sr$."^^qudt:LatexString;
  qudt:applicableUnit unit:UNITLESS, unit:UNITLESS .

quantitykind:RatioOfSpecificHeatCapacities a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:seeAlso quantitykind:IsentropicExponent, quantitykind:IsentropicExponent;
  rdfs:label "Ratio of Specific Heat Capacities"@en, "Ratio of Specific Heat Capacities"@en;
  rdfs:comment "Applicable units are those of quantitykind:RatioOfSpecificHeatCapacities",
    "Applicable units are those of quantitykind:RatioOfSpecificHeatCapacities";
  dct:description """
  The specific heat ratio of a gas is the ratio of the specific heat at constant pressure,
   $c_p$, to the specific heat at constant volume, $c_V$. 
  It is sometimes referred to as the $\\textit{adiabatic index}$,
   or the $\\textit{heat capacity ratio}$,
   or the $\\textit{isentropic expansion factor}$,
   or the $\\textit{adiabatic exponent}$,
  or the $\\textit{isentropic exponent}$.
  """^^qudt:LatexString,
    """
  The specific heat ratio of a gas is the ratio of the specific heat at constant pressure,
   $c_p$, to the specific heat at constant volume, $c_V$. 
  It is sometimes referred to as the $\\textit{adiabatic index}$,
   or the $\\textit{heat capacity ratio}$,
   or the $\\textit{isentropic expansion factor}$,
   or the $\\textit{adiabatic exponent}$,
  or the $\\textit{isentropic exponent}$.
  """^^qudt:LatexString;
  qudt:hasDimensionVector dimensionvector:A0E0L0I0M0H0T0D1, dimensionvector:A0E0L0I0M0H0T0D1;
  qudt:informativeReference "http://en.citizendium.org/wiki/Specific_heat_ratio"^^xsd:anyURI,
    "http://en.citizendium.org/wiki/Specific_heat_ratio"^^xsd:anyURI;
  qudt:isoNormativeReference "http://www.iso.org/iso/catalogue_detail?csnumber=31890"^^xsd:anyURI,
    "http://www.iso.org/iso/catalogue_detail?csnumber=31890"^^xsd:anyURI;
  qudt:latexSymbol "$\\gamma$"^^qudt:LatexString, "$\\gamma$"^^qudt:LatexString, "$\\varkappa$"^^qudt:LatexString,
    "$\\varkappa$"^^qudt:LatexString;
  qudt:latexDefinition "$\\gamma = c_p / c_V$, where $c$ is the specific heat of a gas, $c_p$ is specific heat capacity at constant pressure, $c_V$ is specific heat capacity at constant volume."^^qudt:LatexString,
    "$\\gamma = c_p / c_V$, where $c$ is the specific heat of a gas, $c_p$ is specific heat capacity at constant pressure, $c_V$ is specific heat capacity at constant volume."^^qudt:LatexString;
  qudt:applicableUnit unit:UNITLESS, unit:UNITLESS .

quantitykind:Reactivity a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "Reactivity"@en, "Reactivity"@en;
  rdfs:comment "Applicable units are those of quantitykind:Reactivity", "Applicable units are those of quantitykind:Reactivity";
  dct:description "\"Reactivity\" characterizes the deflection of reactor from the critical state."^^qudt:LatexString,
    "\"Reactivity\" characterizes the deflection of reactor from the critical state."^^qudt:LatexString;
  qudt:hasDimensionVector dimensionvector:A0E0L0I0M0H0T0D1, dimensionvector:A0E0L0I0M0H0T0D1;
  qudt:informativeReference "http://en.wikipedia.org/wiki/Nuclear_chain_reaction"^^xsd:anyURI,
    "http://en.wikipedia.org/wiki/Nuclear_chain_reaction"^^xsd:anyURI;
  qudt:isoNormativeReference "http://www.iso.org/iso/catalogue_detail?csnumber=31895"^^xsd:anyURI,
    "http://www.iso.org/iso/catalogue_detail?csnumber=31895"^^xsd:anyURI;
  qudt:plainTextDescription "\"Reactivity\" characterizes the deflection of reactor from the critical state.",
    "\"Reactivity\" characterizes the deflection of reactor from the critical state.";
  qudt:latexSymbol "$\\rho$"^^qudt:LatexString, "$\\rho$"^^qudt:LatexString;
  qudt:latexDefinition "$\\rho = \\frac{k_{eff} - 1}{k_{eff}}$, where $k_{eff}$ is the effective multiplication factor."^^qudt:LatexString,
    "$\\rho = \\frac{k_{eff} - 1}{k_{eff}}$, where $k_{eff}$ is the effective multiplication factor."^^qudt:LatexString;
  qudt:applicableUnit unit:UNITLESS, unit:UNITLESS .

quantitykind:ReflectanceFactor a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "Reflectance Factor"@en, "Reflectance Factor"@en;
  rdfs:comment "Applicable units are those of quantitykind:ReflectanceFactor", "Applicable units are those of quantitykind:ReflectanceFactor";
  dct:description "Reflectance Factor is the measure of the ability of a surface to reflect light or other electromagnetic radiation, equal to the ratio of the reflected flux to the incident flux."^^qudt:LatexString,
    "Reflectance Factor is the measure of the ability of a surface to reflect light or other electromagnetic radiation, equal to the ratio of the reflected flux to the incident flux."^^qudt:LatexString;
  qudt:hasDimensionVector dimensionvector:A0E0L0I0M0H0T0D1, dimensionvector:A0E0L0I0M0H0T0D1;
  qudt:informativeReference "http://www.thefreedictionary.com/reflectance+factor"^^xsd:anyURI,
    "http://www.thefreedictionary.com/reflectance+factor"^^xsd:anyURI;
  qudt:symbol "R", "R";
  qudt:plainTextDescription "Reflectance Factor is the measure of the ability of a surface to reflect light or other electromagnetic radiation, equal to the ratio of the reflected flux to the incident flux.",
    "Reflectance Factor is the measure of the ability of a surface to reflect light or other electromagnetic radiation, equal to the ratio of the reflected flux to the incident flux.";
  qudt:latexDefinition "$R = \\frac{\\Phi_n}{\\Phi_d}$, where $\\Phi_n$ is the radiant flux or luminous flux reflected in the directions delimited by a given cone and $\\Phi_d$ is the flux reflected in the same directions by an identically radiated diffuser of reflectance equal to 1."^^qudt:LatexString,
    "$R = \\frac{\\Phi_n}{\\Phi_d}$, where $\\Phi_n$ is the radiant flux or luminous flux reflected in the directions delimited by a given cone and $\\Phi_d$ is the flux reflected in the same directions by an identically radiated diffuser of reflectance equal to 1."^^qudt:LatexString;
  qudt:applicableUnit unit:UNITLESS, unit:UNITLESS .

quantitykind:RefractiveIndex a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "Brechzahl"@de, "Brechzahl"@de, "Indeks biasan"@ms, "Indeks biasan"@ms,
    "Index lomu"@cs, "Index lomu"@cs, "Indice de refracție"@ro, "Indice de refracție"@ro,
    "Współczynnik załamania"@pl, "Współczynnik załamania"@pl, "indice de réfraction"@fr,
    "indice de réfraction"@fr, "indice di rifrazione"@it, "indice di rifrazione"@it, "kırılma indeksi"@tr,
    "kırılma indeksi"@tr, "refractive index"@en, "refractive index"@en, "índice de refracción"@es,
    "índice de refracción"@es, "índice refrativo"@pt, "índice refrativo"@pt, "Показатель преломления"@ru,
    "Показатель преломления"@ru, "ضریب شکست"@fa, "ضریب شکست"@fa, "معامل الانكسار"@ar,
    "معامل الانكسار"@ar, "अपवर्तनांक"@hi, "अपवर्तनांक"@hi, "屈折率"@ja, "屈折率"@ja, "折射率"@zh,
    "折射率"@zh;
  rdfs:comment "Applicable units are those of quantitykind:RefractiveIndex", "Applicable units are those of quantitykind:RefractiveIndex";
  dct:description "\"refractive index\" or index of refraction n of a substance (optical medium) is a dimensionless number that describes how light, or any other radiation, propagates through that medium."^^qudt:LatexString,
    "\"refractive index\" or index of refraction n of a substance (optical medium) is a dimensionless number that describes how light, or any other radiation, propagates through that medium."^^qudt:LatexString;
  skos:altLabel "Brechungsindex"@de, "Brechungsindex"@de;
  qudt:hasDimensionVector dimensionvector:A0E0L0I0M0H0T0D1, dimensionvector:A0E0L0I0M0H0T0D1;
  qudt:informativeReference "http://en.wikipedia.org/wiki/Refractive_index"^^xsd:anyURI,
    "http://en.wikipedia.org/wiki/Refractive_index"^^xsd:anyURI;
  qudt:symbol "n", "n";
  qudt:plainTextDescription "\"refractive index\" or index of refraction n of a substance (optical medium) is a dimensionless number that describes how light, or any other radiation, propagates through that medium.",
    "\"refractive index\" or index of refraction n of a substance (optical medium) is a dimensionless number that describes how light, or any other radiation, propagates through that medium.";
  qudt:latexDefinition "$n = \\frac{c_0}{c}$, where $c_0$ is the speed of light in vacuum, and $c$ is the speed of light in the medium."^^qudt:LatexString,
    "$n = \\frac{c_0}{c}$, where $c_0$ is the speed of light in vacuum, and $c$ is the speed of light in the medium."^^qudt:LatexString;
  qudt:applicableUnit unit:UNITLESS, unit:UNITLESS .

quantitykind:RelativeMassConcentrationOfVapour a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:seeAlso quantitykind:RelativePartialPressure, quantitykind:RelativePartialPressure;
  rdfs:label "Relative Mass Concentration of Vapour"@en, "Relative Mass Concentration of Vapour"@en;
  rdfs:comment "Applicable units are those of quantitykind:RelativeMassConcentrationOfVapour",
    "Applicable units are those of quantitykind:RelativeMassConcentrationOfVapour";
  dct:description "\"Relative Mass Concentration of Vapour\" is one of a number of \"Relative Concentration\" quantities defined by ISO 80000."^^qudt:LatexString,
    "\"Relative Mass Concentration of Vapour\" is one of a number of \"Relative Concentration\" quantities defined by ISO 80000."^^qudt:LatexString;
  qudt:hasDimensionVector dimensionvector:A0E0L0I0M0H0T0D1, dimensionvector:A0E0L0I0M0H0T0D1;
  qudt:isoNormativeReference "http://www.iso.org/iso/catalogue_detail?csnumber=31890"^^xsd:anyURI,
    "http://www.iso.org/iso/catalogue_detail?csnumber=31890"^^xsd:anyURI;
  qudt:plainTextDescription "Relative Mass Concentration of Vapour is one of a number of Relative Concentration quantities defined by ISO 80000.",
    "Relative Mass Concentration of Vapour is one of a number of Relative Concentration quantities defined by ISO 80000.";
  qudt:latexSymbol "$\\varphi$"^^qudt:LatexString, "$\\varphi$"^^qudt:LatexString;
  qudt:latexDefinition "$\\varphi = v / v_{sat}$, where $v$ is mass concentration of water vapour,  $v_{sat}$ is its mass concentration of water vapour at saturation (at the same temperature). For normal cases, the relative partial pressure may be assumed to be equal to relative mass concentration of vapour."^^qudt:LatexString,
    "$\\varphi = v / v_{sat}$, where $v$ is mass concentration of water vapour,  $v_{sat}$ is its mass concentration of water vapour at saturation (at the same temperature). For normal cases, the relative partial pressure may be assumed to be equal to relative mass concentration of vapour."^^qudt:LatexString;
  qudt:applicableUnit unit:UNITLESS, unit:UNITLESS .

quantitykind:RelativeMassDensity a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "Relative Mass Density"@en, "Relative Mass Density"@en;
  rdfs:comment "Applicable units are those of quantitykind:RelativeMassDensity", "Applicable units are those of quantitykind:RelativeMassDensity";
  dct:description "Relative density, or specific gravity, is the ratio of the density (mass of a unit volume) of a substance to the density of a given reference material."^^qudt:LatexString,
    "Relative density, or specific gravity, is the ratio of the density (mass of a unit volume) of a substance to the density of a given reference material."^^qudt:LatexString;
  qudt:hasDimensionVector dimensionvector:A0E0L0I0M0H0T0D1, dimensionvector:A0E0L0I0M0H0T0D1;
  qudt:informativeReference "http://en.wikipedia.org/wiki/Relative_density"^^xsd:anyURI,
    "http://en.wikipedia.org/wiki/Relative_density"^^xsd:anyURI;
  qudt:symbol "d", "d";
  qudt:isoNormativeReference "http://www.iso.org/iso/catalogue_detail?csnumber=31889"^^xsd:anyURI,
    "http://www.iso.org/iso/catalogue_detail?csnumber=31889"^^xsd:anyURI;
  qudt:plainTextDescription "Relative density, or specific gravity, is the ratio of the density (mass of a unit volume) of a substance to the density of a given reference material.",
    "Relative density, or specific gravity, is the ratio of the density (mass of a unit volume) of a substance to the density of a given reference material.";
  qudt:latexDefinition "$d = \\frac{\\rho}{\\rho_0}$, where $\\rho$ is mass density of a substance and $\\rho_0$ is the mass density of a reference substance under conditions that should be specified for both substances."^^qudt:LatexString,
    "$d = \\frac{\\rho}{\\rho_0}$, where $\\rho$ is mass density of a substance and $\\rho_0$ is the mass density of a reference substance under conditions that should be specified for both substances."^^qudt:LatexString;
  qudt:applicableUnit unit:UNITLESS, unit:UNITLESS .

quantitykind:RelativeMassExcess a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "Relative Mass Excess"@en, "Relative Mass Excess"@en;
  rdfs:comment "Applicable units are those of quantitykind:RelativeMassExcess", "Applicable units are those of quantitykind:RelativeMassExcess";
  dct:description "The \"Relative Mass Excess\" is the mass excess between the monoisotopic mass of an element and the mass of its A + 1 or its A + 2 isotopic cluster (extrapolated from relative mass defect)."^^qudt:LatexString,
    "The \"Relative Mass Excess\" is the mass excess between the monoisotopic mass of an element and the mass of its A + 1 or its A + 2 isotopic cluster (extrapolated from relative mass defect)."^^qudt:LatexString;
  qudt:hasDimensionVector dimensionvector:A0E0L0I0M0H0T0D1, dimensionvector:A0E0L0I0M0H0T0D1;
  qudt:informativeReference "http://en.wikipedia.org/wiki/Mass_excess"^^xsd:anyURI,
    "http://en.wikipedia.org/wiki/Mass_excess"^^xsd:anyURI;
  qudt:isoNormativeReference "http://www.iso.org/iso/catalogue_detail?csnumber=31895"^^xsd:anyURI,
    "http://www.iso.org/iso/catalogue_detail?csnumber=31895"^^xsd:anyURI;
  qudt:plainTextDescription "The \"Relative Mass Excess\" is the mass excess between the monoisotopic mass of an element and the mass of its A + 1 or its A + 2 isotopic cluster (extrapolated from relative mass defect).",
    "The \"Relative Mass Excess\" is the mass excess between the monoisotopic mass of an element and the mass of its A + 1 or its A + 2 isotopic cluster (extrapolated from relative mass defect).";
  qudt:latexSymbol "$\\Delta_r$"^^qudt:LatexString, "$\\Delta_r$"^^qudt:LatexString;
  qudt:latexDefinition "$\\Delta_r = \\frac{\\Delta}{m_u}$, where $\\Delta$ is the mass excess and $m_u$ is the unified atomic mass constant."^^qudt:LatexString,
    "$\\Delta_r = \\frac{\\Delta}{m_u}$, where $\\Delta$ is the mass excess and $m_u$ is the unified atomic mass constant."^^qudt:LatexString;
  qudt:applicableUnit unit:UNITLESS, unit:UNITLESS .

quantitykind:RelativeMassRatioOfVapour a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "Relative Mass Ratio of Vapour"@en, "Relative Mass Ratio of Vapour"@en;
  rdfs:comment "Applicable units are those of quantitykind:RelativeMassRatioOfVapour",
    "Applicable units are those of quantitykind:RelativeMassRatioOfVapour";
  dct:description "\"Relative Mass Ratio of Vapour\" is one of a number of \"Relative Concentration\" quantities defined by ISO 80000."^^qudt:LatexString,
    "\"Relative Mass Ratio of Vapour\" is one of a number of \"Relative Concentration\" quantities defined by ISO 80000."^^qudt:LatexString;
  qudt:hasDimensionVector dimensionvector:A0E0L0I0M0H0T0D1, dimensionvector:A0E0L0I0M0H0T0D1;
  qudt:isoNormativeReference "http://www.iso.org/iso/catalogue_detail?csnumber=31890"^^xsd:anyURI,
    "http://www.iso.org/iso/catalogue_detail?csnumber=31890"^^xsd:anyURI;
  qudt:plainTextDescription "Relative Mass Ratio of Vapour is one of a number of Relative Concentration quantities defined by ISO 80000.",
    "Relative Mass Ratio of Vapour is one of a number of Relative Concentration quantities defined by ISO 80000.";
  qudt:latexSymbol "$\\psi$"^^qudt:LatexString, "$\\psi$"^^qudt:LatexString;
  qudt:latexDefinition "$\\psi = x / x_{sat}$, where $x$ is mass ratio of water vapour to dry gas,  $x_{sat}$ is its mass raio of water vapour to dry gas at saturation (at the same temperature)."^^qudt:LatexString,
    "$\\psi = x / x_{sat}$, where $x$ is mass ratio of water vapour to dry gas,  $x_{sat}$ is its mass raio of water vapour to dry gas at saturation (at the same temperature)."^^qudt:LatexString;
  qudt:applicableUnit unit:UNITLESS, unit:UNITLESS .

quantitykind:ResonanceEscapeProbability a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "Resonance Escape Probability"@en, "Resonance Escape Probability"@en;
  rdfs:comment "Applicable units are those of quantitykind:ResonanceEscapeProbability",
    "Applicable units are those of quantitykind:ResonanceEscapeProbability";
  dct:description "The \"Resonance Escape Probability\" is the fraction of fission neutrons that manage to slow down from fission to thermal energies without being absorbed. In an infinite medium, the probability that a neutron slowing down will traverse all or some specified portion of the range of resonance energies without being absorbed."^^qudt:LatexString,
    "The \"Resonance Escape Probability\" is the fraction of fission neutrons that manage to slow down from fission to thermal energies without being absorbed. In an infinite medium, the probability that a neutron slowing down will traverse all or some specified portion of the range of resonance energies without being absorbed."^^qudt:LatexString;
  qudt:hasDimensionVector dimensionvector:A0E0L0I0M0H0T0D1, dimensionvector:A0E0L0I0M0H0T0D1;
  qudt:informativeReference "http://en.wikipedia.org/wiki/Four_factor_formula"^^xsd:anyURI,
    "http://en.wikipedia.org/wiki/Four_factor_formula"^^xsd:anyURI;
  qudt:symbol "p", "p";
  qudt:isoNormativeReference "http://www.iso.org/iso/catalogue_detail?csnumber=31895"^^xsd:anyURI,
    "http://www.iso.org/iso/catalogue_detail?csnumber=31895"^^xsd:anyURI;
  qudt:plainTextDescription "The \"Resonance Escape Probability\" is the fraction of fission neutrons that manage to slow down from fission to thermal energies without being absorbed. In an infinite medium, the probability that a neutron slowing down will traverse all or some specified portion of the range of resonance energies without being absorbed.",
    "The \"Resonance Escape Probability\" is the fraction of fission neutrons that manage to slow down from fission to thermal energies without being absorbed. In an infinite medium, the probability that a neutron slowing down will traverse all or some specified portion of the range of resonance energies without being absorbed.";
  qudt:applicableUnit unit:UNITLESS, unit:UNITLESS .

quantitykind:Short-RangeOrderParameter a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "Short-Range Order Parameter"@en, "Short-Range Order Parameter"@en;
  rdfs:comment "Applicable units are those of quantitykind:Short-RangeOrderParameter",
    "Applicable units are those of quantitykind:Short-RangeOrderParameter";
  dct:description "\"Short-Range Order Parameter\" is the fraction of the nearest-neighbor atom pairs in an Ising ferromagnet having magnetic moments in one direction, minus the fraction having magnetic moments in the opposite direction."^^qudt:LatexString,
    "\"Short-Range Order Parameter\" is the fraction of the nearest-neighbor atom pairs in an Ising ferromagnet having magnetic moments in one direction, minus the fraction having magnetic moments in the opposite direction."^^qudt:LatexString;
  qudt:hasDimensionVector dimensionvector:A0E0L0I0M0H0T0D1, dimensionvector:A0E0L0I0M0H0T0D1;
  qudt:isoNormativeReference "http://www.iso.org/iso/catalogue_detail?csnumber=31897"^^xsd:anyURI,
    "http://www.iso.org/iso/catalogue_detail?csnumber=31897"^^xsd:anyURI;
  qudt:plainTextDescription "\"Short-Range Order Parameter\" is the fraction of the nearest-neighbor atom pairs in an Ising ferromagnet having magnetic moments in one direction, minus the fraction having magnetic moments in the opposite direction.",
    "\"Short-Range Order Parameter\" is the fraction of the nearest-neighbor atom pairs in an Ising ferromagnet having magnetic moments in one direction, minus the fraction having magnetic moments in the opposite direction.";
  qudt:latexSymbol "$r, \\sigma$"^^qudt:LatexString, "$r, \\sigma$"^^qudt:LatexString;
  qudt:applicableUnit unit:UNITLESS, unit:UNITLESS .

quantitykind:StandardAbsoluteActivity a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "Standard Absolute Activity"@en, "Standard Absolute Activity"@en;
  rdfs:comment "Applicable units are those of quantitykind:StandardAbsoluteActivity",
    "Applicable units are those of quantitykind:StandardAbsoluteActivity";
  dct:description "The \"Standard Absolute Activity\" is proportional to the absoulte activity of the pure substance $B$ at the same temperature and pressure multiplied by the standard pressure."^^qudt:LatexString,
    "The \"Standard Absolute Activity\" is proportional to the absoulte activity of the pure substance $B$ at the same temperature and pressure multiplied by the standard pressure."^^qudt:LatexString;
  qudt:hasDimensionVector dimensionvector:A0E0L0I0M0H0T0D1, dimensionvector:A0E0L0I0M0H0T0D1;
  qudt:informativeReference "http://en.wikipedia.org/wiki/Activity_coefficient"^^xsd:anyURI,
    "http://en.wikipedia.org/wiki/Activity_coefficient"^^xsd:anyURI;
  qudt:isoNormativeReference "http://www.iso.org/iso/catalogue_detail?csnumber=31894"^^xsd:anyURI,
    "http://www.iso.org/iso/catalogue_detail?csnumber=31894"^^xsd:anyURI;
  qudt:latexSymbol "$\\lambda_B^\\Theta$"^^qudt:LatexString, "$\\lambda_B^\\Theta$"^^qudt:LatexString;
  qudt:latexDefinition "$\\lambda_B^\\Theta = \\lambda_B^*(p^\\Theta)$, where $\\lambda_B^\\Theta$ the absolute activity of the pure substance $B$ at the same temperature and pressure, and $p^\\Theta$ is standard pressure."^^qudt:LatexString,
    "$\\lambda_B^\\Theta = \\lambda_B^*(p^\\Theta)$, where $\\lambda_B^\\Theta$ the absolute activity of the pure substance $B$ at the same temperature and pressure, and $p^\\Theta$ is standard pressure."^^qudt:LatexString;
  qudt:applicableUnit unit:UNITLESS, unit:UNITLESS .

quantitykind:StatisticalWeight a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "Statistical Weight"@en, "Statistical Weight"@en;
