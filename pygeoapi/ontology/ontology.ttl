quantitykind:AmountOfSubstance a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "Jumlah bahan"@ms, "Jumlah bahan"@ms, "Látkové množství"@cs, "Látkové množství"@cs,
    "Stoffmenge"@de, "Stoffmenge"@de, "amount of substance"@en, "amount of substance"@en,
    "anyagmennyiség"@hu, "anyagmennyiség"@hu, "cantidad de sustancia"@es, "cantidad de sustancia"@es,
    "cantitate de substanță"@ro, "cantitate de substanță"@ro, "liczność materii"@pl, "liczność materii"@pl,
    "madde miktarı"@tr, "madde miktarı"@tr, "množina snovi"@sl, "množina snovi"@sl, "quantidade de substância"@pt,
    "quantidade de substância"@pt, "quantitas substantiae"@la, "quantitas substantiae"@la,
    "quantità di sostanza"@it, "quantità di sostanza"@it, "quantité de matière"@fr, "quantité de matière"@fr,
    "Ποσότητα Ουσίας"@el, "Ποσότητα Ουσίας"@el, "Количество вещества"@ru, "Количество вещества"@ru,
    "Количество вещество"@bg, "Количество вещество"@bg, "כמות חומר"@he, "כמות חומר"@he,
    "كمية المادة"@ar, "كمية المادة"@ar, "مقدار ماده"@fa, "مقدار ماده"@fa, "पदार्थ की मात्रा"@hi,
    "पदार्थ की मात्रा"@hi, "物質量"@ja, "物質量"@ja, "物质的量"@zh, "物质的量"@zh;
  rdfs:comment "Applicable units are those of quantitykind:AmountOfSubstance", "Applicable units are those of quantitykind:AmountOfSubstance";
  dct:description """
  $\\textit{Amount of Substance}$ is a standards-defined quantity that measures the size of an ensemble of elementary entities,
   such as atoms, molecules, electrons, and other particles. 
  It is sometimes referred to as chemical amount.

  The International System of Units (SI) defines the amount of substance to be proportional to the number of elementary entities present. 
  The SI unit for amount of substance is mole. 
  It has the unit symbol $mol$.

  The mole is defined as the amount of substance that contains an equal number of elementary entities as there are atoms in 0.012kg of the isotope carbon-12. 
  This number is called Avogadro's number and has the value $6.02214179(30) \\times 10^{23}$. 
  
  The only other unit of amount of substance in current use is the $pound-mole$ with the symbol $lb-mol$,
   which is sometimes used in chemical engineering in the United States. 
  One $pound-mole$ is exactly $453.59237 mol$.
  """^^qudt:LatexString,
    """
  $\\textit{Amount of Substance}$ is a standards-defined quantity that measures the size of an ensemble of elementary entities,
   such as atoms, molecules, electrons, and other particles. 
  It is sometimes referred to as chemical amount.

  The International System of Units (SI) defines the amount of substance to be proportional to the number of elementary entities present. 
  The SI unit for amount of substance is mole. 
  It has the unit symbol $mol$.

  The mole is defined as the amount of substance that contains an equal number of elementary entities as there are atoms in 0.012kg of the isotope carbon-12. 
  This number is called Avogadro's number and has the value $6.02214179(30) \\times 10^{23}$. 
  
  The only other unit of amount of substance in current use is the $pound-mole$ with the symbol $lb-mol$,
   which is sometimes used in chemical engineering in the United States. 
  One $pound-mole$ is exactly $453.59237 mol$.
  """^^qudt:LatexString;
  skos:altLabel "chemical amount"@en, "chemical amount"@en, "jumlah kimia"@ms, "jumlah kimia"@ms,
    "quantità chimica"@it, "quantità chimica"@it, "quantità di materia"@it, "quantità di materia"@it;
  qudt:dbpediaMatch "http://dbpedia.org/resource/Amount_of_substance"^^xsd:anyURI, "http://dbpedia.org/resource/Amount_of_substance"^^xsd:anyURI;
  qudt:hasDimensionVector dimensionvector:A1E0L0I0M0H0T0D0, dimensionvector:A1E0L0I0M0H0T0D0;
