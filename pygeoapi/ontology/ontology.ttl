  skos:prefLabel "Lake/Reservoir Side Inflow Volume"@en;
  skos:editorialNote "RISE ParameterTimestep is daily"@en, "RISE ParameterTransformation is sum"@en,
    "RISE ParameterUnit is af"@en, "RISE ParameterGroup is Lake/Reservoir Inflow"@en,
    "Kyle's Match Status is Maybe Match, check on specigic semantics (e.g. metals total/dissolved/suspended; specific reservoir releases vs streamflow)"@en;
  skos:broader <https://data.usbr.gov/rise/api/parameter-group/9> .

<https://data.usbr.gov/rise/api/parameter/1383> a skos:Concept;
