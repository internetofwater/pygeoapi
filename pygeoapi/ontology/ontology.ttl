unit:MicroGRAY a qudt:Unit, qudt:Unit, qudt:DerivedUnit, qudt:DerivedUnit;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/unit>, <http://qudt.org/vocab/unit>;
  rdfs:label "MicroGray"@en, "MicroGray"@en;
  dct:description "0.000001 fold of the SI unit of radiation dose. Radiation carries energy, and when it is absorbed by matter the matter receives this energy. The dose is the amount of energy deposited per unit of mass. One gray is defined to be the dose of one joule of energy absorbed per kilogram of matter, or 100 rad. The unit is named for the British physician L. Harold Gray (1905-1965), an authority on the use of radiation in the treatment of cancer."^^rdf:HTML,
    "0.000001 fold of the SI unit of radiation dose. Radiation carries energy, and when it is absorbed by matter the matter receives this energy. The dose is the amount of energy deposited per unit of mass. One gray is defined to be the dose of one joule of energy absorbed per kilogram of matter, or 100 rad. The unit is named for the British physician L. Harold Gray (1905-1965), an authority on the use of radiation in the treatment of cancer."^^rdf:HTML;
  qudt:applicableSystem <http://qudt.org/vocab/sou/CGS-EMU>, <http://qudt.org/vocab/sou/CGS-EMU>,
    <http://qudt.org/vocab/sou/CGS-GAUSS>, <http://qudt.org/vocab/sou/CGS-GAUSS>, <http://qudt.org/vocab/sou/SI>,
    <http://qudt.org/vocab/sou/SI>, <http://qudt.org/vocab/sou/CGS>, <http://qudt.org/vocab/sou/CGS>;
  qudt:conversionMultiplier 0.000001, 0.000001;
  qudt:conversionMultiplierSN 1.0E-6, 1.0E-6;
  qudt:dbpediaMatch "http://dbpedia.org/resource/Grey"^^xsd:anyURI, "http://dbpedia.org/resource/Grey"^^xsd:anyURI;
  qudt:hasDimensionVector dimensionvector:A0E0L2I0M0H0T-2D0, dimensionvector:A0E0L2I0M0H0T-2D0;
  qudt:hasQuantityKind quantitykind:AbsorbedDose, quantitykind:AbsorbedDose;
  qudt:informativeReference "http://en.wikipedia.org/wiki/Grey?oldid=494774160"^^xsd:anyURI,
    "http://en.wikipedia.org/wiki/Grey?oldid=494774160"^^xsd:anyURI;
  qudt:omUnit <http://www.ontology-of-units-of-measure.org/resource/om-2/gray>, <http://www.ontology-of-units-of-measure.org/resource/om-2/gray>;
  qudt:symbol "μGy", "μGy";
