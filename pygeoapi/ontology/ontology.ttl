        1.550003e+03 ;
    qudt:expression "$cd/in^{2}$"^^qudt:LatexString ;
    qudt:hasDimensionVector dimensionvector:A0E0L-2I1M0H0T0D0 ;
    qudt:hasFactorUnit [ qudt:exponent -2 ;
