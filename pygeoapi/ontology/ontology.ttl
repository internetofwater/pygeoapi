  <http://qudt.org/schema/qudt/hasQuantityKind> <http://qudt.org/vocab/quantitykind/PowerPerArea>,
    <http://qudt.org/vocab/quantitykind/Radiosity>;
  <http://qudt.org/schema/qudt/symbol> "J/(cm²·d)";
  <http://qudt.org/schema/qudt/ucumCode> "J.cm-2.d-1"^^<http://qudt.org/schema/qudt/UCUMcs> .

