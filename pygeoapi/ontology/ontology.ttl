  <http://qudt.org/schema/qudt/symbol> "hPa/K";
  <http://qudt.org/schema/qudt/ucumCode> "hPa.K-1"^^<http://qudt.org/schema/qudt/UCUMcs>;
  <http://qudt.org/schema/qudt/uneceCommonCode> "F82";
  <http://qudt.org/schema/qudt/plainTextDescription> "100-fold of the SI derived unit pascal divided by the SI base unit kelvin" .

