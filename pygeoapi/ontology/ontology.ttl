  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/unit>;
  rdfs:label "Kilogram per Millimeter"@en-US, "Kilogram per Millimetre"@en;
  dct:description "SI base unit kilogram divided by the 0.001-fold of the SI base unit metre"^^rdf:HTML;
