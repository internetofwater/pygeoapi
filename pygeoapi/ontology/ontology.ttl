<http://qudt.org/vocab/dimensionvector/A0E-1L0I0M1H0T-1D0> a <http://qudt.org/schema/qudt/QuantityKindDimensionVector_SI>,
    <http://qudt.org/schema/qudt/QuantityKindDimensionVector_ISO>, <http://qudt.org/schema/qudt/QuantityKindDimensionVector_Imperial>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/dimensionvector>;
  rdfs:label "A0E-1L0I0M1H0T-1D0";
  <http://qudt.org/schema/qudt/latexDefinition> "$M T^-1 I^-1$"^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/hasReferenceQuantityKind> <http://qudt.org/vocab/quantitykind/MassPerElectricCharge>;
  <http://qudt.org/schema/qudt/dimensionExponentForAmountOfSubstance> 0;
  <http://qudt.org/schema/qudt/dimensionExponentForElectricCurrent> -1;
  <http://qudt.org/schema/qudt/dimensionExponentForLength> 0;
