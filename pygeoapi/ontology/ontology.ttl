unit:HeartBeat a qudt:Unit, qudt:Unit, qudt:CountingUnit, qudt:ContextualUnit;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/unit>, <http://qudt.org/vocab/unit>;
  rdfs:label "Heart Beat"@en, "Heart Beat"@en;
  dct:description """A heart beat is a single contraction of the heart muscle,
  which pumps blood through the circulatory system. The heart rate is the number of heart beats
  per unit of time, typically measured in beats per minute (bpm). A normal resting 
  heart rate for adults ranges from 60 to 100 beats per minute."""^^rdf:HTML;
