unit:K a qudt:Unit, qudt:Unit;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/unit>, <http://qudt.org/vocab/unit>;
  rdfs:label "Kelvin"@de, "Kelvin"@de, "kelvin"@cs, "kelvin"@cs, "kelvin"@en, "kelvin"@en,
    "kelvin"@es, "kelvin"@es, "kelvin"@fr, "kelvin"@fr, "kelvin"@hu, "kelvin"@hu, "kelvin"@it,
    "kelvin"@it, "kelvin"@la, "kelvin"@la, "kelvin"@ms, "kelvin"@ms, "kelvin"@pt, "kelvin"@pt,
    "kelvin"@ro, "kelvin"@ro, "kelvin"@sl, "kelvin"@sl, "kelvin"@tr, "kelvin"@tr, "kelwin"@pl,
    "kelwin"@pl, "κέλβιν"@el, "κέλβιν"@el, "келвин"@bg, "келвин"@bg, "кельвин"@ru, "кельвин"@ru,
    "קלווין"@he, "קלווין"@he, "كلفن"@ar, "كلفن"@ar, "کلوین"@fa, "کلوین"@fa, "कैल्विन"@hi,
    "कैल्विन"@hi, "ケルビン"@ja, "ケルビン"@ja, "开尔文"@zh, "开尔文"@zh;
  dct:description """
  The unit $\\textit{Kelvin}$ is the SI base unit of temperature, previously called the degree Kelvin. 
  One kelvin represents the same temperature difference as one degree Celsius. 
  In 1967 the General Conference on Weights and Measures defined the temperature of the triple point of water
   (the temperature at which water exists simultaneously in the gaseous, liquid, and solid states) to be exactly 273.16 kelvins. 
  Since this temperature is also equal to 0.01 u00b0C, the temperature in kelvins is always equal to 273.15 plus the temperature in degrees Celsius. 
  The kelvin equals exactly 1.8 degrees Fahrenheit. 
  The unit is named for the British mathematician and physicist William Thomson (1824-1907),
   later known as Lord Kelvin after he was named Baron Kelvin of Largs.
  """^^qudt:LatexString,
    """
  The unit $\\textit{Kelvin}$ is the SI base unit of temperature, previously called the degree Kelvin. 
  One kelvin represents the same temperature difference as one degree Celsius. 
  In 1967 the General Conference on Weights and Measures defined the temperature of the triple point of water
   (the temperature at which water exists simultaneously in the gaseous, liquid, and solid states) to be exactly 273.16 kelvins. 
  Since this temperature is also equal to 0.01 u00b0C, the temperature in kelvins is always equal to 273.15 plus the temperature in degrees Celsius. 
  The kelvin equals exactly 1.8 degrees Fahrenheit. 
  The unit is named for the British mathematician and physicist William Thomson (1824-1907),
   later known as Lord Kelvin after he was named Baron Kelvin of Largs.
  """^^qudt:LatexString;
  qudt:applicableSystem <http://qudt.org/vocab/sou/SI>, <http://qudt.org/vocab/sou/SI>;
  qudt:conversionMultiplier 1.0, 1.0;
  qudt:conversionMultiplierSN 1.0E0, 1.0E0;
  qudt:dbpediaMatch "http://dbpedia.org/resource/Kelvin"^^xsd:anyURI, "http://dbpedia.org/resource/Kelvin"^^xsd:anyURI;
  qudt:hasDimensionVector dimensionvector:A0E0L0I0M0H1T0D0, dimensionvector:A0E0L0I0M0H1T0D0;
  qudt:hasQuantityKind quantitykind:BoilingPoint, quantitykind:BoilingPoint, quantitykind:FlashPoint,
    quantitykind:FlashPoint, quantitykind:MeltingPoint, quantitykind:MeltingPoint, quantitykind:Temperature,
    quantitykind:Temperature, quantitykind:ThermodynamicTemperature, quantitykind:ThermodynamicTemperature,
    quantitykind:CorrelatedColorTemperature, quantitykind:CorrelatedColorTemperature;
  qudt:iec61360Code "0112/2///62720#UAA185", "0112/2///62720#UAA185", "0112/2///62720#UAD721";
  qudt:informativeReference "http://en.wikipedia.org/wiki/Kelvin?oldid=495075694"^^xsd:anyURI,
    "http://en.wikipedia.org/wiki/Kelvin?oldid=495075694"^^xsd:anyURI, "https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAA185"^^xsd:anyURI,
    "https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAA185"^^xsd:anyURI,
    "https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAD721"^^xsd:anyURI;
  qudt:omUnit <http://www.ontology-of-units-of-measure.org/resource/om-2/kelvin>, <http://www.ontology-of-units-of-measure.org/resource/om-2/kelvin>;
  qudt:siExactMatch <https://si-digital-framework.org/SI/units/kelvin>, <https://si-digital-framework.org/SI/units/kelvin>;
