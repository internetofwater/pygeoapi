quantitykind:Stress a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "Stress"@en, "Stress"@en;
  rdfs:comment "Applicable units are those of quantitykind:ForcePerArea", "Applicable units are those of quantitykind:ForcePerArea";
  dct:description "Stress is a measure of the average amount of force exerted per unit area of a surface within a deformable body on which internal forces act. In other words, it is a measure of the intensity or internal distribution of the total internal forces acting within a deformable body across imaginary surfaces. These internal forces are produced between the particles in the body as a reaction to external forces applied on the body. Stress is defined as ${\\rm{Stress}} = \\frac{F}{A}$."^^qudt:LatexString,
    "Stress is a measure of the average amount of force exerted per unit area of a surface within a deformable body on which internal forces act. In other words, it is a measure of the intensity or internal distribution of the total internal forces acting within a deformable body across imaginary surfaces. These internal forces are produced between the particles in the body as a reaction to external forces applied on the body. Stress is defined as ${\\rm{Stress}} = \\frac{F}{A}$."^^qudt:LatexString;
  skos:broader quantitykind:ForcePerArea, quantitykind:ForcePerArea;
  qudt:hasDimensionVector dimensionvector:A0E0L-1I0M1H0T-2D0, dimensionvector:A0E0L-1I0M1H0T-2D0;
  qudt:informativeReference "http://www.freestudy.co.uk/mech%20prin%20h2/stress.pdf"^^xsd:anyURI,
    "http://www.freestudy.co.uk/mech%20prin%20h2/stress.pdf"^^xsd:anyURI;
  qudt:latexSymbol "$\\sigma$"^^qudt:LatexString, "$\\sigma$"^^qudt:LatexString;
  qudt:latexDefinition "${\\rm{Stress}} = \\frac{F}{A}$"^^qudt:LatexString, "${\\rm{Stress}} = \\frac{F}{A}$"^^qudt:LatexString;
  qudt:applicableUnit unit:ATM, unit:ATM, unit:ATM_T, unit:ATM_T, unit:BAR, unit:BAR,
    unit:BARAD, unit:BARAD, unit:BARYE, unit:BARYE, unit:CentiBAR, unit:CentiBAR, unit:CentiM_H2O,
