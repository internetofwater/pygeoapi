  rdfs:label "Barrel"@en;
  dct:description "A barrel is one of several units of volume, with dry barrels, fluid barrels (UK beer barrel, U.S. beer barrel), oil barrel, etc. The volume of some barrel units is double others, with various volumes in the range of about 100-200 litres (22-44 imp gal; 26-53 US gal)."^^rdf:HTML;
  <http://qudt.org/schema/qudt/applicableSystem> <http://qudt.org/vocab/sou/USCS>;
  <http://qudt.org/schema/qudt/dbpediaMatch> "http://dbpedia.org/resource/Barrel"^^xsd:anyURI;
