  <http://qudt.org/schema/qudt/symbol> "mag" .

<http://qudt.org/vocab/quantitykind/EarthquakeMagnitude> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "earthquake magnitude";
  rdfs:comment "Applicable units are those of quantitykind:EarthquakeMagnitude";
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1>;
