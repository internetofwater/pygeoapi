unit:GT a qudt:Unit, qudt:Unit;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/unit>, <http://qudt.org/vocab/unit>;
  rdfs:seeAlso unit:TON_Register, unit:TON_Register;
  rdfs:label "Gross Tonnage"@en, "Gross Tonnage"@en;
  dct:description "The formula for calculating GT is given by ${ GT=V\\times (0.2+0.02\\times \\log _{10}(V))}$"^^qudt:LatexString,
    "The formula for calculating GT is given by ${ GT=V\\times (0.2+0.02\\times \\log _{10}(V))}$"^^qudt:LatexString;
  qudt:conversionMultiplier 0.0, 0.0;
  qudt:conversionMultiplierSN 0.0E0, 0.0E0;
  qudt:hasDimensionVector dimensionvector:A0E0L3I0M0H0T0D0, dimensionvector:A0E0L3I0M0H0T0D0;
  qudt:hasQuantityKind quantitykind:Volume, quantitykind:Volume;
  qudt:informativeReference "https://en.wikipedia.org/wiki/Gross_tonnage"^^xsd:anyURI,
    "https://en.wikipedia.org/wiki/Gross_tonnage"^^xsd:anyURI;
  qudt:symbol "G.T.", "G.T.";
  qudt:ucumCode "t{gross}"^^qudt:UCUMcs, "t{gross}"^^qudt:UCUMcs;
  qudt:uneceCommonCode "GT", "GT";
  qudt:plainTextDescription "Gross tonnage (GT, G.T. or gt) is a nonlinear measure of a ship's overall internal volume. Gross tonnage is different from gross register tonnage. Gross tonnage is used to determine things such as a ship's manning regulations, safety rules, registration fees, and port dues, whereas the older gross register tonnage is a measure of the volume of only certain enclosed spaces.",
    "Gross tonnage (GT, G.T. or gt) is a nonlinear measure of a ship's overall internal volume. Gross tonnage is different from gross register tonnage. Gross tonnage is used to determine things such as a ship's manning regulations, safety rules, registration fees, and port dues, whereas the older gross register tonnage is a measure of the volume of only certain enclosed spaces.";
  qudt:latexDefinition "${ GT=V\\times (0.2+0.02\\times \\log _{10}(V))}$ where V is measured in cubic meters."^^qudt:LatexString,
    "${ GT=V\\times (0.2+0.02\\times \\log _{10}(V))}$ where V is measured in cubic meters."^^qudt:LatexString .

