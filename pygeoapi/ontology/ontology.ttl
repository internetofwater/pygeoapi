<http://qudt.org/vocab/quantitykind/AtomicStoppingPower> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "atomic stopping power"@en-US;
