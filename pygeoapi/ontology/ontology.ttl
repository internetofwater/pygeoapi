  <http://qudt.org/schema/qudt/applicableUnit> unit:UNITLESS .

<http://qudt.org/vocab/quantitykind/Efficiency> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Wirkungsgrad"@de, "efficiency"@en, "efficienza"@it, "eficiência"@pt, "rendement"@fr,
    "rendimiento"@es, "sprawność"@pl, "коэффициент полезного действия"@ru, "كفاءة"@ar,
    "効率"@ja, "效率"@zh;
  rdfs:comment "Applicable units are those of quantitykind:DimensionlessRatio";
  dct:description "Efficiency is the ratio of output power to input power."^^<http://qudt.org/schema/qudt/LatexString>;
  skos:altLabel "rendimento"@it;
  skos:broader <http://qudt.org/vocab/quantitykind/DimensionlessRatio>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1>;
  <http://qudt.org/schema/qudt/informativeReference> "http://en.wikipedia.org/wiki/Deformation_(mechanics)"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/isoNormativeReference> "http://www.iso.org/iso/catalogue_detail?csnumber=31889"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/plainTextDescription> "Efficiency is the ratio of output power to input power.";
  <http://qudt.org/schema/qudt/latexSymbol> "$\\eta$"^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/latexDefinition> "$\\eta = \\frac{P_{out}}{P_{in}}$, where $P_{out}$ is the output power and $P_{in}$ is the input power."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/applicableUnit> unit:FRACTION, unit:GR, unit:NUM, unit:PERCENT,
    unit:PERMITTIVITY_REL, unit:PPB, unit:PPM, unit:PPQ, unit:PPT, unit:PPTH, unit:PPTM,
    unit:PSU, unit:UNITLESS .

<http://qudt.org/vocab/quantitykind/EinsteinTransitionProbabilityForSpontaneousOrInducedEmissionAndAbsorption>
  a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Einstein transition probability for spontaneous or induced emission and absorption"@en-US;
  dct:description "nuclear constant for the special transition where the probability of the absorption, spontaneous emission or induced emission of energy depends on the number of existing quantums of light, expressed as energy density in the wave model of light: energy divided by volume and frequency"@en;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L0I0M-1H0T1D0>;
  <http://qudt.org/schema/qudt/symbol> "0173-1#Z4-BAJ456#001";
  <http://qudt.org/schema/qudt/plainTextDescription> "atomare Konstante für den speziellen Übergang, wobei die Wahrscheinlichkeit der Absorption, der spontanen Emission und der induzierte Emission von Energie abhängig ist von der Zahl der vorhandenen Lichtquanten, ausgedrückt als Energiedichte im Wellenmodell des Lichtes: Energie durch Volumen und Frequenz"@de .

