  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "surface-related volume flow"@en-US;
  rdfs:comment "Applicable units are those of quantitykind:SurfaceRelatedVolumeFlow";
  dct:description "quotient of the volume of a material, which passes through a specified surface, and the therefor required time divided by this specified area"@en;
