    <http://qudt.org/vocab/sou/SI>;
  qudt:conversionMultiplier 1.0, 1.0;
  qudt:conversionMultiplierSN 1.0E0, 1.0E0;
  qudt:hasDimensionVector dimensionvector:A0E1L-2I0M-1H0T2D0, dimensionvector:A0E1L-2I0M-1H0T2D0;
  qudt:hasQuantityKind quantitykind:InverseMagneticFlux, quantitykind:InverseMagneticFlux;
  qudt:symbol "Hz/V", "Hz/V";
  qudt:ucumCode "Hz.V-1"^^qudt:UCUMcs, "Hz.V-1"^^qudt:UCUMcs;
