  <http://qudt.org/schema/qudt/iec61360Code> "0112/2///62720#UAA236";
  <http://qudt.org/schema/qudt/informativeReference> "https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAA236"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/symbol> "N/A";
  <http://qudt.org/schema/qudt/ucumCode> "N.A-1"^^<http://qudt.org/schema/qudt/UCUMcs>,
    "N/A"^^<http://qudt.org/schema/qudt/UCUMcs>;
  <http://qudt.org/schema/qudt/uneceCommonCode> "H40";
  <http://qudt.org/schema/qudt/plainTextDescription> "SI derived unit newton divided by the SI base unit ampere" .

<http://qudt.org/vocab/quantitykind/MagneticFluxPerLength> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Magnetic flux per length"@en;
  rdfs:comment "Applicable units are those of quantitykind:MagneticFluxPerLength";
  dct:description "\"Magnetic Flux per Length\" is a quantity in the SI and C.G.S. Systems of Quantities."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E-1L1I0M1H0T-2D0>;
  <http://qudt.org/schema/qudt/plainTextDescription> "\"Magnetic Flux per Length\" is a quantity in the SI and C.G.S. Systems of Quantities.";
  <http://qudt.org/schema/qudt/qkdvDenominator> <http://qudt.org/vocab/dimensionvector/A0E0L1I0M0H0T0D0>;
  <http://qudt.org/schema/qudt/qkdvNumerator> <http://qudt.org/vocab/dimensionvector/A0E-1L2I0M1H0T-2D0>;
