    rdfs:label "QUDT VOCAB Units of Measure Release 3.1.3",
        "QUDT Vocab Units of Measure Release 3.1.4" ;
    ns2:hasGraphMetadata ns2:GMD_QUDT-UNITS-ALL ;
    rdfs:isDefinedBy <http://qudt.org/vocab/unit> ;
    owl:imports <http://qudt.org/schema/facade/qudt>,
        <http://qudt.org/vocab/prefix>,
