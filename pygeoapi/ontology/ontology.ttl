  rdfs:subPropertyOf dc:relation, dc:relation, dct:relation, dct:relation;
  dct:description "This property is intended to be used with non-literal values. This property is an inverse property of Has Part."@en,
    "This property is intended to be used with non-literal values. This property is an inverse property of Has Part."@en;
  dct:issued "2000-07-11"^^xsd:date, "2000-07-11"^^xsd:date .

dct:isReferencedBy a rdf:Property, rdf:Property;
