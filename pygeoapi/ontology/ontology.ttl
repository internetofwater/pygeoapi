    "https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAA112"^^xsd:anyURI;
  qudt:symbol "Bq/kg", "Bq/kg";
  qudt:ucumCode "Bq.kg-1"^^qudt:UCUMcs, "Bq.kg-1"^^qudt:UCUMcs, "Bq/kg"^^qudt:UCUMcs,
