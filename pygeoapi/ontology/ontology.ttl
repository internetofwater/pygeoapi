quantitykind:PartialPressure a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "Partial Pressure"@en, "Partial Pressure"@en;
  rdfs:comment "Applicable units are those of quantitykind:ForcePerArea", "Applicable units are those of quantitykind:ForcePerArea";
  dct:description """
  The quantity kind $\\textit{Partial Pressure}$ is the pressure that the gas would
   have if it alone occupied the volume of the mixture at the same temperature.
  """^^qudt:LatexString,
    """
  The quantity kind $\\textit{Partial Pressure}$ is the pressure that the gas would
   have if it alone occupied the volume of the mixture at the same temperature.
  """^^qudt:LatexString;
