quantitykind:HeatFlowRate a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "Heat Flow Rate"@en, "Heat Flow Rate"@en;
  rdfs:comment "Applicable units are those of quantitykind:HeatFlowRate", "Applicable units are those of quantitykind:HeatFlowRate";
  dct:description "The rate of heat flow between two systems is measured in watts (joules per second). The formula for rate of heat flow is $\\bigtriangleup Q / \\bigtriangleup t = -K \\times A \\times \\bigtriangleup T/x$, where $\\bigtriangleup Q / \\bigtriangleup t$ is the rate of heat flow; $-K$ is the thermal conductivity factor; A is the surface area; $\\bigtriangleup T$ is the change in temperature and $x$ is the thickness of the material. $\\bigtriangleup  T/ x$ is called the temperature gradient and is always negative because of the heat of flow always goes from more thermal energy to less)."^^qudt:LatexString,
    "The rate of heat flow between two systems is measured in watts (joules per second). The formula for rate of heat flow is $\\bigtriangleup Q / \\bigtriangleup t = -K \\times A \\times \\bigtriangleup T/x$, where $\\bigtriangleup Q / \\bigtriangleup t$ is the rate of heat flow; $-K$ is the thermal conductivity factor; A is the surface area; $\\bigtriangleup T$ is the change in temperature and $x$ is the thickness of the material. $\\bigtriangleup  T/ x$ is called the temperature gradient and is always negative because of the heat of flow always goes from more thermal energy to less)."^^qudt:LatexString;
  skos:broader quantitykind:Power, quantitykind:Power;
  qudt:hasDimensionVector dimensionvector:A0E0L2I0M1H0T-3D0, dimensionvector:A0E0L2I0M1H0T-3D0;
  qudt:informativeReference "http://en.wikipedia.org/wiki/Rate_of_heat_flow"^^xsd:anyURI,
    "http://en.wikipedia.org/wiki/Rate_of_heat_flow"^^xsd:anyURI;
  qudt:expression "$heat-flow-rate$"^^qudt:LatexString, "$heat-flow-rate$"^^qudt:LatexString;
  qudt:latexSymbol "$\\Phi$"^^qudt:LatexString, "$\\Phi$"^^qudt:LatexString;
