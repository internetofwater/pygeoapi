quantitykind:ElectricConductivity a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "Kekonduksian elektrik"@ms, "Kekonduksian elektrik"@ms, "conducibilità elettrica"@it,
    "conducibilità elettrica"@it, "conductividad eléctrica"@es, "conductividad eléctrica"@es,
    "conductivité électrique"@fr, "conductivité électrique"@fr, "condutividade elétrica"@pt,
    "condutividade elétrica"@pt, "electric conductivity"@en, "electric conductivity"@en,
    "elektrik iletkenliği"@tr, "elektrik iletkenliği"@tr, "elektrische Leitfähigkeit"@de,
    "elektrische Leitfähigkeit"@de, "električna prevodnost"@sl, "električna prevodnost"@sl,
    "رسانايى الکتريکى/هدایت الکتریکی"@fa, "رسانايى الکتريکى/هدایت الکتریکی"@fa, "电导率"@zh,
    "电导率"@zh;
  rdfs:comment "Applicable units are those of quantitykind:ElectricConductivity", "Applicable units are those of quantitykind:ElectricConductivity";
  dct:description """
  The quantity kind $\\textit{Electric Conductivity}$ or $\\textit{Specific Conductance}$ is a measure of a material's ability to conduct an electric current. 
  When an electrical potential difference is placed across a conductor, its movable charges flow, giving rise to an electric current. 
  The conductivity $\\sigma$ is defined as the ratio of the electric current density $J$ to the electric field, $E$: $J = \\sigma E$. 
  In isotropic materials, conductivity is scalar-valued, however in general, conductivity is a tensor-valued quantity.
  """^^qudt:LatexString,
    """
  The quantity kind $\\textit{Electric Conductivity}$ or $\\textit{Specific Conductance}$ is a measure of a material's ability to conduct an electric current. 
  When an electrical potential difference is placed across a conductor, its movable charges flow, giving rise to an electric current. 
  The conductivity $\\sigma$ is defined as the ratio of the electric current density $J$ to the electric field, $E$: $J = \\sigma E$. 
  In isotropic materials, conductivity is scalar-valued, however in general, conductivity is a tensor-valued quantity.
  """^^qudt:LatexString;
  qudt:hasDimensionVector dimensionvector:A0E2L-3I0M-1H0T3D0, dimensionvector:A0E2L-3I0M-1H0T3D0;
  qudt:latexSymbol "$\\sigma$"^^qudt:LatexString, "$\\sigma$"^^qudt:LatexString;
  qudt:applicableUnit unit:MHO_Stat, unit:MHO_Stat, unit:S_Stat, unit:S_Stat, unit:S_Ab,
    unit:S_Ab .

unit:MI a qudt:Unit, qudt:Unit;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/unit>, <http://qudt.org/vocab/unit>;
  rdfs:label "International Mile"@en, "International Mile"@en;
  dct:description "The exact length of the land mile varied slightly among English-speaking countries until the international yard and pound agreement in 1959 established the yard as exactly 0.9144 metres, giving a mile of exactly 1,609.344 metres. The United States adopted this international mile for most purposes, but retained the pre-1959 mile for some land-survey data, terming it the US survey mile. In the US, statute mile formally refers to the survey mile, about 3.219 mm (1/8 inch) longer than the international mile (the international mile is exactly 0.0002% less than the US survey mile)."^^rdf:HTML,
    "The exact length of the land mile varied slightly among English-speaking countries until the international yard and pound agreement in 1959 established the yard as exactly 0.9144 metres, giving a mile of exactly 1,609.344 metres. The United States adopted this international mile for most purposes, but retained the pre-1959 mile for some land-survey data, terming it the US survey mile. In the US, statute mile formally refers to the survey mile, about 3.219 mm (1/8 inch) longer than the international mile (the international mile is exactly 0.0002% less than the US survey mile)."^^rdf:HTML;
  qudt:applicableSystem <http://qudt.org/vocab/sou/IMPERIAL>, <http://qudt.org/vocab/sou/IMPERIAL>,
    <http://qudt.org/vocab/sou/USCS>, <http://qudt.org/vocab/sou/USCS>;
  qudt:conversionMultiplier 1609.344, 1609.344;
  qudt:conversionMultiplierSN 1.609344E3, 1.609344E3;
  qudt:hasDimensionVector dimensionvector:A0E0L1I0M0H0T0D0, dimensionvector:A0E0L1I0M0H0T0D0;
  qudt:hasQuantityKind quantitykind:Length, quantitykind:Length, quantitykind:Distance,
    quantitykind:Distance;
  qudt:iec61360Code "0112/2///62720#UAA839", "0112/2///62720#UAA839";
  qudt:informativeReference "http://en.wikipedia.org/wiki/Mile"^^xsd:anyURI, "http://en.wikipedia.org/wiki/Mile"^^xsd:anyURI,
