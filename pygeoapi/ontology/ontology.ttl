quantitykind:TotalLinearStoppingPower a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "Total Linear Stopping Power"@en, "Total Linear Stopping Power"@en;
  rdfs:comment "Applicable units are those of quantitykind:TotalLinearStoppingPower",
    "Applicable units are those of quantitykind:TotalLinearStoppingPower";
  dct:description "The \"Total Linear Stopping Power\" is defined as the average energy loss of the particle per unit path length."^^qudt:LatexString,
    "The \"Total Linear Stopping Power\" is defined as the average energy loss of the particle per unit path length."^^qudt:LatexString;
  qudt:hasDimensionVector dimensionvector:A0E0L1I0M1H0T-2D0, dimensionvector:A0E0L1I0M1H0T-2D0;
  qudt:iec61360Code "0112/2///62720#UAD203", "0112/2///62720#UAD203";
  qudt:informativeReference "http://en.wikipedia.org/wiki/Stopping_power_(particle_radiation)"^^xsd:anyURI,
    "http://en.wikipedia.org/wiki/Stopping_power_(particle_radiation)"^^xsd:anyURI, "https://cdd.iec.ch/cdd/iec61987/iec61987.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD203"^^xsd:anyURI,
    "https://cdd.iec.ch/cdd/iec61987/iec61987.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD203"^^xsd:anyURI;
  qudt:symbol "S", "S";
  qudt:isoNormativeReference "http://www.iso.org/iso/catalogue_detail?csnumber=31895"^^xsd:anyURI,
    "http://www.iso.org/iso/catalogue_detail?csnumber=31895"^^xsd:anyURI;
  qudt:plainTextDescription "The \"Total Linear Stopping Power\" is defined as the average energy loss of the particle per unit path length.",
    "The \"Total Linear Stopping Power\" is defined as the average energy loss of the particle per unit path length.";
  qudt:latexDefinition "$S = -\\frac{dE}{dx}$, where $-dE$ is the energy decrement in the $x-direction$ along an elementary path with the length $dx$."^^qudt:LatexString,
