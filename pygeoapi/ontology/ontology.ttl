unit:AC a qudt:Unit, qudt:Unit, qudt:DerivedUnit, qudt:DerivedUnit;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/unit>, <http://qudt.org/vocab/unit>;
  rdfs:label "Acre"@en, "Acre"@en;
  dct:description "The acre is a unit of area in a number of different systems, including the imperial and U.S. customary systems. Its international symbol is ac. The most commonly used acres today are the international acre and, in the United States, the survey acre. The most common use of the acre is to measure tracts of land. One international acre is equal to 4046.8564224 square metres."^^rdf:HTML,
    "The acre is a unit of area in a number of different systems, including the imperial and U.S. customary systems. Its international symbol is ac. The most commonly used acres today are the international acre and, in the United States, the survey acre. The most common use of the acre is to measure tracts of land. One international acre is equal to 4046.8564224 square metres."^^rdf:HTML;
  skos:altLabel "acre", "acre";
  qudt:applicableSystem <http://qudt.org/vocab/sou/IMPERIAL>, <http://qudt.org/vocab/sou/IMPERIAL>,
    <http://qudt.org/vocab/sou/USCS>, <http://qudt.org/vocab/sou/USCS>;
  qudt:conversionMultiplier 4046.8564224, 4046.8564224;
  qudt:conversionMultiplierSN 4.0468564224E3, 4.0468564224E3;
  qudt:dbpediaMatch "http://dbpedia.org/resource/Acre"^^xsd:anyURI, "http://dbpedia.org/resource/Acre"^^xsd:anyURI;
  qudt:hasDimensionVector dimensionvector:A0E0L2I0M0H0T0D0, dimensionvector:A0E0L2I0M0H0T0D0;
  qudt:hasQuantityKind quantitykind:Area, quantitykind:Area;
  qudt:iec61360Code "0112/2///62720#UAA320", "0112/2///62720#UAA320";
  qudt:informativeReference "http://en.wikipedia.org/wiki/Acre?oldid=495387342"^^xsd:anyURI,
    "http://en.wikipedia.org/wiki/Acre?oldid=495387342"^^xsd:anyURI, "https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAA320"^^xsd:anyURI,
    "https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAA320"^^xsd:anyURI;
  qudt:symbol "acre", "acre";
  qudt:ucumCode "[acr_br]"^^qudt:UCUMcs, "[acr_br]"^^qudt:UCUMcs;
  qudt:uneceCommonCode "ACR", "ACR";
  qudt:definedUnitOfSystem <http://qudt.org/vocab/sou/IMPERIAL>, <http://qudt.org/vocab/sou/IMPERIAL>,
    <http://qudt.org/vocab/sou/USCS>, <http://qudt.org/vocab/sou/USCS>;
  qudt:scalingOf unit:M2 .

<http://qudt.org/vocab/sou/IMPERIAL> a qudt:SystemOfUnits, qudt:SystemOfUnits;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/sou>, <http://qudt.org/vocab/sou>;
  rdfs:label "Imperial System of Units"@en, "Imperial System of Units"@en;
  dct:description "A system of units formerly widely used in the UK and the rest of the English-speaking world. It includes the pound (lb), quarter (qt), hundredweight (cwt), and ton (ton); the foot (ft), yard (yd), and mile (mi); and the gallon (gal), British thermal unit (btu), etc. These units have been largely replaced by metric units, although Imperial units persist in some contexts. In January 2000 an EU regulation outlawing the sale of goods in Imperial measures was adopted into British law; an exception was made for the sale of beer and milk in pints. "^^rdf:HTML,
    "A system of units formerly widely used in the UK and the rest of the English-speaking world. It includes the pound (lb), quarter (qt), hundredweight (cwt), and ton (ton); the foot (ft), yard (yd), and mile (mi); and the gallon (gal), British thermal unit (btu), etc. These units have been largely replaced by metric units, although Imperial units persist in some contexts. In January 2000 an EU regulation outlawing the sale of goods in Imperial measures was adopted into British law; an exception was made for the sale of beer and milk in pints. "^^rdf:HTML;
  qudt:dbpediaMatch "http://dbpedia.org/resource/Imperial_units"^^xsd:anyURI, "http://dbpedia.org/resource/Imperial_units"^^xsd:anyURI;
  qudt:informativeReference "http://www.oxfordreference.com/view/10.1093/acref/9780199234899.001.0001/acref-9780199234899-e-3147"^^xsd:anyURI,
    "http://www.oxfordreference.com/view/10.1093/acref/acref-9780199234899-e-3147"^^xsd:anyURI;
  qudt:abbreviation "Imperial", "Imperial" .

<http://qudt.org/vocab/sou/USCS> a qudt:SystemOfUnits, qudt:SystemOfUnits;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/sou>, <http://qudt.org/vocab/sou>;
  rdfs:label "US Customary Unit System"@en, "US Customary Unit System"@en;
  dct:description "United States customary units are a system of measurements commonly used in the United States. Many U.S. units are virtually identical to their imperial counterparts, but the U.S. customary system developed from English units used in the British Empire before the system of imperial units was standardized in 1824. Several numerical differences from the imperial system are present. The vast majority of U.S. customary units have been defined in terms of the meter and the kilogram since the Mendenhall Order of 1893 (and, in practice, for many years before that date). These definitions were refined in 1959. The United States is the only industrialized nation that does not mainly use the metric system in its commercial and standards activities, although the International System of Units (SI, often referred to as \"metric\") is commonly used in the U.S. Armed Forces, in fields relating to science, and increasingly in medicine, aviation, and government as well as various sectors of industry. [Wikipedia]"^^rdf:HTML,
    "United States customary units are a system of measurements commonly used in the United States. Many U.S. units are virtually identical to their imperial counterparts, but the U.S. customary system developed from English units used in the British Empire before the system of imperial units was standardized in 1824. Several numerical differences from the imperial system are present. The vast majority of U.S. customary units have been defined in terms of the meter and the kilogram since the Mendenhall Order of 1893 (and, in practice, for many years before that date). These definitions were refined in 1959. The United States is the only industrialized nation that does not mainly use the metric system in its commercial and standards activities, although the International System of Units (SI, often referred to as \"metric\") is commonly used in the U.S. Armed Forces, in fields relating to science, and increasingly in medicine, aviation, and government as well as various sectors of industry. [Wikipedia]"^^rdf:HTML;
  qudt:dbpediaMatch "http://dbpedia.org/resource/United_States_customary_units"^^xsd:anyURI,
    "http://dbpedia.org/resource/United_States_customary_units"^^xsd:anyURI;
  qudt:abbreviation "US Customary", "US Customary";
  <http://www.linkedmodel.org/schema/vaem#url> "http://en.wikipedia.org/wiki/US_customary_units"^^xsd:anyURI,
    "http://en.wikipedia.org/wiki/US_customary_units"^^xsd:anyURI .

