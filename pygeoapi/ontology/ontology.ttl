quantitykind:MigrationArea a qudt:QuantityKind ;
    rdfs:label "Migration Area"@en ;
    dct:description "\"Migration Area\" is the sum of the slowing-down area from fission energy to thermal energy and the diffusion area for thermal neutrons."^^qudt:LatexString ;
    qudt:applicableUnit unit:AC,
        unit:ARE,
        unit:BARN,
        unit:CentiM2,
