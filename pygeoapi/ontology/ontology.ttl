quantitykind:RadiantIntensity a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "Radiant Intensity"@en, "Radiant Intensity"@en;
  rdfs:comment "Applicable units are those of quantitykind:RadiantIntensity", "Applicable units are those of quantitykind:RadiantIntensity";
  dct:description "Radiant Intensity is a measure of the intensity of electromagnetic radiation. It is defined as power per unit solid angle."^^qudt:LatexString,
    "Radiant Intensity is a measure of the intensity of electromagnetic radiation. It is defined as power per unit solid angle."^^qudt:LatexString;
  qudt:hasDimensionVector dimensionvector:A0E0L2I0M1H0T-3D0, dimensionvector:A0E0L2I0M1H0T-3D0;
  qudt:iec61360Code "0112/2///62720#UAD151", "0112/2///62720#UAD151";
  qudt:informativeReference "http://en.wikipedia.org/wiki/Radiant_intensity"^^xsd:anyURI,
    "http://en.wikipedia.org/wiki/Radiant_intensity"^^xsd:anyURI, "https://cdd.iec.ch/cdd/iec61987/iec61987.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD151"^^xsd:anyURI,
    "https://cdd.iec.ch/cdd/iec61987/iec61987.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD151"^^xsd:anyURI;
  qudt:siExactMatch <https://si-digital-framework.org/SI/quantities/RAIN>, <https://si-digital-framework.org/quantities/RAIN>;
  qudt:symbol "I", "I";
  qudt:plainTextDescription "Radiant Intensity is a measure of the intensity of electromagnetic radiation. It is defined as power per unit solid angle.",
    "Radiant Intensity is a measure of the intensity of electromagnetic radiation. It is defined as power per unit solid angle.";
  qudt:latexDefinition "$I = \\frac{d\\Phi}{d\\Omega}$, where $d\\Phi$ is the radiant flux leaving the source in an elementary cone containing the given direction with the solid angle $d\\Omega$."^^qudt:LatexString,
    "$I = \\frac{d\\Phi}{d\\Omega}$, where $d\\Phi$ is the radiant flux leaving the source in an elementary cone containing the given direction with the solid angle $d\\Omega$."^^qudt:LatexString;
  qudt:applicableUnit unit:W-PER-SR, unit:W-PER-SR .

