  qudt:altSymbol "I_t", "I_t";
  qudt:applicableUnit unit:A, unit:A, unit:AttoA, unit:AttoA, unit:FemtoA, unit:FemtoA,
    unit:GigaA, unit:GigaA, unit:PetaA, unit:PetaA, unit:TeraA, unit:TeraA .

