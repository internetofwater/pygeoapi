  <http://qudt.org/schema/qudt/hasQuantityKind> <http://qudt.org/vocab/quantitykind/Acceleration>,
    <http://qudt.org/vocab/quantitykind/LinearAcceleration>;
  <http://qudt.org/schema/qudt/iec61360Code> "0112/2///62720#UAB130";
  <http://qudt.org/schema/qudt/informativeReference> "https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAB130"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/symbol> "kPa·m²/g";
  <http://qudt.org/schema/qudt/ucumCode> "kPa.m2.g-1"^^<http://qudt.org/schema/qudt/UCUMcs>;
  <http://qudt.org/schema/qudt/uneceCommonCode> "33";
  <http://qudt.org/schema/qudt/plainTextDescription> "sector-specific unit of the burst index as 1 000-fold of the derived unit for pressure pascal related to the substance, represented as a quotient from the 0.001-fold of the SI base unit kilogram divided by the power of the SI base unit metre by exponent 2" .

