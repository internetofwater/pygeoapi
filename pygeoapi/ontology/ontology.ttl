<http://qudt.org/vocab/quantitykind/LinearStrain> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Linear Strain"@en;
  rdfs:comment "Applicable units are those of quantitykind:LengthRatio";
  dct:description "A strain is a normalized measure of deformation representing the displacement between particles in the body relative to a reference length."^^<http://qudt.org/schema/qudt/LatexString>;
  skos:broader <http://qudt.org/vocab/quantitykind/LengthRatio>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1>;
  <http://qudt.org/schema/qudt/informativeReference> "http://en.wikipedia.org/wiki/Deformation_(mechanics)"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/isoNormativeReference> "http://www.iso.org/iso/catalogue_detail?csnumber=31889"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/plainTextDescription> "A strain is a normalized measure of deformation representing the displacement between particles in the body relative to a reference length.";
  <http://qudt.org/schema/qudt/exactMatch> <http://qudt.org/vocab/quantitykind/Strain>;
  <http://qudt.org/schema/qudt/latexSymbol> "$\\xi$"^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/latexDefinition> "$\\xi = \\frac{\\Delta l}{l_0}$, where $\\Delta l$ is the increase in length and $l_0$ is the length in a reference state to be specified."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/applicableUnit> unit:PERCENT .

<http://qudt.org/vocab/quantitykind/Strain> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Strain"@en;
  rdfs:comment "Applicable units are those of quantitykind:DimensionlessRatio";
  dct:description "In any branch of science dealing with materials and their behaviour, strain is the geometrical expression of deformation caused by the action of stress on a physical body. Strain is calculated by first assuming a change between two body states: the beginning state and the final state. Then the difference in placement of two points in this body in those two states expresses the numerical value of strain. Strain therefore expresses itself as a change in size and/or shape. [Wikipedia]"^^<http://qudt.org/schema/qudt/LatexString>;
  skos:broader <http://qudt.org/vocab/quantitykind/DimensionlessRatio>;
  <http://qudt.org/schema/qudt/dbpediaMatch> "http://dbpedia.org/resource/Strain"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1>;
  <http://qudt.org/schema/qudt/informativeReference> "http://www.freestudy.co.uk/mech+prin+h2/stress.pdf"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/plainTextDescription> "In any branch of science dealing with materials and their behaviour, strain is the geometrical expression of deformation caused by the action of stress on a physical body. Strain is calculated by first assuming a change between two body states: the beginning state and the final state. Then the difference in placement of two points in this body in those two states expresses the numerical value of strain. Strain therefore expresses itself as a change in size and/or shape. [Wikipedia]";
  <http://qudt.org/schema/qudt/exactMatch> <http://qudt.org/vocab/quantitykind/LinearStrain>;
  <http://qudt.org/schema/qudt/latexSymbol> "$\\epsilon$"^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/applicableUnit> unit:FRACTION, unit:GR, unit:NUM, unit:PERCENT,
    unit:PERMITTIVITY_REL, unit:PPB, unit:PPM, unit:PPQ, unit:PPT, unit:PPTH, unit:PPTM,
    unit:PSU, unit:UNITLESS .

<http://qudt.org/vocab/quantitykind/LinearVoltageCoefficient> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "linear voltage coefficient"@en-US;
  dct:description "ratio identifying the relationship between induced voltage and velocity"@en;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E-1L1I0M1H0T-2D0>;
  <http://qudt.org/schema/qudt/symbol> "0173-1#Z4-BAJ336#003";
  <http://qudt.org/schema/qudt/plainTextDescription> "Verhältnis, das den Zusammenhang zwischen induzierter Spannung zur Geschwindigkeit kennzeichnet"@de .

<http://qudt.org/vocab/quantitykind/LineicCharge> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "lineic charge"@en-US;
  dct:description "electric charge divided by related length"@en;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E1L-1I0M0H0T1D0>;
  <http://qudt.org/schema/qudt/symbol> "0173-1#Z4-BAJ457#001";
  <http://qudt.org/schema/qudt/plainTextDescription> "elektrische Ladung dividiert durch dazugehörige Länge"@de .

<http://qudt.org/vocab/quantitykind/LineicDataVolume> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "lineic data volume"@en-US;
  dct:description "number of data, usually dependent on the respective information complexity or its coding procedure, divided by the related length"@en;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L-1I0M0H0T0D0>;
  <http://qudt.org/schema/qudt/symbol> "0173-1#Z4-BAJ331#002";
  <http://qudt.org/schema/qudt/plainTextDescription> "Anzahl von Daten, die in der Regel abhängig von der jeweiligen Komplexität der Information oder deren Codierungsverfahren ist, dividiert durch die zugehörige Länge"@de .

<http://qudt.org/vocab/quantitykind/LineicLogarithmicRatio> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "lineic logarithmic ratio"@en-US;
  dct:description "logarithm of the relationship between the value of a given quantity and the quantity of a reference value of the same type divided by the related length"@en;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L-1I0M0H0T0D0>;
  <http://qudt.org/schema/qudt/symbol> "0173-1#Z4-BAJ332#003";
  <http://qudt.org/schema/qudt/plainTextDescription> "Logarithmus des Verhältnisses des Werts einer gegebenen Größe zum Wert einer Bezugsgröße gleicher Art dividiert durch die zugehörige Länge"@de .

<http://qudt.org/vocab/quantitykind/LineicMass> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "lineic mass"@en-US;
  dct:description "ratio between mass divided by the related length"@en;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L-1I0M1H0T0D0>;
  <http://qudt.org/schema/qudt/symbol> "0173-1#Z4-BAJ341#003";
  <http://qudt.org/schema/qudt/plainTextDescription> "Quotient Masse dividiert durch die dazugehörige Länge"@de .

<http://qudt.org/vocab/quantitykind/LineicQuantity> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "lineic quantity"@en-US;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/NotApplicable> .

<http://qudt.org/vocab/quantitykind/LineicResistance> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "lineic resistance"@en-US;
  dct:description "ratio of resistance divided by length"@en;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/NotApplicable>;
  <http://qudt.org/schema/qudt/symbol> "0173-1#Z4-BAJ333#003";
  <http://qudt.org/schema/qudt/plainTextDescription> "Quotient Widerstand durch Länge"@de .

<http://qudt.org/vocab/quantitykind/LineicResolution> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "lineic resolution"@en-US;
  rdfs:comment "Applicable units are those of quantitykind:InverseLength";
  dct:description "graphic resolution capacity of output devices such as printers or of data acquisition such as scanners, as a number of pixels per length"@en;
  skos:broader <http://qudt.org/vocab/quantitykind/InverseLength>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L-1I0M0H0T0D0>;
  <http://qudt.org/schema/qudt/symbol> "0173-1#Z4-BAJ438#002";
  <http://qudt.org/schema/qudt/plainTextDescription> "grafisches Auflösungsvermögen von Ausgabegeräten wie Druckern oder von Datenerfassungsgeräten wie Scannern als Anzahl der Bildpunkte je Länge"@de;
  <http://qudt.org/schema/qudt/applicableUnit> unit:DPI, unit:KY, unit:M-PER-HA, unit:M-PER-M2,
    unit:MESH, unit:NUM-PER-M, unit:PER-M, unit:PER-ANGSTROM, unit:PER-CentiM, unit:PER-KiloM,
    unit:PER-MicroM, unit:PER-MilliM, unit:PER-NanoM, unit:PER-PicoM .

<http://qudt.org/vocab/quantitykind/LineicTorque> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "lineic torque"@en-US;
  dct:description "torque divided by the appropriate length"@en;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L1I0M1H0T-2D0>;
  <http://qudt.org/schema/qudt/symbol> "0173-1#Z4-BAJ433#001";
  <http://qudt.org/schema/qudt/plainTextDescription> "Drehmoment dividiert durch die zugehörige Länge"@de .

<http://qudt.org/vocab/quantitykind/LinkedFlux> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Linked Flux"@en;
  rdfs:comment "Applicable units are those of quantitykind:MagneticFlux";
  dct:description "\"Linked Flux\" is defined as the path integral of the magnetic vector potential. This is the line integral of a magnetic vector potential $A$ along a curve $C$. The line vector element $dr$ is the differential of position vector $r$."^^<http://qudt.org/schema/qudt/LatexString>;
  skos:broader <http://qudt.org/vocab/quantitykind/MagneticFlux>;
  <http://qudt.org/schema/qudt/dbpediaMatch> "http://dbpedia.org/resource/Magnetic_flux"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E-1L2I0M1H0T-2D0>;
  <http://qudt.org/schema/qudt/informativeReference> "http://www.iso.org/iso/home/store/catalogue_tc/catalogue_detail.htm?csnumber=31891"^^xsd:anyURI,
    "http://www.electropedia.org/iev/iev.nsf/display?openform&ievref=121-11-24"^^xsd:anyURI,
    "http://www.oxfordreference.com/display/10.1093/acref/9780199233991.001.0001/acref-9780199233991-e-1800"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/expression> "$linked-flux$"^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/latexSymbol> "$\\Psi$"^^<http://qudt.org/schema/qudt/LatexString>,
    "$\\Psi_m$"^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/latexDefinition> "$\\Psi_m = \\int_C A \\cdot dr$, where $A$ is magnetic vector potential and $dr$ is the vector element of the curve $C$."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/applicableUnit> unit:KiloLB_F-FT-PER-A, unit:KiloWB,
    unit:MX, unit:MilliWB, unit:N-M-PER-A, unit:UnitPole, unit:V_Ab-SEC, unit:WB .

