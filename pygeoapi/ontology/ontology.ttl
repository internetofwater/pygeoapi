  dct:description "\"Molar Absorption Coefficient\" is a spectrophotometric unit indicating the light a substance absorbs with respect to length, usually centimeters, and concentration, usually moles per liter."^^qudt:LatexString,
    "\"Molar Absorption Coefficient\" is a spectrophotometric unit indicating the light a substance absorbs with respect to length, usually centimeters, and concentration, usually moles per liter."^^qudt:LatexString;
  qudt:hasDimensionVector dimensionvector:A-1E0L2I0M0H0T0D0, dimensionvector:A-1E0L2I0M0H0T0D0;
  qudt:informativeReference "http://medical-dictionary.thefreedictionary.com/molar+absorption+coefficient"^^xsd:anyURI,
    "http://medical-dictionary.thefreedictionary.com/molar+absorption+coefficient"^^xsd:anyURI;
  qudt:symbol "x", "x";
  qudt:plainTextDescription "\"Molar Absorption Coefficient\" is a spectrophotometric unit indicating the light a substance absorbs with respect to length, usually centimeters, and concentration, usually moles per liter.",
    "\"Molar Absorption Coefficient\" is a spectrophotometric unit indicating the light a substance absorbs with respect to length, usually centimeters, and concentration, usually moles per liter.";
  qudt:exactMatch quantitykind:MolarAttenuationCoefficient, quantitykind:MolarAttenuationCoefficient;
  qudt:latexDefinition "$x = aV_m$, where $a$ is the linear absorption coefficient and $V_m$ is the molar volume."^^qudt:LatexString,
