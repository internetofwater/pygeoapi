quantitykind:Temperature a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:seeAlso quantitykind:ThermodynamicTemperature, quantitykind:ThermodynamicTemperature;
  rdfs:label "Temperature"@en, "Temperature"@en;
  rdfs:comment "Applicable units are those of quantitykind:Temperature", "Applicable units are those of quantitykind:Temperature";
  dct:description "Temperature is a physical property of matter that quantitatively expresses the common notions of hot and cold. Objects of low temperature are cold, while various degrees of higher temperatures are referred to as warm or hot. Heat spontaneously flows from bodies of a higher temperature to bodies of lower temperature, at a rate that increases with the temperature difference and the thermal conductivity."^^qudt:LatexString,
    "Temperature is a physical property of matter that quantitatively expresses the common notions of hot and cold. Objects of low temperature are cold, while various degrees of higher temperatures are referred to as warm or hot. Heat spontaneously flows from bodies of a higher temperature to bodies of lower temperature, at a rate that increases with the temperature difference and the thermal conductivity."^^qudt:LatexString;
  qudt:dbpediaMatch "http://dbpedia.org/resource/Temperature"^^xsd:anyURI, "http://dbpedia.org/resource/Temperature"^^xsd:anyURI;
  qudt:hasDimensionVector dimensionvector:A0E0L0I0M0H1T0D0, dimensionvector:A0E0L0I0M0H1T0D0;
  qudt:iec61360Code "0112/2///62720#UAD374", "0112/2///62720#UAD374";
  qudt:informativeReference "https://cdd.iec.ch/cdd/iec61987/iec61987.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD374"^^xsd:anyURI,
    "https://cdd.iec.ch/cdd/iec61987/iec61987.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD374"^^xsd:anyURI;
  qudt:plainTextDescription "Temperature is a physical property of matter that quantitatively expresses the common notions of hot and cold. Objects of low temperature are cold, while various degrees of higher temperatures are referred to as warm or hot. Heat spontaneously flows from bodies of a higher temperature to bodies of lower temperature, at a rate that increases with the temperature difference and the thermal conductivity.",
    "Temperature is a physical property of matter that quantitatively expresses the common notions of hot and cold. Objects of low temperature are cold, while various degrees of higher temperatures are referred to as warm or hot. Heat spontaneously flows from bodies of a higher temperature to bodies of lower temperature, at a rate that increases with the temperature difference and the thermal conductivity.";
  qudt:applicableUnit unit:DEG_C, unit:DEG_C, unit:DEG_F, unit:DEG_F, unit:DEG_R, unit:DEG_R,
