<http://qudt.org/vocab/quantitykind/DragCoefficient> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Drag Coefficient"@en;
  rdfs:comment "Applicable units are those of quantitykind:Dimensionless";
  dct:description "In fluid dynamics, the drag coefficient is a dimensionless quantity that is used to quantify the drag or resistance of an object in a fluid environment such as air or water."^^<http://qudt.org/schema/qudt/LatexString>;
