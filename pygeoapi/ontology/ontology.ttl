quantitykind:DebyeAngularFrequency a qudt:QuantityKind ;
    rdfs:label "Debye Angular Frequency"@en ;
    dct:description "\"Debye Angular Frequency\" is the cut-off angular frequency in the Debye model of the vibrational spectrum of a solid."^^qudt:LatexString ;
    qudt:applicableUnit unit:DEG-PER-HR,
