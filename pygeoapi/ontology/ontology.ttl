quantitykind:HeartRate a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "Heart Rate"@en, "Heart Rate"@en;
  rdfs:comment "Applicable units are those of quantitykind:HeartRate", "Applicable units are those of quantitykind:HeartRate";
  dct:description "The number of heartbeats per unit of time, usually per minute. The heart rate is based on the number of contractions of the ventricles (the lower chambers of the heart). The heart rate may be too fast (tachycardia) or too slow (bradycardia). The average adult pulse rate at rest is 60–80 per minute, but exercise, injury, illness, and emotion may produce much faster rates."^^qudt:LatexString,
    "The number of heartbeats per unit of time, usually per minute. The heart rate is based on the number of contractions of the ventricles (the lower chambers of the heart). The heart rate may be too fast (tachycardia) or too slow (bradycardia). The average adult pulse rate at rest is 60–80 per minute, but exercise, injury, illness, and emotion may produce much faster rates."^^qudt:LatexString;
  qudt:dbpediaMatch "http://dbpedia.org/resource/Heart_rate"^^xsd:anyURI, "http://dbpedia.org/resource/Heart_rate"^^xsd:anyURI;
  qudt:hasDimensionVector dimensionvector:A0E0L0I0M0H0T-1D0, dimensionvector:A0E0L0I0M0H0T-1D0;
  qudt:informativeReference "http://www.oxfordreference.com/display/10.1093/oi/authority.20110803100354463"^^xsd:anyURI,
    "http://www.oxfordreference.com/display/10.1093/oi/authority.20110803100354463"^^xsd:anyURI;
  qudt:plainTextDescription "The number of heartbeats per unit of time, usually per minute. The heart rate is based on the number of contractions of the ventricles (the lower chambers of the heart). The heart rate may be too fast (tachycardia) or too slow (bradycardia). The average adult pulse rate at rest is 60–80 per minute, but exercise, injury, illness, and emotion may produce much faster rates.",
    "The number of heartbeats per unit of time, usually per minute. The heart rate is based on the number of contractions of the ventricles (the lower chambers of the heart). The heart rate may be too fast (tachycardia) or too slow (bradycardia). The average adult pulse rate at rest is 60–80 per minute, but exercise, injury, illness, and emotion may produce much faster rates.";
  qudt:applicableUnit unit:BEAT-PER-MIN, unit:BEAT-PER-MIN .

