quantitykind:AbsorbedDose a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "Absorbed Dose"@en, "Absorbed Dose"@en;
  rdfs:comment "Applicable units are those of quantitykind:AbsorbedDose", "Applicable units are those of quantitykind:AbsorbedDose",
    "Note that the absorbed dose is not a good indicator of the likely biological effect. 1 Gy of alpha radiation would be much more biologically damaging than 1 Gy of photon radiation for example. Appropriate weighting factors can be applied reflecting the different relative biological effects to find the equivalent dose. The risk of stoctic effects due to radiation exposure can be quantified using the effective dose, which is a weighted average of the equivalent dose to each organ depending upon its radiosensitivity. When ionising radiation is used to treat cancer, the doctor will usually prescribe the radiotherapy treatment in Gy. When risk from ionising radiation is being discussed, a related unit, the Sievert is used.",
    "Note that the absorbed dose is not a good indicator of the likely biological effect. 1 Gy of alpha radiation would be much more biologically damaging than 1 Gy of photon radiation for example. Appropriate weighting factors can be applied reflecting the different relative biological effects to find the equivalent dose. The risk of stoctic effects due to radiation exposure can be quantified using the effective dose, which is a weighted average of the equivalent dose to each organ depending upon its radiosensitivity. When ionising radiation is used to treat cancer, the doctor will usually prescribe the radiotherapy treatment in Gy. When risk from ionising radiation is being discussed, a related unit, the Sievert is used.";
  dct:description "\"Absorbed Dose\" (also known as Total Ionizing Dose, TID) is a measure of the energy deposited in a medium by ionizing radiation. It is equal to the energy deposited per unit mass of medium, and so has the unit $J/kg$, which is given the special name Gray ($Gy$)."^^qudt:LatexString,
    "\"Absorbed Dose\" (also known as Total Ionizing Dose, TID) is a measure of the energy deposited in a medium by ionizing radiation. It is equal to the energy deposited per unit mass of medium, and so has the unit $J/kg$, which is given the special name Gray ($Gy$)."^^qudt:LatexString;
  skos:broader quantitykind:SpecificEnergy, quantitykind:SpecificEnergy;
  qudt:dbpediaMatch "http://dbpedia.org/resource/Absorbed_dose"^^xsd:anyURI, "http://dbpedia.org/resource/Absorbed_dose"^^xsd:anyURI;
  qudt:hasDimensionVector dimensionvector:A0E0L2I0M0H0T-2D0, dimensionvector:A0E0L2I0M0H0T-2D0;
  qudt:iec61360Code "0112/2///62720#UAD000", "0112/2///62720#UAD000";
  qudt:informativeReference "http://en.wikipedia.org/wiki/Absorbed_dose"^^xsd:anyURI,
    "http://en.wikipedia.org/wiki/Absorbed_dose"^^xsd:anyURI, "https://cdd.iec.ch/cdd/iec61987/iec61987.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD000"^^xsd:anyURI,
    "https://cdd.iec.ch/cdd/iec61987/iec61987.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD000"^^xsd:anyURI;
  qudt:siExactMatch <https://si-digital-framework.org/SI/quantities/ABDO>, <https://si-digital-framework.org/quantities/ABDO>;
  qudt:symbol "D", "D";
  qudt:isoNormativeReference "http://www.iso.org/iso/catalogue_detail?csnumber=31895"^^xsd:anyURI,
    "http://www.iso.org/iso/catalogue_detail?csnumber=31895"^^xsd:anyURI;
  qudt:latexDefinition "$D = \\frac{d\\bar{\\varepsilon}}{dm}$, where $d\\bar{\\varepsilon}$ is the mean energy imparted by ionizing radiation to an element of irradiated matter with the mass $dm$."^^qudt:LatexString,
    "$D = \\frac{d\\bar{\\varepsilon}}{dm}$, where $d\\bar{\\varepsilon}$ is the mean energy imparted by ionizing radiation to an element of irradiated matter with the mass $dm$."^^qudt:LatexString;
  qudt:applicableUnit unit:CentiGRAY, unit:CentiGRAY, unit:GRAY, unit:GRAY, unit:KiloGRAY,
    unit:KiloGRAY, unit:MegaGRAY, unit:MegaGRAY, unit:MicroGRAY, unit:MicroGRAY, unit:MilliGRAY,
    unit:MilliGRAY, unit:MilliRAD_R, unit:MilliRAD_R, unit:RAD_R, unit:RAD_R, unit:NanoGRAY .

quantitykind:Kerma a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "Kerma"@en, "Kerma"@en;
  rdfs:comment "Applicable units are those of quantitykind:Kerma", "Applicable units are those of quantitykind:Kerma";
  dct:description "\"Kerma\" is the sum of the initial kinetic energies of all the charged particles liberated by uncharged ionizing radiation (i.e., indirectly ionizing radiation such as photons and neutrons) in a sample of matter, divided by the mass of the sample."^^qudt:LatexString,
    "\"Kerma\" is the sum of the initial kinetic energies of all the charged particles liberated by uncharged ionizing radiation (i.e., indirectly ionizing radiation such as photons and neutrons) in a sample of matter, divided by the mass of the sample."^^qudt:LatexString;
  skos:broader quantitykind:SpecificEnergy, quantitykind:SpecificEnergy;
  qudt:hasDimensionVector dimensionvector:A0E0L2I0M0H0T-2D0, dimensionvector:A0E0L2I0M0H0T-2D0;
  qudt:informativeReference "http://en.wikipedia.org/wiki/Kerma_(physics)"^^xsd:anyURI,
    "http://en.wikipedia.org/wiki/Kerma_(physics)"^^xsd:anyURI;
  qudt:symbol "K", "K";
  qudt:isoNormativeReference "http://www.iso.org/iso/catalogue_detail?csnumber=31895"^^xsd:anyURI,
    "http://www.iso.org/iso/catalogue_detail?csnumber=31895"^^xsd:anyURI;
  qudt:plainTextDescription "\"Kerma\" is the sum of the initial kinetic energies of all the charged particles liberated by uncharged ionizing radiation (i.e., indirectly ionizing radiation such as photons and neutrons) in a sample of matter, divided by the mass of the sample.",
    "\"Kerma\" is the sum of the initial kinetic energies of all the charged particles liberated by uncharged ionizing radiation (i.e., indirectly ionizing radiation such as photons and neutrons) in a sample of matter, divided by the mass of the sample.";
  qudt:latexDefinition "For indirectly ionizing (uncharged) particles, $K= \\frac{dE_{tr}}{dm}$, where $dE_{tr}$ is the mean sum of the initial kinetic energies of all the charged ionizing particles liberated by uncharged ionizing particles in an element of matter, and $dm$ is the mass of that element."^^qudt:LatexString,
    "For indirectly ionizing (uncharged) particles, $K= \\frac{dE_{tr}}{dm}$, where $dE_{tr}$ is the mean sum of the initial kinetic energies of all the charged ionizing particles liberated by uncharged ionizing particles in an element of matter, and $dm$ is the mass of that element."^^qudt:LatexString;
  qudt:applicableUnit unit:CentiGRAY, unit:CentiGRAY, unit:GRAY, unit:GRAY, unit:KiloGRAY,
    unit:KiloGRAY, unit:MegaGRAY, unit:MegaGRAY, unit:NanoGRAY .

