quantitykind:SpecificOpticalRotationalAbility a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "specific optical rotational ability", "specific optical rotational ability",
    "specific optical rotational ability"@en-US, "specific optical rotational ability"@en-US;
