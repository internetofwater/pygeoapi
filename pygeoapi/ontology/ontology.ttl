  <http://qudt.org/schema/qudt/symbol> "μmol²/(m⁴·s²)";
  <http://qudt.org/schema/qudt/ucumCode> "umol2.m-4.s-2"^^<http://qudt.org/schema/qudt/UCUMcs>;
  <http://qudt.org/schema/qudt/plainTextDescription> "NEON variance for a molar flux density, (uM/m^2/s)^2 ."@en .

<http://qudt.org/vocab/dimensionvector/A2E0L-4I0M0H0T-2D0> a <http://qudt.org/schema/qudt/QuantityKindDimensionVector_SI>,
    <http://qudt.org/schema/qudt/QuantityKindDimensionVector_ISO>, <http://qudt.org/schema/qudt/QuantityKindDimensionVector_Imperial>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/dimensionvector>;
  rdfs:label "qkdv:A2E0L-4I0M0H0T-2D0";
  <http://qudt.org/schema/qudt/dimensionExponentForAmountOfSubstance> 2;
  <http://qudt.org/schema/qudt/dimensionExponentForElectricCurrent> 0;
  <http://qudt.org/schema/qudt/dimensionExponentForLength> -4;
  <http://qudt.org/schema/qudt/dimensionExponentForLuminousIntensity> 0;
  <http://qudt.org/schema/qudt/dimensionExponentForMass> 0;
