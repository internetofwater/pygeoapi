quantitykind:EnergyDensity a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "Energy Density"@en, "Energy Density"@en;
  rdfs:comment "Applicable units are those of quantitykind:EnergyDensity", "Applicable units are those of quantitykind:EnergyDensity";
  dct:description """
  Energy density is defined as energy per unit volume. 
  The SI unit for energy density is the joule per cubic meter.
  """^^qudt:LatexString,
    """
  Energy density is defined as energy per unit volume. 
  The SI unit for energy density is the joule per cubic meter.
  """^^qudt:LatexString;
  qudt:dbpediaMatch "http://dbpedia.org/resource/Energy_density"^^xsd:anyURI, "http://dbpedia.org/resource/Energy_density"^^xsd:anyURI;
