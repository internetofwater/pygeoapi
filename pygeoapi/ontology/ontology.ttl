unit:ARCSEC a qudt:DerivedUnit,
        qudt:Unit ;
    rdfs:label "ArcSecond"@en,
        "Arcsecond"@en ;
    dct:description "\"Arc Second\" is a unit of angular measure, also called the $\\textit{second of arc}$, equal to $1/60 \\; arcminute$. One arcsecond is a very small angle: there are 1,296,000 in a circle. The SI recommends $\\textit{double prime}$ ($''$) as the symbol for the arcsecond. The symbol has become common in astronomy, where very small angles are stated in milliarcseconds ($mas$)."^^qudt:LatexString ;
    qudt:applicableSystem <http://qudt.org/vocab/sou/USCS> ;
    qudt:conversionMultiplier 0.00000484813681 ;
    qudt:conversionMultiplierSN 4.848137e-06 ;
    qudt:definedUnitOfSystem <http://qudt.org/vocab/sou/USCS> ;
    qudt:hasDimensionVector dimensionvector:A0E0L0I0M0H0T0D1 ;
    qudt:hasQuantityKind quantitykind:Angle,
        quantitykind:PlaneAngle ;
    qudt:iec61360Code "0112/2///62720#UAA096" ;
