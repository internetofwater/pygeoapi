    unit:CAL_TH-PER-MIN, unit:CAL_TH-PER-MIN, unit:CAL_TH-PER-SEC, unit:CAL_TH-PER-SEC,
    unit:KiloBTU_IT-PER-HR, unit:KiloBTU_IT-PER-HR, unit:KiloBTU_TH-PER-HR, unit:KiloBTU_TH-PER-HR,
