            qudt:hasUnit unit:ONE ],
        [ qudt:exponent -1 ;
            qudt:hasUnit unit:ONE ],
        [ qudt:exponent 1 ;
            qudt:hasUnit unit:ONE ],
        [ qudt:exponent -1 ;
            qudt:hasUnit unit:ONE ],
        [ qudt:exponent 1 ;
            qudt:hasUnit unit:ONE ] ;
