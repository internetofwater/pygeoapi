        unit:PlanckPower,
        unit:THM_US-PER-HR,
        unit:TON_FG,
        unit:TeraJ-PER-SEC,
        unit:TeraW,
        unit:TeraW-HR-PER-YR,
        unit:W ;
    qudt:hasDimensionVector dimensionvector:A0E0L2I0M1H0T-3D0 ;
    qudt:latexDefinition "$p = ui$, where $u$ is instantaneous voltage and $i$ is instantaneous electric current."^^qudt:LatexString ;
