    unit:DEG, unit:GON, unit:GRAD, unit:MIL, unit:MicroRAD, unit:MilliARCSEC, unit:MilliRAD,
    unit:RAD, unit:REV .

<http://qudt.org/vocab/quantitykind/BandwidthDistanceProduct> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "bandwidth distance product";
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L1I0M0H0T-1D0>;
  <http://qudt.org/schema/qudt/iec61360Code> "0112/2///62720#UAD016";
  <http://qudt.org/schema/qudt/informativeReference> "https://cdd.iec.ch/cdd/iec61987/iec61987.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD016"^^xsd:anyURI .

<http://qudt.org/vocab/quantitykind/BandwidthLengthProduct> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "bandwidth length product"@en-US;
  dct:description "parameter of transmission media for determination of frequency and length restrictions as reciprocal value of the multimode distortion corresponding to the product of maximum pulse frequency and maximum transmission distance"@en;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L1I0M0H0T-1D0>;
  <http://qudt.org/schema/qudt/symbol> "0173-1#Z4-BAJ293#003";
  <http://qudt.org/schema/qudt/plainTextDescription> "Parameter von Übertragungsmedien zur Bestimmung der Frequenz- und Längenrestriktionen als reziproke Wert der Modendispersion entsprechend dem Produkt aus maximaler Impulsfrequenz mal maximaler Übertragungsstrecke"@de .

<http://qudt.org/vocab/quantitykind/BendingMomentOfForce> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Bending Moment of Force"@en;
  rdfs:comment "Applicable units are those of quantitykind:Torque";
  dct:description "A bending moment exists in a structural element when a moment is applied to the element so that the element bends. It is the component of moment of force perpendicular to the longitudinal axis of a beam or a shaft."^^<http://qudt.org/schema/qudt/LatexString>;
  skos:broader <http://qudt.org/vocab/quantitykind/Torque>;
  <http://qudt.org/schema/qudt/dbpediaMatch> "http://dbpedia.org/resource/Torque"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L2I0M1H0T-2D0>;
  <http://qudt.org/schema/qudt/informativeReference> "http://en.wikipedia.org/wiki/Bending_moment"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/symbol> "M_b";
  <http://qudt.org/schema/qudt/isoNormativeReference> "http://www.iso.org/iso/catalogue_detail?csnumber=31889"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/plainTextDescription> "A bending moment exists in a structural element when a moment is applied to the element so that the element bends. It is the component of moment of force perpendicular to the longitudinal axis of a beam or a shaft.";
  <http://qudt.org/schema/qudt/latexDefinition> "$M_b = M \\cdot e_Q$, where $M$ is the momentof force and $e_Q$ is a unit vector directed along a $Q-axis$ with respect to which the torque is considered."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/applicableUnit> unit:CentiN-M, unit:DYN-CentiM, unit:DYN-M,
    unit:DeciN-M, unit:FT-LB_F, unit:IN-PDL, unit:N-M, unit:KiloGM_F-M, unit:KiloN-M,
    unit:LB_F-FT, unit:LB_F-IN, unit:MegaN-M, unit:MicroN-M, unit:MilliN-M, unit:N-CentiM,
    unit:OZ_F-IN, unit:PDL-FT, unit:PDL-IN .

<http://qudt.org/vocab/quantitykind/BetaDisintegrationEnergy> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Beta Disintegration Energy"@en;
  rdfs:comment "Applicable units are those of quantitykind:Energy";
  dct:description "\"Beta Disintegration Energy\" is the  energy released by a beta particle radioactive decay. It is the sum of the maximum beta-particle kinetic energy and the recoil energy of the atom produced in the reference frame in which the emitting nucleus is at rest before its disintegration."^^<http://qudt.org/schema/qudt/LatexString>;
  skos:broader <http://qudt.org/vocab/quantitykind/Energy>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L2I0M1H0T-2D0>;
  <http://qudt.org/schema/qudt/informativeReference> "http://en.wikipedia.org/wiki/Decay_energy"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/symbol> "Qᵦ";
  <http://qudt.org/schema/qudt/plainTextDescription> "\"Beta Disintegration Energy\" is the  energy released by a beta particle radioactive decay. It is the sum of the maximum beta-particle kinetic energy and the recoil energy of the atom produced in the reference frame in which the emitting nucleus is at rest before its disintegration.";
  <http://qudt.org/schema/qudt/applicableUnit> unit:AttoJ, unit:BTU_IT, unit:BTU_TH,
    unit:CAL_IT, unit:CAL_TH, unit:ERG, unit:EV, unit:E_h, unit:ExaJ, unit:FT-LB_F, unit:FT-PDL,
    unit:FemtoJ, unit:GigaEV, unit:GigaJ, unit:GigaW-HR, unit:J, unit:KiloBTU_IT, unit:KiloBTU_TH,
    unit:KiloCAL, unit:KiloEV, unit:KiloJ, unit:KiloV-A-HR, unit:KiloV-A_Reactive-HR,
    unit:KiloW-HR, unit:MegaEV, unit:MegaJ, unit:MegaTOE, unit:MegaV-A-HR, unit:MegaV-A_Reactive-HR,
    unit:MegaW-HR, unit:MicroJ, unit:MilliJ, unit:NanoJ, unit:PetaJ, unit:PicoJ, unit:PlanckEnergy,
    unit:QUAD, unit:THERM_EC, unit:THM_EEC, unit:THERM_US, unit:THM_US, unit:TOE, unit:TeraJ,
    unit:TeraW-HR, unit:TonEnergy, unit:V-A-HR, unit:V-A_Reactive-HR, unit:W-HR, unit:W-SEC;
  <http://qudt.org/schema/qudt/normativeReference> "http://www.iso.org/iso/catalogue_detail?csnumber=31895"^^xsd:anyURI .

<http://qudt.org/vocab/quantitykind/BevelGearPitchAngle> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Bevel Gear Pitch Angle"@en;
  rdfs:comment "Applicable units are those of quantitykind:Angle";
  dct:description "Pitch angle in bevel gears is the angle between an element of a pitch cone and its axis. In external and internal bevel gears, the pitch angles are respectively less than and greater than 90 degrees."^^<http://qudt.org/schema/qudt/LatexString>;
  skos:broader <http://qudt.org/vocab/quantitykind/Angle>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1>;
  <http://qudt.org/schema/qudt/plainTextDescription> "Pitch angle in bevel gears is the angle between an element of a pitch cone and its axis. In external and internal bevel gears, the pitch angles are respectively less than and greater than 90 degrees.";
  <http://qudt.org/schema/qudt/latexSymbol> "$\\theta$"^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/applicableUnit> unit:ARCMIN, unit:MIN_Angle, unit:ARCSEC,
    unit:DEG, unit:GON, unit:GRAD, unit:MIL, unit:MicroRAD, unit:MilliARCSEC, unit:MilliRAD,
    unit:RAD, unit:REV .

<http://qudt.org/vocab/quantitykind/BiogeochemicalRate> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Biogeochemical Rate"@en;
