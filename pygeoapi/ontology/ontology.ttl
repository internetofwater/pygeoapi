unit:RAD-PER-MIN a qudt:Unit ;
    rdfs:label "Radian per Minute"@en ;
    dct:description "Radian Per Minute (rad/min) is a unit in the category of Angular velocity. It is also known as radians per minute, radian/minute. Radian Per Minute (rad/min) has a dimension of aT-1 where $T$ is time. It can be converted to the corresponding standard SI unit rad/s by multiplying its value by a factor of 0.0166666666667. "^^rdf:HTML ;
    qudt:applicableSystem <http://qudt.org/vocab/sou/CGS>,
        <http://qudt.org/vocab/sou/CGS-EMU>,
        <http://qudt.org/vocab/sou/CGS-GAUSS>,
        <http://qudt.org/vocab/sou/SI> ;
    qudt:conversionMultiplier 0.01666666666666666666666666666666667,
        0.016666666666666666666667 ;
    qudt:conversionMultiplierSN 1.666667e-02 ;
    qudt:expression "$rad/m$"^^qudt:LatexString ;
    qudt:hasDimensionVector dimensionvector:A0E0L0I0M0H0T-1D0 ;
    qudt:hasFactorUnit [ qudt:exponent -1 ;
            qudt:hasUnit unit:MIN ],
        [ qudt:exponent 1 ;
            qudt:hasUnit unit:RAD ],
        [ qudt:exponent -1 ;
            qudt:hasUnit unit:MIN ],
        [ qudt:exponent 1 ;
            qudt:hasUnit unit:RAD ],
        [ qudt:exponent -1 ;
            qudt:hasUnit unit:MIN ],
        [ qudt:exponent 1 ;
            qudt:hasUnit unit:RAD ] ;
    qudt:hasQuantityKind quantitykind:AngularFrequency,
        quantitykind:AngularVelocity ;
    qudt:symbol "rad/min" ;
    qudt:ucumCode "rad.min-1"^^qudt:UCUMcs,
        "rad/min"^^qudt:UCUMcs ;
    rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/unit>,
        <http://qudt.org/vocab/unit> .

