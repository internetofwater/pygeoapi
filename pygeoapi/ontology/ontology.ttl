<http://qudt.org/vocab/quantitykind/Resistance> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:seeAlso <http://qudt.org/vocab/quantitykind/ElectricCurrent>, <http://qudt.org/vocab/quantitykind/Impedance>,
