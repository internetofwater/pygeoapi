unit:NAT a <http://qudt.org/schema/qudt/Unit>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/unit>;
  rdfs:label "Nat"@en;
  dct:description "A nat is a logarithmic unit of information or entropy, based on natural logarithms and powers of e, rather than the powers of 2 and base 2 logarithms which define the bit. The nat is the natural unit for information entropy. Physical systems of natural units which normalize Boltzmann's constant to 1 are effectively measuring thermodynamic entropy in nats."^^rdf:HTML;
  <http://qudt.org/schema/qudt/applicableSystem> <http://qudt.org/vocab/sou/CGS-EMU>,
    <http://qudt.org/vocab/sou/CGS-GAUSS>, <http://qudt.org/vocab/sou/PLANCK>, <http://qudt.org/vocab/sou/SI>,
    <http://qudt.org/vocab/sou/CGS>, <http://qudt.org/vocab/sou/IMPERIAL>, <http://qudt.org/vocab/sou/CGS-ESU>,
    <http://qudt.org/vocab/sou/ASU>;
  <http://qudt.org/schema/qudt/conversionMultiplier> 1.0;
  <http://qudt.org/schema/qudt/conversionMultiplierSN> 1.0E0;
  <http://qudt.org/schema/qudt/dbpediaMatch> "http://dbpedia.org/resource/Nat"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1>;
  <http://qudt.org/schema/qudt/hasQuantityKind> <http://qudt.org/vocab/quantitykind/InformationEntropy>;
  <http://qudt.org/schema/qudt/iec61360Code> "0112/2///62720#UAB345";
  <http://qudt.org/schema/qudt/informativeReference> "http://en.wikipedia.org/wiki/Nat?oldid=474010287"^^xsd:anyURI,
    "https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAB345"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/symbol> "nat";
  <http://qudt.org/schema/qudt/uneceCommonCode> "Q16" .

unit:NAT-PER-SEC a <http://qudt.org/schema/qudt/Unit>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/unit>;
  rdfs:label "Nat per Second"@en;
  dct:description "\"Nat per Second\" is information rate in natural units."^^rdf:HTML;
  <http://qudt.org/schema/qudt/conversionMultiplier> 1.0;
  <http://qudt.org/schema/qudt/conversionMultiplierSN> 1.0E0;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T-1D0>;
  <http://qudt.org/schema/qudt/hasQuantityKind> <http://qudt.org/vocab/quantitykind/InformationFlowRate>;
  <http://qudt.org/schema/qudt/iec61360Code> "0112/2///62720#UAB348";
  <http://qudt.org/schema/qudt/informativeReference> "http://en.wikipedia.org/wiki/Nat?oldid=474010287"^^xsd:anyURI,
    "https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAB348"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/symbol> "nat/s";
  <http://qudt.org/schema/qudt/uneceCommonCode> "Q19";
  <http://qudt.org/schema/qudt/expression> "$nat-per-sec$"^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/isoNormativeReference> "http://www.iso.org/iso/catalogue_detail?csnumber=31898"^^xsd:anyURI .

unit:NP a <http://qudt.org/schema/qudt/Unit>, <http://qudt.org/schema/qudt/DimensionlessUnit>,
    <http://qudt.org/schema/qudt/LogarithmicUnit>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/unit>;
  rdfs:label "Neper"@en;
  dct:description "The neper is a logarithmic unit for ratios of measurements of physical field and power quantities, such as gain and loss of electronic signals. It has the unit symbol Np. The unit's name is derived from the name of John Napier, the inventor of logarithms. As is the case for the decibel and bel, the neper is not a unit in the International System of Units (SI), but it is accepted for use alongside the SI. Like the decibel, the neper is a unit in a logarithmic scale. While the bel uses the decadic (base-10) logarithm to compute ratios, the neper uses the natural logarithm, based on Euler's number"^^rdf:HTML;
  <http://qudt.org/schema/qudt/applicableSystem> <http://qudt.org/vocab/sou/SI>;
  <http://qudt.org/schema/qudt/dbpediaMatch> "http://dbpedia.org/resource/Neper"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1>;
  <http://qudt.org/schema/qudt/hasQuantityKind> <http://qudt.org/vocab/quantitykind/Dimensionless>;
  <http://qudt.org/schema/qudt/iec61360Code> "0112/2///62720#UAA253";
  <http://qudt.org/schema/qudt/informativeReference> "https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAA253"^^xsd:anyURI,
    "https://en.wikipedia.org/wiki/Neper"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/siExactMatch> <https://si-digital-framework.org/SI/units/neper>;
  <http://qudt.org/schema/qudt/symbol> "Np";
  <http://qudt.org/schema/qudt/ucumCode> "Np"^^<http://qudt.org/schema/qudt/UCUMcs>;
  <http://qudt.org/schema/qudt/uneceCommonCode> "C50" .

unit:NP-PER-SEC a <http://qudt.org/schema/qudt/Unit>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/unit>;
  rdfs:label "neper per second";
  dct:description "unit neper divided by the SI base unit second";
  <http://qudt.org/schema/qudt/conversionMultiplier> 1.0;
  <http://qudt.org/schema/qudt/conversionMultiplierSN> 1.0E0;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T-1D0>;
  <http://qudt.org/schema/qudt/hasQuantityKind> <http://qudt.org/vocab/quantitykind/Unknown>;
  <http://qudt.org/schema/qudt/iec61360Code> "0112/2///62720#UAA254";
  <http://qudt.org/schema/qudt/informativeReference> "https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAA254"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/symbol> "Np/s";
  <http://qudt.org/schema/qudt/ucumCode> "Np.s-1"^^<http://qudt.org/schema/qudt/UCUMcs>,
    "Np/s"^^<http://qudt.org/schema/qudt/UCUMcs>;
  <http://qudt.org/schema/qudt/uneceCommonCode> "C51" .

unit:NT a <http://qudt.org/schema/qudt/Unit>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/unit>;
  rdfs:seeAlso unit:TON_Register;
  rdfs:label "Net tonnage"@en;
  <http://qudt.org/schema/qudt/applicableSystem> <http://qudt.org/vocab/sou/USCS>;
  <http://qudt.org/schema/qudt/conversionMultiplier> 0.0;
  <http://qudt.org/schema/qudt/conversionMultiplierSN> 0.0E0;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L3I0M0H0T0D0>;
  <http://qudt.org/schema/qudt/hasQuantityKind> <http://qudt.org/vocab/quantitykind/Volume>;
  <http://qudt.org/schema/qudt/informativeReference> "http://en.wikipedia.org/wiki/Net_tonnage"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/symbol> "NT";
  <http://qudt.org/schema/qudt/plainTextDescription> """Net tonnage is used in the United States to determine eligibility for registering boats with 
 the federal government. It is a nonlinear unit derived from the total volume of a ship's cargo space as well as some 
 dimensionless factors. Net tonnage is not a measure of the weight of the ship or its cargo, and should not be confused 
 with terms such as deadweight tonnage or displacement. Net tonnage is also used to determine the amount of money that 
 can be charged to a ship for using a port's facilities.""" .

unit:NTU a <http://qudt.org/schema/qudt/Unit>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/unit>;
  rdfs:label "Nephelometry Turbidity Unit"@en;
  dct:description "\"Nephelometry Turbidity Unit\" is a C.G.S System unit for  'Turbidity' expressed as $NTU$."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/applicableSystem> <http://qudt.org/vocab/sou/CGS>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1>;
  <http://qudt.org/schema/qudt/hasQuantityKind> <http://qudt.org/vocab/quantitykind/Turbidity>;
  <http://qudt.org/schema/qudt/symbol> "NTU" .

<http://qudt.org/vocab/quantitykind/Turbidity> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Turbidity"@en;
  rdfs:comment "Applicable units are those of quantitykind:Turbidity";
  dct:description "Turbidity is the cloudiness or haziness of a fluid, or of air, caused by individual particles (suspended solids) that are generally invisible to the naked eye, similar to smoke in air. Turbidity in open water is often caused by phytoplankton and the measurement of turbidity is a key test of water quality. The higher the turbidity, the higher the risk of the drinkers developing gastrointestinal diseases, especially for immune-compromised people, because contaminants like virus or bacteria can become attached to the suspended solid. The suspended solids interfere with water disinfection with chlorine because the particles act as shields for the virus and bacteria. Similarly suspended solids can protect bacteria from UV sterilisation of water. Fluids can contain suspended solid matter consisting of particles of many different sizes. While some suspended material will be large enough and heavy enough to settle rapidly to the bottom container if a liquid sample is left to stand (the settleable solids), very small particles will settle only very slowly or not at all if the sample is regularly agitated or the particles are colloidal. These small solid particles cause the liquid to appear turbid."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/dbpediaMatch> "http://dbpedia.org/resource/Turbidity"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1>;
  <http://qudt.org/schema/qudt/informativeReference> "http://en.wikipedia.org/wiki/Turbidity"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/plainTextDescription> "Turbidity is the cloudiness or haziness of a fluid, or of air, caused by individual particles (suspended solids) that are generally invisible to the naked eye, similar to smoke in air. Turbidity in open water is often caused by phytoplankton and the measurement of turbidity is a key test of water quality. The higher the turbidity, the higher the risk of the drinkers developing gastrointestinal diseases, especially for immune-compromised people, because contaminants like virus or bacteria can become attached to the suspended solid. The suspended solids interfere with water disinfection with chlorine because the particles act as shields for the virus and bacteria. Similarly suspended solids can protect bacteria from UV sterilisation of water. Fluids can contain suspended solid matter consisting of particles of many different sizes. While some suspended material will be large enough and heavy enough to settle rapidly to the bottom container if a liquid sample is left to stand (the settleable solids), very small particles will settle only very slowly or not at all if the sample is regularly agitated or the particles are colloidal. These small solid particles cause the liquid to appear turbid.";
  <http://qudt.org/schema/qudt/applicableUnit> unit:NTU .

unit:NUM a <http://qudt.org/schema/qudt/Unit>, <http://qudt.org/schema/qudt/CountingUnit>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/unit>;
  rdfs:label "Number"@en;
  dct:description "\"Number\" is a unit for  'Dimensionless' expressed as (\\#$."^^rdf:HTML;
  <http://qudt.org/schema/qudt/applicableSystem> <http://qudt.org/vocab/sou/CGS-EMU>,
    <http://qudt.org/vocab/sou/CGS-GAUSS>, <http://qudt.org/vocab/sou/PLANCK>, <http://qudt.org/vocab/sou/SI>,
    <http://qudt.org/vocab/sou/CGS>, <http://qudt.org/vocab/sou/IMPERIAL>, <http://qudt.org/vocab/sou/CGS-ESU>,
    <http://qudt.org/vocab/sou/ASU>;
  <http://qudt.org/schema/qudt/conversionMultiplier> 1.0;
  <http://qudt.org/schema/qudt/conversionMultiplierSN> 1.0E0;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1>;
  <http://qudt.org/schema/qudt/hasQuantityKind> <http://qudt.org/vocab/quantitykind/Dimensionless>,
    <http://qudt.org/vocab/quantitykind/DimensionlessRatio>, <http://qudt.org/vocab/quantitykind/OpeningRatio>,
    <http://qudt.org/vocab/quantitykind/ChargeNumber>, <http://qudt.org/vocab/quantitykind/CoefficientOfPerformance>,
    <http://qudt.org/vocab/quantitykind/Count>, <http://qudt.org/vocab/quantitykind/FrictionCoefficient>,
    <http://qudt.org/vocab/quantitykind/HyperfineStructureQuantumNumber>, <http://qudt.org/vocab/quantitykind/IonTransportNumber>,
    <http://qudt.org/vocab/quantitykind/Landau-GinzburgNumber>, <http://qudt.org/vocab/quantitykind/MagneticQuantumNumber>,
    <http://qudt.org/vocab/quantitykind/MassNumber>, <http://qudt.org/vocab/quantitykind/NeutronNumber>,
    <http://qudt.org/vocab/quantitykind/NuclearSpinQuantumNumber>, <http://qudt.org/vocab/quantitykind/NucleonNumber>,
    <http://qudt.org/vocab/quantitykind/OrbitalAngularMomentumQuantumNumber>, <http://qudt.org/vocab/quantitykind/Population>,
    <http://qudt.org/vocab/quantitykind/PrincipalQuantumNumber>, <http://qudt.org/vocab/quantitykind/QuantumNumber>,
    <http://qudt.org/vocab/quantitykind/ReynoldsNumber>, <http://qudt.org/vocab/quantitykind/SpinQuantumNumber>,
    <http://qudt.org/vocab/quantitykind/StoichiometricNumber>, <http://qudt.org/vocab/quantitykind/TotalAngularMomentumQuantumNumber>;
  <http://qudt.org/schema/qudt/symbol> "#";
  <http://qudt.org/schema/qudt/ucumCode> "1"^^<http://qudt.org/schema/qudt/UCUMcs>,
    "{#}"^^<http://qudt.org/schema/qudt/UCUMcs> .

<http://qudt.org/vocab/quantitykind/ChargeNumber> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Charge Number"@en;
  rdfs:comment "Applicable units are those of quantitykind:ChargeNumber";
  dct:description "The \"Charge Number\", or just valance of an ion is the coefficient that, when multiplied by the elementary charge, gives the ion's charge."^^<http://qudt.org/schema/qudt/LatexString>;
  skos:broader <http://qudt.org/vocab/quantitykind/Dimensionless>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1>;
  <http://qudt.org/schema/qudt/informativeReference> "http://en.wikipedia.org/wiki/Charge_number"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/symbol> "z";
  <http://qudt.org/schema/qudt/isoNormativeReference> "http://www.iso.org/iso/catalogue_detail?csnumber=31894"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/plainTextDescription> "The \"Charge Number\", or just valance of an ion is the coefficient that, when multiplied by the elementary charge, gives the ion's charge.";
  <http://qudt.org/schema/qudt/applicableUnit> unit:NUM .

<http://qudt.org/vocab/quantitykind/CoefficientOfPerformance> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "CoefficientOfPerformance"@en;
  rdfs:comment "Applicable units are those of quantitykind:CoefficientOfPerformance";
  dct:description "\"Coefficient of Performance\",is a measure of the efficiency of a heating or cooling system, defined as the ratio of useful heating or cooling output to the energy input required to achieve it."^^<http://qudt.org/schema/qudt/LatexString>;
  skos:broader <http://qudt.org/vocab/quantitykind/DimensionlessRatio>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1>;
  <http://qudt.org/schema/qudt/informativeReference> "https://en.wikipedia.org/wiki/Coefficient_of_performance#:~:text=The+coefficient+of+performance+or,and+thus+lower+operating+costs."^^xsd:anyURI;
  <http://qudt.org/schema/qudt/symbol> "COP";
  <http://qudt.org/schema/qudt/plainTextDescription> "\"\"Coefficient of Performance\",is a measure of the efficiency of a heating or cooling system, defined as the ratio of useful heating or cooling output to the energy input required to achieve it.";
  <http://qudt.org/schema/qudt/applicableUnit> unit:NUM;
  <http://qudt.org/schema/qudt/applicableSIUnit> unit:NUM .

<http://qudt.org/vocab/quantitykind/Count> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Count"@en;
  rdfs:comment "Applicable units are those of quantitykind:Count";
  dct:description "\"Count\" is the value of a count of items."^^<http://qudt.org/schema/qudt/LatexString>;
  skos:broader <http://qudt.org/vocab/quantitykind/Dimensionless>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1>;
  <http://qudt.org/schema/qudt/plainTextDescription> "\"Count\" is the value of a count of items.";
  <http://qudt.org/schema/qudt/applicableUnit> unit:NUM, unit:UNITLESS .

<http://qudt.org/vocab/quantitykind/FrictionCoefficient> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Friction Coefficient"@en;
  rdfs:comment "Applicable units are those of quantitykind:FrictionCoefficient";
  dct:description "\"Friction Coefficient\" is the ratio of the force of friction between two bodies and the force pressing them together"^^<http://qudt.org/schema/qudt/LatexString>;
  skos:broader <http://qudt.org/vocab/quantitykind/DimensionlessRatio>;
  <http://qudt.org/schema/qudt/dbpediaMatch> "http://dbpedia.org/resource/Friction"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1>;
  <http://qudt.org/schema/qudt/informativeReference> "http://en.wikipedia.org/wiki/Friction"^^xsd:anyURI,
    "http://wiki.answers.com/Q/What_is_the_symbol_of_friction"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/plainTextDescription> "\"Friction Coefficient\" is the ratio of the force of friction between two bodies and the force pressing them together";
  <http://qudt.org/schema/qudt/latexSymbol> "$\\mu$"^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/qkdvDenominator> <http://qudt.org/vocab/dimensionvector/A0E0L1I0M1H0T-2D0>;
  <http://qudt.org/schema/qudt/qkdvNumerator> <http://qudt.org/vocab/dimensionvector/A0E0L1I0M1H0T-2D0>;
  <http://qudt.org/schema/qudt/applicableUnit> unit:NUM, unit:UNITLESS .

<http://qudt.org/vocab/quantitykind/HyperfineStructureQuantumNumber> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Hyperfine Structure Quantum Number"@en;
  rdfs:comment "Applicable units are those of quantitykind:HyperfineStructureQuantumNumber";
  dct:description "The \"Hyperfine Structure Quantum Number\" is a quantum number of an atom describing inclination of the nuclear spin with respect to a quantization axis given by the magnetic field produced by the orbital electrons."^^<http://qudt.org/schema/qudt/LatexString>;
  skos:broader <http://qudt.org/vocab/quantitykind/QuantumNumber>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1>;
  <http://qudt.org/schema/qudt/informativeReference> "http://en.wikipedia.org/wiki/Hyperfine_structure"^^xsd:anyURI,
    "http://en.wikipedia.org/wiki/Quantum_number"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/symbol> "F";
  <http://qudt.org/schema/qudt/isoNormativeReference> "http://www.iso.org/iso/catalogue_detail?csnumber=31894"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/plainTextDescription> "The \"Hyperfine Structure Quantum Number\" is a quantum number of an atom describing inclination of the nuclear spin with respect to a quantization axis given by the magnetic field produced by the orbital electrons.";
  <http://qudt.org/schema/qudt/applicableUnit> unit:NUM .

<http://qudt.org/vocab/quantitykind/IonTransportNumber> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Ion Transport Number"@en;
  rdfs:comment "Applicable units are those of quantitykind:IonTransportNumber";
  dct:description "The \"Ion Transport Number\" is a quantity which indicates the different contribution of ions to the electric current in electrolytes due to different electrical mobility."^^<http://qudt.org/schema/qudt/LatexString>;
  skos:broader <http://qudt.org/vocab/quantitykind/DimensionlessRatio>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1>;
  <http://qudt.org/schema/qudt/informativeReference> "http://en.wikipedia.org/wiki/Ion_transport_number"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/symbol> "t_B";
  <http://qudt.org/schema/qudt/isoNormativeReference> "http://www.iso.org/iso/catalogue_detail?csnumber=31894"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/plainTextDescription> "The \"Ion Transport Number\" is a quantity which indicates the different contribution of ions to the electric current in electrolytes due to different electrical mobility.";
  <http://qudt.org/schema/qudt/latexDefinition> "$t_B = \\frac{i_B}{i}$, where $i_B$ is the electric current carried by the ion $B$ and $i$ is the total electric current."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/applicableUnit> unit:NUM .

<http://qudt.org/vocab/quantitykind/Landau-GinzburgNumber> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Landau-Ginzburg Number"@en;
  rdfs:comment "Applicable units are those of quantitykind:Landau-GinzburgNumber";
  dct:description "\"Landau-Ginzburg Number\", also known as the Ginzburg-Landau parameter, describes the relationship between London penetration depth and coherence length."^^<http://qudt.org/schema/qudt/LatexString>;
  skos:broader <http://qudt.org/vocab/quantitykind/DimensionlessRatio>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1>;
  <http://qudt.org/schema/qudt/informativeReference> "http://en.wikipedia.org/wiki/Ginzburg–Landau_theory"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/isoNormativeReference> "http://www.iso.org/iso/catalogue_detail?csnumber=31897"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/plainTextDescription> "\"Landau-Ginzburg Number\", also known as the Ginzburg-Landau parameter, describes the relationship between London penetration depth and coherence length.";
  <http://qudt.org/schema/qudt/latexSymbol> "$\\kappa$"^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/latexDefinition> "At zero thermodynamic temperature $\\kappa = \\frac{\\lambda_L}{(\\varepsilon\\sqrt{2})}$, where $\\lambda_L$ is London penetration depth and $\\varepsilon$ is coherence length."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/applicableUnit> unit:NUM .

<http://qudt.org/vocab/quantitykind/MagneticQuantumNumber> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Magnetic Quantum Number"@en;
  rdfs:comment "Applicable units are those of quantitykind:MagneticQuantumNumber";
  dct:description "The \"Magnetic Quantum Number\" describes the specific orbital (or \"cloud\") within that subshell, and yields the projection of the orbital angular momentum along a specified axis."^^<http://qudt.org/schema/qudt/LatexString>;
  skos:broader <http://qudt.org/vocab/quantitykind/QuantumNumber>;
  skos:closeMatch <http://qudt.org/vocab/quantitykind/OrbitalAngularMomentumQuantumNumber>,
    <http://qudt.org/vocab/quantitykind/PrincipalQuantumNumber>, <http://qudt.org/vocab/quantitykind/SpinQuantumNumber>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1>;
  <http://qudt.org/schema/qudt/informativeReference> "http://en.wikipedia.org/wiki/Quantum_number"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/symbol> "m";
  <http://qudt.org/schema/qudt/isoNormativeReference> "http://www.iso.org/iso/catalogue_detail?csnumber=31894"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/plainTextDescription> "The \"Magnetic Quantum Number\" describes the specific orbital (or \"cloud\") within that subshell, and yields the projection of the orbital angular momentum along a specified axis.";
  <http://qudt.org/schema/qudt/applicableUnit> unit:NUM .

<http://qudt.org/vocab/quantitykind/MassNumber> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Mass Number"@en;
  rdfs:comment "Applicable units are those of quantitykind:MassNumber";
  dct:description "The \"Mass Number\" (A), also called atomic mass number or nucleon number, is the total number of protons and neutrons (together known as nucleons) in an atomic nucleus. Nuclides with the same value of $A$ are called isobars."^^<http://qudt.org/schema/qudt/LatexString>;
  skos:broader <http://qudt.org/vocab/quantitykind/Count>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1>;
  <http://qudt.org/schema/qudt/informativeReference> "http://en.wikipedia.org/wiki/Mass_number"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/symbol> "A";
  <http://qudt.org/schema/qudt/isoNormativeReference> "http://www.iso.org/iso/catalogue_detail?csnumber=31895"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/latexDefinition> "$A = Z + N$, where $Z$ is the atomic number and $N$ is the neutron number."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/applicableUnit> unit:NUM .

<http://qudt.org/vocab/quantitykind/NeutronNumber> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Neutronenzahl"@de, "Neutronové číslo"@cs, "Nombor neutron"@ms, "Nombre de neutrons"@fr,
    "liczba neutronowa"@pl, "neutron number"@en, "numero neutronico"@it, "nötron snumarası"@tr,
    "número de neutrons"@pt, "número neutrónico"@es, "число нейтронов"@ru, "عدد النيوترونات"@ar,
    "عدد نوترون"@fa, "中子數"@zh;
  rdfs:comment "Applicable units are those of quantitykind:NeutronNumber";
  dct:description "\"Neutron Number\", symbol $N$, is the number of neutrons in a nuclide. Nuclides with the same value of $N$ but different values of $Z$ are called isotones. $N - Z$ is called the neutron excess number."^^<http://qudt.org/schema/qudt/LatexString>;
  skos:broader <http://qudt.org/vocab/quantitykind/Count>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1>;
  <http://qudt.org/schema/qudt/informativeReference> "http://www.iso.org/iso/home/store/catalogue_tc/catalogue_detail.htm?csnumber=31895"^^xsd:anyURI,
    "http://en.wikipedia.org/wiki/Neutron_number"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/symbol> "N";
  <http://qudt.org/schema/qudt/isoNormativeReference> "http://www.iso.org/iso/catalogue_detail?csnumber=31895"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/applicableUnit> unit:NUM .

<http://qudt.org/vocab/quantitykind/NuclearSpinQuantumNumber> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Spin Quantum Number"@en;
  rdfs:comment "Applicable units are those of quantitykind:NuclearSpinQuantumNumber";
  dct:description "The \"Spin Quantum Number\"  describes the spin (intrinsic angular momentum) of the electron within that orbital, and gives the projection of the spin angular momentum S along the specified axis"^^<http://qudt.org/schema/qudt/LatexString>;
  skos:broader <http://qudt.org/vocab/quantitykind/SpinQuantumNumber>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1>;
  <http://qudt.org/schema/qudt/informativeReference> "http://en.wikipedia.org/wiki/Quantum_number"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/symbol> "I";
  <http://qudt.org/schema/qudt/isoNormativeReference> "http://www.iso.org/iso/catalogue_detail?csnumber=31894"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/plainTextDescription> "The \"Spin Quantum Number\"  describes the spin (intrinsic angular momentum) of the electron within that orbital, and gives the projection of the spin angular momentum S along the specified axis";
  <http://qudt.org/schema/qudt/latexDefinition> "$I^2 = \\hbar^2 I(I + 1)$, where $\\hbar$ is the Planck constant."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/applicableUnit> unit:NUM .

<http://qudt.org/vocab/quantitykind/NucleonNumber> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Nombor nukleon"@ms, "Nukleonenzahl"@de, "Nukleové číslo"@cs, "liczba masowa"@pl,
    "nombre de masse"@fr, "nucleon number"@en, "numero di massa"@it, "número de massa"@pt,
    "número másico"@es, "nükleon numarası"@tr, "عدد جرمی"@fa, "عدد كتلي"@ar, "質量数"@ja,
    "质量数"@zh;
  rdfs:comment "Applicable units are those of quantitykind:NucleonNumber";
  dct:description "Number of nucleons in an atomic nucleus.A = Z+N. Nuclides with the same value of A are called isobars."^^<http://qudt.org/schema/qudt/LatexString>;
  skos:altLabel "Massenzahl"@de, "kütle numarası"@tr, "mass number"@en, "nombor jisim"@ms,
    "numero di nucleoni"@it;
  skos:broader <http://qudt.org/vocab/quantitykind/Count>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1>;
  <http://qudt.org/schema/qudt/informativeReference> "http://www.iso.org/iso/home/store/catalogue_tc/catalogue_detail.htm?csnumber=31895"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/symbol> "A";
  <http://qudt.org/schema/qudt/plainTextDescription> "Number of nucleons in an atomic nucleus.A = Z+N. Nuclides with the same value of A are called isobars.";
  <http://qudt.org/schema/qudt/applicableUnit> unit:NUM .

<http://qudt.org/vocab/quantitykind/OrbitalAngularMomentumQuantumNumber> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Orbital Angular Momentum Quantum Number"@en;
  rdfs:comment "Applicable units are those of quantitykind:OrbitalAngularMomentumQuantumNumber";
  dct:description "The \"Principal Quantum Number\" describes the electron shell, or energy level, of an atom. The value of $n$ ranges from 1 to the shell containing the outermost electron of that atom."^^<http://qudt.org/schema/qudt/LatexString>;
  skos:broader <http://qudt.org/vocab/quantitykind/QuantumNumber>;
  skos:closeMatch <http://qudt.org/vocab/quantitykind/MagneticQuantumNumber>, <http://qudt.org/vocab/quantitykind/PrincipalQuantumNumber>,
    <http://qudt.org/vocab/quantitykind/SpinQuantumNumber>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1>;
  <http://qudt.org/schema/qudt/informativeReference> "http://en.wikipedia.org/wiki/Quantum_number"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/symbol> "l";
  <http://qudt.org/schema/qudt/isoNormativeReference> "http://www.iso.org/iso/catalogue_detail?csnumber=31894"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/latexDefinition> "$l^2 = \\hbar^2 l(l + 1), l = 0, 1, ..., n - 1$, where $l_i$ refers to a specific particle $i$."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/applicableUnit> unit:NUM .

<http://qudt.org/vocab/quantitykind/Population> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Population"@en;
  rdfs:comment "Applicable units are those of quantitykind:Population";
  dct:description "Population typically refers to the number of people in a single area, whether it be a city or town, region, country, continent, or the world, but can also represent the number of any kind of entity."^^<http://qudt.org/schema/qudt/LatexString>;
  skos:broader <http://qudt.org/vocab/quantitykind/Count>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1>;
  <http://qudt.org/schema/qudt/informativeReference> "https://en.wikipedia.org/wiki/Population"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/plainTextDescription> "Population typically refers to the number of people in a single area, whether it be a city or town, region, country, continent, or the world, but can also represent the number of any kind of entity.";
  <http://qudt.org/schema/qudt/applicableUnit> unit:NUM .

<http://qudt.org/vocab/quantitykind/PrincipalQuantumNumber> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Principal Quantum Number"@en;
  rdfs:comment "Applicable units are those of quantitykind:PrincipalQuantumNumber";
  dct:description "The \"Principal Quantum Number\" describes the electron shell, or energy level, of an atom. The value of $n$ ranges from 1 to the shell containing the outermost electron of that atom."^^<http://qudt.org/schema/qudt/LatexString>;
  skos:broader <http://qudt.org/vocab/quantitykind/QuantumNumber>;
  skos:closeMatch <http://qudt.org/vocab/quantitykind/MagneticQuantumNumber>, <http://qudt.org/vocab/quantitykind/OrbitalAngularMomentumQuantumNumber>,
    <http://qudt.org/vocab/quantitykind/SpinQuantumNumber>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1>;
  <http://qudt.org/schema/qudt/informativeReference> "http://en.wikipedia.org/wiki/Quantum_number"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/symbol> "n";
  <http://qudt.org/schema/qudt/isoNormativeReference> "http://www.iso.org/iso/catalogue_detail?csnumber=31894"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/applicableUnit> unit:NUM .

<http://qudt.org/vocab/quantitykind/QuantumNumber> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Quantum Number"@en;
  rdfs:comment "Applicable units are those of quantitykind:QuantumNumber";
  dct:description "The \"Quantum Number\" describes values of conserved quantities in the dynamics of the quantum system. Perhaps the most peculiar aspect of quantum mechanics is the quantization of observable quantities, since quantum numbers are discrete sets of integers or half-integers."^^<http://qudt.org/schema/qudt/LatexString>;
  skos:broader <http://qudt.org/vocab/quantitykind/Dimensionless>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1>;
  <http://qudt.org/schema/qudt/informativeReference> "http://en.wikipedia.org/wiki/Quantum_number"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/symbol> "n";
  <http://qudt.org/schema/qudt/isoNormativeReference> "http://www.iso.org/iso/catalogue_detail?csnumber=31894"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/plainTextDescription> "The \"Quantum Number\" describes values of conserved quantities in the dynamics of the quantum system. Perhaps the most peculiar aspect of quantum mechanics is the quantization of observable quantities, since quantum numbers are discrete sets of integers or half-integers.";
  <http://qudt.org/schema/qudt/applicableUnit> unit:NUM .

<http://qudt.org/vocab/quantitykind/ReynoldsNumber> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Reynolds Number"@en;
  rdfs:comment "Applicable units are those of quantitykind:ReynoldsNumber";
  dct:description "The \"Reynolds Number\" (Re) is a dimensionless number that gives a measure of the ratio of inertial forces to viscous forces and consequently quantifies the relative importance of these two types of forces for given flow conditions."^^<http://qudt.org/schema/qudt/LatexString>;
  skos:broader <http://qudt.org/vocab/quantitykind/DimensionlessRatio>;
  skos:closeMatch <http://dbpedia.org/resource/Reynolds_number>;
  <http://qudt.org/schema/qudt/dbpediaMatch> "http://dbpedia.org/resource/Reynolds_number"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1>;
  <http://qudt.org/schema/qudt/informativeReference> "http://en.wikipedia.org/wiki/Reynolds_number"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/symbol> "Re";
  <http://qudt.org/schema/qudt/plainTextDescription> "The \"Reynolds Number\" (Re) is a dimensionless number that gives a measure of the ratio of inertial forces to viscous forces and consequently quantifies the relative importance of these two types of forces for given flow conditions.";
  <http://qudt.org/schema/qudt/latexDefinition> "$Re = \\frac{\\rho uL}{\\mu} = \\frac{uL}{\\nu}$, where $\\rho$ is mass density, $u$ is speed, $L$ is length,  $\\mu$ is dynamic viscosity, and $\\nu$ is kinematic viscosity."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/applicableUnit> unit:NUM;
  <http://qudt.org/schema/qudt/normativeReference> "http://www.iso.org/iso/catalogue_detail?csnumber=31896"^^xsd:anyURI .

<http://qudt.org/vocab/quantitykind/SpinQuantumNumber> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Spin Quantum Number"@en;
  rdfs:comment "Applicable units are those of quantitykind:SpinQuantumNumber";
  dct:description "The \"Spin Quantum Number\"  describes the spin (intrinsic angular momentum) of the electron within that orbital, and gives the projection of the spin angular momentum S along the specified axis"^^<http://qudt.org/schema/qudt/LatexString>;
  skos:broader <http://qudt.org/vocab/quantitykind/QuantumNumber>;
  skos:closeMatch <http://qudt.org/vocab/quantitykind/MagneticQuantumNumber>, <http://qudt.org/vocab/quantitykind/OrbitalAngularMomentumQuantumNumber>,
    <http://qudt.org/vocab/quantitykind/PrincipalQuantumNumber>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1>;
  <http://qudt.org/schema/qudt/iec61360Code> "0112/2///62720#UAD371";
  <http://qudt.org/schema/qudt/informativeReference> "http://en.wikipedia.org/wiki/Quantum_number"^^xsd:anyURI,
    "https://cdd.iec.ch/cdd/iec61987/iec61987.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD371"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/symbol> "s";
  <http://qudt.org/schema/qudt/isoNormativeReference> "http://www.iso.org/iso/catalogue_detail?csnumber=31894"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/plainTextDescription> "The \"Spin Quantum Number\"  describes the spin (intrinsic angular momentum) of the electron within that orbital, and gives the projection of the spin angular momentum S along the specified axis";
  <http://qudt.org/schema/qudt/latexDefinition> "$s^2 = \\hbar^2 s(s + 1)$, where $s$ is the spin quantum number and $\\hbar$ is the Planck constant."^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/applicableUnit> unit:NUM .

<http://qudt.org/vocab/quantitykind/StoichiometricNumber> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Stoichiometric Number"@en;
  rdfs:comment "Applicable units are those of quantitykind:StoichiometricNumber";
  dct:description "Chemical reactions, as macroscopic unit operations, consist of simply a very large number of elementary reactions, where a single molecule reacts with another molecule. As the reacting molecules (or moieties) consist of a definite set of atoms in an integer ratio, the ratio between reactants in a complete reaction is also in integer ratio. A reaction may consume more than one molecule, and the \"Stoichiometric Number\" counts this number, defined as positive for products (added) and negative for reactants (removed)."^^<http://qudt.org/schema/qudt/LatexString>;
  skos:broader <http://qudt.org/vocab/quantitykind/Dimensionless>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1>;
  <http://qudt.org/schema/qudt/informativeReference> "http://en.wikipedia.org/wiki/Stoichiometry"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/isoNormativeReference> "http://www.iso.org/iso/catalogue_detail?csnumber=31894"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/plainTextDescription> "Chemical reactions, as macroscopic unit operations, consist of simply a very large number of elementary reactions, where a single molecule reacts with another molecule. As the reacting molecules (or moieties) consist of a definite set of atoms in an integer ratio, the ratio between reactants in a complete reaction is also in integer ratio. A reaction may consume more than one molecule, and the \"Stoichiometric Number\" counts this number, defined as positive for products (added) and negative for reactants (removed).";
  <http://qudt.org/schema/qudt/latexSymbol> "$\\nu_B$"^^<http://qudt.org/schema/qudt/LatexString>;
  <http://qudt.org/schema/qudt/applicableUnit> unit:NUM .

<http://qudt.org/vocab/quantitykind/TotalAngularMomentumQuantumNumber> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Total Angular Momentum Quantum Number"@en;
  rdfs:comment "Applicable units are those of quantitykind:TotalAngularMomentumQuantumNumber";
  dct:description "The \"Total Angular Quantum Number\" describes the magnitude of total angular momentum $J$, where $j$ refers to a specific particle and $J$ is used for the whole system."^^<http://qudt.org/schema/qudt/LatexString>;
  skos:broader <http://qudt.org/vocab/quantitykind/QuantumNumber>;
  skos:closeMatch <http://qudt.org/vocab/quantitykind/MagneticQuantumNumber>, <http://qudt.org/vocab/quantitykind/PrincipalQuantumNumber>,
    <http://qudt.org/vocab/quantitykind/SpinQuantumNumber>;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1>;
  <http://qudt.org/schema/qudt/informativeReference> "http://en.wikipedia.org/wiki/Quantum_number"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/symbol> "j";
  <http://qudt.org/schema/qudt/isoNormativeReference> "http://www.iso.org/iso/catalogue_detail?csnumber=31894"^^xsd:anyURI;
  <http://qudt.org/schema/qudt/applicableUnit> unit:NUM .

unit:NUM-PER-CentiM-KiloYR a <http://qudt.org/schema/qudt/Unit>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/unit>;
  rdfs:label "Number per square centimetre thousand years"@en;
  <http://qudt.org/schema/qudt/conversionMultiplier> 0.000000003168808781402895023702689684893655;
  <http://qudt.org/schema/qudt/conversionMultiplierSN> 3.168808781402895023702689684893655E-9;
  <http://qudt.org/schema/qudt/hasDimensionVector> <http://qudt.org/vocab/dimensionvector/A0E0L-1I0M0H0T-1D0>;
  <http://qudt.org/schema/qudt/hasQuantityKind> <http://qudt.org/vocab/quantitykind/Unknown>;
  <http://qudt.org/schema/qudt/symbol> "#/(cm·1000 a)";
  <http://qudt.org/schema/qudt/ucumCode> "{#}.cm-2.ka-1"^^<http://qudt.org/schema/qudt/UCUMcs> .

<http://qudt.org/vocab/dimensionvector/A0E0L-1I0M0H0T-1D0> a <http://qudt.org/schema/qudt/QuantityKindDimensionVector_SI>,
    <http://qudt.org/schema/qudt/QuantityKindDimensionVector_CGS>, <http://qudt.org/schema/qudt/QuantityKindDimensionVector_ISO>,
    <http://qudt.org/schema/qudt/QuantityKindDimensionVector_Imperial>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/dimensionvector>;
