<https://water.sec.usace.army.mil/cda/reporting/projects#FloodStorage> a skos:Concept;
  rdfs:seeAlso "https://www.swd.usace.army.mil/Portals/42/docs/publicaffairs/Lake%20Project%20Fact%20Sheet.pdf"^^xsd:anyURI;
  skos:definition "[from Google AI]   the capacity of a reservoir or other structure to temporarily hold excess water during a flood event, releasing it at a controlled rate after the flood peak has passed"@en;
  skos:inScheme :conceptScheme_3e018a2a;
  skos:prefLabel "Flood Storage"@en;
  skos:hiddenLabel "Flood Storage"@en;
  skos:note "This controlled release helps to reduce the severity of downstream flooding by attenuating the flood's peak. "@en;
  skos:editorialNote "ac-ft"@en;
  skos:broader :c_b0cbf49d;
  skos:related <https://water.sec.usace.army.mil/cda/reporting/projects#ConservationStorage>;
  skos:broadMatch variablename:reservoirStorage;
  qudt:hasUnit unit:AC-FT .

