variablename:nacrite a skos:Concept;
  skos:definition "Nacrite Al2Si2O5(OH)4 is a clay mineral that is polymorphous (or polytypic) with kaolinite. It crystallizes in the monoclinic system. X-ray diffraction analysis is required for positive identification. Nacrite was first described in 1807 for an occurrence in Saxony, Germany. The name is from nacre in reference to the mother of pearl luster of nacrite masses.";
  skos:inScheme <http://vocabulary.odm2.org/variablename>;
  skos:topConceptOf <http://vocabulary.odm2.org/variablename>;
  skos:prefLabel "Nacrite";
  skos:note "Added to support Critical Zone Observatory (CZO) data use cases. ";
  skos:historyNote "Wikipedia";
  skos:exactMatch "https://en.wikipedia.org/wiki/Nacrite" .

