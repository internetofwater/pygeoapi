variablename:cesium a skos:Concept;
  skos:definition "Caesium (IUPAC spelling) or cesium (American spelling) is a chemical element with symbol Cs and atomic number 55. It is a soft, silvery-gold alkali metal with a melting point of 28.5 °C (83.3 °F), which makes it one of only five elemental metals that are liquid at or near room temperature.";
  skos:topConceptOf <http://vocabulary.odm2.org/variablename>;
  skos:prefLabel "Cesium";
  skos:note "Added to support Critical Zone Observatory (CZO) data use cases. ";
  skos:historyNote "Wikipedia";
  skos:exactMatch "https://en.wikipedia.org/wiki/Caesium" .

variablename:BOD5Nitrogenous a skos:Concept;
  skos:definition "5-day Nitrogenous Biochemical Oxygen Demand";
  skos:topConceptOf <http://vocabulary.odm2.org/variablename>;
  skos:prefLabel "BOD5, nitrogenous";
  skos:historyNote "Originally from the CUAHSI HIS VariableNameCV.  See: http://his.cuahsi.org/mastercvreg/edit_cv11.aspx?tbl=VariableNameCV." .

variablename:diameterAtBreastHeight a skos:Concept;
  skos:definition "Diameter at breast height, or DBH, is the standard for measuring trees. DBH refers to the tree diameter measured at 4.5 feet above the ground.";
  skos:topConceptOf <http://vocabulary.odm2.org/variablename>;
  skos:prefLabel "Diameter at breast height (DBH)";
  skos:note "Added to support Critical Zone Observatory (CZO) data use cases. ";
  skos:historyNote "Wikipedia";
  skos:exactMatch "https://en.wikipedia.org/wiki/Diameter_at_breast_height" .

variablename:phosphorusPentoxide a skos:Concept;
  skos:definition "Phosphorus pentoxide is a chemical compound with molecular formula P4O10 (with its common name derived from its empirical formula, P2O5). This white crystalline solid is the anhydride of phosphoric acid.";
  skos:topConceptOf <http://vocabulary.odm2.org/variablename>;
  skos:prefLabel "Phosphorus pentoxide";
  skos:note "Added to support Critical Zone Observatory (CZO) data use cases. ";
  skos:historyNote "Wikipedia";
  skos:exactMatch "https://en.wikipedia.org/wiki/Phosphorus_pentoxide" .

variablename:calciumDissolved a skos:Concept;
  skos:definition "Dissolved Calcium (Ca)", "Calcium is a chemical element with symbol Ca and atomic number 20. An alkaline earth metal, calcium is a reactive metal that forms a dark oxide-nitride layer when exposed to air. Its physical and chemical properties are most similar to its heavier homologues strontium and barium. It is the fifth most abundant element in Earth's crust and the third most abundant metal, after iron and aluminium. The most common calcium compound on Earth is calcium carbonate, found in limestone and the fossilised remnants of early sea life; gypsum, anhydrite, fluorite, and apatite are also sources of calcium. The name derives from Latin calx \"lime\", which was obtained from heating limestone.";
  skos:topConceptOf <http://vocabulary.odm2.org/variablename>;
  skos:prefLabel "Calcium, dissolved";
  skos:note "Added to support Critical Zone Observatory (CZO) data use cases. ";
  skos:historyNote "Originally from the CUAHSI HIS VariableNameCV.  See: http://his.cuahsi.org/mastercvreg/edit_cv11.aspx?tbl=VariableNameCV.",
    "Wikipedia";
  skos:exactMatch "https://en.wikipedia.org/wiki/Calcium" .

variablename:samariumDissolved a skos:Concept;
  skos:definition "Dissolved Samarium (Sm). \"Dissolved \" indicates a the measurement was made on a filtered sample.";
  skos:topConceptOf <http://vocabulary.odm2.org/variablename>;
  skos:prefLabel "Samarium, dissolved";
  skos:note "Added to support Critical Zone Observatory (CZO) data use cases. ";
  skos:historyNote "Wikipedia";
  skos:exactMatch "https://en.wikipedia.org/wiki/Samarium" .

variablename:soilOrganicMatter a skos:Concept;
  skos:definition "Soil organic matter (SOM) is the organic matter component of soil, consisting of plant and animal residues at various stages of decomposition, cells and tissues of soil organisms, and substances synthesized by soil organisms.";
  skos:topConceptOf <http://vocabulary.odm2.org/variablename>;
  skos:prefLabel "Soil organic matter (SOM)";
  skos:note "Added to support Critical Zone Observatory (CZO) data use cases. ";
  skos:historyNote "Wikipedia";
  skos:exactMatch "https://en.wikipedia.org/wiki/Soil_organic_matter" .

variablename:soilRespiration a skos:Concept;
  skos:definition "Soil respiration refers to the production of carbon dioxide when soil organisms respire. This includes respiration of plant roots, the rhizosphere, microbes and fauna.";
  skos:topConceptOf <http://vocabulary.odm2.org/variablename>;
  skos:prefLabel "Soil respiration";
  skos:note "Added to support Critical Zone Observatory (CZO) data use cases. ";
  skos:historyNote "Wikipedia";
  skos:exactMatch "https://en.wikipedia.org/wiki/Soil_respiration" .

variablename:respirationEcosystem a skos:Concept;
  skos:definition "Gross carbon dioxide production by all organisms in an ecosystem. Ecosystem respiration is the sum of all respiration occurring by the living organisms in a specific ecosystem.";
  skos:topConceptOf <http://vocabulary.odm2.org/variablename>;
  skos:prefLabel "Respiration, ecosystem";
  skos:historyNote "Originally from the CUAHSI HIS VariableNameCV.  See: http://his.cuahsi.org/mastercvreg/edit_cv11.aspx?tbl=VariableNameCV." .

variablename:radiationIncomingLongwave a skos:Concept;
  skos:definition "Incoming Longwave Radiation";
  skos:topConceptOf <http://vocabulary.odm2.org/variablename>;
  skos:prefLabel "Radiation, incoming longwave";
  skos:historyNote "Originally from the CUAHSI HIS VariableNameCV.  See: http://his.cuahsi.org/mastercvreg/edit_cv11.aspx?tbl=VariableNameCV." .

