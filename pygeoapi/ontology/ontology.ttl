quantitykind:IonicStrength a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "Ionic Strength"@en, "Ionic Strength"@en;
  rdfs:comment "Applicable units are those of quantitykind:IonicStrength", "Applicable units are those of quantitykind:IonicStrength";
  dct:description "The \"Ionic Strength\" of a solution is a measure of the concentration of ions in that solution."^^qudt:LatexString,
    "The \"Ionic Strength\" of a solution is a measure of the concentration of ions in that solution."^^qudt:LatexString;
  qudt:hasDimensionVector dimensionvector:A1E0L0I0M-1H0T0D0, dimensionvector:A1E0L0I0M-1H0T0D0;
  qudt:informativeReference "http://en.wikipedia.org/wiki/Ionic_strength"^^xsd:anyURI,
    "http://en.wikipedia.org/wiki/Ionic_strength"^^xsd:anyURI;
  qudt:symbol "I", "I";
  qudt:isoNormativeReference "http://www.iso.org/iso/catalogue_detail?csnumber=31894"^^xsd:anyURI,
    "http://www.iso.org/iso/catalogue_detail?csnumber=31894"^^xsd:anyURI;
  qudt:plainTextDescription "The \"Ionic Strength\" of a solution is a measure of the concentration of ions in that solution.",
    "The \"Ionic Strength\" of a solution is a measure of the concentration of ions in that solution.";
  qudt:latexDefinition "$I = \\frac{1}{2} \\sum z_i^2 b_i$, where the summation is carried out over all ions with charge number $z_i$ and molality $m_i$."^^qudt:LatexString,
