  qudt:symbol "W", "W";
  qudt:ucumCode "W"^^qudt:UCUMcs, "W"^^qudt:UCUMcs;
  qudt:udunitsCode "W", "W";
  qudt:uneceCommonCode "WTT", "WTT";
  qudt:derivedCoherentUnitOfSystem <http://qudt.org/vocab/sou/SI>, <http://qudt.org/vocab/sou/SI>;
