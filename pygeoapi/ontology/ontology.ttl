    skos:historyNote "Originally from the CUAHSI HIS VariableNameCV.  See: http://his.cuahsi.org/mastercvreg/edit_cv11.aspx?tbl=VariableNameCV." ;
    skos:inScheme <http://vocabulary.odm2.org/variablename> ;
    skos:prefLabel "Arsenic, particulate" ;
    skos:topConceptOf <http://vocabulary.odm2.org/variablename> .

variablename:arsenicTotal a skos:Concept ;
    skos:definition "Total arsenic (As). Total indicates was measured on a whole water sample." ;
    skos:historyNote "Originally from the CUAHSI HIS VariableNameCV.  See: http://his.cuahsi.org/mastercvreg/edit_cv11.aspx?tbl=VariableNameCV." ;
    skos:inScheme <http://vocabulary.odm2.org/variablename> ;
    skos:prefLabel "Arsenic, total" ;
    skos:topConceptOf <http://vocabulary.odm2.org/variablename> .

variablename:aspect a skos:Concept ;
    skos:definition "Aspect identifies the downslope direction of the maximum rate of change in value from each raster DEM cell to its neighbors." ;
    skos:exactMatch "http://desktop.arcgis.com/en/arcmap/10.3/tools/spatial-analyst-toolbox/how-aspect-works.htm" ;
    skos:inScheme <http://vocabulary.odm2.org/variablename> ;
    skos:note "Added to support Critical Zone Observatory (CZO) data use cases. " ;
    skos:prefLabel "Aspect" ;
    skos:topConceptOf <http://vocabulary.odm2.org/variablename> .

