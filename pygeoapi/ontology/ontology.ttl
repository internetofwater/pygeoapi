  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:seeAlso quantitykind:MagneticTension, quantitykind:MagneticTension, quantitykind:MagneticFlux,
    quantitykind:MagneticFlux;
  rdfs:label "Reluctance"@en, "Reluctance"@en;
  rdfs:comment "Applicable units are those of quantitykind:Reluctance", "Applicable units are those of quantitykind:Reluctance";
  dct:description "\"Reluctance\" or magnetic resistance, is a concept used in the analysis of magnetic circuits. It is analogous to resistance in an electrical circuit, but rather than dissipating electric energy it stores magnetic energy. In likeness to the way an electric field causes an electric current to follow the path of least resistance, a magnetic field causes magnetic flux to follow the path of least magnetic reluctance. It is a scalar, extensive quantity, akin to electrical resistance."^^qudt:LatexString,
    "\"Reluctance\" or magnetic resistance, is a concept used in the analysis of magnetic circuits. It is analogous to resistance in an electrical circuit, but rather than dissipating electric energy it stores magnetic energy. In likeness to the way an electric field causes an electric current to follow the path of least resistance, a magnetic field causes magnetic flux to follow the path of least magnetic reluctance. It is a scalar, extensive quantity, akin to electrical resistance."^^qudt:LatexString;
  qudt:hasDimensionVector dimensionvector:A0E2L-2I0M-1H0T2D0, dimensionvector:A0E2L-2I0M-1H0T2D0;
  qudt:iec61360Code "0112/2///62720#UAD159", "0112/2///62720#UAD159";
  qudt:informativeReference "http://www.iso.org/iso/home/store/catalogue_tc/catalogue_detail.htm?csnumber=31891"^^xsd:anyURI,
    "http://www.iso.org/iso/home/store/catalogue_tc/catalogue_detail.htm?csnumber=31891"^^xsd:anyURI,
    "http://en.wikipedia.org/wiki/Magnetic_reluctance"^^xsd:anyURI, "http://en.wikipedia.org/wiki/Magnetic_reluctance"^^xsd:anyURI,
    "https://cdd.iec.ch/cdd/iec61987/iec61987.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD159"^^xsd:anyURI,
    "https://cdd.iec.ch/cdd/iec61987/iec61987.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD159"^^xsd:anyURI;
  qudt:symbol "R_m", "R_m";
  qudt:plainTextDescription "\"Reluctance\" or magnetic resistance, is a concept used in the analysis of magnetic circuits. It is analogous to resistance in an electrical circuit, but rather than dissipating electric energy it stores magnetic energy. In likeness to the way an electric field causes an electric current to follow the path of least resistance, a magnetic field causes magnetic flux to follow the path of least magnetic reluctance. It is a scalar, extensive quantity, akin to electrical resistance.",
    "\"Reluctance\" or magnetic resistance, is a concept used in the analysis of magnetic circuits. It is analogous to resistance in an electrical circuit, but rather than dissipating electric energy it stores magnetic energy. In likeness to the way an electric field causes an electric current to follow the path of least resistance, a magnetic field causes magnetic flux to follow the path of least magnetic reluctance. It is a scalar, extensive quantity, akin to electrical resistance.";
  qudt:latexDefinition "$R_m = \\frac{U_m}{\\Phi}$, where $U_m$ is magnetic tension, and $\\Phi$ is magnetic flux."^^qudt:LatexString,
    "$R_m = \\frac{U_m}{\\Phi}$, where $U_m$ is magnetic tension, and $\\Phi$ is magnetic flux."^^qudt:LatexString;
  qudt:applicableUnit unit:PER-H, unit:PER-H .

