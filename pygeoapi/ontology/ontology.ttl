quantitykind:RadiantExposure a qudt:QuantityKind ;
    rdfs:label "Radiant Exposure"@en ;
    dct:description "Radiant exposure is a measure of the total radiant energy incident on a surface per unit area; equal to the integral over time of the radiant flux density. Also known as exposure."^^qudt:LatexString ;
    qudt:abbreviation "J-PER-CM2" ;
