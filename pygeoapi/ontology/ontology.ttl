<http://qudt.org/vocab/quantitykind/CartesianArea> a <http://qudt.org/schema/qudt/QuantityKind>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>;
  rdfs:label "Cartesian Area"@en;
  rdfs:comment "Applicable units are those of quantitykind:Area";
  dct:description "\"Area\" is a quantity that expresses the extent of a two-dimensional surface or shape, or planar lamina, in the plane."^^<http://qudt.org/schema/qudt/LatexString>;
  skos:broader <http://qudt.org/vocab/quantitykind/Area>;
  skos:closeMatch <http://qudt.org/vocab/quantitykind/Area>;
