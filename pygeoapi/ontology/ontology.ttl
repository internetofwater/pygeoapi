  <http://qudt.org/schema/qudt/uneceCommonCode> "F69" .

unit:KiloGM-PER-SEC-K a <http://qudt.org/schema/qudt/Unit>;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/unit>;
  rdfs:label "kilogram per second kelvin";
  dct:description "SI base unit kilogram divided by the product out of the SI base unit second and the SI base unit kelvin";
  <http://qudt.org/schema/qudt/conversionMultiplier> 1.0;
  <http://qudt.org/schema/qudt/conversionMultiplierSN> 1.0E0;
