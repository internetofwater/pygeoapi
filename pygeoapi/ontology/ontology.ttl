variablename:canopyHeight a skos:Concept;
  skos:definition "Forest canopy density and height are used as variables in a number of environmental applications, such as biomass estimation, vegetation coverage, and biodiversity determination. Canopy density, or canopy cover, is the ratio of vegetation to ground as seen from the air. Canopy height measures how far above the ground the top of the canopy is. Lidar can be used to determine both of these variables.";
  skos:inScheme <http://vocabulary.odm2.org/variablename>;
  skos:topConceptOf <http://vocabulary.odm2.org/variablename>;
  skos:prefLabel "Canopy height";
  skos:note "Added to support Critical Zone Observatory (CZO) data use cases. ";
  skos:exactMatch "http://desktop.arcgis.com/en/arcmap/10.3/manage-data/las-dataset/lidar-solutions-estimating-forest-density-and-height.htm" .

