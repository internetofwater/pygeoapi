quantitykind:TotalAngularMomentum a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "Total Angular Momentum"@en, "Total Angular Momentum"@en;
  rdfs:comment "Applicable units are those of quantitykind:AngularMomentum", "Applicable units are those of quantitykind:AngularMomentum";
  dct:description "\"Total Angular Momentum\" combines both the spin and orbital angular momentum of all particles and fields. In atomic and nuclear physics, orbital angular momentum is usually denoted by $l$ or $L$ instead of $\\Lambda$. The magnitude of $J$ is quantized so that $J^2 = \\hbar^2 j(j + 1)$, where $j$ is the total angular momentum quantum number."^^qudt:LatexString,
    "\"Total Angular Momentum\" combines both the spin and orbital angular momentum of all particles and fields. In atomic and nuclear physics, orbital angular momentum is usually denoted by $l$ or $L$ instead of $\\Lambda$. The magnitude of $J$ is quantized so that $J^2 = \\hbar^2 j(j + 1)$, where $j$ is the total angular momentum quantum number."^^qudt:LatexString;
  skos:broader quantitykind:AngularMomentum, quantitykind:AngularMomentum;
  qudt:hasDimensionVector dimensionvector:A0E0L2I0M1H0T-1D0, dimensionvector:A0E0L2I0M1H0T-1D0;
  qudt:informativeReference "http://en.wikipedia.org/wiki/Angular_momentum#Spin.2C_orbital.2C_and_total_angular_momentum"^^xsd:anyURI,
    "http://en.wikipedia.org/wiki/Angular_momentum#Spin.2C_orbital.2C_and_total_angular_momentum"^^xsd:anyURI;
  qudt:symbol "J", "J";
  qudt:applicableUnit unit:ERG-SEC, unit:ERG-SEC, unit:EV-SEC, unit:EV-SEC, unit:FT-LB_F-SEC,
    unit:FT-LB_F-SEC, unit:J-SEC, unit:J-SEC, unit:KiloGM-M2-PER-SEC, unit:KiloGM-M2-PER-SEC,
    unit:N-M-SEC, unit:N-M-SEC;
  qudt:normativeReference "http://www.iso.org/iso/catalogue_detail?csnumber=31895"^^xsd:anyURI,
    "http://www.iso.org/iso/catalogue_detail?csnumber=31895"^^xsd:anyURI .

quantitykind:TotalCrossSection a qudt:QuantityKind, qudt:QuantityKind;
  rdfs:isDefinedBy <http://qudt.org/3.0.0/vocab/quantitykind>, <http://qudt.org/vocab/quantitykind>;
  rdfs:label "Total Cross-section"@en, "Total Cross-section"@en;
  rdfs:comment "Applicable units are those of quantitykind:Area", "Applicable units are those of quantitykind:Area";
  dct:description "\"Total Cross-section\" is related to the absorbance of the light intensity through Beer-Lambert's law. It is the sum of all cross-sections corresponding to the various reactions or processes between an incident particle of specified type and energy and a target particle."^^qudt:LatexString,
    "\"Total Cross-section\" is related to the absorbance of the light intensity through Beer-Lambert's law. It is the sum of all cross-sections corresponding to the various reactions or processes between an incident particle of specified type and energy and a target particle."^^qudt:LatexString;
  skos:broader quantitykind:CrossSection, quantitykind:CrossSection;
  qudt:hasDimensionVector dimensionvector:A0E0L2I0M0H0T0D0, dimensionvector:A0E0L2I0M0H0T0D0;
  qudt:informativeReference "http://en.wikipedia.org/wiki/Cross_section_(physics)"^^xsd:anyURI,
    "http://en.wikipedia.org/wiki/Cross_section_(physics)"^^xsd:anyURI;
  qudt:symbol "σₜ", "σₜ";
  qudt:plainTextDescription "\"Total Cross-section\" is related to the absorbance of the light intensity through Beer-Lambert's law. It is the sum of all cross-sections corresponding to the various reactions or processes between an incident particle of specified type and energy and a target particle.",
    "\"Total Cross-section\" is related to the absorbance of the light intensity through Beer-Lambert's law. It is the sum of all cross-sections corresponding to the various reactions or processes between an incident particle of specified type and energy and a target particle.";
