    rdfs:label "كولوم"@ar,
        "Кулон"@bg,
        "кулон"@bg,
        "Coulomb"@cs,
        "coulomb"@cs,
        "Coulomb"@de,
        "Κουλόμπ"@el,
        "κουλόμπ"@el,
        "Coulomb"@en,
        "coulomb"@en,
        "Culombio"@es,
        "culombio"@es,
        "کولمب/کولن"@fa,
        "Coulomb"@fr,
        "coulomb"@fr,
        "קולון"@he,
